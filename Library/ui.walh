                    function widget(const self&) -> Widget as "node";

                    function x(const self&) -> float {
                        return self.native_rect(0);
                    } end function x

                    function y(const self&) -> float {
                        return self.native_rect(1);
                    } end function y

                    function width(const self&) -> float {
                        return self.native_rect(2);
                    } end function width

                    function height(const self&) -> float {
                        return self.native_rect(3);
                    } end function height

                    function selected(const self&) -> long int;
                    function set_selected(self&, long int: value) -> void;

                    function option(self&, const string&: label, long int: value) -> RadioButton {
                        return self.native_radio(label, value);
                    } end function option

                    function changed(self&) -> bool {
                        return self.take_changed();
                    } end function changed
                } end class RadioGroup

                class Ui as "walnut_rt::gfx::ui" {
                    function native_add(self&, const Widget&: child) -> bool as "add";
                    function native_remove(self&, const Widget&: child) -> bool as "remove";
                    function native_set_accent(self&, unsigned long int: rgba) -> void as "set_accent";
                    function native_root(const self&) -> Stack as "root";
                    function valid(const self&) -> bool;

                public:
                    constructor();
                    constructor(const Window&: window);

                    static function make(const Window&: window) -> Ui {
                        Ui: u = Ui(window);
                        if (!u.valid()) then {
                            throw std::errors::ui_error("can't attach a Ui to this window");
                        }
                        return u;
                    } end function make

                    template <typename W>
                    function add(const W&: child) -> void {
                        if (!native_add(child.widget())) then {
                            throw std::errors::ui_error("add() needs a widget");
                        }
                    } end function add

                    template <typename W>
                    function remove(const W&: child) -> bool {
                        return native_remove(child.widget());
                    } end function remove

                    function root(const self&) -> Stack {
                        return self.native_root();
                    } end function root

                    function update(self&, float: dt) -> void;
                    function draw(self&, Renderer&: renderer) -> void;
                    function set_dark(self&) -> void;
                    function set_light(self&) -> void;
                    function set_font_size(self&, float: px) -> void;
                    function set_font(self&, const string&: name) -> void;
                    function set_scale(self&, float: scale) -> void;
                    function scale(const self&) -> float;
                    function wants_mouse(const self&) -> bool;
                    function wants_keyboard(const self&) -> bool;
                    function alert(self&, const string&: title, const string&: message) -> void;
                    function modal_open(const self&) -> bool;
                    function clear_focus(self&) -> void;

                    function set_accent(self&, const Color&: c) -> void {
                        self.native_set_accent(c.packed());
                    } end function set_accent
                } end class Ui
            } end extern
        } end namespace ui
    } end namespace std
} end safe
