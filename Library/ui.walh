import module.collections
import module.colors
import module.windows
import module.graphics

namespace std {
    namespace errors {
        class ui_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what() const -> string {
                return message;
            } end function what
        } end class ui_error
    } end namespace errors

    namespace ui {
        using std::colors::Color;
        using std::windows::Window;
        using std::graphics::Renderer;

        enum Align { start, center, finish, stretch }

        enum ButtonStyle { normal, primary, danger, flat }

        extern "C++" from "<walnut_ui.hpp>" {
            class Widget as "walnut_rt::gfx::ui_widget" {
            public:
                constructor();
                function valid() const -> bool;
                function widget() const -> Widget as "node";
            } end class Widget


            class Label as "walnut_rt::gfx::ui_widget" {
                function native_rect(long int: which) const -> float as "rect";
                function take_clicked() -> bool;
                function take_changed() -> bool;
                function take_released() -> bool;
                function take_submitted() -> bool;
                static function native_make(const string&: t) -> Label as "walnut_rt::gfx::ui_label";
                function native_set_color(long int: rgba) -> void as "set_color";
                function native_set_align(long int: a) -> void as "set_align";

            public:
                constructor();

                static function make(const string&: t = "") -> Label {
                    return native_make(t);
                } end function make

                function set_size(float: width, float: height) -> void;
                function set_width(float: width) -> void;
                function set_height(float: height) -> void;
                function set_min_size(float: width, float: height) -> void;
                function set_max_size(float: width, float: height) -> void;
                function set_flex(float: flex) -> void;
                function set_visible(bool: visible) -> void;
                function visible() const -> bool;
                function set_enabled(bool: enabled) -> void;
                function enabled() const -> bool;
                function set_tooltip(const string&: tip) -> void;
                function set_id(const string&: id_value) -> void;
                function id() const -> string;
                function hovered() const -> bool;
                function focused() const -> bool;
                function focus() -> void;
                function widget() const -> Widget as "node";

                function x() const -> float {
                    return native_rect(0);
                } end function x

                function y() const -> float {
                    return native_rect(1);
                } end function y

                function width() const -> float {
                    return native_rect(2);
                } end function width

                function height() const -> float {
                    return native_rect(3);
                } end function height

                function set_text(const string&: t) -> void;
                function text_value() const -> string as "text";
                function set_font_size(float: px) -> void;
                function set_bold(bool: on = true) -> void;
                function set_muted(bool: on = true) -> void;

                function set_color(const Color&: c) -> void {
                    native_set_color(c.packed());
                } end function set_color

                function set_align(Align: a) -> void {
                    native_set_align(static_cast<long int>(a));
                } end function set_align
            } end class Label

