            class Ui as "walnut_rt::gfx::ui" {
                function native_add(const Widget&: child) -> bool as "add";
                function native_remove(const Widget&: child) -> bool as "remove";
                function native_set_accent(long int: rgba) -> void as "set_accent";
                function native_root() const -> Stack as "root";
                function valid() const -> bool;

            public:
                constructor();
                constructor(const Window&: window);

                static function make(const Window&: window) -> Ui {
                    Ui: u = Ui(window);
                    if (!u.valid()) then {
                        throw std::errors::ui_error("can't attach a Ui to this window");
                    }
                    return u;
                } end function make

                template <typename W>
                function add(const W&: child) -> void {
                    if (!native_add(child.widget())) then {
                        throw std::errors::ui_error("add() needs a widget");
                    }
                } end function add

                template <typename W>
                function remove(const W&: child) -> bool {
                    return native_remove(child.widget());
                } end function remove

                function root() const -> Stack {
                    return native_root();
                } end function root

                function update(float: dt) -> void;
                function draw(Renderer&: renderer) -> void;
                function set_dark() -> void;
                function set_light() -> void;
                function set_font_size(float: px) -> void;
                function set_font(const string&: name) -> void;
                function set_scale(float: scale) -> void;
                function scale() const -> float;
                function wants_mouse() const -> bool;
                function wants_keyboard() const -> bool;
                function alert(const string&: title, const string&: message) -> void;
                function modal_open() const -> bool;
                function clear_focus() -> void;

                function set_accent(const Color&: c) -> void {
                    native_set_accent(c.packed());
                } end function set_accent
            } end class Ui
        } end extern
    } end namespace ui
} end namespace std
