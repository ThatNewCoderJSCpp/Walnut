import module.collections
import module.colors
import module.windows
import module.graphics

safe(compile) {
    namespace std {
        namespace errors {
            class ui_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class ui_error
        } end namespace errors

        namespace ui {
            using std::colors::Color;
            using std::windows::Window;
            using std::graphics::Renderer;

            enum Align { start, center, finish, stretch }

            enum ButtonStyle { normal, primary, danger, flat }

            extern "C++" from "<walnut_ui.hpp>" {
                class Widget as "walnut_rt::gfx::ui_widget" {
                public:
                    constructor();
                    function valid(const self&) -> bool;
                    function widget(const self&) -> Widget as "node";
                } end class Widget


                class Label as "walnut_rt::gfx::ui_widget" {
                    function native_rect(const self&, unsigned long int: which) -> float as "rect";
                    function take_clicked(self&) -> bool;
                    function take_changed(self&) -> bool;
                    function take_released(self&) -> bool;
                    function take_submitted(self&) -> bool;
                    static function native_make(const string&: t) -> Label as "walnut_rt::gfx::ui_label";
                    function native_set_color(self&, unsigned long int: rgba) -> void as "set_color";
                    function native_set_align(self&, unsigned long int: a) -> void as "set_align";

                public:
                    constructor();

                    static function make(const string&: t = "") -> Label {
                        return native_make(t);
                    } end function make

                    function set_size(self&, float: width, float: height) -> void;
                    function set_width(self&, float: width) -> void;
                    function set_height(self&, float: height) -> void;
                    function set_min_size(self&, float: width, float: height) -> void;
                    function set_max_size(self&, float: width, float: height) -> void;
                    function set_flex(self&, float: flex) -> void;
                    function set_visible(self&, bool: visible) -> void;
                    function visible(const self&) -> bool;
                    function set_enabled(self&, bool: enabled) -> void;
                    function enabled(const self&) -> bool;
                    function set_tooltip(self&, const string&: tip) -> void;
                    function set_id(self&, const string&: id_value) -> void;
                    function id(const self&) -> string;
                    function hovered(const self&) -> bool;
                    function focused(const self&) -> bool;
                    function focus(self&) -> void;
                    function widget(const self&) -> Widget as "node";

                    function x(const self&) -> float {
                        return self.native_rect(0);
                    } end function x

                    function y(const self&) -> float {
                        return self.native_rect(1);
                    } end function y

                    function width(const self&) -> float {
                        return self.native_rect(2);
                    } end function width

                    function height(const self&) -> float {
                        return self.native_rect(3);
                    } end function height

                    function set_text(self&, const string&: t) -> void;
                    function text_value(const self&) -> string as "text";
                    function set_font_size(self&, float: px) -> void;
                    function set_bold(self&, bool: on = true) -> void;
                    function set_muted(self&, bool: on = true) -> void;

                    function set_color(self&, const Color&: c) -> void {
                        self.native_set_color(c.packed());
                    } end function set_color

                    function set_align(self&, Align: a) -> void {
                        self.native_set_align(static_cast<unsigned long int>(a));
                    } end function set_align
                } end class Label

