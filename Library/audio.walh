import module.collections
import module.optional

safe(compile) {
    namespace std {
        namespace errors {
            class audio_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class audio_error
        } end namespace errors

        namespace audio {
            using std::collections::Vector;

            enum DeviceKind { output, input, loopback }

            enum FileType { detect, wav, flac, mp3, ogg_vorbis, ogg_opus, aac, mp4, matroska, ogg }

            enum SampleFormat { u8, s16, s24, s32, f32, f64, alaw, ulaw }

            enum Quality { fast, medium, high, best }

            enum FadeCurve { linear, equal_power, logarithmic, exponential, s_curve }

            enum FilterType { lowpass, highpass, bandpass, notch, peak, lowshelf, highshelf, allpass }

            enum Waveform { sine, square, saw, triangle, noise }

            enum VoicePreset { none, helium, deep, robot, alien, monster, radio, telephone, megaphone, cave, underwater, whisper, feminine, masculine }

            enum Scale { chromatic, major, minor, harmonic_minor, pentatonic_major, pentatonic_minor, blues }

            enum StretchQuality { fast, normal, high }

            enum StretchMode { detect, phase_vocoder, wsola }

            enum AutomationCurve { linear, hold, exponential, s_curve, bezier }

            hidden namespace detail {
                function fail(const string&: what, const string&: why) -> std::errors::audio_error {
                    return std::errors::audio_error(static_cast<string>(`${what}: ${why}`));
                } end function fail

                function check_not_empty(const string&: problem, const string&: what) -> void {
                    if (problem.size() > 0) then {
                        throw fail(what, problem);
                    }
                } end function check_not_empty
            } end namespace detail

            struct SaveOptions {
                FileType: format = FileType::detect;
                SampleFormat: wav_format = SampleFormat::s16;
                bool: dither = true;
                long int: flac_compression = 5;
                long int: flac_bits = 16;
                long int: mp3_bitrate = 192;
                bool: mp3_vbr = false;
                long int: mp3_vbr_quality = 2;
                long int: mp3_quality = 2;
                Vector<string>: tag_keys;
                Vector<string>: tag_values;

                constructor() { }

                constructor(FileType: f) : format = f { }

                function tag(self&, const string&: key, const string&: value) -> SaveOptions& {
                    self.tag_keys.push_back(key);
                    self.tag_values.push_back(value);
                    return *this;
                } end function tag
            } end struct SaveOptions

            class AudioBuffer;
            class Loudness;
            class Effect;
            class EffectChain;

            extern "C++" from "<walnut_audio.hpp>" {
                class Device as "walnut_rt::audio::device" {
                    function native_kind(const self&) -> long int as "kind";

                public:
                    constructor();
                    function id(const self&) -> string;
                    function name(const self&) -> string;
                    function is_default(const self&) -> bool;
                    function sample_rate(const self&) -> long int;
                    function channels(const self&) -> long int;
                    function backend(const self&) -> string;

                    function kind(const self&) -> DeviceKind {
                        return static_cast<DeviceKind>(self.native_kind());
                    } end function kind

                    function to_string(const self&) -> string {
                        return static_cast<string>(`${self.name()} (${self.backend()}, ${self.sample_rate()} Hz, ${self.channels()} channels)`);
                    } end function to_string
                } end class Device

                hidden class DeviceList as "walnut_rt::audio::device_list" {
                public:
                    constructor();
                    static function list(long int: kind) -> DeviceList as "walnut_rt::audio::device_list::list";
                    static function default_of(long int: kind) -> DeviceList as "walnut_rt::audio::device_list::default_of";
                    function size(const self&) -> long int;
                    function at(const self&, long int: index) -> Device;
                } end class DeviceList

                hidden class Api as "walnut_rt::audio::api" {
                public:
                    static function backend_name() -> string as "walnut_rt::audio::backend_name";
                    static function available_backends() -> Vector<string> as "walnut_rt::audio::available_backends";
                    static function set_backend(const string&: name) -> string as "walnut_rt::audio::set_backend";
                    static function type_from_extension(const string&: path) -> long int as "walnut_rt::audio::type_from_extension";
                    static function readable_extensions() -> Vector<string> as "walnut_rt::audio::readable_extensions";
                    static function writable_extensions() -> Vector<string> as "walnut_rt::audio::writable_extensions";
                    static function voice_preset_names() -> Vector<string> as "walnut_rt::audio::voice_preset_names";
                    static function crossfade(const AudioBuffer&: first, const AudioBuffer&: second, float: seconds, long int: curve) -> AudioBuffer as "walnut_rt::audio::crossfade";
                    static function mix(const AudioBuffer&: first, const AudioBuffer&: second, float: gain) -> AudioBuffer as "walnut_rt::audio::mix";
                    static function db_to_gain(float: db) -> float as "walnut_rt::audio::db_to_gain";
                    static function gain_to_db(float: gain) -> float as "walnut_rt::audio::gain_to_db";
                } end class Api

                class AudioFileInfo as "walnut_rt::audio::file_info" {
                    function native_type(const self&) -> long int as "type";
                    function ok(const self&) -> bool;

                public:
                    constructor();
                    static function native_read(const string&: path) -> AudioFileInfo as "walnut_rt::audio::file_info::read";
                    static function native_error() -> string as "walnut_rt::audio::last_error";

                    static function read(const string&: path) -> AudioFileInfo {
                        AudioFileInfo: info = native_read(path);
                        if (!info.ok()) then {
                            throw detail::fail(static_cast<string>(`can't read '${path}'`), native_error());
                        }
                        return info;
                    } end function read

                    function format(const self&) -> FileType {
                        return static_cast<FileType>(self.native_type());
                    } end function format

                    function format_name(const self&) -> string as "type_name";
                    function sample_rate(const self&) -> long int;
                    function channels(const self&) -> long int;
                    function frames(const self&) -> long int;
                    function duration(const self&) -> float;
                    function bitrate_kbps(const self&) -> long int;
                    function tag(const self&, const string&: key) -> string;
                    function tag_keys(const self&) -> Vector<string>;
                } end class AudioFileInfo

                class AudioBuffer as "walnut_rt::audio::buffer" {
                    static function native_load(const string&: path) -> AudioBuffer as "walnut_rt::audio::buffer::load";
                    static function native_error() -> string as "walnut_rt::audio::last_error";
                    static function native_from_samples(const Vector<std::hardware_float>&: samples, long int: channels, long int: rate) -> AudioBuffer as "walnut_rt::audio::buffer::from_samples";
                    static function native_tone(float: frequency, float: seconds, long int: rate, long int: channels, float: amplitude, long int: shape) -> AudioBuffer as "walnut_rt::audio::buffer::tone";
                    function native_save(const self&, const string&: path, long int: type, long int: wav_format, bool: dither, long int: flac_compression, long int: flac_bits, long int: mp3_bitrate, bool: mp3_vbr, long int: mp3_vbr_quality, long int: mp3_quality, const Vector<string>&: keys, const Vector<string>&: values) -> string as "save";
                    function native_get(const self&, long int: frame, long int: channel) -> std::hardware_float as "get";
                    function native_set(self&, long int: frame, long int: channel, std::hardware_float: value) -> void as "set";
                    function native_set_wide(self&, long int: frame, long int: channel, float: value) -> void as "set_wide";
                    function native_channel(const self&, long int: index) -> Vector<std::hardware_float> as "channel";
                    function native_set_channel(self&, long int: index, const Vector<std::hardware_float>&: values) -> void as "set_channel";
                    function native_append(self&, const AudioBuffer&: other) -> bool as "append";
                    function native_insert(self&, long int: at, const AudioBuffer&: other) -> bool as "insert";
                    function native_erase(self&, long int: start, long int: count) -> void as "erase";
                    function native_mix_in(self&, const AudioBuffer&: other, long int: at, float: gain) -> bool as "mix_in";
                    function native_slice(const self&, long int: start, long int: count) -> AudioBuffer as "slice";
                    function native_with_channels(const self&, long int: channels) -> AudioBuffer as "with_channels";
                    function native_resampled(const self&, long int: rate, long int: quality) -> AudioBuffer as "resampled";
                    function native_converted(const self&, long int: channels, long int: rate, long int: quality) -> AudioBuffer as "converted";
                    function native_fade(self&, long int: start, long int: count, float: from_gain, float: to_gain, long int: curve) -> void as "fade";
                    function native_fade_in(self&, float: seconds, long int: curve) -> void as "fade_in";
                    function native_fade_out(self&, float: seconds, long int: curve) -> void as "fade_out";
                    function native_swap(self&, long int: first, long int: second) -> void as "swap_channels";
                    function native_silence_ranges(const self&, float: threshold_db, float: min_seconds) -> Vector<std::hardware_int64> as "silence_ranges";
                    function native_gain_envelope(self&, const Vector<std::hardware_double>&: times, const Vector<std::hardware_double>&: dbs) -> void as "gain_envelope";
                    function native_time_stretched(const self&, float: tempo, long int: quality, long int: mode) -> AudioBuffer as "time_stretched";
                    function native_pitch_changed(const self&, float: semitones, long int: quality, long int: mode) -> AudioBuffer as "pitch_changed";
                    function native_tempo_and_pitch(const self&, float: tempo, float: semitones, long int: quality, long int: mode) -> AudioBuffer as "tempo_and_pitch_changed";
                    function native_speed_changed(const self&, float: factor, long int: quality) -> AudioBuffer as "speed_changed";
                    function native_spectrum(const self&, long int: bands, float: min_hz, float: max_hz, long int: fft_size) -> Vector<std::hardware_float> as "spectrum";

                    function native_set_sample_rate(self&, long int: rate) -> void as "set_sample_rate";
                    function native_resize(self&, long int: frames) -> void as "resize";
                    function check(const self&, long int: frame, long int: channel, const string&: what) -> void {
                        if (frame < 0 || frame >= self.frames() || channel < 0 || channel >= self.channels()) then {
                            throw std::errors::audio_error(static_cast<string>(`${what}: frame ${frame}, channel ${channel} is outside the buffer (${self.frames()} frames, ${self.channels()} channels)`));
                        }
                    } end function check

                    function check_range(const self&, long int: start, long int: count, const string&: what) -> void {
                        if (start < 0 || count < 0 || start + count > self.frames()) then {
                            throw std::errors::audio_error(static_cast<string>(`${what}: frames ${start} to ${start + count} are outside the buffer's ${self.frames()} frames`));
                        }
                    } end function check_range

                    function check_format(const self&, long int: c, long int: rate, const string&: what) -> void {
                        if (c <= 0 || c > 64) then {
                            throw std::errors::audio_error(static_cast<string>(`${what}: a buffer needs 1 to 64 channels, not ${c}`));
                        }
                        if (rate <= 0) then {
                            throw std::errors::audio_error(static_cast<string>(`${what}: the sample rate has to be above 0, not ${rate}`));
                        }
                    } end function check_format

                    function check_same(const self&, const AudioBuffer&: other, const string&: what) -> void {
                        if (other.channels() != self.channels() || other.sample_rate() != self.sample_rate()) then {
                            throw std::errors::audio_error(static_cast<string>(`${what}: the buffers don't match (${self.channels()} channels at ${self.sample_rate()} Hz and ${other.channels()} channels at ${other.sample_rate()} Hz); use converted() first`));
                        }
                    } end function check_same

                public:
                    constructor();
                    constructor(long int: channels, long int: sample_rate) as "walnut_rt::audio::buffer";
                    constructor(long int: channels, long int: sample_rate, long int: frames) as "walnut_rt::audio::buffer";

                    static function make(long int: channels, long int: sample_rate, long int: frames = 0) -> AudioBuffer {
                        AudioBuffer: probe;
                        probe.check_format(channels, sample_rate, "AudioBuffer::make()");
                        if (frames < 0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::make(): the length can't be negative (${frames} frames)`));
                        }
                        return AudioBuffer(channels, sample_rate, frames);
                    } end function make

                    static function silence(float: seconds, long int: sample_rate = 48000, long int: channels = 2) -> AudioBuffer {
                        AudioBuffer: probe;
                        probe.check_format(channels, sample_rate, "AudioBuffer::silence()");
                        long int: count = static_cast<long int>(seconds * static_cast<float>(sample_rate) + 0.5);
                        if (count < 0) then {
                            count = 0;
                        }
                        return AudioBuffer(channels, sample_rate, count);
                    } end function silence

                    static function tone(float: frequency, float: seconds, long int: sample_rate = 48000, long int: channels = 1, float: amplitude = 0.5, Waveform: shape = Waveform::sine) -> AudioBuffer {
                        AudioBuffer: probe;
                        probe.check_format(channels, sample_rate, "AudioBuffer::tone()");
                        return native_tone(frequency, seconds, sample_rate, channels, amplitude, static_cast<long int>(shape));
                    } end function tone

                    static function from_samples(const Vector<std::hardware_float>&: samples, long int: channels, long int: sample_rate) -> AudioBuffer {
                        AudioBuffer: probe;
                        probe.check_format(channels, sample_rate, "AudioBuffer::from_samples()");
                        return native_from_samples(samples, channels, sample_rate);
                    } end function from_samples

                    static function load(const string&: path) -> AudioBuffer {
                        AudioBuffer: b = native_load(path);
                        if (b.empty()) then {
                            const string: problem = native_error();
                            if (problem.size() > 0) then {
                                throw detail::fail(static_cast<string>(`can't load '${path}'`), problem);
                            }
                        }
                        return b;
                    } end function load

                    function save(const self&, const string&: path, const SaveOptions&: options = SaveOptions()) -> void {
                        const string: problem = self.native_save(path, static_cast<long int>(options.format), static_cast<long int>(options.wav_format), options.dither, options.flac_compression, options.flac_bits, options.mp3_bitrate, options.mp3_vbr, options.mp3_vbr_quality, options.mp3_quality, options.tag_keys, options.tag_values);
                        detail::check_not_empty(problem, static_cast<string>(`can't save '${path}'`));
                    } end function save

                    function save(const self&, const string&: path, FileType: format) -> void {
                        self.save(path, SaveOptions(format));
                    } end function save

                    function channels(const self&) -> long int;
                    function sample_rate(const self&) -> long int;
                    function frames(const self&) -> long int;
                    function sample_count(const self&) -> long int;
                    function duration(const self&) -> float;
                    function empty(const self&) -> bool;

                    function sample(const self&, long int: frame, long int: channel = 0) -> std::hardware_float {
                        self.check(frame, channel, "AudioBuffer::sample()");
                        return self.native_get(frame, channel);
                    } end function sample

                    function set_sample(self&, long int: frame, long int: channel, std::hardware_float: value) -> void {
                        self.check(frame, channel, "AudioBuffer::set_sample()");
                        self.native_set(frame, channel, value);
                    } end function set_sample

                    function set_sample(self&, long int: frame, long int: channel, float: value) -> void {
                        self.check(frame, channel, "AudioBuffer::set_sample()");
                        self.native_set_wide(frame, channel, value);
                    } end function set_sample

                    function samples(const self&) -> Vector<std::hardware_float>;
                    function set_samples(self&, const Vector<std::hardware_float>&: values) -> void;

                    function channel(const self&, long int: index) -> Vector<std::hardware_float> {
                        if (index < 0 || index >= self.channels()) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::channel(): channel ${index} doesn't exist in a ${self.channels()}-channel buffer`));
                        }
                        return self.native_channel(index);
                    } end function channel

                    function set_channel(self&, long int: index, const Vector<std::hardware_float>&: values) -> void {
                        if (index < 0 || index >= self.channels()) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::set_channel(): channel ${index} doesn't exist in a ${self.channels()}-channel buffer`));
                        }
                        self.native_set_channel(index, values);
                    } end function set_channel

                    function set_sample_rate(self&, long int: rate) -> void {
                        if (rate <= 0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::set_sample_rate(): the sample rate has to be above 0, not ${rate}`));
                        }
                        self.native_set_sample_rate(rate);
                    } end function set_sample_rate

                    function resize(self&, long int: frames) -> void {
                        if (frames < 0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::resize(): the length can't be negative (${frames} frames)`));
                        }
                        self.native_resize(frames);
                    } end function resize

                    function clear(self&) -> void;
                    function silence(self&) -> void;

                    function append(self&, const AudioBuffer&: other) -> void {
                        if (self.empty() && self.channels() == 0) then {
                            *this = other;
                            return;
                        }
                        self.check_same(other, "AudioBuffer::append()");
                        self.native_append(other);
                    } end function append

                    function insert(self&, long int: at_frame, const AudioBuffer&: other) -> void {
                        self.check_same(other, "AudioBuffer::insert()");
                        if (at_frame < 0 || at_frame > self.frames()) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::insert(): frame ${at_frame} is outside the buffer's ${self.frames()} frames`));
                        }
                        self.native_insert(at_frame, other);
                    } end function insert

                    function erase(self&, long int: start_frame, long int: count) -> void {
                        self.check_range(start_frame, count, "AudioBuffer::erase()");
                        self.native_erase(start_frame, count);
                    } end function erase

                    function mix(self&, const AudioBuffer&: other, long int: at_frame = 0, float: gain = 1.0) -> void {
                        self.check_same(other, "AudioBuffer::mix()");
                        if (at_frame < 0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::mix(): frame ${at_frame} is negative`));
                        }
                        self.native_mix_in(other, at_frame, gain);
                    } end function mix

                    function slice(const self&, long int: start_frame, long int: count) -> AudioBuffer {
                        self.check_range(start_frame, count, "AudioBuffer::slice()");
                        return self.native_slice(start_frame, count);
                    } end function slice

                    function cut(const self&, float: start_seconds, float: length_seconds) -> AudioBuffer {
                        long int: start = self.frame_at(start_seconds);
                        long int: end_frame = self.frame_at(start_seconds + length_seconds);
                        if (start > self.frames()) then {
                            start = self.frames();
                        }
                        if (end_frame > self.frames()) then {
                            end_frame = self.frames();
                        }
                        if (end_frame < start) then {
                            end_frame = start;
                        }
                        return self.native_slice(start, end_frame - start);
                    } end function cut

                    function with_channels(const self&, long int: count) -> AudioBuffer {
                        self.check_format(count, self.sample_rate(), "AudioBuffer::with_channels()");
                        return self.native_with_channels(count);
                    } end function with_channels

                    function resampled(const self&, long int: rate, Quality: quality = Quality::high) -> AudioBuffer {
                        self.check_format(self.channels(), rate, "AudioBuffer::resampled()");
                        return self.native_resampled(rate, static_cast<long int>(quality));
                    } end function resampled

                    function converted(const self&, long int: channels_wanted, long int: rate, Quality: quality = Quality::high) -> AudioBuffer {
                        self.check_format(channels_wanted, rate, "AudioBuffer::converted()");
                        return self.native_converted(channels_wanted, rate, static_cast<long int>(quality));
                    } end function converted

                    function to_mono(const self&) -> AudioBuffer;
                    function to_stereo(const self&) -> AudioBuffer;

                    function swap_channels(self&, long int: first = 0, long int: second = 1) -> void {
                        if (first < 0 || second < 0 || first >= self.channels() || second >= self.channels()) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::swap_channels(): channels ${first} and ${second} don't both exist in a ${self.channels()}-channel buffer`));
                        }
                        self.native_swap(first, second);
                    } end function swap_channels

                    function frame_at(const self&, float: seconds) -> long int;
                    function seconds_at(const self&, long int: frame) -> float;

                    function peak(const self&) -> std::hardware_float;
                    function rms(const self&) -> std::hardware_float;
                    function peak_db(const self&) -> float;
                    function true_peak_db(const self&) -> float;
                    function gain(self&, float: factor) -> void as "apply_gain";
                    function gain_db(self&, float: db) -> void as "apply_gain_db";
                    function normalize(self&, float: target_peak = 1.0) -> void;
                    function normalize_db(self&, float: target_db) -> void;
                    function clamp(self&) -> void;

                    function loudness(const self&) -> Loudness as "walnut_rt::audio::loudness::measure";
                    function normalize_loudness(self&, float: target_lufs = -14.0, float: max_true_peak_db = -1.0) -> void as "walnut_rt::audio::normalize_loudness";

                    function fade(self&, long int: start_frame, long int: count, float: from_gain, float: to_gain, FadeCurve: curve = FadeCurve::linear) -> void {
                        self.check_range(start_frame, count, "AudioBuffer::fade()");
                        self.native_fade(start_frame, count, from_gain, to_gain, static_cast<long int>(curve));
                    } end function fade

                    function fade_in(self&, float: seconds, FadeCurve: curve = FadeCurve::linear) -> void {
                        self.native_fade_in(seconds, static_cast<long int>(curve));
                    } end function fade_in

                    function fade_out(self&, float: seconds, FadeCurve: curve = FadeCurve::linear) -> void {
                        self.native_fade_out(seconds, static_cast<long int>(curve));
                    } end function fade_out

                    function gain_envelope(self&, const Vector<std::hardware_double>&: times, const Vector<std::hardware_double>&: dbs) -> void {
                        if (times.size() != dbs.size()) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::gain_envelope(): ${times.size()} times but ${dbs.size()} levels`));
                        }
                        self.native_gain_envelope(times, dbs);
                    } end function gain_envelope

                    function reverse(self&) -> void;
                    function invert_polarity(self&) -> void;
                    function remove_dc(self&) -> void;
                    function pad(self&, float: before_seconds, float: after_seconds) -> void;
                    function trim_silence(self&, float: threshold_db = -60.0, float: keep_ms = 10.0) -> void;

                    function silent_parts(const self&, float: threshold_db = -60.0, float: min_seconds = 0.1) -> Vector<std::hardware_int64> {
                        return self.native_silence_ranges(threshold_db, min_seconds);
                    } end function silent_parts

                    function time_stretched(const self&, float: tempo, StretchQuality: quality = StretchQuality::high, StretchMode: mode = StretchMode::detect) -> AudioBuffer {
                        if (tempo < 0.25 || tempo > 4.0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::time_stretched(): the tempo has to be between 0.25 and 4, not ${tempo}`));
                        }
                        return self.native_time_stretched(tempo, static_cast<long int>(quality), static_cast<long int>(mode));
                    } end function time_stretched

                    function pitch_shifted(const self&, float: semitones, StretchQuality: quality = StretchQuality::high, StretchMode: mode = StretchMode::detect) -> AudioBuffer {
                        if (semitones < -24.0 || semitones > 24.0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::pitch_shifted(): the shift has to be between -24 and 24 semitones, not ${semitones}`));
                        }
                        return self.native_pitch_changed(semitones, static_cast<long int>(quality), static_cast<long int>(mode));
                    } end function pitch_shifted

                    function stretched(const self&, float: tempo, float: semitones, StretchQuality: quality = StretchQuality::high, StretchMode: mode = StretchMode::detect) -> AudioBuffer {
                        if (tempo < 0.25 || tempo > 4.0 || semitones < -24.0 || semitones > 24.0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::stretched(): the tempo has to be between 0.25 and 4 and the shift between -24 and 24 semitones, not ${tempo} and ${semitones}`));
                        }
                        return self.native_tempo_and_pitch(tempo, semitones, static_cast<long int>(quality), static_cast<long int>(mode));
                    } end function stretched

                    function speed_changed(const self&, float: factor, Quality: quality = Quality::high) -> AudioBuffer {
                        if (factor <= 0.0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::speed_changed(): the factor has to be above 0, not ${factor}`));
                        }
                        return self.native_speed_changed(factor, static_cast<long int>(quality));
                    } end function speed_changed

                    function pitch(const self&, float: min_hz = 50.0, float: max_hz = 2000.0) -> float as "detect_pitch";

                    function spectrum(const self&, long int: bands = 32, float: min_hz = 20.0, float: max_hz = 20000.0, long int: fft_size = 4096) -> Vector<std::hardware_float> {
                        if (bands <= 0) then {
                            throw std::errors::audio_error(static_cast<string>(`AudioBuffer::spectrum(): the number of bands has to be above 0, not ${bands}`));
                        }
                        return self.native_spectrum(bands, min_hz, max_hz, fft_size);
                    } end function spectrum

                    function apply(self&, const Effect&: effect, bool: keep_tail = true) -> void {
                        effect.apply_to(*this, keep_tail);
                    } end function apply

                    function apply(self&, const EffectChain&: chain, bool: keep_tail = true) -> void {
                        chain.apply_to(*this, keep_tail);
                    } end function apply

                    function applied(const self&, const Effect&: effect, bool: keep_tail = true) -> AudioBuffer {
                        return effect.process(*this, keep_tail);
                    } end function applied

                    function applied(const self&, const EffectChain&: chain, bool: keep_tail = true) -> AudioBuffer {
                        return chain.process(*this, keep_tail);
                    } end function applied

                    function to_string(const self&) -> string {
                        return static_cast<string>(`AudioBuffer(${self.channels()} channels, ${self.sample_rate()} Hz, ${self.frames()} frames)`);
                    } end function to_string
                } end class AudioBuffer

                class Loudness as "walnut_rt::audio::loudness" {
                public:
                    constructor();
                    function integrated(const self&) -> float;
                    function range(const self&) -> float;
                    function true_peak_db(const self&) -> float;
                    function sample_peak_db(const self&) -> float;
                    function max_momentary(const self&) -> float;
                    function max_short_term(const self&) -> float;
                } end class Loudness

                class AudioBlock as "walnut_rt::audio::block" {
                    function native_set(self&, long int: frame, long int: channel, std::hardware_float: value) -> void as "set";
                    function native_set_wide(self&, long int: frame, long int: channel, float: value) -> void as "set_wide";
                    function native_get_index(const self&, long int: index) -> std::hardware_float as "get_index";
                    function native_set_index(self&, long int: index, std::hardware_float: value) -> void as "set_index";
                    function native_set_index_wide(self&, long int: index, float: value) -> void as "set_index_wide";
                    function native_fill(self&, std::hardware_float: value) -> void as "fill";
                    function native_fill_wide(self&, float: value) -> void as "fill_wide";
                    function native_copy(self&, const AudioBuffer&: source, long int: start, float: gain, bool: add) -> long int as "copy_from";

                public:
                    constructor();
                    function frames(const self&) -> long int;
                    function channels(const self&) -> long int;
                    function sample_rate(const self&) -> long int;
                    function sample_count(const self&) -> long int;
                    function writable(const self&) -> bool;
                    function get(const self&, long int: frame, long int: channel = 0) -> std::hardware_float;

                    function set(self&, long int: frame, long int: channel, std::hardware_float: value) -> void {
                        self.native_set(frame, channel, value);
                    } end function set

                    function set(self&, long int: frame, long int: channel, float: value) -> void {
                        self.native_set_wide(frame, channel, value);
                    } end function set

                    function sample(const self&, long int: index) -> std::hardware_float {
                        return self.native_get_index(index);
                    } end function sample

                    function set_sample(self&, long int: index, std::hardware_float: value) -> void {
                        self.native_set_index(index, value);
                    } end function set_sample

                    function set_sample(self&, long int: index, float: value) -> void {
                        self.native_set_index_wide(index, value);
                    } end function set_sample

                    function fill(self&, std::hardware_float: value) -> void {
                        self.native_fill(value);
                    } end function fill

                    function fill(self&, float: value) -> void {
                        self.native_fill_wide(value);
                    } end function fill

                    function silence(self&) -> void {
                        self.native_fill_wide(0.0);
                    } end function silence

                    function gain(self&, float: factor) -> void as "apply_gain";
                    function peak(const self&) -> std::hardware_float;
                    function rms(const self&) -> std::hardware_float;

                    function copy_from(self&, const AudioBuffer&: source, long int: start_frame = 0, float: gain = 1.0) -> long int {
                        return self.native_copy(source, start_frame, gain, false);
                    } end function copy_from

                    function add_from(self&, const AudioBuffer&: source, long int: start_frame = 0, float: gain = 1.0) -> long int {
                        return self.native_copy(source, start_frame, gain, true);
                    } end function add_from

                    function to_buffer(const self&) -> AudioBuffer;
                } end class AudioBlock

                class Stream as "walnut_rt::audio::stream" {
                    static function native_playback(const string&: device, long int: rate, long int: channels, long int: latency_ms, const string&: name, function(AudioBlock&) -> void: callback) -> Stream as "walnut_rt::audio::stream::open_playback";
                    static function native_capture(long int: kind, const string&: device, long int: rate, long int: channels, long int: latency_ms, const string&: name, function(const AudioBlock&) -> void: callback) -> Stream as "walnut_rt::audio::stream::open_capture";
                    static function native_error() -> string as "walnut_rt::audio::last_error";
                    function native_start(self&) -> string as "start";
                    function native_kind(const self&) -> long int as "kind";

                    static function opened(Stream&&: s, const string&: what) -> Stream {
                        if (!s.is_open()) then {
                            throw detail::fail(what, native_error());
                        }
                        return std::move(s);
                    } end function opened

                public:
                    constructor();
                    constructor(const Stream&: other) = delete;
                    constructor(Stream&&: other);
                    operator(=) function(self&, Stream&&: other) -> Stream&;

                    static function playback(function(AudioBlock&) -> void: callback, const string&: device = "", long int: sample_rate = 0, long int: channels = 0, long int: latency_ms = 20, const string&: name = "walnut") -> Stream {
                        return opened(native_playback(device, sample_rate, channels, latency_ms, name, callback), "can't open the output device");
                    } end function playback

                    static function capture(function(const AudioBlock&) -> void: callback, const string&: device = "", long int: sample_rate = 0, long int: channels = 0, long int: latency_ms = 20, const string&: name = "walnut") -> Stream {
                        return opened(native_capture(1, device, sample_rate, channels, latency_ms, name, callback), "can't open the input device");
                    } end function capture

                    static function loopback(function(const AudioBlock&) -> void: callback, const string&: device = "", long int: sample_rate = 0, long int: channels = 0, long int: latency_ms = 20, const string&: name = "walnut") -> Stream {
                        return opened(native_capture(2, device, sample_rate, channels, latency_ms, name, callback), "can't open the loopback device");
                    } end function loopback

                    function start(self&) -> void {
                        detail::check_not_empty(self.native_start(), "can't start the stream");
                    } end function start

                    function stop(self&) -> void;
                    function close(self&) -> void;
                    function is_open(const self&) -> bool;
                    function running(const self&) -> bool;
                    function failed(const self&) -> bool;
                    function error(const self&) -> string;

                    function check(const self&) -> void {
                        if (self.failed()) then {
                            throw detail::fail("the audio stream stopped", self.error());
                        }
                    } end function check

                    function kind(const self&) -> DeviceKind {
                        return static_cast<DeviceKind>(self.native_kind());
                    } end function kind

                    function sample_rate(const self&) -> long int;
                    function channels(const self&) -> long int;
                    function latency_frames(const self&) -> long int;
                    function device_name(const self&) -> string;
                    function frames_processed(const self&) -> long int;
                    function seconds_processed(const self&) -> float;
                } end class Stream

                class Effect as "walnut_rt::audio::effect" {
                    static function native_gain(float: db) -> Effect as "walnut_rt::audio::effect::gain";
                    static function native_filter(long int: type, float: frequency, float: q, float: gain_db, float: slope_db) -> Effect as "walnut_rt::audio::effect::filter";
                    static function native_parametric_eq(long int: bands) -> Effect as "walnut_rt::audio::effect::parametric_eq";
                    static function native_compressor(float: threshold, float: ratio, float: attack, float: release) -> Effect as "walnut_rt::audio::effect::compressor";
                    static function native_limiter(float: ceiling, float: release, float: lookahead) -> Effect as "walnut_rt::audio::effect::limiter";
                    static function native_gate(float: threshold, float: attack, float: hold, float: release) -> Effect as "walnut_rt::audio::effect::noise_gate";
                    static function native_expander(float: threshold, float: ratio) -> Effect as "walnut_rt::audio::effect::expander";
                    static function native_de_esser(float: frequency, float: threshold, float: amount) -> Effect as "walnut_rt::audio::effect::de_esser";
                    static function native_pitch_shifter(float: semitones) -> Effect as "walnut_rt::audio::effect::pitch_shifter";
                    static function native_formant_shifter(float: semitones) -> Effect as "walnut_rt::audio::effect::formant_shifter";
                    static function native_voice_changer(long int: preset) -> Effect as "walnut_rt::audio::effect::voice_changer";
                    static function native_hum_remover(float: frequency) -> Effect as "walnut_rt::audio::effect::hum_remover";
                    static function native_create(const string&: type) -> Effect as "walnut_rt::audio::effect::create";
                    static function native_custom(const string&: name, function(AudioBlock&) -> void: body) -> Effect as "walnut_rt::audio::effect::custom";
                    static function native_from_json(const string&: json) -> Effect as "walnut_rt::audio::effect::from_json";
                    static function native_error() -> string as "walnut_rt::audio::last_error";
                    function native_set(self&, const string&: parameter, float: value) -> bool as "set";
                    function native_set_band(self&, long int: index, long int: type, float: frequency, float: q, float: gain_db, bool: enabled) -> bool as "set_band";
                    function native_set_graphic_band(self&, long int: index, float: gain_db) -> bool as "set_graphic_band";
                    function native_learn_noise(self&, const AudioBuffer&: noise) -> string as "learn_noise";
                    function native_process(const self&, const AudioBuffer&: input, bool: keep_tail) -> AudioBuffer as "process";
                    function native_apply(const self&, AudioBuffer&: buffer, bool: keep_tail) -> void as "apply";
                    function valid(const self&) -> bool;

                    function native_get(const self&, const string&: parameter) -> float as "get";
                    function native_minimum(const self&, const string&: parameter) -> float as "minimum";
                    function native_maximum(const self&, const string&: parameter) -> float as "maximum";
                    static function native_autotune() -> Effect as "walnut_rt::audio::effect::autotune";
                    function require(const self&, const string&: parameter, const string&: what) -> void {
                        if (!self.has(parameter)) then {
                            string: known = "";
                            for (const string&: n in self.parameter_names()) {
                                if (known.size() > 0) then {
                                    known += ", ";
                                }
                                known += n;
                            }
                            throw std::errors::audio_error(static_cast<string>(`${what}: the ${self.name()} effect has no parameter '${parameter}' (it has: ${known})`));
                        }
                    } end function require

                    static function made(Effect&&: e, const string&: what) -> Effect {
                        if (!e.valid()) then {
                            throw detail::fail(what, native_error());
                        }
                        return std::move(e);
                    } end function made

                public:
                    constructor();

                    static function gain(float: db = 0.0) -> Effect {
                        return native_gain(db);
                    } end function gain

                    static function filter(FilterType: type, float: frequency, float: q = 0.70710678, float: gain_db = 0.0, float: slope_db = 12.0) -> Effect {
                        return native_filter(static_cast<long int>(type), frequency, q, gain_db, slope_db);
                    } end function filter

                    static function lowpass(float: frequency, float: q = 0.70710678) -> Effect {
                        return native_filter(static_cast<long int>(FilterType::lowpass), frequency, q, 0.0, 12.0);
                    } end function lowpass

                    static function highpass(float: frequency, float: q = 0.70710678) -> Effect {
                        return native_filter(static_cast<long int>(FilterType::highpass), frequency, q, 0.0, 12.0);
                    } end function highpass

                    static function bandpass(float: frequency, float: q = 1.0) -> Effect {
                        return native_filter(static_cast<long int>(FilterType::bandpass), frequency, q, 0.0, 12.0);
                    } end function bandpass

                    static function notch(float: frequency, float: q = 5.0) -> Effect {
                        return native_filter(static_cast<long int>(FilterType::notch), frequency, q, 0.0, 12.0);
                    } end function notch

                    static function eq(long int: bands = 8) -> Effect {
                        if (bands < 1 || bands > 16) then {
                            throw std::errors::audio_error(static_cast<string>(`Effect::eq(): an equalizer has 1 to 16 bands, not ${bands}`));
                        }
                        return native_parametric_eq(bands);
                    } end function eq

                    static function graphic_eq() -> Effect as "walnut_rt::audio::effect::graphic_eq";
                    static function dc_blocker() -> Effect as "walnut_rt::audio::effect::dc_blocker";

                    static function compressor(float: threshold_db = -18.0, float: ratio = 4.0, float: attack_ms = 10.0, float: release_ms = 100.0) -> Effect {
                        return native_compressor(threshold_db, ratio, attack_ms, release_ms);
                    } end function compressor

                    static function limiter(float: ceiling_db = -1.0, float: release_ms = 50.0, float: lookahead_ms = 5.0) -> Effect {
                        return native_limiter(ceiling_db, release_ms, lookahead_ms);
                    } end function limiter

                    static function gate(float: threshold_db = -40.0, float: attack_ms = 1.0, float: hold_ms = 50.0, float: release_ms = 100.0) -> Effect {
                        return native_gate(threshold_db, attack_ms, hold_ms, release_ms);
                    } end function gate

                    static function expander(float: threshold_db = -40.0, float: ratio = 2.0) -> Effect {
                        return native_expander(threshold_db, ratio);
                    } end function expander

                    static function de_esser(float: frequency = 6000.0, float: threshold_db = -30.0, float: amount_db = 6.0) -> Effect {
                        return native_de_esser(frequency, threshold_db, amount_db);
                    } end function de_esser

                    static function reverb() -> Effect as "walnut_rt::audio::effect::reverb";
                    static function delay() -> Effect as "walnut_rt::audio::effect::delay";
                    static function distortion() -> Effect as "walnut_rt::audio::effect::distortion";
                    static function bitcrusher() -> Effect as "walnut_rt::audio::effect::bitcrusher";
                    static function chorus() -> Effect as "walnut_rt::audio::effect::chorus";
                    static function flanger() -> Effect as "walnut_rt::audio::effect::flanger";
                    static function phaser() -> Effect as "walnut_rt::audio::effect::phaser";
                    static function tremolo() -> Effect as "walnut_rt::audio::effect::tremolo";
                    static function vibrato() -> Effect as "walnut_rt::audio::effect::vibrato";
                    static function autopan() -> Effect as "walnut_rt::audio::effect::autopan";

                    static function pitch_shift(float: semitones) -> Effect {
                        return native_pitch_shifter(semitones);
                    } end function pitch_shift

                    static function formant_shift(float: semitones) -> Effect {
                        return native_formant_shifter(semitones);
                    } end function formant_shift

                    static function autotune(long int: key = 0, Scale: scale = Scale::chromatic) -> Effect {
                        Effect: e = native_autotune();
                        e.native_set("key", static_cast<float>(key));
                        e.native_set("scale", static_cast<float>(static_cast<long int>(scale)));
                        return e;
                    } end function autotune

                    static function voice_changer(VoicePreset: preset = VoicePreset::none) -> Effect {
                        return native_voice_changer(static_cast<long int>(preset));
                    } end function voice_changer

                    static function voice_eq() -> Effect as "walnut_rt::audio::effect::voice_eq";
                    static function ring_modulator() -> Effect as "walnut_rt::audio::effect::ring_modulator";
                    static function vocoder() -> Effect as "walnut_rt::audio::effect::vocoder";
                    static function noise_reduction() -> Effect as "walnut_rt::audio::effect::noise_reduction";

                    static function hum_remover(float: frequency = 0.0) -> Effect {
                        return native_hum_remover(frequency);
                    } end function hum_remover

                    static function click_remover() -> Effect as "walnut_rt::audio::effect::click_remover";

                    static function create(const string&: type) -> Effect {
                        Effect: e = native_create(type);
                        if (!e.valid()) then {
                            throw std::errors::audio_error(static_cast<string>(`Effect::create(): there is no effect type '${type}'`));
                        }
                        return e;
                    } end function create

                    static function types() -> Vector<string> as "walnut_rt::audio::effect::types";

                    static function custom(function(AudioBlock&) -> void: body, const string&: name = "custom") -> Effect {
                        return native_custom(name, body);
                    } end function custom

                    static function from_json(const string&: json) -> Effect {
                        return made(native_from_json(json), "can't read the effect");
                    } end function from_json

                    function name(const self&) -> string;
                    function type(const self&) -> string;
                    function has(const self&, const string&: parameter) -> bool;

                    function set(self&, const string&: parameter, float: value) -> void {
                        self.require(parameter, "Effect::set()");
                        self.native_set(parameter, value);
                    } end function set

                    function get(const self&, const string&: parameter) -> float {
                        self.require(parameter, "Effect::get()");
                        return self.native_get(parameter);
                    } end function get

                    function minimum(const self&, const string&: parameter) -> float {
                        self.require(parameter, "Effect::minimum()");
                        return self.native_minimum(parameter);
                    } end function minimum

                    function maximum(const self&, const string&: parameter) -> float {
                        self.require(parameter, "Effect::maximum()");
                        return self.native_maximum(parameter);
                    } end function maximum

                    function unit(const self&, const string&: parameter) -> string;
                    function parameter_names(const self&) -> Vector<string>;
                    function set_enabled(self&, bool: on) -> void;
                    function enabled(const self&) -> bool;
                    function reset(self&) -> void;
                    function latency_frames(const self&) -> long int;
                    function tail_frames(const self&) -> long int;

                    function set_band(self&, long int: index, FilterType: type, float: frequency, float: q = 1.0, float: gain_db = 0.0, bool: on = true) -> void {
                        if (!self.native_set_band(index, static_cast<long int>(type), frequency, q, gain_db, on)) then {
                            throw std::errors::audio_error(static_cast<string>(`Effect::set_band(): band ${index} doesn't exist (this is a '${self.name()}' effect with ${self.band_count()} bands; only Effect::eq() has bands to set this way)`));
                        }
                    } end function set_band

                    function set_band_gain(self&, long int: index, float: gain_db) -> void {
                        if (!self.native_set_graphic_band(index, gain_db)) then {
                            throw std::errors::audio_error(static_cast<string>(`Effect::set_band_gain(): band ${index} doesn't exist (only Effect::graphic_eq() has 10 fixed bands)`));
                        }
                    } end function set_band_gain

                    function band_count(const self&) -> long int;

                    function learn_noise(self&, const AudioBuffer&: noise) -> void {
                        detail::check_not_empty(self.native_learn_noise(noise), "Effect::learn_noise()");
                    } end function learn_noise

                    function detected_pitch(const self&) -> float;
                    function gain_reduction_db(const self&) -> float;
                    function error(const self&) -> string;
                    function clear_error(self&) -> void;
                    function clone(const self&) -> Effect;
                    function to_json(const self&) -> string;

                    function process(const self&, const AudioBuffer&: input, bool: keep_tail = true) -> AudioBuffer {
                        return self.native_process(input, keep_tail);
                    } end function process

                    function apply_to(const self&, AudioBuffer&: buffer, bool: keep_tail = true) -> void {
                        self.native_apply(buffer, keep_tail);
                    } end function apply_to
                } end class Effect

                class EffectChain as "walnut_rt::audio::chain" {
                    static function native_voice_preset(long int: preset) -> EffectChain as "walnut_rt::audio::chain::voice_preset";
                    static function native_voice_preset_named(const string&: name) -> EffectChain as "walnut_rt::audio::chain::voice_preset_named";
                    static function native_load(const string&: path) -> EffectChain as "walnut_rt::audio::chain::load_preset";
                    static function native_from_json(const string&: json) -> EffectChain as "walnut_rt::audio::chain::from_json";
                    static function native_error() -> string as "walnut_rt::audio::last_error";
                    function native_save(const self&, const string&: path, const string&: name, const string&: author, const string&: description) -> string as "save_preset";
                    function native_insert(self&, long int: index, const Effect&: effect) -> bool as "insert";
                    function native_remove(self&, long int: index) -> bool as "remove";
                    function native_move(self&, long int: from_index, long int: to_index) -> bool as "move_effect";
                    function native_at(const self&, long int: index) -> Effect as "at";
                    function native_process(const self&, const AudioBuffer&: input, bool: keep_tail) -> AudioBuffer as "process";
                    function native_apply(const self&, AudioBuffer&: buffer, bool: keep_tail) -> void as "apply";

                    function native_add(self&, const Effect&: effect) -> void as "add";
                    function check_index(const self&, long int: index, long int: limit, const string&: what) -> void {
                        if (index < 0 || index >= limit) then {
                            throw std::errors::audio_error(static_cast<string>(`${what}: index ${index} is out of range for a chain of ${self.size()} effects`));
                        }
                    } end function check_index

                    static function loaded(EffectChain&&: c, const string&: what) -> EffectChain {
                        const string: problem = native_error();
                        if (problem.size() > 0) then {
                            throw detail::fail(what, problem);
                        }
                        return std::move(c);
                    } end function loaded

                public:
                    constructor();

                    constructor(Effect...: effects) {
                        for (const Effect&: e in effects) {
                            self.add(e);
                        }
                    }

                    static function voice_preset(VoicePreset: preset) -> EffectChain {
                        return native_voice_preset(static_cast<long int>(preset));
                    } end function voice_preset

                    static function voice_preset(const string&: name) -> EffectChain {
                        bool: known = false;
                        for (const string&: n in voice_preset_names()) {
                            if (n == name) then {
                                known = true;
                            }
                        }
                        if (!known) then {
                            throw std::errors::audio_error(static_cast<string>(`EffectChain::voice_preset(): there is no voice preset named '${name}'`));
                        }
                        return native_voice_preset_named(name);
                    } end function voice_preset

                    static function voice_preset_names() -> Vector<string> as "walnut_rt::audio::chain::voice_preset_names";

                    static function load(const string&: path) -> EffectChain {
                        return loaded(native_load(path), static_cast<string>(`can't load the preset '${path}'`));
                    } end function load

                    static function from_json(const string&: json) -> EffectChain {
                        return loaded(native_from_json(json), "can't read the preset");
                    } end function from_json

                    function save(const self&, const string&: path, const string&: name = "", const string&: author = "", const string&: description = "") -> void {
                        detail::check_not_empty(self.native_save(path, name, author, description), static_cast<string>(`can't save the preset '${path}'`));
                    } end function save

                    function to_json(const self&, const string&: name = "") -> string;

                    function add(self&, const Effect&: effect) -> EffectChain& {
                        self.native_add(effect);
                        return *this;
                    } end function add

                    function insert(self&, long int: index, const Effect&: effect) -> void {
                        self.check_index(index, self.size() + 1, "EffectChain::insert()");
                        self.native_insert(index, effect);
                    } end function insert

                    function remove(self&, long int: index) -> void {
                        self.check_index(index, self.size(), "EffectChain::remove()");
                        self.native_remove(index);
                    } end function remove

                    function move(self&, long int: from_index, long int: to_index) -> void {
                        self.check_index(from_index, self.size(), "EffectChain::move()");
                        self.check_index(to_index, self.size(), "EffectChain::move()");
                        self.native_move(from_index, to_index);
                    } end function move

                    function clear(self&) -> void;
                    function size(const self&) -> long int;

                    function at(const self&, long int: index) -> Effect {
                        self.check_index(index, self.size(), "EffectChain::at()");
                        return self.native_at(index);
                    } end function at

                    operator([]) function(const self&, long int: index) -> Effect {
                        return self.at(index);
                    }

                    function reset(self&) -> void;
                    function set_enabled(self&, bool: on) -> void;
                    function enabled(const self&) -> bool;
                    function latency_frames(const self&) -> long int;
                    function tail_frames(const self&) -> long int;
                    function as_effect(const self&) -> Effect;

                    function process(const self&, const AudioBuffer&: input, bool: keep_tail = true) -> AudioBuffer {
                        return self.native_process(input, keep_tail);
                    } end function process

                    function apply_to(const self&, AudioBuffer&: buffer, bool: keep_tail = true) -> void {
                        self.native_apply(buffer, keep_tail);
                    } end function apply_to
                } end class EffectChain

                class LiveChain as "walnut_rt::audio::duplex" {
                    function native_start(self&, const string&: input, const string&: output, long int: rate, long int: channels, long int: latency_ms, bool: loopback) -> string as "start";

                public:
                    constructor();
                    constructor(const LiveChain&: other) = delete;
                    constructor(LiveChain&&: other);

                    function start(self&, const string&: input = "", const string&: output = "", long int: sample_rate = 0, long int: channels = 0, long int: latency_ms = 20, bool: loopback = false) -> void {
                        detail::check_not_empty(self.native_start(input, output, sample_rate, channels, latency_ms, loopback), "can't start the live chain");
                    } end function start

                    function stop(self&) -> void;
                    function running(const self&) -> bool;
                    function failed(const self&) -> bool;
                    function error(const self&) -> string;

                    function check(const self&) -> void {
                        if (self.failed()) then {
                            throw detail::fail("the live chain stopped", self.error());
                        }
                    } end function check

                    function effects(const self&) -> EffectChain;
                    function set_effects(self&, const EffectChain&: chain) -> void;
                    function set_gain(self&, float: gain) -> void;
                    function gain(const self&) -> float;
                    function set_bypass(self&, bool: on) -> void;
                    function bypass(const self&) -> bool;
                    function set_muted(self&, bool: on) -> void;
                    function muted(const self&) -> bool;
                    function sample_rate(const self&) -> long int;
                    function channels(const self&) -> long int;
                    function input_device(const self&) -> string;
                    function output_device(const self&) -> string;
                    function underruns(const self&) -> long int;
                    function overruns(const self&) -> long int;
                    function dropped_frames(const self&) -> long int;
                    function frames_processed(const self&) -> long int;
                    function input_peak(self&) -> float;
                    function output_peak(self&) -> float;
                    function latency_ms(const self&) -> float;
                } end class LiveChain

                class Sound as "walnut_rt::audio::sound" {
                    static function native_load(const string&: path) -> Sound as "walnut_rt::audio::sound::load";
                    static function native_error() -> string as "walnut_rt::audio::last_error";

                public:
                    constructor();
                    constructor(const AudioBuffer&: buffer);

                    static function load(const string&: path) -> Sound {
                        Sound: s = native_load(path);
                        if (!s.valid()) then {
                            const string: problem = native_error();
                            if (problem.size() > 0) then {
                                throw detail::fail(static_cast<string>(`can't load '${path}'`), problem);
                            }
                        }
                        return s;
                    } end function load

                    function valid(const self&) -> bool;
                    function channels(const self&) -> long int;
                    function sample_rate(const self&) -> long int;
                    function frames(const self&) -> long int;
                    function duration(const self&) -> float;
                    function to_buffer(const self&) -> AudioBuffer;
                } end class Sound

                class Voice as "walnut_rt::audio::voice" {
                    function native_stop(self&, float: fade_out) -> void as "stop";

                public:
                    constructor();
                    function id(const self&) -> long int;
                    function valid(const self&) -> bool;
                    function is_playing(const self&) -> bool;
                    function is_paused(const self&) -> bool;

                    function stop(self&, float: fade_out_seconds = 0.0) -> void {
                        self.native_stop(fade_out_seconds);
                    } end function stop

                    function pause(self&) -> void;
                    function resume(self&) -> void;
                    function set_gain(self&, float: gain) -> void;
                    function set_pan(self&, float: pan) -> void;
                    function set_speed(self&, float: speed) -> void;
                    function set_loop(self&, bool: on) -> void;
                    function set_pitch(self&, float: semitones) -> bool;
                    function set_preserve_pitch(self&, bool: on) -> bool;
                    function seek(self&, float: seconds) -> bool;
                    function position(const self&) -> float;
                    function duration(const self&) -> float;

                    function wait(const self&, long int: timeout_ms = -1) -> bool;
                } end class Voice

                class Mixer as "walnut_rt::audio::mixer" {
                    function native_play(self&, const Sound&: sound, float: gain, float: pan, float: speed, bool: loop, bool: paused, float: start, float: fade_in, float: pitch, bool: preserve_pitch) -> Voice as "play";
                    function native_play_buffer(self&, const AudioBuffer&: buffer, float: gain, float: pan, float: speed, bool: loop, bool: paused, float: start, float: fade_in, float: pitch, bool: preserve_pitch) -> Voice as "play_buffer";
                    function native_play_file(self&, const string&: path, float: gain, float: pan, float: speed, bool: loop, bool: paused, float: start, float: fade_in, float: pitch, bool: preserve_pitch) -> Voice as "play_file";
                    static function native_error() -> string as "walnut_rt::audio::last_error";
                    function native_start(self&, const string&: device, long int: latency_ms) -> string as "start";
                    function native_stop_all(self&, float: fade_out) -> void as "stop_all";
                    function native_render(self&, long int: frames) -> AudioBuffer as "render";

                public:
                    constructor();
                    constructor(long int: sample_rate, long int: channels = 2);
                    constructor(const Mixer&: other) = delete;
                    constructor(Mixer&&: other);

                    function play(self&, const Sound&: sound, float: gain = 1.0, float: pan = 0.0, float: speed = 1.0, bool: loop = false, bool: paused = false, float: start = 0.0, float: fade_in = 0.0, float: pitch = 0.0, bool: preserve_pitch = false) -> Voice {
                        if (!sound.valid()) then {
                            throw std::errors::audio_error("Mixer::play(): the sound is empty");
                        }
                        return self.native_play(sound, gain, pan, speed, loop, paused, start, fade_in, pitch, preserve_pitch);
                    } end function play

                    function play(self&, const AudioBuffer&: buffer, float: gain = 1.0, float: pan = 0.0, float: speed = 1.0, bool: loop = false, bool: paused = false, float: start = 0.0, float: fade_in = 0.0, float: pitch = 0.0, bool: preserve_pitch = false) -> Voice {
                        if (buffer.empty()) then {
                            throw std::errors::audio_error("Mixer::play(): the buffer is empty");
                        }
                        return self.native_play_buffer(buffer, gain, pan, speed, loop, paused, start, fade_in, pitch, preserve_pitch);
                    } end function play

                    function play_file(self&, const string&: path, float: gain = 1.0, float: pan = 0.0, float: speed = 1.0, bool: loop = false, bool: paused = false, float: start = 0.0, float: fade_in = 0.0, float: pitch = 0.0, bool: preserve_pitch = false) -> Voice {
                        Voice: v = self.native_play_file(path, gain, pan, speed, loop, paused, start, fade_in, pitch, preserve_pitch);
                        if (!v.valid()) then {
                            throw detail::fail(static_cast<string>(`can't play '${path}'`), native_error());
                        }
                        return v;
                    } end function play_file

                    function stop_all(self&, float: fade_out_seconds = 0.0) -> void {
                        self.native_stop_all(fade_out_seconds);
                    } end function stop_all

                    function voice_count(const self&) -> long int;
                    function set_master_gain(self&, float: gain) -> void;
                    function master_gain(const self&) -> float;
                    function output_peak(const self&) -> float;
                    function sample_rate(const self&) -> long int;
                    function channels(const self&) -> long int;
                    function effects(const self&) -> EffectChain;

                    function render(self&, long int: frames) -> AudioBuffer {
                        if (frames < 0) then {
                            throw std::errors::audio_error(static_cast<string>(`Mixer::render(): the length can't be negative (${frames} frames)`));
                        }
                        if (self.output_running()) then {
                            throw std::errors::audio_error("Mixer::render(): the mixer is playing through a device; call stop_output() first");
                        }
                        return self.native_render(frames);
                    } end function render

                    function render_seconds(self&, float: seconds) -> AudioBuffer {
                        return self.render(static_cast<long int>(seconds * static_cast<float>(self.sample_rate()) + 0.5));
                    } end function render_seconds

                    function start(self&, const string&: device = "", long int: latency_ms = 30) -> void {
                        detail::check_not_empty(self.native_start(device, latency_ms), "can't start the mixer's output");
                    } end function start

                    function stop_output(self&) -> void;
                    function output_running(const self&) -> bool;
                    function output_failed(const self&) -> bool;
                    function output_error(const self&) -> string;
                    function device_name(const self&) -> string;
                    function wait_idle(const self&, long int: timeout_ms = -1) -> bool;
                } end class Mixer

                class Track as "walnut_rt::audio::track" {
                    function native_add_clip(self&, const Sound&: sound, float: position, const string&: name) -> long int as "add_clip";
                    function native_add_buffer(self&, const AudioBuffer&: buffer, float: position, const string&: name) -> long int as "add_buffer";
                    function native_set_clip_fades(self&, long int: index, float: fade_in, float: fade_out, long int: curve) -> void as "set_clip_fades";
                    function native_automate(self&, long int: target, long int: effect_index, const string&: parameter, float: time, float: value, long int: curve) -> void as "automate";

                public:
                    constructor();
                    function name(const self&) -> string;
                    function set_name(self&, const string&: name) -> void;
                    function index(const self&) -> long int;
                    function set_volume_db(self&, float: db) -> void;
                    function volume_db(const self&) -> float;
                    function set_pan(self&, float: pan) -> void;
                    function pan(const self&) -> float;
                    function set_mute(self&, bool: on) -> void;
                    function mute(const self&) -> bool;
                    function set_solo(self&, bool: on) -> void;
                    function solo(const self&) -> bool;
                    function length(const self&) -> float;

                    function add_clip(self&, const Sound&: sound, float: position = 0.0, const string&: name = "") -> long int {
                        return self.native_add_clip(sound, position, name);
                    } end function add_clip

                    function add_clip(self&, const AudioBuffer&: buffer, float: position = 0.0, const string&: name = "") -> long int {
                        if (buffer.empty()) then {
                            throw std::errors::audio_error("Track::add_clip(): the buffer is empty");
                        }
                        return self.native_add_buffer(buffer, position, name);
                    } end function add_clip

                    function clip_count(const self&) -> long int;
                    function remove_clip(self&, long int: index) -> bool;
                    function split_clip(self&, long int: index, float: time) -> bool;
                    function clip_position(const self&, long int: index) -> float;
                    function clip_length(const self&, long int: index) -> float;
                    function clip_end(const self&, long int: index) -> float;
                    function clip_name(const self&, long int: index) -> string;
                    function move_clip(self&, long int: index, float: time) -> void;
                    function set_clip_gain_db(self&, long int: index, float: db) -> void;
                    function set_clip_muted(self&, long int: index, bool: on) -> void;
                    function trim_clip_start(self&, long int: index, float: time) -> void;
                    function trim_clip_end(self&, long int: index, float: time) -> void;

                    function set_clip_fades(self&, long int: index, float: fade_in, float: fade_out, FadeCurve: curve = FadeCurve::linear) -> void {
                        self.native_set_clip_fades(index, fade_in, fade_out, static_cast<long int>(curve));
                    } end function set_clip_fades

                    function effects(self&) -> EffectChain;

                    function automate_volume(self&, float: time, float: db, AutomationCurve: curve = AutomationCurve::linear) -> void {
                        self.native_automate(0, 0, "", time, db, static_cast<long int>(curve));
                    } end function automate_volume

                    function automate_pan(self&, float: time, float: pan, AutomationCurve: curve = AutomationCurve::linear) -> void {
                        self.native_automate(1, 0, "", time, pan, static_cast<long int>(curve));
                    } end function automate_pan

                    function automate_mute(self&, float: time, bool: muted) -> void {
                        float: value = 0.0;
                        if (muted) then {
                            value = 1.0;
                        }
                        self.native_automate(2, 0, "", time, value, static_cast<long int>(AutomationCurve::hold));
                    } end function automate_mute

                    function automate_effect(self&, long int: effect_index, const string&: parameter, float: time, float: value, AutomationCurve: curve = AutomationCurve::linear) -> void {
                        EffectChain: chain = self.effects();
                        if (effect_index < 0 || effect_index >= chain.size()) then {
                            throw std::errors::audio_error(static_cast<string>(`Track::automate_effect(): the track has no effect ${effect_index} (it has ${chain.size()})`));
                        }
                        if (!chain.at(effect_index).has(parameter)) then {
                            throw std::errors::audio_error(static_cast<string>(`Track::automate_effect(): the ${chain.at(effect_index).name()} effect has no parameter '${parameter}'`));
                        }
                        self.native_automate(3, effect_index, parameter, time, value, static_cast<long int>(curve));
                    } end function automate_effect

                    function clear_automation(self&) -> void;
                } end class Track

                class Timeline as "walnut_rt::audio::timeline" {
                    function native_automate_master(self&, float: time, float: db, long int: curve) -> void as "automate_master_volume";
                    function native_track_at(const self&, long int: index) -> Track as "track_at";

                public:
                    constructor();
                    constructor(long int: sample_rate, long int: channels = 2);
                    function sample_rate(const self&) -> long int;
                    function channels(const self&) -> long int;

                    function add_track(self&, const string&: name = "") -> Track;
                    function track_count(const self&) -> long int;

                    function track(const self&, long int: index) -> Track {
                        if (index < 0 || index >= self.track_count()) then {
                            throw std::errors::audio_error(static_cast<string>(`Timeline::track(): track ${index} is out of range for a timeline with ${self.track_count()} tracks`));
                        }
                        return self.native_track_at(index);
                    } end function track

                    function remove_track(self&, long int: index) -> bool;
                    function length(const self&) -> float;
                    function set_tempo(self&, float: bpm) -> void;
                    function tempo(const self&) -> float;
                    function beats_to_seconds(const self&, float: beats) -> float;
                    function bars_to_seconds(const self&, float: bars) -> float;
                    function snap(const self&, float: seconds, float: division_beats = 1.0) -> float;
                    function add_marker(self&, float: time, const string&: name = "") -> long int;
                    function marker_count(const self&) -> long int;
                    function marker_time(const self&, long int: index) -> float;
                    function marker_name(const self&, long int: index) -> string;
                    function set_master_volume_db(self&, float: db) -> void;
                    function master_volume_db(const self&) -> float;
                    function set_loop(self&, float: start, float: end_time, bool: on = true) -> void;
                    function master_effects(self&) -> EffectChain;

                    function automate_master_volume(self&, float: time, float: db, AutomationCurve: curve = AutomationCurve::linear) -> void {
                        self.native_automate_master(time, db, static_cast<long int>(curve));
                    } end function automate_master_volume

                    function render(const self&, bool: include_tail = true) -> AudioBuffer;

                    function render(const self&, float: start, float: end_time, bool: include_tail = false) -> AudioBuffer as "render_range";

                    function export(const self&, const string&: path, const SaveOptions&: options = SaveOptions()) -> void {
                        self.render().save(path, options);
                    } end function export
                } end class Timeline

                class TimelinePlayer as "walnut_rt::audio::timeline_player" {
                    function native_start(self&, const string&: device, long int: latency_ms) -> string as "start";
                    function native_render(self&, long int: frames) -> AudioBuffer as "render";

                public:
                    constructor();
                    constructor(long int: sample_rate, long int: channels = 2);
                    constructor(const TimelinePlayer&: other) = delete;
                    constructor(TimelinePlayer&&: other);
                    function update(self&, const Timeline&: timeline) -> void;
                    function play(self&) -> void;
                    function pause(self&) -> void;
                    function stop(self&) -> void;
                    function seek(self&, float: seconds) -> void;
                    function set_loop(self&, float: start, float: end_time, bool: on = true) -> void;
                    function is_playing(const self&) -> bool;
                    function position(const self&) -> float;
                    function output_peak(const self&) -> float;
                    function sample_rate(const self&) -> long int;
                    function channels(const self&) -> long int;

                    function render(self&, long int: frames) -> AudioBuffer {
                        if (self.output_running()) then {
                            throw std::errors::audio_error("TimelinePlayer::render(): the player is playing through a device; call stop_output() first");
                        }
                        return self.native_render(frames);
                    } end function render

                    function start(self&, const string&: device = "", long int: latency_ms = 30) -> void {
                        detail::check_not_empty(self.native_start(device, latency_ms), "can't start the timeline's output");
                    } end function start

                    function stop_output(self&) -> void;
                    function output_running(const self&) -> bool;
                } end class TimelinePlayer

            } end extern

            function split_on_silence(const AudioBuffer&: buffer, float: threshold_db = -50.0, float: min_silence_seconds = 0.3) -> Vector<AudioBuffer> {
                Vector<std::hardware_int64>: quiet = buffer.silent_parts(threshold_db, min_silence_seconds);
                Vector<AudioBuffer>: parts;
                long int: at = 0;
                long int: i = 0;
                while (i + 1 < quiet.size()) {
                    const long int: begin_quiet = quiet[i];
                    const long int: end_quiet = quiet[i + 1];
                    if (begin_quiet > at) then {
                        parts.push_back(buffer.slice(at, begin_quiet - at));
                    }
                    at = end_quiet;
                    i += 2;
                }
                if (at < buffer.frames()) then {
                    parts.push_back(buffer.slice(at, buffer.frames() - at));
                }
                return parts;
            } end function split_on_silence

            function crossfade(const AudioBuffer&: first, const AudioBuffer&: second, float: seconds, FadeCurve: curve = FadeCurve::equal_power) -> AudioBuffer {
                if (first.channels() != second.channels() || first.sample_rate() != second.sample_rate()) then {
                    throw std::errors::audio_error("crossfade(): the buffers need the same channels and sample rate; use converted() first");
                }
                return Api::crossfade(first, second, seconds, static_cast<long int>(curve));
            } end function crossfade

            function mix(const AudioBuffer&: first, const AudioBuffer&: second, float: gain = 1.0) -> AudioBuffer {
                if (first.channels() != second.channels() || first.sample_rate() != second.sample_rate()) then {
                    throw std::errors::audio_error("mix(): the buffers need the same channels and sample rate; use converted() first");
                }
                return Api::mix(first, second, gain);
            } end function mix

            function db_to_gain(float: db) -> float {
                return Api::db_to_gain(db);
            } end function db_to_gain

            function gain_to_db(float: gain) -> float {
                return Api::gain_to_db(gain);
            } end function gain_to_db

            function backend() -> string {
                return Api::backend_name();
            } end function backend

            function backends() -> Vector<string> {
                return Api::available_backends();
            } end function backends

            function use_backend(const string&: name) -> void {
                detail::check_not_empty(Api::set_backend(name), static_cast<string>(`can't use the audio backend '${name}'`));
            } end function use_backend

            function devices() -> Vector<Device> {
                DeviceList: list = DeviceList::list(-1);
                Vector<Device>: out;
                for (long int: i = 0; i < list.size(); i++) {
                    out.push_back(list.at(i));
                }
                return out;
            } end function devices

            function devices(DeviceKind: kind) -> Vector<Device> {
                DeviceList: list = DeviceList::list(static_cast<long int>(kind));
                Vector<Device>: out;
                for (long int: i = 0; i < list.size(); i++) {
                    out.push_back(list.at(i));
                }
                return out;
            } end function devices

            function default_device(DeviceKind: kind = DeviceKind::output) -> std::optional::Optional<Device> {
                DeviceList: list = DeviceList::default_of(static_cast<long int>(kind));
                if (list.size() == 0) then {
                    return std::optional::nothing<Device>();
                }
                return std::optional::Optional<Device>(list.at(0));
            } end function default_device

            function file_info(const string&: path) -> AudioFileInfo {
                return AudioFileInfo::read(path);
            } end function file_info

            function format_of(const string&: path) -> FileType {
                return static_cast<FileType>(Api::type_from_extension(path));
            } end function format_of

            function readable_extensions() -> Vector<string> {
                return Api::readable_extensions();
            } end function readable_extensions

            function writable_extensions() -> Vector<string> {
                return Api::writable_extensions();
            } end function writable_extensions

            function voice_preset_name(VoicePreset: preset) -> string {
                return Api::voice_preset_names()[static_cast<long int>(preset)];
            } end function voice_preset_name

            function load(const string&: path) -> AudioBuffer {
                return AudioBuffer::load(path);
            } end function load

            function play(const AudioBuffer&: buffer, const string&: device = "") -> void {
                Mixer: m(buffer.sample_rate(), buffer.channels());
                m.start(device);
                Voice: v = m.play(buffer);
                v.wait();
                m.stop_output();
            } end function play

            function play_file(const string&: path, const string&: device = "") -> void {
                AudioBuffer: b = AudioBuffer::load(path);
                play(b, device);
            } end function play_file
        } end namespace audio
    } end namespace std
} end safe
