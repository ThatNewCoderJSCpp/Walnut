                function remove_if(std::Predicate<T>: pred) -> long int {
                    const long int: kept = std::algorithms::remove_if(data(), data() + size(), pred) - data();
                    const long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function remove_if

                function retain_if(std::Predicate<T>: pred) -> long int {
                    return remove_if([&pred](const T&: x) -> bool { return !pred(x); });
                } end function retain_if

                function remove_at(long int: index) -> T {
                    return erase(index);
                } end function remove_at

                function remove_unordered(long int: index) -> T {
                    check(index);
                    const long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                    return pop_back();
                } end function remove_unordered

                function swap_remove(long int: index) -> T {
                    return remove_unordered(index);
                } end function swap_remove

                function erase_unordered(long int: index) -> T {
                    return remove_unordered(index);
                } end function erase_unordered

                function take_at_unordered(long int: index) -> T {
                    return remove_unordered(index);
                } end function take_at_unordered

                function remove_at_unordered(long int: index) -> T {
                    return remove_unordered(index);
                } end function remove_at_unordered

                function remove_first_unordered(const T&: value) -> bool {
                    const long int: at = find(value);
                    if (at < 0) then {
                        return false;
                    }
                    remove_unordered(at);
                    return true;
                } end function remove_first_unordered

                function remove_all_unordered(const T&: value) -> long int {
                    return remove_if_unordered([&value](const T&: x) -> bool { return x == value; });
                } end function remove_all_unordered

                function remove_if_unordered(std::Predicate<T>: drop) -> long int {
                    long int: removed = 0;
                    long int: i = 0;
                    while (i < size()) {
                        if (drop(data()[i])) then {
                            remove_unordered(i);
                            removed += 1;
                        } else then {
                            i += 1;
                        }
                    }
                    return removed;
                } end function remove_if_unordered

                function retain_if_unordered(std::Predicate<T>: keep) -> long int {
                    return remove_if_unordered([&keep](const T&: x) -> bool { return !keep(x); });
                } end function retain_if_unordered

                function remove_range_unordered(long int: start, long int: stop) -> void {
                    if (start < 0 || start > size()) then {
                        throw detail::out_of_range(start, size());
                    }
                    if (stop < start || stop > size()) then {
                        throw detail::out_of_range(stop, size());
                    }
                    const long int: count = stop - start;
                    const long int: n = size();
                    for (long int: k = 0; k < count; k++) {
                        const long int: hole = start + k;
                        const long int: source = n - 1 - k;
                        if (source >= stop && source > hole) then {
                            data()[hole] = std::core::move(data()[source]);
                        }
                    }
                    for (long int: k = 0; k < count; k++) {
                        pop_back();
                    }
                } end function remove_range_unordered

                function take_front_unordered() -> T {
                    if (empty()) then {
                        throw detail::empty_error("take_front_unordered()");
                    }
                    return remove_unordered(0);
                } end function take_front_unordered

                function pop_front_unordered() -> T {
                    return take_front_unordered();
                } end function pop_front_unordered

                function remove_first(const T&: value) -> bool {
                    const long int: at = find(value);
                    if (at < 0) then {
                        return false;
                    }
                    erase(at);
                    return true;
                } end function remove_first

                function unique() -> long int {
                    const long int: kept = std::algorithms::unique(data(), data() + size()) - data();
                    const long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function unique

                function deduplicate() -> long int {
                    long int: kept = 0;
                    for (long int: i = 0; i < size(); i++) {
                        bool: seen = false;
                        for (long int: j = 0; j < kept; j++) {
                            if (data()[j] == data()[i]) then {
                                seen = true;
                                break;
                            }
                        }
                        if (!seen) then {
                            if (kept != i) then {
                                data()[kept] = std::core::move(data()[i]);
                            }
                            kept += 1;
                        }
                    }
                    const long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function deduplicate

                function distinct() const -> DynamicArray {
                    DynamicArray: out = *this;
                    out.deduplicate();
                    return out;
                } end function distinct

                function replace(const T&: old_value, const T&: new_value) -> long int {
                    return std::algorithms::replace(data(), data() + size(), old_value, new_value);
                } end function replace

                function replace_if(std::Predicate<T>: pred, const T&: new_value) -> long int {
                    return std::algorithms::replace_if(data(), data() + size(), pred, new_value);
                } end function replace_if

                function rotate_left(long int: steps = 1) -> void {
                    std::algorithms::rotate_left(data(), data() + size(), steps);
                } end function rotate_left

                function rotate_right(long int: steps = 1) -> void {
                    std::algorithms::rotate_right(data(), data() + size(), steps);
                } end function rotate_right

                function shuffle() -> void {
                    std::algorithms::shuffle(data(), data() + size());
                } end function shuffle

                function swap_items(long int: a, long int: b) -> void {
                    check(a);
                    check(b);
                    std::algorithms::detail::swap_values(data()[a], data()[b]);
                } end function swap_items

                function partition(std::Predicate<T>: pred) -> long int {
                    return std::algorithms::partition(data(), data() + size(), pred) - data();
                } end function partition

                function stable_partition(std::Predicate<T>: pred) -> long int {
                    return std::algorithms::stable_partition(data(), data() + size(), pred) - data();
                } end function stable_partition

                function append(const T&: value) -> void {
                    push_back(value);
                } end function append

                function prepend(const T&: value) -> void {
                    insert(0, value);
                } end function prepend

                function insert_n(long int: index, long int: count, const T&: value) -> void {
                    for (long int: k = 0; k < count; k++) {
                        insert(index, value);
                    }
                } end function insert_n

                function insert_all(long int: index, const DynamicArray&: items) -> void {
                    for (long int: k = 0; k < items.size(); k++) {
                        insert(index + k, items[k]);
                    }
                } end function insert_all

                function append_n(long int: count, const T&: value) -> void {
                    for (long int: k = 0; k < count; k++) {
                        push_back(value);
                    }
                } end function append_n

                function insert_unordered(long int: index, const T&: value) -> void {
                    if (index < 0 || index > size()) then {
                        throw detail::out_of_range(index, size());
                    }
                    push_back(value);
                    const long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                } end function insert_unordered

                function take(long int: count) const -> DynamicArray {
                    DynamicArray: out;
                    for (long int: i = 0; i < count && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function take

                function skip(long int: count) const -> DynamicArray {
                    DynamicArray: out;
                    for (long int: i = count < 0 ? 0 : count; i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function skip

                function slice(long int: start, long int: stop) const -> DynamicArray {
                    DynamicArray: out;
                    for (long int: i = start < 0 ? 0 : start; i < stop && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function slice

                function sliced(long int: start, long int: stop, long int: step, bool: has_start, bool: has_stop) const -> DynamicArray {
                    if (step == 0) then {
                        throw std::errors::collection_error("a slice's step can't be 0");
                    }
                    const long int: n = size();
                    const long int: low = step > 0 ? 0 : -1;
                    const long int: high = step > 0 ? n : n - 1;
                    long int: first = step > 0 ? 0 : n - 1;
                    long int: last = step > 0 ? n : -1;
                    if (has_start) then {
                        first = start < 0 ? start + n : start;
                        first = first < low ? low : (first > high ? high : first);
                    }
                    if (has_stop) then {
                        last = stop < 0 ? stop + n : stop;
                        last = last < low ? low : (last > high ? high : last);
                    }
                    DynamicArray: out;
                    for (long int: i = first; step > 0 ? i < last : i > last; i += step) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function sliced

                function starts_with(const DynamicArray&: prefix) const -> bool {
                    return std::algorithms::starts_with(data(), data() + size(), prefix.data(), prefix.data() + prefix.size());
                } end function starts_with

                function ends_with(const DynamicArray&: suffix) const -> bool {
                    return std::algorithms::ends_with(data(), data() + size(), suffix.data(), suffix.data() + suffix.size());
                } end function ends_with

                function where(const T&: value) -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::equal_to(*this, value);
                } end function where

                function where(std::Predicate<T>: pred) -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::matching(*this, pred);
                } end function where

                function where_indices(const Vector<long int>&: indices) -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::at_indices(*this, indices);
                } end function where_indices

                function all() -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::matching(*this, [](const T&: x) -> bool { return true; });
                } end function all

                function swap(DynamicArray&: other) -> void;

                operator(==) function(const DynamicArray&: other) const -> bool {
                    return detail::same_items(data(), size(), other.data(), other.size());
                }

                operator(!=) function(const DynamicArray&: other) const -> bool {
                    return !detail::same_items(data(), size(), other.data(), other.size());
                }
            } end class DynamicArray

            template <typename T, int N = 8>
            class SmallVector as "fizmo::collections::SmallVector" {
                function check(long int: index) const -> void {
                    if (index < 0 || index >= size()) then {
                        throw detail::out_of_range(index, size());
                    }
                } end function check

                function take_back() -> T as "pop_back";
                function take_at(long int: index) -> T as "pop";
                function insert_at(long int: index, const T&: value) -> void as "insert";
                function remove_range(long int: start, long int: stop) -> void;
                function grow(long int: count) -> void as "resize";
                function grow_with(long int: count, const T&: value) -> void as "resize";
                function reserve_more(long int: count) -> void as "reserve";
                function sort_native() -> void as "sort";

            public:
                constructor();
                constructor(T...: items);

                function size() const -> long int;
                function capacity() const -> long int;
                function empty() const -> bool;
                function is_inline() const -> bool as "is_using_inline_storage";
                function data() -> T* as "walnut_rt::coll::data";
                function data() const -> const T* as "walnut_rt::coll::data";
                function begin() -> T* as "walnut_rt::coll::begin";
                function begin() const -> const T* as "walnut_rt::coll::begin";
                function end() -> T* as "walnut_rt::coll::end";
                function end() const -> const T* as "walnut_rt::coll::end";

                function rbegin() -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(data(), size() - 1);
                } end function rbegin

                function rend() -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(data(), -1);
                } end function rend

                function rbegin() const -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(data(), size() - 1);
                } end function rbegin

                function rend() const -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(data(), -1);
                } end function rend

                function backwards() -> std::iterators::Range<std::iterators::Pointer<T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<T, true>>(rbegin(), rend());
                } end function backwards

                function backwards() const -> std::iterators::Range<std::iterators::Pointer<const T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<const T, true>>(rbegin(), rend());
                } end function backwards

                operator([]) function(long int: index) -> T& {
                    check(index);
                    return data()[index];
                }

                operator([]) function(long int: index) const -> const T& {
                    check(index);
                    return data()[index];
                }

                function at(long int: index) -> T& {
                    check(index);
                    return data()[index];
                } end function at

                function at(long int: index) const -> const T& {
                    check(index);
                    return data()[index];
                } end function at

                function front() -> T& {
                    if (empty()) then {
                        throw detail::empty_error("front()");
                    }
                    return data()[0];
                } end function front

                function back() -> T& {
                    if (empty()) then {
                        throw detail::empty_error("back()");
                    }
                    return data()[size() - 1];
                } end function back

                function reserve(long int: wanted) -> void {
                    if (wanted > capacity()) then {
                        reserve_more(wanted);
                    }
                } end function reserve

                function push_back(const T&: value) -> void;
                function push_back(T&&: value) -> void;

                function pop_back() -> T {
                    if (empty()) then {
                        throw detail::empty_error("pop_back()");
                    }
                    return take_back();
                } end function pop_back

                function insert(long int: index, const T&: value) -> void {
                    if (index < 0 || index > size()) then {
                        throw detail::out_of_range(index, size());
                    }
                    insert_at(index, value);
                } end function insert

                function erase(long int: index) -> T {
                    check(index);
                    return take_at(index);
                } end function erase

                function remove(const T&: value) -> long int {
                    const long int: removed = detail::compact(data(), size(), value);
                    remove_range(size() - removed, size());
                    return removed;
                } end function remove

                function resize(long int: count) -> void {
                    if (count < 0) then {
                        throw detail::out_of_range(count, size());
                    }
                    grow(count);
                } end function resize

                function resize(long int: count, const T&: value) -> void {
                    if (count < 0) then {
                        throw detail::out_of_range(count, size());
                    }
                    grow_with(count, value);
                } end function resize

                function clear() -> void;
                function shrink_to_fit() -> void;
                function reverse() -> void;

                function find(const T&: value) const -> long int {
                    return detail::find_in(data(), size(), value);
                } end function find

                function contains(const T&: value) const -> bool {
                    return detail::contains_in(data(), size(), value);
                } end function contains

                function sort() -> void {
                    if constexpr (std::traits::is_builtin_number<T> || std::traits::is_string<T> || std::traits::is_enum<T> || std::traits::is_bool<T> || std::traits::is_char<T>) then {
                        sort_native();
                    } else then {
                        detail::sort_range(data(), size());
                    }
                } end function sort

                function sort(std::Compare<T>: comp) -> void {
                    std::algorithms::sort(data(), data() + size(), comp);
                } end function sort

                function sort_descending() -> void {
                    std::algorithms::sort_descending(data(), data() + size());
                } end function sort_descending

                template <typename K>
                function sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::sort_by(data(), data() + size(), key);
                } end function sort_by

                function stable_sort() -> void {
                    std::algorithms::stable_sort(data(), data() + size());
                } end function stable_sort

                function stable_sort(std::Compare<T>: comp) -> void {
                    std::algorithms::stable_sort(data(), data() + size(), comp);
                } end function stable_sort

                template <typename K>
                function stable_sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::stable_sort_by(data(), data() + size(), key);
                } end function stable_sort_by

                function heap_sort() -> void {
                    std::algorithms::heap_sort(data(), data() + size());
                } end function heap_sort

                function quick_sort() -> void {
                    std::algorithms::quick_sort(data(), data() + size());
                } end function quick_sort

                function merge_sort() -> void {
                    std::algorithms::merge_sort(data(), data() + size());
                } end function merge_sort

                function insertion_sort() -> void {
                    std::algorithms::insertion_sort(data(), data() + size());
                } end function insertion_sort

                function selection_sort() -> void {
                    std::algorithms::selection_sort(data(), data() + size());
                } end function selection_sort

                function bubble_sort() -> void {
                    std::algorithms::bubble_sort(data(), data() + size());
                } end function bubble_sort

                function shell_sort() -> void {
                    std::algorithms::shell_sort(data(), data() + size());
                } end function shell_sort

                function counting_sort(bool: descending = false) -> void {
                    std::algorithms::counting_sort(data(), data() + size(), descending);
                } end function counting_sort

                function radix_sort() -> void {
                    std::algorithms::radix_sort(data(), data() + size());
                } end function radix_sort

                function partial_sort(long int: count) -> void {
                    const long int: k = count < size() ? count : size();
                    std::algorithms::partial_sort(data(), data() + k, data() + size());
                } end function partial_sort

                function nth_element(long int: index) -> void {
                    check(index);
                    std::algorithms::nth_element(data(), data() + index, data() + size());
                } end function nth_element

                function is_sorted() const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size());
                } end function is_sorted

                function is_sorted(std::Compare<T>: comp) const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size(), comp);
                } end function is_sorted

                function sorted() const -> SmallVector {
                    SmallVector: out = *this;
                    out.sort();
                    return out;
                } end function sorted

                function sorted(std::Compare<T>: comp) const -> SmallVector {
                    SmallVector: out = *this;
                    std::algorithms::sort(out.data(), out.data() + out.size(), comp);
                    return out;
                } end function sorted

                function reversed() const -> SmallVector {
                    SmallVector: out = *this;
                    std::algorithms::reverse(out.data(), out.data() + out.size());
                    return out;
                } end function reversed

                function binary_search(const T&: value) const -> bool {
                    return std::algorithms::binary_search(data(), data() + size(), value);
                } end function binary_search

                function lower_bound(const T&: value) const -> long int {
                    return std::algorithms::lower_bound(data(), data() + size(), value) - data();
                } end function lower_bound

                function upper_bound(const T&: value) const -> long int {
                    return std::algorithms::upper_bound(data(), data() + size(), value) - data();
                } end function upper_bound

                function binary_find(const T&: value) const -> long int {
                    const T*: it = std::algorithms::binary_find(data(), data() + size(), value);
                    return it == data() + size() ? -1 : it - data();
                } end function binary_find

                function insert_sorted(const T&: value) -> long int {
                    const long int: at = upper_bound(value);
                    insert(at, value);
                    return at;
                } end function insert_sorted

                function insert_sorted(const T&: value, std::Compare<T>: comp) -> long int {
                    const long int: at = std::algorithms::upper_bound(data(), data() + size(), value, comp) - data();
                    insert(at, value);
                    return at;
                } end function insert_sorted

                function find_if(std::Predicate<T>: pred) const -> long int {
                    return std::algorithms::index_if(data(), data() + size(), pred);
                } end function find_if

                function find_last(const T&: value) const -> long int {
                    for (long int: i = size() - 1; i >= 0; i--) {
                        if (data()[i] == value) then {
                            return i;
                        }
                    }
                    return -1;
                } end function find_last

                function find_last_if(std::Predicate<T>: pred) const -> long int {
                    for (long int: i = size() - 1; i >= 0; i--) {
                        if (pred(data()[i])) then {
                            return i;
                        }
                    }
                    return -1;
                } end function find_last_if

                function find_all(const T&: value) const -> Vector<long int> {
                    Vector<long int>: out;
                    for (long int: i = 0; i < size(); i++) {
                        if (data()[i] == value) then {
                            out.push_back(i);
                        }
                    }
                    return out;
                } end function find_all

                function count(const T&: value) const -> long int {
                    return std::algorithms::count(data(), data() + size(), value);
                } end function count

                function count_if(std::Predicate<T>: pred) const -> long int {
                    return std::algorithms::count_if(data(), data() + size(), pred);
                } end function count_if

                function contains_if(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::contains_if(data(), data() + size(), pred);
                } end function contains_if

                function all_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::all_of(data(), data() + size(), pred);
                } end function all_of

                function any_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::any_of(data(), data() + size(), pred);
                } end function any_of

                function none_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::none_of(data(), data() + size(), pred);
                } end function none_of

                function min_index() const -> long int {
                    return empty() ? -1 : std::algorithms::min_element(data(), data() + size()) - data();
                } end function min_index

                function max_index() const -> long int {
                    return empty() ? -1 : std::algorithms::max_element(data(), data() + size()) - data();
                } end function max_index

                function min() const -> T {
                    if (empty()) then {
                        throw detail::empty_error("min()");
                    }
                    return *std::algorithms::min_element(data(), data() + size());
                } end function min

                function max() const -> T {
                    if (empty()) then {
                        throw detail::empty_error("max()");
                    }
                    return *std::algorithms::max_element(data(), data() + size());
                } end function max

                function sum() const -> T {
                    if (empty()) then {
                        return T();
                    }
                    T: total = data()[0];
                    for (long int: i = 1; i < size(); i++) {
                        total = total + data()[i];
                    }
                    return total;
                } end function sum

                template <typename U>
                function accumulate(U: init, std::Combine<U, T>: op) const -> U {
                    return std::algorithms::accumulate(data(), data() + size(), init, op);
                } end function accumulate

                function for_each(std::Action<T>: func) -> void {
                    std::algorithms::for_each(data(), data() + size(), func);
                } end function for_each

                function for_each_indexed(function(long int, T&) -> void: func) -> void {
                    std::algorithms::for_each_indexed(data(), data() + size(), func);
                } end function for_each_indexed

                function transform(std::Transform<T, T>: func) -> void {
                    std::algorithms::transform_in_place(data(), data() + size(), func);
                } end function transform

                template <typename U>
                function map(std::Transform<T, U>: func) const -> Vector<U> {
                    Vector<U>: out;
                    out.reserve(size());
                    for (long int: i = 0; i < size(); i++) {
                        out.push_back(func(data()[i]));
                    }
                    return out;
                } end function map

                function filter(std::Predicate<T>: pred) const -> SmallVector {
                    SmallVector: out;
                    for (long int: i = 0; i < size(); i++) {
                        if (pred(data()[i])) then {
                            out.push_back(data()[i]);
                        }
                    }
                    return out;
                } end function filter

                function remove_if(std::Predicate<T>: pred) -> long int {
                    const long int: kept = std::algorithms::remove_if(data(), data() + size(), pred) - data();
                    const long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function remove_if

                function retain_if(std::Predicate<T>: pred) -> long int {
                    return remove_if([&pred](const T&: x) -> bool { return !pred(x); });
                } end function retain_if

                function remove_at(long int: index) -> T {
                    return erase(index);
                } end function remove_at

                function remove_unordered(long int: index) -> T {
                    check(index);
                    const long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                    return pop_back();
                } end function remove_unordered

                function swap_remove(long int: index) -> T {
                    return remove_unordered(index);
                } end function swap_remove

                function erase_unordered(long int: index) -> T {
                    return remove_unordered(index);
                } end function erase_unordered

                function take_at_unordered(long int: index) -> T {
                    return remove_unordered(index);
                } end function take_at_unordered

                function remove_at_unordered(long int: index) -> T {
                    return remove_unordered(index);
                } end function remove_at_unordered

                function remove_first_unordered(const T&: value) -> bool {
                    const long int: at = find(value);
                    if (at < 0) then {
                        return false;
                    }
                    remove_unordered(at);
                    return true;
                } end function remove_first_unordered

                function remove_all_unordered(const T&: value) -> long int {
                    return remove_if_unordered([&value](const T&: x) -> bool { return x == value; });
                } end function remove_all_unordered

                function remove_if_unordered(std::Predicate<T>: drop) -> long int {
                    long int: removed = 0;
                    long int: i = 0;
                    while (i < size()) {
                        if (drop(data()[i])) then {
                            remove_unordered(i);
                            removed += 1;
                        } else then {
                            i += 1;
                        }
                    }
                    return removed;
                } end function remove_if_unordered

                function retain_if_unordered(std::Predicate<T>: keep) -> long int {
                    return remove_if_unordered([&keep](const T&: x) -> bool { return !keep(x); });
                } end function retain_if_unordered

                function remove_range_unordered(long int: start, long int: stop) -> void {
                    if (start < 0 || start > size()) then {
                        throw detail::out_of_range(start, size());
                    }
                    if (stop < start || stop > size()) then {
                        throw detail::out_of_range(stop, size());
                    }
                    const long int: count = stop - start;
                    const long int: n = size();
                    for (long int: k = 0; k < count; k++) {
                        const long int: hole = start + k;
                        const long int: source = n - 1 - k;
                        if (source >= stop && source > hole) then {
                            data()[hole] = std::core::move(data()[source]);
                        }
                    }
                    for (long int: k = 0; k < count; k++) {
                        pop_back();
                    }
                } end function remove_range_unordered

                function remove_first(const T&: value) -> bool {
                    const long int: at = find(value);
                    if (at < 0) then {
                        return false;
                    }
                    erase(at);
                    return true;
                } end function remove_first

                function unique() -> long int {
                    const long int: kept = std::algorithms::unique(data(), data() + size()) - data();
                    const long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function unique

                function deduplicate() -> long int {
                    long int: kept = 0;
                    for (long int: i = 0; i < size(); i++) {
                        bool: seen = false;
                        for (long int: j = 0; j < kept; j++) {
                            if (data()[j] == data()[i]) then {
                                seen = true;
                                break;
                            }
                        }
                        if (!seen) then {
                            if (kept != i) then {
                                data()[kept] = std::core::move(data()[i]);
                            }
                            kept += 1;
                        }
                    }
                    const long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function deduplicate

                function distinct() const -> SmallVector {
                    SmallVector: out = *this;
                    out.deduplicate();
                    return out;
                } end function distinct

                function replace(const T&: old_value, const T&: new_value) -> long int {
                    return std::algorithms::replace(data(), data() + size(), old_value, new_value);
                } end function replace

                function replace_if(std::Predicate<T>: pred, const T&: new_value) -> long int {
                    return std::algorithms::replace_if(data(), data() + size(), pred, new_value);
                } end function replace_if

                function rotate_left(long int: steps = 1) -> void {
                    std::algorithms::rotate_left(data(), data() + size(), steps);
                } end function rotate_left

                function rotate_right(long int: steps = 1) -> void {
                    std::algorithms::rotate_right(data(), data() + size(), steps);
                } end function rotate_right

                function shuffle() -> void {
                    std::algorithms::shuffle(data(), data() + size());
                } end function shuffle

                function swap_items(long int: a, long int: b) -> void {
                    check(a);
                    check(b);
                    std::algorithms::detail::swap_values(data()[a], data()[b]);
                } end function swap_items

                function partition(std::Predicate<T>: pred) -> long int {
                    return std::algorithms::partition(data(), data() + size(), pred) - data();
                } end function partition

                function stable_partition(std::Predicate<T>: pred) -> long int {
                    return std::algorithms::stable_partition(data(), data() + size(), pred) - data();
                } end function stable_partition

                function append(const T&: value) -> void {
                    push_back(value);
                } end function append

                function prepend(const T&: value) -> void {
                    insert(0, value);
                } end function prepend

                function insert_n(long int: index, long int: count, const T&: value) -> void {
                    for (long int: k = 0; k < count; k++) {
                        insert(index, value);
                    }
                } end function insert_n

                function insert_all(long int: index, const SmallVector&: items) -> void {
                    for (long int: k = 0; k < items.size(); k++) {
                        insert(index + k, items[k]);
                    }
                } end function insert_all

                function append_n(long int: count, const T&: value) -> void {
                    for (long int: k = 0; k < count; k++) {
                        push_back(value);
                    }
                } end function append_n

                function insert_unordered(long int: index, const T&: value) -> void {
                    if (index < 0 || index > size()) then {
                        throw detail::out_of_range(index, size());
                    }
                    push_back(value);
                    const long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                } end function insert_unordered

                function take(long int: count) const -> SmallVector {
                    SmallVector: out;
                    for (long int: i = 0; i < count && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function take

                function skip(long int: count) const -> SmallVector {
                    SmallVector: out;
                    for (long int: i = count < 0 ? 0 : count; i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function skip

                function slice(long int: start, long int: stop) const -> SmallVector {
                    SmallVector: out;
                    for (long int: i = start < 0 ? 0 : start; i < stop && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function slice

                function sliced(long int: start, long int: stop, long int: step, bool: has_start, bool: has_stop) const -> SmallVector {
                    if (step == 0) then {
                        throw std::errors::collection_error("a slice's step can't be 0");
                    }
                    const long int: n = size();
                    const long int: low = step > 0 ? 0 : -1;
                    const long int: high = step > 0 ? n : n - 1;
                    long int: first = step > 0 ? 0 : n - 1;
                    long int: last = step > 0 ? n : -1;
                    if (has_start) then {
                        first = start < 0 ? start + n : start;
                        first = first < low ? low : (first > high ? high : first);
                    }
                    if (has_stop) then {
                        last = stop < 0 ? stop + n : stop;
                        last = last < low ? low : (last > high ? high : last);
                    }
                    SmallVector: out;
                    for (long int: i = first; step > 0 ? i < last : i > last; i += step) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function sliced

                function starts_with(const SmallVector&: prefix) const -> bool {
                    return std::algorithms::starts_with(data(), data() + size(), prefix.data(), prefix.data() + prefix.size());
                } end function starts_with

                function ends_with(const SmallVector&: suffix) const -> bool {
                    return std::algorithms::ends_with(data(), data() + size(), suffix.data(), suffix.data() + suffix.size());
                } end function ends_with

                function where(const T&: value) -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::equal_to(*this, value);
                } end function where

                function where(std::Predicate<T>: pred) -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::matching(*this, pred);
                } end function where

                function where_indices(const Vector<long int>&: indices) -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::at_indices(*this, indices);
                } end function where_indices

                function all() -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::matching(*this, [](const T&: x) -> bool { return true; });
                } end function all

                function swap(SmallVector&: other) -> void;

                operator(==) function(const SmallVector&: other) const -> bool {
                    return detail::same_items(data(), size(), other.data(), other.size());
                }

                operator(!=) function(const SmallVector&: other) const -> bool {
                    return !detail::same_items(data(), size(), other.data(), other.size());
                }
            } end class SmallVector
        } end extern


        template <typename T>
        class LinkedList {
            struct Node {
                T: value;
                Node*: prev = nullptr;
                Node*: next = nullptr;
            } end struct Node

            Node*: m_head = nullptr;
            Node*: m_tail = nullptr;
            long int: m_size = 0;

            function node_at(long int: index) const -> Node* {
                if (index < 0 || index >= m_size) then {
                    throw detail::out_of_range(index, m_size);
                }
                Node*: n = m_head;
                for (long int: i = 0; i < index; i++) {
                    n = n->next;
                }
                return n;
            } end function node_at

            function unlink(Node*: n) -> T {
                if (n->prev != nullptr) then {
                    n->prev->next = n->next;
                } else then {
                    m_head = n->next;
                }
                if (n->next != nullptr) then {
                    n->next->prev = n->prev;
                } else then {
                    m_tail = n->prev;
                }
                T: out = std::core::move(n->value);
                delete n;
                m_size -= 1;
                return out;
            } end function unlink

        public:
            using Iterator = std::iterators::Linked<Node, T>;
            using ReverseIterator = std::iterators::Linked<Node, T, true>;

            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    push_back(item);
                }
            }

            constructor(const LinkedList&: other) {
                for (Node*: n = other.m_head; n != nullptr; n = n->next) {
                    push_back(n->value);
                }
            }

            constructor(LinkedList&&: other) : m_head = other.m_head, m_tail = other.m_tail, m_size = other.m_size {
                other.m_head = nullptr;
                other.m_tail = nullptr;
                other.m_size = 0;
            }

            destructor() {
                clear();
            }

            operator(=) function(const LinkedList&: other) -> LinkedList& {
                if (this == &other) then {
                    return *this;
                }
                clear();
                for (Node*: n = other.m_head; n != nullptr; n = n->next) {
                    push_back(n->value);
                }
                return *this;
            }

            operator(=) function(LinkedList&&: other) -> LinkedList& {
                if (this == &other) then {
                    return *this;
                }
                clear();
                m_head = other.m_head;
                m_tail = other.m_tail;
                m_size = other.m_size;
                other.m_head = nullptr;
                other.m_tail = nullptr;
                other.m_size = 0;
                return *this;
            }

            function size() const -> long int {
                return m_size;
            } end function size

            function empty() const -> bool {
                return m_size == 0;
            } end function empty

            function begin() const -> Iterator {
                return Iterator(m_head);
            } end function begin

            function end() const -> Iterator {
                return Iterator(nullptr);
            } end function end

            function rbegin() const -> ReverseIterator {
                return ReverseIterator(m_tail);
            } end function rbegin

            function rend() const -> ReverseIterator {
                return ReverseIterator(nullptr);
            } end function rend

            function backwards() const -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(rbegin(), rend());
            } end function backwards

            function front() -> T& {
                if (m_size == 0) then {
                    throw detail::empty_error("front()");
                }
                return m_head->value;
            } end function front

            function back() -> T& {
                if (m_size == 0) then {
                    throw detail::empty_error("back()");
                }
                return m_tail->value;
            } end function back

            function push_back(const T&: value) -> void {
                Node*: n = new Node;
                n->value = value;
                n->prev = m_tail;
                if (m_tail != nullptr) then {
                    m_tail->next = n;
                } else then {
                    m_head = n;
                }
                m_tail = n;
                m_size += 1;
            } end function push_back

            function push_front(const T&: value) -> void {
                Node*: n = new Node;
                n->value = value;
                n->next = m_head;
                if (m_head != nullptr) then {
                    m_head->prev = n;
                } else then {
                    m_tail = n;
                }
                m_head = n;
                m_size += 1;
            } end function push_front

            function pop_back() -> T {
                if (m_size == 0) then {
                    throw detail::empty_error("pop_back()");
                }
                return unlink(m_tail);
            } end function pop_back

            function pop_front() -> T {
                if (m_size == 0) then {
                    throw detail::empty_error("pop_front()");
                }
                return unlink(m_head);
            } end function pop_front

            operator([]) function(long int: index) -> T& {
                return node_at(index)->value;
            }

            function at(long int: index) -> T& {
                return node_at(index)->value;
            } end function at

            function insert(long int: index, const T&: value) -> void {
                if (index == m_size) then {
                    push_back(value);
                    return;
                }
                Node*: after = node_at(index);
                Node*: n = new Node;
                n->value = value;
                n->next = after;
                n->prev = after->prev;
                if (after->prev != nullptr) then {
                    after->prev->next = n;
                } else then {
                    m_head = n;
                }
                after->prev = n;
                m_size += 1;
            } end function insert

            function erase(long int: index) -> T {
                return unlink(node_at(index));
            } end function erase

            function remove(const T&: value) -> long int {
                long int: removed = 0;
                Node*: n = m_head;
                while (n != nullptr) {
                    Node*: next = n->next;
                    if (n->value == value) then {
                        unlink(n);
                        removed += 1;
                    }
                    n = next;
                }
                return removed;
            } end function remove

            function clear() -> void {
                Node*: n = m_head;
                while (n != nullptr) {
                    Node*: next = n->next;
                    delete n;
                    n = next;
                }
                m_head = nullptr;
                m_tail = nullptr;
                m_size = 0;
            } end function clear

            function find(const T&: value) const -> long int {
                long int: i = 0;
                for (Node*: n = m_head; n != nullptr; n = n->next) {
                    if (n->value == value) then {
                        return i;
                    }
                    i += 1;
                }
                return undefined;
            } end function find

            function contains(const T&: value) const -> bool {
                for (Node*: n = m_head; n != nullptr; n = n->next) {
                    if (n->value == value) then {
                        return true;
                    }
                }
                return false;
            } end function contains

            function reverse() -> void {
                Node*: n = m_head;
                while (n != nullptr) {
                    Node*: next = n->next;
                    n->next = n->prev;
                    n->prev = next;
                    n = next;
                }
                Node*: old_head = m_head;
                m_head = m_tail;
                m_tail = old_head;
            } end function reverse

            function to_vector() const -> Vector<T> {
                Vector<T>: out;
                for (const T&: x in *this) {
                    out.push_back(x);
                }
                return out;
            } end function to_vector

            function count(const T&: value) const -> long int {
                long int: n = 0;
                for (const T&: x in *this) {
                    if (x == value) then {
                        n += 1;
                    }
                }
                return n;
            } end function count

            function count_if(std::Predicate<T>: pred) const -> long int {
                long int: n = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        n += 1;
                    }
                }
                return n;
            } end function count_if

            function find_if(std::Predicate<T>: pred) const -> long int {
                long int: i = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        return i;
                    }
                    i += 1;
                }
                return -1;
            } end function find_if

            function contains_if(std::Predicate<T>: pred) const -> bool {
                return find_if(pred) >= 0;
            } end function contains_if

            function all_of(std::Predicate<T>: pred) const -> bool {
                return count_if(pred) == size();
            } end function all_of

            function any_of(std::Predicate<T>: pred) const -> bool {
                return find_if(pred) >= 0;
            } end function any_of

            function none_of(std::Predicate<T>: pred) const -> bool {
                return find_if(pred) < 0;
            } end function none_of

            function for_each(std::Action<T>: func) -> void {
                for (T&: x in *this) {
                    func(x);
                }
            } end function for_each

            function transform(std::Transform<T, T>: func) -> void {
                for (T&: x in *this) {
                    x = func(x);
                }
            } end function transform

            function sort(std::Compare<T>: comp) -> void {
                Vector<T>: items = to_vector();
                std::algorithms::sort(items.data(), items.data() + items.size(), comp);
                long int: i = 0;
                for (T&: x in *this) {
                    x = std::core::move(items[i]);
                    i += 1;
                }
            } end function sort

            function sort() -> void {
                sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function sort

            function stable_sort(std::Compare<T>: comp) -> void {
                Vector<T>: items = to_vector();
                std::algorithms::stable_sort(items.data(), items.data() + items.size(), comp);
                long int: i = 0;
                for (T&: x in *this) {
                    x = std::core::move(items[i]);
                    i += 1;
                }
            } end function stable_sort

            function stable_sort() -> void {
                stable_sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function stable_sort

            function is_sorted() const -> bool {
                Vector<T>: items = to_vector();
                return std::algorithms::is_sorted(items.data(), items.data() + items.size());
            } end function is_sorted

            function min() const -> T {
                if (empty()) then {
                    throw detail::empty_error("min()");
                }
                Vector<T>: items = to_vector();
                return *std::algorithms::min_element(items.data(), items.data() + items.size());
            } end function min

            function max() const -> T {
                if (empty()) then {
                    throw detail::empty_error("max()");
                }
                Vector<T>: items = to_vector();
                return *std::algorithms::max_element(items.data(), items.data() + items.size());
            } end function max

            function where(const T&: value) -> WhereQuery<LinkedList, T> {
                return WhereQuery<LinkedList, T>::equal_to(*this, value);
            } end function where

            function where(std::Predicate<T>: pred) -> WhereQuery<LinkedList, T> {
                return WhereQuery<LinkedList, T>::matching(*this, pred);
            } end function where
        } end class LinkedList

        template <typename T>
        class Deque {
            T*: m_data = nullptr;
            long int: m_capacity = 0;
            long int: m_head = 0;
            long int: m_size = 0;

            function slot(long int: index) const -> long int {
                return (m_head + index) % m_capacity;
            } end function slot

            function grow_to(long int: wanted) -> void {
                if (wanted <= m_capacity) then {
                    return;
                }
                T*: fresh = new T[wanted];
                for (long int: i = 0; i < m_size; i++) {
                    fresh[i] = std::core::move(m_data[slot(i)]);
                }
                if (m_data != nullptr) then {
                    delete[] m_data;
                }
                m_data = fresh;
                m_capacity = wanted;
                m_head = 0;
            } end function grow_to

            function check(long int: index) const -> void {
                if (index < 0 || index >= m_size) then {
                    throw detail::out_of_range(index, m_size);
                }
            } end function check

        public:
            using Iterator = std::iterators::Indexed<Deque, T>;
            using ReverseIterator = std::iterators::Indexed<Deque, T, true>;

            constructor() { }

            constructor(T...: items) {
                grow_to(countof(items));
                for (const T&: item in items) {
                    push_back(item);
                }
            }

            constructor(const Deque&: other) {
                grow_to(other.m_size);
                for (long int: i = 0; i < other.m_size; i++) {
                    m_data[i] = other.m_data[other.slot(i)];
                }
                m_size = other.m_size;
            }

            constructor(Deque&&: other) : m_data = other.m_data, m_capacity = other.m_capacity, m_head = other.m_head, m_size = other.m_size {
                other.m_data = nullptr;
                other.m_capacity = 0;
                other.m_head = 0;
                other.m_size = 0;
            }

            destructor() {
                if (m_data != nullptr) then {
                    delete[] m_data;
                }
            }

            operator(=) function(const Deque&: other) -> Deque& {
                if (this == &other) then {
                    return *this;
                }
                clear();
                grow_to(other.m_size);
                m_head = 0;
                for (long int: i = 0; i < other.m_size; i++) {
                    m_data[i] = other.m_data[other.slot(i)];
                }
                m_size = other.m_size;
                return *this;
            }

            operator(=) function(Deque&&: other) -> Deque& {
                if (this == &other) then {
                    return *this;
                }
                if (m_data != nullptr) then {
                    delete[] m_data;
                }
                m_data = other.m_data;
                m_capacity = other.m_capacity;
                m_head = other.m_head;
                m_size = other.m_size;
                other.m_data = nullptr;
                other.m_capacity = 0;
                other.m_head = 0;
                other.m_size = 0;
                return *this;
            }

            function size() const -> long int {
                return m_size;
            } end function size

            function empty() const -> bool {
                return m_size == 0;
            } end function empty

            function begin() -> Iterator {
                return Iterator(this, 0);
            } end function begin

            function end() -> Iterator {
                return Iterator(this, m_size);
            } end function end

            function begin() const -> Iterator {
                return Iterator(const_cast<Deque*>(this), 0);
            } end function begin

            function end() const -> Iterator {
                return Iterator(const_cast<Deque*>(this), m_size);
            } end function end

            function rbegin() -> ReverseIterator {
                return ReverseIterator(this, m_size - 1);
            } end function rbegin

            function rend() -> ReverseIterator {
                return ReverseIterator(this, -1);
            } end function rend

            function rbegin() const -> ReverseIterator {
                return ReverseIterator(const_cast<Deque*>(this), m_size - 1);
            } end function rbegin

            function rend() const -> ReverseIterator {
                return ReverseIterator(const_cast<Deque*>(this), -1);
            } end function rend

            function backwards() const -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(rbegin(), rend());
            } end function backwards

            operator([]) function(long int: index) -> T& {
                check(index);
                return m_data[slot(index)];
            }

            operator([]) function(long int: index) const -> const T& {
                check(index);
                return m_data[slot(index)];
            }

            function at(long int: index) -> T& {
                check(index);
                return m_data[slot(index)];
            } end function at

            function front() -> T& {
                if (m_size == 0) then {
                    throw detail::empty_error("front()");
                }
                return m_data[m_head];
            } end function front

            function back() -> T& {
                if (m_size == 0) then {
                    throw detail::empty_error("back()");
                }
                return m_data[slot(m_size - 1)];
            } end function back

            function push_back(const T&: value) -> void {
                if (m_size == m_capacity) then {
                    grow_to(detail::grown(m_capacity, m_size + 1));
                }
                m_data[slot(m_size)] = value;
                m_size += 1;
            } end function push_back

            function push_front(const T&: value) -> void {
                if (m_size == m_capacity) then {
                    grow_to(detail::grown(m_capacity, m_size + 1));
                }
                m_head = (m_head + m_capacity - 1) % m_capacity;
                m_data[m_head] = value;
                m_size += 1;
            } end function push_front

            function pop_back() -> T {
                if (m_size == 0) then {
                    throw detail::empty_error("pop_back()");
                }
                const long int: at = slot(m_size - 1);
                T: out = std::core::move(m_data[at]);
                m_data[at] = T();
                m_size -= 1;
                return out;
            } end function pop_back

            function pop_front() -> T {
                if (m_size == 0) then {
                    throw detail::empty_error("pop_front()");
                }
                T: out = std::core::move(m_data[m_head]);
                m_data[m_head] = T();
                m_head = (m_head + 1) % m_capacity;
                m_size -= 1;
                return out;
            } end function pop_front

            function clear() -> void {
                for (long int: i = 0; i < m_size; i++) {
                    m_data[slot(i)] = T();
                }
                m_head = 0;
                m_size = 0;
            } end function clear

            function find(const T&: value) const -> long int {
                for (long int: i = 0; i < m_size; i++) {
                    if (m_data[slot(i)] == value) then {
                        return i;
                    }
                }
                return undefined;
            } end function find

            function contains(const T&: value) const -> bool {
                for (long int: i = 0; i < m_size; i++) {
                    if (m_data[slot(i)] == value) then {
                        return true;
                    }
                }
                return false;
            } end function contains

            function to_vector() const -> Vector<T> {
                Vector<T>: out;
                for (const T&: x in *this) {
                    out.push_back(x);
                }
                return out;
            } end function to_vector

            function count(const T&: value) const -> long int {
                long int: n = 0;
                for (const T&: x in *this) {
                    if (x == value) then {
                        n += 1;
                    }
                }
                return n;
            } end function count

            function count_if(std::Predicate<T>: pred) const -> long int {
                long int: n = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        n += 1;
                    }
                }
                return n;
            } end function count_if

            function find_if(std::Predicate<T>: pred) const -> long int {
                long int: i = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        return i;
                    }
                    i += 1;
                }
                return -1;
            } end function find_if

            function contains_if(std::Predicate<T>: pred) const -> bool {
                return find_if(pred) >= 0;
            } end function contains_if

            function all_of(std::Predicate<T>: pred) const -> bool {
                return count_if(pred) == size();
            } end function all_of

            function any_of(std::Predicate<T>: pred) const -> bool {
                return find_if(pred) >= 0;
            } end function any_of

            function none_of(std::Predicate<T>: pred) const -> bool {
                return find_if(pred) < 0;
            } end function none_of

            function for_each(std::Action<T>: func) -> void {
                for (T&: x in *this) {
                    func(x);
                }
            } end function for_each

            function transform(std::Transform<T, T>: func) -> void {
                for (T&: x in *this) {
                    x = func(x);
                }
            } end function transform

            function sort(std::Compare<T>: comp) -> void {
                Vector<T>: items = to_vector();
                std::algorithms::sort(items.data(), items.data() + items.size(), comp);
                long int: i = 0;
                for (T&: x in *this) {
                    x = std::core::move(items[i]);
                    i += 1;
                }
            } end function sort

            function sort() -> void {
                sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function sort

            function stable_sort(std::Compare<T>: comp) -> void {
                Vector<T>: items = to_vector();
                std::algorithms::stable_sort(items.data(), items.data() + items.size(), comp);
                long int: i = 0;
                for (T&: x in *this) {
                    x = std::core::move(items[i]);
                    i += 1;
                }
            } end function stable_sort

            function stable_sort() -> void {
                stable_sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function stable_sort

            function is_sorted() const -> bool {
                Vector<T>: items = to_vector();
                return std::algorithms::is_sorted(items.data(), items.data() + items.size());
            } end function is_sorted

            function min() const -> T {
                if (empty()) then {
                    throw detail::empty_error("min()");
                }
                Vector<T>: items = to_vector();
                return *std::algorithms::min_element(items.data(), items.data() + items.size());
            } end function min

            function max() const -> T {
                if (empty()) then {
                    throw detail::empty_error("max()");
                }
                Vector<T>: items = to_vector();
                return *std::algorithms::max_element(items.data(), items.data() + items.size());
            } end function max

            function where(const T&: value) -> WhereQuery<Deque, T> {
                return WhereQuery<Deque, T>::equal_to(*this, value);
            } end function where

            function where(std::Predicate<T>: pred) -> WhereQuery<Deque, T> {
                return WhereQuery<Deque, T>::matching(*this, pred);
            } end function where
        } end class Deque

        template <typename T>
        class Stack {
            Vector<T>: m_items;

        public:
            constructor() { }

            function push(const T&: value) -> void {
                m_items.push_back(value);
            } end function push

            function pop() -> T {
                if (m_items.empty()) then {
                    throw detail::empty_error("pop()");
                }
                return m_items.pop_back();
            } end function pop

            function top() -> T& {
                if (m_items.empty()) then {
                    throw detail::empty_error("top()");
                }
                return m_items.back();
            } end function top

            function size() const -> long int {
                return m_items.size();
            } end function size

            function empty() const -> bool {
                return m_items.empty();
            } end function empty

            function clear() -> void {
                m_items.clear();
            } end function clear
        } end class Stack

        template <typename T>
        class Queue {
            Deque<T>: m_items;

        public:
            constructor() { }

            function push(const T&: value) -> void {
                m_items.push_back(value);
            } end function push

            function pop() -> T {
                if (m_items.empty()) then {
                    throw detail::empty_error("pop()");
                }
                return m_items.pop_front();
            } end function pop

            function front() -> T& {
                if (m_items.empty()) then {
                    throw detail::empty_error("front()");
                }
                return m_items.front();
            } end function front

            function back() -> T& {
                if (m_items.empty()) then {
                    throw detail::empty_error("back()");
                }
                return m_items.back();
            } end function back

            function size() const -> long int {
                return m_items.size();
            } end function size

            function empty() const -> bool {
                return m_items.empty();
            } end function empty

            function clear() -> void {
                m_items.clear();
            } end function clear
        } end class Queue

        template <typename T, bool Largest = true>
        class PriorityQueue {
            Vector<T>: m_heap;

            function before(const T&: a, const T&: b) const -> bool {
                if constexpr (Largest) then {
                    return a < b;
                } else then {
                    return b < a;
                }
            } end function before

        public:
            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    push(item);
                }
            }

            function push(const T&: value) -> void {
                m_heap.push_back(value);
                long int: child = m_heap.size() - 1;
                while (child > 0) {
                    const long int: parent = (child - 1) / 2;
                    if (!before(m_heap[parent], m_heap[child])) then {
                        break;
                    }
                    detail::swap_items(m_heap[parent], m_heap[child]);
                    child = parent;
                }
            } end function push

            function top() const -> const T& {
                if (m_heap.empty()) then {
                    throw detail::empty_error("top()");
                }
                return m_heap[0];
            } end function top

            function pop() -> T {
                if (m_heap.empty()) then {
                    throw detail::empty_error("pop()");
                }
                const long int: last = m_heap.size() - 1;
                detail::swap_items(m_heap[0], m_heap[last]);
                T: out = m_heap.pop_back();
                const long int: count = m_heap.size();
                long int: root = 0;
                while (root * 2 + 1 < count) {
                    long int: child = root * 2 + 1;
                    if (child + 1 < count && before(m_heap[child], m_heap[child + 1])) then {
                        child += 1;
                    }
                    if (!before(m_heap[root], m_heap[child])) then {
                        break;
                    }
                    detail::swap_items(m_heap[root], m_heap[child]);
                    root = child;
                }
                return out;
            } end function pop

            function size() const -> long int {
                return m_heap.size();
            } end function size

            function empty() const -> bool {
                return m_heap.empty();
            } end function empty

            function clear() -> void {
                m_heap.clear();
            } end function clear
        } end class PriorityQueue

        function hash_text(const string&: s) -> unsigned long int {
            unsigned long int: h = 14695981039346656037ul;
            for (char: c in s) {
                h = (h ^ static_cast<unsigned long int>(static_cast<long int>(c))) * 1099511628211ul;
            }
            return h;
        } end function hash_text

        template <typename T>
        function hash_of(const T&: value) -> unsigned long int {
            if constexpr (std::traits::is_bool<T>) then {
                return value ? 1ul : 0ul;
            } else if constexpr (std::traits::is_char<T>) then {
                return detail::mix(static_cast<unsigned long int>(static_cast<long int>(value)));
            } else if constexpr (std::traits::is_enum<T>) then {
                return detail::mix(static_cast<unsigned long int>(static_cast<long long int>(value)));
            } else if constexpr (std::traits::is_builtin_integer<T>) then {
                return detail::mix(static_cast<unsigned long int>(value));
            } else if constexpr (std::traits::is_builtin_float<T>) then {
                return hash_text(static_cast<string>(`${value}`));
            } else if constexpr (std::traits::is_string<T>) then {
                return hash_text(static_cast<string>(value));
            } else if constexpr (std::traits::is_pointer<T>) then {
                return detail::mix(reinterpret_cast<unsigned long int>(value));
            } else then {
                return value.hash();
            }
        } end function hash_of

        template <typename A, typename B>
        function hash_of(const Pair<A, B>&: p) -> unsigned long int {
            return hash_of(p.first) * 31ul + hash_of(p.second);
        } end function hash_of

        template <typename K, typename V>
        class UnorderedMap {
            Pair<K, V>*: m_slots = nullptr;
            char*: m_state = nullptr;
            long int: m_capacity = 0;
            long int: m_size = 0;
            long int: m_used = 0;

            function slot_of(const K&: key) const -> long int {
                if (m_capacity == 0) then {
                    return -1;
                }
                long int: i = static_cast<long int>(hash_of(key) % static_cast<unsigned long int>(m_capacity));
                while (m_state[i] != '\0') {
                    if (m_state[i] == 'f' && m_slots[i].first == key) then {
                        return i;
                    }
                    i = (i + 1) % m_capacity;
                }
                return -1;
            } end function slot_of

            function rehash(long int: wanted) -> void {
                Pair<K, V>*: old_slots = m_slots;
                char*: old_state = m_state;
                const long int: old_capacity = m_capacity;
                m_slots = new Pair<K, V>[wanted];
                m_state = new char[wanted];
                for (long int: i = 0; i < wanted; i++) {
                    m_state[i] = '\0';
                }
                m_capacity = wanted;
                m_size = 0;
                m_used = 0;
                for (long int: i = 0; i < old_capacity; i++) {
                    if (old_state[i] == 'f') then {
                        place(std::core::move(old_slots[i].first), std::core::move(old_slots[i].second));
                    }
                }
                if (old_slots != nullptr) then {
                    delete[] old_slots;
                    delete[] old_state;
                }
            } end function rehash

            function place(const K&: key, const V&: value) -> long int {
                long int: i = static_cast<long int>(hash_of(key) % static_cast<unsigned long int>(m_capacity));
                long int: reuse = -1;
                while (m_state[i] != '\0') {
                    if (m_state[i] == 'f' && m_slots[i].first == key) then {
                        return i;
                    }
                    if (m_state[i] == 'd' && reuse < 0) then {
                        reuse = i;
                    }
                    i = (i + 1) % m_capacity;
                }
                if (reuse >= 0) then {
                    i = reuse;
                } else then {
                    m_used += 1;
                }
                m_slots[i].first = key;
                m_slots[i].second = value;
                m_state[i] = 'f';
                m_size += 1;
                return i;
            } end function place

            function make_room() -> void {
                if (m_capacity == 0) then {
                    rehash(8);
                } else if ((m_used + 1) * 4 > m_capacity * 3) then {
                    rehash(m_size * 2 < 8 ? 8 : m_size * 4);
                }
            } end function make_room

            function copy_from(const UnorderedMap&: other) -> void {
                if (other.m_capacity == 0) then {
                    return;
                }
                rehash(other.m_capacity);
                for (long int: i = 0; i < other.m_capacity; i++) {
                    if (other.m_state[i] == 'f') then {
                        place(other.m_slots[i].first, other.m_slots[i].second);
                    }
                }
            } end function copy_from

            function release() -> void {
                if (m_slots != nullptr) then {
                    delete[] m_slots;
                    delete[] m_state;
                }
                m_slots = nullptr;
                m_state = nullptr;
                m_capacity = 0;
                m_size = 0;
                m_used = 0;
            } end function release

        public:
            using Iterator = std::iterators::Sparse<Pair<K, V>>;
            using ReverseIterator = std::iterators::Sparse<Pair<K, V>, true>;

            constructor() { }

            constructor(const UnorderedMap&: other) {
                copy_from(other);
            }

            constructor(UnorderedMap&&: other) : m_slots = other.m_slots, m_state = other.m_state, m_capacity = other.m_capacity, m_size = other.m_size, m_used = other.m_used {
                other.m_slots = nullptr;
                other.m_state = nullptr;
                other.m_capacity = 0;
                other.m_size = 0;
                other.m_used = 0;
            }

            destructor() {
                release();
            }

            operator(=) function(const UnorderedMap&: other) -> UnorderedMap& {
                if (this == &other) then {
                    return *this;
                }
                release();
                copy_from(other);
                return *this;
            }

            operator(=) function(UnorderedMap&&: other) -> UnorderedMap& {
                if (this == &other) then {
                    return *this;
                }
                release();
                m_slots = other.m_slots;
                m_state = other.m_state;
                m_capacity = other.m_capacity;
                m_size = other.m_size;
                m_used = other.m_used;
                other.m_slots = nullptr;
                other.m_state = nullptr;
                other.m_capacity = 0;
                other.m_size = 0;
                other.m_used = 0;
                return *this;
            }

            function size() const -> long int {
                return m_size;
            } end function size

            function empty() const -> bool {
                return m_size == 0;
            } end function empty

            function begin() const -> Iterator {
                return Iterator(m_slots, m_state, m_capacity, 0);
            } end function begin

            function end() const -> Iterator {
                return Iterator(m_slots, m_state, m_capacity, m_capacity);
            } end function end

            function rbegin() const -> ReverseIterator {
                return ReverseIterator(m_slots, m_state, m_capacity, m_capacity - 1);
            } end function rbegin

            function rend() const -> ReverseIterator {
                return ReverseIterator(m_slots, m_state, m_capacity, -1);
            } end function rend

            function backwards() const -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(rbegin(), rend());
            } end function backwards

            function insert(const K&: key, const V&: value) -> bool {
                if (slot_of(key) >= 0) then {
                    return false;
                }
                make_room();
                place(key, value);
                return true;
            } end function insert

            function set(const K&: key, const V&: value) -> void {
                const long int: at = slot_of(key);
                if (at >= 0) then {
                    m_slots[at].second = value;
                    return;
                }
                make_room();
                place(key, value);
            } end function set

            operator([]) function(const K&: key) -> V& {
                long int: at = slot_of(key);
                if (at < 0) then {
                    make_room();
                    at = place(key, V());
                }
                return m_slots[at].second;
            }

            function at(const K&: key) -> V& {
                const long int: index = slot_of(key);
                if (index < 0) then {
                    throw std::errors::collection_error(static_cast<string>(`the key isn't in the map`));
                }
                return m_slots[index].second;
            } end function at

            function find(const K&: key) -> V* {
                const long int: index = slot_of(key);
                return index < 0 ? nullptr : &m_slots[index].second;
            } end function find

            function get(const K&: key, const V&: fallback) const -> V {
                const long int: index = slot_of(key);
                return index < 0 ? fallback : m_slots[index].second;
            } end function get

            function contains(const K&: key) const -> bool {
                return slot_of(key) >= 0;
            } end function contains

            function remove(const K&: key) -> bool {
                const long int: index = slot_of(key);
                if (index < 0) then {
                    return false;
                }
                m_slots[index] = Pair<K, V>();
                m_state[index] = 'd';
                m_size -= 1;
                return true;
            } end function remove

            function clear() -> void {
                release();
            } end function clear

            function reserve(long int: count) -> void {
                long int: wanted = 8;
                while (wanted * 3 < count * 4) {
                    wanted *= 2;
                }
                if (wanted > m_capacity) then {
                    rehash(wanted);
                }
            } end function reserve

            function keys() const -> Vector<K> {
                Vector<K>: out;
                for (long int: i = 0; i < m_capacity; i++) {
                    if (m_state[i] == 'f') then {
                        out.push_back(m_slots[i].first);
                    }
                }
                return out;
            } end function keys

            function values() const -> Vector<V> {
                Vector<V>: out;
                for (long int: i = 0; i < m_capacity; i++) {
                    if (m_state[i] == 'f') then {
                        out.push_back(m_slots[i].second);
                    }
                }
                return out;
            } end function values
        } end class UnorderedMap

        template <typename T>
        class UnorderedSet {
            UnorderedMap<T, bool>: m_items;

        public:
            using Iterator = std::iterators::Keys<UnorderedMap<T, bool>::Iterator, const T>;
            using ReverseIterator = std::iterators::Keys<UnorderedMap<T, bool>::ReverseIterator, const T>;

            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    m_items.insert(item, true);
                }
            }

            function size() const -> long int {
                return m_items.size();
            } end function size

            function empty() const -> bool {
                return m_items.empty();
            } end function empty

            function begin() const -> Iterator {
                return Iterator(m_items.begin());
            } end function begin

            function end() const -> Iterator {
                return Iterator(m_items.end());
            } end function end

            function rbegin() const -> ReverseIterator {
                return ReverseIterator(m_items.rbegin());
            } end function rbegin

            function rend() const -> ReverseIterator {
                return ReverseIterator(m_items.rend());
            } end function rend

            function backwards() const -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(rbegin(), rend());
            } end function backwards

            function insert(const T&: value) -> bool {
                return m_items.insert(value, true);
            } end function insert

            function contains(const T&: value) const -> bool {
                return m_items.contains(value);
            } end function contains

            function remove(const T&: value) -> bool {
                return m_items.remove(value);
            } end function remove

            function clear() -> void {
                m_items.clear();
            } end function clear

            function to_vector() const -> Vector<T> {
                return m_items.keys();
            } end function to_vector
        } end class UnorderedSet

        namespace detail {
            template <typename E>
            struct TreeNode {
                E: entry;
                TreeNode<E>*: left = nullptr;
                TreeNode<E>*: right = nullptr;
                TreeNode<E>*: parent = nullptr;
                long int: count = 1;
                bool: red = true;
            } end struct TreeNode

            template <typename E>
            function tree_count(TreeNode<E>*: n) -> long int {
                return n == nullptr ? 0 : n->count;
            } end function tree_count

            template <typename E>
            function tree_first(TreeNode<E>*: n) -> TreeNode<E>* {
                if (n == nullptr) then {
                    return nullptr;
                }
                TreeNode<E>*: at = n;
                while (at->left != nullptr) {
                    at = at->left;
                }
                return at;
            } end function tree_first

            template <typename E>
            function tree_last(TreeNode<E>*: n) -> TreeNode<E>* {
                if (n == nullptr) then {
                    return nullptr;
                }
                TreeNode<E>*: at = n;
                while (at->right != nullptr) {
                    at = at->right;
                }
                return at;
            } end function tree_last

            template <typename E>
            function tree_next(TreeNode<E>*: n) -> TreeNode<E>* {
                if (n->right != nullptr) then {
                    return tree_first(n->right);
                }
                TreeNode<E>*: at = n;
                TreeNode<E>*: up = n->parent;
                while (up != nullptr && at == up->right) {
                    at = up;
                    up = up->parent;
                }
                return up;
            } end function tree_next

            template <typename E>
            function tree_copy(TreeNode<E>*: source, TreeNode<E>*: parent) -> TreeNode<E>* {
                if (source == nullptr) then {
                    return nullptr;
                }
                TreeNode<E>*: n = new TreeNode<E>;
                n->entry = source->entry;
                n->count = source->count;
                n->red = source->red;
                n->parent = parent;
                n->left = tree_copy(source->left, n);
                n->right = tree_copy(source->right, n);
                return n;
            } end function tree_copy

            template <typename E>
            function tree_free(TreeNode<E>*: n) -> void {
                TreeNode<E>*: at = n;
                while (at != nullptr) {
                    tree_free(at->right);
                    TreeNode<E>*: left = at->left;
                    delete at;
                    at = left;
                }
            } end function tree_free

            template <typename K, typename E>
            class Tree {
            public:
                TreeNode<E>*: m_root = nullptr;

                static function key_of(const E&: entry) -> const K& {
                    if constexpr (std::traits::is_same<E, K>) then {
                        return entry;
                    } else then {
                        return entry.first;
                    }
                } end function key_of

                constructor() { }

                constructor(const Tree&: other) : m_root = tree_copy<E>(other.m_root, nullptr) { }

                constructor(Tree&&: other) : m_root = other.m_root {
                    other.m_root = nullptr;
                }

                destructor() {
                    tree_free(m_root);
                }

                operator(=) function(const Tree&: other) -> Tree& {
                    if (this != &other) then {
                        tree_free(m_root);
                        m_root = tree_copy<E>(other.m_root, nullptr);
                    }
                    return *this;
                }

                operator(=) function(Tree&&: other) -> Tree& {
                    if (this != &other) then {
                        tree_free(m_root);
                        m_root = other.m_root;
                        other.m_root = nullptr;
                    }
                    return *this;
                }

                function size() const -> long int {
                    return tree_count(m_root);
                } end function size

                function clear() -> void {
                    tree_free(m_root);
                    m_root = nullptr;
                } end function clear

                function find(const K&: key) const -> TreeNode<E>* {
                    TreeNode<E>*: at = m_root;
                    while (at != nullptr) {
                        if (key < key_of(at->entry)) then {
                            at = at->left;
                        } else if (key_of(at->entry) < key) then {
                            at = at->right;
                        } else then {
                            return at;
                        }
                    }
                    return nullptr;
                } end function find

                function lower(const K&: key) const -> TreeNode<E>* {
                    TreeNode<E>*: at = m_root;
                    TreeNode<E>*: best = nullptr;
                    while (at != nullptr) {
                        if (key_of(at->entry) < key) then {
                            at = at->right;
                        } else then {
                            best = at;
                            at = at->left;
                        }
                    }
                    return best;
                } end function lower

                function upper(const K&: key) const -> TreeNode<E>* {
                    TreeNode<E>*: at = m_root;
                    TreeNode<E>*: best = nullptr;
                    while (at != nullptr) {
                        if (key < key_of(at->entry)) then {
                            best = at;
                            at = at->left;
                        } else then {
                            at = at->right;
                        }
                    }
                    return best;
                } end function upper

                function nth(long int: index) const -> TreeNode<E>* {
                    long int: left_over = index;
                    TreeNode<E>*: at = m_root;
                    while (at != nullptr) {
                        const long int: smaller = tree_count(at->left);
                        if (left_over < smaller) then {
                            at = at->left;
                        } else if (left_over == smaller) then {
                            return at;
                        } else then {
                            left_over -= smaller + 1;
                            at = at->right;
                        }
                    }
                    return nullptr;
                } end function nth

                function rank(TreeNode<E>*: n) const -> long int {
                    long int: r = tree_count(n->left);
                    TreeNode<E>*: at = n;
                    while (at->parent != nullptr) {
                        if (at == at->parent->right) then {
                            r += tree_count(at->parent->left) + 1;
                        }
                        at = at->parent;
                    }
                    return r;
                } end function rank

                function rotate_left(TreeNode<E>*: x) -> void {
                    TreeNode<E>*: y = x->right;
                    x->right = y->left;
                    if (y->left != nullptr) then {
                        y->left->parent = x;
                    }
                    y->parent = x->parent;
                    if (x->parent == nullptr) then {
                        m_root = y;
                    } else if (x == x->parent->left) then {
                        x->parent->left = y;
                    } else then {
                        x->parent->right = y;
                    }
                    y->left = x;
                    x->parent = y;
                    y->count = x->count;
                    x->count = tree_count(x->left) + tree_count(x->right) + 1;
                } end function rotate_left

                function rotate_right(TreeNode<E>*: x) -> void {
                    TreeNode<E>*: y = x->left;
                    x->left = y->right;
                    if (y->right != nullptr) then {
                        y->right->parent = x;
                    }
                    y->parent = x->parent;
                    if (x->parent == nullptr) then {
                        m_root = y;
                    } else if (x == x->parent->right) then {
                        x->parent->right = y;
                    } else then {
                        x->parent->left = y;
                    }
                    y->right = x;
                    x->parent = y;
                    y->count = x->count;
                    x->count = tree_count(x->left) + tree_count(x->right) + 1;
                } end function rotate_right

                function insert(const E&: entry, bool&: added) -> TreeNode<E>* {
                    const K&: key = key_of(entry);
                    TreeNode<E>*: parent = nullptr;
                    TreeNode<E>*: at = m_root;
                    bool: go_left = false;
                    while (at != nullptr) {
                        parent = at;
                        if (key < key_of(at->entry)) then {
                            go_left = true;
                            at = at->left;
                        } else if (key_of(at->entry) < key) then {
                            go_left = false;
                            at = at->right;
                        } else then {
                            added = false;
                            return at;
                        }
                    }
                    TreeNode<E>*: n = new TreeNode<E>;
                    n->entry = entry;
                    n->parent = parent;
                    if (parent == nullptr) then {
                        m_root = n;
                    } else if (go_left) then {
                        parent->left = n;
                    } else then {
                        parent->right = n;
                    }
                    for (TreeNode<E>*: up = parent; up != nullptr; up = up->parent) {
                        up->count += 1;
                    }
                    insert_fixup(n);
                    added = true;
                    return n;
                } end function insert

                function insert_fixup(TreeNode<E>*: node) -> void {
                    TreeNode<E>*: z = node;
                    while (z != m_root && z->parent->red) {
                        TreeNode<E>*: p = z->parent;
                        TreeNode<E>*: g = p->parent;
                        if (p == g->left) then {
                            TreeNode<E>*: uncle = g->right;
                            if (uncle != nullptr && uncle->red) then {
                                p->red = false;
                                uncle->red = false;
                                g->red = true;
                                z = g;
                            } else then {
                                if (z == p->right) then {
                                    z = p;
                                    rotate_left(z);
                                    p = z->parent;
                                }
                                p->red = false;
                                g->red = true;
                                rotate_right(g);
                            }
                        } else then {
                            TreeNode<E>*: uncle = g->left;
                            if (uncle != nullptr && uncle->red) then {
                                p->red = false;
                                uncle->red = false;
                                g->red = true;
                                z = g;
                            } else then {
                                if (z == p->left) then {
                                    z = p;
                                    rotate_right(z);
                                    p = z->parent;
                                }
                                p->red = false;
                                g->red = true;
                                rotate_left(g);
                            }
                        }
                    }
                    m_root->red = false;
                } end function insert_fixup

                function replace(TreeNode<E>*: old_node, TreeNode<E>*: new_node) -> void {
                    if (old_node->parent == nullptr) then {
                        m_root = new_node;
                    } else if (old_node == old_node->parent->left) then {
                        old_node->parent->left = new_node;
                    } else then {
                        old_node->parent->right = new_node;
                    }
                    if (new_node != nullptr) then {
                        new_node->parent = old_node->parent;
                    }
                } end function replace

                function erase(TreeNode<E>*: z) -> void {
                    TreeNode<E>*: x = nullptr;
                    TreeNode<E>*: xp = nullptr;
                    bool: removed_red = z->red;
                    if (z->left == nullptr) then {
                        x = z->right;
                        xp = z->parent;
                        replace(z, z->right);
                    } else if (z->right == nullptr) then {
                        x = z->left;
                        xp = z->parent;
                        replace(z, z->left);
                    } else then {
                        TreeNode<E>*: y = tree_first(z->right);
                        removed_red = y->red;
                        x = y->right;
                        if (y->parent == z) then {
                            xp = y;
                        } else then {
                            xp = y->parent;
                            replace(y, y->right);
                            y->right = z->right;
                            y->right->parent = y;
                        }
                        replace(z, y);
                        y->left = z->left;
                        y->left->parent = y;
                        y->red = z->red;
                    }
                    for (TreeNode<E>*: up = xp; up != nullptr; up = up->parent) {
                        up->count = tree_count(up->left) + tree_count(up->right) + 1;
                    }
                    delete z;
                    if (!removed_red) then {
                        erase_fixup(x, xp);
                    }
                } end function erase

                function erase_fixup(TreeNode<E>*: node, TreeNode<E>*: node_parent) -> void {
                    TreeNode<E>*: x = node;
                    TreeNode<E>*: xp = node_parent;
                    while (x != m_root && (x == nullptr || !x->red)) {
                        if (x == xp->left) then {
                            TreeNode<E>*: w = xp->right;
                            if (w->red) then {
                                w->red = false;
                                xp->red = true;
                                rotate_left(xp);
                                w = xp->right;
                            }
                            const bool: left_black = w->left == nullptr || !w->left->red;
                            const bool: right_black = w->right == nullptr || !w->right->red;
                            if (left_black && right_black) then {
                                w->red = true;
                                x = xp;
                                xp = x->parent;
                            } else then {
                                if (right_black) then {
                                    w->left->red = false;
                                    w->red = true;
                                    rotate_right(w);
                                    w = xp->right;
                                }
                                w->red = xp->red;
                                xp->red = false;
                                if (w->right != nullptr) then {
                                    w->right->red = false;
                                }
                                rotate_left(xp);
                                x = m_root;
                                xp = nullptr;
                            }
                        } else then {
                            TreeNode<E>*: w = xp->left;
                            if (w->red) then {
                                w->red = false;
                                xp->red = true;
                                rotate_right(xp);
                                w = xp->left;
                            }
                            const bool: left_black = w->left == nullptr || !w->left->red;
                            const bool: right_black = w->right == nullptr || !w->right->red;
                            if (left_black && right_black) then {
                                w->red = true;
                                x = xp;
                                xp = x->parent;
                            } else then {
                                if (left_black) then {
                                    w->right->red = false;
                                    w->red = true;
                                    rotate_left(w);
                                    w = xp->left;
                                }
                                w->red = xp->red;
                                xp->red = false;
                                if (w->left != nullptr) then {
                                    w->left->red = false;
                                }
                                rotate_right(xp);
                                x = m_root;
                                xp = nullptr;
                            }
                        }
                    }
                    if (x != nullptr) then {
                        x->red = false;
                    }
                } end function erase_fixup

                function check() const -> long int {
                    if (m_root != nullptr && m_root->red) then {
                        return -1;
                    }
                    return check_node(m_root);
                } end function check

                function check_node(TreeNode<E>*: n) const -> long int {
                    if (n == nullptr) then {
                        return 1;
                    }
                    if (n->red && ((n->left != nullptr && n->left->red) || (n->right != nullptr && n->right->red))) then {
                        return -1;
                    }
                    if (n->count != tree_count(n->left) + tree_count(n->right) + 1) then {
                        return -1;
                    }
                    if (n->left != nullptr && (n->left->parent != n || !(key_of(n->left->entry) < key_of(n->entry)))) then {
                        return -1;
                    }
                    if (n->right != nullptr && (n->right->parent != n || !(key_of(n->entry) < key_of(n->right->entry)))) then {
                        return -1;
                    }
                    const long int: lh = check_node(n->left);
                    const long int: rh = check_node(n->right);
                    if (lh < 0 || rh < 0 || lh != rh) then {
                        return -1;
                    }
                    return lh + (n->red ? 0 : 1);
                } end function check_node
            } end class Tree
        } end namespace detail

        template <typename K, typename V>
        class Map {
            detail::Tree<K, Pair<K, V>>: m_tree;

        public:
            using Iterator = std::iterators::Tree<detail::TreeNode<Pair<K, V>>, Pair<K, V>>;
            using ReverseIterator = std::iterators::Tree<detail::TreeNode<Pair<K, V>>, Pair<K, V>, true>;

            constructor() { }

            function size() const -> long int {
                return m_tree.size();
            } end function size

            function empty() const -> bool {
                return m_tree.m_root == nullptr;
            } end function empty

            function begin() const -> Iterator {
                return Iterator(detail::tree_first(m_tree.m_root));
            } end function begin

            function end() const -> Iterator {
                return Iterator(nullptr);
            } end function end

            function rbegin() const -> ReverseIterator {
                return ReverseIterator(detail::tree_last(m_tree.m_root));
            } end function rbegin

            function rend() const -> ReverseIterator {
                return ReverseIterator(nullptr);
            } end function rend

            function backwards() const -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(rbegin(), rend());
            } end function backwards

            function insert(const K&: key, const V&: value) -> bool {
                bool: added = false;
                m_tree.insert(Pair<K, V>(key, value), added);
                return added;
            } end function insert

            function set(const K&: key, const V&: value) -> void {
                bool: added = false;
                detail::TreeNode<Pair<K, V>>*: n = m_tree.insert(Pair<K, V>(key, value), added);
                if (!added) then {
                    n->entry.second = value;
                }
            } end function set

            operator([]) function(const K&: key) -> V& {
                detail::TreeNode<Pair<K, V>>*: n = m_tree.find(key);
                if (n == nullptr) then {
                    bool: added = false;
                    n = m_tree.insert(Pair<K, V>(key, V()), added);
                }
                return n->entry.second;
            }

            function at(const K&: key) -> V& {
                detail::TreeNode<Pair<K, V>>*: n = m_tree.find(key);
                if (n == nullptr) then {
                    throw std::errors::collection_error(static_cast<string>(`the key isn't in the map`));
                }
                return n->entry.second;
            } end function at

            function find(const K&: key) -> V* {
                detail::TreeNode<Pair<K, V>>*: n = m_tree.find(key);
                return n == nullptr ? nullptr : &n->entry.second;
            } end function find

            function get(const K&: key, const V&: fallback) const -> V {
                detail::TreeNode<Pair<K, V>>*: n = m_tree.find(key);
                return n == nullptr ? fallback : n->entry.second;
            } end function get

            function contains(const K&: key) const -> bool {
                return m_tree.find(key) != nullptr;
            } end function contains

            function remove(const K&: key) -> bool {
                detail::TreeNode<Pair<K, V>>*: n = m_tree.find(key);
                if (n == nullptr) then {
                    return false;
                }
                m_tree.erase(n);
                return true;
            } end function remove

            function clear() -> void {
                m_tree.clear();
            } end function clear

            function keys() const -> Vector<K> {
                Vector<K>: out;
                out.reserve(size());
                for (detail::TreeNode<Pair<K, V>>*: n = detail::tree_first(m_tree.m_root); n != nullptr; n = detail::tree_next(n)) {
                    out.push_back(n->entry.first);
                }
                return out;
            } end function keys

            function values() const -> Vector<V> {
                Vector<V>: out;
                out.reserve(size());
                for (detail::TreeNode<Pair<K, V>>*: n = detail::tree_first(m_tree.m_root); n != nullptr; n = detail::tree_next(n)) {
                    out.push_back(n->entry.second);
                }
                return out;
            } end function values

            function first() -> Pair<K, V>& {
                if (m_tree.m_root == nullptr) then {
                    throw detail::empty_error("first()");
                }
                return detail::tree_first(m_tree.m_root)->entry;
            } end function first

            function last() -> Pair<K, V>& {
                if (m_tree.m_root == nullptr) then {
                    throw detail::empty_error("last()");
                }
                return detail::tree_last(m_tree.m_root)->entry;
            } end function last

            function entry_at(long int: index) -> Pair<K, V>& {
                if (index < 0 || index >= size()) then {
                    throw detail::out_of_range(index, size());
                }
                return m_tree.nth(index)->entry;
            } end function entry_at

            function lower_bound(const K&: key) const -> Iterator {
                return Iterator(m_tree.lower(key));
            } end function lower_bound

            function upper_bound(const K&: key) const -> Iterator {
                return Iterator(m_tree.upper(key));
            } end function upper_bound
        } end class Map

        template <typename T>
        class Set {
            detail::Tree<T, T>: m_tree;

        public:
            using Iterator = std::iterators::Tree<detail::TreeNode<T>, const T>;
            using ReverseIterator = std::iterators::Tree<detail::TreeNode<T>, const T, true>;

            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    insert(item);
                }
            }

            function size() const -> long int {
                return m_tree.size();
            } end function size

            function empty() const -> bool {
                return m_tree.m_root == nullptr;
            } end function empty

            function begin() const -> Iterator {
                return Iterator(detail::tree_first(m_tree.m_root));
            } end function begin

            function end() const -> Iterator {
                return Iterator(nullptr);
            } end function end

            function rbegin() const -> ReverseIterator {
                return ReverseIterator(detail::tree_last(m_tree.m_root));
            } end function rbegin

            function rend() const -> ReverseIterator {
                return ReverseIterator(nullptr);
            } end function rend

            function backwards() const -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(rbegin(), rend());
            } end function backwards

            function insert(const T&: value) -> bool {
                bool: added = false;
                m_tree.insert(value, added);
                return added;
            } end function insert

            function contains(const T&: value) const -> bool {
                return m_tree.find(value) != nullptr;
            } end function contains

            function remove(const T&: value) -> bool {
                detail::TreeNode<T>*: n = m_tree.find(value);
                if (n == nullptr) then {
                    return false;
                }
                m_tree.erase(n);
                return true;
            } end function remove

            function clear() -> void {
                m_tree.clear();
            } end function clear

            operator([]) function(long int: index) const -> const T& {
                if (index < 0 || index >= size()) then {
                    throw detail::out_of_range(index, size());
                }
                return m_tree.nth(index)->entry;
            }

            function index_of(const T&: value) const -> long int {
                detail::TreeNode<T>*: n = m_tree.find(value);
                if (n == nullptr) then {
                    return undefined;
                }
                return m_tree.rank(n);
            } end function index_of

            function first() const -> const T& {
                if (m_tree.m_root == nullptr) then {
                    throw detail::empty_error("first()");
                }
                return detail::tree_first(m_tree.m_root)->entry;
            } end function first

            function last() const -> const T& {
                if (m_tree.m_root == nullptr) then {
                    throw detail::empty_error("last()");
                }
                return detail::tree_last(m_tree.m_root)->entry;
            } end function last

            function lower_bound(const T&: value) const -> Iterator {
                return Iterator(m_tree.lower(value));
            } end function lower_bound

            function upper_bound(const T&: value) const -> Iterator {
                return Iterator(m_tree.upper(value));
            } end function upper_bound

            function to_vector() const -> Vector<T> {
                Vector<T>: out;
                out.reserve(size());
                for (detail::TreeNode<T>*: n = detail::tree_first(m_tree.m_root); n != nullptr; n = detail::tree_next(n)) {
                    out.push_back(n->entry);
                }
                return out;
            } end function to_vector
        } end class Set

        extern "C++" from "<walnut_trie.hpp>" {
            template <typename V>
            class TrieMap as "walnut_rt::trie::map" {
                function slot(const string&: key) -> V&;

            public:
                constructor();
                constructor(bool: ignore_case);

                static function ignoring_case() -> TrieMap {
                    return TrieMap(true);
                } end function ignoring_case

                function ignores_case() const -> bool;
                function size() const -> long int;
                function empty() const -> bool;
                function clear() -> void;
                function insert(const string&: key, const V&: value) -> bool;
                function set(const string&: key, const V&: value) -> bool;
                function find(const string&: key) -> V*;
                function find(const string&: key) const -> const V*;
                function contains(const string&: key) const -> bool;
                function remove(const string&: key) -> bool;
                function has_prefix(const string&: prefix) const -> bool;
                function count_prefix(const string&: prefix) const -> long int;
                function keys_with_prefix(const string&: prefix, long int: limit) const -> Vector<string>;
                function values_with_prefix(const string&: prefix, long int: limit) const -> Vector<V>;
                function keys() const -> Vector<string>;
                function complete(const string&: prefix) const -> string;
                function longest_prefix_of(const string&: subject) const -> long int;
                function nearest(const string&: word, long int: max_distance, long int: limit) const -> Vector<string>;
                function nearest_distances(const string&: word, long int: max_distance, long int: limit) const -> Vector<long int>;

                operator([]) function(const string&: key) -> V& {
                    return slot(key);
                }

                function at(const string&: key) -> V& {
                    V*: found = find(key);
                    if (found == nullptr) then {
                        throw std::errors::collection_error(static_cast<string>(`"${key}" isn't in the trie`));
                    }
                    return *found;
                } end function at

                function get(const string&: key, const V&: fallback) const -> V {
                    const V*: found = find(key);
                    return found == nullptr ? fallback : *found;
                } end function get

                function keys_with_prefix(const string&: prefix) const -> Vector<string> {
                    return keys_with_prefix(prefix, -1);
                } end function keys_with_prefix

                function values_with_prefix(const string&: prefix) const -> Vector<V> {
                    return values_with_prefix(prefix, -1);
                } end function values_with_prefix

                function entries_with_prefix(const string&: prefix) const -> Vector<Pair<string, V>> {
                    Vector<Pair<string, V>>: out;
                    for (const string&: key in keys_with_prefix(prefix, -1)) {
                        out.push_back(Pair<string, V>(key, *find(key)));
                    }
                    return out;
                } end function entries_with_prefix

                function nearest(const string&: word, long int: max_distance) const -> Vector<string> {
                    return nearest(word, max_distance, 10);
                } end function nearest
            } end class TrieMap

            class Trie as "walnut_rt::trie::set" {
            public:
                constructor();
                constructor(bool: ignore_case);

                constructor(string...: words) {
                    for (const string&: word in words) {
                        insert(word);
                    }
                }

                static function ignoring_case() -> Trie {
                    return Trie(true);
                } end function ignoring_case

                function ignores_case() const -> bool;
                function size() const -> long int;
                function empty() const -> bool;
                function clear() -> void;
                function insert(const string&: word) -> bool;
                function contains(const string&: word) const -> bool;
                function remove(const string&: word) -> bool;
                function has_prefix(const string&: prefix) const -> bool;
                function count_prefix(const string&: prefix) const -> long int;
                function with_prefix(const string&: prefix, long int: limit) const -> Vector<string>;
                function words() const -> Vector<string>;
                function complete(const string&: prefix) const -> string;
                function longest_prefix_of(const string&: subject) const -> long int;
                function nearest(const string&: word, long int: max_distance, long int: limit) const -> Vector<string>;
                function nearest_distances(const string&: word, long int: max_distance, long int: limit) const -> Vector<long int>;

                function with_prefix(const string&: prefix) const -> Vector<string> {
                    return with_prefix(prefix, -1);
                } end function with_prefix

                function nearest(const string&: word, long int: max_distance) const -> Vector<string> {
                    return nearest(word, max_distance, 10);
                } end function nearest
            } end class Trie
        } end extern

        using TrieSet = Trie;

        template <typename K, typename V>
        class Cache {
            UnorderedMap<K, long int>: m_index;
            Vector<K>: m_keys;
            Vector<V>: m_values;
            Vector<long int>: m_newer;
            Vector<long int>: m_older;
            Vector<long int>: m_free;
            long int: m_newest = -1;
            long int: m_oldest = -1;
            long int: m_capacity = 256;
            long int: m_hits = 0;
            long int: m_misses = 0;
            long int: m_evictions = 0;

            function unlink(long int: slot) -> void {
                const long int: newer = m_newer[slot];
                const long int: older = m_older[slot];
                if (newer >= 0) then {
                    m_older[newer] = older;
                } else then {
                    m_newest = older;
                }
                if (older >= 0) then {
                    m_newer[older] = newer;
                } else then {
                    m_oldest = newer;
                }
                m_newer[slot] = -1;
                m_older[slot] = -1;
            } end function unlink

            function make_newest(long int: slot) -> void {
                m_newer[slot] = -1;
                m_older[slot] = m_newest;
                if (m_newest >= 0) then {
                    m_newer[m_newest] = slot;
                }
                m_newest = slot;
                if (m_oldest < 0) then {
                    m_oldest = slot;
                }
            } end function make_newest

            function touch(long int: slot) -> void {
                if (slot == m_newest) then {
                    return;
                }
                unlink(slot);
                make_newest(slot);
            } end function touch

            function drop(long int: slot) -> void {
                unlink(slot);
                m_index.remove(m_keys[slot]);
                m_keys[slot] = K();
                m_values[slot] = V();
                m_free.push_back(slot);
            } end function drop

            function trim(long int: room) -> void {
                if (m_capacity <= 0) then {
                    return;
                }
                while (m_oldest >= 0 && m_index.size() + room > m_capacity) {
                    drop(m_oldest);
                    m_evictions += 1;
                }
            } end function trim

            function add(const K&: key, const V&: value) -> long int {
                trim(1);
                long int: slot = -1;
                if (m_free.empty()) then {
                    slot = m_keys.size();
                    m_keys.push_back(key);
                    m_values.push_back(value);
                    m_newer.push_back(-1);
                    m_older.push_back(-1);
                } else then {
                    slot = m_free.pop_back();
                    m_keys[slot] = key;
                    m_values[slot] = value;
                }
                m_index.set(key, slot);
                make_newest(slot);
                return slot;
            } end function add

            function slot_of(const K&: key) const -> long int {
                return m_index.get(key, -1);
            } end function slot_of

        public:
            constructor() { }

            constructor(long int: capacity) : m_capacity = capacity { }

            function size() const -> long int {
                return m_index.size();
            } end function size

            function empty() const -> bool {
                return m_index.empty();
            } end function empty

            function capacity() const -> long int {
                return m_capacity;
            } end function capacity

            function set_capacity(long int: capacity) -> void {
                m_capacity = capacity;
                trim(0);
            } end function set_capacity

            function put(const K&: key, const V&: value) -> void {
                const long int: slot = slot_of(key);
                if (slot >= 0) then {
                    m_values[slot] = value;
                    touch(slot);
                    return;
                }
                add(key, value);
            } end function put

            function find(const K&: key) -> V* {
                const long int: slot = slot_of(key);
                if (slot < 0) then {
                    m_misses += 1;
                    return nullptr;
                }
                m_hits += 1;
                touch(slot);
                return &m_values[slot];
            } end function find

            function peek(const K&: key) const -> const V* {
                const long int: slot = slot_of(key);
                return slot < 0 ? nullptr : &m_values[slot];
            } end function peek

            function get(const K&: key, const V&: fallback) -> V {
                V*: found = find(key);
                return found == nullptr ? fallback : *found;
            } end function get

            function get_or_add(const K&: key, std::Supplier<V>: make) -> V& {
                V*: found = find(key);
                if (found != nullptr) then {
                    return *found;
                }
                const V: made = make();
                return m_values[add(key, made)];
            } end function get_or_add

            function get_or_compute(const K&: key, std::Transform<K, V>: make) -> V& {
                V*: found = find(key);
                if (found != nullptr) then {
                    return *found;
                }
                const V: made = make(key);
                return m_values[add(key, made)];
            } end function get_or_compute

            function contains(const K&: key) const -> bool {
                return slot_of(key) >= 0;
            } end function contains

            function remove(const K&: key) -> bool {
                const long int: slot = slot_of(key);
                if (slot < 0) then {
                    return false;
                }
                drop(slot);
                return true;
            } end function remove

            function clear() -> void {
                m_index.clear();
                m_keys.clear();
                m_values.clear();
                m_newer.clear();
                m_older.clear();
                m_free.clear();
                m_newest = -1;
                m_oldest = -1;
            } end function clear

            function hits() const -> long int {
                return m_hits;
            } end function hits

            function misses() const -> long int {
                return m_misses;
            } end function misses

            function evictions() const -> long int {
                return m_evictions;
            } end function evictions

            function hit_rate() const -> double {
                const long int: total = m_hits + m_misses;
                return total == 0 ? 0.0 : static_cast<double>(m_hits) / static_cast<double>(total);
            } end function hit_rate

            function reset_stats() -> void {
                m_hits = 0;
                m_misses = 0;
                m_evictions = 0;
            } end function reset_stats

            function keys() const -> Vector<K> {
                Vector<K>: out;
                for (long int: slot = m_newest; slot >= 0; slot = m_older[slot]) {
                    out.push_back(m_keys[slot]);
                }
                return out;
            } end function keys

            function values() const -> Vector<V> {
                Vector<V>: out;
                for (long int: slot = m_newest; slot >= 0; slot = m_older[slot]) {
                    out.push_back(m_values[slot]);
                }
                return out;
            } end function values
        } end class Cache

        template <typename C, typename E>
        class WhereQuery {
            C*: m_items = nullptr;
            Vector<long int>: m_indices;

            function item(long int: k) const -> E {
                return (*m_items)[m_indices[k]];
            } end function item

            function with(Vector<long int>&&: picked) const -> WhereQuery {
                return WhereQuery(m_items, std::core::move(picked));
            } end function with

            function total() const -> long int {
                if constexpr (std::traits::is_string<C>) then {
                    return m_items->length();
                } else then {
                    return m_items->size();
                }
            } end function total

            function erase_indices(const Vector<long int>&: doomed) -> void {
                if constexpr (std::traits::is_string<C>) then {
                    string: kept = "";
                    long int: d = 0;
                    long int: i = 0;
                    for (char: ch in *m_items) {
                        if (d < doomed.size() && doomed[d] == i) then {
                            d += 1;
                        } else then {
                            kept += ch;
                        }
                        i += 1;
                    }
                    *m_items = static_cast<C>(kept);
                } else then {
                    for (long int: k = doomed.size() - 1; k >= 0; k--) {
                        m_items->erase(doomed[k]);
                    }
                }
            } end function erase_indices

            function insert_values(const E&: value, long int: shift) -> void {
                if constexpr (std::traits::is_string<C>) then {
                    string: built = "";
                    long int: d = 0;
                    long int: i = 0;
                    for (char: ch in *m_items) {
                        if (shift == 1) then {
                            built += ch;
                        }
                        while (d < m_indices.size() && m_indices[d] == i) {
                            built += value;
                            d += 1;
                        }
                        if (shift == 0) then {
                            built += ch;
                        }
                        i += 1;
                    }
                    *m_items = static_cast<C>(built);
                } else then {
                    for (long int: k = m_indices.size() - 1; k >= 0; k--) {
                        m_items->insert(m_indices[k] + shift, value);
                    }
                }
                m_indices.clear();
            } end function insert_values

        public:
            constructor() { }

            constructor(C*: items, Vector<long int>&&: picked) : m_items = items, m_indices = std::core::move(picked) { }

            static function matching(C&: items, std::Predicate<E>: pred) -> WhereQuery {
                Vector<long int>: picked;
                long int: i = 0;
                for (const auto&: x in items) {
                    if (pred(x)) then {
                        picked.push_back(i);
                    }
                    i += 1;
                }
                return WhereQuery(&items, std::core::move(picked));
            } end function matching

            static function equal_to(C&: items, const E&: value) -> WhereQuery {
                Vector<long int>: picked;
                long int: i = 0;
                for (const auto&: x in items) {
                    if (x == value) then {
                        picked.push_back(i);
                    }
                    i += 1;
                }
                return WhereQuery(&items, std::core::move(picked));
            } end function equal_to

            static function at_indices(C&: items, const Vector<long int>&: picked) -> WhereQuery {
                Vector<long int>: sorted_picked = picked;
                sorted_picked.sort();
                Vector<long int>: clean;
                for (long int: i in sorted_picked) {
                    if (clean.empty() || clean.back() != i) then {
                        clean.push_back(i);
                    }
                }
                return WhereQuery(&items, std::core::move(clean));
            } end function at_indices

            function count() const -> long int {
                return m_indices.size();
            } end function count

            function size() const -> long int {
                return m_indices.size();
            } end function size

            function empty() const -> bool {
                return m_indices.empty();
            } end function empty

            function index(long int: k) const -> long int {
                if (k < 0 || k >= m_indices.size()) then {
                    throw detail::out_of_range(k, m_indices.size());
                }
                return m_indices[k];
            } end function index

            function first_index() const -> long int {
                return m_indices.empty() ? -1 : m_indices[0];
            } end function first_index

            function last_index() const -> long int {
                return m_indices.empty() ? -1 : m_indices.back();
            } end function last_index

            function contains_index(long int: i) const -> bool {
                for (long int: k in m_indices) {
                    if (k == i) then {
                        return true;
                    }
                }
                return false;
            } end function contains_index

            function indices() const -> Vector<long int> {
                return m_indices;
            } end function indices

            operator([]) function(long int: k) const -> E {
                if (k < 0 || k >= m_indices.size()) then {
                    throw detail::out_of_range(k, m_indices.size());
                }
                return item(k);
            }

            function at(long int: k) const -> E {
                if (k < 0 || k >= m_indices.size()) then {
                    throw detail::out_of_range(k, m_indices.size());
                }
                return item(k);
            } end function at

            function first_value() const -> E {
                if (m_indices.empty()) then {
                    throw detail::empty_error("first_value()");
                }
                return item(0);
            } end function first_value

            function last_value() const -> E {
                if (m_indices.empty()) then {
                    throw detail::empty_error("last_value()");
                }
                return item(m_indices.size() - 1);
            } end function last_value

            function values() const -> C {
                C: out;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    if constexpr (std::traits::is_string<C>) then {
                        out += item(k);
                    } else then {
                        out.push_back(item(k));
                    }
                }
                return out;
            } end function values

            function to_vector() const -> Vector<E> {
                Vector<E>: out;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    out.push_back(item(k));
                }
                return out;
            } end function to_vector

            function first(long int: n = 1) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = 0; k < n && k < m_indices.size(); k++) {
                    picked.push_back(m_indices[k]);
                }
                return with(std::core::move(picked));
            } end function first

            function take(long int: n) const -> WhereQuery {
                return first(n);
            } end function take

            function last(long int: n = 1) const -> WhereQuery {
                Vector<long int>: picked;
                long int: start = m_indices.size() - n;
                if (start < 0) then {
                    start = 0;
                }
                for (long int: k = start; k < m_indices.size(); k++) {
                    picked.push_back(m_indices[k]);
                }
                return with(std::core::move(picked));
            } end function last

            function skip(long int: n) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = n < 0 ? 0 : n; k < m_indices.size(); k++) {
                    picked.push_back(m_indices[k]);
                }
                return with(std::core::move(picked));
            } end function skip

            function skip_last(long int: n) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = 0; k < m_indices.size() - n; k++) {
                    picked.push_back(m_indices[k]);
                }
                return with(std::core::move(picked));
            } end function skip_last

            function slice(long int: start, long int: stop) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = start < 0 ? 0 : start; k < stop && k < m_indices.size(); k++) {
                    picked.push_back(m_indices[k]);
                }
                return with(std::core::move(picked));
            } end function slice

            function range(long int: lo, long int: hi) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: i in m_indices) {
                    if (i >= lo && i < hi) then {
                        picked.push_back(i);
                    }
                }
                return with(std::core::move(picked));
            } end function range

            function step(long int: n) const -> WhereQuery {
                Vector<long int>: picked;
                const long int: by = n < 1 ? 1 : n;
                for (long int: k = 0; k < m_indices.size(); k += by) {
                    picked.push_back(m_indices[k]);
                }
                return with(std::core::move(picked));
            } end function step

            function even() const -> WhereQuery {
                return step(2);
            } end function even

            function odd() const -> WhereQuery {
                return skip(1).step(2);
            } end function odd

            function where(std::Predicate<E>: pred) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    if (pred(item(k))) then {
                        picked.push_back(m_indices[k]);
                    }
                }
                return with(std::core::move(picked));
            } end function where

            function where(const E&: value) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    if (item(k) == value) then {
                        picked.push_back(m_indices[k]);
                    }
                }
                return with(std::core::move(picked));
            } end function where

            function where_not(std::Predicate<E>: pred) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    if (!pred(item(k))) then {
                        picked.push_back(m_indices[k]);
                    }
                }
                return with(std::core::move(picked));
            } end function where_not

            function where_indexed(function(long int, const E&) -> bool: pred) const -> WhereQuery {
                Vector<long int>: picked;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    if (pred(m_indices[k], item(k))) then {
                        picked.push_back(m_indices[k]);
                    }
                }
                return with(std::core::move(picked));
            } end function where_indexed

            function invert() const -> WhereQuery {
                Vector<long int>: picked;
                long int: k = 0;
                const long int: n = total();
                for (long int: i = 0; i < n; i++) {
                    if (k < m_indices.size() && m_indices[k] == i) then {
                        k += 1;
                    } else then {
                        picked.push_back(i);
                    }
                }
                return with(std::core::move(picked));
            } end function invert

            function union_with(const WhereQuery&: other) const -> WhereQuery {
                Vector<long int>: picked;
                long int: a = 0;
                long int: b = 0;
                const Vector<long int>&: theirs = other.m_indices;
                while (a < m_indices.size() || b < theirs.size()) {
                    if (b >= theirs.size() || (a < m_indices.size() && m_indices[a] < theirs[b])) then {
                        picked.push_back(m_indices[a]);
                        a += 1;
                    } else if (a >= m_indices.size() || theirs[b] < m_indices[a]) then {
                        picked.push_back(theirs[b]);
                        b += 1;
                    } else then {
                        picked.push_back(m_indices[a]);
                        a += 1;
                        b += 1;
                    }
                }
                return with(std::core::move(picked));
            } end function union_with

            function intersect_with(const WhereQuery&: other) const -> WhereQuery {
                Vector<long int>: picked;
                long int: a = 0;
                long int: b = 0;
                const Vector<long int>&: theirs = other.m_indices;
                while (a < m_indices.size() && b < theirs.size()) {
                    if (m_indices[a] < theirs[b]) then {
                        a += 1;
                    } else if (theirs[b] < m_indices[a]) then {
                        b += 1;
                    } else then {
                        picked.push_back(m_indices[a]);
                        a += 1;
                        b += 1;
                    }
                }
                return with(std::core::move(picked));
            } end function intersect_with

            function except(const WhereQuery&: other) const -> WhereQuery {
                Vector<long int>: picked;
                long int: b = 0;
                const Vector<long int>&: theirs = other.m_indices;
                for (long int: i in m_indices) {
                    while (b < theirs.size() && theirs[b] < i) {
                        b += 1;
                    }
                    if (b >= theirs.size() || theirs[b] != i) then {
                        picked.push_back(i);
                    }
                }
                return with(std::core::move(picked));
            } end function except

            function or_where(std::Predicate<E>: pred) const -> WhereQuery {
                return union_with(matching(*m_items, pred));
            } end function or_where

            function count_if(std::Predicate<E>: pred) const -> long int {
                long int: n = 0;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    if (pred(item(k))) then {
                        n += 1;
                    }
                }
                return n;
            } end function count_if

            function all_of(std::Predicate<E>: pred) const -> bool {
                return count_if(pred) == m_indices.size();
            } end function all_of

            function any_of(std::Predicate<E>: pred) const -> bool {
                return count_if(pred) > 0;
            } end function any_of

            function none_of(std::Predicate<E>: pred) const -> bool {
                return count_if(pred) == 0;
            } end function none_of

            function sum() const -> E {
                E: total = E();
                for (long int: k = 0; k < m_indices.size(); k++) {
                    total = total + item(k);
                }
                return total;
            } end function sum

            function min_index() const -> long int {
                if (m_indices.empty()) then {
                    return -1;
                }
                long int: best = 0;
                for (long int: k = 1; k < m_indices.size(); k++) {
                    if (item(k) < item(best)) then {
                        best = k;
                    }
                }
                return m_indices[best];
            } end function min_index

            function max_index() const -> long int {
                if (m_indices.empty()) then {
                    return -1;
                }
                long int: best = 0;
                for (long int: k = 1; k < m_indices.size(); k++) {
                    if (item(best) < item(k)) then {
                        best = k;
                    }
                }
                return m_indices[best];
            } end function max_index

            function min_value() const -> E {
                if (m_indices.empty()) then {
                    throw detail::empty_error("min_value()");
                }
                return (*m_items)[min_index()];
            } end function min_value

            function max_value() const -> E {
                if (m_indices.empty()) then {
                    throw detail::empty_error("max_value()");
                }
                return (*m_items)[max_index()];
            } end function max_value

            function for_each(std::Action<E>: func) -> WhereQuery& {
                if constexpr (std::traits::is_string<C>) then {
                    for (long int: k = 0; k < m_indices.size(); k++) {
                        E: held = item(k);
                        func(held);
                    }
                } else then {
                    for (long int: i in m_indices) {
                        func((*m_items)[i]);
                    }
                }
                return *this;
            } end function for_each

            function for_each_indexed(function(long int, E&) -> void: func) -> WhereQuery& {
                if constexpr (std::traits::is_string<C>) then {
                    for (long int: k = 0; k < m_indices.size(); k++) {
                        E: held = item(k);
                        func(m_indices[k], held);
                    }
                } else then {
                    for (long int: i in m_indices) {
                        func(i, (*m_items)[i]);
                    }
                }
                return *this;
            } end function for_each_indexed

            function transform(std::Transform<E, E>: func) -> WhereQuery& {
                for (long int: k = 0; k < m_indices.size(); k++) {
                    (*m_items)[m_indices[k]] = func(item(k));
                }
                return *this;
            } end function transform

            template <typename U>
            function map(std::Transform<E, U>: func) const -> Vector<U> {
                Vector<U>: out;
                for (long int: k = 0; k < m_indices.size(); k++) {
                    out.push_back(func(item(k)));
                }
                return out;
            } end function map

            function replace(const E&: value) -> WhereQuery& {
                for (long int: i in m_indices) {
                    (*m_items)[i] = value;
                }
                return *this;
            } end function replace

            function fill(const E&: value) -> WhereQuery& {
                return replace(value);
            } end function fill

            function remove() -> long int {
                const long int: n = m_indices.size();
                erase_indices(m_indices);
                m_indices.clear();
                return n;
            } end function remove

            function pop() -> C {
                C: out = values();
                remove();
                return out;
            } end function pop

            function extract() -> C {
                return pop();
            } end function extract

            function sort(std::Compare<E>: comp) -> WhereQuery& {
                Vector<E>: picked = to_vector();
                std::algorithms::sort(picked.begin(), picked.end(), comp);
                for (long int: k = 0; k < m_indices.size(); k++) {
                    (*m_items)[m_indices[k]] = picked[k];
                }
                return *this;
            } end function sort

            function sort() -> WhereQuery& {
                return sort([](const E&: a, const E&: b) -> bool { return a < b; });
            } end function sort

            function sort_descending() -> WhereQuery& {
                return sort([](const E&: a, const E&: b) -> bool { return b < a; });
            } end function sort_descending

            function stable_sort(std::Compare<E>: comp) -> WhereQuery& {
                Vector<E>: picked = to_vector();
                std::algorithms::stable_sort(picked.begin(), picked.end(), comp);
                for (long int: k = 0; k < m_indices.size(); k++) {
                    (*m_items)[m_indices[k]] = picked[k];
                }
                return *this;
            } end function stable_sort

            function stable_sort() -> WhereQuery& {
                return stable_sort([](const E&: a, const E&: b) -> bool { return a < b; });
            } end function stable_sort

            template <typename K>
            function sort_by(std::Transform<E, K>: key) -> WhereQuery& {
                return sort([&key](const E&: a, const E&: b) -> bool { return key(a) < key(b); });
            } end function sort_by

            function reverse() -> WhereQuery& {
                Vector<E>: picked = to_vector();
                const long int: n = m_indices.size();
                for (long int: k = 0; k < n; k++) {
                    (*m_items)[m_indices[k]] = picked[n - 1 - k];
                }
                return *this;
            } end function reverse

            function rotate_left(long int: steps = 1) -> WhereQuery& {
                Vector<E>: picked = to_vector();
                std::algorithms::rotate_left(picked.begin(), picked.end(), steps);
                for (long int: k = 0; k < m_indices.size(); k++) {
                    (*m_items)[m_indices[k]] = picked[k];
                }
                return *this;
            } end function rotate_left

            function rotate_right(long int: steps = 1) -> WhereQuery& {
                Vector<E>: picked = to_vector();
                std::algorithms::rotate_right(picked.begin(), picked.end(), steps);
                for (long int: k = 0; k < m_indices.size(); k++) {
                    (*m_items)[m_indices[k]] = picked[k];
                }
                return *this;
            } end function rotate_right

            function shuffle() -> WhereQuery& {
                Vector<E>: picked = to_vector();
                std::algorithms::shuffle(picked.begin(), picked.end());
                for (long int: k = 0; k < m_indices.size(); k++) {
                    (*m_items)[m_indices[k]] = picked[k];
                }
                return *this;
            } end function shuffle

            template <typename Dest>
            function copy_to(Dest&: dest) const -> void {
                for (long int: k = 0; k < m_indices.size(); k++) {
                    if constexpr (std::traits::is_string<Dest>) then {
                        dest += item(k);
                    } else then {
                        dest.push_back(item(k));
                    }
                }
            } end function copy_to

            template <typename Dest>
            function move_to(Dest&: dest) -> void {
                copy_to(dest);
                remove();
            } end function move_to

            function insert_before(const E&: value) -> void {
                insert_values(value, 0);
            } end function insert_before

            function insert_after(const E&: value) -> void {
                insert_values(value, 1);
            } end function insert_after
        } end class WhereQuery

        namespace detail {
            template <typename T>
            function empty_list() -> Vector<std::traits::discard_cv<T>> {
                return Vector<std::traits::discard_cv<T>>();
            } end function empty_list
        } end namespace detail

        template <typename K, typename V>
        class OrderedMap {
            Vector<Pair<K, V>>: m_entries;
            UnorderedMap<K, long int>: m_index;

            function reindex_from(long int: start) -> void {
                for (long int: i = start; i < m_entries.size(); i++) {
                    m_index.set(m_entries[i].first, i);
                }
            } end function reindex_from

            function missing(const K&: key) const -> void {
                throw std::errors::collection_error("the key isn't in the map");
            } end function missing

        public:
            using Iterator = Pair<K, V>*;
            using ReverseIterator = std::iterators::Pointer<Pair<K, V>, true>;

            constructor() { }

            function size() const -> long int {
                return m_entries.size();
            } end function size

            function empty() const -> bool {
                return m_entries.empty();
            } end function empty

            function begin() -> Pair<K, V>* {
                return m_entries.begin();
            } end function begin

            function end() -> Pair<K, V>* {
                return m_entries.end();
            } end function end

            function begin() const -> const Pair<K, V>* {
                return m_entries.begin();
            } end function begin

            function end() const -> const Pair<K, V>* {
                return m_entries.end();
            } end function end

            function rbegin() -> std::iterators::Pointer<Pair<K, V>, true> {
                return std::iterators::Pointer<Pair<K, V>, true>(m_entries.data(), m_entries.size() - 1);
            } end function rbegin

            function rend() -> std::iterators::Pointer<Pair<K, V>, true> {
                return std::iterators::Pointer<Pair<K, V>, true>(m_entries.data(), -1);
            } end function rend

            function backwards() -> std::iterators::Range<std::iterators::Pointer<Pair<K, V>, true>> {
                return std::iterators::Range<std::iterators::Pointer<Pair<K, V>, true>>(rbegin(), rend());
            } end function backwards

            function insert(const K&: key, const V&: value) -> bool {
                if (m_index.contains(key)) then {
                    return false;
                }
                m_index.set(key, m_entries.size());
                m_entries.push_back(Pair<K, V>(key, value));
                return true;
            } end function insert

            function set(const K&: key, const V&: value) -> void {
                long int*: at = m_index.find(key);
                if (at != nullptr) then {
                    m_entries[*at].second = value;
                    return;
                }
                m_index.set(key, m_entries.size());
                m_entries.push_back(Pair<K, V>(key, value));
            } end function set

            operator([]) function(const K&: key) -> V& {
                long int*: at = m_index.find(key);
                if (at != nullptr) then {
                    return m_entries[*at].second;
                }
                m_index.set(key, m_entries.size());
                m_entries.push_back(Pair<K, V>(key, V()));
                return m_entries[m_entries.size() - 1].second;
            }

            function at(const K&: key) -> V& {
                long int*: where = m_index.find(key);
                if (where == nullptr) then {
                    missing(key);
                }
                return m_entries[*where].second;
            } end function at

            function at(const K&: key) const -> const V& {
                const long int: where = m_index.get(key, -1);
                if (where < 0) then {
                    missing(key);
                }
                return m_entries[where].second;
            } end function at

            function find(const K&: key) -> V* {
                long int*: where = m_index.find(key);
                if (where == nullptr) then {
                    return nullptr;
                }
                return &m_entries[*where].second;
            } end function find

            function get(const K&: key, const V&: fallback) const -> V {
                const long int: where = m_index.get(key, -1);
                if (where < 0) then {
                    return fallback;
                }
                return m_entries[where].second;
            } end function get

            function contains(const K&: key) const -> bool {
                return m_index.contains(key);
            } end function contains

            function index_of(const K&: key) const -> long int {
                return m_index.get(key, -1);
            } end function index_of

            function entry(long int: i) -> Pair<K, V>& {
                return m_entries[i];
            } end function entry

            function entry(long int: i) const -> const Pair<K, V>& {
                return m_entries[i];
            } end function entry

            function remove(const K&: key) -> bool {
                const long int: where = m_index.get(key, -1);
                if (where < 0) then {
                    return false;
                }
                m_index.remove(key);
                m_entries.erase(where);
                reindex_from(where);
                return true;
            } end function remove

            function pop(const K&: key) -> V {
                const long int: where = m_index.get(key, -1);
                if (where < 0) then {
                    missing(key);
                }
                V: value = m_entries[where].second;
                remove(key);
                return value;
            } end function pop

            function pop_last() -> Pair<K, V> {
                if (m_entries.empty()) then {
                    throw std::errors::collection_error("pop_last() on an empty map");
                }
                Pair<K, V>: last = m_entries.pop_back();
                m_index.remove(last.first);
                return last;
            } end function pop_last

            function pop_first() -> Pair<K, V> {
                if (m_entries.empty()) then {
                    throw std::errors::collection_error("pop_first() on an empty map");
                }
                Pair<K, V>: first = m_entries.erase(0);
                m_index.remove(first.first);
                reindex_from(0);
                return first;
            } end function pop_first

            function move_to_end(const K&: key) -> void {
                const long int: where = m_index.get(key, -1);
                if (where < 0) then {
                    missing(key);
                }
                Pair<K, V>: moved = m_entries.erase(where);
                m_entries.push_back(moved);
                reindex_from(where);
            } end function move_to_end

            function move_to_front(const K&: key) -> void {
                const long int: where = m_index.get(key, -1);
                if (where < 0) then {
                    missing(key);
                }
                Pair<K, V>: moved = m_entries.erase(where);
                m_entries.insert(0, moved);
                reindex_from(0);
            } end function move_to_front

            function first() const -> const Pair<K, V>& {
                if (m_entries.empty()) then {
                    throw std::errors::collection_error("first() on an empty map");
                }
                return m_entries[0];
            } end function first

            function last() const -> const Pair<K, V>& {
                if (m_entries.empty()) then {
                    throw std::errors::collection_error("last() on an empty map");
                }
                return m_entries[m_entries.size() - 1];
            } end function last

            function clear() -> void {
                m_entries.clear();
                m_index.clear();
            } end function clear

            function keys() const -> Vector<K> {
                Vector<K>: out;
                out.reserve(m_entries.size());
                for (const auto&: e in m_entries) {
                    out.push_back(e.first);
                }
                return out;
            } end function keys

            function values() const -> Vector<V> {
                Vector<V>: out;
                out.reserve(m_entries.size());
                for (const auto&: e in m_entries) {
                    out.push_back(e.second);
                }
                return out;
            } end function values

            function items() const -> Vector<Pair<K, V>> {
                return m_entries;
            } end function items

            function update(const OrderedMap&: other) -> void {
                for (const auto&: e in other) {
                    set(e.first, e.second);
                }
            } end function update

            operator(==) function(const OrderedMap&: other) const -> bool {
                return m_entries == other.m_entries;
            }

            operator(!=) function(const OrderedMap&: other) const -> bool {
                return !(m_entries == other.m_entries);
            }
        } end class OrderedMap

        template <typename T>
        class OrderedSet {
            Vector<T>: m_items;
            UnorderedMap<T, long int>: m_index;

            function reindex_from(long int: start) -> void {
                for (long int: i = start; i < m_items.size(); i++) {
                    m_index.set(m_items[i], i);
                }
            } end function reindex_from

        public:
            using Iterator = const T*;
            using ReverseIterator = std::iterators::Pointer<const T, true>;

            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    insert(item);
                }
            }

            function size() const -> long int {
                return m_items.size();
            } end function size

            function empty() const -> bool {
                return m_items.empty();
            } end function empty

            function begin() const -> const T* {
                return m_items.begin();
            } end function begin

            function end() const -> const T* {
                return m_items.end();
            } end function end

            function rbegin() const -> std::iterators::Pointer<const T, true> {
                return std::iterators::Pointer<const T, true>(m_items.data(), m_items.size() - 1);
            } end function rbegin

            function rend() const -> std::iterators::Pointer<const T, true> {
                return std::iterators::Pointer<const T, true>(m_items.data(), -1);
            } end function rend

            function backwards() const -> std::iterators::Range<std::iterators::Pointer<const T, true>> {
                return std::iterators::Range<std::iterators::Pointer<const T, true>>(rbegin(), rend());
            } end function backwards

            function insert(const T&: value) -> bool {
                if (m_index.contains(value)) then {
                    return false;
                }
                m_index.set(value, m_items.size());
                m_items.push_back(value);
                return true;
            } end function insert

            function contains(const T&: value) const -> bool {
                return m_index.contains(value);
            } end function contains

            function index_of(const T&: value) const -> long int {
                return m_index.get(value, -1);
            } end function index_of

            operator([]) function(long int: i) const -> const T& {
                return m_items[i];
            }

            function remove(const T&: value) -> bool {
                const long int: where = m_index.get(value, -1);
                if (where < 0) then {
                    return false;
                }
                m_index.remove(value);
                m_items.erase(where);
                reindex_from(where);
                return true;
            } end function remove

            function pop_last() -> T {
                if (m_items.empty()) then {
                    throw std::errors::collection_error("pop_last() on an empty set");
                }
                T: last = m_items.pop_back();
                m_index.remove(last);
                return last;
            } end function pop_last

            function clear() -> void {
                m_items.clear();
                m_index.clear();
            } end function clear

            function to_vector() const -> Vector<T> {
                return m_items;
            } end function to_vector

            function union_with(const OrderedSet&: other) const -> OrderedSet {
                OrderedSet: out = *this;
                for (const T&: v in other) {
                    out.insert(v);
                }
                return out;
            } end function union_with

            function intersect_with(const OrderedSet&: other) const -> OrderedSet {
                OrderedSet: out;
                for (const T&: v in m_items) {
                    if (other.contains(v)) then {
                        out.insert(v);
                    }
                }
                return out;
            } end function intersect_with

            function except(const OrderedSet&: other) const -> OrderedSet {
                OrderedSet: out;
                for (const T&: v in m_items) {
                    if (!other.contains(v)) then {
                        out.insert(v);
                    }
                }
                return out;
            } end function except

            function is_subset_of(const OrderedSet&: other) const -> bool {
                for (const T&: v in m_items) {
                    if (!other.contains(v)) then {
                        return false;
                    }
                }
                return true;
            } end function is_subset_of

            operator(==) function(const OrderedSet&: other) const -> bool {
                return m_items.size() == other.m_items.size() && is_subset_of(other);
            }

            operator(!=) function(const OrderedSet&: other) const -> bool {
                return !(*this == other);
            }
        } end class OrderedSet

        template <typename T>
        class Counter {
            OrderedMap<T, long int>: m_counts;

        public:
            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    add(item);
                }
            }

            static function of(iterable<T>: items) -> Counter {
                Counter: out;
                for (const T&: item in items) {
                    out.add(item);
                }
                return out;
            } end function of

            function size() const -> long int {
                return m_counts.size();
            } end function size

            function empty() const -> bool {
                return m_counts.empty();
            } end function empty

            function begin() const -> const Pair<T, long int>* {
                return m_counts.begin();
            } end function begin

            function end() const -> const Pair<T, long int>* {
                return m_counts.end();
            } end function end

            function add(const T&: item) -> long int {
                long int&: n = m_counts[item];
                n += 1;
                return n;
            } end function add

            function add(const T&: item, long int: times) -> long int {
                long int&: n = m_counts[item];
                n += times;
                return n;
            } end function add

            function add_all(iterable<T>: items) -> void {
                for (const T&: item in items) {
                    add(item);
                }
            } end function add_all

            function subtract(const T&: item, long int: times = 1) -> long int {
                long int&: n = m_counts[item];
                n -= times;
                return n;
            } end function subtract

            function set(const T&: item, long int: times) -> void {
                m_counts.set(item, times);
            } end function set

            function count(const T&: item) const -> long int {
                return m_counts.get(item, 0);
            } end function count

            operator([]) function(const T&: item) const -> long int {
                return m_counts.get(item, 0);
            }

            function contains(const T&: item) const -> bool {
                return m_counts.contains(item);
            } end function contains

            function remove(const T&: item) -> bool {
                return m_counts.remove(item);
            } end function remove

            function clear() -> void {
                m_counts.clear();
            } end function clear

            function total() const -> long int {
                long int: sum = 0;
                for (const auto&: e in m_counts) {
                    sum += e.second;
                }
                return sum;
            } end function total

            function most_common() const -> Vector<Pair<T, long int>> {
                Vector<Pair<T, long int>>: out = m_counts.items();
                out.stable_sort([](const Pair<T, long int>&: a, const Pair<T, long int>&: b) -> bool { return a.second > b.second; });
                return out;
            } end function most_common

            function most_common(long int: n) const -> Vector<Pair<T, long int>> {
                Vector<Pair<T, long int>>: out = most_common();
                if (n < out.size()) then {
                    out.resize(n < 0 ? 0 : n);
                }
                return out;
            } end function most_common

            function least_common(long int: n) const -> Vector<Pair<T, long int>> {
                Vector<Pair<T, long int>>: out = m_counts.items();
                out.stable_sort([](const Pair<T, long int>&: a, const Pair<T, long int>&: b) -> bool { return a.second < b.second; });
                if (n < out.size()) then {
                    out.resize(n < 0 ? 0 : n);
                }
                return out;
            } end function least_common

            function elements() const -> Vector<T> {
                Vector<T>: out;
                for (const auto&: e in m_counts) {
                    for (long int: i = 0; i < e.second; i++) {
                        out.push_back(e.first);
                    }
                }
                return out;
            } end function elements

            function keys() const -> Vector<T> {
                return m_counts.keys();
            } end function keys

            function drop_zeros() -> long int {
                Vector<T>: gone;
                for (const auto&: e in m_counts) {
                    if (e.second <= 0) then {
                        gone.push_back(e.first);
                    }
                }
                for (const T&: k in gone) {
                    m_counts.remove(k);
                }
                return gone.size();
            } end function drop_zeros

            function merge(const Counter&: other) -> void {
                for (const auto&: e in other) {
                    add(e.first, e.second);
                }
            } end function merge

            operator(==) function(const Counter&: other) const -> bool {
                if (size() != other.size()) then {
                    return false;
                }
                for (const auto&: e in m_counts) {
                    if (other.count(e.first) != e.second || !other.contains(e.first)) then {
                        return false;
                    }
                }
                return true;
            }

            operator(!=) function(const Counter&: other) const -> bool {
                return !(*this == other);
            }
        } end class Counter

        template <typename K, typename V>
        class DefaultMap {
            UnorderedMap<K, V>: m_map;
            function() -> V: m_make;

        public:
            using Iterator = UnorderedMap<K, V>::Iterator;
            using ReverseIterator = UnorderedMap<K, V>::ReverseIterator;

            constructor() : m_make = []() -> V { return V(); } { }

            constructor(function() -> V: make) : m_make = make { }

            constructor(const V&: value) : m_make = [value]() -> V { return value; } { }

            function size() const -> long int {
                return m_map.size();
            } end function size

            function empty() const -> bool {
                return m_map.empty();
            } end function empty

            function begin() const -> Iterator {
                return m_map.begin();
            } end function begin

            function end() const -> Iterator {
                return m_map.end();
            } end function end

            operator([]) function(const K&: key) -> V& {
                V*: found = m_map.find(key);
                if (found != nullptr) then {
                    return *found;
                }
                m_map.set(key, m_make());
                return *m_map.find(key);
            }

            function at(const K&: key) -> V& {
                return m_map.at(key);
            } end function at

            function get(const K&: key, const V&: fallback) const -> V {
                return m_map.get(key, fallback);
            } end function get

            function find(const K&: key) -> V* {
                return m_map.find(key);
            } end function find

            function set(const K&: key, const V&: value) -> void {
                m_map.set(key, value);
            } end function set

            function contains(const K&: key) const -> bool {
                return m_map.contains(key);
            } end function contains

            function remove(const K&: key) -> bool {
                return m_map.remove(key);
            } end function remove

            function clear() -> void {
                m_map.clear();
            } end function clear

            function keys() const -> Vector<K> {
                return m_map.keys();
            } end function keys

            function values() const -> Vector<V> {
                return m_map.values();
            } end function values
        } end class DefaultMap
    } end namespace collections
} end namespace std
