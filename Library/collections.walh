import module.algorithms
import module.iterators

namespace std {
    safe(compile) {
        namespace errors {
            class collection_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class collection_error
        } end namespace errors
    } end safe

    namespace collections {
        hidden namespace detail {
            safe(compile) {
                function negative_index(unsigned long int: index) -> std::errors::collection_error {
                    return std::errors::collection_error(static_cast<string>(`index ${index} is negative; indexes start at 0`));
                } end function negative_index

                function out_of_range(unsigned long int: index, unsigned long int: size) -> std::errors::collection_error {
                    return std::errors::collection_error(static_cast<string>(`index ${index} is out of range for a collection of size ${size}`));
                } end function out_of_range

                function empty_error(const string&: what) -> std::errors::collection_error {
                    return std::errors::collection_error(static_cast<string>(`${what} on an empty collection`));
                } end function empty_error

                template <typename T>
                function swap_items(T&: a, T&: b) -> void {
                    T: held = std::move(a);
                    a = std::move(b);
                    b = std::move(held);
                } end function swap_items
            } end safe

            template <typename T>
            function sift_down(T*: data, unsigned long int: start, unsigned long int: count) -> void {
                unsigned long int: root = start;
                while (root * 2 + 1 < count) {
                    unsigned long int: child = root * 2 + 1;
                    if (child + 1 < count && data[child] < data[child + 1]) then {
                        child += 1;
                    }
                    if (data[root] < data[child]) then {
                        swap_items(data[root], data[child]);
                        root = child;
                    } else then {
                        return;
                    }
                }
            } end function sift_down

            template <typename T>
            function heap_sort(T*: data, unsigned long int: count) -> void {
                if (count < 2) then {
                    return;
                }
                for (unsigned long int: start = count / 2; start > 0;) {
                    start--;
                    sift_down(data, start, count);
                }
                for (unsigned long int: last = count - 1; last > 0; last--) {
                    swap_items(data[0], data[last]);
                    sift_down(data, 0, last);
                }
            } end function heap_sort

            template <typename T>
            function insertion_sort(T*: data, unsigned long int: lo, unsigned long int: hi) -> void {
                for (unsigned long int: i = lo + 1; i < hi; i++) {
                    if (data[i] < data[i - 1]) then {
                        T: held = std::move(data[i]);
                        unsigned long int: j = i;
                        while (j > lo && held < data[j - 1]) {
                            data[j] = std::move(data[j - 1]);
                            j -= 1;
                        }
                        data[j] = std::move(held);
                    }
                }
            } end function insertion_sort

            template <typename T>
            function intro_sort(T*: data, unsigned long int: lo, unsigned long int: hi, unsigned int: depth) -> void {
                unsigned long int: first = lo;
                unsigned long int: last = hi;
                unsigned int: budget = depth;
                while (last - first > 16) {
                    if (budget == 0) then {
                        heap_sort(data + first, last - first);
                        return;
                    }
                    budget -= 1;
                    const unsigned long int: mid = first + (last - first) / 2;
                    if (data[mid] < data[first]) then {
                        swap_items(data[mid], data[first]);
                    }
                    if (data[last - 1] < data[first]) then {
                        swap_items(data[last - 1], data[first]);
                    }
                    if (data[last - 1] < data[mid]) then {
                        swap_items(data[last - 1], data[mid]);
                    }
                    const T: pivot = data[mid];
                    unsigned long int: i = first;
                    unsigned long int: j = last - 1;
                    while (true) {
                        while (data[i] < pivot) {
                            i += 1;
                        }
                        while (pivot < data[j]) {
                            j -= 1;
                        }
                        if (i >= j) then {
                            break;
                        }
                        swap_items(data[i], data[j]);
                        i += 1;
                        j -= 1;
                    }
                    if (j + 1 - first < last - j - 1) then {
                        intro_sort(data, first, j + 1, budget);
                        first = j + 1;
                    } else then {
                        intro_sort(data, j + 1, last, budget);
                        last = j + 1;
                    }
                }
                insertion_sort(data, first, last);
            } end function intro_sort

            safe(compile) {
                template <typename T>
                function sort_range(T*: data, unsigned long int: count) -> void {
                    unsigned int: depth = 0;
                    for (unsigned long int: n = count; n > 1; n /= 2) {
                        depth += 2;
                    }
                    intro_sort(data, 0, count, depth);
                } end function sort_range
            } end safe

            template <typename T>
            function find_in(const T*: items, unsigned long int: count, const T&: value) -> unsigned long int {
                for (unsigned long int: i = 0; i < count; i++) {
                    if (items[i] == value) then {
                        return i;
                    }
                }
                return undefined;
            } end function find_in

            template <typename T>
            function contains_in(const T*: items, unsigned long int: count, const T&: value) -> bool {
                for (unsigned long int: i = 0; i < count; i++) {
                    if (items[i] == value) then {
                        return true;
                    }
                }
                return false;
            } end function contains_in

            template <typename T>
            function compact(T*: items, unsigned long int: count, const T&: value) -> unsigned long int {
                const T: target = value;
                unsigned long int: kept = 0;
                for (unsigned long int: i = 0; i < count; i++) {
                    if (!(items[i] == target)) then {
                        if (kept != i) then {
                            items[kept] = std::move(items[i]);
                        }
                        kept += 1;
                    }
                }
                return count - kept;
            } end function compact

            template <typename T>
            function same_items(const T*: a, unsigned long int: na, const T*: b, unsigned long int: nb) -> bool {
                if (na != nb) then {
                    return false;
                }
                for (unsigned long int: i = 0; i < na; i++) {
                    if (!(a[i] == b[i])) then {
                        return false;
                    }
                }
                return true;
            } end function same_items

            safe(compile) {
                function mix(unsigned long int: h) noexcept -> unsigned long int {
                    std::hardware_uint64: x = static_cast<std::hardware_uint64>(h);
                    x = (x ^ (x >> static_cast<std::hardware_uint64>(30))) * static_cast<std::hardware_uint64>(13787848793156543929ul);
                    x = (x ^ (x >> static_cast<std::hardware_uint64>(27))) * static_cast<std::hardware_uint64>(10723151780598845931ul);
                    return static_cast<unsigned long int>(x ^ (x >> static_cast<std::hardware_uint64>(31)));
                } end function mix

                function combine(unsigned long int: a, unsigned long int: b) noexcept -> unsigned long int {
                    return static_cast<unsigned long int>(static_cast<std::hardware_uint64>(a) * static_cast<std::hardware_uint64>(31) + static_cast<std::hardware_uint64>(b));
                } end function combine

                function grown(unsigned long int: capacity, unsigned long int: needed) noexcept -> unsigned long int {
                    unsigned long int: next = capacity < 4 ? 4u : capacity * 2u;
                    while (next < needed) {
                        next *= 2;
                    }
                    return next;
                } end function grown
            } end safe
        } end namespace detail

        safe(compile) {
            template <typename A, typename B>
            struct Pair {
                A: first;
                B: second;

                constructor() { }

                constructor(const A&: a, const B&: b) : first = a, second = b { }

                operator(==) function(const self&, const Pair&: other) -> bool {
                    return self.first == other.first && self.second == other.second;
                }

                operator(!=) function(const self&, const Pair&: other) -> bool {
                    return !(self.first == other.first && self.second == other.second);
                }
            } end struct Pair

            template <typename... Ts>
            struct Tuple {
                Ts...: items;

                function size(const self&) -> unsigned long int {
                    return countof(self.items);
                } end function size
            } end struct Tuple

            template <typename... Ts>
            function make_tuple(Ts...: values) -> Tuple<Ts...> {
                return Tuple<Ts...>{values...};
            } end function make_tuple

            template <typename C, typename E>
            class WhereQuery;
        } end safe

        extern "C++" from "<walnut_collections.hpp>" {
            template <typename T>
            class Vector as "walnut_rt::coll::vector" {
                function check(const self&, unsigned long int: index) -> void {
                    if (index >= self.size()) then {
                        throw detail::out_of_range(index, self.size());
                    }
                } end function check

                function take_back(self&) -> T as "walnut_rt::coll::take_back";
                function insert_at(self&, unsigned long int: index, const T&: value) -> void as "walnut_rt::coll::insert_at";
                function erase_at(self&, unsigned long int: index) -> T as "walnut_rt::coll::erase_at";
                function truncate(self&, unsigned long int: count) -> void as "walnut_rt::coll::truncate";
                function grow(self&, unsigned long int: count) -> void as "resize";
                function grow_with(self&, unsigned long int: count, const T&: value) -> void as "walnut_rt::coll::resize_fill";
                function reserve_more(self&, unsigned long int: count) -> void as "reserve";
                function append_all(self&, const Vector&: other) -> void as "walnut_rt::coll::append";
                function sort_native(self&) -> void as "walnut_rt::coll::sort";

            public:
                constructor();

                constructor(T...: items) as "walnut_rt::coll::from_items";

                static function filled(unsigned long int: count, const T&: value) -> Vector {
                    Vector: out;
                    out.resize(count, value);
                    return out;
                } end function filled

                function size(const self&) -> unsigned long int;
                function capacity(const self&) -> unsigned long int;
                function empty(const self&) -> bool;
                function data(self&) -> T* as "walnut_rt::coll::data";
                function data(const self&) -> const T* as "walnut_rt::coll::data";
                function begin(self&) -> T* as "walnut_rt::coll::begin";
                function begin(const self&) -> const T* as "walnut_rt::coll::begin";
                function end(self&) -> T* as "walnut_rt::coll::end";
                function end(const self&) -> const T* as "walnut_rt::coll::end";

                function rbegin(self&) -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(self.data(), self.size());
                } end function rbegin

                function rend(self&) -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(self.data(), 0);
                } end function rend

                function rbegin(const self&) -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(self.data(), self.size());
                } end function rbegin

                function rend(const self&) -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(self.data(), 0);
                } end function rend

                function backwards(self&) -> std::iterators::Range<std::iterators::Pointer<T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<T, true>>(self.rbegin(), self.rend());
                } end function backwards

                function backwards(const self&) -> std::iterators::Range<std::iterators::Pointer<const T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<const T, true>>(self.rbegin(), self.rend());
                } end function backwards

                operator([]) function(self&, unsigned long int: index) -> T& {
                    self.check(index);
                    return self.data()[index];
                }

                operator([]) function(const self&, unsigned long int: index) -> const T& {
                    self.check(index);
                    return self.data()[index];
                }

                function hardware_size(const self&) -> std::hardware_int64 as "walnut_rt::coll::hardware_size";

                operator([]) function(self&, std::hardware_int64: index) -> T& {
                    if (index < 0) then {
                        throw detail::negative_index(static_cast<unsigned long int>(index));
                    }
                    if (index >= self.hardware_size()) then {
                        self.check(static_cast<unsigned long int>(index));
                    }
                    return self.data()[index];
                }

                operator([]) function(const self&, std::hardware_int64: index) -> const T& {
                    if (index < 0) then {
                        throw detail::negative_index(static_cast<unsigned long int>(index));
                    }
                    if (index >= self.hardware_size()) then {
                        self.check(static_cast<unsigned long int>(index));
                    }
                    return self.data()[index];
                }

                function at(self&, unsigned long int: index) -> T& {
                    self.check(index);
                    return self.data()[index];
                } end function at

                function at(const self&, unsigned long int: index) -> const T& {
                    self.check(index);
                    return self.data()[index];
                } end function at

                function front(self&) -> T& {
                    if (self.empty()) then {
                        throw detail::empty_error("front()");
                    }
                    return self.data()[0];
                } end function front

                function front(const self&) -> const T& {
                    if (self.empty()) then {
                        throw detail::empty_error("front()");
                    }
                    return self.data()[0];
                } end function front

                function back(self&) -> T& {
                    if (self.empty()) then {
                        throw detail::empty_error("back()");
                    }
                    return self.data()[self.size() - 1];
                } end function back

                function back(const self&) -> const T& {
                    if (self.empty()) then {
                        throw detail::empty_error("back()");
                    }
                    return self.data()[self.size() - 1];
                } end function back

                function reserve(self&, unsigned long int: wanted) -> void {
                    if (wanted > self.capacity()) then {
                        self.reserve_more(wanted);
                    }
                } end function reserve

                function push_back(self&, const T&: value) -> void;
                function push_back(self&, T&&: value) -> void;

                function pop_back(self&) -> T {
                    if (self.empty()) then {
                        throw detail::empty_error("pop_back()");
                    }
                    return self.take_back();
                } end function pop_back

                function insert(self&, unsigned long int: index, const T&: value) -> void {
                    if (index > self.size()) then {
                        throw detail::out_of_range(index, self.size());
                    }
                    self.insert_at(index, value);
                } end function insert

                function erase(self&, unsigned long int: index) -> T {
                    self.check(index);
                    return self.erase_at(index);
                } end function erase

                function remove(self&, const T&: value) -> unsigned long int {
                    const unsigned long int: removed = detail::compact(self.data(), self.size(), value);
                    self.truncate(self.size() - removed);
                    return removed;
                } end function remove

                function resize(self&, unsigned long int: count) -> void {
                    if (count < self.size()) then {
                        self.truncate(count);
                    } else then {
                        self.grow(count);
                    }
                } end function resize

                function resize(self&, unsigned long int: count, const T&: value) -> void {
                    if (count < self.size()) then {
                        self.truncate(count);
                    } else then {
                        self.grow_with(count, value);
                    }
                } end function resize

                function clear(self&) -> void;
                function shrink_to_fit(self&) -> void;

                function find(const self&, const T&: value) -> unsigned long int {
                    return detail::find_in(self.data(), self.size(), value);
                } end function find

                function contains(const self&, const T&: value) -> bool {
                    return detail::contains_in(self.data(), self.size(), value);
                } end function contains

                function extend(self&, const Vector&: other) -> void {
                    self.append_all(other);
                } end function extend

                function reverse(self&) -> void as "walnut_rt::coll::reverse";

                requires std::traits::has_operator<std::traits::op::less, T>
                function sort(self&) -> void {
                    if constexpr (std::traits::is_builtin_number<T> || std::traits::is_string<T> || std::traits::is_enum<T> || std::traits::is_bool<T> || std::traits::is_char<T>) then {
                        self.sort_native();
                    } else then {
                        detail::sort_range(self.data(), self.size());
                    }
                } end function sort

                function sort(self&, std::Compare<T>: comp) -> void {
                    std::algorithms::sort(self.data(), self.data() + self.size(), comp);
                } end function sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function sort_descending(self&) -> void {
                    std::algorithms::sort_descending(self.data(), self.data() + self.size());
                } end function sort_descending

                template <typename K>

                requires std::traits::has_operator<std::traits::op::less, K>
                function sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::sort_by(data(), data() + size(), key);
                } end function sort_by

                requires std::traits::has_operator<std::traits::op::less, T>
                function stable_sort(self&) -> void {
                    std::algorithms::stable_sort(self.data(), self.data() + self.size());
                } end function stable_sort

                function stable_sort(self&, std::Compare<T>: comp) -> void {
                    std::algorithms::stable_sort(self.data(), self.data() + self.size(), comp);
                } end function stable_sort

                template <typename K>

                requires std::traits::has_operator<std::traits::op::less, K>
                function stable_sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::stable_sort_by(data(), data() + size(), key);
                } end function stable_sort_by

                requires std::traits::has_operator<std::traits::op::less, T>
                function heap_sort(self&) -> void {
                    std::algorithms::heap_sort(self.data(), self.data() + self.size());
                } end function heap_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function quick_sort(self&) -> void {
                    std::algorithms::quick_sort(self.data(), self.data() + self.size());
                } end function quick_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function merge_sort(self&) -> void {
                    std::algorithms::merge_sort(self.data(), self.data() + self.size());
                } end function merge_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function insertion_sort(self&) -> void {
                    std::algorithms::insertion_sort(self.data(), self.data() + self.size());
                } end function insertion_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function selection_sort(self&) -> void {
                    std::algorithms::selection_sort(self.data(), self.data() + self.size());
                } end function selection_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function bubble_sort(self&) -> void {
                    std::algorithms::bubble_sort(self.data(), self.data() + self.size());
                } end function bubble_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function shell_sort(self&) -> void {
                    std::algorithms::shell_sort(self.data(), self.data() + self.size());
                } end function shell_sort

                requires std::traits::is_integer<T> || std::traits::is_char<T>
                function counting_sort(self&, bool: descending = false) -> void {
                    std::algorithms::counting_sort(self.data(), self.data() + self.size(), descending);
                } end function counting_sort

                requires std::traits::is_integer<T> || std::traits::is_char<T>
                function radix_sort(self&) -> void {
                    std::algorithms::radix_sort(self.data(), self.data() + self.size());
                } end function radix_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function partial_sort(self&, unsigned long int: count) -> void {
                    const unsigned long int: k = count < self.size() ? count : self.size();
                    std::algorithms::partial_sort(self.data(), self.data() + k, self.data() + self.size());
                } end function partial_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function nth_element(self&, unsigned long int: index) -> void {
                    self.check(index);
                    std::algorithms::nth_element(self.data(), self.data() + index, self.data() + self.size());
                } end function nth_element

                requires std::traits::has_operator<std::traits::op::less, T>
                function is_sorted(const self&) -> bool {
                    return std::algorithms::is_sorted(self.data(), self.data() + self.size());
                } end function is_sorted

                function is_sorted(const self&, std::Compare<T>: comp) -> bool {
                    return std::algorithms::is_sorted(self.data(), self.data() + self.size(), comp);
                } end function is_sorted

                requires std::traits::has_operator<std::traits::op::less, T>
                function sorted(const self&) -> Vector {
                    Vector: out = *this;
                    out.sort();
                    return out;
                } end function sorted

                function sorted(const self&, std::Compare<T>: comp) -> Vector {
                    Vector: out = *this;
                    std::algorithms::sort(out.data(), out.data() + out.size(), comp);
                    return out;
                } end function sorted

                function reversed(const self&) -> Vector {
                    Vector: out = *this;
                    std::algorithms::reverse(out.data(), out.data() + out.size());
                    return out;
                } end function reversed

                requires std::traits::has_operator<std::traits::op::less, T>
                function binary_search(const self&, const T&: value) -> bool {
                    return std::algorithms::binary_search(self.data(), self.data() + self.size(), value);
                } end function binary_search

                requires std::traits::has_operator<std::traits::op::less, T>
                function lower_bound(const self&, const T&: value) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::lower_bound(self.data(), self.data() + self.size(), value) - self.data());
                } end function lower_bound

                requires std::traits::has_operator<std::traits::op::less, T>
                function upper_bound(const self&, const T&: value) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::upper_bound(self.data(), self.data() + self.size(), value) - self.data());
                } end function upper_bound

                requires std::traits::has_operator<std::traits::op::less, T>
                function binary_find(const self&, const T&: value) -> unsigned long int {
                    const T*: it = std::algorithms::binary_find(self.data(), self.data() + self.size(), value);
                    return it == self.data() + self.size() ? std::npos : static_cast<unsigned long int>(it - self.data());
                } end function binary_find

                requires std::traits::has_operator<std::traits::op::less, T>
                function insert_sorted(self&, const T&: value) -> unsigned long int {
                    const unsigned long int: at = self.upper_bound(value);
                    self.insert(at, value);
                    return at;
                } end function insert_sorted

                function insert_sorted(self&, const T&: value, std::Compare<T>: comp) -> unsigned long int {
                    const unsigned long int: at = static_cast<unsigned long int>(std::algorithms::upper_bound(self.data(), self.data() + self.size(), value, comp) - self.data());
                    self.insert(at, value);
                    return at;
                } end function insert_sorted

                function find_if(const self&, std::Predicate<T>: pred) -> unsigned long int {
                    return std::algorithms::index_if(self.data(), self.data() + self.size(), pred);
                } end function find_if

                function find_last(const self&, const T&: value) -> unsigned long int {
                    for (unsigned long int: i = self.size(); i > 0;) {
                        i--;
                        if (self.data()[i] == value) then {
                            return i;
                        }
                    }
                    return std::npos;
                } end function find_last

                function find_last_if(const self&, std::Predicate<T>: pred) -> unsigned long int {
                    for (unsigned long int: i = self.size(); i > 0;) {
                        i--;
                        if (pred(self.data()[i])) then {
                            return i;
                        }
                    }
                    return std::npos;
                } end function find_last_if

                function find_all(const self&, const T&: value) -> Vector<unsigned long int> {
                    Vector<unsigned long int>: out;
                    for (unsigned long int: i = 0; i < self.size(); i++) {
                        if (self.data()[i] == value) then {
                            out.push_back(i);
                        }
                    }
                    return out;
                } end function find_all

                function count(const self&, const T&: value) -> unsigned long int {
                    return std::algorithms::count(self.data(), self.data() + self.size(), value);
                } end function count

                function count_if(const self&, std::Predicate<T>: pred) -> unsigned long int {
                    return std::algorithms::count_if(self.data(), self.data() + self.size(), pred);
                } end function count_if

                function contains_if(const self&, std::Predicate<T>: pred) -> bool {
                    return std::algorithms::contains_if(self.data(), self.data() + self.size(), pred);
                } end function contains_if

                function all_of(const self&, std::Predicate<T>: pred) -> bool {
                    return std::algorithms::all_of(self.data(), self.data() + self.size(), pred);
                } end function all_of

                function any_of(const self&, std::Predicate<T>: pred) -> bool {
                    return std::algorithms::any_of(self.data(), self.data() + self.size(), pred);
                } end function any_of

                function none_of(const self&, std::Predicate<T>: pred) -> bool {
                    return std::algorithms::none_of(self.data(), self.data() + self.size(), pred);
                } end function none_of

                requires std::traits::has_operator<std::traits::op::less, T>
                function min_index(const self&) -> unsigned long int {
                    return self.empty() ? std::npos : static_cast<unsigned long int>(std::algorithms::min_element(self.data(), self.data() + self.size()) - self.data());
                } end function min_index

                requires std::traits::has_operator<std::traits::op::less, T>
                function max_index(const self&) -> unsigned long int {
                    return self.empty() ? std::npos : static_cast<unsigned long int>(std::algorithms::max_element(self.data(), self.data() + self.size()) - self.data());
                } end function max_index

                requires std::traits::has_operator<std::traits::op::less, T>
                function min(const self&) -> T {
                    if (self.empty()) then {
                        throw detail::empty_error("min()");
                    }
                    return *std::algorithms::min_element(self.data(), self.data() + self.size());
                } end function min

                requires std::traits::has_operator<std::traits::op::less, T>
                function max(const self&) -> T {
                    if (self.empty()) then {
                        throw detail::empty_error("max()");
                    }
                    return *std::algorithms::max_element(self.data(), self.data() + self.size());
                } end function max

                requires std::traits::has_operator<std::traits::op::add, T>
                function sum(const self&) -> T {
                    if (self.empty()) then {
                        return T();
                    }
                    T: total = self.data()[0];
                    for (unsigned long int: i = 1; i < self.size(); i++) {
                        total = total + self.data()[i];
                    }
                    return total;
                } end function sum

                template <typename U>
                function accumulate(U: init, std::Combine<U, T>: op) const -> U {
                    return std::algorithms::accumulate(data(), data() + size(), init, op);
                } end function accumulate

                function for_each(self&, std::Action<T>: func) -> void {
                    std::algorithms::for_each(self.data(), self.data() + self.size(), func);
                } end function for_each

                function for_each_indexed(self&, function(unsigned long int, T&) -> void: func) -> void {
                    std::algorithms::for_each_indexed(self.data(), self.data() + self.size(), func);
                } end function for_each_indexed

                function transform(self&, std::Transform<T, T>: func) -> void {
                    std::algorithms::transform_in_place(self.data(), self.data() + self.size(), func);
                } end function transform

                template <typename U>
                function map(std::Transform<T, U>: func) const -> Vector<U> {
                    Vector<U>: out;
                    out.reserve(size());
                    for (unsigned long int: i = 0; i < size(); i++) {
                        out.push_back(func(data()[i]));
                    }
                    return out;
                } end function map

                function filter(const self&, std::Predicate<T>: pred) -> Vector {
                    Vector: out;
                    for (unsigned long int: i = 0; i < self.size(); i++) {
                        if (pred(self.data()[i])) then {
                            out.push_back(self.data()[i]);
                        }
                    }
                    return out;
                } end function filter

                function remove_if(self&, std::Predicate<T>: pred) -> unsigned long int {
                    const unsigned long int: kept = static_cast<unsigned long int>(std::algorithms::remove_if(self.data(), self.data() + self.size(), pred) - self.data());
                    const unsigned long int: removed = self.size() - kept;
                    while (self.size() > kept) {
                        self.pop_back();
                    }
                    return removed;
                } end function remove_if

                function retain_if(self&, std::Predicate<T>: pred) -> unsigned long int {
                    return self.remove_if([&pred](const T&: x) -> bool { return !pred(x); });
                } end function retain_if

                function remove_at(self&, unsigned long int: index) -> T {
                    return self.erase(index);
                } end function remove_at

                function remove_unordered(self&, unsigned long int: index) -> T {
                    self.check(index);
                    const unsigned long int: last_index = self.size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(self.data()[index], self.data()[last_index]);
                    }
                    return self.pop_back();
                } end function remove_unordered

                function swap_remove(self&, unsigned long int: index) -> T {
                    return self.remove_unordered(index);
                } end function swap_remove

                function erase_unordered(self&, unsigned long int: index) -> T {
                    return self.remove_unordered(index);
                } end function erase_unordered

                function take_at_unordered(self&, unsigned long int: index) -> T {
                    return self.remove_unordered(index);
                } end function take_at_unordered

                function remove_at_unordered(self&, unsigned long int: index) -> T {
                    return self.remove_unordered(index);
                } end function remove_at_unordered

                function remove_first_unordered(self&, const T&: value) -> bool {
                    const unsigned long int: at = self.find(value);
                    self.remove_unordered(at);
                    return true;
                } end function remove_first_unordered

                function remove_all_unordered(self&, const T&: value) -> unsigned long int {
                    return self.remove_if_unordered([&value](const T&: x) -> bool { return x == value; });
                } end function remove_all_unordered

                function remove_if_unordered(self&, std::Predicate<T>: drop) -> unsigned long int {
                    unsigned long int: removed = 0;
                    unsigned long int: i = 0;
                    while (i < self.size()) {
                        if (drop(self.data()[i])) then {
                            self.remove_unordered(i);
                            removed += 1;
                        } else then {
                            i += 1;
                        }
                    }
                    return removed;
                } end function remove_if_unordered

                function retain_if_unordered(self&, std::Predicate<T>: keep) -> unsigned long int {
                    return self.remove_if_unordered([&keep](const T&: x) -> bool { return !keep(x); });
                } end function retain_if_unordered

                function remove_range_unordered(self&, unsigned long int: start, unsigned long int: stop) -> void {
                    if (start > self.size()) then {
                        throw detail::out_of_range(start, self.size());
                    }
                    if (stop < start || stop > self.size()) then {
                        throw detail::out_of_range(stop, self.size());
                    }
                    const unsigned long int: count = stop - start;
                    const unsigned long int: n = self.size();
                    for (unsigned long int: k = 0; k < count; k++) {
                        const unsigned long int: hole = start + k;
                        const unsigned long int: source = n - 1 - k;
                        if (source >= stop && source > hole) then {
                            self.data()[hole] = std::move(self.data()[source]);
                        }
                    }
                    for (unsigned long int: k = 0; k < count; k++) {
                        self.pop_back();
                    }
                } end function remove_range_unordered

                function remove_first(self&, const T&: value) -> bool {
                    const unsigned long int: at = self.find(value);
                    self.erase(at);
                    return true;
                } end function remove_first

                function unique(self&) -> unsigned long int {
                    const unsigned long int: kept = static_cast<unsigned long int>(std::algorithms::unique(self.data(), self.data() + self.size()) - self.data());
                    const unsigned long int: removed = self.size() - kept;
                    while (self.size() > kept) {
                        self.pop_back();
                    }
                    return removed;
                } end function unique

                function deduplicate(self&) -> unsigned long int {
                    unsigned long int: kept = 0;
                    for (unsigned long int: i = 0; i < self.size(); i++) {
                        bool: seen = false;
                        for (unsigned long int: j = 0; j < kept; j++) {
                            if (self.data()[j] == self.data()[i]) then {
                                seen = true;
                                break;
                            }
                        }
                        if (!seen) then {
                            if (kept != i) then {
                                self.data()[kept] = std::move(self.data()[i]);
                            }
                            kept += 1;
                        }
                    }
                    const unsigned long int: removed = self.size() - kept;
                    while (self.size() > kept) {
                        self.pop_back();
                    }
                    return removed;
                } end function deduplicate

                function distinct(const self&) -> Vector {
                    Vector: out = *this;
                    out.deduplicate();
                    return out;
                } end function distinct

                function replace(self&, const T&: old_value, const T&: new_value) -> unsigned long int {
                    return std::algorithms::replace(self.data(), self.data() + self.size(), old_value, new_value);
                } end function replace

                function replace_if(self&, std::Predicate<T>: pred, const T&: new_value) -> unsigned long int {
                    return std::algorithms::replace_if(self.data(), self.data() + self.size(), pred, new_value);
                } end function replace_if

                function rotate_left(self&, unsigned long int: steps = 1) -> void {
                    std::algorithms::rotate_left(self.data(), self.data() + self.size(), steps);
                } end function rotate_left

                function rotate_right(self&, unsigned long int: steps = 1) -> void {
                    std::algorithms::rotate_right(self.data(), self.data() + self.size(), steps);
                } end function rotate_right

                function shuffle(self&) -> void {
                    std::algorithms::shuffle(self.data(), self.data() + self.size());
                } end function shuffle

                function swap_items(self&, unsigned long int: a, unsigned long int: b) -> void {
                    self.check(a);
                    self.check(b);
                    std::algorithms::detail::swap_values(self.data()[a], self.data()[b]);
                } end function swap_items

                function partition(self&, std::Predicate<T>: pred) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::partition(self.data(), self.data() + self.size(), pred) - self.data());
                } end function partition

                function stable_partition(self&, std::Predicate<T>: pred) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::stable_partition(self.data(), self.data() + self.size(), pred) - self.data());
                } end function stable_partition

                function append(self&, const T&: value) -> void {
                    self.push_back(value);
                } end function append

                function prepend(self&, const T&: value) -> void {
                    self.insert(0, value);
                } end function prepend

                function insert_n(self&, unsigned long int: index, unsigned long int: count, const T&: value) -> void {
                    for (unsigned long int: k = 0; k < count; k++) {
                        self.insert(index, value);
                    }
                } end function insert_n

                function insert_all(self&, unsigned long int: index, const Vector&: items) -> void {
                    for (unsigned long int: k = 0; k < items.size(); k++) {
                        self.insert(index + k, items[k]);
                    }
                } end function insert_all

                function append_n(self&, unsigned long int: count, const T&: value) -> void {
                    for (unsigned long int: k = 0; k < count; k++) {
                        self.push_back(value);
                    }
                } end function append_n

                function insert_unordered(self&, unsigned long int: index, const T&: value) -> void {
                    if (index > self.size()) then {
                        throw detail::out_of_range(index, self.size());
                    }
                    self.push_back(value);
                    const unsigned long int: last_index = self.size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(self.data()[index], self.data()[last_index]);
                    }
                } end function insert_unordered

                function take(const self&, unsigned long int: count) -> Vector {
                    Vector: out;
                    for (unsigned long int: i = 0; i < count && i < self.size(); i++) {
                        out.push_back(self.data()[i]);
                    }
                    return out;
                } end function take

                function skip(const self&, unsigned long int: count) -> Vector {
                    Vector: out;
                    for (unsigned long int: i = count; i < self.size(); i++) {
                        out.push_back(self.data()[i]);
                    }
                    return out;
                } end function skip

                function slice(const self&, unsigned long int: start, unsigned long int: stop) -> Vector {
                    Vector: out;
                    for (unsigned long int: i = start; i < stop && i < self.size(); i++) {
                        out.push_back(self.data()[i]);
                    }
                    return out;
                } end function slice

                function sliced(const self&, long int: start, long int: stop, long int: step, bool: has_start, bool: has_stop) -> Vector {
                    if (step == 0) then {
                        throw std::errors::collection_error("a slice's step can't be 0");
                    }
                    const long int: n = static_cast<long int>(self.size());
                    const long int: low = step > 0 ? 0 : -1;
                    const long int: high = step > 0 ? n : n - 1;
                    long int: first = step > 0 ? 0 : n - 1;
                    long int: last = step > 0 ? n : -1;
                    if (has_start) then {
                        first = start < 0 ? start + n : start;
                        first = first < low ? low : (first > high ? high : first);
                    }
                    if (has_stop) then {
                        last = stop < 0 ? stop + n : stop;
                        last = last < low ? low : (last > high ? high : last);
                    }
                    Vector: out;
                    for (long int: i = first; step > 0 ? i < last : i > last; i += step) {
                        out.push_back(self.data()[i]);
                    }
                    return out;
                } end function sliced

                function starts_with(const self&, const Vector&: prefix) -> bool {
                    return std::algorithms::starts_with(self.data(), self.data() + self.size(), prefix.data(), prefix.data() + prefix.size());
                } end function starts_with

                function ends_with(const self&, const Vector&: suffix) -> bool {
                    return std::algorithms::ends_with(self.data(), self.data() + self.size(), suffix.data(), suffix.data() + suffix.size());
                } end function ends_with

                function where(self&, const T&: value) -> WhereQuery<Vector, T> {
                    return WhereQuery<Vector, T>::equal_to(*this, value);
                } end function where

                function where(self&, std::Predicate<T>: pred) -> WhereQuery<Vector, T> {
                    return WhereQuery<Vector, T>::matching(*this, pred);
                } end function where

                function where_indices(self&, const Vector<unsigned long int>&: indices) -> WhereQuery<Vector, T> {
                    return WhereQuery<Vector, T>::at_indices(*this, indices);
                } end function where_indices

                function all(self&) -> WhereQuery<Vector, T> {
                    return WhereQuery<Vector, T>::matching(*this, [](const T&: x) -> bool { return true; });
                } end function all

                function swap(self&, Vector&: other) noexcept -> void;

                operator(==) function(const self&, const Vector&: other) -> bool {
                    return detail::same_items(self.data(), self.size(), other.data(), other.size());
                }

                operator(!=) function(const self&, const Vector&: other) -> bool {
                    return !detail::same_items(self.data(), self.size(), other.data(), other.size());
                }
            } end class Vector
        } end extern

        template <typename T>
        class Span {
            T*: m_data = nullptr;
            unsigned long int: m_size = 0;

            function check(const self&, unsigned long int: index) -> void {
                if (index >= self.m_size) then {
                    throw detail::out_of_range(index, self.m_size);
                }
            } end function check

        public:
            constructor() { }

            constructor(T*: first, unsigned long int: count) : m_data = first, m_size = count { }

            constructor(Vector<T>&: v) : m_data = v.data(), m_size = v.size() { }

            function size(const self&) -> unsigned long int {
                return self.m_size;
            } end function size

            function empty(const self&) -> bool {
                return self.m_size == 0;
            } end function empty

            function data(const self&) -> T* {
                return self.m_data;
            } end function data

            function begin(const self&) -> T* {
                return self.m_data;
            } end function begin

            function end(const self&) -> T* {
                return self.m_data + self.m_size;
            } end function end

            function rbegin(const self&) -> std::iterators::Pointer<T, true> {
                return std::iterators::Pointer<T, true>(self.m_data, self.m_size);
            } end function rbegin

            function rend(const self&) -> std::iterators::Pointer<T, true> {
                return std::iterators::Pointer<T, true>(self.m_data, 0);
            } end function rend

            function backwards(const self&) -> std::iterators::Range<std::iterators::Pointer<T, true>> {
                return std::iterators::Range<std::iterators::Pointer<T, true>>(self.rbegin(), self.rend());
            } end function backwards

            operator([]) function(const self&, unsigned long int: index) -> T& {
                self.check(index);
                return self.m_data[index];
            }

            function at(const self&, unsigned long int: index) -> T& {
                self.check(index);
                return self.m_data[index];
            } end function at

            function front(const self&) -> T& {
                if (self.m_size == 0) then {
                    throw detail::empty_error("front()");
                }
                return self.m_data[0];
            } end function front

            function back(const self&) -> T& {
                if (self.m_size == 0) then {
                    throw detail::empty_error("back()");
                }
                return self.m_data[self.m_size - 1];
            } end function back

            function subspan(const self&, unsigned long int: offset, unsigned long int: count) -> Span {
                if (offset > self.m_size) then {
                    throw detail::out_of_range(offset, self.m_size);
                }
                if (offset + count > self.m_size) then {
                    throw detail::out_of_range(offset + count, self.m_size);
                }
                return Span(self.m_data + offset, count);
            } end function subspan

            function first(const self&, unsigned long int: count) -> Span {
                return self.subspan(0, count);
            } end function first

            function last(const self&, unsigned long int: count) -> Span {
                return self.subspan(self.m_size - count, count);
            } end function last

            function find(const self&, const T&: value) -> unsigned long int {
                for (unsigned long int: i = 0; i < self.m_size; i++) {
                    if (self.m_data[i] == value) then {
                        return i;
                    }
                }
                return undefined;
            } end function find

            function contains(const self&, const T&: value) -> bool {
                for (unsigned long int: i = 0; i < self.m_size; i++) {
                    if (self.m_data[i] == value) then {
                        return true;
                    }
                }
                return false;
            } end function contains

            function fill(const self&, const T&: value) -> void {
                for (unsigned long int: i = 0; i < self.m_size; i++) {
                    self.m_data[i] = value;
                }
            } end function fill

            requires std::traits::has_operator<std::traits::op::less, T>
            function sort(const self&) -> void {
                detail::sort_range(self.m_data, self.m_size);
            } end function sort
        } end class Span

        extern "C++" from "<walnut_fizmo_arrays.hpp>" {
            template <typename T>
            class DynamicArray as "fizmo::collections::DynamicArray" {
                function check(unsigned long int: index) const -> void {
                    if (index >= size()) then {
                        throw detail::out_of_range(index, size());
                    }
                } end function check

                function take_back() -> T as "pop_back";
                function take_front() -> T as "pop_front";
                function take_at(unsigned long int: index) -> T as "pop";
                function insert_at(unsigned long int: index, const T&: value) -> void as "insert";
                function remove_range(unsigned long int: start, unsigned long int: stop) -> void;
                function grow(unsigned long int: count) -> void as "resize";
                function grow_with(unsigned long int: count, const T&: value) -> void as "resize";
                function reserve_more(unsigned long int: count) -> void as "reserve";
                function sort_native() -> void as "sort";

            public:
                constructor();
                constructor(unsigned long int: count);
                constructor(unsigned long int: count, const T&: value);

                static function of(T...: items) -> DynamicArray {
                    DynamicArray: out;
                    out.reserve(countof(items));
                    for (const T&: item in items) {
                        out.push_back(item);
                    }
                    return out;
                } end function of

                function size() const -> unsigned long int;
                function capacity() const -> unsigned long int;
                function empty() const -> bool;
                function data() -> T* as "walnut_rt::coll::data";
                function data() const -> const T* as "walnut_rt::coll::data";
                function begin() -> T* as "walnut_rt::coll::begin";
                function begin() const -> const T* as "walnut_rt::coll::begin";
                function end() -> T* as "walnut_rt::coll::end";
                function end() const -> const T* as "walnut_rt::coll::end";

                function rbegin() -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(data(), size());
                } end function rbegin

                function rend() -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(data(), 0);
                } end function rend

                function rbegin() const -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(data(), size());
                } end function rbegin

                function rend() const -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(data(), 0);
                } end function rend

                function backwards() -> std::iterators::Range<std::iterators::Pointer<T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<T, true>>(rbegin(), rend());
                } end function backwards

                function backwards() const -> std::iterators::Range<std::iterators::Pointer<const T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<const T, true>>(rbegin(), rend());
                } end function backwards

                operator([]) function(unsigned long int: index) -> T& {
                    check(index);
                    return data()[index];
                }

                operator([]) function(unsigned long int: index) const -> const T& {
                    check(index);
                    return data()[index];
                }

                function hardware_size() const -> std::hardware_int64 as "walnut_rt::coll::hardware_size";

                operator([]) function(std::hardware_int64: index) -> T& {
                    if (index < 0 || index >= hardware_size()) then {
                        check(static_cast<unsigned long int>(index));
                    }
                    return data()[index];
                }

                operator([]) function(std::hardware_int64: index) const -> const T& {
                    if (index < 0 || index >= hardware_size()) then {
                        check(static_cast<unsigned long int>(index));
                    }
                    return data()[index];
                }

                function at(unsigned long int: index) -> T& {
                    check(index);
                    return data()[index];
                } end function at

                function at(unsigned long int: index) const -> const T& {
                    check(index);
                    return data()[index];
                } end function at

                function front() -> T& {
                    if (empty()) then {
                        throw detail::empty_error("front()");
                    }
                    return data()[0];
                } end function front

                function back() -> T& {
                    if (empty()) then {
                        throw detail::empty_error("back()");
                    }
                    return data()[size() - 1];
                } end function back

                function reserve(unsigned long int: wanted) -> void {
                    if (wanted > capacity()) then {
                        reserve_more(wanted);
                    }
                } end function reserve

                function push_back(const T&: value) -> void;
                function push_back(T&&: value) -> void;
                function push_front(const T&: value) -> void;

                function pop_back() -> T {
                    if (empty()) then {
                        throw detail::empty_error("pop_back()");
                    }
                    return take_back();
                } end function pop_back

                function pop_front() -> T {
                    if (empty()) then {
                        throw detail::empty_error("pop_front()");
                    }
                    return take_front();
                } end function pop_front

                function insert(unsigned long int: index, const T&: value) -> void {
                    if (index > size()) then {
                        throw detail::out_of_range(index, size());
                    }
                    insert_at(index, value);
                } end function insert

                function erase(unsigned long int: index) -> T {
                    check(index);
                    return take_at(index);
                } end function erase

                function remove(const T&: value) -> unsigned long int {
                    const unsigned long int: removed = detail::compact(data(), size(), value);
                    remove_range(size() - removed, size());
                    return removed;
                } end function remove

                function resize(unsigned long int: count) -> void {
                    grow(count);
                } end function resize

                function resize(unsigned long int: count, const T&: value) -> void {
                    grow_with(count, value);
                } end function resize

                function fill(const T&: value) -> void;
                function clear() -> void;
                function shrink_to_fit() -> void;
                function reverse() -> void;

                function find(const T&: value) const -> unsigned long int {
                    return detail::find_in(data(), size(), value);
                } end function find

                function contains(const T&: value) const -> bool {
                    return detail::contains_in(data(), size(), value);
                } end function contains

                requires std::traits::has_operator<std::traits::op::less, T>
                function sort() -> void {
                    if constexpr (std::traits::is_builtin_number<T> || std::traits::is_string<T> || std::traits::is_enum<T> || std::traits::is_bool<T> || std::traits::is_char<T>) then {
                        sort_native();
                    } else then {
                        detail::sort_range(data(), size());
                    }
                } end function sort

                function as_span() -> Span<T> {
                    return Span<T>(data(), size());
                } end function as_span

                function sort(std::Compare<T>: comp) -> void {
                    std::algorithms::sort(data(), data() + size(), comp);
                } end function sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function sort_descending() -> void {
                    std::algorithms::sort_descending(data(), data() + size());
                } end function sort_descending

                template <typename K>

                requires std::traits::has_operator<std::traits::op::less, K>
                function sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::sort_by(data(), data() + size(), key);
                } end function sort_by

                requires std::traits::has_operator<std::traits::op::less, T>
                function stable_sort() -> void {
                    std::algorithms::stable_sort(data(), data() + size());
                } end function stable_sort

                function stable_sort(std::Compare<T>: comp) -> void {
                    std::algorithms::stable_sort(data(), data() + size(), comp);
                } end function stable_sort

                template <typename K>

                requires std::traits::has_operator<std::traits::op::less, K>
                function stable_sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::stable_sort_by(data(), data() + size(), key);
                } end function stable_sort_by

                requires std::traits::has_operator<std::traits::op::less, T>
                function heap_sort() -> void {
                    std::algorithms::heap_sort(data(), data() + size());
                } end function heap_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function quick_sort() -> void {
                    std::algorithms::quick_sort(data(), data() + size());
                } end function quick_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function merge_sort() -> void {
                    std::algorithms::merge_sort(data(), data() + size());
                } end function merge_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function insertion_sort() -> void {
                    std::algorithms::insertion_sort(data(), data() + size());
                } end function insertion_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function selection_sort() -> void {
                    std::algorithms::selection_sort(data(), data() + size());
                } end function selection_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function bubble_sort() -> void {
                    std::algorithms::bubble_sort(data(), data() + size());
                } end function bubble_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function shell_sort() -> void {
                    std::algorithms::shell_sort(data(), data() + size());
                } end function shell_sort

                requires std::traits::is_integer<T> || std::traits::is_char<T>
                function counting_sort(bool: descending = false) -> void {
                    std::algorithms::counting_sort(data(), data() + size(), descending);
                } end function counting_sort

                requires std::traits::is_integer<T> || std::traits::is_char<T>
                function radix_sort() -> void {
                    std::algorithms::radix_sort(data(), data() + size());
                } end function radix_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function partial_sort(unsigned long int: count) -> void {
                    const unsigned long int: k = count < size() ? count : size();
                    std::algorithms::partial_sort(data(), data() + k, data() + size());
                } end function partial_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function nth_element(unsigned long int: index) -> void {
                    check(index);
                    std::algorithms::nth_element(data(), data() + index, data() + size());
                } end function nth_element

                requires std::traits::has_operator<std::traits::op::less, T>
                function is_sorted() const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size());
                } end function is_sorted

                function is_sorted(std::Compare<T>: comp) const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size(), comp);
                } end function is_sorted

                requires std::traits::has_operator<std::traits::op::less, T>
                function sorted() const -> DynamicArray {
                    DynamicArray: out = *this;
                    out.sort();
                    return out;
                } end function sorted

                function sorted(std::Compare<T>: comp) const -> DynamicArray {
                    DynamicArray: out = *this;
                    std::algorithms::sort(out.data(), out.data() + out.size(), comp);
                    return out;
                } end function sorted

                function reversed() const -> DynamicArray {
                    DynamicArray: out = *this;
                    std::algorithms::reverse(out.data(), out.data() + out.size());
                    return out;
                } end function reversed

                requires std::traits::has_operator<std::traits::op::less, T>
                function binary_search(const T&: value) const -> bool {
                    return std::algorithms::binary_search(data(), data() + size(), value);
                } end function binary_search

                requires std::traits::has_operator<std::traits::op::less, T>
                function lower_bound(const T&: value) const -> unsigned long int {
                    return std::algorithms::lower_bound(data(), data() + size(), value) - data();
                } end function lower_bound

                requires std::traits::has_operator<std::traits::op::less, T>
                function upper_bound(const T&: value) const -> unsigned long int {
                    return std::algorithms::upper_bound(data(), data() + size(), value) - data();
                } end function upper_bound

                requires std::traits::has_operator<std::traits::op::less, T>
                function binary_find(const T&: value) const -> unsigned long int {
                    const T*: it = std::algorithms::binary_find(data(), data() + size(), value);
                    return it == data() + size() ? std::npos : static_cast<unsigned long int>(it - data());
                } end function binary_find

                requires std::traits::has_operator<std::traits::op::less, T>
                function insert_sorted(const T&: value) -> unsigned long int {
                    const unsigned long int: at = upper_bound(value);
                    insert(at, value);
                    return at;
                } end function insert_sorted

                function insert_sorted(const T&: value, std::Compare<T>: comp) -> unsigned long int {
                    const unsigned long int: at = std::algorithms::upper_bound(data(), data() + size(), value, comp) - data();
                    insert(at, value);
                    return at;
                } end function insert_sorted

                function find_if(std::Predicate<T>: pred) const -> unsigned long int {
                    return std::algorithms::index_if(data(), data() + size(), pred);
                } end function find_if

                function find_last(const T&: value) const -> unsigned long int {
                    for (unsigned long int: i = size(); i > 0;) {
                        i--;
                        if (data()[i] == value) then {
                            return i;
                        }
                    }
                    return std::npos;
                } end function find_last

                function find_last_if(std::Predicate<T>: pred) const -> unsigned long int {
                    for (unsigned long int: i = size(); i > 0;) {
                        i--;
                        if (pred(data()[i])) then {
                            return i;
                        }
                    }
                    return std::npos;
                } end function find_last_if

                function find_all(const T&: value) const -> Vector<unsigned long int> {
                    Vector<unsigned long int>: out;
                    for (unsigned long int: i = 0; i < size(); i++) {
                        if (data()[i] == value) then {
                            out.push_back(i);
                        }
                    }
                    return out;
                } end function find_all

                function count(const T&: value) const -> unsigned long int {
                    return std::algorithms::count(data(), data() + size(), value);
                } end function count

                function count_if(std::Predicate<T>: pred) const -> unsigned long int {
                    return std::algorithms::count_if(data(), data() + size(), pred);
                } end function count_if

                function contains_if(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::contains_if(data(), data() + size(), pred);
                } end function contains_if

                function all_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::all_of(data(), data() + size(), pred);
                } end function all_of

                function any_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::any_of(data(), data() + size(), pred);
                } end function any_of

                function none_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::none_of(data(), data() + size(), pred);
                } end function none_of

                requires std::traits::has_operator<std::traits::op::less, T>
                function min_index() const -> unsigned long int {
                    return empty() ? std::npos : static_cast<unsigned long int>(std::algorithms::min_element(data(), data() + size()) - data());
                } end function min_index

                requires std::traits::has_operator<std::traits::op::less, T>
                function max_index() const -> unsigned long int {
                    return empty() ? std::npos : static_cast<unsigned long int>(std::algorithms::max_element(data(), data() + size()) - data());
                } end function max_index

                requires std::traits::has_operator<std::traits::op::less, T>
                function min() const -> T {
                    if (empty()) then {
                        throw detail::empty_error("min()");
                    }
                    return *std::algorithms::min_element(data(), data() + size());
                } end function min

                requires std::traits::has_operator<std::traits::op::less, T>
                function max() const -> T {
                    if (empty()) then {
                        throw detail::empty_error("max()");
                    }
                    return *std::algorithms::max_element(data(), data() + size());
                } end function max

                requires std::traits::has_operator<std::traits::op::add, T>
                function sum() const -> T {
                    if (empty()) then {
                        return T();
                    }
                    T: total = data()[0];
                    for (unsigned long int: i = 1; i < size(); i++) {
                        total = total + data()[i];
                    }
                    return total;
                } end function sum

                template <typename U>
                function accumulate(U: init, std::Combine<U, T>: op) const -> U {
                    return std::algorithms::accumulate(data(), data() + size(), init, op);
                } end function accumulate

                function for_each(std::Action<T>: func) -> void {
                    std::algorithms::for_each(data(), data() + size(), func);
                } end function for_each

                function for_each_indexed(function(unsigned long int, T&) -> void: func) -> void {
                    std::algorithms::for_each_indexed(data(), data() + size(), func);
                } end function for_each_indexed

                function transform(std::Transform<T, T>: func) -> void {
                    std::algorithms::transform_in_place(data(), data() + size(), func);
                } end function transform

                template <typename U>
                function map(std::Transform<T, U>: func) const -> Vector<U> {
                    Vector<U>: out;
                    out.reserve(size());
                    for (unsigned long int: i = 0; i < size(); i++) {
                        out.push_back(func(data()[i]));
                    }
                    return out;
                } end function map

                function filter(std::Predicate<T>: pred) const -> DynamicArray {
                    DynamicArray: out;
                    for (unsigned long int: i = 0; i < size(); i++) {
                        if (pred(data()[i])) then {
                            out.push_back(data()[i]);
                        }
                    }
                    return out;
                } end function filter

                function remove_if(std::Predicate<T>: pred) -> unsigned long int {
                    const unsigned long int: kept = std::algorithms::remove_if(data(), data() + size(), pred) - data();
                    const unsigned long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function remove_if

                function retain_if(std::Predicate<T>: pred) -> unsigned long int {
                    return remove_if([&pred](const T&: x) -> bool { return !pred(x); });
                } end function retain_if

                function remove_at(unsigned long int: index) -> T {
                    return erase(index);
                } end function remove_at

                function remove_unordered(unsigned long int: index) -> T {
                    check(index);
                    const unsigned long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                    return pop_back();
                } end function remove_unordered

                function swap_remove(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function swap_remove

                function erase_unordered(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function erase_unordered

                function take_at_unordered(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function take_at_unordered

                function remove_at_unordered(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function remove_at_unordered

                function remove_first_unordered(const T&: value) -> bool {
                    const unsigned long int: at = find(value);
                    if (at == std::npos) then {
                        return false;
                    }
                    remove_unordered(at);
                    return true;
                } end function remove_first_unordered

                function remove_all_unordered(const T&: value) -> unsigned long int {
                    return remove_if_unordered([&value](const T&: x) -> bool { return x == value; });
                } end function remove_all_unordered

                function remove_if_unordered(std::Predicate<T>: drop) -> unsigned long int {
                    unsigned long int: removed = 0;
                    unsigned long int: i = 0;
                    while (i < size()) {
                        if (drop(data()[i])) then {
                            remove_unordered(i);
                            removed += 1;
                        } else then {
                            i += 1;
                        }
                    }
                    return removed;
                } end function remove_if_unordered

                function retain_if_unordered(std::Predicate<T>: keep) -> unsigned long int {
                    return remove_if_unordered([&keep](const T&: x) -> bool { return !keep(x); });
                } end function retain_if_unordered

                function remove_range_unordered(unsigned long int: start, unsigned long int: stop) -> void {
                    if (start > size()) then {
                        throw detail::out_of_range(start, size());
                    }
                    if (stop < start || stop > size()) then {
                        throw detail::out_of_range(stop, size());
                    }
                    const unsigned long int: count = stop - start;
                    const unsigned long int: n = size();
                    for (unsigned long int: k = 0; k < count; k++) {
                        const unsigned long int: hole = start + k;
                        const unsigned long int: source = n - 1 - k;
                        if (source >= stop && source > hole) then {
                            data()[hole] = std::move(data()[source]);
                        }
                    }
                    for (unsigned long int: k = 0; k < count; k++) {
                        pop_back();
                    }
                } end function remove_range_unordered

                function take_front_unordered() -> T {
                    if (empty()) then {
                        throw detail::empty_error("take_front_unordered()");
                    }
                    return remove_unordered(0);
                } end function take_front_unordered

                function pop_front_unordered() -> T {
                    return take_front_unordered();
                } end function pop_front_unordered

                function remove_first(const T&: value) -> bool {
                    const unsigned long int: at = find(value);
                    if (at == std::npos) then {
                        return false;
                    }
                    erase(at);
                    return true;
                } end function remove_first

                function unique() -> unsigned long int {
                    const unsigned long int: kept = std::algorithms::unique(data(), data() + size()) - data();
                    const unsigned long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function unique

                function deduplicate() -> unsigned long int {
                    unsigned long int: kept = 0;
                    for (unsigned long int: i = 0; i < size(); i++) {
                        bool: seen = false;
                        for (unsigned long int: j = 0; j < kept; j++) {
                            if (data()[j] == data()[i]) then {
                                seen = true;
                                break;
                            }
                        }
                        if (!seen) then {
                            if (kept != i) then {
                                data()[kept] = std::move(data()[i]);
                            }
                            kept += 1;
                        }
                    }
                    const unsigned long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function deduplicate

                function distinct() const -> DynamicArray {
                    DynamicArray: out = *this;
                    out.deduplicate();
                    return out;
                } end function distinct

                function replace(const T&: old_value, const T&: new_value) -> unsigned long int {
                    return std::algorithms::replace(data(), data() + size(), old_value, new_value);
                } end function replace

                function replace_if(std::Predicate<T>: pred, const T&: new_value) -> unsigned long int {
                    return std::algorithms::replace_if(data(), data() + size(), pred, new_value);
                } end function replace_if

                function rotate_left(unsigned long int: steps = 1) -> void {
                    std::algorithms::rotate_left(data(), data() + size(), steps);
                } end function rotate_left

                function rotate_right(unsigned long int: steps = 1) -> void {
                    std::algorithms::rotate_right(data(), data() + size(), steps);
                } end function rotate_right

                function shuffle() -> void {
                    std::algorithms::shuffle(data(), data() + size());
                } end function shuffle

                function swap_items(unsigned long int: a, unsigned long int: b) -> void {
                    check(a);
                    check(b);
                    std::algorithms::detail::swap_values(data()[a], data()[b]);
                } end function swap_items

                function partition(std::Predicate<T>: pred) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::partition(data(), data() + size(), pred) - data());
                } end function partition

                function stable_partition(std::Predicate<T>: pred) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::stable_partition(data(), data() + size(), pred) - data());
                } end function stable_partition

                function append(const T&: value) -> void {
                    push_back(value);
                } end function append

                function prepend(const T&: value) -> void {
                    insert(0, value);
                } end function prepend

                function insert_n(unsigned long int: index, unsigned long int: count, const T&: value) -> void {
                    for (unsigned long int: k = 0; k < count; k++) {
                        insert(index, value);
                    }
                } end function insert_n

                function insert_all(unsigned long int: index, const DynamicArray&: items) -> void {
                    for (unsigned long int: k = 0; k < items.size(); k++) {
                        insert(index + k, items[k]);
                    }
                } end function insert_all

                function append_n(unsigned long int: count, const T&: value) -> void {
                    for (unsigned long int: k = 0; k < count; k++) {
                        push_back(value);
                    }
                } end function append_n

                function insert_unordered(unsigned long int: index, const T&: value) -> void {
                    if (index > size()) then {
                        throw detail::out_of_range(index, size());
                    }
                    push_back(value);
                    const unsigned long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                } end function insert_unordered

                function take(unsigned long int: count) const -> DynamicArray {
                    DynamicArray: out;
                    for (unsigned long int: i = 0; i < count && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function take

                function skip(unsigned long int: count) const -> DynamicArray {
                    DynamicArray: out;
                    for (unsigned long int: i = count; i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function skip

                function slice(unsigned long int: start, unsigned long int: stop) const -> DynamicArray {
                    DynamicArray: out;
                    for (unsigned long int: i = start; i < stop && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function slice

                function sliced(long int: start, long int: stop, long int: step, bool: has_start, bool: has_stop) const -> DynamicArray {
                    if (step == 0) then {
                        throw std::errors::collection_error("a slice's step can't be 0");
                    }
                    const long int: n = static_cast<long int>(size());
                    const long int: low = step > 0 ? 0 : -1;
                    const long int: high = step > 0 ? n : n - 1;
                    long int: first = step > 0 ? 0 : n - 1;
                    long int: last = step > 0 ? n : -1;
                    if (has_start) then {
                        first = start < 0 ? start + n : start;
                        first = first < low ? low : (first > high ? high : first);
                    }
                    if (has_stop) then {
                        last = stop < 0 ? stop + n : stop;
                        last = last < low ? low : (last > high ? high : last);
                    }
                    DynamicArray: out;
                    for (long int: i = first; step > 0 ? i < last : i > last; i += step) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function sliced

                function starts_with(const DynamicArray&: prefix) const -> bool {
                    return std::algorithms::starts_with(data(), data() + size(), prefix.data(), prefix.data() + prefix.size());
                } end function starts_with

                function ends_with(const DynamicArray&: suffix) const -> bool {
                    return std::algorithms::ends_with(data(), data() + size(), suffix.data(), suffix.data() + suffix.size());
                } end function ends_with

                function where(const T&: value) -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::equal_to(*this, value);
                } end function where

                function where(std::Predicate<T>: pred) -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::matching(*this, pred);
                } end function where

                function where_indices(const Vector<unsigned long int>&: indices) -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::at_indices(*this, indices);
                } end function where_indices

                function all() -> WhereQuery<DynamicArray, T> {
                    return WhereQuery<DynamicArray, T>::matching(*this, [](const T&: x) -> bool { return true; });
                } end function all

                function swap(DynamicArray&: other) noexcept -> void;

                operator(==) function(const DynamicArray&: other) const -> bool {
                    return detail::same_items(data(), size(), other.data(), other.size());
                }

                operator(!=) function(const DynamicArray&: other) const -> bool {
                    return !detail::same_items(data(), size(), other.data(), other.size());
                }
            } end class DynamicArray

            template <typename T, unsigned int N = 8>
            class SmallVector as "fizmo::collections::SmallVector" {
                function check(unsigned long int: index) const -> void {
                    if (index >= size()) then {
                        throw detail::out_of_range(index, size());
                    }
                } end function check

                function take_back() -> T as "pop_back";
                function take_at(unsigned long int: index) -> T as "pop";
                function insert_at(unsigned long int: index, const T&: value) -> void as "insert";
                function remove_range(unsigned long int: start, unsigned long int: stop) -> void;
                function grow(unsigned long int: count) -> void as "resize";
                function grow_with(unsigned long int: count, const T&: value) -> void as "resize";
                function reserve_more(unsigned long int: count) -> void as "reserve";
                function sort_native() -> void as "sort";

            public:
                constructor();
                constructor(T...: items);

                function size() const -> unsigned long int;
                function capacity() const -> unsigned long int;
                function empty() const -> bool;
                function is_inline() const -> bool as "is_using_inline_storage";
                function data() -> T* as "walnut_rt::coll::data";
                function data() const -> const T* as "walnut_rt::coll::data";
                function begin() -> T* as "walnut_rt::coll::begin";
                function begin() const -> const T* as "walnut_rt::coll::begin";
                function end() -> T* as "walnut_rt::coll::end";
                function end() const -> const T* as "walnut_rt::coll::end";

                function rbegin() -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(data(), size());
                } end function rbegin

                function rend() -> std::iterators::Pointer<T, true> {
                    return std::iterators::Pointer<T, true>(data(), 0);
                } end function rend

                function rbegin() const -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(data(), size());
                } end function rbegin

                function rend() const -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(data(), 0);
                } end function rend

                function backwards() -> std::iterators::Range<std::iterators::Pointer<T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<T, true>>(rbegin(), rend());
                } end function backwards

                function backwards() const -> std::iterators::Range<std::iterators::Pointer<const T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<const T, true>>(rbegin(), rend());
                } end function backwards

                operator([]) function(unsigned long int: index) -> T& {
                    check(index);
                    return data()[index];
                }

                operator([]) function(unsigned long int: index) const -> const T& {
                    check(index);
                    return data()[index];
                }

                function hardware_size() const -> std::hardware_int64 as "walnut_rt::coll::hardware_size";

                operator([]) function(std::hardware_int64: index) -> T& {
                    if (index < 0 || index >= hardware_size()) then {
                        check(static_cast<unsigned long int>(index));
                    }
                    return data()[index];
                }

                operator([]) function(std::hardware_int64: index) const -> const T& {
                    if (index < 0 || index >= hardware_size()) then {
                        check(static_cast<unsigned long int>(index));
                    }
                    return data()[index];
                }

                function at(unsigned long int: index) -> T& {
                    check(index);
                    return data()[index];
                } end function at

                function at(unsigned long int: index) const -> const T& {
                    check(index);
                    return data()[index];
                } end function at

                function front() -> T& {
                    if (empty()) then {
                        throw detail::empty_error("front()");
                    }
                    return data()[0];
                } end function front

                function back() -> T& {
                    if (empty()) then {
                        throw detail::empty_error("back()");
                    }
                    return data()[size() - 1];
                } end function back

                function reserve(unsigned long int: wanted) -> void {
                    if (wanted > capacity()) then {
                        reserve_more(wanted);
                    }
                } end function reserve

                function push_back(const T&: value) -> void;
                function push_back(T&&: value) -> void;

                function pop_back() -> T {
                    if (empty()) then {
                        throw detail::empty_error("pop_back()");
                    }
                    return take_back();
                } end function pop_back

                function insert(unsigned long int: index, const T&: value) -> void {
                    if (index > size()) then {
                        throw detail::out_of_range(index, size());
                    }
                    insert_at(index, value);
                } end function insert

                function erase(unsigned long int: index) -> T {
                    check(index);
                    return take_at(index);
                } end function erase

                function remove(const T&: value) -> unsigned long int {
                    const unsigned long int: removed = detail::compact(data(), size(), value);
                    remove_range(size() - removed, size());
                    return removed;
                } end function remove

                function resize(unsigned long int: count) -> void {
                    grow(count);
                } end function resize

                function resize(unsigned long int: count, const T&: value) -> void {
                    grow_with(count, value);
                } end function resize

                function clear() -> void;
                function shrink_to_fit() -> void;
                function reverse() -> void;

                function find(const T&: value) const -> unsigned long int {
                    return detail::find_in(data(), size(), value);
                } end function find

                function contains(const T&: value) const -> bool {
                    return detail::contains_in(data(), size(), value);
                } end function contains

                requires std::traits::has_operator<std::traits::op::less, T>
                function sort() -> void {
                    if constexpr (std::traits::is_builtin_number<T> || std::traits::is_string<T> || std::traits::is_enum<T> || std::traits::is_bool<T> || std::traits::is_char<T>) then {
                        sort_native();
                    } else then {
                        detail::sort_range(data(), size());
                    }
                } end function sort

                function sort(std::Compare<T>: comp) -> void {
                    std::algorithms::sort(data(), data() + size(), comp);
                } end function sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function sort_descending() -> void {
                    std::algorithms::sort_descending(data(), data() + size());
                } end function sort_descending

                template <typename K>

                requires std::traits::has_operator<std::traits::op::less, K>
                function sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::sort_by(data(), data() + size(), key);
                } end function sort_by

                requires std::traits::has_operator<std::traits::op::less, T>
                function stable_sort() -> void {
                    std::algorithms::stable_sort(data(), data() + size());
                } end function stable_sort

                function stable_sort(std::Compare<T>: comp) -> void {
                    std::algorithms::stable_sort(data(), data() + size(), comp);
                } end function stable_sort

                template <typename K>

                requires std::traits::has_operator<std::traits::op::less, K>
                function stable_sort_by(std::Transform<T, K>: key) -> void {
                    std::algorithms::stable_sort_by(data(), data() + size(), key);
                } end function stable_sort_by

                requires std::traits::has_operator<std::traits::op::less, T>
                function heap_sort() -> void {
                    std::algorithms::heap_sort(data(), data() + size());
                } end function heap_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function quick_sort() -> void {
                    std::algorithms::quick_sort(data(), data() + size());
                } end function quick_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function merge_sort() -> void {
                    std::algorithms::merge_sort(data(), data() + size());
                } end function merge_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function insertion_sort() -> void {
                    std::algorithms::insertion_sort(data(), data() + size());
                } end function insertion_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function selection_sort() -> void {
                    std::algorithms::selection_sort(data(), data() + size());
                } end function selection_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function bubble_sort() -> void {
                    std::algorithms::bubble_sort(data(), data() + size());
                } end function bubble_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function shell_sort() -> void {
                    std::algorithms::shell_sort(data(), data() + size());
                } end function shell_sort

                requires std::traits::is_integer<T> || std::traits::is_char<T>
                function counting_sort(bool: descending = false) -> void {
                    std::algorithms::counting_sort(data(), data() + size(), descending);
                } end function counting_sort

                requires std::traits::is_integer<T> || std::traits::is_char<T>
                function radix_sort() -> void {
                    std::algorithms::radix_sort(data(), data() + size());
                } end function radix_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function partial_sort(unsigned long int: count) -> void {
                    const unsigned long int: k = count < size() ? count : size();
                    std::algorithms::partial_sort(data(), data() + k, data() + size());
                } end function partial_sort

                requires std::traits::has_operator<std::traits::op::less, T>
                function nth_element(unsigned long int: index) -> void {
                    check(index);
                    std::algorithms::nth_element(data(), data() + index, data() + size());
                } end function nth_element

                requires std::traits::has_operator<std::traits::op::less, T>
                function is_sorted() const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size());
                } end function is_sorted

                function is_sorted(std::Compare<T>: comp) const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size(), comp);
                } end function is_sorted

                requires std::traits::has_operator<std::traits::op::less, T>
                function sorted() const -> SmallVector {
                    SmallVector: out = *this;
                    out.sort();
                    return out;
                } end function sorted

                function sorted(std::Compare<T>: comp) const -> SmallVector {
                    SmallVector: out = *this;
                    std::algorithms::sort(out.data(), out.data() + out.size(), comp);
                    return out;
                } end function sorted

                function reversed() const -> SmallVector {
                    SmallVector: out = *this;
                    std::algorithms::reverse(out.data(), out.data() + out.size());
                    return out;
                } end function reversed

                requires std::traits::has_operator<std::traits::op::less, T>
                function binary_search(const T&: value) const -> bool {
                    return std::algorithms::binary_search(data(), data() + size(), value);
                } end function binary_search

                requires std::traits::has_operator<std::traits::op::less, T>
                function lower_bound(const T&: value) const -> unsigned long int {
                    return std::algorithms::lower_bound(data(), data() + size(), value) - data();
                } end function lower_bound

                requires std::traits::has_operator<std::traits::op::less, T>
                function upper_bound(const T&: value) const -> unsigned long int {
                    return std::algorithms::upper_bound(data(), data() + size(), value) - data();
                } end function upper_bound

                requires std::traits::has_operator<std::traits::op::less, T>
                function binary_find(const T&: value) const -> unsigned long int {
                    const T*: it = std::algorithms::binary_find(data(), data() + size(), value);
                    return it == data() + size() ? std::npos : static_cast<unsigned long int>(it - data());
                } end function binary_find

                requires std::traits::has_operator<std::traits::op::less, T>
                function insert_sorted(const T&: value) -> unsigned long int {
                    const unsigned long int: at = upper_bound(value);
                    insert(at, value);
                    return at;
                } end function insert_sorted

                function insert_sorted(const T&: value, std::Compare<T>: comp) -> unsigned long int {
                    const unsigned long int: at = std::algorithms::upper_bound(data(), data() + size(), value, comp) - data();
                    insert(at, value);
                    return at;
                } end function insert_sorted

                function find_if(std::Predicate<T>: pred) const -> unsigned long int {
                    return std::algorithms::index_if(data(), data() + size(), pred);
                } end function find_if

                function find_last(const T&: value) const -> unsigned long int {
                    for (unsigned long int: i = size(); i > 0;) {
                        i--;
                        if (data()[i] == value) then {
                            return i;
                        }
                    }
                    return std::npos;
                } end function find_last

                function find_last_if(std::Predicate<T>: pred) const -> unsigned long int {
                    for (unsigned long int: i = size(); i > 0;) {
                        i--;
                        if (pred(data()[i])) then {
                            return i;
                        }
                    }
                    return std::npos;
                } end function find_last_if

                function find_all(const T&: value) const -> Vector<unsigned long int> {
                    Vector<unsigned long int>: out;
                    for (unsigned long int: i = 0; i < size(); i++) {
                        if (data()[i] == value) then {
                            out.push_back(i);
                        }
                    }
                    return out;
                } end function find_all

                function count(const T&: value) const -> unsigned long int {
                    return std::algorithms::count(data(), data() + size(), value);
                } end function count

                function count_if(std::Predicate<T>: pred) const -> unsigned long int {
                    return std::algorithms::count_if(data(), data() + size(), pred);
                } end function count_if

                function contains_if(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::contains_if(data(), data() + size(), pred);
                } end function contains_if

                function all_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::all_of(data(), data() + size(), pred);
                } end function all_of

                function any_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::any_of(data(), data() + size(), pred);
                } end function any_of

                function none_of(std::Predicate<T>: pred) const -> bool {
                    return std::algorithms::none_of(data(), data() + size(), pred);
                } end function none_of

                requires std::traits::has_operator<std::traits::op::less, T>
                function min_index() const -> unsigned long int {
                    return empty() ? std::npos : static_cast<unsigned long int>(std::algorithms::min_element(data(), data() + size()) - data());
                } end function min_index

                requires std::traits::has_operator<std::traits::op::less, T>
                function max_index() const -> unsigned long int {
                    return empty() ? std::npos : static_cast<unsigned long int>(std::algorithms::max_element(data(), data() + size()) - data());
                } end function max_index

                requires std::traits::has_operator<std::traits::op::less, T>
                function min() const -> T {
                    if (empty()) then {
                        throw detail::empty_error("min()");
                    }
                    return *std::algorithms::min_element(data(), data() + size());
                } end function min

                requires std::traits::has_operator<std::traits::op::less, T>
                function max() const -> T {
                    if (empty()) then {
                        throw detail::empty_error("max()");
                    }
                    return *std::algorithms::max_element(data(), data() + size());
                } end function max

                requires std::traits::has_operator<std::traits::op::add, T>
                function sum() const -> T {
                    if (empty()) then {
                        return T();
                    }
                    T: total = data()[0];
                    for (unsigned long int: i = 1; i < size(); i++) {
                        total = total + data()[i];
                    }
                    return total;
                } end function sum

                template <typename U>
                function accumulate(U: init, std::Combine<U, T>: op) const -> U {
                    return std::algorithms::accumulate(data(), data() + size(), init, op);
                } end function accumulate

                function for_each(std::Action<T>: func) -> void {
                    std::algorithms::for_each(data(), data() + size(), func);
                } end function for_each

                function for_each_indexed(function(unsigned long int, T&) -> void: func) -> void {
                    std::algorithms::for_each_indexed(data(), data() + size(), func);
                } end function for_each_indexed

                function transform(std::Transform<T, T>: func) -> void {
                    std::algorithms::transform_in_place(data(), data() + size(), func);
                } end function transform

                template <typename U>
                function map(std::Transform<T, U>: func) const -> Vector<U> {
                    Vector<U>: out;
                    out.reserve(size());
                    for (unsigned long int: i = 0; i < size(); i++) {
                        out.push_back(func(data()[i]));
                    }
                    return out;
                } end function map

                function filter(std::Predicate<T>: pred) const -> SmallVector {
                    SmallVector: out;
                    for (unsigned long int: i = 0; i < size(); i++) {
                        if (pred(data()[i])) then {
                            out.push_back(data()[i]);
                        }
                    }
                    return out;
                } end function filter

                function remove_if(std::Predicate<T>: pred) -> unsigned long int {
                    const unsigned long int: kept = std::algorithms::remove_if(data(), data() + size(), pred) - data();
                    const unsigned long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function remove_if

                function retain_if(std::Predicate<T>: pred) -> unsigned long int {
                    return remove_if([&pred](const T&: x) -> bool { return !pred(x); });
                } end function retain_if

                function remove_at(unsigned long int: index) -> T {
                    return erase(index);
                } end function remove_at

                function remove_unordered(unsigned long int: index) -> T {
                    check(index);
                    const unsigned long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                    return pop_back();
                } end function remove_unordered

                function swap_remove(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function swap_remove

                function erase_unordered(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function erase_unordered

                function take_at_unordered(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function take_at_unordered

                function remove_at_unordered(unsigned long int: index) -> T {
                    return remove_unordered(index);
                } end function remove_at_unordered

                function remove_first_unordered(const T&: value) -> bool {
                    const unsigned long int: at = find(value);
                    if (at == std::npos) then {
                        return false;
                    }
                    remove_unordered(at);
                    return true;
                } end function remove_first_unordered

                function remove_all_unordered(const T&: value) -> unsigned long int {
                    return remove_if_unordered([&value](const T&: x) -> bool { return x == value; });
                } end function remove_all_unordered

                function remove_if_unordered(std::Predicate<T>: drop) -> unsigned long int {
                    unsigned long int: removed = 0;
                    unsigned long int: i = 0;
                    while (i < size()) {
                        if (drop(data()[i])) then {
                            remove_unordered(i);
                            removed += 1;
                        } else then {
                            i += 1;
                        }
                    }
                    return removed;
                } end function remove_if_unordered

                function retain_if_unordered(std::Predicate<T>: keep) -> unsigned long int {
                    return remove_if_unordered([&keep](const T&: x) -> bool { return !keep(x); });
                } end function retain_if_unordered

                function remove_range_unordered(unsigned long int: start, unsigned long int: stop) -> void {
                    if (start > size()) then {
                        throw detail::out_of_range(start, size());
                    }
                    if (stop < start || stop > size()) then {
                        throw detail::out_of_range(stop, size());
                    }
                    const unsigned long int: count = stop - start;
                    const unsigned long int: n = size();
                    for (unsigned long int: k = 0; k < count; k++) {
                        const unsigned long int: hole = start + k;
                        const unsigned long int: source = n - 1 - k;
                        if (source >= stop && source > hole) then {
                            data()[hole] = std::move(data()[source]);
                        }
                    }
                    for (unsigned long int: k = 0; k < count; k++) {
                        pop_back();
                    }
                } end function remove_range_unordered

                function remove_first(const T&: value) -> bool {
                    const unsigned long int: at = find(value);
                    if (at == std::npos) then {
                        return false;
                    }
                    erase(at);
                    return true;
                } end function remove_first

                function unique() -> unsigned long int {
                    const unsigned long int: kept = std::algorithms::unique(data(), data() + size()) - data();
                    const unsigned long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function unique

                function deduplicate() -> unsigned long int {
                    unsigned long int: kept = 0;
                    for (unsigned long int: i = 0; i < size(); i++) {
                        bool: seen = false;
                        for (unsigned long int: j = 0; j < kept; j++) {
                            if (data()[j] == data()[i]) then {
                                seen = true;
                                break;
                            }
                        }
                        if (!seen) then {
                            if (kept != i) then {
                                data()[kept] = std::move(data()[i]);
                            }
                            kept += 1;
                        }
                    }
                    const unsigned long int: removed = size() - kept;
                    while (size() > kept) {
                        pop_back();
                    }
                    return removed;
                } end function deduplicate

                function distinct() const -> SmallVector {
                    SmallVector: out = *this;
                    out.deduplicate();
                    return out;
                } end function distinct

                function replace(const T&: old_value, const T&: new_value) -> unsigned long int {
                    return std::algorithms::replace(data(), data() + size(), old_value, new_value);
                } end function replace

                function replace_if(std::Predicate<T>: pred, const T&: new_value) -> unsigned long int {
                    return std::algorithms::replace_if(data(), data() + size(), pred, new_value);
                } end function replace_if

                function rotate_left(unsigned long int: steps = 1) -> void {
                    std::algorithms::rotate_left(data(), data() + size(), steps);
                } end function rotate_left

                function rotate_right(unsigned long int: steps = 1) -> void {
                    std::algorithms::rotate_right(data(), data() + size(), steps);
                } end function rotate_right

                function shuffle() -> void {
                    std::algorithms::shuffle(data(), data() + size());
                } end function shuffle

                function swap_items(unsigned long int: a, unsigned long int: b) -> void {
                    check(a);
                    check(b);
                    std::algorithms::detail::swap_values(data()[a], data()[b]);
                } end function swap_items

                function partition(std::Predicate<T>: pred) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::partition(data(), data() + size(), pred) - data());
                } end function partition

                function stable_partition(std::Predicate<T>: pred) -> unsigned long int {
                    return static_cast<unsigned long int>(std::algorithms::stable_partition(data(), data() + size(), pred) - data());
                } end function stable_partition

                function append(const T&: value) -> void {
                    push_back(value);
                } end function append

                function prepend(const T&: value) -> void {
                    insert(0, value);
                } end function prepend

                function insert_n(unsigned long int: index, unsigned long int: count, const T&: value) -> void {
                    for (unsigned long int: k = 0; k < count; k++) {
                        insert(index, value);
                    }
                } end function insert_n

                function insert_all(unsigned long int: index, const SmallVector&: items) -> void {
                    for (unsigned long int: k = 0; k < items.size(); k++) {
                        insert(index + k, items[k]);
                    }
                } end function insert_all

                function append_n(unsigned long int: count, const T&: value) -> void {
                    for (unsigned long int: k = 0; k < count; k++) {
                        push_back(value);
                    }
                } end function append_n

                function insert_unordered(unsigned long int: index, const T&: value) -> void {
                    if (index > size()) then {
                        throw detail::out_of_range(index, size());
                    }
                    push_back(value);
                    const unsigned long int: last_index = size() - 1;
                    if (index != last_index) then {
                        std::algorithms::detail::swap_values(data()[index], data()[last_index]);
                    }
                } end function insert_unordered

                function take(unsigned long int: count) const -> SmallVector {
                    SmallVector: out;
                    for (unsigned long int: i = 0; i < count && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function take

                function skip(unsigned long int: count) const -> SmallVector {
                    SmallVector: out;
                    for (unsigned long int: i = count; i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function skip

                function slice(unsigned long int: start, unsigned long int: stop) const -> SmallVector {
                    SmallVector: out;
                    for (unsigned long int: i = start; i < stop && i < size(); i++) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function slice

                function sliced(long int: start, long int: stop, long int: step, bool: has_start, bool: has_stop) const -> SmallVector {
                    if (step == 0) then {
                        throw std::errors::collection_error("a slice's step can't be 0");
                    }
                    const long int: n = static_cast<long int>(size());
                    const long int: low = step > 0 ? 0 : -1;
                    const long int: high = step > 0 ? n : n - 1;
                    long int: first = step > 0 ? 0 : n - 1;
                    long int: last = step > 0 ? n : -1;
                    if (has_start) then {
                        first = start < 0 ? start + n : start;
                        first = first < low ? low : (first > high ? high : first);
                    }
                    if (has_stop) then {
                        last = stop < 0 ? stop + n : stop;
                        last = last < low ? low : (last > high ? high : last);
                    }
                    SmallVector: out;
                    for (long int: i = first; step > 0 ? i < last : i > last; i += step) {
                        out.push_back(data()[i]);
                    }
                    return out;
                } end function sliced

                function starts_with(const SmallVector&: prefix) const -> bool {
                    return std::algorithms::starts_with(data(), data() + size(), prefix.data(), prefix.data() + prefix.size());
                } end function starts_with

                function ends_with(const SmallVector&: suffix) const -> bool {
                    return std::algorithms::ends_with(data(), data() + size(), suffix.data(), suffix.data() + suffix.size());
                } end function ends_with

                function where(const T&: value) -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::equal_to(*this, value);
                } end function where

                function where(std::Predicate<T>: pred) -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::matching(*this, pred);
                } end function where

                function where_indices(const Vector<unsigned long int>&: indices) -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::at_indices(*this, indices);
                } end function where_indices

                function all() -> WhereQuery<SmallVector, T> {
                    return WhereQuery<SmallVector, T>::matching(*this, [](const T&: x) -> bool { return true; });
                } end function all

                function swap(SmallVector&: other) noexcept -> void;

                operator(==) function(const SmallVector&: other) const -> bool {
                    return detail::same_items(data(), size(), other.data(), other.size());
                }

                operator(!=) function(const SmallVector&: other) const -> bool {
                    return !detail::same_items(data(), size(), other.data(), other.size());
                }
            } end class SmallVector
        } end extern


        template <typename T>
        class LinkedList {
            struct Node {
                T: value;
                Node*: prev = nullptr;
                Node*: next = nullptr;
            } end struct Node

            Node*: m_head = nullptr;
            Node*: m_tail = nullptr;
            unsigned long int: m_size = 0;

            function node_at(const self&, unsigned long int: index) -> Node* {
                if (index >= self.m_size) then {
                    throw detail::out_of_range(index, self.m_size);
                }
                Node*: n = self.m_head;
                for (unsigned long int: i = 0; i < index; i++) {
                    n = n->next;
                }
                return n;
            } end function node_at

            function unlink(self&, Node*: n) -> T {
                if (n->prev != nullptr) then {
                    n->prev->next = n->next;
                } else then {
                    self.m_head = n->next;
                }
                if (n->next != nullptr) then {
                    n->next->prev = n->prev;
                } else then {
                    self.m_tail = n->prev;
                }
                T: out = std::move(n->value);
                delete n;
                self.m_size -= 1;
                return out;
            } end function unlink

        public:
            using Iterator = std::iterators::Linked<Node, T>;
            using ReverseIterator = std::iterators::Linked<Node, T, true>;

            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    push_back(item);
                }
            }

            constructor(const LinkedList&: other) {
                for (Node*: n = other.m_head; n != nullptr; n = n->next) {
                    push_back(n->value);
                }
            }

            constructor(LinkedList&&: other) noexcept : m_head = other.m_head, m_tail = other.m_tail, m_size = other.m_size {
                other.m_head = nullptr;
                other.m_tail = nullptr;
                other.m_size = 0;
            }

            destructor() noexcept {
                clear();
            }

            operator(=) function(self&, const LinkedList&: other) -> LinkedList& {
                if (this == &other) then {
                    return *this;
                }
                self.clear();
                for (Node*: n = other.m_head; n != nullptr; n = n->next) {
                    self.push_back(n->value);
                }
                return *this;
            }

            operator(=) function(self&, LinkedList&&: other) noexcept -> LinkedList& {
                if (this == &other) then {
                    return *this;
                }
                self.clear();
                self.m_head = other.m_head;
                self.m_tail = other.m_tail;
                self.m_size = other.m_size;
                other.m_head = nullptr;
                other.m_tail = nullptr;
                other.m_size = 0;
                return *this;
            }

            function size(const self&) -> unsigned long int {
                return self.m_size;
            } end function size

            function empty(const self&) -> bool {
                return self.m_size == 0;
            } end function empty

            function begin(const self&) -> Iterator {
                return Iterator(self.m_head);
            } end function begin

            function end(const self&) -> Iterator {
                return Iterator(nullptr);
            } end function end

            function rbegin(const self&) -> ReverseIterator {
                return ReverseIterator(self.m_tail);
            } end function rbegin

            function rend(const self&) -> ReverseIterator {
                return ReverseIterator(nullptr);
            } end function rend

            function backwards(const self&) -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(self.rbegin(), self.rend());
            } end function backwards

            function front(self&) -> T& {
                if (self.m_size == 0) then {
                    throw detail::empty_error("front()");
                }
                return self.m_head->value;
            } end function front

            function back(self&) -> T& {
                if (self.m_size == 0) then {
                    throw detail::empty_error("back()");
                }
                return self.m_tail->value;
            } end function back

            function push_back(self&, const T&: value) -> void {
                Node*: n = new Node;
                n->value = value;
                n->prev = self.m_tail;
                if (self.m_tail != nullptr) then {
                    self.m_tail->next = n;
                } else then {
                    self.m_head = n;
                }
                self.m_tail = n;
                self.m_size += 1;
            } end function push_back

            function push_front(self&, const T&: value) -> void {
                Node*: n = new Node;
                n->value = value;
                n->next = self.m_head;
                if (self.m_head != nullptr) then {
                    self.m_head->prev = n;
                } else then {
                    self.m_tail = n;
                }
                self.m_head = n;
                self.m_size += 1;
            } end function push_front

            function pop_back(self&) -> T {
                if (self.m_size == 0) then {
                    throw detail::empty_error("pop_back()");
                }
                return self.unlink(self.m_tail);
            } end function pop_back

            function pop_front(self&) -> T {
                if (self.m_size == 0) then {
                    throw detail::empty_error("pop_front()");
                }
                return self.unlink(self.m_head);
            } end function pop_front

            operator([]) function(self&, unsigned long int: index) -> T& {
                return self.node_at(index)->value;
            }

            function at(self&, unsigned long int: index) -> T& {
                return self.node_at(index)->value;
            } end function at

            function insert(self&, unsigned long int: index, const T&: value) -> void {
                if (index == self.m_size) then {
                    self.push_back(value);
                    return;
                }
                Node*: after = self.node_at(index);
                Node*: n = new Node;
                n->value = value;
                n->next = after;
                n->prev = after->prev;
                if (after->prev != nullptr) then {
                    after->prev->next = n;
                } else then {
                    self.m_head = n;
                }
                after->prev = n;
                self.m_size += 1;
            } end function insert

            function erase(self&, unsigned long int: index) -> T {
                return self.unlink(self.node_at(index));
            } end function erase

            function remove(self&, const T&: value) -> unsigned long int {
                unsigned long int: removed = 0;
                Node*: n = self.m_head;
                while (n != nullptr) {
                    Node*: next = n->next;
                    if (n->value == value) then {
                        self.unlink(n);
                        removed += 1;
                    }
                    n = next;
                }
                return removed;
            } end function remove

            function clear(self&) -> void {
                Node*: n = self.m_head;
                while (n != nullptr) {
                    Node*: next = n->next;
                    delete n;
                    n = next;
                }
                self.m_head = nullptr;
                self.m_tail = nullptr;
                self.m_size = 0;
            } end function clear

            function find(const self&, const T&: value) -> unsigned long int {
                unsigned long int: i = 0;
                for (Node*: n = self.m_head; n != nullptr; n = n->next) {
                    if (n->value == value) then {
                        return i;
                    }
                    i += 1;
                }
                return undefined;
            } end function find

            function contains(const self&, const T&: value) -> bool {
                for (Node*: n = self.m_head; n != nullptr; n = n->next) {
                    if (n->value == value) then {
                        return true;
                    }
                }
                return false;
            } end function contains

            function reverse(self&) -> void {
                Node*: n = self.m_head;
                while (n != nullptr) {
                    Node*: next = n->next;
                    n->next = n->prev;
                    n->prev = next;
                    n = next;
                }
                Node*: old_head = self.m_head;
                self.m_head = self.m_tail;
                self.m_tail = old_head;
            } end function reverse

            function to_vector(const self&) -> Vector<T> {
                Vector<T>: out;
                for (const T&: x in *this) {
                    out.push_back(x);
                }
                return out;
            } end function to_vector

            function count(const self&, const T&: value) -> unsigned long int {
                unsigned long int: n = 0;
                for (const T&: x in *this) {
                    if (x == value) then {
                        n += 1;
                    }
                }
                return n;
            } end function count

            function count_if(const self&, std::Predicate<T>: pred) -> unsigned long int {
                unsigned long int: n = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        n += 1;
                    }
                }
                return n;
            } end function count_if

            function find_if(const self&, std::Predicate<T>: pred) -> unsigned long int {
                unsigned long int: i = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        return i;
                    }
                    i += 1;
                }
                return std::npos;
            } end function find_if

            function contains_if(const self&, std::Predicate<T>: pred) -> bool {
                return self.find_if(pred) >= 0;
            } end function contains_if

            function all_of(const self&, std::Predicate<T>: pred) -> bool {
                return self.count_if(pred) == self.size();
            } end function all_of

            function any_of(const self&, std::Predicate<T>: pred) -> bool {
                return self.find_if(pred) >= 0;
            } end function any_of

            function none_of(const self&, std::Predicate<T>: pred) -> bool {
                return self.find_if(pred) < 0;
            } end function none_of

            function for_each(self&, std::Action<T>: func) -> void {
                for (T&: x in *this) {
                    func(x);
                }
            } end function for_each

            function transform(self&, std::Transform<T, T>: func) -> void {
                for (T&: x in *this) {
                    x = func(x);
                }
            } end function transform

            function sort(self&, std::Compare<T>: comp) -> void {
                Vector<T>: items = self.to_vector();
                std::algorithms::sort(items.data(), items.data() + items.size(), comp);
                unsigned long int: i = 0;
                for (T&: x in *this) {
                    x = std::move(items[i]);
                    i += 1;
                }
            } end function sort

            requires std::traits::has_operator<std::traits::op::less, T>
            function sort(self&) -> void {
                self.sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function sort

            function stable_sort(self&, std::Compare<T>: comp) -> void {
                Vector<T>: items = self.to_vector();
                std::algorithms::stable_sort(items.data(), items.data() + items.size(), comp);
                unsigned long int: i = 0;
                for (T&: x in *this) {
                    x = std::move(items[i]);
                    i += 1;
                }
            } end function stable_sort

            requires std::traits::has_operator<std::traits::op::less, T>
            function stable_sort(self&) -> void {
                self.stable_sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function stable_sort

            requires std::traits::has_operator<std::traits::op::less, T>
            function is_sorted(const self&) -> bool {
                Vector<T>: items = self.to_vector();
                return std::algorithms::is_sorted(items.data(), items.data() + items.size());
            } end function is_sorted

            requires std::traits::has_operator<std::traits::op::less, T>
            function min(const self&) -> T {
                if (self.empty()) then {
                    throw detail::empty_error("min()");
                }
                Vector<T>: items = self.to_vector();
                return *std::algorithms::min_element(items.data(), items.data() + items.size());
            } end function min

            requires std::traits::has_operator<std::traits::op::less, T>
            function max(const self&) -> T {
                if (self.empty()) then {
                    throw detail::empty_error("max()");
                }
                Vector<T>: items = self.to_vector();
                return *std::algorithms::max_element(items.data(), items.data() + items.size());
            } end function max

            function where(self&, const T&: value) -> WhereQuery<LinkedList, T> {
                return WhereQuery<LinkedList, T>::equal_to(*this, value);
            } end function where

            function where(self&, std::Predicate<T>: pred) -> WhereQuery<LinkedList, T> {
                return WhereQuery<LinkedList, T>::matching(*this, pred);
            } end function where
        } end class LinkedList

        template <typename T>
        class Deque {
            T*: m_data = nullptr;
            unsigned long int: m_capacity = 0;
            unsigned long int: m_head = 0;
            unsigned long int: m_size = 0;

            function slot(const self&, unsigned long int: index) -> unsigned long int {
                return (self.m_head + index) % self.m_capacity;
            } end function slot

            function grow_to(self&, unsigned long int: wanted) -> void {
                if (wanted <= self.m_capacity) then {
                    return;
                }
                T*: fresh = new T[wanted];
                for (unsigned long int: i = 0; i < self.m_size; i++) {
                    fresh[i] = std::move(self.m_data[self.slot(i)]);
                }
                if (self.m_data != nullptr) then {
                    delete[] self.m_data;
                }
                self.m_data = fresh;
                self.m_capacity = wanted;
                self.m_head = 0;
            } end function grow_to

            function check(const self&, unsigned long int: index) -> void {
                if (index >= self.m_size) then {
                    throw detail::out_of_range(index, self.m_size);
                }
            } end function check

        public:
            using Iterator = std::iterators::Indexed<Deque, T>;
            using ReverseIterator = std::iterators::Indexed<Deque, T, true>;

            constructor() { }

            constructor(T...: items) {
                grow_to(countof(items));
                for (const T&: item in items) {
                    push_back(item);
                }
            }

            constructor(const Deque&: other) {
                grow_to(other.m_size);
                for (unsigned long int: i = 0; i < other.m_size; i++) {
                    m_data[i] = other.m_data[other.slot(i)];
                }
                m_size = other.m_size;
            }

            constructor(Deque&&: other) noexcept : m_data = other.m_data, m_capacity = other.m_capacity, m_head = other.m_head, m_size = other.m_size {
                other.m_data = nullptr;
                other.m_capacity = 0;
                other.m_head = 0;
                other.m_size = 0;
            }

            destructor() noexcept {
                if (m_data != nullptr) then {
                    delete[] m_data;
                }
            }

            operator(=) function(self&, const Deque&: other) -> Deque& {
                if (this == &other) then {
                    return *this;
                }
                self.clear();
                self.grow_to(other.m_size);
                self.m_head = 0;
                for (unsigned long int: i = 0; i < other.m_size; i++) {
                    self.m_data[i] = other.m_data[other.slot(i)];
                }
                self.m_size = other.m_size;
                return *this;
            }

            operator(=) function(self&, Deque&&: other) noexcept -> Deque& {
                if (this == &other) then {
                    return *this;
                }
                if (self.m_data != nullptr) then {
                    delete[] self.m_data;
                }
                self.m_data = other.m_data;
                self.m_capacity = other.m_capacity;
                self.m_head = other.m_head;
                self.m_size = other.m_size;
                other.m_data = nullptr;
                other.m_capacity = 0;
                other.m_head = 0;
                other.m_size = 0;
                return *this;
            }

            function size(const self&) -> unsigned long int {
                return self.m_size;
            } end function size

            function empty(const self&) -> bool {
                return self.m_size == 0;
            } end function empty

            function begin(self&) -> Iterator {
                return Iterator(this, 0);
            } end function begin

            function end(self&) -> Iterator {
                return Iterator(this, self.m_size);
            } end function end

            function begin(const self&) -> Iterator {
                return Iterator(const_cast<Deque*>(this), 0);
            } end function begin

            function end(const self&) -> Iterator {
                return Iterator(const_cast<Deque*>(this), self.m_size);
            } end function end

            function rbegin(self&) -> ReverseIterator {
                return ReverseIterator(this, self.m_size);
            } end function rbegin

            function rend(self&) -> ReverseIterator {
                return ReverseIterator(this, 0);
            } end function rend

            function rbegin(const self&) -> ReverseIterator {
                return ReverseIterator(const_cast<Deque*>(this), self.m_size);
            } end function rbegin

            function rend(const self&) -> ReverseIterator {
                return ReverseIterator(const_cast<Deque*>(this), 0);
            } end function rend

            function backwards(const self&) -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(self.rbegin(), self.rend());
            } end function backwards

            operator([]) function(self&, unsigned long int: index) -> T& {
                self.check(index);
                return self.m_data[self.slot(index)];
            }

            operator([]) function(const self&, unsigned long int: index) -> const T& {
                self.check(index);
                return self.m_data[self.slot(index)];
            }

            function at(self&, unsigned long int: index) -> T& {
                self.check(index);
                return self.m_data[self.slot(index)];
            } end function at

            function front(self&) -> T& {
                if (self.m_size == 0) then {
                    throw detail::empty_error("front()");
                }
                return self.m_data[self.m_head];
            } end function front

            function back(self&) -> T& {
                if (self.m_size == 0) then {
                    throw detail::empty_error("back()");
                }
                return self.m_data[self.slot(self.m_size - 1)];
            } end function back

            function push_back(self&, const T&: value) -> void {
                if (self.m_size == self.m_capacity) then {
                    self.grow_to(detail::grown(self.m_capacity, self.m_size + 1));
                }
                self.m_data[self.slot(self.m_size)] = value;
                self.m_size += 1;
            } end function push_back

            function push_front(self&, const T&: value) -> void {
                if (self.m_size == self.m_capacity) then {
                    self.grow_to(detail::grown(self.m_capacity, self.m_size + 1));
                }
                self.m_head = (self.m_head + self.m_capacity - 1) % self.m_capacity;
                self.m_data[self.m_head] = value;
                self.m_size += 1;
            } end function push_front

            function pop_back(self&) -> T {
                if (self.m_size == 0) then {
                    throw detail::empty_error("pop_back()");
                }
                const unsigned long int: at = self.slot(self.m_size - 1);
                T: out = std::move(self.m_data[at]);
                self.m_data[at] = T();
                self.m_size -= 1;
                return out;
            } end function pop_back

            function pop_front(self&) -> T {
                if (self.m_size == 0) then {
                    throw detail::empty_error("pop_front()");
                }
                T: out = std::move(self.m_data[self.m_head]);
                self.m_data[self.m_head] = T();
                self.m_head = (self.m_head + 1) % self.m_capacity;
                self.m_size -= 1;
                return out;
            } end function pop_front

            function clear(self&) -> void {
                for (unsigned long int: i = 0; i < self.m_size; i++) {
                    self.m_data[self.slot(i)] = T();
                }
                self.m_head = 0;
                self.m_size = 0;
            } end function clear

            function find(const self&, const T&: value) -> unsigned long int {
                for (unsigned long int: i = 0; i < self.m_size; i++) {
                    if (self.m_data[self.slot(i)] == value) then {
                        return i;
                    }
                }
                return undefined;
            } end function find

            function contains(const self&, const T&: value) -> bool {
                for (unsigned long int: i = 0; i < self.m_size; i++) {
                    if (self.m_data[self.slot(i)] == value) then {
                        return true;
                    }
                }
                return false;
            } end function contains

            function to_vector(const self&) -> Vector<T> {
                Vector<T>: out;
                for (const T&: x in *this) {
                    out.push_back(x);
                }
                return out;
            } end function to_vector

            function count(const self&, const T&: value) -> unsigned long int {
                unsigned long int: n = 0;
                for (const T&: x in *this) {
                    if (x == value) then {
                        n += 1;
                    }
                }
                return n;
            } end function count

            function count_if(const self&, std::Predicate<T>: pred) -> unsigned long int {
                unsigned long int: n = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        n += 1;
                    }
                }
                return n;
            } end function count_if

            function find_if(const self&, std::Predicate<T>: pred) -> unsigned long int {
                unsigned long int: i = 0;
                for (const T&: x in *this) {
                    if (pred(x)) then {
                        return i;
                    }
                    i += 1;
                }
                return std::npos;
            } end function find_if

            function contains_if(const self&, std::Predicate<T>: pred) -> bool {
                return self.find_if(pred) >= 0;
            } end function contains_if

            function all_of(const self&, std::Predicate<T>: pred) -> bool {
                return self.count_if(pred) == self.size();
            } end function all_of

            function any_of(const self&, std::Predicate<T>: pred) -> bool {
                return self.find_if(pred) >= 0;
            } end function any_of

            function none_of(const self&, std::Predicate<T>: pred) -> bool {
                return self.find_if(pred) < 0;
            } end function none_of

            function for_each(self&, std::Action<T>: func) -> void {
                for (T&: x in *this) {
                    func(x);
                }
            } end function for_each

            function transform(self&, std::Transform<T, T>: func) -> void {
                for (T&: x in *this) {
                    x = func(x);
                }
            } end function transform

            function sort(self&, std::Compare<T>: comp) -> void {
                Vector<T>: items = self.to_vector();
                std::algorithms::sort(items.data(), items.data() + items.size(), comp);
                unsigned long int: i = 0;
                for (T&: x in *this) {
                    x = std::move(items[i]);
                    i += 1;
                }
            } end function sort

            requires std::traits::has_operator<std::traits::op::less, T>
            function sort(self&) -> void {
                self.sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function sort

            function stable_sort(self&, std::Compare<T>: comp) -> void {
                Vector<T>: items = self.to_vector();
                std::algorithms::stable_sort(items.data(), items.data() + items.size(), comp);
                unsigned long int: i = 0;
                for (T&: x in *this) {
                    x = std::move(items[i]);
                    i += 1;
                }
            } end function stable_sort

            requires std::traits::has_operator<std::traits::op::less, T>
            function stable_sort(self&) -> void {
                self.stable_sort([](const T&: a, const T&: b) -> bool { return a < b; });
            } end function stable_sort

            requires std::traits::has_operator<std::traits::op::less, T>
            function is_sorted(const self&) -> bool {
                Vector<T>: items = self.to_vector();
                return std::algorithms::is_sorted(items.data(), items.data() + items.size());
            } end function is_sorted

            requires std::traits::has_operator<std::traits::op::less, T>
            function min(const self&) -> T {
                if (self.empty()) then {
                    throw detail::empty_error("min()");
                }
                Vector<T>: items = self.to_vector();
                return *std::algorithms::min_element(items.data(), items.data() + items.size());
            } end function min

            requires std::traits::has_operator<std::traits::op::less, T>
            function max(const self&) -> T {
                if (self.empty()) then {
                    throw detail::empty_error("max()");
                }
                Vector<T>: items = self.to_vector();
                return *std::algorithms::max_element(items.data(), items.data() + items.size());
            } end function max

            function where(self&, const T&: value) -> WhereQuery<Deque, T> {
                return WhereQuery<Deque, T>::equal_to(*this, value);
            } end function where

            function where(self&, std::Predicate<T>: pred) -> WhereQuery<Deque, T> {
                return WhereQuery<Deque, T>::matching(*this, pred);
            } end function where
        } end class Deque

        template <typename P>
        requires std::traits::is_pointer<P>
        function hash_address(P: value) -> unsigned long int {
            return detail::mix(reinterpret_cast<unsigned long int>(value));
        } end function hash_address

        safe(compile) {
            template <typename T>
            class Stack {
                Vector<T>: m_items;

            public:
                constructor() { }

                function push(self&, const T&: value) -> void {
                    self.m_items.push_back(value);
                } end function push

                function pop(self&) -> T {
                    if (self.m_items.empty()) then {
                        throw detail::empty_error("pop()");
                    }
                    return self.m_items.pop_back();
                } end function pop

                function top(self&) -> T& {
                    if (self.m_items.empty()) then {
                        throw detail::empty_error("top()");
                    }
                    return self.m_items.back();
                } end function top

                function size(const self&) -> unsigned long int {
                    return self.m_items.size();
                } end function size

                function empty(const self&) -> bool {
                    return self.m_items.empty();
                } end function empty

                function clear(self&) -> void {
                    self.m_items.clear();
                } end function clear
            } end class Stack

            template <typename T>
            class Queue {
                Deque<T>: m_items;

            public:
                constructor() { }

                function push(self&, const T&: value) -> void {
                    self.m_items.push_back(value);
                } end function push

                function pop(self&) -> T {
                    if (self.m_items.empty()) then {
                        throw detail::empty_error("pop()");
                    }
                    return self.m_items.pop_front();
                } end function pop

                function front(self&) -> T& {
                    if (self.m_items.empty()) then {
                        throw detail::empty_error("front()");
                    }
                    return self.m_items.front();
                } end function front

                function back(self&) -> T& {
                    if (self.m_items.empty()) then {
                        throw detail::empty_error("back()");
                    }
                    return self.m_items.back();
                } end function back

                function size(const self&) -> unsigned long int {
                    return self.m_items.size();
                } end function size

                function empty(const self&) -> bool {
                    return self.m_items.empty();
                } end function empty

                function clear(self&) -> void {
                    self.m_items.clear();
                } end function clear
            } end class Queue

            template <typename T, bool Largest = true>
            requires std::traits::has_operator<std::traits::op::less, T>
            class PriorityQueue {
                Vector<T>: m_heap;

                function before(const self&, const T&: a, const T&: b) -> bool {
                    if constexpr (Largest) then {
                        return a < b;
                    } else then {
                        return b < a;
                    }
                } end function before

            public:
                constructor() { }

                constructor(T...: items) {
                    for (const T&: item in items) {
                        self.push(item);
                    }
                }

                function push(self&, const T&: value) -> void {
                    self.m_heap.push_back(value);
                    unsigned long int: child = self.m_heap.size() - 1;
                    while (child > 0) {
                        const unsigned long int: parent = (child - 1) / 2;
                        if (!self.before(self.m_heap[parent], self.m_heap[child])) then {
                            break;
                        }
                        detail::swap_items(self.m_heap[parent], self.m_heap[child]);
                        child = parent;
                    }
                } end function push

                function top(const self&) -> const T& {
                    if (self.m_heap.empty()) then {
                        throw detail::empty_error("top()");
                    }
                    return self.m_heap[0];
                } end function top

                function pop(self&) -> T {
                    if (self.m_heap.empty()) then {
                        throw detail::empty_error("pop()");
                    }
                    const unsigned long int: last = self.m_heap.size() - 1;
                    detail::swap_items(self.m_heap[0], self.m_heap[last]);
                    T: out = self.m_heap.pop_back();
                    const unsigned long int: count = self.m_heap.size();
                    unsigned long int: root = 0;
                    while (root * 2 + 1 < count) {
                        unsigned long int: child = root * 2 + 1;
                        if (child + 1 < count && self.before(self.m_heap[child], self.m_heap[child + 1])) then {
                            child += 1;
                        }
                        if (!self.before(self.m_heap[root], self.m_heap[child])) then {
                            break;
                        }
                        detail::swap_items(self.m_heap[root], self.m_heap[child]);
                        root = child;
                    }
                    return out;
                } end function pop

                function size(const self&) -> unsigned long int {
                    return self.m_heap.size();
                } end function size

                function empty(const self&) -> bool {
                    return self.m_heap.empty();
                } end function empty

                function clear(self&) -> void {
                    self.m_heap.clear();
                } end function clear
            } end class PriorityQueue

            function hash_text(string_view: s) noexcept -> unsigned long int {
                std::hardware_uint64: h = static_cast<std::hardware_uint64>(14695981039346656037ul);
                for (char: c in s) {
                    h = (h ^ static_cast<std::hardware_uint64>(static_cast<unsigned long int>(c))) * static_cast<std::hardware_uint64>(1099511628211ul);
                }
                return static_cast<unsigned long int>(h);
            } end function hash_text

            template <typename T>
            requires std::traits::is_bool<T> || std::traits::is_char<T> || std::traits::is_enum<T> || std::traits::is_builtin_integer<T> || std::traits::is_builtin_float<T> || std::traits::is_string<T> || std::traits::is_string_view<T> || std::traits::is_pointer<T> || std::concepts::hashable<T>
            function hash_of(const T&: value) -> unsigned long int {
                if constexpr (std::traits::is_bool<T>) then {
                    return value ? 1ul : 0ul;
                } else if constexpr (std::traits::is_char<T>) then {
                    return detail::mix(static_cast<unsigned long int>(static_cast<unsigned long int>(value)));
                } else if constexpr (std::traits::is_enum<T>) then {
                    return hash_of(static_cast<std::traits::underlying_type<T>>(value));
                } else if constexpr (std::traits::is_builtin_integer<T>) then {
                    return detail::mix(static_cast<unsigned long int>(value));
                } else if constexpr (std::traits::is_builtin_float<T>) then {
                    return hash_text(static_cast<string>(`${value}`));
                } else if constexpr (std::traits::is_string<T> || std::traits::is_string_view<T>) then {
                    return hash_text(value);
                } else if constexpr (std::traits::is_pointer<T>) then {
                    return hash_address(value);
                } else then {
                    return value.hash();
                }
            } end function hash_of

            template <typename A, typename B>
            requires (requires (const A&: a, const B&: b) { hash_of(a); hash_of(b); })
            function hash_of(const Pair<A, B>&: p) -> unsigned long int {
                return detail::combine(hash_of(p.first), hash_of(p.second));
            } end function hash_of

            template <typename T>
            concept HashKey = requires (const T&: value) { hash_of(value); }

            function hash_combine(unsigned long int: a, unsigned long int: b) noexcept -> unsigned long int {
                return detail::combine(a, b);
            } end function hash_combine
        } end safe

        template <typename K, typename V>
        requires HashKey<K> && std::traits::has_operator<std::traits::op::equal, K>
        class UnorderedMap {
            Pair<K, V>*: m_slots = nullptr;
            char*: m_state = nullptr;
            unsigned long int: m_capacity = 0;
            unsigned long int: m_size = 0;
            unsigned long int: m_used = 0;

            function slot_of(const self&, const K&: key) -> unsigned long int {
                if (self.m_capacity == 0) then {
                    return std::npos;
                }
                unsigned long int: i = static_cast<unsigned long int>(hash_of(key) % static_cast<unsigned long int>(self.m_capacity));
                while (self.m_state[i] != '\0') {
                    if (self.m_state[i] == 'f' && self.m_slots[i].first == key) then {
                        return i;
                    }
                    i = (i + 1) % self.m_capacity;
                }
                return std::npos;
            } end function slot_of

            function rehash(self&, unsigned long int: wanted) -> void {
                Pair<K, V>*: old_slots = self.m_slots;
                char*: old_state = self.m_state;
                const unsigned long int: old_capacity = self.m_capacity;
                self.m_slots = new Pair<K, V>[wanted];
                self.m_state = new char[wanted];
                for (unsigned long int: i = 0; i < wanted; i++) {
                    self.m_state[i] = '\0';
                }
                self.m_capacity = wanted;
                self.m_size = 0;
                self.m_used = 0;
                for (unsigned long int: i = 0; i < old_capacity; i++) {
                    if (old_state[i] == 'f') then {
                        self.place(std::move(old_slots[i].first), std::move(old_slots[i].second));
                    }
                }
                if (old_slots != nullptr) then {
                    delete[] old_slots;
                    delete[] old_state;
                }
            } end function rehash

            function place(self&, const K&: key, const V&: value) -> unsigned long int {
                unsigned long int: i = static_cast<unsigned long int>(hash_of(key) % static_cast<unsigned long int>(self.m_capacity));
                unsigned long int: reuse = std::npos;
                while (self.m_state[i] != '\0') {
                    if (self.m_state[i] == 'f' && self.m_slots[i].first == key) then {
                        return i;
                    }
                    if (self.m_state[i] == 'd' && reuse == std::npos) then {
                        reuse = i;
                    }
                    i = (i + 1) % self.m_capacity;
                }
                if (reuse != std::npos) then {
                    i = reuse;
                } else then {
                    self.m_used += 1;
                }
                self.m_slots[i].first = key;
                self.m_slots[i].second = value;
                self.m_state[i] = 'f';
                self.m_size += 1;
                return i;
            } end function place

            function make_room(self&) -> void {
                if (self.m_capacity == 0) then {
                    self.rehash(8);
                } else if ((self.m_used + 1) * 4 > self.m_capacity * 3) then {
                    self.rehash(static_cast<unsigned long int>(self.m_size * 2 < 8 ? 8 : self.m_size * 4));
                }
            } end function make_room

            function copy_from(self&, const UnorderedMap&: other) -> void {
                if (other.m_capacity == 0) then {
                    return;
                }
                self.rehash(other.m_capacity);
                for (unsigned long int: i = 0; i < other.m_capacity; i++) {
                    if (other.m_state[i] == 'f') then {
                        self.place(other.m_slots[i].first, other.m_slots[i].second);
                    }
                }
            } end function copy_from

            function release(self&) -> void {
                if (self.m_slots != nullptr) then {
                    delete[] self.m_slots;
                    delete[] self.m_state;
                }
                self.m_slots = nullptr;
                self.m_state = nullptr;
                self.m_capacity = 0;
                self.m_size = 0;
                self.m_used = 0;
            } end function release

        public:
            using Iterator = std::iterators::Sparse<Pair<K, V>>;
            using ReverseIterator = std::iterators::Sparse<Pair<K, V>, true>;

            constructor() { }

            constructor(const UnorderedMap&: other) {
                copy_from(other);
            }

            constructor(UnorderedMap&&: other) noexcept : m_slots = other.m_slots, m_state = other.m_state, m_capacity = other.m_capacity, m_size = other.m_size, m_used = other.m_used {
                other.m_slots = nullptr;
                other.m_state = nullptr;
                other.m_capacity = 0;
                other.m_size = 0;
                other.m_used = 0;
            }

            destructor() noexcept {
                release();
            }

            operator(=) function(self&, const UnorderedMap&: other) -> UnorderedMap& {
                if (this == &other) then {
                    return *this;
                }
                self.release();
                self.copy_from(other);
                return *this;
            }

            operator(=) function(self&, UnorderedMap&&: other) noexcept -> UnorderedMap& {
                if (this == &other) then {
                    return *this;
                }
                self.release();
                self.m_slots = other.m_slots;
                self.m_state = other.m_state;
                self.m_capacity = other.m_capacity;
                self.m_size = other.m_size;
                self.m_used = other.m_used;
                other.m_slots = nullptr;
                other.m_state = nullptr;
                other.m_capacity = 0;
                other.m_size = 0;
                other.m_used = 0;
                return *this;
            }

            function size(const self&) -> unsigned long int {
                return self.m_size;
            } end function size

            function empty(const self&) -> bool {
                return self.m_size == 0;
            } end function empty

            function begin(const self&) -> Iterator {
                return Iterator(self.m_slots, self.m_state, self.m_capacity, 0);
            } end function begin

            function end(const self&) -> Iterator {
                return Iterator(self.m_slots, self.m_state, self.m_capacity, self.m_capacity);
            } end function end

            function rbegin(const self&) -> ReverseIterator {
                return ReverseIterator(self.m_slots, self.m_state, self.m_capacity, self.m_capacity);
            } end function rbegin

            function rend(const self&) -> ReverseIterator {
                return ReverseIterator(self.m_slots, self.m_state, self.m_capacity, 0);
            } end function rend

            function backwards(const self&) -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(self.rbegin(), self.rend());
            } end function backwards

            function insert(self&, const K&: key, const V&: value) -> bool {
                if (self.slot_of(key) >= 0) then {
                    return false;
                }
                self.make_room();
                self.place(key, value);
                return true;
            } end function insert

            function set(self&, const K&: key, const V&: value) -> void {
                const unsigned long int: at = self.slot_of(key);
                if (at != std::npos) then {
                    self.m_slots[at].second = value;
                    return;
                }
                self.make_room();
                self.place(key, value);
            } end function set

            operator([]) function(self&, const K&: key) -> V& {
                unsigned long int: at = self.slot_of(key);
                if (at == std::npos) then {
                    self.make_room();
                    at = self.place(key, V());
                }
                return self.m_slots[at].second;
            }

            function at(self&, const K&: key) -> V& {
                const unsigned long int: index = self.slot_of(key);
                if (index == std::npos) then {
                    throw std::errors::collection_error(static_cast<string>(`the key isn't in the map`));
                }
                return self.m_slots[index].second;
            } end function at

            function find(self&, const K&: key) -> V* {
                const unsigned long int: index = self.slot_of(key);
                return index == std::npos ? nullptr : &self.m_slots[index].second;
            } end function find

            function get(const self&, const K&: key, const V&: fallback) -> V {
                const unsigned long int: index = self.slot_of(key);
                return index == std::npos ? fallback : self.m_slots[index].second;
            } end function get

            function contains(const self&, const K&: key) -> bool {
                return self.slot_of(key) >= 0;
            } end function contains

            function remove(self&, const K&: key) -> bool {
                const unsigned long int: index = self.slot_of(key);
                if (index == std::npos) then {
                    return false;
                }
                self.m_slots[index] = Pair<K, V>();
                self.m_state[index] = 'd';
                self.m_size -= 1;
                return true;
            } end function remove

            function clear(self&) -> void {
                self.release();
            } end function clear

            function reserve(self&, unsigned long int: count) -> void {
                unsigned long int: wanted = 8;
                while (wanted * 3 < count * 4) {
                    wanted *= 2;
                }
                if (wanted > self.m_capacity) then {
                    self.rehash(wanted);
                }
            } end function reserve

            function keys(const self&) -> Vector<K> {
                Vector<K>: out;
                for (unsigned long int: i = 0; i < self.m_capacity; i++) {
                    if (self.m_state[i] == 'f') then {
                        out.push_back(self.m_slots[i].first);
                    }
                }
                return out;
            } end function keys

            function values(const self&) -> Vector<V> {
                Vector<V>: out;
                for (unsigned long int: i = 0; i < self.m_capacity; i++) {
                    if (self.m_state[i] == 'f') then {
                        out.push_back(self.m_slots[i].second);
                    }
                }
                return out;
            } end function values
        } end class UnorderedMap

        safe(compile) {
            template <typename T>
            requires HashKey<T> && std::traits::has_operator<std::traits::op::equal, T>
            class UnorderedSet {
                UnorderedMap<T, bool>: m_items;

            public:
                using Iterator = std::iterators::Keys<UnorderedMap<T, bool>::Iterator, const T>;
                using ReverseIterator = std::iterators::Keys<UnorderedMap<T, bool>::ReverseIterator, const T>;

                constructor() { }

                constructor(T...: items) {
                    for (const T&: item in items) {
                        self.m_items.insert(item, true);
                    }
                }

                function size(const self&) -> unsigned long int {
                    return self.m_items.size();
                } end function size

                function empty(const self&) -> bool {
                    return self.m_items.empty();
                } end function empty

                function begin(const self&) -> Iterator {
                    return Iterator(self.m_items.begin());
                } end function begin

                function end(const self&) -> Iterator {
                    return Iterator(self.m_items.end());
                } end function end

                function rbegin(const self&) -> ReverseIterator {
                    return ReverseIterator(self.m_items.rbegin());
                } end function rbegin

                function rend(const self&) -> ReverseIterator {
                    return ReverseIterator(self.m_items.rend());
                } end function rend

                function backwards(const self&) -> std::iterators::Range<ReverseIterator> {
                    return std::iterators::Range<ReverseIterator>(self.rbegin(), self.rend());
                } end function backwards

                function insert(self&, const T&: value) -> bool {
                    return self.m_items.insert(value, true);
                } end function insert

                function contains(const self&, const T&: value) -> bool {
                    return self.m_items.contains(value);
                } end function contains

                function remove(self&, const T&: value) -> bool {
                    return self.m_items.remove(value);
                } end function remove

                function clear(self&) -> void {
                    self.m_items.clear();
                } end function clear

                function to_vector(const self&) -> Vector<T> {
                    return self.m_items.keys();
                } end function to_vector
            } end class UnorderedSet
        } end safe

        hidden namespace detail {
            safe(compile) {
                template <typename E>
                struct TreeNode {
                    E: entry;
                    TreeNode<E>*: left = nullptr;
                    TreeNode<E>*: right = nullptr;
                    TreeNode<E>*: parent = nullptr;
                    unsigned long int: count = 1;
                    bool: red = true;
                } end struct TreeNode
            } end safe

            template <typename E>
            function tree_count(TreeNode<E>*: n) -> unsigned long int {
                return n == nullptr ? 0ul : n->count;
            } end function tree_count

            template <typename E>
            function tree_first(TreeNode<E>*: n) -> TreeNode<E>* {
                if (n == nullptr) then {
                    return nullptr;
                }
                TreeNode<E>*: at = n;
                while (at->left != nullptr) {
                    at = at->left;
                }
                return at;
            } end function tree_first

            template <typename E>
            function tree_last(TreeNode<E>*: n) -> TreeNode<E>* {
                if (n == nullptr) then {
                    return nullptr;
                }
                TreeNode<E>*: at = n;
                while (at->right != nullptr) {
                    at = at->right;
                }
                return at;
            } end function tree_last

            template <typename E>
            function tree_next(TreeNode<E>*: n) -> TreeNode<E>* {
                if (n->right != nullptr) then {
                    return tree_first(n->right);
                }
                TreeNode<E>*: at = n;
                TreeNode<E>*: up = n->parent;
                while (up != nullptr && at == up->right) {
                    at = up;
                    up = up->parent;
                }
                return up;
            } end function tree_next

            template <typename E>
            function tree_copy(TreeNode<E>*: source, TreeNode<E>*: parent) -> TreeNode<E>* {
                if (source == nullptr) then {
                    return nullptr;
                }
                TreeNode<E>*: n = new TreeNode<E>;
                n->entry = source->entry;
                n->count = source->count;
                n->red = source->red;
                n->parent = parent;
                n->left = tree_copy(source->left, n);
                n->right = tree_copy(source->right, n);
                return n;
            } end function tree_copy

            template <typename E>
            function tree_free(TreeNode<E>*: n) -> void {
                TreeNode<E>*: at = n;
                while (at != nullptr) {
                    tree_free(at->right);
                    TreeNode<E>*: left = at->left;
                    delete at;
                    at = left;
                }
            } end function tree_free

            template <typename K, typename E>
            class Tree {
            public:
                TreeNode<E>*: m_root = nullptr;

                static function key_of(const E&: entry) -> const K& {
                    if constexpr (std::traits::is_same<E, K>) then {
                        return entry;
                    } else then {
                        return entry.first;
                    }
                } end function key_of

                constructor() { }

                constructor(const Tree&: other) : m_root = tree_copy<E>(other.m_root, nullptr) { }

                constructor(Tree&&: other) noexcept : m_root = other.m_root {
                    other.m_root = nullptr;
                }

                destructor() noexcept {
                    tree_free(m_root);
                }

                operator(=) function(self&, const Tree&: other) -> Tree& {
                    if (this != &other) then {
                        tree_free(self.m_root);
                        self.m_root = tree_copy<E>(other.m_root, nullptr);
                    }
                    return *this;
                }

                operator(=) function(self&, Tree&&: other) noexcept -> Tree& {
                    if (this != &other) then {
                        tree_free(self.m_root);
                        self.m_root = other.m_root;
                        other.m_root = nullptr;
                    }
                    return *this;
                }

                function size(const self&) -> unsigned long int {
                    return tree_count(self.m_root);
                } end function size

                function clear(self&) -> void {
                    tree_free(self.m_root);
                    self.m_root = nullptr;
                } end function clear

                function find(const self&, const K&: key) -> TreeNode<E>* {
                    TreeNode<E>*: at = self.m_root;
                    while (at != nullptr) {
                        if (key < key_of(at->entry)) then {
                            at = at->left;
                        } else if (key_of(at->entry) < key) then {
                            at = at->right;
                        } else then {
                            return at;
                        }
                    }
                    return nullptr;
                } end function find

                function lower(const self&, const K&: key) -> TreeNode<E>* {
                    TreeNode<E>*: at = self.m_root;
                    TreeNode<E>*: best = nullptr;
                    while (at != nullptr) {
                        if (key_of(at->entry) < key) then {
                            at = at->right;
                        } else then {
                            best = at;
                            at = at->left;
                        }
                    }
                    return best;
                } end function lower

                function upper(const self&, const K&: key) -> TreeNode<E>* {
                    TreeNode<E>*: at = self.m_root;
                    TreeNode<E>*: best = nullptr;
                    while (at != nullptr) {
                        if (key < key_of(at->entry)) then {
                            best = at;
                            at = at->left;
                        } else then {
                            at = at->right;
                        }
                    }
                    return best;
                } end function upper

                function nth(const self&, unsigned long int: index) -> TreeNode<E>* {
                    unsigned long int: left_over = index;
                    TreeNode<E>*: at = self.m_root;
                    while (at != nullptr) {
                        const unsigned long int: smaller = tree_count(at->left);
                        if (left_over < smaller) then {
                            at = at->left;
                        } else if (left_over == smaller) then {
                            return at;
                        } else then {
                            left_over -= smaller + 1;
                            at = at->right;
                        }
                    }
                    return nullptr;
                } end function nth

                function rank(const self&, TreeNode<E>*: n) -> unsigned long int {
                    unsigned long int: r = tree_count(n->left);
                    TreeNode<E>*: at = n;
                    while (at->parent != nullptr) {
                        if (at == at->parent->right) then {
                            r += tree_count(at->parent->left) + 1;
                        }
                        at = at->parent;
                    }
                    return r;
                } end function rank

                function rotate_left(self&, TreeNode<E>*: x) -> void {
                    TreeNode<E>*: y = x->right;
                    x->right = y->left;
                    if (y->left != nullptr) then {
                        y->left->parent = x;
                    }
                    y->parent = x->parent;
                    if (x->parent == nullptr) then {
                        self.m_root = y;
                    } else if (x == x->parent->left) then {
                        x->parent->left = y;
                    } else then {
                        x->parent->right = y;
                    }
                    y->left = x;
                    x->parent = y;
                    y->count = x->count;
                    x->count = tree_count(x->left) + tree_count(x->right) + 1;
                } end function rotate_left

                function rotate_right(self&, TreeNode<E>*: x) -> void {
                    TreeNode<E>*: y = x->left;
                    x->left = y->right;
                    if (y->right != nullptr) then {
                        y->right->parent = x;
                    }
                    y->parent = x->parent;
                    if (x->parent == nullptr) then {
                        self.m_root = y;
                    } else if (x == x->parent->right) then {
                        x->parent->right = y;
                    } else then {
                        x->parent->left = y;
                    }
                    y->right = x;
                    x->parent = y;
                    y->count = x->count;
                    x->count = tree_count(x->left) + tree_count(x->right) + 1;
                } end function rotate_right

                function insert(self&, const E&: entry, bool&: added) -> TreeNode<E>* {
                    const K&: key = key_of(entry);
                    TreeNode<E>*: parent = nullptr;
                    TreeNode<E>*: at = self.m_root;
                    bool: go_left = false;
                    while (at != nullptr) {
                        parent = at;
                        if (key < key_of(at->entry)) then {
                            go_left = true;
                            at = at->left;
                        } else if (key_of(at->entry) < key) then {
                            go_left = false;
                            at = at->right;
                        } else then {
                            added = false;
                            return at;
                        }
                    }
                    TreeNode<E>*: n = new TreeNode<E>;
                    n->entry = entry;
                    n->parent = parent;
                    if (parent == nullptr) then {
                        self.m_root = n;
                    } else if (go_left) then {
                        parent->left = n;
                    } else then {
                        parent->right = n;
                    }
                    for (TreeNode<E>*: up = parent; up != nullptr; up = up->parent) {
                        up->count += 1;
                    }
                    self.insert_fixup(n);
                    added = true;
                    return n;
                } end function insert

                function insert_fixup(self&, TreeNode<E>*: node) -> void {
                    TreeNode<E>*: z = node;
                    while (z != self.m_root && z->parent->red) {
                        TreeNode<E>*: p = z->parent;
                        TreeNode<E>*: g = p->parent;
                        if (p == g->left) then {
                            TreeNode<E>*: uncle = g->right;
                            if (uncle != nullptr && uncle->red) then {
                                p->red = false;
                                uncle->red = false;
                                g->red = true;
                                z = g;
                            } else then {
                                if (z == p->right) then {
                                    z = p;
                                    self.rotate_left(z);
                                    p = z->parent;
                                }
                                p->red = false;
                                g->red = true;
                                self.rotate_right(g);
                            }
                        } else then {
                            TreeNode<E>*: uncle = g->left;
                            if (uncle != nullptr && uncle->red) then {
                                p->red = false;
                                uncle->red = false;
                                g->red = true;
                                z = g;
                            } else then {
                                if (z == p->left) then {
                                    z = p;
                                    self.rotate_right(z);
                                    p = z->parent;
                                }
                                p->red = false;
                                g->red = true;
                                self.rotate_left(g);
                            }
                        }
                    }
                    self.m_root->red = false;
                } end function insert_fixup

                function replace(self&, TreeNode<E>*: old_node, TreeNode<E>*: new_node) -> void {
                    if (old_node->parent == nullptr) then {
                        self.m_root = new_node;
                    } else if (old_node == old_node->parent->left) then {
                        old_node->parent->left = new_node;
                    } else then {
                        old_node->parent->right = new_node;
                    }
                    if (new_node != nullptr) then {
                        new_node->parent = old_node->parent;
                    }
                } end function replace

                function erase(self&, TreeNode<E>*: z) -> void {
                    TreeNode<E>*: x = nullptr;
                    TreeNode<E>*: xp = nullptr;
                    bool: removed_red = z->red;
                    if (z->left == nullptr) then {
                        x = z->right;
                        xp = z->parent;
                        self.replace(z, z->right);
                    } else if (z->right == nullptr) then {
                        x = z->left;
                        xp = z->parent;
                        self.replace(z, z->left);
                    } else then {
                        TreeNode<E>*: y = tree_first(z->right);
                        removed_red = y->red;
                        x = y->right;
                        if (y->parent == z) then {
                            xp = y;
                        } else then {
                            xp = y->parent;
                            self.replace(y, y->right);
                            y->right = z->right;
                            y->right->parent = y;
                        }
                        self.replace(z, y);
                        y->left = z->left;
                        y->left->parent = y;
                        y->red = z->red;
                    }
                    for (TreeNode<E>*: up = xp; up != nullptr; up = up->parent) {
                        up->count = tree_count(up->left) + tree_count(up->right) + 1;
                    }
                    delete z;
                    if (!removed_red) then {
                        self.erase_fixup(x, xp);
                    }
                } end function erase

                function erase_fixup(self&, TreeNode<E>*: node, TreeNode<E>*: node_parent) -> void {
                    TreeNode<E>*: x = node;
                    TreeNode<E>*: xp = node_parent;
                    while (x != self.m_root && (x == nullptr || !x->red)) {
                        if (x == xp->left) then {
                            TreeNode<E>*: w = xp->right;
                            if (w->red) then {
                                w->red = false;
                                xp->red = true;
                                self.rotate_left(xp);
                                w = xp->right;
                            }
                            const bool: left_black = w->left == nullptr || !w->left->red;
                            const bool: right_black = w->right == nullptr || !w->right->red;
                            if (left_black && right_black) then {
                                w->red = true;
                                x = xp;
                                xp = x->parent;
                            } else then {
                                if (right_black) then {
                                    w->left->red = false;
                                    w->red = true;
                                    self.rotate_right(w);
                                    w = xp->right;
                                }
                                w->red = xp->red;
                                xp->red = false;
                                if (w->right != nullptr) then {
                                    w->right->red = false;
                                }
                                self.rotate_left(xp);
                                x = self.m_root;
                                xp = nullptr;
                            }
                        } else then {
                            TreeNode<E>*: w = xp->left;
                            if (w->red) then {
                                w->red = false;
                                xp->red = true;
                                self.rotate_right(xp);
                                w = xp->left;
                            }
                            const bool: left_black = w->left == nullptr || !w->left->red;
                            const bool: right_black = w->right == nullptr || !w->right->red;
                            if (left_black && right_black) then {
                                w->red = true;
                                x = xp;
                                xp = x->parent;
                            } else then {
                                if (left_black) then {
                                    w->right->red = false;
                                    w->red = true;
                                    self.rotate_left(w);
                                    w = xp->left;
                                }
                                w->red = xp->red;
                                xp->red = false;
                                if (w->left != nullptr) then {
                                    w->left->red = false;
                                }
                                self.rotate_right(xp);
                                x = self.m_root;
                                xp = nullptr;
                            }
                        }
                    }
                    if (x != nullptr) then {
                        x->red = false;
                    }
                } end function erase_fixup

                function check(const self&) -> unsigned long int {
                    if (self.m_root != nullptr && self.m_root->red) then {
                        return std::npos;
                    }
                    return self.check_node(self.m_root);
                } end function check

                function check_node(const self&, TreeNode<E>*: n) -> unsigned long int {
                    if (n == nullptr) then {
                        return 1;
                    }
                    if (n->red && ((n->left != nullptr && n->left->red) || (n->right != nullptr && n->right->red))) then {
                        return std::npos;
                    }
                    if (n->count != tree_count(n->left) + tree_count(n->right) + 1) then {
                        return std::npos;
                    }
                    if (n->left != nullptr && (n->left->parent != n || !(key_of(n->left->entry) < key_of(n->entry)))) then {
                        return std::npos;
                    }
                    if (n->right != nullptr && (n->right->parent != n || !(key_of(n->entry) < key_of(n->right->entry)))) then {
                        return std::npos;
                    }
                    const unsigned long int: lh = self.check_node(n->left);
                    const unsigned long int: rh = self.check_node(n->right);
                    if (lh == std::npos || rh == std::npos || lh != rh) then {
                        return std::npos;
                    }
                    return lh + (n->red ? 0 : 1);
                } end function check_node
            } end class Tree
        } end namespace detail

        template <typename K, typename V>
        requires std::traits::has_operator<std::traits::op::less, K>
        class Map {
            detail::Tree<K, Pair<K, V>>: m_tree;

        public:
            using Iterator = std::iterators::Tree<detail::TreeNode<Pair<K, V>>, Pair<K, V>>;
            using ReverseIterator = std::iterators::Tree<detail::TreeNode<Pair<K, V>>, Pair<K, V>, true>;

            constructor() { }

            function size(const self&) -> unsigned long int {
                return self.m_tree.size();
            } end function size

            function empty(const self&) -> bool {
                return self.m_tree.m_root == nullptr;
            } end function empty

            function begin(const self&) -> Iterator {
                return Iterator(detail::tree_first(self.m_tree.m_root));
            } end function begin

            function end(const self&) -> Iterator {
                return Iterator(nullptr);
            } end function end

            function rbegin(const self&) -> ReverseIterator {
                return ReverseIterator(detail::tree_last(self.m_tree.m_root));
            } end function rbegin

            function rend(const self&) -> ReverseIterator {
                return ReverseIterator(nullptr);
            } end function rend

            function backwards(const self&) -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(self.rbegin(), self.rend());
            } end function backwards

            function insert(self&, const K&: key, const V&: value) -> bool {
                bool: added = false;
                self.m_tree.insert(Pair<K, V>(key, value), added);
                return added;
            } end function insert

            function set(self&, const K&: key, const V&: value) -> void {
                bool: added = false;
                detail::TreeNode<Pair<K, V>>*: n = self.m_tree.insert(Pair<K, V>(key, value), added);
                if (!added) then {
                    n->entry.second = value;
                }
            } end function set

            operator([]) function(self&, const K&: key) -> V& {
                detail::TreeNode<Pair<K, V>>*: n = self.m_tree.find(key);
                if (n == nullptr) then {
                    bool: added = false;
                    n = self.m_tree.insert(Pair<K, V>(key, V()), added);
                }
                return n->entry.second;
            }

            function at(self&, const K&: key) -> V& {
                detail::TreeNode<Pair<K, V>>*: n = self.m_tree.find(key);
                if (n == nullptr) then {
                    throw std::errors::collection_error(static_cast<string>(`the key isn't in the map`));
                }
                return n->entry.second;
            } end function at

            function find(self&, const K&: key) -> V* {
                detail::TreeNode<Pair<K, V>>*: n = self.m_tree.find(key);
                return n == nullptr ? nullptr : &n->entry.second;
            } end function find

            function get(const self&, const K&: key, const V&: fallback) -> V {
                detail::TreeNode<Pair<K, V>>*: n = self.m_tree.find(key);
                return n == nullptr ? fallback : n->entry.second;
            } end function get

            function contains(const self&, const K&: key) -> bool {
                return self.m_tree.find(key) != nullptr;
            } end function contains

            function remove(self&, const K&: key) -> bool {
                detail::TreeNode<Pair<K, V>>*: n = self.m_tree.find(key);
                if (n == nullptr) then {
                    return false;
                }
                self.m_tree.erase(n);
                return true;
            } end function remove

            function clear(self&) -> void {
                self.m_tree.clear();
            } end function clear

            function keys(const self&) -> Vector<K> {
                Vector<K>: out;
                out.reserve(self.size());
                for (detail::TreeNode<Pair<K, V>>*: n = detail::tree_first(self.m_tree.m_root); n != nullptr; n = detail::tree_next(n)) {
                    out.push_back(n->entry.first);
                }
                return out;
            } end function keys

            function values(const self&) -> Vector<V> {
                Vector<V>: out;
                out.reserve(self.size());
                for (detail::TreeNode<Pair<K, V>>*: n = detail::tree_first(self.m_tree.m_root); n != nullptr; n = detail::tree_next(n)) {
                    out.push_back(n->entry.second);
                }
                return out;
            } end function values

            function first(self&) -> Pair<K, V>& {
                if (self.m_tree.m_root == nullptr) then {
                    throw detail::empty_error("first()");
                }
                return detail::tree_first(self.m_tree.m_root)->entry;
            } end function first

            function last(self&) -> Pair<K, V>& {
                if (self.m_tree.m_root == nullptr) then {
                    throw detail::empty_error("last()");
                }
                return detail::tree_last(self.m_tree.m_root)->entry;
            } end function last

            function entry_at(self&, unsigned long int: index) -> Pair<K, V>& {
                if (index >= self.size()) then {
                    throw detail::out_of_range(index, self.size());
                }
                return self.m_tree.nth(index)->entry;
            } end function entry_at

            function lower_bound(const self&, const K&: key) -> Iterator {
                return Iterator(self.m_tree.lower(key));
            } end function lower_bound

            function upper_bound(const self&, const K&: key) -> Iterator {
                return Iterator(self.m_tree.upper(key));
            } end function upper_bound
        } end class Map

        template <typename T>
        requires std::traits::has_operator<std::traits::op::less, T>
        class Set {
            detail::Tree<T, T>: m_tree;

        public:
            using Iterator = std::iterators::Tree<detail::TreeNode<T>, const T>;
            using ReverseIterator = std::iterators::Tree<detail::TreeNode<T>, const T, true>;

            constructor() { }

            constructor(T...: items) {
                for (const T&: item in items) {
                    insert(item);
                }
            }

            function size(const self&) -> unsigned long int {
                return self.m_tree.size();
            } end function size

            function empty(const self&) -> bool {
                return self.m_tree.m_root == nullptr;
            } end function empty

            function begin(const self&) -> Iterator {
                return Iterator(detail::tree_first(self.m_tree.m_root));
            } end function begin

            function end(const self&) -> Iterator {
                return Iterator(nullptr);
            } end function end

            function rbegin(const self&) -> ReverseIterator {
                return ReverseIterator(detail::tree_last(self.m_tree.m_root));
            } end function rbegin

            function rend(const self&) -> ReverseIterator {
                return ReverseIterator(nullptr);
            } end function rend

            function backwards(const self&) -> std::iterators::Range<ReverseIterator> {
                return std::iterators::Range<ReverseIterator>(self.rbegin(), self.rend());
            } end function backwards

            function insert(self&, const T&: value) -> bool {
                bool: added = false;
                self.m_tree.insert(value, added);
                return added;
            } end function insert

            function contains(const self&, const T&: value) -> bool {
                return self.m_tree.find(value) != nullptr;
            } end function contains

            function remove(self&, const T&: value) -> bool {
                detail::TreeNode<T>*: n = self.m_tree.find(value);
                if (n == nullptr) then {
                    return false;
                }
                self.m_tree.erase(n);
                return true;
            } end function remove

            function clear(self&) -> void {
                self.m_tree.clear();
            } end function clear

            operator([]) function(const self&, unsigned long int: index) -> const T& {
                if (index >= self.size()) then {
                    throw detail::out_of_range(index, self.size());
                }
                return self.m_tree.nth(index)->entry;
            }

            function index_of(const self&, const T&: value) -> unsigned long int {
                detail::TreeNode<T>*: n = self.m_tree.find(value);
                if (n == nullptr) then {
                    return undefined;
                }
                return self.m_tree.rank(n);
            } end function index_of

            function first(const self&) -> const T& {
                if (self.m_tree.m_root == nullptr) then {
                    throw detail::empty_error("first()");
                }
                return detail::tree_first(self.m_tree.m_root)->entry;
            } end function first

            function last(const self&) -> const T& {
                if (self.m_tree.m_root == nullptr) then {
                    throw detail::empty_error("last()");
                }
                return detail::tree_last(self.m_tree.m_root)->entry;
            } end function last

            function lower_bound(const self&, const T&: value) -> Iterator {
                return Iterator(self.m_tree.lower(value));
            } end function lower_bound

            function upper_bound(const self&, const T&: value) -> Iterator {
                return Iterator(self.m_tree.upper(value));
            } end function upper_bound

            function to_vector(const self&) -> Vector<T> {
                Vector<T>: out;
                out.reserve(self.size());
                for (detail::TreeNode<T>*: n = detail::tree_first(self.m_tree.m_root); n != nullptr; n = detail::tree_next(n)) {
                    out.push_back(n->entry);
                }
                return out;
            } end function to_vector
        } end class Set

        extern "C++" from "<walnut_trie.hpp>" {
            template <typename V>
            class TrieMap as "walnut_rt::trie::map" {
                function slot(const string&: key) -> V&;

            public:
                constructor();
                constructor(bool: ignore_case);

                static function ignoring_case() -> TrieMap {
                    return TrieMap(true);
                } end function ignoring_case

                function ignores_case() const -> bool;
                function size() const -> unsigned long int;
                function empty() const -> bool;
                function clear() -> void;
                function insert(const string&: key, const V&: value) -> bool;
                function set(const string&: key, const V&: value) -> bool;
                function find(const string&: key) -> V*;
                function find(const string&: key) const -> const V*;
                function contains(const string&: key) const -> bool;
                function remove(const string&: key) -> bool;
                function has_prefix(const string&: prefix) const -> bool;
                function count_prefix(const string&: prefix) const -> unsigned long int;
                function keys_with_prefix(const string&: prefix, unsigned long int: limit) const -> Vector<string>;
                function values_with_prefix(const string&: prefix, unsigned long int: limit) const -> Vector<V>;
                function keys() const -> Vector<string>;
                function complete(const string&: prefix) const -> string;
                function longest_prefix_of(const string&: subject) const -> unsigned long int;
                function nearest(const string&: word, unsigned long int: max_distance, unsigned long int: limit) const -> Vector<string>;
                function nearest_distances(const string&: word, unsigned long int: max_distance, unsigned long int: limit) const -> Vector<unsigned long int>;

                operator([]) function(const string&: key) -> V& {
                    return slot(key);
                }

                function at(const string&: key) -> V& {
                    V*: found = find(key);
                    if (found == nullptr) then {
                        throw std::errors::collection_error(static_cast<string>(`"${key}" isn't in the trie`));
                    }
                    return *found;
                } end function at

                function get(const string&: key, const V&: fallback) const -> V {
                    const V*: found = find(key);
                    return found == nullptr ? fallback : *found;
                } end function get

                function keys_with_prefix(const string&: prefix) const -> Vector<string> {
                    return keys_with_prefix(prefix, 9223372036854775807);
                } end function keys_with_prefix

                function values_with_prefix(const string&: prefix) const -> Vector<V> {
                    return values_with_prefix(prefix, 9223372036854775807);
                } end function values_with_prefix

                function entries_with_prefix(const string&: prefix) const -> Vector<Pair<string, V>> {
                    Vector<Pair<string, V>>: out;
                    for (const string&: key in keys_with_prefix(prefix, 9223372036854775807)) {
                        out.push_back(Pair<string, V>(key, *find(key)));
                    }
                    return out;
                } end function entries_with_prefix

                function nearest(const string&: word, unsigned long int: max_distance) const -> Vector<string> {
                    return nearest(word, max_distance, 10);
                } end function nearest
            } end class TrieMap

            class Trie as "walnut_rt::trie::set" {
            public:
                constructor();
                constructor(bool: ignore_case);

                constructor(string...: words) {
                    for (const string&: word in words) {
                        self.insert(word);
                    }
                }

                static function ignoring_case() -> Trie {
                    return Trie(true);
                } end function ignoring_case

                function ignores_case(const self&) -> bool;
                function size(const self&) noexcept -> unsigned long int;
                function empty(const self&) noexcept -> bool;
                function clear(self&) -> void;
                function insert(self&, const string&: word) -> bool;
                function contains(const self&, const string&: word) -> bool;
                function remove(self&, const string&: word) -> bool;
                function has_prefix(const self&, const string&: prefix) -> bool;
                function count_prefix(const self&, const string&: prefix) -> unsigned long int;
                function with_prefix(const self&, const string&: prefix, unsigned long int: limit) -> Vector<string>;
                function words(const self&) -> Vector<string>;
                function complete(const self&, const string&: prefix) -> string;
                function longest_prefix_of(const self&, const string&: subject) -> unsigned long int;
                function nearest(const self&, const string&: word, unsigned long int: max_distance, unsigned long int: limit) -> Vector<string>;
                function nearest_distances(const self&, const string&: word, unsigned long int: max_distance, unsigned long int: limit) -> Vector<unsigned long int>;

                function with_prefix(const self&, const string&: prefix) -> Vector<string> {
                    return self.with_prefix(prefix, 9223372036854775807);
                } end function with_prefix

                function nearest(const self&, const string&: word, unsigned long int: max_distance) -> Vector<string> {
                    return self.nearest(word, max_distance, 10);
                } end function nearest
            } end class Trie
        } end extern

        safe(compile) {
            using TrieSet = Trie;
        } end safe

        template <typename K, typename V>
        requires HashKey<K> && std::traits::has_operator<std::traits::op::equal, K>
        class Cache {
            UnorderedMap<K, unsigned long int>: m_index;
            Vector<K>: m_keys;
            Vector<V>: m_values;
            Vector<unsigned long int>: m_newer;
            Vector<unsigned long int>: m_older;
            Vector<unsigned long int>: m_free;
            unsigned long int: m_newest = std::npos;
            unsigned long int: m_oldest = std::npos;
            unsigned long int: m_capacity = 256;
            unsigned long int: m_hits = 0;
            unsigned long int: m_misses = 0;
            unsigned long int: m_evictions = 0;

            function unlink(self&, unsigned long int: slot) -> void {
                const unsigned long int: newer = self.m_newer[slot];
                const unsigned long int: older = self.m_older[slot];
                if (newer != std::npos) then {
                    self.m_older[newer] = older;
                } else then {
                    self.m_newest = older;
                }
                if (older != std::npos) then {
                    self.m_newer[older] = newer;
                } else then {
                    self.m_oldest = newer;
                }
                self.m_newer[slot] = std::npos;
                self.m_older[slot] = std::npos;
            } end function unlink

            function make_newest(self&, unsigned long int: slot) -> void {
                self.m_newer[slot] = std::npos;
                self.m_older[slot] = self.m_newest;
                if (self.m_newest != std::npos) then {
                    self.m_newer[self.m_newest] = slot;
                }
                self.m_newest = slot;
                if (self.m_oldest == std::npos) then {
                    self.m_oldest = slot;
                }
            } end function make_newest

            function touch(self&, unsigned long int: slot) -> void {
                if (slot == self.m_newest) then {
                    return;
                }
                self.unlink(slot);
                self.make_newest(slot);
            } end function touch

            function drop(self&, unsigned long int: slot) -> void {
                self.unlink(slot);
                self.m_index.remove(self.m_keys[slot]);
                self.m_keys[slot] = K();
                self.m_values[slot] = V();
                self.m_free.push_back(slot);
            } end function drop

            function trim(self&, unsigned long int: room) -> void {
                if (self.m_capacity <= 0) then {
                    return;
                }
                while (self.m_oldest != std::npos && self.m_index.size() + room > self.m_capacity) {
                    self.drop(self.m_oldest);
                    self.m_evictions += 1;
                }
            } end function trim

            function add(self&, const K&: key, const V&: value) -> unsigned long int {
                self.trim(1);
                unsigned long int: slot = std::npos;
                if (self.m_free.empty()) then {
                    slot = self.m_keys.size();
                    self.m_keys.push_back(key);
                    self.m_values.push_back(value);
                    self.m_newer.push_back(std::npos);
                    self.m_older.push_back(std::npos);
                } else then {
                    slot = self.m_free.pop_back();
                    self.m_keys[slot] = key;
                    self.m_values[slot] = value;
                }
                self.m_index.set(key, slot);
                self.make_newest(slot);
                return slot;
            } end function add

            function slot_of(const self&, const K&: key) -> unsigned long int {
                return self.m_index.get(key, std::npos);
            } end function slot_of

        public:
            constructor() { }

            constructor(unsigned long int: capacity) : m_capacity = capacity { }

            function size(const self&) -> unsigned long int {
                return self.m_index.size();
            } end function size

            function empty(const self&) -> bool {
                return self.m_index.empty();
            } end function empty

            function capacity(const self&) -> unsigned long int {
                return self.m_capacity;
            } end function capacity

            function set_capacity(self&, unsigned long int: capacity) -> void {
                self.m_capacity = capacity;
                self.trim(0);
            } end function set_capacity

            function put(self&, const K&: key, const V&: value) -> void {
                const unsigned long int: slot = self.slot_of(key);
                if (slot != std::npos) then {
                    self.m_values[slot] = value;
                    self.touch(slot);
                    return;
                }
                self.add(key, value);
            } end function put

            function find(self&, const K&: key) -> V* {
                const unsigned long int: slot = self.slot_of(key);
                if (slot == std::npos) then {
                    self.m_misses += 1;
                    return nullptr;
                }
                self.m_hits += 1;
                self.touch(slot);
                return &self.m_values[slot];
            } end function find

            function peek(const self&, const K&: key) -> const V* {
                const unsigned long int: slot = self.slot_of(key);
                return slot == std::npos ? nullptr : &self.m_values[slot];
            } end function peek

            function get(self&, const K&: key, const V&: fallback) -> V {
                V*: found = self.find(key);
                return found == nullptr ? fallback : *found;
            } end function get

            function get_or_add(self&, const K&: key, std::Supplier<V>: make) -> V& {
                V*: found = self.find(key);
                if (found != nullptr) then {
                    return *found;
                }
                const V: made = make();
                return self.m_values[static_cast<unsigned long int>(self.add(key, made))];
            } end function get_or_add

            function get_or_compute(self&, const K&: key, std::Transform<K, V>: make) -> V& {
                V*: found = self.find(key);
                if (found != nullptr) then {
                    return *found;
                }
                const V: made = make(key);
                return self.m_values[static_cast<unsigned long int>(self.add(key, made))];
            } end function get_or_compute

            function contains(const self&, const K&: key) -> bool {
                return self.slot_of(key) >= 0;
            } end function contains

            function remove(self&, const K&: key) -> bool {
                const unsigned long int: slot = self.slot_of(key);
                if (slot == std::npos) then {
                    return false;
                }
                self.drop(slot);
                return true;
            } end function remove

            function clear(self&) -> void {
                self.m_index.clear();
                self.m_keys.clear();
                self.m_values.clear();
                self.m_newer.clear();
                self.m_older.clear();
                self.m_free.clear();
                self.m_newest = std::npos;
                self.m_oldest = std::npos;
            } end function clear

            function hits(const self&) -> unsigned long int {
                return self.m_hits;
            } end function hits

            function misses(const self&) -> unsigned long int {
                return self.m_misses;
            } end function misses

            function evictions(const self&) -> unsigned long int {
                return self.m_evictions;
            } end function evictions

            function hit_rate(const self&) -> double {
                const unsigned long int: total = self.m_hits + self.m_misses;
                return total == 0 ? 0.0 : static_cast<double>(self.m_hits) / static_cast<double>(total);
            } end function hit_rate

            function reset_stats(self&) -> void {
                self.m_hits = 0;
                self.m_misses = 0;
                self.m_evictions = 0;
            } end function reset_stats

            function keys(const self&) -> Vector<K> {
                Vector<K>: out;
                for (unsigned long int: slot = self.m_newest; slot != std::npos; slot = self.m_older[slot]) {
                    out.push_back(self.m_keys[slot]);
                }
                return out;
            } end function keys

            function values(const self&) -> Vector<V> {
                Vector<V>: out;
                for (unsigned long int: slot = self.m_newest; slot != std::npos; slot = self.m_older[slot]) {
                    out.push_back(self.m_values[slot]);
                }
                return out;
            } end function values
        } end class Cache

        template <typename C, typename E>
        class WhereQuery {
            C*: m_items = nullptr;
            Vector<unsigned long int>: m_indices;

            function item(const self&, unsigned long int: k) -> E {
                return (*self.m_items)[self.m_indices[k]];
            } end function item

            function with(const self&, Vector<unsigned long int>&&: picked) -> WhereQuery {
                return WhereQuery(self.m_items, std::move(picked));
            } end function with

            function total(const self&) -> unsigned long int {
                if constexpr (std::traits::is_string<C>) then {
                    return self.m_items->length();
                } else then {
                    return self.m_items->size();
                }
            } end function total

            function erase_indices(self&, const Vector<unsigned long int>&: doomed) -> void {
                if constexpr (std::traits::is_string<C>) then {
                    string: kept = "";
                    unsigned long int: d = 0;
                    unsigned long int: i = 0;
                    for (char: ch in *self.m_items) {
                        if (d < doomed.size() && doomed[d] == i) then {
                            d += 1;
                        } else then {
                            kept += ch;
                        }
                        i += 1;
                    }
                    *self.m_items = static_cast<C>(kept);
                } else then {
                    for (unsigned long int: k = doomed.size(); k > 0;) {
                        k--;
                        self.m_items->erase(doomed[k]);
                    }
                }
            } end function erase_indices

            function insert_values(self&, const E&: value, unsigned long int: shift) -> void {
                if constexpr (std::traits::is_string<C>) then {
                    string: built = "";
                    unsigned long int: d = 0;
                    unsigned long int: i = 0;
                    for (char: ch in *self.m_items) {
                        if (shift == 1) then {
                            built += ch;
                        }
                        while (d < self.m_indices.size() && self.m_indices[d] == i) {
                            built += value;
                            d += 1;
                        }
                        if (shift == 0) then {
                            built += ch;
                        }
                        i += 1;
                    }
                    *self.m_items = static_cast<C>(built);
                } else then {
                    for (unsigned long int: k = self.m_indices.size(); k > 0;) {
                        k--;
                        self.m_items->insert(self.m_indices[k] + shift, value);
                    }
                }
                self.m_indices.clear();
            } end function insert_values

        public:
            constructor() noexcept { }

            constructor(C*: items, Vector<unsigned long int>&&: picked) : m_items = items, m_indices = std::move(picked) { }

            static function matching(C&: items, std::Predicate<E>: pred) -> WhereQuery {
                Vector<unsigned long int>: picked;
                unsigned long int: i = 0;
                for (const auto&: x in items) {
                    if (pred(x)) then {
                        picked.push_back(i);
                    }
                    i += 1;
                }
                return WhereQuery(&items, std::move(picked));
            } end function matching

            static function equal_to(C&: items, const E&: value) -> WhereQuery {
                Vector<unsigned long int>: picked;
                unsigned long int: i = 0;
                for (const auto&: x in items) {
                    if (x == value) then {
                        picked.push_back(i);
                    }
                    i += 1;
                }
                return WhereQuery(&items, std::move(picked));
            } end function equal_to

            static function at_indices(C&: items, const Vector<unsigned long int>&: picked) -> WhereQuery {
                Vector<unsigned long int>: sorted_picked = picked;
                sorted_picked.sort();
                Vector<unsigned long int>: clean;
                for (unsigned long int: i in sorted_picked) {
                    if (clean.empty() || clean.back() != i) then {
                        clean.push_back(i);
                    }
                }
                return WhereQuery(&items, std::move(clean));
            } end function at_indices

            function count(const self&) -> unsigned long int {
                return self.m_indices.size();
            } end function count

            function size(const self&) -> unsigned long int {
                return self.m_indices.size();
            } end function size

            function empty(const self&) -> bool {
                return self.m_indices.empty();
            } end function empty

            function index(const self&, unsigned long int: k) -> unsigned long int {
                if (k >= self.m_indices.size()) then {
                    throw detail::out_of_range(k, self.m_indices.size());
                }
                return self.m_indices[k];
            } end function index

            function first_index(const self&) -> unsigned long int {
                return self.m_indices.empty() ? std::npos : static_cast<unsigned long int>(self.m_indices[0]);
            } end function first_index

            function last_index(const self&) -> unsigned long int {
                return self.m_indices.empty() ? std::npos : static_cast<unsigned long int>(self.m_indices.back());
            } end function last_index

            function contains_index(const self&, unsigned long int: i) noexcept -> bool {
                for (unsigned long int: k in self.m_indices) {
                    if (k == i) then {
                        return true;
                    }
                }
                return false;
            } end function contains_index

            function indices(const self&) -> Vector<unsigned long int> {
                return self.m_indices;
            } end function indices

            operator([]) function(const self&, unsigned long int: k) -> E {
                if (k >= self.m_indices.size()) then {
                    throw detail::out_of_range(k, self.m_indices.size());
                }
                return self.item(k);
            }

            function at(const self&, unsigned long int: k) -> E {
                if (k >= self.m_indices.size()) then {
                    throw detail::out_of_range(k, self.m_indices.size());
                }
                return self.item(k);
            } end function at

            function first_value(const self&) -> E {
                if (self.m_indices.empty()) then {
                    throw detail::empty_error("first_value()");
                }
                return self.item(0);
            } end function first_value

            function last_value(const self&) -> E {
                if (self.m_indices.empty()) then {
                    throw detail::empty_error("last_value()");
                }
                return self.item(self.m_indices.size() - 1);
            } end function last_value

            function values(const self&) -> C {
                C: out;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    if constexpr (std::traits::is_string<C>) then {
                        out += self.item(k);
                    } else then {
                        out.push_back(self.item(k));
                    }
                }
                return out;
            } end function values

            function to_vector(const self&) -> Vector<E> {
                Vector<E>: out;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    out.push_back(self.item(k));
                }
                return out;
            } end function to_vector

            function first(const self&, unsigned long int: n = 1) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = 0; k < n && k < self.m_indices.size(); k++) {
                    picked.push_back(self.m_indices[k]);
                }
                return self.with(std::move(picked));
            } end function first

            function take(const self&, unsigned long int: n) -> WhereQuery {
                return self.first(n);
            } end function take

            function last(const self&, unsigned long int: n = 1) -> WhereQuery {
                Vector<unsigned long int>: picked;
                const unsigned long int: start = n < self.m_indices.size() ? self.m_indices.size() - n : 0u;
                for (unsigned long int: k = start; k < self.m_indices.size(); k++) {
                    picked.push_back(self.m_indices[k]);
                }
                return self.with(std::move(picked));
            } end function last

            function skip(const self&, unsigned long int: n) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = n; k < self.m_indices.size(); k++) {
                    picked.push_back(self.m_indices[k]);
                }
                return self.with(std::move(picked));
            } end function skip

            function skip_last(const self&, unsigned long int: n) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = 0; k < self.m_indices.size() - n; k++) {
                    picked.push_back(self.m_indices[k]);
                }
                return self.with(std::move(picked));
            } end function skip_last

            function slice(const self&, unsigned long int: start, unsigned long int: stop) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = start; k < stop && k < self.m_indices.size(); k++) {
                    picked.push_back(self.m_indices[k]);
                }
                return self.with(std::move(picked));
            } end function slice

            function range(const self&, unsigned long int: lo, unsigned long int: hi) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: i in self.m_indices) {
                    if (i >= lo && i < hi) then {
                        picked.push_back(i);
                    }
                }
                return self.with(std::move(picked));
            } end function range

            function step(const self&, unsigned long int: n) -> WhereQuery {
                Vector<unsigned long int>: picked;
                const unsigned long int: by = n < 1 ? 1u : n;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k += by) {
                    picked.push_back(self.m_indices[k]);
                }
                return self.with(std::move(picked));
            } end function step

            function even(const self&) -> WhereQuery {
                return self.step(2);
            } end function even

            function odd(const self&) -> WhereQuery {
                return self.skip(1).step(2);
            } end function odd

            function where(const self&, std::Predicate<E>: pred) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    if (pred(self.item(k))) then {
                        picked.push_back(self.m_indices[k]);
                    }
                }
                return self.with(std::move(picked));
            } end function where

            function where(const self&, const E&: value) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    if (self.item(k) == value) then {
                        picked.push_back(self.m_indices[k]);
                    }
                }
                return self.with(std::move(picked));
            } end function where

            function where_not(const self&, std::Predicate<E>: pred) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    if (!pred(self.item(k))) then {
                        picked.push_back(self.m_indices[k]);
                    }
                }
                return self.with(std::move(picked));
            } end function where_not

            function where_indexed(const self&, function(unsigned long int, const E&) -> bool: pred) -> WhereQuery {
                Vector<unsigned long int>: picked;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    if (pred(self.m_indices[k], self.item(k))) then {
                        picked.push_back(self.m_indices[k]);
                    }
                }
                return self.with(std::move(picked));
            } end function where_indexed

            function invert(const self&) -> WhereQuery {
                Vector<unsigned long int>: picked;
                unsigned long int: k = 0;
                const unsigned long int: n = self.total();
                for (unsigned long int: i = 0; i < n; i++) {
                    if (k < self.m_indices.size() && self.m_indices[k] == i) then {
                        k += 1;
                    } else then {
                        picked.push_back(i);
                    }
                }
                return self.with(std::move(picked));
            } end function invert

            function union_with(const self&, const WhereQuery&: other) -> WhereQuery {
                Vector<unsigned long int>: picked;
                unsigned long int: a = 0;
                unsigned long int: b = 0;
                const Vector<unsigned long int>&: theirs = other.m_indices;
                while (a < self.m_indices.size() || b < theirs.size()) {
                    if (b >= theirs.size() || (a < self.m_indices.size() && self.m_indices[a] < theirs[b])) then {
                        picked.push_back(self.m_indices[a]);
                        a += 1;
                    } else if (a >= self.m_indices.size() || theirs[b] < self.m_indices[a]) then {
                        picked.push_back(theirs[b]);
                        b += 1;
                    } else then {
                        picked.push_back(self.m_indices[a]);
                        a += 1;
                        b += 1;
                    }
                }
                return self.with(std::move(picked));
            } end function union_with

            function intersect_with(const self&, const WhereQuery&: other) -> WhereQuery {
                Vector<unsigned long int>: picked;
                unsigned long int: a = 0;
                unsigned long int: b = 0;
                const Vector<unsigned long int>&: theirs = other.m_indices;
                while (a < self.m_indices.size() && b < theirs.size()) {
                    if (self.m_indices[a] < theirs[b]) then {
                        a += 1;
                    } else if (theirs[b] < self.m_indices[a]) then {
                        b += 1;
                    } else then {
                        picked.push_back(self.m_indices[a]);
                        a += 1;
                        b += 1;
                    }
                }
                return self.with(std::move(picked));
            } end function intersect_with

            function except(const self&, const WhereQuery&: other) -> WhereQuery {
                Vector<unsigned long int>: picked;
                unsigned long int: b = 0;
                const Vector<unsigned long int>&: theirs = other.m_indices;
                for (unsigned long int: i in self.m_indices) {
                    while (b < theirs.size() && theirs[b] < i) {
                        b += 1;
                    }
                    if (b >= theirs.size() || theirs[b] != i) then {
                        picked.push_back(i);
                    }
                }
                return self.with(std::move(picked));
            } end function except

            function or_where(const self&, std::Predicate<E>: pred) -> WhereQuery {
                return self.union_with(matching(*self.m_items, pred));
            } end function or_where

            function count_if(const self&, std::Predicate<E>: pred) -> unsigned long int {
                unsigned long int: n = 0;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    if (pred(self.item(k))) then {
                        n += 1;
                    }
                }
                return n;
            } end function count_if

            function all_of(const self&, std::Predicate<E>: pred) -> bool {
                return self.count_if(pred) == self.m_indices.size();
            } end function all_of

            function any_of(const self&, std::Predicate<E>: pred) -> bool {
                return self.count_if(pred) > 0;
            } end function any_of

            function none_of(const self&, std::Predicate<E>: pred) -> bool {
                return self.count_if(pred) == 0;
            } end function none_of

            requires std::traits::has_operator<std::traits::op::add, E>
            function sum(const self&) -> E {
                E: total = E();
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    total = total + self.item(k);
                }
                return total;
            } end function sum

            requires std::traits::has_operator<std::traits::op::less, E>
            function min_index(const self&) -> unsigned long int {
                if (self.m_indices.empty()) then {
                    return std::npos;
                }
                unsigned long int: best = 0;
                for (unsigned long int: k = 1; k < self.m_indices.size(); k++) {
                    if (self.item(k) < self.item(best)) then {
                        best = k;
                    }
                }
                return static_cast<unsigned long int>(self.m_indices[best]);
            } end function min_index

            requires std::traits::has_operator<std::traits::op::less, E>
            function max_index(const self&) -> unsigned long int {
                if (self.m_indices.empty()) then {
                    return std::npos;
                }
                unsigned long int: best = 0;
                for (unsigned long int: k = 1; k < self.m_indices.size(); k++) {
                    if (self.item(best) < self.item(k)) then {
                        best = k;
                    }
                }
                return static_cast<unsigned long int>(self.m_indices[best]);
            } end function max_index

            requires std::traits::has_operator<std::traits::op::less, E>
            function min_value(const self&) -> E {
                if (self.m_indices.empty()) then {
                    throw detail::empty_error("min_value()");
                }
                return (*self.m_items)[static_cast<unsigned long int>(self.min_index())];
            } end function min_value

            requires std::traits::has_operator<std::traits::op::less, E>
            function max_value(const self&) -> E {
                if (self.m_indices.empty()) then {
                    throw detail::empty_error("max_value()");
                }
                return (*self.m_items)[static_cast<unsigned long int>(self.max_index())];
            } end function max_value

            function for_each(self&, std::Action<E>: func) -> WhereQuery& {
                if constexpr (std::traits::is_string<C>) then {
                    for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                        E: held = self.item(k);
                        func(held);
                    }
                } else then {
                    for (unsigned long int: i in self.m_indices) {
                        func((*self.m_items)[i]);
                    }
                }
                return *this;
            } end function for_each

            function for_each_indexed(self&, function(unsigned long int, E&) -> void: func) -> WhereQuery& {
                if constexpr (std::traits::is_string<C>) then {
                    for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                        E: held = self.item(k);
                        func(self.m_indices[k], held);
                    }
                } else then {
                    for (unsigned long int: i in self.m_indices) {
                        func(i, (*self.m_items)[i]);
                    }
                }
                return *this;
            } end function for_each_indexed

            function transform(self&, std::Transform<E, E>: func) -> WhereQuery& {
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    (*self.m_items)[self.m_indices[k]] = func(self.item(k));
                }
                return *this;
            } end function transform

            template <typename U>
            function map(const self&, std::Transform<E, U>: func) -> Vector<U> {
                Vector<U>: out;
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    out.push_back(func(self.item(k)));
                }
                return out;
            } end function map

            function replace(self&, const E&: value) -> WhereQuery& {
                for (unsigned long int: i in self.m_indices) {
                    (*self.m_items)[i] = value;
                }
                return *this;
            } end function replace

            function fill(self&, const E&: value) -> WhereQuery& {
                return self.replace(value);
            } end function fill

            function remove(self&) -> unsigned long int {
                const unsigned long int: n = self.m_indices.size();
                self.erase_indices(self.m_indices);
                self.m_indices.clear();
                return n;
            } end function remove

            function pop(self&) -> C {
                C: out = self.values();
                self.remove();
                return out;
            } end function pop

            function extract(self&) -> C {
                return self.pop();
            } end function extract

            function sort(self&, std::Compare<E>: comp) -> WhereQuery& {
                Vector<E>: picked = self.to_vector();
                std::algorithms::sort(picked.begin(), picked.end(), comp);
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    (*self.m_items)[self.m_indices[k]] = picked[k];
                }
                return *this;
            } end function sort

            requires std::traits::has_operator<std::traits::op::less, E>
            function sort(self&) -> WhereQuery& {
                return self.sort([](const E&: a, const E&: b) -> bool { return a < b; });
            } end function sort

            requires std::traits::has_operator<std::traits::op::less, E>
            function sort_descending(self&) -> WhereQuery& {
                return self.sort([](const E&: a, const E&: b) -> bool { return b < a; });
            } end function sort_descending

            function stable_sort(self&, std::Compare<E>: comp) -> WhereQuery& {
                Vector<E>: picked = self.to_vector();
                std::algorithms::stable_sort(picked.begin(), picked.end(), comp);
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    (*self.m_items)[self.m_indices[k]] = picked[k];
                }
                return *this;
            } end function stable_sort

            requires std::traits::has_operator<std::traits::op::less, E>
            function stable_sort(self&) -> WhereQuery& {
                return self.stable_sort([](const E&: a, const E&: b) -> bool { return a < b; });
            } end function stable_sort

            template <typename K>

            requires std::traits::has_operator<std::traits::op::less, K>
            function sort_by(self&, std::Transform<E, K>: key) -> WhereQuery& {
                return self.sort([&key](const E&: a, const E&: b) -> bool { return key(a) < key(b); });
            } end function sort_by

            function reverse(self&) -> WhereQuery& {
                Vector<E>: picked = self.to_vector();
                const unsigned long int: n = self.m_indices.size();
                for (unsigned long int: k = 0; k < n; k++) {
                    (*self.m_items)[self.m_indices[k]] = picked[n - 1 - k];
                }
                return *this;
            } end function reverse

            function rotate_left(self&, unsigned long int: steps = 1) -> WhereQuery& {
                Vector<E>: picked = self.to_vector();
                std::algorithms::rotate_left(picked.begin(), picked.end(), steps);
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    (*self.m_items)[self.m_indices[k]] = picked[k];
                }
                return *this;
            } end function rotate_left

            function rotate_right(self&, unsigned long int: steps = 1) -> WhereQuery& {
                Vector<E>: picked = self.to_vector();
                std::algorithms::rotate_right(picked.begin(), picked.end(), steps);
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    (*self.m_items)[self.m_indices[k]] = picked[k];
                }
                return *this;
            } end function rotate_right

            function shuffle(self&) -> WhereQuery& {
                Vector<E>: picked = self.to_vector();
                std::algorithms::shuffle(picked.begin(), picked.end());
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    (*self.m_items)[self.m_indices[k]] = picked[k];
                }
                return *this;
            } end function shuffle

            template <typename Dest>
            function copy_to(const self&, Dest&: dest) -> void {
                for (unsigned long int: k = 0; k < self.m_indices.size(); k++) {
                    if constexpr (std::traits::is_string<Dest>) then {
                        dest += self.item(k);
                    } else then {
                        dest.push_back(self.item(k));
                    }
                }
            } end function copy_to

            template <typename Dest>
            function move_to(self&, Dest&: dest) -> void {
                self.copy_to(dest);
                self.remove();
            } end function move_to

            function insert_before(self&, const E&: value) -> void {
                self.insert_values(value, 0);
            } end function insert_before

            function insert_after(self&, const E&: value) -> void {
                self.insert_values(value, 1);
            } end function insert_after
        } end class WhereQuery

        safe(compile) {
            hidden namespace detail {
                template <typename T>
                function empty_list() -> Vector<std::traits::discard_cv<T>> {
                    return Vector<std::traits::discard_cv<T>>();
                } end function empty_list
            } end namespace detail
        } end safe

        template <typename K, typename V>
        requires HashKey<K> && std::traits::has_operator<std::traits::op::equal, K>
        class OrderedMap {
            Vector<Pair<K, V>>: m_entries;
            UnorderedMap<K, unsigned long int>: m_index;

            function reindex_from(self&, unsigned long int: start) -> void {
                for (unsigned long int: i = start; i < self.m_entries.size(); i++) {
                    self.m_index.set(self.m_entries[i].first, i);
                }
            } end function reindex_from

            function missing(const self&, const K&: key) -> void {
                throw std::errors::collection_error("the key isn't in the map");
            } end function missing

        public:
            using Iterator = Pair<K, V>*;
            using ReverseIterator = std::iterators::Pointer<Pair<K, V>, true>;

            constructor() { }

            function size(const self&) -> unsigned long int {
                return self.m_entries.size();
            } end function size

            function empty(const self&) -> bool {
                return self.m_entries.empty();
            } end function empty

            function begin(self&) -> Pair<K, V>* {
                return self.m_entries.begin();
            } end function begin

            function end(self&) -> Pair<K, V>* {
                return self.m_entries.end();
            } end function end

            function begin(const self&) -> const Pair<K, V>* {
                return self.m_entries.begin();
            } end function begin

            function end(const self&) -> const Pair<K, V>* {
                return self.m_entries.end();
            } end function end

            function rbegin(self&) -> std::iterators::Pointer<Pair<K, V>, true> {
                return std::iterators::Pointer<Pair<K, V>, true>(self.m_entries.data(), self.m_entries.size());
            } end function rbegin

            function rend(self&) -> std::iterators::Pointer<Pair<K, V>, true> {
                return std::iterators::Pointer<Pair<K, V>, true>(self.m_entries.data(), 0);
            } end function rend

            function backwards(self&) -> std::iterators::Range<std::iterators::Pointer<Pair<K, V>, true>> {
                return std::iterators::Range<std::iterators::Pointer<Pair<K, V>, true>>(self.rbegin(), self.rend());
            } end function backwards

            function insert(self&, const K&: key, const V&: value) -> bool {
                if (self.m_index.contains(key)) then {
                    return false;
                }
                self.m_index.set(key, self.m_entries.size());
                self.m_entries.push_back(Pair<K, V>(key, value));
                return true;
            } end function insert

            function set(self&, const K&: key, const V&: value) -> void {
                unsigned long int*: at = self.m_index.find(key);
                if (at != nullptr) then {
                    self.m_entries[static_cast<unsigned long int>(*at)].second = value;
                    return;
                }
                self.m_index.set(key, self.m_entries.size());
                self.m_entries.push_back(Pair<K, V>(key, value));
            } end function set

            operator([]) function(self&, const K&: key) -> V& {
                unsigned long int*: at = self.m_index.find(key);
                if (at != nullptr) then {
                    return self.m_entries[static_cast<unsigned long int>(*at)].second;
                }
                self.m_index.set(key, self.m_entries.size());
                self.m_entries.push_back(Pair<K, V>(key, V()));
                return self.m_entries[self.m_entries.size() - 1].second;
            }

            function at(self&, const K&: key) -> V& {
                unsigned long int*: where = self.m_index.find(key);
                if (where == nullptr) then {
                    self.missing(key);
                }
                return self.m_entries[static_cast<unsigned long int>(*where)].second;
            } end function at

            function at(const self&, const K&: key) -> const V& {
                const unsigned long int: where = self.m_index.get(key, std::npos);
                if (where == std::npos) then {
                    self.missing(key);
                }
                return self.m_entries[where].second;
            } end function at

            function find(self&, const K&: key) -> V* {
                unsigned long int*: where = self.m_index.find(key);
                if (where == nullptr) then {
                    return nullptr;
                }
                return &self.m_entries[static_cast<unsigned long int>(*where)].second;
            } end function find

            function get(const self&, const K&: key, const V&: fallback) -> V {
                const unsigned long int: where = self.m_index.get(key, std::npos);
                if (where == std::npos) then {
                    return fallback;
                }
                return self.m_entries[where].second;
            } end function get

            function contains(const self&, const K&: key) -> bool {
                return self.m_index.contains(key);
            } end function contains

            function index_of(const self&, const K&: key) -> unsigned long int {
                return self.m_index.get(key, std::npos);
            } end function index_of

            function entry(self&, unsigned long int: i) -> Pair<K, V>& {
                return self.m_entries[i];
            } end function entry

            function entry(const self&, unsigned long int: i) -> const Pair<K, V>& {
                return self.m_entries[i];
            } end function entry

            function remove(self&, const K&: key) -> bool {
                const unsigned long int: where = self.m_index.get(key, std::npos);
                if (where == std::npos) then {
                    return false;
                }
                self.m_index.remove(key);
                self.m_entries.erase(where);
                self.reindex_from(where);
                return true;
            } end function remove

            function pop(self&, const K&: key) -> V {
                const unsigned long int: where = self.m_index.get(key, std::npos);
                if (where == std::npos) then {
                    self.missing(key);
                }
                V: value = self.m_entries[where].second;
                self.remove(key);
                return value;
            } end function pop

            function pop_last(self&) -> Pair<K, V> {
                if (self.m_entries.empty()) then {
                    throw std::errors::collection_error("pop_last() on an empty map");
                }
                Pair<K, V>: last = self.m_entries.pop_back();
                self.m_index.remove(last.first);
                return last;
            } end function pop_last

            function pop_first(self&) -> Pair<K, V> {
                if (self.m_entries.empty()) then {
                    throw std::errors::collection_error("pop_first() on an empty map");
                }
                Pair<K, V>: first = self.m_entries.erase(0);
                self.m_index.remove(first.first);
                self.reindex_from(0);
                return first;
            } end function pop_first

            function move_to_end(self&, const K&: key) -> void {
                const unsigned long int: where = self.m_index.get(key, std::npos);
                if (where == std::npos) then {
                    self.missing(key);
                }
                Pair<K, V>: moved = self.m_entries.erase(where);
                self.m_entries.push_back(moved);
                self.reindex_from(where);
            } end function move_to_end

            function move_to_front(self&, const K&: key) -> void {
                const unsigned long int: where = self.m_index.get(key, std::npos);
                if (where == std::npos) then {
                    self.missing(key);
                }
                Pair<K, V>: moved = self.m_entries.erase(where);
                self.m_entries.insert(0, moved);
                self.reindex_from(0);
            } end function move_to_front

            function first(const self&) -> const Pair<K, V>& {
                if (self.m_entries.empty()) then {
                    throw std::errors::collection_error("first() on an empty map");
                }
                return self.m_entries[0];
            } end function first

            function last(const self&) -> const Pair<K, V>& {
                if (self.m_entries.empty()) then {
                    throw std::errors::collection_error("last() on an empty map");
                }
                return self.m_entries[self.m_entries.size() - 1];
            } end function last

            function clear(self&) -> void {
                self.m_entries.clear();
                self.m_index.clear();
            } end function clear

            function keys(const self&) -> Vector<K> {
                Vector<K>: out;
                out.reserve(self.m_entries.size());
                for (const auto&: e in self.m_entries) {
                    out.push_back(e.first);
                }
                return out;
            } end function keys

            function values(const self&) -> Vector<V> {
                Vector<V>: out;
                out.reserve(self.m_entries.size());
                for (const auto&: e in self.m_entries) {
                    out.push_back(e.second);
                }
                return out;
            } end function values

            function items(const self&) -> Vector<Pair<K, V>> {
                return self.m_entries;
            } end function items

            function update(self&, const OrderedMap&: other) -> void {
                for (const auto&: e in other) {
                    self.set(e.first, e.second);
                }
            } end function update

            operator(==) function(const self&, const OrderedMap&: other) -> bool {
                return self.m_entries == other.m_entries;
            }

            operator(!=) function(const self&, const OrderedMap&: other) -> bool {
                return !(self.m_entries == other.m_entries);
            }
        } end class OrderedMap

        safe(compile) {
            template <typename T>
            requires HashKey<T> && std::traits::has_operator<std::traits::op::equal, T>
            class OrderedSet {
                Vector<T>: m_items;
                UnorderedMap<T, unsigned long int>: m_index;

                function reindex_from(self&, unsigned long int: start) -> void {
                    for (unsigned long int: i = start; i < self.m_items.size(); i++) {
                        self.m_index.set(self.m_items[i], i);
                    }
                } end function reindex_from

            public:
                using Iterator = const T*;
                using ReverseIterator = std::iterators::Pointer<const T, true>;

                constructor() { }

                constructor(T...: items) {
                    for (const T&: item in items) {
                        self.insert(item);
                    }
                }

                function size(const self&) -> unsigned long int {
                    return self.m_items.size();
                } end function size

                function empty(const self&) -> bool {
                    return self.m_items.empty();
                } end function empty

                function begin(const self&) -> const T* {
                    return self.m_items.begin();
                } end function begin

                function end(const self&) -> const T* {
                    return self.m_items.end();
                } end function end

                function rbegin(const self&) -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(self.m_items.data(), self.m_items.size());
                } end function rbegin

                function rend(const self&) -> std::iterators::Pointer<const T, true> {
                    return std::iterators::Pointer<const T, true>(self.m_items.data(), 0);
                } end function rend

                function backwards(const self&) -> std::iterators::Range<std::iterators::Pointer<const T, true>> {
                    return std::iterators::Range<std::iterators::Pointer<const T, true>>(self.rbegin(), self.rend());
                } end function backwards

                function insert(self&, const T&: value) -> bool {
                    if (self.m_index.contains(value)) then {
                        return false;
                    }
                    self.m_index.set(value, self.m_items.size());
                    self.m_items.push_back(value);
                    return true;
                } end function insert

                function contains(const self&, const T&: value) -> bool {
                    return self.m_index.contains(value);
                } end function contains

                function index_of(const self&, const T&: value) -> unsigned long int {
                    return self.m_index.get(value, std::npos);
                } end function index_of

                operator([]) function(const self&, unsigned long int: i) -> const T& {
                    return self.m_items[i];
                }

                function remove(self&, const T&: value) -> bool {
                    const unsigned long int: where = self.m_index.get(value, std::npos);
                    if (where == std::npos) then {
                        return false;
                    }
                    self.m_index.remove(value);
                    self.m_items.erase(where);
                    self.reindex_from(where);
                    return true;
                } end function remove

                function pop_last(self&) -> T {
                    if (self.m_items.empty()) then {
                        throw std::errors::collection_error("pop_last() on an empty set");
                    }
                    T: last = self.m_items.pop_back();
                    self.m_index.remove(last);
                    return last;
                } end function pop_last

                function clear(self&) -> void {
                    self.m_items.clear();
                    self.m_index.clear();
                } end function clear

                function to_vector(const self&) -> Vector<T> {
                    return self.m_items;
                } end function to_vector

                function union_with(const self&, const OrderedSet&: other) -> OrderedSet {
                    OrderedSet: out = *this;
                    for (const T&: v in other) {
                        out.insert(v);
                    }
                    return out;
                } end function union_with

                function intersect_with(const self&, const OrderedSet&: other) -> OrderedSet {
                    OrderedSet: out;
                    for (const T&: v in self.m_items) {
                        if (other.contains(v)) then {
                            out.insert(v);
                        }
                    }
                    return out;
                } end function intersect_with

                function except(const self&, const OrderedSet&: other) -> OrderedSet {
                    OrderedSet: out;
                    for (const T&: v in self.m_items) {
                        if (!other.contains(v)) then {
                            out.insert(v);
                        }
                    }
                    return out;
                } end function except

                function is_subset_of(const self&, const OrderedSet&: other) -> bool {
                    for (const T&: v in self.m_items) {
                        if (!other.contains(v)) then {
                            return false;
                        }
                    }
                    return true;
                } end function is_subset_of

                operator(==) function(const self&, const OrderedSet&: other) -> bool {
                    return self.m_items.size() == other.m_items.size() && self.is_subset_of(other);
                }

                operator(!=) function(const self&, const OrderedSet&: other) -> bool {
                    return !(*this == other);
                }
            } end class OrderedSet

            template <typename T>
            requires HashKey<T> && std::traits::has_operator<std::traits::op::equal, T>
            class Counter {
                OrderedMap<T, unsigned long int>: m_counts;

            public:
                constructor() { }

                constructor(T...: items) {
                    for (const T&: item in items) {
                        self.add(item);
                    }
                }

                static function of(iterable<T>: items) -> Counter {
                    Counter: out;
                    for (const T&: item in items) {
                        out.add(item);
                    }
                    return out;
                } end function of

                function size(const self&) -> unsigned long int {
                    return self.m_counts.size();
                } end function size

                function empty(const self&) -> bool {
                    return self.m_counts.empty();
                } end function empty

                function begin(const self&) -> const Pair<T, unsigned long int>* {
                    return self.m_counts.begin();
                } end function begin

                function end(const self&) -> const Pair<T, unsigned long int>* {
                    return self.m_counts.end();
                } end function end

                function add(self&, const T&: item) -> unsigned long int {
                    unsigned long int&: n = self.m_counts[item];
                    n += 1;
                    return n;
                } end function add

                function add(self&, const T&: item, unsigned long int: times) -> unsigned long int {
                    unsigned long int&: n = self.m_counts[item];
                    n += times;
                    return n;
                } end function add

                function add_all(self&, iterable<T>: items) -> void {
                    for (const T&: item in items) {
                        self.add(item);
                    }
                } end function add_all

                function subtract(self&, const T&: item, unsigned long int: times = 1) -> unsigned long int {
                    unsigned long int&: n = self.m_counts[item];
                    n -= times;
                    return n;
                } end function subtract

                function set(self&, const T&: item, unsigned long int: times) -> void {
                    self.m_counts.set(item, times);
                } end function set

                function count(const self&, const T&: item) -> unsigned long int {
                    return self.m_counts.get(item, 0);
                } end function count

                operator([]) function(const self&, const T&: item) -> unsigned long int {
                    return self.m_counts.get(item, 0);
                }

                function contains(const self&, const T&: item) -> bool {
                    return self.m_counts.contains(item);
                } end function contains

                function remove(self&, const T&: item) -> bool {
                    return self.m_counts.remove(item);
                } end function remove

                function clear(self&) -> void {
                    self.m_counts.clear();
                } end function clear

                function total(const self&) -> unsigned long int {
                    unsigned long int: sum = 0;
                    for (const auto&: e in self.m_counts) {
                        sum += e.second;
                    }
                    return sum;
                } end function total

                function most_common(const self&) -> Vector<Pair<T, unsigned long int>> {
                    Vector<Pair<T, unsigned long int>>: out = self.m_counts.items();
                    out.stable_sort([](const Pair<T, unsigned long int>&: a, const Pair<T, unsigned long int>&: b) -> bool { return a.second > b.second; });
                    return out;
                } end function most_common

                function most_common(const self&, unsigned long int: n) -> Vector<Pair<T, unsigned long int>> {
                    Vector<Pair<T, unsigned long int>>: out = self.most_common();
                    if (n < out.size()) then {
                        out.resize(n);
                    }
                    return out;
                } end function most_common

                function least_common(const self&, unsigned long int: n) -> Vector<Pair<T, unsigned long int>> {
                    Vector<Pair<T, unsigned long int>>: out = self.m_counts.items();
                    out.stable_sort([](const Pair<T, unsigned long int>&: a, const Pair<T, unsigned long int>&: b) -> bool { return a.second < b.second; });
                    if (n < out.size()) then {
                        out.resize(n);
                    }
                    return out;
                } end function least_common

                function elements(const self&) -> Vector<T> {
                    Vector<T>: out;
                    for (const auto&: e in self.m_counts) {
                        for (unsigned long int: i = 0; i < e.second; i++) {
                            out.push_back(e.first);
                        }
                    }
                    return out;
                } end function elements

                function keys(const self&) -> Vector<T> {
                    return self.m_counts.keys();
                } end function keys

                function drop_zeros(self&) -> unsigned long int {
                    Vector<T>: gone;
                    for (const auto&: e in self.m_counts) {
                        if (e.second <= 0) then {
                            gone.push_back(e.first);
                        }
                    }
                    for (const T&: k in gone) {
                        self.m_counts.remove(k);
                    }
                    return gone.size();
                } end function drop_zeros

                function merge(self&, const Counter&: other) -> void {
                    for (const auto&: e in other) {
                        self.add(e.first, e.second);
                    }
                } end function merge

                operator(==) function(const self&, const Counter&: other) -> bool {
                    if (self.size() != other.size()) then {
                        return false;
                    }
                    for (const auto&: e in self.m_counts) {
                        if (other.count(e.first) != e.second || !other.contains(e.first)) then {
                            return false;
                        }
                    }
                    return true;
                }

                operator(!=) function(const self&, const Counter&: other) -> bool {
                    return !(*this == other);
                }
            } end class Counter
        } end safe

        template <typename K, typename V>
        requires HashKey<K> && std::traits::has_operator<std::traits::op::equal, K>
        class DefaultMap {
            UnorderedMap<K, V>: m_map;
            function() -> V: m_make;

        public:
            using Iterator = UnorderedMap<K, V>::Iterator;
            using ReverseIterator = UnorderedMap<K, V>::ReverseIterator;

            constructor() : m_make = []() -> V { return V(); } { }

            constructor(function() -> V: make) : m_make = make { }

            constructor(const V&: value) : m_make = [value]() -> V { return value; } { }

            function size(const self&) -> unsigned long int {
                return self.m_map.size();
            } end function size

            function empty(const self&) -> bool {
                return self.m_map.empty();
            } end function empty

            function begin(const self&) -> Iterator {
                return self.m_map.begin();
            } end function begin

            function end(const self&) -> Iterator {
                return self.m_map.end();
            } end function end

            operator([]) function(self&, const K&: key) -> V& {
                V*: found = self.m_map.find(key);
                if (found != nullptr) then {
                    return *found;
                }
                self.m_map.set(key, self.m_make());
                return *self.m_map.find(key);
            }

            function at(self&, const K&: key) -> V& {
                return self.m_map.at(key);
            } end function at

            function get(const self&, const K&: key, const V&: fallback) -> V {
                return self.m_map.get(key, fallback);
            } end function get

            function find(self&, const K&: key) -> V* {
                return self.m_map.find(key);
            } end function find

            function set(self&, const K&: key, const V&: value) -> void {
                self.m_map.set(key, value);
            } end function set

            function contains(const self&, const K&: key) -> bool {
                return self.m_map.contains(key);
            } end function contains

            function remove(self&, const K&: key) -> bool {
                return self.m_map.remove(key);
            } end function remove

            function clear(self&) -> void {
                self.m_map.clear();
            } end function clear

            function keys(const self&) -> Vector<K> {
                return self.m_map.keys();
            } end function keys

            function values(const self&) -> Vector<V> {
                return self.m_map.values();
            } end function values
        } end class DefaultMap

        safe(compile) {
            template <unsigned long int N>
            class Bitset {
                static_assert(N >= 0, "a Bitset can't have a negative number of bits");

            public:
                using word_type = std::hardware_uint64;
                static constexpr unsigned long int: word_count = N == 0 ? 1 : (N + 63) / 64;

            private:
                array[word_count] word_type: m_words;

                static function word_of(unsigned long int: index) -> unsigned long int {
                    return index / 64;
                } end function word_of

                static function bit_of(unsigned long int: index) -> word_type {
                    return static_cast<word_type>(static_cast<word_type>(1) << static_cast<word_type>(index % 64));
                } end function bit_of

                static function last_word_mask() -> word_type {
                    if constexpr (N % 64 == 0) then {
                        return static_cast<word_type>(~static_cast<word_type>(0));
                    } else then {
                        return static_cast<word_type>(static_cast<word_type>(static_cast<word_type>(1) << static_cast<word_type>(N % 64)) - static_cast<word_type>(1));
                    }
                } end function last_word_mask

                function trim(self&) -> void {
                    if constexpr (N == 0) then {
                        self.m_words[0] = static_cast<word_type>(0);
                    } else then {
                        self.m_words[word_count - 1] = static_cast<word_type>(self.m_words[word_count - 1] & last_word_mask());
                    }
                } end function trim

                function check(const self&, unsigned long int: index) -> void {
                    if (index >= N) then {
                        throw detail::out_of_range(index, N);
                    }
                } end function check

                static function bits_in(word_type: w) -> unsigned long int {
                    unsigned long int: n = 0;
                    while (w != static_cast<word_type>(0)) {
                        w = static_cast<word_type>(w & static_cast<word_type>(w - static_cast<word_type>(1)));
                        n += 1;
                    }
                    return n;
                } end function bits_in

                static function lowest_bit(word_type: w) -> unsigned long int {
                    unsigned long int: i = 0;
                    while ((w & static_cast<word_type>(1)) == static_cast<word_type>(0)) {
                        w = static_cast<word_type>(w >> static_cast<word_type>(1));
                        i += 1;
                    }
                    return i;
                } end function lowest_bit

            public:
                class Step {
                public:
                    const Bitset*: owner;
                    unsigned long int: at;

                    constructor(const Bitset*: o, unsigned long int: a) : owner = o, at = a { }

                    operator(!=) function(const self&, const Step&: other) -> bool {
                        return self.at != other.at;
                    }

                    operator(++) function(self&) -> Step& {
                        self.at = self.owner->find_next(self.at);
                        return self;
                    }

                    operator(*) function(const self&) -> unsigned long int {
                        return self.at;
                    }
                } end class Step

                constructor() {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(0);
                    }
                }

                constructor(unsigned long int...: on) {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(0);
                    }
                    for (unsigned long int: index in on) {
                        self.set(index);
                    }
                }

                static function from_mask(std::hardware_uint64: mask) -> Bitset {
                    Bitset: out;
                    out.m_words[0] = mask;
                    out.trim();
                    return out;
                } end function from_mask

                static function from_string(const string&: bits) -> Bitset {
                    Bitset: out;
                    const unsigned long int: n = bits.length();
                    for (unsigned long int: k = 0; k < n; k++) {
                        const char: c = bits[k];
                        const unsigned long int: index = n - 1 - k;
                        if (c == '1') then {
                            if (index >= N) then {
                                throw std::errors::collection_error(static_cast<string>(`the string has a '1' at bit ${index}, but this Bitset has only ${N} bits`));
                            }
                            out.m_words[word_of(index)] = static_cast<word_type>(out.m_words[word_of(index)] | bit_of(index));
                        } else if (c != '0') then {
                            throw std::errors::collection_error(static_cast<string>(`a Bitset string can only have '0' and '1', not '${c}'`));
                        }
                    }
                    return out;
                } end function from_string

                static function size() -> unsigned long int {
                    return N;
                } end function size

                function test(const self&, unsigned long int: index) -> bool {
                    self.check(index);
                    return (self.m_words[word_of(index)] & bit_of(index)) != static_cast<word_type>(0);
                } end function test

                function is_on(const self&, unsigned long int: index) -> bool {
                    return self.test(index);
                } end function is_on

                function is_off(const self&, unsigned long int: index) -> bool {
                    return !self.test(index);
                } end function is_off

                operator([]) function(const self&, unsigned long int: index) -> bool {
                    return self.test(index);
                }

                function set(self&, unsigned long int: index) -> Bitset& {
                    self.check(index);
                    self.m_words[word_of(index)] = static_cast<word_type>(self.m_words[word_of(index)] | bit_of(index));
                    return self;
                } end function set

                function set(self&, unsigned long int: index, bool: on) -> Bitset& {
                    if (on) then {
                        return self.set(index);
                    }
                    return self.clear(index);
                } end function set

                function clear(self&, unsigned long int: index) -> Bitset& {
                    self.check(index);
                    self.m_words[word_of(index)] = static_cast<word_type>(self.m_words[word_of(index)] & static_cast<word_type>(~bit_of(index)));
                    return self;
                } end function clear

                function toggle(self&, unsigned long int: index) -> Bitset& {
                    self.check(index);
                    self.m_words[word_of(index)] = static_cast<word_type>(self.m_words[word_of(index)] ^ bit_of(index));
                    return self;
                } end function toggle

                function set_all(self&) -> Bitset& {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(~static_cast<word_type>(0));
                    }
                    self.trim();
                    return self;
                } end function set_all

                function clear_all(self&) -> Bitset& {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(0);
                    }
                    return self;
                } end function clear_all

                function toggle_all(self&) -> Bitset& {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(~self.m_words[i]);
                    }
                    self.trim();
                    return self;
                } end function toggle_all

                function count(const self&) -> unsigned long int {
                    unsigned long int: n = 0;
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        n += bits_in(self.m_words[i]);
                    }
                    return n;
                } end function count

                function empty(const self&) -> bool {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        if (self.m_words[i] != static_cast<word_type>(0)) then {
                            return false;
                        }
                    }
                    return true;
                } end function empty

                function full(const self&) -> bool {
                    return self.count() == N;
                } end function full

                function has_any(const self&, const Bitset&: other) -> bool {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        if ((self.m_words[i] & other.m_words[i]) != static_cast<word_type>(0)) then {
                            return true;
                        }
                    }
                    return false;
                } end function has_any

                function has_all(const self&, const Bitset&: other) -> bool {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        if ((self.m_words[i] & other.m_words[i]) != other.m_words[i]) then {
                            return false;
                        }
                    }
                    return true;
                } end function has_all

                function has_none(const self&, const Bitset&: other) -> bool {
                    return !self.has_any(other);
                } end function has_none

                function includes(const self&, const Bitset&: other) -> bool {
                    return self.has_all(other);
                } end function includes

                function is_subset_of(const self&, const Bitset&: other) -> bool {
                    return other.has_all(self);
                } end function is_subset_of

                function find_first(const self&) -> unsigned long int {
                    return self.find_from(0);
                } end function find_first

                function find_next(const self&, unsigned long int: after) -> unsigned long int {
                    return after >= N ? N : self.find_from(after + 1);
                } end function find_next

                function find_from(const self&, unsigned long int: start) -> unsigned long int {
                    if (start >= N) then {
                        return N;
                    }
                    unsigned long int: w = word_of(start);
                    word_type: current = static_cast<word_type>(self.m_words[w] & static_cast<word_type>(~static_cast<word_type>(bit_of(start) - static_cast<word_type>(1))));
                    while (true) {
                        if (current != static_cast<word_type>(0)) then {
                            const unsigned long int: found = w * 64 + lowest_bit(current);
                            return found < N ? found : N;
                        }
                        w += 1;
                        if (w >= word_count) then {
                            return N;
                        }
                        current = self.m_words[w];
                    }
                    return N;
                } end function find_from

                function begin(const self&) -> Step {
                    return Step(&self, self.find_first());
                } end function begin

                function end(const self&) -> Step {
                    return Step(&self, N);
                } end function end

                function to_mask(const self&) -> std::hardware_uint64 {
                    for (unsigned long int: i = 1; i < word_count; i++) {
                        if (self.m_words[i] != static_cast<word_type>(0)) then {
                            throw std::errors::collection_error("to_mask() needs every set bit to be below 64");
                        }
                    }
                    return self.m_words[0];
                } end function to_mask

                function to_string(const self&) -> string {
                    string: out = "";
                    for (unsigned long int: index = N; index > 0;) {
                        index--;
                        if ((self.m_words[word_of(index)] & bit_of(index)) != static_cast<word_type>(0)) then {
                            out += '1';
                        } else then {
                            out += '0';
                        }
                    }
                    return out;
                } end function to_string

                operator(==) function(const self&, const Bitset&: other) -> bool {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        if (self.m_words[i] != other.m_words[i]) then {
                            return false;
                        }
                    }
                    return true;
                }

                operator(!=) function(const self&, const Bitset&: other) -> bool {
                    return !(self == other);
                }

                operator(|=) function(self&, const Bitset&: other) -> Bitset& {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(self.m_words[i] | other.m_words[i]);
                    }
                    return self;
                }

                operator(&=) function(self&, const Bitset&: other) -> Bitset& {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(self.m_words[i] & other.m_words[i]);
                    }
                    return self;
                }

                operator(^=) function(self&, const Bitset&: other) -> Bitset& {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(self.m_words[i] ^ other.m_words[i]);
                    }
                    return self;
                }

                operator(-=) function(self&, const Bitset&: other) -> Bitset& {
                    for (unsigned long int: i = 0; i < word_count; i++) {
                        self.m_words[i] = static_cast<word_type>(self.m_words[i] & static_cast<word_type>(~other.m_words[i]));
                    }
                    return self;
                }

                operator(|) function(const self&, const Bitset&: other) -> Bitset {
                    Bitset: out = self;
                    out |= other;
                    return out;
                }

                operator(&) function(const self&, const Bitset&: other) -> Bitset {
                    Bitset: out = self;
                    out &= other;
                    return out;
                }

                operator(^) function(const self&, const Bitset&: other) -> Bitset {
                    Bitset: out = self;
                    out ^= other;
                    return out;
                }

                operator(-) function(const self&, const Bitset&: other) -> Bitset {
                    Bitset: out = self;
                    out -= other;
                    return out;
                }

                operator(~) function(const self&) -> Bitset {
                    Bitset: out = self;
                    out.toggle_all();
                    return out;
                }

                operator(<<=) function(self&, unsigned long int: shift) -> Bitset& {
                    if (shift <= 0) then {
                        return self;
                    }
                    Bitset: out;
                    for (unsigned long int: index in self) {
                        if (index + shift < N) then {
                            out.set(index + shift);
                        }
                    }
                    self = out;
                    return self;
                }

                operator(>>=) function(self&, unsigned long int: shift) -> Bitset& {
                    if (shift <= 0) then {
                        return self;
                    }
                    Bitset: out;
                    for (unsigned long int: index in self) {
                        if (index >= shift) then {
                            out.set(index - shift);
                        }
                    }
                    self = out;
                    return self;
                }

                operator(<<) function(const self&, unsigned long int: shift) -> Bitset {
                    Bitset: out = self;
                    out <<= shift;
                    return out;
                }

                operator(>>) function(const self&, unsigned long int: shift) -> Bitset {
                    Bitset: out = self;
                    out >>= shift;
                    return out;
                }
            } end class Bitset
        } end safe
    } end namespace collections
} end namespace std
