                } end function partial_sort

                function nth_element(long int: index) -> void {
                    check(index);
                    std::algorithms::nth_element(data(), data() + index, data() + size());
                } end function nth_element

                function is_sorted() const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size());
                } end function is_sorted

                function is_sorted(std::Compare<T>: comp) const -> bool {
                    return std::algorithms::is_sorted(data(), data() + size(), comp);
                } end function is_sorted

                function sorted() const -> DynamicArray {
                    DynamicArray: out = *this;
                    out.sort();
                    return out;
