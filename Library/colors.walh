        function parse(const string&: text_value) -> Color {
            const string: key = detail::squash(text_value);
            if (key.starts_with("#")) then {
                return Color::from_hex(key);
            }
            return named(key);
        } end function parse

        function lerp(const Color&: x, const Color&: y, float: t) -> Color {
            return x.lerp(y, t);
        } end function lerp
