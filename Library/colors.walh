import module.math
import module.random

namespace std {
    namespace errors {
        class color_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what() const -> string {
                return message;
            } end function what
        } end class color_error
    } end namespace errors

    namespace colors {
        namespace detail {
            function clamp_channel(long int: v) -> int {
                if (v < 0) then {
                    return 0;
                }
                if (v > 255) then {
                    return 255;
                }
                return static_cast<int>(v);
            } end function clamp_channel

            function clamp_unit(float: v) -> float {
                if (v < 0.0) then {
                    return 0.0;
                }
                if (v > 1.0) then {
                    return 1.0;
                }
                return v;
            } end function clamp_unit

            function channel_of(float: unit) -> int {
                return clamp_channel(static_cast<long int>(std::math::floor(clamp_unit(unit) * 255.0 + 0.5)));
            } end function channel_of

            function wrap_hue(float: h) -> float {
                float: x = std::math::fmod(h, 360.0);
                if (x < 0.0) then {
                    x = x + 360.0;
                }
                return x;
            } end function wrap_hue

            function hex_digit(char: c) -> int {
                if (c >= '0' && c <= '9') then {
                    return static_cast<int>(c) - static_cast<int>('0');
                }
                if (c >= 'a' && c <= 'f') then {
                    return static_cast<int>(c) - static_cast<int>('a') + 10;
                }
                if (c >= 'A' && c <= 'F') then {
                    return static_cast<int>(c) - static_cast<int>('A') + 10;
                }
                return -1;
            } end function hex_digit

            function hex_pair(long int: v) -> string {
                const string: digits = "0123456789abcdef";
                return digits.substr(v / 16, 1) + digits.substr(v % 16, 1);
            } end function hex_pair

            function squash(const string&: s) -> string {
                string: out = "";
                for (char: c in s) {
                    if (c == ' ' || c == '_' || c == '-') then {
                        continue;
                    }
                    if (c >= 'A' && c <= 'Z') then {
                        out = out + static_cast<char>(c + 32);
                    } else then {
                        out = out + c;
                    }
                }
                return out;
            } end function squash

            function to_linear(float: c) -> float {
                if (c <= 0.04045) then {
                    return c / 12.92;
                }
                return std::math::pow((c + 0.055) / 1.055, 2.4);
            } end function to_linear

            function hue_part(float: p, float: q, float: t) -> float {
                float: x = t;
                if (x < 0.0) then {
                    x = x + 1.0;
                }
                if (x > 1.0) then {
                    x = x - 1.0;
                }
                if (x < 1.0 / 6.0) then {
                    return p + (q - p) * 6.0 * x;
                }
                if (x < 0.5) then {
                    return q;
                }
                if (x < 2.0 / 3.0) then {
                    return p + (q - p) * (2.0 / 3.0 - x) * 6.0;
                }
                return p;
            } end function hue_part

            function max3(float: a, float: b, float: c) -> float {
                float: m = a;
                if (b > m) then {
                    m = b;
                }
                if (c > m) then {
                    m = c;
                }
                return m;
            } end function max3

            function min3(float: a, float: b, float: c) -> float {
                float: m = a;
                if (b < m) then {
                    m = b;
                }
                if (c < m) then {
                    m = c;
                }
                return m;
            } end function min3
        } end namespace detail

        struct HSL {
            float: hue = 0.0;
            float: saturation = 0.0;
            float: lightness = 0.0;
            float: alpha = 1.0;

            constructor() { }

            constructor(float: h, float: s, float: l, float: a = 1.0) : hue = h, saturation = s, lightness = l, alpha = a { }

            function to_string() const -> string {
                return static_cast<string>(`hsl(${hue}, ${saturation}, ${lightness}, ${alpha})`);
            } end function to_string
        } end struct HSL

        struct HSV {
            float: hue = 0.0;
            float: saturation = 0.0;
            float: value = 0.0;
            float: alpha = 1.0;

            constructor() { }

            constructor(float: h, float: s, float: v, float: a = 1.0) : hue = h, saturation = s, value = v, alpha = a { }

            function to_string() const -> string {
                return static_cast<string>(`hsv(${hue}, ${saturation}, ${value}, ${alpha})`);
            } end function to_string
        } end struct HSV

        struct Color {
            int: r = 0;
            int: g = 0;
            int: b = 0;
            int: a = 255;

            constructor() { }

            constructor(long int: red, long int: green, long int: blue, long int: alpha = 255) : r = detail::clamp_channel(red), g = detail::clamp_channel(green), b = detail::clamp_channel(blue), a = detail::clamp_channel(alpha) { }

            static function rgb(long int: red, long int: green, long int: blue) -> Color {
                return Color(red, green, blue, 255);
            } end function rgb

            static function rgba(long int: red, long int: green, long int: blue, long int: alpha) -> Color {
                return Color(red, green, blue, alpha);
            } end function rgba

            static function from_unit(float: red, float: green, float: blue, float: alpha = 1.0) -> Color {
                return Color(detail::channel_of(red), detail::channel_of(green), detail::channel_of(blue), detail::channel_of(alpha));
            } end function from_unit

            static function gray(long int: level, long int: alpha = 255) -> Color {
                return Color(level, level, level, alpha);
            } end function gray

            static function from_packed(long int: rgba) -> Color {
                return Color((rgba / 16777216) % 256, (rgba / 65536) % 256, (rgba / 256) % 256, rgba % 256);
            } end function from_packed

            static function from_hex(const string&: hex) -> Color {
                string: s = hex.trim();
                if (s.starts_with("#")) then {
                    s = s.substr(1);
                }
                const long int: n = s.length();
                if (n != 3 && n != 4 && n != 6 && n != 8) then {
                    throw std::errors::color_error(static_cast<string>(`'${hex}' is not a hex color; use #rgb, #rgba, #rrggbb or #rrggbbaa`));
                }
                array[8] int: d = {0, 0, 0, 0, 0, 0, 15, 15};
                long int: k = 0;
                for (char: c in s) {
                    const int: v = detail::hex_digit(c);
                    if (v < 0) then {
                        throw std::errors::color_error(static_cast<string>(`'${hex}' is not a hex color; '${c}' is not a hex digit`));
                    }
                    d[k] = v;
                    k++;
                }
                if (n == 3 || n == 4) then {
                    const int: alpha = n == 4 ? d[3] * 17 : 255;
                    return Color(d[0] * 17, d[1] * 17, d[2] * 17, alpha);
                }
                const int: alpha = n == 8 ? d[6] * 16 + d[7] : 255;
                return Color(d[0] * 16 + d[1], d[2] * 16 + d[3], d[4] * 16 + d[5], alpha);
            } end function from_hex

            static function from_hsl(float: hue, float: saturation, float: lightness, float: alpha = 1.0) -> Color {
                const float: h = detail::wrap_hue(hue) / 360.0;
                const float: s = detail::clamp_unit(saturation);
                const float: l = detail::clamp_unit(lightness);
                if (s == 0.0) then {
                    return Color::from_unit(l, l, l, alpha);
                }
                const float: q = l < 0.5 ? l * (1.0 + s) : l + s - l * s;
                const float: p = 2.0 * l - q;
                return Color::from_unit(detail::hue_part(p, q, h + 1.0 / 3.0), detail::hue_part(p, q, h), detail::hue_part(p, q, h - 1.0 / 3.0), alpha);
            } end function from_hsl

            static function from_hsl(const HSL&: c) -> Color {
                return Color::from_hsl(c.hue, c.saturation, c.lightness, c.alpha);
            } end function from_hsl

            static function from_hsv(float: hue, float: saturation, float: value, float: alpha = 1.0) -> Color {
                const float: h = detail::wrap_hue(hue) / 60.0;
                const float: s = detail::clamp_unit(saturation);
                const float: v = detail::clamp_unit(value);
                const float: c = v * s;
                const float: x = c * (1.0 - std::math::abs(std::math::fmod(h, 2.0) - 1.0));
                const float: m = v - c;
                float: rr = 0.0;
                float: gg = 0.0;
                float: bb = 0.0;
                if (h < 1.0) then {
                    rr = c;
                    gg = x;
                } else if (h < 2.0) then {
                    rr = x;
                    gg = c;
                } else if (h < 3.0) then {
                    gg = c;
                    bb = x;
                } else if (h < 4.0) then {
                    gg = x;
                    bb = c;
                } else if (h < 5.0) then {
                    rr = x;
                    bb = c;
                } else then {
                    rr = c;
                    bb = x;
                }
                return Color::from_unit(rr + m, gg + m, bb + m, alpha);
            } end function from_hsv

            static function from_hsv(const HSV&: c) -> Color {
                return Color::from_hsv(c.hue, c.saturation, c.value, c.alpha);
            } end function from_hsv

            static function random(bool: random_alpha = false) -> Color {
                const long int: alpha = random_alpha ? std::random::random_int(0, 255) : 255;
                return Color(std::random::random_int(0, 255), std::random::random_int(0, 255), std::random::random_int(0, 255), alpha);
            } end function random

            function red() const -> int {
                return r;
            } end function red

            function green() const -> int {
                return g;
            } end function green

            function blue() const -> int {
                return b;
            } end function blue

            function alpha() const -> int {
                return a;
            } end function alpha

            function red_unit() const -> float {
                return static_cast<float>(r) / 255.0;
            } end function red_unit

            function green_unit() const -> float {
                return static_cast<float>(g) / 255.0;
            } end function green_unit

            function blue_unit() const -> float {
                return static_cast<float>(b) / 255.0;
            } end function blue_unit

            function alpha_unit() const -> float {
                return static_cast<float>(a) / 255.0;
            } end function alpha_unit

            function packed() const -> long int {
                return static_cast<long int>(r) * 16777216 + static_cast<long int>(g) * 65536 + static_cast<long int>(b) * 256 + static_cast<long int>(a);
            } end function packed

            function to_hex(bool: include_alpha = false) -> string {
                string: out = "#" + detail::hex_pair(r) + detail::hex_pair(g) + detail::hex_pair(b);
                if (include_alpha) then {
                    out = out + detail::hex_pair(a);
                }
                return out;
            } end function to_hex

            function to_string() const -> string {
                if (a == 255) then {
                    return static_cast<string>(`rgb(${r}, ${g}, ${b})`);
                }
                return static_cast<string>(`rgba(${r}, ${g}, ${b}, ${a})`);
            } end function to_string

            function to_hsl() const -> HSL {
                const float: rr = red_unit();
                const float: gg = green_unit();
                const float: bb = blue_unit();
                const float: hi = detail::max3(rr, gg, bb);
                const float: lo = detail::min3(rr, gg, bb);
                const float: l = (hi + lo) / 2.0;
                if (hi == lo) then {
                    return HSL(0.0, 0.0, l, alpha_unit());
                }
                const float: dd = hi - lo;
                const float: s = l > 0.5 ? dd / (2.0 - hi - lo) : dd / (hi + lo);
                float: h = 0.0;
                if (hi == rr) then {
                    h = (gg - bb) / dd + (gg < bb ? 6.0 : 0.0);
                } else if (hi == gg) then {
                    h = (bb - rr) / dd + 2.0;
                } else then {
                    h = (rr - gg) / dd + 4.0;
                }
                return HSL(h * 60.0, s, l, alpha_unit());
            } end function to_hsl

            function to_hsv() const -> HSV {
                const float: rr = red_unit();
                const float: gg = green_unit();
                const float: bb = blue_unit();
                const float: hi = detail::max3(rr, gg, bb);
                const float: lo = detail::min3(rr, gg, bb);
                const float: dd = hi - lo;
                const float: s = hi == 0.0 ? 0.0 : dd / hi;
                if (dd == 0.0) then {
                    return HSV(0.0, s, hi, alpha_unit());
                }
                float: h = 0.0;
                if (hi == rr) then {
                    h = (gg - bb) / dd + (gg < bb ? 6.0 : 0.0);
                } else if (hi == gg) then {
                    h = (bb - rr) / dd + 2.0;
                } else then {
                    h = (rr - gg) / dd + 4.0;
                }
                return HSV(h * 60.0, s, hi, alpha_unit());
            } end function to_hsv

            function hue() const -> float {
                return to_hsl().hue;
            } end function hue

            function saturation() const -> float {
                return to_hsl().saturation;
            } end function saturation

            function lightness() const -> float {
                return to_hsl().lightness;
            } end function lightness

            function brightness() const -> float {
                return to_hsv().value;
            } end function brightness

            function luminance() const -> float {
                return 0.2126 * detail::to_linear(red_unit()) + 0.7152 * detail::to_linear(green_unit()) + 0.0722 * detail::to_linear(blue_unit());
            } end function luminance

            function contrast_ratio(const Color&: other) const -> float {
                const float: x = luminance() + 0.05;
                const float: y = other.luminance() + 0.05;
                return x > y ? x / y : y / x;
            } end function contrast_ratio

            function is_dark() const -> bool {
                return luminance() < 0.179;
            } end function is_dark

            function is_light() const -> bool {
                return !is_dark();
            } end function is_light

            function is_opaque() const -> bool {
                return a == 255;
            } end function is_opaque

            function is_transparent() const -> bool {
                return a == 0;
            } end function is_transparent

            function with_red(long int: v) const -> Color {
                return Color(v, g, b, a);
            } end function with_red

            function with_green(long int: v) const -> Color {
                return Color(r, v, b, a);
            } end function with_green

            function with_blue(long int: v) const -> Color {
                return Color(r, g, v, a);
            } end function with_blue

            function with_alpha(long int: v) const -> Color {
                return Color(r, g, b, v);
            } end function with_alpha

            function with_opacity(float: unit) const -> Color {
                return Color(r, g, b, detail::channel_of(unit));
            } end function with_opacity

            function lerp(const Color&: other, float: t) const -> Color {
                const float: k = detail::clamp_unit(t);
                return Color(static_cast<long int>(std::math::floor(static_cast<float>(r) + (static_cast<float>(other.r) - static_cast<float>(r)) * k + 0.5)),
                             static_cast<long int>(std::math::floor(static_cast<float>(g) + (static_cast<float>(other.g) - static_cast<float>(g)) * k + 0.5)),
                             static_cast<long int>(std::math::floor(static_cast<float>(b) + (static_cast<float>(other.b) - static_cast<float>(b)) * k + 0.5)),
                             static_cast<long int>(std::math::floor(static_cast<float>(a) + (static_cast<float>(other.a) - static_cast<float>(a)) * k + 0.5)));
            } end function lerp

            function mix(const Color&: other, float: t = 0.5) const -> Color {
                return lerp(other, t);
            } end function mix

            function lighten(float: amount) const -> Color {
                const HSL: c = to_hsl();
                return Color::from_hsl(c.hue, c.saturation, c.lightness + amount, c.alpha);
            } end function lighten

            function darken(float: amount) const -> Color {
                const HSL: c = to_hsl();
                return Color::from_hsl(c.hue, c.saturation, c.lightness - amount, c.alpha);
            } end function darken

            function saturate(float: amount) const -> Color {
                const HSL: c = to_hsl();
                return Color::from_hsl(c.hue, c.saturation + amount, c.lightness, c.alpha);
            } end function saturate

            function desaturate(float: amount) const -> Color {
                const HSL: c = to_hsl();
                return Color::from_hsl(c.hue, c.saturation - amount, c.lightness, c.alpha);
            } end function desaturate

            function rotate_hue(float: degrees) const -> Color {
                const HSL: c = to_hsl();
                return Color::from_hsl(c.hue + degrees, c.saturation, c.lightness, c.alpha);
            } end function rotate_hue

            function complement() const -> Color {
                return rotate_hue(180.0);
            } end function complement

            function grayscale() const -> Color {
                const long int: v = static_cast<long int>(std::math::floor(0.299 * static_cast<float>(r) + 0.587 * static_cast<float>(g) + 0.114 * static_cast<float>(b) + 0.5));
                return Color(v, v, v, a);
            } end function grayscale

            function inverted() const -> Color {
                return Color(255 - r, 255 - g, 255 - b, a);
            } end function inverted

            function blend_over(const Color&: background) const -> Color {
                const float: sa = alpha_unit();
                const float: da = background.alpha_unit();
                const float: oa = sa + da * (1.0 - sa);
                if (oa <= 0.0) then {
                    return Color(0, 0, 0, 0);
                }
                const float: rr = (red_unit() * sa + background.red_unit() * da * (1.0 - sa)) / oa;
                const float: gg = (green_unit() * sa + background.green_unit() * da * (1.0 - sa)) / oa;
                const float: bb = (blue_unit() * sa + background.blue_unit() * da * (1.0 - sa)) / oa;
                return Color::from_unit(rr, gg, bb, oa);
            } end function blend_over

            function premultiplied() const -> Color {
                return Color((static_cast<long int>(r) * a + 127) / 255, (static_cast<long int>(g) * a + 127) / 255, (static_cast<long int>(b) * a + 127) / 255, a);
            } end function premultiplied

            function distance(const Color&: other) const -> float {
                const float: dr = static_cast<float>(r - other.r);
                const float: dg = static_cast<float>(g - other.g);
                const float: db = static_cast<float>(b - other.b);
                return std::math::sqrt(dr * dr + dg * dg + db * db);
            } end function distance

            operator(==) function(const Color&: o) const -> bool {
                return r == o.r && g == o.g && b == o.b && a == o.a;
            }

            operator(!=) function(const Color&: o) const -> bool {
                return !(r == o.r && g == o.g && b == o.b && a == o.a);
            }

            operator(+) function(const Color&: o) const -> Color {
                return Color(r + o.r, g + o.g, b + o.b, a);
            }

            operator(-) function(const Color&: o) const -> Color {
                return Color(r - o.r, g - o.g, b - o.b, a);
            }

            operator(*) function(float: k) const -> Color {
                return Color::from_unit(red_unit() * k, green_unit() * k, blue_unit() * k, alpha_unit());
            }
        } end struct Color

        const Color: transparent = Color(0, 0, 0, 0);

        const Color: alice_blue = Color(240, 248, 255);
        const Color: antique_white = Color(250, 235, 215);
        const Color: aqua = Color(0, 255, 255);
