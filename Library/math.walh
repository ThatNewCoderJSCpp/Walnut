namespace std {
    namespace math {
        extern "C++" from "<walnut_math.hpp>" {
            class BigFloat as "fizmo::multiprecision::BigFloat" {
            public:
                constructor();
                constructor(long int: value);
                constructor(float: value) as "walnut_rt::math::big_from";
                constructor(long float: value) as "walnut_rt::math::big_from";
                constructor(long long float: value) as "walnut_rt::math::big_from";
                constructor(long double: value) as "walnut_rt::math::big_from";
                constructor(long long double: value) as "walnut_rt::math::big_from";
                constructor(const string&: digits) explicit as "walnut_rt::math::parse_big";
                function to_string() const -> string;
                function to_string(long int: digits) const -> string as "walnut_rt::math::big_to_string";
                function is_zero() const -> bool;
                function is_negative() const -> bool;
                function is_positive() const -> bool;
                function is_integer() const -> bool;
                function is_finite() const -> bool;
                function is_infinite() const -> bool;
                function is_nan() const -> bool;
                function sign() const -> int;
                function abs() const -> BigFloat;
                operator(-) function() const -> BigFloat;
                operator(+) function(const BigFloat&: other) const -> BigFloat;
                operator(-) function(const BigFloat&: other) const -> BigFloat;
                operator(*) function(const BigFloat&: other) const -> BigFloat;
                operator(/) function(const BigFloat&: other) const -> BigFloat;
                operator(==) function(const BigFloat&: other) const -> bool;
                operator(!=) function(const BigFloat&: other) const -> bool;
                operator(<) function(const BigFloat&: other) const -> bool;
                operator(>) function(const BigFloat&: other) const -> bool;
                operator(<=) function(const BigFloat&: other) const -> bool;
                operator(>=) function(const BigFloat&: other) const -> bool;
                operator(+=) function(const BigFloat&: other) -> BigFloat&;
                operator(-=) function(const BigFloat&: other) -> BigFloat&;
                operator(*=) function(const BigFloat&: other) -> BigFloat&;
                operator(/=) function(const BigFloat&: other) -> BigFloat&;
                operator(short short float) function() const explicit;
                operator(short float) function() const explicit;
                operator(float) function() const explicit;
                operator(long float) function() const explicit;
                operator(long long float) function() const explicit;
                operator(long double) function() const explicit;
                operator(long long double) function() const explicit;
            } end class BigFloat

            class BigComplex as "fizmo::multiprecision::BigComplex" {
            public:
                constructor();
                constructor(const BigFloat&: real);
                constructor(const BigFloat&: real, const BigFloat&: imaginary);
                constructor(long int: real) as "walnut_rt::math::big_complex_of";
                constructor(float: real) as "walnut_rt::math::big_complex_of";
                constructor(float: real, float: imaginary) as "walnut_rt::math::big_complex_of";
                static function i() -> BigComplex;
                static function polar(const BigFloat&: magnitude, const BigFloat&: angle) -> BigComplex as "walnut_rt::math::big_polar";
                function real() const -> BigFloat;
                function imaginary() const -> BigFloat;
                function magnitude() const -> BigFloat as "walnut_rt::math::big_magnitude";
                function argument() const -> BigFloat as "walnut_rt::math::big_argument";
                function conjugate() const -> BigComplex;
                function to_string() const -> string;
                function to_string(long int: digits) const -> string as "walnut_rt::math::big_complex_to_string";
                function is_zero() const -> bool;
                function is_real() const -> bool;
                function is_imaginary() const -> bool;
                function is_finite() const -> bool;
                operator(-) function() const -> BigComplex;
                operator(+) function(const BigComplex&: other) const -> BigComplex;
                operator(-) function(const BigComplex&: other) const -> BigComplex;
                operator(*) function(const BigComplex&: other) const -> BigComplex;
                operator(/) function(const BigComplex&: other) const -> BigComplex;
                operator(==) function(const BigComplex&: other) const -> bool;
                operator(!=) function(const BigComplex&: other) const -> bool;
                operator(+=) function(const BigComplex&: other) -> BigComplex&;
                operator(-=) function(const BigComplex&: other) -> BigComplex&;
                operator(*=) function(const BigComplex&: other) -> BigComplex&;
                operator(/=) function(const BigComplex&: other) -> BigComplex&;
            } end class BigComplex

            template <typename T>
            class Complex as "fizmo::Complex" {
            public:
                constructor();
                constructor(const T&: real);
                constructor(const T&: real, const T&: imaginary);
                static function i() -> Complex;
                static function polar(const T&: magnitude, const T&: angle) -> Complex;
                function real() const -> T;
                function imaginary() const -> T;
                function magnitude() const -> T;
                function magnitude_squared() const -> T;
                function argument() const -> T;
                function conjugate() const -> Complex;
                function reciprocal() const -> Complex;
                function to_string() const -> string;
                function is_zero() const -> bool;
                function is_real() const -> bool;
                function is_imaginary() const -> bool;
                function is_finite() const -> bool;
                operator(-) function() const -> Complex;
                operator(+) function(const Complex&: other) const -> Complex;
                operator(+) function(const T&: other) const -> Complex;
                operator(-) function(const Complex&: other) const -> Complex;
                operator(-) function(const T&: other) const -> Complex;
                operator(*) function(const Complex&: other) const -> Complex;
                operator(*) function(const T&: other) const -> Complex;
                operator(/) function(const Complex&: other) const -> Complex;
                operator(/) function(const T&: other) const -> Complex;
                operator(==) function(const Complex&: other) const -> bool;
                operator(!=) function(const Complex&: other) const -> bool;
                operator(+=) function(const Complex&: other) -> Complex&;
                operator(-=) function(const Complex&: other) -> Complex&;
                operator(*=) function(const Complex&: other) -> Complex&;
                operator(/=) function(const Complex&: other) -> Complex&;
            } end class Complex

        } end extern

        namespace detail {
            template <typename T>
            concept ComplexValue = requires (T: z) { z.imaginary(); z.conjugate(); }

            template <typename T>
            concept RealValue = std::traits::is_builtin_float<T> || std::traits::is_same<T, BigFloat>

            template <typename T>
            concept MathValue = RealValue<T> || ComplexValue<T>

