        function conj(const Complex<T>&: z) -> Complex<T> {
            return z.conjugate();
        } end function conj

        function conj(const BigComplex&: z) -> BigComplex {
            return z.conjugate();
        } end function conj

        template <typename T>
        function min(const T&: a, const T&: b) -> T {
            return b < a ? b : a;
        } end function min

        template <typename T>
        function max(const T&: a, const T&: b) -> T {
            return a < b ? b : a;
        } end function max

        template <typename T>
        function clamp(const T&: x, const T&: lo, const T&: hi) -> T {
            if (x < lo) then {
                return lo;
            }
            if (hi < x) then {
                return hi;
            }
            return x;
        } end function clamp

        template <typename T>
        requires std::traits::is_builtin_integer<T>
        function gcd(const T&: a, const T&: b) -> T {
            T: x = a < 0 ? -a : a;
            T: y = b < 0 ? -b : b;
            while (y != 0) {
                const T: r = x % y;
                x = y;
                y = r;
            }
            return x;
        } end function gcd

        template <typename T>
        requires std::traits::is_builtin_integer<T>
        function lcm(const T&: a, const T&: b) -> T {
            if (a == 0 || b == 0) then {
                return 0;
            }
            const T: g = gcd(a, b);
            const T: r = a / g * b;
            return r < 0 ? -r : r;
        } end function lcm

        template <typename T>
        requires std::traits::is_builtin_integer<T> || detail::RealValue<T>
        function sign(const T&: x) -> T {
            if (x < 0) then {
                return -1;
            }
            if (0 < x) then {
                return 1;
            }
            return x;
        } end function sign

        template <typename T>
        requires std::traits::is_builtin_integer<T>
        function hypot(const T&: x, const T&: y) -> float {
            const float: fx = x;
            const float: fy = y;
            return detail::Fn<float>::sqrt(fx * fx + fy * fy);
        } end function hypot

        template <typename T>
        requires detail::RealValue<T>
        function hypot(const T&: x, const T&: y) -> T {
            return detail::Fn<T>::sqrt(x * x + y * y);
        } end function hypot

        template <typename T>
        requires detail::MathValue<T>
        function lerp(const T&: a, const T&: b, const T&: t) -> T {
            return a + (b - a) * t;
        } end function lerp

        template <typename T>
        requires detail::RealValue<T>
        function radians(const T&: degrees) -> T {
            return degrees * detail::Fn<T>::pi_180();
        } end function radians

        template <typename T>
        requires detail::RealValue<T>
        function degrees(const T&: radians) -> T {
            return radians * detail::Fn<T>::inv_pi_180();
        } end function degrees

