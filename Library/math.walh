        function abs(const T&: x) -> T {
            return x < 0 ? -x : x;
        } end function abs

        template <typename T>
        requires detail::RealValue<T>
        function abs(const T&: x) -> T {
            return detail::Fn<T>::abs(x);
        } end function abs

        template <typename T>
        function abs(const Complex<T>&: z) -> T {
            return z.magnitude();
        } end function abs

        function abs(const BigComplex&: z) -> BigFloat {
            return z.magnitude();
        } end function abs

        template <typename T>
        function arg(const Complex<T>&: z) -> T {
            return z.argument();
        } end function arg

        function arg(const BigComplex&: z) -> BigFloat {
            return z.argument();
        } end function arg

