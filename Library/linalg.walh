import module.math
import module.collections

namespace std {
    namespace errors {
        class linalg_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what() const -> string {
                return message;
            } end function what
        } end class linalg_error
    } end namespace errors

    namespace linalg {
        namespace detail {
            template <typename T>
            function tolerance() -> T {
                if constexpr (std::traits::is_builtin_float<T>) then {
                    return std::traits::float_traits<T>::epsilon();
                } else then {
                    return std::math::pow(T(2), T(-std::math::precision()));
                }
            } end function tolerance

            template <typename T>
            function clamp_unit(const T&: value) -> T {
                if (value > T(1)) then {
                    return T(1);
                }
                if (value < T(-1)) then {
                    return T(-1);
                }
                return value;
            } end function clamp_unit

            template <typename T>
            function sign_of(const T&: value) -> T {
                return value < T(0) ? T(-1) : T(1);
            } end function sign_of

            template <typename T>
            function copy_sign(const T&: magnitude, const T&: sign) -> T {
                const T: m = std::math::abs(magnitude);
                return sign < T(0) ? -m : m;
            } end function copy_sign

            function fail(const string&: message) -> void {
                throw std::errors::linalg_error(message);
            } end function fail

            template <typename T>
            function pi() -> T {
                return std::math::detail::Fn<T>::pi();
            } end function pi
        } end namespace detail

        template <typename T>
        struct Vector2;

        template <typename T>
        struct Vector3;

        template <typename T>
        struct Vector4;

        template <typename T, int N>
        struct VectorN;

        template <typename T>
        class DynVector;

        template <typename T, int R, int C>
        struct Matrix;

        template <typename T>
        class DynMatrix;

        template <typename T>
        struct Vector2 {
            static_assert(std::traits::is_float<T>, "linalg vectors need a real float type, such as float or double, not an integer or other type");
            T: x = T(0);
            T: y = T(0);

            constructor() { }

            constructor(const T&: x_value, const T&: y_value) : x = x_value, y = y_value { }

            static function zero() -> Vector2 {
                return Vector2();
            } end function zero

            static function one() -> Vector2 {
                return Vector2(T(1), T(1));
            } end function one

            static function filled(const T&: value) -> Vector2 {
                return Vector2(value, value);
            } end function filled

            static function unit_x() -> Vector2 {
                return Vector2(T(1), T(0));
            } end function unit_x

            static function unit_y() -> Vector2 {
                return Vector2(T(0), T(1));
            } end function unit_y

            static function size() -> long int {
                return 2;
            } end function size

            operator([]) function(long int: index) -> T& {
                if (index == 0) then {
                    return x;
                }
                if (index == 1) then {
                    return y;
                }
                throw std::errors::linalg_error(static_cast<string>(`index ${index} is out of range for a Vector2`));
            }

            operator([]) function(long int: index) const -> const T& {
                if (index == 0) then {
                    return x;
                }
                if (index == 1) then {
                    return y;
                }
                throw std::errors::linalg_error(static_cast<string>(`index ${index} is out of range for a Vector2`));
            }

            function at(long int: index) -> T& {
                return (*this)[index];
            } end function at

            function at(long int: index) const -> const T& {
                return (*this)[index];
            } end function at

            operator(+) function(const Vector2&: o) const -> Vector2 {
                return Vector2(x + o.x, y + o.y);
            }

            operator(-) function(const Vector2&: o) const -> Vector2 {
                return Vector2(x - o.x, y - o.y);
            }

            operator(*) function(const Vector2&: o) const -> Vector2 {
                return Vector2(x * o.x, y * o.y);
            }

            operator(/) function(const Vector2&: o) const -> Vector2 {
                return Vector2(x / o.x, y / o.y);
            }

            operator(*) function(const T&: k) const -> Vector2 {
                return Vector2(x * k, y * k);
            }

            operator(/) function(const T&: k) const -> Vector2 {
                return Vector2(x / k, y / k);
            }

            operator(-) function() const -> Vector2 {
                return Vector2(-x, -y);
            }

            operator(+=) function(const Vector2&: o) -> Vector2& {
                x = x + o.x;
                y = y + o.y;
                return *this;
            }

            operator(-=) function(const Vector2&: o) -> Vector2& {
                x = x - o.x;
                y = y - o.y;
                return *this;
            }

            operator(*=) function(const Vector2&: o) -> Vector2& {
                x = x * o.x;
                y = y * o.y;
                return *this;
            }

            operator(/=) function(const Vector2&: o) -> Vector2& {
                x = x / o.x;
                y = y / o.y;
                return *this;
            }

            operator(*=) function(const T&: k) -> Vector2& {
                x = x * k;
                y = y * k;
                return *this;
            }

            operator(/=) function(const T&: k) -> Vector2& {
                x = x / k;
                y = y / k;
                return *this;
            }

            operator(==) function(const Vector2&: o) const -> bool {
                return x == o.x && y == o.y;
            }

            operator(!=) function(const Vector2&: o) const -> bool {
                return !(*this == o);
            }

            function dot(const Vector2&: o) const -> T {
                return x * o.x + y * o.y;
            } end function dot

            function length_squared() const -> T {
                return dot(*this);
            } end function length_squared

            function length() const -> T {
                return std::math::sqrt(dot(*this));
            } end function length

            function magnitude() const -> T {
                return length();
            } end function magnitude

            function normalized() const -> Vector2 {
                const T: len = length();
                if (len == T(0)) then {
                    return Vector2();
                }
                return *this / len;
            } end function normalized

            function normalize() -> Vector2& {
                *this = normalized();
                return *this;
            } end function normalize

            function is_normalized() const -> bool {
                return std::math::abs(length_squared() - T(1)) <= detail::tolerance<T>() * T(16);
            } end function is_normalized

            function is_zero() const -> bool {
                return x == T(0) && y == T(0);
            } end function is_zero

            function distance(const Vector2&: o) const -> T {
                return (*this - o).length();
            } end function distance

            function distance_squared(const Vector2&: o) const -> T {
                return (*this - o).length_squared();
            } end function distance_squared

            function lerp(const Vector2&: o, const T&: t) const -> Vector2 {
                return *this + (o - *this) * t;
            } end function lerp

            function angle_to(const Vector2&: o) const -> T {
                const T: denom = length() * o.length();
                if (denom == T(0)) then {
                    return T(0);
                }
                return std::math::acos(detail::clamp_unit(dot(o) / denom));
            } end function angle_to

            function project_onto(const Vector2&: o) const -> Vector2 {
                const T: d = o.length_squared();
                if (d == T(0)) then {
                    return Vector2();
                }
                return o * (dot(o) / d);
            } end function project_onto

            function reject_from(const Vector2&: o) const -> Vector2 {
                return *this - project_onto(o);
            } end function reject_from

            function reflect(const Vector2&: normal) const -> Vector2 {
                return *this - normal * (T(2) * dot(normal));
            } end function reflect

            function min(const Vector2&: o) const -> Vector2 {
                return Vector2(x < o.x ? x : o.x, y < o.y ? y : o.y);
            } end function min

            function max(const Vector2&: o) const -> Vector2 {
                return Vector2(x > o.x ? x : o.x, y > o.y ? y : o.y);
            } end function max

            function abs() const -> Vector2 {
                return Vector2(std::math::abs(x), std::math::abs(y));
            } end function abs

            function clamp(const Vector2&: lo, const Vector2&: hi) const -> Vector2 {
                return max(lo).min(hi);
            } end function clamp

            function sum() const -> T {
                return x + y;
            } end function sum

            function product() const -> T {
                return x * y;
            } end function product

            function min_component() const -> T {
                T: best = x;
                if (y < best) then {
                    best = y;
                }
                return best;
            } end function min_component

            function max_component() const -> T {
                T: best = x;
                if (y > best) then {
                    best = y;
                }
                return best;
            } end function max_component

            function approx_equal(const Vector2&: o, const T&: tolerance) const -> bool {
                return std::math::abs(x - o.x) <= tolerance && std::math::abs(y - o.y) <= tolerance;
            } end function approx_equal

            function approx_equal(const Vector2&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            function to_vector() const -> VectorN<T, 2> {
                VectorN<T, 2>: out;
                out[0] = x;
                out[1] = y;
                return out;
            } end function to_vector

            function to_dyn() const -> DynVector<T> {
                DynVector<T>: out(2);
                out[0] = x;
                out[1] = y;
                return out;
            } end function to_dyn

            function to_string() const -> string {
                return static_cast<string>(`(${std::core::to_string(x)}, ${std::core::to_string(y)})`);
            } end function to_string

            function cross(const Vector2&: o) const -> T {
                return x * o.y - y * o.x;
            } end function cross

            function perp_dot(const Vector2&: o) const -> T {
                return x * o.y - y * o.x;
            } end function perp_dot

            function perpendicular() const -> Vector2 {
                return Vector2(-y, x);
            } end function perpendicular

            function angle() const -> T {
                return std::math::atan2(y, x);
            } end function angle

            function rotated(const T&: radians) const -> Vector2 {
                const T: c = std::math::cos(radians);
                const T: s = std::math::sin(radians);
                return Vector2(x * c - y * s, x * s + y * c);
            } end function rotated

            static function from_angle(const T&: radians) -> Vector2 {
                return Vector2(std::math::cos(radians), std::math::sin(radians));
            } end function from_angle

            function extend(const T&: z_value) const -> Vector3<T> {
                return Vector3<T>(x, y, z_value);
            } end function extend
        } end struct Vector2

        template <typename T>
        operator(*) function(const T&: k, const Vector2<T>&: v) -> Vector2<T> {
            return v * k;
        }

        template <typename T>
        struct Vector3 {
            static_assert(std::traits::is_float<T>, "linalg vectors need a real float type, such as float or double, not an integer or other type");
            T: x = T(0);
            T: y = T(0);
            T: z = T(0);

            constructor() { }

            constructor(const T&: x_value, const T&: y_value, const T&: z_value) : x = x_value, y = y_value, z = z_value { }

            static function zero() -> Vector3 {
                return Vector3();
            } end function zero

            static function one() -> Vector3 {
                return Vector3(T(1), T(1), T(1));
            } end function one

            static function filled(const T&: value) -> Vector3 {
                return Vector3(value, value, value);
            } end function filled

            static function unit_x() -> Vector3 {
                return Vector3(T(1), T(0), T(0));
            } end function unit_x

            static function unit_y() -> Vector3 {
                return Vector3(T(0), T(1), T(0));
            } end function unit_y

            static function unit_z() -> Vector3 {
                return Vector3(T(0), T(0), T(1));
            } end function unit_z

            static function size() -> long int {
                return 3;
            } end function size

            operator([]) function(long int: index) -> T& {
                if (index == 0) then {
                    return x;
                }
                if (index == 1) then {
                    return y;
                }
                if (index == 2) then {
                    return z;
                }
                throw std::errors::linalg_error(static_cast<string>(`index ${index} is out of range for a Vector3`));
            }

            operator([]) function(long int: index) const -> const T& {
                if (index == 0) then {
                    return x;
                }
                if (index == 1) then {
                    return y;
                }
                if (index == 2) then {
                    return z;
                }
                throw std::errors::linalg_error(static_cast<string>(`index ${index} is out of range for a Vector3`));
            }

            function at(long int: index) -> T& {
                return (*this)[index];
            } end function at

            function at(long int: index) const -> const T& {
                return (*this)[index];
            } end function at

            operator(+) function(const Vector3&: o) const -> Vector3 {
                return Vector3(x + o.x, y + o.y, z + o.z);
            }

            operator(-) function(const Vector3&: o) const -> Vector3 {
                return Vector3(x - o.x, y - o.y, z - o.z);
            }

            operator(*) function(const Vector3&: o) const -> Vector3 {
                return Vector3(x * o.x, y * o.y, z * o.z);
            }

            operator(/) function(const Vector3&: o) const -> Vector3 {
                return Vector3(x / o.x, y / o.y, z / o.z);
            }

            operator(*) function(const T&: k) const -> Vector3 {
                return Vector3(x * k, y * k, z * k);
            }

            operator(/) function(const T&: k) const -> Vector3 {
                return Vector3(x / k, y / k, z / k);
            }

            operator(-) function() const -> Vector3 {
                return Vector3(-x, -y, -z);
            }

            operator(+=) function(const Vector3&: o) -> Vector3& {
                x = x + o.x;
                y = y + o.y;
                z = z + o.z;
                return *this;
            }

            operator(-=) function(const Vector3&: o) -> Vector3& {
                x = x - o.x;
                y = y - o.y;
                z = z - o.z;
                return *this;
            }

            operator(*=) function(const Vector3&: o) -> Vector3& {
                x = x * o.x;
                y = y * o.y;
                z = z * o.z;
                return *this;
            }

            operator(/=) function(const Vector3&: o) -> Vector3& {
                x = x / o.x;
                y = y / o.y;
                z = z / o.z;
                return *this;
            }

            operator(*=) function(const T&: k) -> Vector3& {
                x = x * k;
                y = y * k;
                z = z * k;
                return *this;
            }

            operator(/=) function(const T&: k) -> Vector3& {
                x = x / k;
                y = y / k;
                z = z / k;
                return *this;
            }

            operator(==) function(const Vector3&: o) const -> bool {
                return x == o.x && y == o.y && z == o.z;
            }

            operator(!=) function(const Vector3&: o) const -> bool {
                return !(*this == o);
            }

            function dot(const Vector3&: o) const -> T {
                return x * o.x + y * o.y + z * o.z;
            } end function dot

            function length_squared() const -> T {
                return dot(*this);
            } end function length_squared

            function length() const -> T {
                return std::math::sqrt(dot(*this));
            } end function length

            function magnitude() const -> T {
                return length();
            } end function magnitude

            function normalized() const -> Vector3 {
                const T: len = length();
                if (len == T(0)) then {
                    return Vector3();
                }
                return *this / len;
            } end function normalized

            function normalize() -> Vector3& {
                *this = normalized();
                return *this;
            } end function normalize

            function is_normalized() const -> bool {
                return std::math::abs(length_squared() - T(1)) <= detail::tolerance<T>() * T(16);
            } end function is_normalized

            function is_zero() const -> bool {
                return x == T(0) && y == T(0) && z == T(0);
            } end function is_zero

            function distance(const Vector3&: o) const -> T {
                return (*this - o).length();
            } end function distance

            function distance_squared(const Vector3&: o) const -> T {
                return (*this - o).length_squared();
            } end function distance_squared

            function lerp(const Vector3&: o, const T&: t) const -> Vector3 {
                return *this + (o - *this) * t;
            } end function lerp

            function angle_to(const Vector3&: o) const -> T {
                const T: denom = length() * o.length();
                if (denom == T(0)) then {
                    return T(0);
                }
                return std::math::acos(detail::clamp_unit(dot(o) / denom));
            } end function angle_to

            function project_onto(const Vector3&: o) const -> Vector3 {
                const T: d = o.length_squared();
                if (d == T(0)) then {
                    return Vector3();
                }
                return o * (dot(o) / d);
            } end function project_onto

            function reject_from(const Vector3&: o) const -> Vector3 {
                return *this - project_onto(o);
            } end function reject_from

            function reflect(const Vector3&: normal) const -> Vector3 {
                return *this - normal * (T(2) * dot(normal));
            } end function reflect

            function min(const Vector3&: o) const -> Vector3 {
                return Vector3(x < o.x ? x : o.x, y < o.y ? y : o.y, z < o.z ? z : o.z);
            } end function min

            function max(const Vector3&: o) const -> Vector3 {
                return Vector3(x > o.x ? x : o.x, y > o.y ? y : o.y, z > o.z ? z : o.z);
            } end function max

            function abs() const -> Vector3 {
                return Vector3(std::math::abs(x), std::math::abs(y), std::math::abs(z));
            } end function abs

            function clamp(const Vector3&: lo, const Vector3&: hi) const -> Vector3 {
                return max(lo).min(hi);
            } end function clamp

            function sum() const -> T {
                return x + y + z;
            } end function sum

            function product() const -> T {
                return x * y * z;
            } end function product

            function min_component() const -> T {
                T: best = x;
                if (y < best) then {
                    best = y;
                }
                if (z < best) then {
                    best = z;
                }
                return best;
            } end function min_component

            function max_component() const -> T {
                T: best = x;
                if (y > best) then {
                    best = y;
                }
                if (z > best) then {
                    best = z;
                }
                return best;
            } end function max_component

            function approx_equal(const Vector3&: o, const T&: tolerance) const -> bool {
                return std::math::abs(x - o.x) <= tolerance && std::math::abs(y - o.y) <= tolerance && std::math::abs(z - o.z) <= tolerance;
            } end function approx_equal

            function approx_equal(const Vector3&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            function to_vector() const -> VectorN<T, 3> {
                VectorN<T, 3>: out;
                out[0] = x;
                out[1] = y;
                out[2] = z;
                return out;
            } end function to_vector

            function to_dyn() const -> DynVector<T> {
                DynVector<T>: out(3);
                out[0] = x;
                out[1] = y;
                out[2] = z;
                return out;
            } end function to_dyn

            function to_string() const -> string {
                return static_cast<string>(`(${std::core::to_string(x)}, ${std::core::to_string(y)}, ${std::core::to_string(z)})`);
            } end function to_string

            function cross(const Vector3&: o) const -> Vector3 {
                return Vector3(y * o.z - z * o.y, z * o.x - x * o.z, x * o.y - y * o.x);
            } end function cross

            function triple(const Vector3&: b, const Vector3&: c) const -> T {
                return dot(b.cross(c));
            } end function triple

            function xy() const -> Vector2<T> {
                return Vector2<T>(x, y);
            } end function xy

            function extend(const T&: w_value) const -> Vector4<T> {
                return Vector4<T>(x, y, z, w_value);
            } end function extend

            function rotated(const Vector3&: axis, const T&: radians) const -> Vector3 {
                const Vector3: k = axis.normalized();
                const T: c = std::math::cos(radians);
                const T: s = std::math::sin(radians);
                return *this * c + k.cross(*this) * s + k * (k.dot(*this) * (T(1) - c));
            } end function rotated

            function any_perpendicular() const -> Vector3 {
                const Vector3: other = std::math::abs(x) < std::math::abs(z) ? Vector3::unit_x() : Vector3::unit_z();
                return cross(other).normalized();
            } end function any_perpendicular
        } end struct Vector3

        template <typename T>
        operator(*) function(const T&: k, const Vector3<T>&: v) -> Vector3<T> {
            return v * k;
        }

        template <typename T>
        struct Vector4 {
            static_assert(std::traits::is_float<T>, "linalg vectors need a real float type, such as float or double, not an integer or other type");
            T: x = T(0);
            T: y = T(0);
            T: z = T(0);
            T: w = T(0);

            constructor() { }

            constructor(const T&: x_value, const T&: y_value, const T&: z_value, const T&: w_value) : x = x_value, y = y_value, z = z_value, w = w_value { }

            static function zero() -> Vector4 {
                return Vector4();
            } end function zero

            static function one() -> Vector4 {
                return Vector4(T(1), T(1), T(1), T(1));
            } end function one

            static function filled(const T&: value) -> Vector4 {
                return Vector4(value, value, value, value);
            } end function filled

            static function unit_x() -> Vector4 {
                return Vector4(T(1), T(0), T(0), T(0));
            } end function unit_x

            static function unit_y() -> Vector4 {
                return Vector4(T(0), T(1), T(0), T(0));
            } end function unit_y

            static function unit_z() -> Vector4 {
                return Vector4(T(0), T(0), T(1), T(0));
            } end function unit_z

            static function unit_w() -> Vector4 {
                return Vector4(T(0), T(0), T(0), T(1));
            } end function unit_w

            static function size() -> long int {
                return 4;
            } end function size

            operator([]) function(long int: index) -> T& {
                if (index == 0) then {
                    return x;
                }
                if (index == 1) then {
                    return y;
                }
                if (index == 2) then {
                    return z;
                }
                if (index == 3) then {
                    return w;
                }
                throw std::errors::linalg_error(static_cast<string>(`index ${index} is out of range for a Vector4`));
            }

            operator([]) function(long int: index) const -> const T& {
                if (index == 0) then {
                    return x;
                }
                if (index == 1) then {
                    return y;
                }
                if (index == 2) then {
                    return z;
                }
                if (index == 3) then {
                    return w;
                }
                throw std::errors::linalg_error(static_cast<string>(`index ${index} is out of range for a Vector4`));
            }

            function at(long int: index) -> T& {
                return (*this)[index];
            } end function at

            function at(long int: index) const -> const T& {
                return (*this)[index];
            } end function at

            operator(+) function(const Vector4&: o) const -> Vector4 {
                return Vector4(x + o.x, y + o.y, z + o.z, w + o.w);
            }

            operator(-) function(const Vector4&: o) const -> Vector4 {
                return Vector4(x - o.x, y - o.y, z - o.z, w - o.w);
            }

            operator(*) function(const Vector4&: o) const -> Vector4 {
                return Vector4(x * o.x, y * o.y, z * o.z, w * o.w);
            }

            operator(/) function(const Vector4&: o) const -> Vector4 {
                return Vector4(x / o.x, y / o.y, z / o.z, w / o.w);
            }

            operator(*) function(const T&: k) const -> Vector4 {
                return Vector4(x * k, y * k, z * k, w * k);
            }

            operator(/) function(const T&: k) const -> Vector4 {
                return Vector4(x / k, y / k, z / k, w / k);
            }

            operator(-) function() const -> Vector4 {
                return Vector4(-x, -y, -z, -w);
            }

            operator(+=) function(const Vector4&: o) -> Vector4& {
                x = x + o.x;
                y = y + o.y;
                z = z + o.z;
                w = w + o.w;
                return *this;
            }

            operator(-=) function(const Vector4&: o) -> Vector4& {
                x = x - o.x;
                y = y - o.y;
                z = z - o.z;
                w = w - o.w;
                return *this;
            }

            operator(*=) function(const Vector4&: o) -> Vector4& {
                x = x * o.x;
                y = y * o.y;
                z = z * o.z;
                w = w * o.w;
                return *this;
            }

            operator(/=) function(const Vector4&: o) -> Vector4& {
                x = x / o.x;
                y = y / o.y;
                z = z / o.z;
                w = w / o.w;
                return *this;
            }

            operator(*=) function(const T&: k) -> Vector4& {
                x = x * k;
                y = y * k;
                z = z * k;
                w = w * k;
                return *this;
            }

            operator(/=) function(const T&: k) -> Vector4& {
                x = x / k;
                y = y / k;
                z = z / k;
                w = w / k;
                return *this;
            }

            operator(==) function(const Vector4&: o) const -> bool {
                return x == o.x && y == o.y && z == o.z && w == o.w;
            }

            operator(!=) function(const Vector4&: o) const -> bool {
                return !(*this == o);
            }

            function dot(const Vector4&: o) const -> T {
                return x * o.x + y * o.y + z * o.z + w * o.w;
            } end function dot

            function length_squared() const -> T {
                return dot(*this);
            } end function length_squared

            function length() const -> T {
                return std::math::sqrt(dot(*this));
            } end function length

            function magnitude() const -> T {
                return length();
            } end function magnitude

            function normalized() const -> Vector4 {
                const T: len = length();
                if (len == T(0)) then {
                    return Vector4();
                }
                return *this / len;
            } end function normalized

            function normalize() -> Vector4& {
                *this = normalized();
                return *this;
            } end function normalize

            function is_normalized() const -> bool {
                return std::math::abs(length_squared() - T(1)) <= detail::tolerance<T>() * T(16);
            } end function is_normalized

            function is_zero() const -> bool {
                return x == T(0) && y == T(0) && z == T(0) && w == T(0);
            } end function is_zero

            function distance(const Vector4&: o) const -> T {
                return (*this - o).length();
            } end function distance

            function distance_squared(const Vector4&: o) const -> T {
                return (*this - o).length_squared();
            } end function distance_squared

            function lerp(const Vector4&: o, const T&: t) const -> Vector4 {
                return *this + (o - *this) * t;
            } end function lerp

            function angle_to(const Vector4&: o) const -> T {
                const T: denom = length() * o.length();
                if (denom == T(0)) then {
                    return T(0);
                }
                return std::math::acos(detail::clamp_unit(dot(o) / denom));
            } end function angle_to

            function project_onto(const Vector4&: o) const -> Vector4 {
                const T: d = o.length_squared();
                if (d == T(0)) then {
                    return Vector4();
                }
                return o * (dot(o) / d);
            } end function project_onto

            function reject_from(const Vector4&: o) const -> Vector4 {
                return *this - project_onto(o);
            } end function reject_from

            function reflect(const Vector4&: normal) const -> Vector4 {
                return *this - normal * (T(2) * dot(normal));
            } end function reflect

            function min(const Vector4&: o) const -> Vector4 {
                return Vector4(x < o.x ? x : o.x, y < o.y ? y : o.y, z < o.z ? z : o.z, w < o.w ? w : o.w);
            } end function min

            function max(const Vector4&: o) const -> Vector4 {
                return Vector4(x > o.x ? x : o.x, y > o.y ? y : o.y, z > o.z ? z : o.z, w > o.w ? w : o.w);
            } end function max

            function abs() const -> Vector4 {
                return Vector4(std::math::abs(x), std::math::abs(y), std::math::abs(z), std::math::abs(w));
            } end function abs

            function clamp(const Vector4&: lo, const Vector4&: hi) const -> Vector4 {
                return max(lo).min(hi);
            } end function clamp

            function sum() const -> T {
                return x + y + z + w;
            } end function sum

            function product() const -> T {
                return x * y * z * w;
            } end function product

            function min_component() const -> T {
                T: best = x;
                if (y < best) then {
                    best = y;
                }
                if (z < best) then {
                    best = z;
                }
                if (w < best) then {
                    best = w;
                }
                return best;
            } end function min_component

            function max_component() const -> T {
                T: best = x;
                if (y > best) then {
                    best = y;
                }
                if (z > best) then {
                    best = z;
                }
                if (w > best) then {
                    best = w;
                }
                return best;
            } end function max_component

            function approx_equal(const Vector4&: o, const T&: tolerance) const -> bool {
                return std::math::abs(x - o.x) <= tolerance && std::math::abs(y - o.y) <= tolerance && std::math::abs(z - o.z) <= tolerance && std::math::abs(w - o.w) <= tolerance;
            } end function approx_equal

            function approx_equal(const Vector4&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            function to_vector() const -> VectorN<T, 4> {
                VectorN<T, 4>: out;
                out[0] = x;
                out[1] = y;
                out[2] = z;
                out[3] = w;
                return out;
            } end function to_vector

            function to_dyn() const -> DynVector<T> {
                DynVector<T>: out(4);
                out[0] = x;
                out[1] = y;
                out[2] = z;
                out[3] = w;
                return out;
            } end function to_dyn

            function to_string() const -> string {
                return static_cast<string>(`(${std::core::to_string(x)}, ${std::core::to_string(y)}, ${std::core::to_string(z)}, ${std::core::to_string(w)})`);
            } end function to_string

            function xyz() const -> Vector3<T> {
                return Vector3<T>(x, y, z);
            } end function xyz

            function xy() const -> Vector2<T> {
                return Vector2<T>(x, y);
            } end function xy

            function project() const -> Vector3<T> {
                if (w == T(0)) then {
                    return Vector3<T>(x, y, z);
                }
                return Vector3<T>(x / w, y / w, z / w);
            } end function project
        } end struct Vector4

        template <typename T>
        operator(*) function(const T&: k, const Vector4<T>&: v) -> Vector4<T> {
            return v * k;
        }


        template <typename T, int N>
        struct VectorN {
            static_assert(std::traits::is_float<T>, "linalg vectors need a real float type, such as float or double, not an integer or other type");
            static_assert(N > 0, "a VectorN needs at least one component");
            array[N] T: data;

            constructor() {
                for (long int: i = 0; i < N; i++) {
                    data[i] = T(0);
                }
            }

            constructor(const array[N] T&: values) : data = values { }

            template <typename... Ts>
            constructor(Ts...: values) {
                static_assert(countof(values) == N, "a VectorN<T, N> is made from exactly N values");
                array[N] T: given = {T(values)...};
                data = given;
            }

            static function zero() -> VectorN {
                return VectorN();
            } end function zero

            static function filled(const T&: value) -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = value;
                }
                return out;
            } end function filled

            static function one() -> VectorN {
                return filled(T(1));
            } end function one

            static function unit(long int: axis) -> VectorN {
                VectorN: out;
                out[axis] = T(1);
                return out;
            } end function unit

            static function size() -> long int {
                return N;
            } end function size

            operator([]) function(long int: index) -> T& {
                if (index < 0 || index >= N) then {
                    detail::fail(static_cast<string>(`index ${index} is out of range for a VectorN of size ${N}`));
                }
                return data[index];
            }

            operator([]) function(long int: index) const -> const T& {
                if (index < 0 || index >= N) then {
                    detail::fail(static_cast<string>(`index ${index} is out of range for a VectorN of size ${N}`));
                }
                return data[index];
            }

            function at(long int: index) -> T& {
                return (*this)[index];
            } end function at

            function at(long int: index) const -> const T& {
                return (*this)[index];
            } end function at

            operator(+) function(const VectorN&: o) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] + o.data[i];
                }
                return out;
            }

            operator(-) function(const VectorN&: o) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] - o.data[i];
                }
                return out;
            }

            operator(*) function(const VectorN&: o) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] * o.data[i];
                }
                return out;
            }

            operator(/) function(const VectorN&: o) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] / o.data[i];
                }
                return out;
            }

            operator(*) function(const T&: k) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] * k;
                }
                return out;
            }

            operator(/) function(const T&: k) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] / k;
                }
                return out;
            }

            operator(-) function() const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = -data[i];
                }
                return out;
            }

            operator(+=) function(const VectorN&: o) -> VectorN& {
                for (long int: i = 0; i < N; i++) {
                    data[i] = data[i] + o.data[i];
                }
                return *this;
            }

            operator(-=) function(const VectorN&: o) -> VectorN& {
                for (long int: i = 0; i < N; i++) {
                    data[i] = data[i] - o.data[i];
                }
                return *this;
            }

            operator(*=) function(const VectorN&: o) -> VectorN& {
                for (long int: i = 0; i < N; i++) {
                    data[i] = data[i] * o.data[i];
                }
                return *this;
            }

            operator(/=) function(const VectorN&: o) -> VectorN& {
                for (long int: i = 0; i < N; i++) {
                    data[i] = data[i] / o.data[i];
                }
                return *this;
            }

            operator(*=) function(const T&: k) -> VectorN& {
                for (long int: i = 0; i < N; i++) {
                    data[i] = data[i] * k;
                }
                return *this;
            }

            operator(/=) function(const T&: k) -> VectorN& {
                for (long int: i = 0; i < N; i++) {
                    data[i] = data[i] / k;
                }
                return *this;
            }

            operator(==) function(const VectorN&: o) const -> bool {
                for (long int: i = 0; i < N; i++) {
                    if (data[i] != o.data[i]) then {
                        return false;
                    }
                }
                return true;
            }

            operator(!=) function(const VectorN&: o) const -> bool {
                return !(*this == o);
            }

            function dot(const VectorN&: o) const -> T {
                T: total = T(0);
                for (long int: i = 0; i < N; i++) {
                    total += data[i] * o.data[i];
                }
                return total;
            } end function dot

            function length_squared() const -> T {
                return dot(*this);
            } end function length_squared

            function length() const -> T {
                return std::math::sqrt(dot(*this));
            } end function length

            function magnitude() const -> T {
                return length();
            } end function magnitude

            function norm() const -> T {
                return length();
            } end function norm

            function norm_1() const -> T {
                T: total = T(0);
                for (long int: i = 0; i < N; i++) {
                    total += std::math::abs(data[i]);
                }
                return total;
            } end function norm_1

            function norm_inf() const -> T {
                T: best = T(0);
                for (long int: i = 0; i < N; i++) {
                    if (std::math::abs(data[i]) > best) then {
                        best = std::math::abs(data[i]);
                    }
                }
                return best;
            } end function norm_inf

            function norm_p(const T&: p) const -> T {
                T: total = T(0);
                for (long int: i = 0; i < N; i++) {
                    total += std::math::pow(std::math::abs(data[i]), p);
                }
                return std::math::pow(total, T(1) / p);
            } end function norm_p

            function normalized() const -> VectorN {
                const T: len = length();
                if (len == T(0)) then {
                    return *this;
                }
                return *this / len;
            } end function normalized

            function normalize() -> VectorN& {
                *this = normalized();
                return *this;
            } end function normalize

            function is_normalized() const -> bool {
                return std::math::abs(length_squared() - T(1)) <= detail::tolerance<T>() * T(16);
            } end function is_normalized

            function is_zero() const -> bool {
                for (long int: i = 0; i < N; i++) {
                    if (data[i] != T(0)) then {
                        return false;
                    }
                }
                return true;
            } end function is_zero

            function distance(const VectorN&: o) const -> T {
                return (*this - o).length();
            } end function distance

            function distance_squared(const VectorN&: o) const -> T {
                return (*this - o).length_squared();
            } end function distance_squared

            function lerp(const VectorN&: o, const T&: t) const -> VectorN {
                return *this + (o - *this) * t;
            } end function lerp

            function angle_to(const VectorN&: o) const -> T {
                const T: denom = length() * o.length();
                if (denom == T(0)) then {
                    return T(0);
                }
                return std::math::acos(detail::clamp_unit(dot(o) / denom));
            } end function angle_to

            function project_onto(const VectorN&: o) const -> VectorN {
                const T: d = o.length_squared();
                if (d == T(0)) then {
                    return o * T(0);
                }
                return o * (dot(o) / d);
            } end function project_onto

            function reject_from(const VectorN&: o) const -> VectorN {
                return *this - project_onto(o);
            } end function reject_from

            function reflect(const VectorN&: normal) const -> VectorN {
                return *this - normal * (T(2) * dot(normal));
            } end function reflect

            function min(const VectorN&: o) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] < o.data[i] ? data[i] : o.data[i];
                }
                return out;
            } end function min

            function max(const VectorN&: o) const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = data[i] > o.data[i] ? data[i] : o.data[i];
                }
                return out;
            } end function max

            function abs() const -> VectorN {
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = std::math::abs(data[i]);
                }
                return out;
            } end function abs

            function clamp(const VectorN&: lo, const VectorN&: hi) const -> VectorN {
                return max(lo).min(hi);
            } end function clamp

            function sum() const -> T {
                T: total = T(0);
                for (long int: i = 0; i < N; i++) {
                    total += data[i];
                }
                return total;
            } end function sum

            function product() const -> T {
                T: total = T(1);
                for (long int: i = 0; i < N; i++) {
                    total *= data[i];
                }
                return total;
            } end function product

            function mean() const -> T {
                return sum() / T(N);
            } end function mean

            function min_component() const -> T {
                T: best = data[0];
                for (long int: i = 0; i < N; i++) {
                    if (data[i] < best) then {
                        best = data[i];
                    }
                }
                return best;
            } end function min_component

            function max_component() const -> T {
                T: best = data[0];
                for (long int: i = 0; i < N; i++) {
                    if (data[i] > best) then {
                        best = data[i];
                    }
                }
                return best;
            } end function max_component

            function argmin() const -> long int {
                long int: best = 0;
                for (long int: i = 0; i < N; i++) {
                    if (data[i] < data[best]) then {
                        best = i;
                    }
                }
                return best;
            } end function argmin

            function argmax() const -> long int {
                long int: best = 0;
                for (long int: i = 0; i < N; i++) {
                    if (data[i] > data[best]) then {
                        best = i;
                    }
                }
                return best;
            } end function argmax

            function approx_equal(const VectorN&: o, const T&: tolerance) const -> bool {
                for (long int: i = 0; i < N; i++) {
                    if (std::math::abs(data[i] - o.data[i]) > tolerance) then {
                        return false;
                    }
                }
                return true;
            } end function approx_equal

            function approx_equal(const VectorN&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            function to_dyn() const -> DynVector<T> {
                DynVector<T>: out(N);
                for (long int: i = 0; i < N; i++) {
                    out[i] = data[i];
                }
                return out;
            } end function to_dyn

            static function from_dyn(const DynVector<T>&: v) -> VectorN {
                if (v.size() != N) then {
                    detail::fail(static_cast<string>(`can't make a VectorN of size ${N} from a DynVector of size ${v.size()}`));
                }
                VectorN: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = v[i];
                }
                return out;
            } end function from_dyn

            function outer(const VectorN&: o) const -> Matrix<T, N, N> {
                Matrix<T, N, N>: out;
                for (long int: i = 0; i < N; i++) {
                    for (long int: j = 0; j < N; j++) {
                        out(i, j) = data[i] * o.data[j];
                    }
                }
                return out;
            } end function outer

            function cross(const VectorN&: o) const -> VectorN {
                static_assert(N == 3, "cross() needs 3 components");
                VectorN: out;
                out.data[0] = data[1] * o.data[2] - data[2] * o.data[1];
                out.data[1] = data[2] * o.data[0] - data[0] * o.data[2];
                out.data[2] = data[0] * o.data[1] - data[1] * o.data[0];
                return out;
            } end function cross

            function begin() -> T* {
                return &data[0];
            } end function begin

            function end() -> T* {
                return &data[0] + N;
            } end function end

            function begin() const -> const T* {
                return &data[0];
            } end function begin

            function end() const -> const T* {
                return &data[0] + N;
            } end function end

            function to_string() const -> string {
                string: out = "(";
                for (long int: i = 0; i < N; i++) {
                    if (i > 0) then {
                        out += ", ";
                    }
                    out += std::core::to_string(data[i]);
                }
                out += ")";
                return out;
            } end function to_string
        } end struct VectorN

        template <typename T, int N>
        operator(*) function(const T&: k, const VectorN<T, N>&: v) -> VectorN<T, N> {
            return v * k;
        }

        template <typename T>
        class DynVector {
            std::collections::Vector<T>: items;

            function check(long int: index) const -> void {
                if (index < 0 || index >= items.size()) then {
                    detail::fail(static_cast<string>(`index ${index} is out of range for a DynVector of size ${items.size()}`));
                }
            } end function check

            function require_same_size(const DynVector&: o, const string&: what) const -> void {
                if (o.size() != size()) then {
                    detail::fail(static_cast<string>(`${what} needs vectors of the same size, not ${size()} and ${o.size()}`));
                }
            } end function require_same_size

        public:
            static_assert(std::traits::is_float<T>, "linalg vectors need a real float type, such as float or double, not an integer or other type");

            constructor() { }

            constructor(long int: count) {
                if (count < 0) then {
                    detail::fail("a DynVector can't have a negative size");
                }
                items.resize(count, T(0));
            }

            constructor(long int: count, const T&: value) {
                if (count < 0) then {
                    detail::fail("a DynVector can't have a negative size");
                }
                items.resize(count, value);
            }

            constructor(const std::collections::Vector<T>&: values) : items = values { }

            static function zero(long int: count) -> DynVector {
                return DynVector(count);
            } end function zero

            static function filled(long int: count, const T&: value) -> DynVector {
                return DynVector(count, value);
            } end function filled

            static function one(long int: count) -> DynVector {
                return DynVector(count, T(1));
            } end function one

            static function unit(long int: count, long int: axis) -> DynVector {
                DynVector: out(count);
                out[axis] = T(1);
                return out;
            } end function unit

            static function of(const std::collections::Vector<T>&: values) -> DynVector {
                return DynVector(values);
            } end function of

            function size() const -> long int {
                return items.size();
            } end function size

            function empty() const -> bool {
                return items.empty();
            } end function empty

            operator([]) function(long int: index) -> T& {
                check(index);
                return items[index];
            }

            operator([]) function(long int: index) const -> const T& {
                check(index);
                return items[index];
            }

            function push_back(const T&: value) -> void {
                items.push_back(value);
            } end function push_back

            function resize(long int: count) -> void {
                items.resize(count, T(0));
            } end function resize

            function values() const -> const std::collections::Vector<T>& {
                return items;
            } end function values

            function to_collection() const -> std::collections::Vector<T> {
                return items;
            } end function to_collection

            function at(long int: index) -> T& {
                return (*this)[index];
            } end function at

            function at(long int: index) const -> const T& {
                return (*this)[index];
            } end function at

            operator(+) function(const DynVector&: o) const -> DynVector {
                require_same_size(o, "'+'");
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] + o.items[i];
                }
                return out;
            }

            operator(-) function(const DynVector&: o) const -> DynVector {
                require_same_size(o, "'-'");
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] - o.items[i];
                }
                return out;
            }

            operator(*) function(const DynVector&: o) const -> DynVector {
                require_same_size(o, "'*'");
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] * o.items[i];
                }
                return out;
            }

            operator(/) function(const DynVector&: o) const -> DynVector {
                require_same_size(o, "'/'");
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] / o.items[i];
                }
                return out;
            }

            operator(*) function(const T&: k) const -> DynVector {
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] * k;
                }
                return out;
            }

            operator(/) function(const T&: k) const -> DynVector {
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] / k;
                }
                return out;
            }

            operator(-) function() const -> DynVector {
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = -items[i];
                }
                return out;
            }

            operator(+=) function(const DynVector&: o) -> DynVector& {
                require_same_size(o, "'+='");
                for (long int: i = 0; i < size(); i++) {
                    items[i] = items[i] + o.items[i];
                }
                return *this;
            }

            operator(-=) function(const DynVector&: o) -> DynVector& {
                require_same_size(o, "'-='");
                for (long int: i = 0; i < size(); i++) {
                    items[i] = items[i] - o.items[i];
                }
                return *this;
            }

            operator(*=) function(const DynVector&: o) -> DynVector& {
                require_same_size(o, "'*='");
                for (long int: i = 0; i < size(); i++) {
                    items[i] = items[i] * o.items[i];
                }
                return *this;
            }

            operator(/=) function(const DynVector&: o) -> DynVector& {
                require_same_size(o, "'/='");
                for (long int: i = 0; i < size(); i++) {
                    items[i] = items[i] / o.items[i];
                }
                return *this;
            }

            operator(*=) function(const T&: k) -> DynVector& {
                for (long int: i = 0; i < size(); i++) {
                    items[i] = items[i] * k;
                }
                return *this;
            }

            operator(/=) function(const T&: k) -> DynVector& {
                for (long int: i = 0; i < size(); i++) {
                    items[i] = items[i] / k;
                }
                return *this;
            }

            operator(==) function(const DynVector&: o) const -> bool {
                if (o.size() != size()) then {
                    return false;
                }
                for (long int: i = 0; i < size(); i++) {
                    if (items[i] != o.items[i]) then {
                        return false;
                    }
                }
                return true;
            }

            operator(!=) function(const DynVector&: o) const -> bool {
                return !(*this == o);
            }

            function dot(const DynVector&: o) const -> T {
                require_same_size(o, "dot()");
                T: total = T(0);
                for (long int: i = 0; i < size(); i++) {
                    total += items[i] * o.items[i];
                }
                return total;
            } end function dot

            function length_squared() const -> T {
                return dot(*this);
            } end function length_squared

            function length() const -> T {
                return std::math::sqrt(dot(*this));
            } end function length

            function magnitude() const -> T {
                return length();
            } end function magnitude

            function norm() const -> T {
                return length();
            } end function norm

            function norm_1() const -> T {
                T: total = T(0);
                for (long int: i = 0; i < size(); i++) {
                    total += std::math::abs(items[i]);
                }
                return total;
            } end function norm_1

            function norm_inf() const -> T {
                T: best = T(0);
                for (long int: i = 0; i < size(); i++) {
                    if (std::math::abs(items[i]) > best) then {
                        best = std::math::abs(items[i]);
                    }
                }
                return best;
            } end function norm_inf

            function norm_p(const T&: p) const -> T {
                T: total = T(0);
                for (long int: i = 0; i < size(); i++) {
                    total += std::math::pow(std::math::abs(items[i]), p);
                }
                return std::math::pow(total, T(1) / p);
            } end function norm_p

            function normalized() const -> DynVector {
                const T: len = length();
                if (len == T(0)) then {
                    return *this;
                }
                return *this / len;
            } end function normalized

            function normalize() -> DynVector& {
                *this = normalized();
                return *this;
            } end function normalize

            function is_normalized() const -> bool {
                return std::math::abs(length_squared() - T(1)) <= detail::tolerance<T>() * T(16);
            } end function is_normalized

            function is_zero() const -> bool {
                for (long int: i = 0; i < size(); i++) {
                    if (items[i] != T(0)) then {
                        return false;
                    }
                }
                return true;
            } end function is_zero

            function distance(const DynVector&: o) const -> T {
                return (*this - o).length();
            } end function distance

            function distance_squared(const DynVector&: o) const -> T {
                return (*this - o).length_squared();
            } end function distance_squared

            function lerp(const DynVector&: o, const T&: t) const -> DynVector {
                return *this + (o - *this) * t;
            } end function lerp

            function angle_to(const DynVector&: o) const -> T {
                const T: denom = length() * o.length();
                if (denom == T(0)) then {
                    return T(0);
                }
                return std::math::acos(detail::clamp_unit(dot(o) / denom));
            } end function angle_to

            function project_onto(const DynVector&: o) const -> DynVector {
                const T: d = o.length_squared();
                if (d == T(0)) then {
                    return o * T(0);
                }
                return o * (dot(o) / d);
            } end function project_onto

            function reject_from(const DynVector&: o) const -> DynVector {
                return *this - project_onto(o);
            } end function reject_from

            function reflect(const DynVector&: normal) const -> DynVector {
                return *this - normal * (T(2) * dot(normal));
            } end function reflect

            function min(const DynVector&: o) const -> DynVector {
                require_same_size(o, "min()");
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] < o.items[i] ? items[i] : o.items[i];
                }
                return out;
            } end function min

            function max(const DynVector&: o) const -> DynVector {
                require_same_size(o, "max()");
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = items[i] > o.items[i] ? items[i] : o.items[i];
                }
                return out;
            } end function max

            function abs() const -> DynVector {
                DynVector: out(size());
                for (long int: i = 0; i < size(); i++) {
                    out.items[i] = std::math::abs(items[i]);
                }
                return out;
            } end function abs

            function clamp(const DynVector&: lo, const DynVector&: hi) const -> DynVector {
                return max(lo).min(hi);
            } end function clamp

            function sum() const -> T {
                T: total = T(0);
                for (long int: i = 0; i < size(); i++) {
                    total += items[i];
                }
                return total;
            } end function sum

            function product() const -> T {
                T: total = T(1);
                for (long int: i = 0; i < size(); i++) {
                    total *= items[i];
                }
                return total;
            } end function product

            function mean() const -> T {
                return sum() / T(size());
            } end function mean

            function min_component() const -> T {
                if (items.empty()) then {
                    detail::fail("min_component() of an empty DynVector");
                }
                T: best = items[0];
                for (long int: i = 0; i < size(); i++) {
                    if (items[i] < best) then {
                        best = items[i];
                    }
                }
                return best;
            } end function min_component

            function max_component() const -> T {
                if (items.empty()) then {
                    detail::fail("max_component() of an empty DynVector");
                }
                T: best = items[0];
                for (long int: i = 0; i < size(); i++) {
                    if (items[i] > best) then {
                        best = items[i];
                    }
                }
                return best;
            } end function max_component

            function argmin() const -> long int {
                long int: best = 0;
                for (long int: i = 0; i < size(); i++) {
                    if (items[i] < items[best]) then {
                        best = i;
                    }
                }
                return best;
            } end function argmin

            function argmax() const -> long int {
                long int: best = 0;
                for (long int: i = 0; i < size(); i++) {
                    if (items[i] > items[best]) then {
                        best = i;
                    }
                }
                return best;
            } end function argmax

            function approx_equal(const DynVector&: o, const T&: tolerance) const -> bool {
                if (o.size() != size()) then {
                    return false;
                }
                for (long int: i = 0; i < size(); i++) {
                    if (std::math::abs(items[i] - o.items[i]) > tolerance) then {
                        return false;
                    }
                }
                return true;
            } end function approx_equal

            function approx_equal(const DynVector&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            function outer(const DynVector&: o) const -> DynMatrix<T> {
                DynMatrix<T>: out(size(), o.size());
                for (long int: i = 0; i < size(); i++) {
                    for (long int: j = 0; j < o.size(); j++) {
                        out(i, j) = items[i] * o.items[j];
                    }
                }
                return out;
            } end function outer

            function cross(const DynVector&: o) const -> DynVector {
                if (size() != 3 || o.size() != 3) then {
                    detail::fail("cross() needs two vectors of size 3");
                }
                DynVector: out(3);
                out.items[0] = items[1] * o.items[2] - items[2] * o.items[1];
                out.items[1] = items[2] * o.items[0] - items[0] * o.items[2];
                out.items[2] = items[0] * o.items[1] - items[1] * o.items[0];
                return out;
            } end function cross

            function begin() -> T* {
                return items.begin();
            } end function begin

            function end() -> T* {
                return items.end();
            } end function end

            function begin() const -> const T* {
                return items.begin();
            } end function begin

            function end() const -> const T* {
                return items.end();
            } end function end

            function to_string() const -> string {
                string: out = "(";
                for (long int: i = 0; i < size(); i++) {
                    if (i > 0) then {
                        out += ", ";
                    }
                    out += std::core::to_string(items[i]);
                }
                out += ")";
                return out;
            } end function to_string
        } end class DynVector

        template <typename T>
        operator(*) function(const T&: k, const DynVector<T>&: v) -> DynVector<T> {
            return v * k;
        }

        namespace detail {
            template <int N>
            constexpr long int: kv_factorial = N * kv_factorial<N - 1>;

            template <>
            constexpr long int: kv_factorial<0> = 1;

            template <int N, int K>
            constexpr long int: kv_components = (K < 0 || K > N) ? 0 : kv_factorial<N> / (kv_factorial<(K < 0 ? 0 : K)> * kv_factorial<(K < 0 || K > N ? 0 : N - K)>);

            function kv_choose(long int: n, long int: k) -> long int {
                if (k < 0 || k > n) then {
                    return 0;
                }
                long int: r = 1;
                for (long int: i = 0; i < k; i++) {
                    r = r * (n - i) / (i + 1);
                }
                return r;
            } end function kv_choose

            function kv_unrank(long int: n, long int: k, long int: rank) -> std::collections::Vector<long int> {
                std::collections::Vector<long int>: out;
                long int: left = rank;
                long int: v = 0;
                for (long int: a = 0; a < k; a++) {
                    while (true) {
                        const long int: count = kv_choose(n - v - 1, k - a - 1);
                        if (left < count) then {
                            break;
                        }
                        left -= count;
                        v++;
                    }
                    out.push_back(v);
                    v++;
                }
                return out;
            } end function kv_unrank

            function kv_rank(long int: n, const std::collections::Vector<long int>&: combo) -> long int {
                const long int: k = combo.size();
                long int: rank = 0;
                long int: start = 0;
                for (long int: a = 0; a < k; a++) {
                    for (long int: v = start; v < combo[a]; v++) {
                        rank += kv_choose(n - v - 1, k - a - 1);
                    }
                    start = combo[a] + 1;
                }
                return rank;
            } end function kv_rank

            function kv_inversions(const std::collections::Vector<long int>&: first, const std::collections::Vector<long int>&: second) -> long int {
                long int: count = 0;
                for (long int: a in first) {
                    for (long int: b in second) {
                        if (a > b) then {
                            count++;
                        }
                    }
                }
                return count;
            } end function kv_inversions
        } end namespace detail

        template <typename T, int K, int N>
        struct KVector {
            static_assert(std::traits::is_float<T>, "k-vectors need a real float type, such as float or double, not an integer or other type");
            static_assert(K >= 0 && K <= N, "a KVector's grade K has to be between 0 and its dimension N");
            array[detail::kv_components<N, K>] T: data;

            constructor() {
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    data[i] = T(0);
                }
            }

            constructor(const array[detail::kv_components<N, K>] T&: values) : data = values { }

            template <typename... Ts>
            constructor(Ts...: values) {
                static_assert(countof(values) == detail::kv_components<N, K>, "a KVector<T, K, N> is made from exactly C(N, K) values, one per component");
                array[detail::kv_components<N, K>] T: given = {T(values)...};
                data = given;
            }

            static function zero() -> KVector {
                return KVector();
            } end function zero

            static function unit(long int: component) -> KVector {
                KVector: out;
                out[component] = T(1);
                return out;
            } end function unit

            static function from_vector(const VectorN<T, N>&: v) -> KVector {
                static_assert(K == 1, "from_vector() makes a 1-vector");
                KVector: out;
                for (long int: i = 0; i < N; i++) {
                    out.data[i] = v[i];
                }
                return out;
            } end function from_vector

            static function of_scalar(const T&: value) -> KVector {
                static_assert(K == 0, "of_scalar() makes a 0-vector");
                KVector: out;
                out.data[0] = value;
                return out;
            } end function of_scalar

            static function size() -> long int {
                return detail::kv_components<N, K>;
            } end function size

            static function grade() -> long int {
                return K;
            } end function grade

            static function dimension() -> long int {
                return N;
            } end function dimension

            static function indices_of(long int: component) -> std::collections::Vector<long int> {
                if (component < 0 || component >= detail::kv_components<N, K>) then {
                    detail::fail(static_cast<string>(`component ${component} is out of range for a KVector with ${detail::kv_components<N, K>} components`));
                }
                return detail::kv_unrank(N, K, component);
            } end function indices_of

            static function component_of(const std::collections::Vector<long int>&: indices) -> long int {
                if (indices.size() != K) then {
                    detail::fail(static_cast<string>(`a grade-${K} component is named by ${K} indices, not ${indices.size()}`));
                }
                for (long int: a = 0; a < indices.size(); a++) {
                    if (indices[a] < 0 || indices[a] >= N) then {
                        detail::fail(static_cast<string>(`index ${indices[a]} is out of range for dimension ${N}`));
                    }
                    if (a > 0 && indices[a] <= indices[a - 1]) then {
                        detail::fail("KVector indices have to be strictly increasing");
                    }
                }
                return detail::kv_rank(N, indices);
            } end function component_of

            operator([]) function(long int: component) -> T& {
                if (component < 0 || component >= detail::kv_components<N, K>) then {
                    detail::fail(static_cast<string>(`component ${component} is out of range for a KVector with ${detail::kv_components<N, K>} components`));
                }
                return data[component];
            }

            operator([]) function(long int: component) const -> const T& {
                if (component < 0 || component >= detail::kv_components<N, K>) then {
                    detail::fail(static_cast<string>(`component ${component} is out of range for a KVector with ${detail::kv_components<N, K>} components`));
                }
                return data[component];
            }

            function component(long int: index) -> T& {
                return (*this)[index];
            } end function component

            function component(long int: index) const -> const T& {
                return (*this)[index];
            } end function component

            template <typename... Is>
            function at(Is...: indices) -> T& {
                static_assert(countof(indices) == K, "at() takes exactly K indices");
                array[(K > 0 ? K : 1)] long int: given = {static_cast<long int>(indices)...};
                std::collections::Vector<long int>: list;
                for (long int: i = 0; i < K; i++) {
                    list.push_back(given[i]);
                }
                return data[component_of(list)];
            } end function at

            template <typename... Is>
            function at(Is...: indices) const -> const T& {
                static_assert(countof(indices) == K, "at() takes exactly K indices");
                array[(K > 0 ? K : 1)] long int: given = {static_cast<long int>(indices)...};
                std::collections::Vector<long int>: list;
                for (long int: i = 0; i < K; i++) {
                    list.push_back(given[i]);
                }
                return data[component_of(list)];
            } end function at

            function scalar() const -> T {
                static_assert(K == 0 || K == N, "scalar() is for 0-vectors and pseudoscalars");
                return data[0];
            } end function scalar

            operator(+) function(const KVector&: o) const -> KVector {
                KVector: out;
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    out.data[i] = data[i] + o.data[i];
                }
                return out;
            }

            operator(-) function(const KVector&: o) const -> KVector {
                KVector: out;
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    out.data[i] = data[i] - o.data[i];
                }
                return out;
            }

            operator(-) function() const -> KVector {
                KVector: out;
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    out.data[i] = -data[i];
                }
                return out;
            }

            operator(*) function(const T&: k) const -> KVector {
                KVector: out;
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    out.data[i] = data[i] * k;
                }
                return out;
            }

            operator(/) function(const T&: k) const -> KVector {
                KVector: out;
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    out.data[i] = data[i] / k;
                }
                return out;
            }

            operator(+=) function(const KVector&: o) -> KVector& {
                *this = *this + o;
                return *this;
            }

            operator(-=) function(const KVector&: o) -> KVector& {
                *this = *this - o;
                return *this;
            }

            operator(*=) function(const T&: k) -> KVector& {
                *this = *this * k;
                return *this;
            }

            operator(/=) function(const T&: k) -> KVector& {
                *this = *this / k;
                return *this;
            }

            operator(==) function(const KVector&: o) const -> bool {
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    if (data[i] != o.data[i]) then {
                        return false;
                    }
                }
                return true;
            }

            operator(!=) function(const KVector&: o) const -> bool {
                return !(*this == o);
            }

            function dot(const KVector&: o) const -> T {
                T: total = T(0);
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    total += data[i] * o.data[i];
                }
                return total;
            } end function dot

            function norm_squared() const -> T {
                return dot(*this);
            } end function norm_squared

            function norm() const -> T {
                return std::math::sqrt(norm_squared());
            } end function norm

            function magnitude() const -> T {
                return norm();
            } end function magnitude

            function normalized() const -> KVector {
                const T: n = norm();
                if (n == T(0)) then {
                    return *this;
                }
                return *this / n;
            } end function normalized

            function is_zero() const -> bool {
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    if (data[i] != T(0)) then {
                        return false;
                    }
                }
                return true;
            } end function is_zero

            function approx_equal(const KVector&: o, const T&: tolerance) const -> bool {
                for (long int: i = 0; i < detail::kv_components<N, K>; i++) {
                    if (std::math::abs(data[i] - o.data[i]) > tolerance) then {
                        return false;
                    }
                }
                return true;
            } end function approx_equal

            function approx_equal(const KVector&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            template <int J>
            function wedge(const KVector<T, J, N>&: o) const -> KVector<T, K + J, N> {
                static_assert(K + J <= N, "the wedge product's grade K + J can't be more than the dimension N");
                KVector<T, K + J, N>: out;
                const long int: total = detail::kv_choose(N, K + J);
                const long int: splits = detail::kv_choose(K + J, K);
                for (long int: r = 0; r < total; r++) {
                    const std::collections::Vector<long int>: blade = detail::kv_unrank(N, K + J, r);
                    T: sum = T(0);
                    for (long int: q = 0; q < splits; q++) {
                        const std::collections::Vector<long int>: picks = detail::kv_unrank(K + J, K, q);
                        std::collections::Vector<long int>: first;
                        std::collections::Vector<long int>: second;
                        long int: p = 0;
                        for (long int: i = 0; i < K + J; i++) {
                            if (p < K && picks[p] == i) then {
                                first.push_back(blade[i]);
                                p++;
                            } else then {
                                second.push_back(blade[i]);
                            }
                        }
                        const T: term = data[detail::kv_rank(N, first)] * o.data[detail::kv_rank(N, second)];
                        if (detail::kv_inversions(first, second) % 2 == 0) then {
                            sum += term;
                        } else then {
                            sum -= term;
                        }
                    }
                    out.data[r] = sum;
                }
                return out;
            } end function wedge

            function hodge() const -> KVector<T, N - K, N> {
                KVector<T, N - K, N>: out;
                for (long int: r = 0; r < detail::kv_components<N, K>; r++) {
                    const std::collections::Vector<long int>: blade = detail::kv_unrank(N, K, r);
                    std::collections::Vector<long int>: rest;
                    long int: p = 0;
                    for (long int: i = 0; i < N; i++) {
                        if (p < K && blade[p] == i) then {
                            p++;
                        } else then {
                            rest.push_back(i);
                        }
                    }
                    const long int: target = detail::kv_rank(N, rest);
                    out.data[target] = detail::kv_inversions(blade, rest) % 2 == 0 ? data[r] : -data[r];
                }
                return out;
            } end function hodge

            function to_vector() const -> VectorN<T, N> {
                static_assert(K == 1, "to_vector() needs a 1-vector");
                VectorN<T, N>: out;
                for (long int: i = 0; i < N; i++) {
                    out[i] = data[i];
                }
                return out;
            } end function to_vector

            function to_string() const -> string {
                string: out;
                for (long int: r = 0; r < detail::kv_components<N, K>; r++) {
                    if (r > 0) then {
                        out += " + ";
                    }
                    out += std::core::to_string(data[r]);
                    if (K > 0) then {
                        out += " e";
                        const std::collections::Vector<long int>: blade = detail::kv_unrank(N, K, r);
                        for (long int: i in blade) {
                            out += std::core::to_string(i);
                        }
                    }
                }
                return out;
            } end function to_string
        } end struct KVector

        template <typename T, int K, int N>
        operator(*) function(const T&: k, const KVector<T, K, N>&: v) -> KVector<T, K, N> {
            return v * k;
        }

        template <typename T, int N>
        using Bivector = KVector<T, 2, N>;

        template <typename T, int N>
        using Trivector = KVector<T, 3, N>;

        template <typename T, int N>
        using Pseudoscalar = KVector<T, N, N>;

        template <typename T, int A, int B, int N>
        function wedge(const KVector<T, A, N>&: a, const KVector<T, B, N>&: b) -> KVector<T, A + B, N> {
            return a.wedge(b);
        } end function wedge

        template <typename T, int N>
        function wedge(const VectorN<T, N>&: a, const VectorN<T, N>&: b) -> KVector<T, 2, N> {
            return KVector<T, 1, N>::from_vector(a).wedge(KVector<T, 1, N>::from_vector(b));
        } end function wedge

        template <typename T>
        function wedge(const Vector2<T>&: a, const Vector2<T>&: b) -> KVector<T, 2, 2> {
            return KVector<T, 2, 2>(a.x * b.y - a.y * b.x);
        } end function wedge

        template <typename T>
        function wedge(const Vector3<T>&: a, const Vector3<T>&: b) -> KVector<T, 2, 3> {
            return KVector<T, 2, 3>(a.x * b.y - a.y * b.x, a.x * b.z - a.z * b.x, a.y * b.z - a.z * b.y);
        } end function wedge

        template <typename T>
        function wedge(const Vector4<T>&: a, const Vector4<T>&: b) -> KVector<T, 2, 4> {
            return wedge(a.to_vector(), b.to_vector());
        } end function wedge

        template <typename T, int K, int N>
        function hodge(const KVector<T, K, N>&: v) -> KVector<T, N - K, N> {
            return v.hodge();
        } end function hodge

        template <typename T>
        struct LUDecomposition {
            DynMatrix<T>: lower;
            DynMatrix<T>: upper;
            std::collections::Vector<long int>: permutation;
            int: sign = 1;
            bool: singular = false;

            function determinant() const -> T {
                if (singular) then {
                    return T(0);
                }
                T: total = T(sign);
                for (long int: i = 0; i < upper.rows(); i++) {
                    total *= upper(i, i);
                }
                return total;
            } end function determinant

            function solve(const DynVector<T>&: b) const -> DynVector<T> {
                const long int: n = upper.rows();
                if (singular) then {
                    detail::fail("solve() on a singular matrix: it has no unique solution");
                }
                if (b.size() != n) then {
                    detail::fail(static_cast<string>(`solve() needs a vector of size ${n}, not ${b.size()}`));
                }
                DynVector<T>: y(n);
                for (long int: i = 0; i < n; i++) {
                    T: s = b[permutation[i]];
                    for (long int: j = 0; j < i; j++) {
                        s -= lower(i, j) * y[j];
                    }
                    y[i] = s;
                }
                DynVector<T>: x(n);
                for (long int: i = n - 1; i >= 0; i--) {
                    T: s = y[i];
                    for (long int: j = i + 1; j < n; j++) {
                        s -= upper(i, j) * x[j];
                    }
                    x[i] = s / upper(i, i);
                }
                return x;
            } end function solve

            function solve(const DynMatrix<T>&: b) const -> DynMatrix<T> {
                if (b.rows() != upper.rows()) then {
                    detail::fail(static_cast<string>(`solve() needs a matrix with ${upper.rows()} rows, not ${b.rows()}`));
                }
                DynMatrix<T>: out(b.rows(), b.cols());
                for (long int: j = 0; j < b.cols(); j++) {
                    out.set_column(j, solve(b.column(j)));
                }
                return out;
            } end function solve

            function inverse() const -> DynMatrix<T> {
                if (singular) then {
                    detail::fail("inverse() of a singular matrix: its determinant is 0");
                }
                return solve(DynMatrix<T>::identity(upper.rows()));
            } end function inverse

            function permutation_matrix() const -> DynMatrix<T> {
                const long int: n = upper.rows();
                DynMatrix<T>: out(n, n);
                for (long int: i = 0; i < n; i++) {
                    out(i, permutation[i]) = T(1);
                }
                return out;
            } end function permutation_matrix
        } end struct LUDecomposition

        template <typename T>
        struct QRDecomposition {
            DynMatrix<T>: q;
            DynMatrix<T>: r;
        } end struct QRDecomposition

        template <typename T>
        struct SymmetricEigen {
            DynVector<T>: values;
            DynMatrix<T>: vectors;

            function vector(long int: index) const -> DynVector<T> {
                return vectors.column(index);
            } end function vector
        } end struct SymmetricEigen

        template <typename T>
        struct SingularValueDecomposition {
            DynMatrix<T>: u;
            DynVector<T>: singular_values;
            DynMatrix<T>: v;
        } end struct SingularValueDecomposition

        template <typename T>
        class DynMatrix {
            long int: row_count = 0;
            long int: col_count = 0;
            std::collections::Vector<T>: cells;

            function check(long int: r, long int: c) const -> void {
                if (r < 0 || r >= row_count || c < 0 || c >= col_count) then {
                    detail::fail(static_cast<string>(`element (${r}, ${c}) is out of range for a ${row_count}x${col_count} matrix`));
                }
            } end function check

            function require_square(const string&: what) const -> void {
                if (row_count != col_count) then {
                    detail::fail(static_cast<string>(`${what} needs a square matrix, not ${row_count}x${col_count}`));
                }
            } end function require_square

            function require_same(const DynMatrix&: o, const string&: what) const -> void {
                if (o.row_count != row_count || o.col_count != col_count) then {
                    detail::fail(static_cast<string>(`${what} needs matrices of the same size, not ${row_count}x${col_count} and ${o.row_count}x${o.col_count}`));
                }
            } end function require_same

            function cell(long int: r, long int: c) -> T& {
                return cells[r * col_count + c];
            } end function cell

            function cell(long int: r, long int: c) const -> const T& {
                return cells[r * col_count + c];
            } end function cell

            function scale() const -> T {
                const T: m = max_abs();
                return m == T(0) ? T(1) : m;
            } end function scale

            function hessenberg_eigenvalues() const -> std::collections::Vector<std::math::Complex<T>> {
                const long int: n = row_count;
                DynMatrix: a = *this;
                for (long int: m = 1; m < n - 1; m++) {
                    T: x = T(0);
                    long int: i = m;
                    for (long int: j = m; j < n; j++) {
                        if (std::math::abs(a.cell(j, m - 1)) > std::math::abs(x)) then {
                            x = a.cell(j, m - 1);
                            i = j;
                        }
                    }
                    if (i != m) then {
                        for (long int: j = m - 1; j < n; j++) {
                            const T: held = a.cell(i, j);
                            a.cell(i, j) = a.cell(m, j);
                            a.cell(m, j) = held;
                        }
                        for (long int: j = 0; j < n; j++) {
                            const T: held = a.cell(j, i);
                            a.cell(j, i) = a.cell(j, m);
                            a.cell(j, m) = held;
                        }
                    }
                    if (x != T(0)) then {
                        for (long int: r = m + 1; r < n; r++) {
                            T: y = a.cell(r, m - 1);
                            if (y != T(0)) then {
                                y /= x;
                                a.cell(r, m - 1) = y;
                                for (long int: j = m; j < n; j++) {
                                    a.cell(r, j) -= y * a.cell(m, j);
                                }
                                for (long int: j = 0; j < n; j++) {
                                    a.cell(j, m) += y * a.cell(j, r);
                                }
                            }
                        }
                    }
                }
                for (long int: r = 2; r < n; r++) {
                    for (long int: c = 0; c < r - 1; c++) {
                        a.cell(r, c) = T(0);
                    }
                }

                std::collections::Vector<T>: wr;
                std::collections::Vector<T>: wi;
                wr.resize(n, T(0));
                wi.resize(n, T(0));
                T: anorm = T(0);
                for (long int: r = 0; r < n; r++) {
                    for (long int: c = (r > 0 ? r - 1 : 0); c < n; c++) {
                        anorm += std::math::abs(a.cell(r, c));
                    }
                }
                long int: nn = n - 1;
                T: t = T(0);
                T: p = T(0);
                T: q = T(0);
                T: r = T(0);
                T: s = T(0);
                T: w = T(0);
                T: x = T(0);
                T: y = T(0);
                T: z = T(0);
                const T: half = T(1) / T(2);
                while (nn >= 0) {
                    int: its = 0;
                    long int: l = 0;
                    while (true) {
                        l = nn;
                        while (l >= 1) {
                            s = std::math::abs(a.cell(l - 1, l - 1)) + std::math::abs(a.cell(l, l));
                            if (s == T(0)) then {
                                s = anorm;
                            }
                            if (std::math::abs(a.cell(l, l - 1)) + s == s) then {
                                a.cell(l, l - 1) = T(0);
                                break;
                            }
                            l--;
                        }
                        if (l < 0) then {
                            l = 0;
                        }
                        x = a.cell(nn, nn);
                        if (l == nn) then {
                            wr[nn] = x + t;
                            wi[nn] = T(0);
                            nn--;
                            break;
                        }
                        y = a.cell(nn - 1, nn - 1);
                        w = a.cell(nn, nn - 1) * a.cell(nn - 1, nn);
                        if (l == nn - 1) then {
                            p = half * (y - x);
                            q = p * p + w;
                            z = std::math::sqrt(std::math::abs(q));
                            x += t;
                            if (q >= T(0)) then {
                                z = p + detail::copy_sign(z, p);
                                wr[nn - 1] = x + z;
                                wr[nn] = x + z;
                                if (z != T(0)) then {
                                    wr[nn] = x - w / z;
                                }
                                wi[nn - 1] = T(0);
                                wi[nn] = T(0);
                            } else then {
                                wr[nn - 1] = x + p;
                                wr[nn] = x + p;
                                wi[nn - 1] = -z;
                                wi[nn] = z;
                            }
                            nn -= 2;
                            break;
                        }
                        if (its == 60) then {
                            detail::fail("eigenvalues() did not converge");
                        }
                        if (its == 10 || its == 20 || its == 40) then {
                            t += x;
                            for (long int: k = 0; k <= nn; k++) {
                                a.cell(k, k) -= x;
                            }
                            s = std::math::abs(a.cell(nn, nn - 1)) + std::math::abs(a.cell(nn - 1, nn - 2));
                            x = T(3) * s / T(4);
                            y = x;
                            w = T(-7) * s * s / T(16);
                        }
                        its++;
                        long int: m = nn - 2;
                        while (m >= l) {
                            z = a.cell(m, m);
                            r = x - z;
                            s = y - z;
                            p = (r * s - w) / a.cell(m + 1, m) + a.cell(m, m + 1);
                            q = a.cell(m + 1, m + 1) - z - r - s;
                            r = a.cell(m + 2, m + 1);
                            s = std::math::abs(p) + std::math::abs(q) + std::math::abs(r);
                            p /= s;
                            q /= s;
                            r /= s;
                            if (m == l) then {
                                break;
                            }
                            const T: u = std::math::abs(a.cell(m, m - 1)) * (std::math::abs(q) + std::math::abs(r));
                            const T: v = std::math::abs(p) * (std::math::abs(a.cell(m - 1, m - 1)) + std::math::abs(z) + std::math::abs(a.cell(m + 1, m + 1)));
                            if (u + v == v) then {
                                break;
                            }
                            m--;
                        }
                        for (long int: i = m + 2; i <= nn; i++) {
                            a.cell(i, i - 2) = T(0);
                            if (i != m + 2) then {
                                a.cell(i, i - 3) = T(0);
                            }
                        }
                        for (long int: k = m; k <= nn - 1; k++) {
                            if (k != m) then {
                                p = a.cell(k, k - 1);
                                q = a.cell(k + 1, k - 1);
                                r = T(0);
                                if (k != nn - 1) then {
                                    r = a.cell(k + 2, k - 1);
                                }
                                x = std::math::abs(p) + std::math::abs(q) + std::math::abs(r);
                                if (x != T(0)) then {
                                    p /= x;
                                    q /= x;
                                    r /= x;
                                }
                            }
                            s = detail::copy_sign(std::math::sqrt(p * p + q * q + r * r), p);
                            if (s != T(0)) then {
                                if (k == m) then {
                                    if (l != m) then {
                                        a.cell(k, k - 1) = -a.cell(k, k - 1);
                                    }
                                } else then {
                                    a.cell(k, k - 1) = -s * x;
                                }
                                p += s;
                                x = p / s;
                                y = q / s;
                                z = r / s;
                                q /= p;
                                r /= p;
                                for (long int: j = k; j <= nn; j++) {
                                    p = a.cell(k, j) + q * a.cell(k + 1, j);
                                    if (k != nn - 1) then {
                                        p += r * a.cell(k + 2, j);
                                        a.cell(k + 2, j) -= p * z;
                                    }
                                    a.cell(k + 1, j) -= p * y;
                                    a.cell(k, j) -= p * x;
                                }
                                const long int: mmin = nn < k + 3 ? nn : k + 3;
                                for (long int: i = l; i <= mmin; i++) {
                                    p = x * a.cell(i, k) + y * a.cell(i, k + 1);
                                    if (k != nn - 1) then {
                                        p += z * a.cell(i, k + 2);
                                        a.cell(i, k + 2) -= p * r;
                                    }
                                    a.cell(i, k + 1) -= p * q;
                                    a.cell(i, k) -= p;
                                }
                            }
                        }
                        if (l >= nn - 1) then {
                            break;
                        }
                    }
                }

                std::collections::Vector<std::math::Complex<T>>: out;
                for (long int: i = 0; i < n; i++) {
                    out.push_back(std::math::Complex<T>(wr[i], wi[i]));
                }
                for (long int: i = 1; i < n; i++) {
                    long int: j = i;
                    while (j > 0 && (out[j].real() < out[j - 1].real() || (out[j].real() == out[j - 1].real() && out[j].imaginary() < out[j - 1].imaginary()))) {
                        const std::math::Complex<T>: held = out[j];
                        out[j] = out[j - 1];
                        out[j - 1] = held;
                        j--;
                    }
                }
                return out;
            } end function hessenberg_eigenvalues

        public:
            static_assert(std::traits::is_float<T>, "linalg matrices need a real float type, such as float or double, not an integer or other type");

            constructor() { }

            constructor(long int: rows, long int: cols) : row_count = rows, col_count = cols {
                if (rows < 0 || cols < 0) then {
                    detail::fail("a DynMatrix can't have a negative size");
                }
                cells.resize(rows * cols, T(0));
            }

            constructor(long int: rows, long int: cols, const T&: value) : row_count = rows, col_count = cols {
                if (rows < 0 || cols < 0) then {
                    detail::fail("a DynMatrix can't have a negative size");
                }
                cells.resize(rows * cols, value);
            }

            static function zero(long int: rows, long int: cols) -> DynMatrix {
                return DynMatrix(rows, cols);
            } end function zero

            static function filled(long int: rows, long int: cols, const T&: value) -> DynMatrix {
                return DynMatrix(rows, cols, value);
            } end function filled

            static function identity(long int: n) -> DynMatrix {
                DynMatrix: out(n, n);
                for (long int: i = 0; i < n; i++) {
                    out.cell(i, i) = T(1);
                }
                return out;
            } end function identity

            static function diagonal(const DynVector<T>&: values) -> DynMatrix {
                DynMatrix: out(values.size(), values.size());
                for (long int: i = 0; i < values.size(); i++) {
                    out.cell(i, i) = values[i];
                }
                return out;
            } end function diagonal

            static function from_rows(const std::collections::Vector<DynVector<T>>&: rows) -> DynMatrix {
                if (rows.empty()) then {
                    return DynMatrix();
                }
                DynMatrix: out(rows.size(), rows[0].size());
                for (long int: i = 0; i < rows.size(); i++) {
                    out.set_row(i, rows[i]);
                }
                return out;
            } end function from_rows

            static function from_columns(const std::collections::Vector<DynVector<T>>&: columns) -> DynMatrix {
                if (columns.empty()) then {
                    return DynMatrix();
                }
                DynMatrix: out(columns[0].size(), columns.size());
                for (long int: j = 0; j < columns.size(); j++) {
                    out.set_column(j, columns[j]);
                }
                return out;
            } end function from_columns

            static function from_values(long int: rows, long int: cols, const std::collections::Vector<T>&: values) -> DynMatrix {
                if (values.size() != rows * cols) then {
                    detail::fail(static_cast<string>(`a ${rows}x${cols} matrix needs ${rows * cols} values, not ${values.size()}`));
                }
                DynMatrix: out(rows, cols);
                for (long int: i = 0; i < values.size(); i++) {
                    out.cells[i] = values[i];
                }
                return out;
            } end function from_values

            function rows() const -> long int {
                return row_count;
            } end function rows

            function cols() const -> long int {
                return col_count;
            } end function cols

            function size() const -> long int {
                return row_count * col_count;
            } end function size

            function empty() const -> bool {
                return row_count == 0 || col_count == 0;
            } end function empty

            function is_square() const -> bool {
                return row_count == col_count;
            } end function is_square

            operator(()) function(long int: r, long int: c) -> T& {
                check(r, c);
                return cells[r * col_count + c];
            }

            operator(()) function(long int: r, long int: c) const -> const T& {
                check(r, c);
                return cells[r * col_count + c];
            }

            function at(long int: r, long int: c) -> T& {
                check(r, c);
                return cells[r * col_count + c];
            } end function at

            function at(long int: r, long int: c) const -> const T& {
                check(r, c);
                return cells[r * col_count + c];
            } end function at

            function values() const -> const std::collections::Vector<T>& {
                return cells;
            } end function values

            function row(long int: r) const -> DynVector<T> {
                check(r, 0);
                DynVector<T>: out(col_count);
                for (long int: j = 0; j < col_count; j++) {
                    out[j] = cell(r, j);
                }
                return out;
            } end function row

            function column(long int: c) const -> DynVector<T> {
                check(0, c);
                DynVector<T>: out(row_count);
                for (long int: i = 0; i < row_count; i++) {
                    out[i] = cell(i, c);
                }
                return out;
            } end function column

            function diagonal_values() const -> DynVector<T> {
                const long int: n = row_count < col_count ? row_count : col_count;
                DynVector<T>: out(n);
                for (long int: i = 0; i < n; i++) {
                    out[i] = cell(i, i);
                }
                return out;
            } end function diagonal_values

            function set_row(long int: r, const DynVector<T>&: values) -> void {
                check(r, 0);
                if (values.size() != col_count) then {
                    detail::fail(static_cast<string>(`set_row() needs ${col_count} values, not ${values.size()}`));
                }
                for (long int: j = 0; j < col_count; j++) {
                    cell(r, j) = values[j];
                }
            } end function set_row

            function set_column(long int: c, const DynVector<T>&: values) -> void {
                check(0, c);
                if (values.size() != row_count) then {
                    detail::fail(static_cast<string>(`set_column() needs ${row_count} values, not ${values.size()}`));
                }
                for (long int: i = 0; i < row_count; i++) {
                    cell(i, c) = values[i];
                }
            } end function set_column

            function swap_rows(long int: a, long int: b) -> void {
                check(a, 0);
                check(b, 0);
                for (long int: j = 0; j < col_count; j++) {
                    const T: held = cell(a, j);
                    cell(a, j) = cell(b, j);
                    cell(b, j) = held;
                }
            } end function swap_rows

            function swap_columns(long int: a, long int: b) -> void {
                check(0, a);
                check(0, b);
                for (long int: i = 0; i < row_count; i++) {
                    const T: held = cell(i, a);
                    cell(i, a) = cell(i, b);
                    cell(i, b) = held;
                }
            } end function swap_columns

            function submatrix(long int: first_row, long int: first_col, long int: rows, long int: cols) const -> DynMatrix {
                if (first_row < 0 || first_col < 0 || rows < 0 || cols < 0 || first_row + rows > row_count || first_col + cols > col_count) then {
                    detail::fail(static_cast<string>(`submatrix(${first_row}, ${first_col}, ${rows}, ${cols}) doesn't fit in a ${row_count}x${col_count} matrix`));
                }
                DynMatrix: out(rows, cols);
                for (long int: i = 0; i < rows; i++) {
                    for (long int: j = 0; j < cols; j++) {
                        out.cell(i, j) = cell(first_row + i, first_col + j);
                    }
                }
                return out;
            } end function submatrix

            function without(long int: r, long int: c) const -> DynMatrix {
                check(r, c);
                DynMatrix: out(row_count - 1, col_count - 1);
                long int: oi = 0;
                for (long int: i = 0; i < row_count; i++) {
                    if (i == r) then {
                        continue;
                    }
                    long int: oj = 0;
                    for (long int: j = 0; j < col_count; j++) {
                        if (j == c) then {
                            continue;
                        }
                        out.cell(oi, oj) = cell(i, j);
                        oj++;
                    }
                    oi++;
                }
                return out;
            } end function without

            function minor(long int: r, long int: c) const -> T {
                require_square("minor()");
                return without(r, c).determinant();
            } end function minor

            function cofactor(long int: r, long int: c) const -> T {
                const T: m = minor(r, c);
                return (r + c) % 2 == 0 ? m : -m;
            } end function cofactor

            function cofactor_matrix() const -> DynMatrix {
                require_square("cofactor_matrix()");
                DynMatrix: out(row_count, col_count);
                if (row_count == 1) then {
                    out.cell(0, 0) = T(1);
                    return out;
                }
                for (long int: i = 0; i < row_count; i++) {
                    for (long int: j = 0; j < col_count; j++) {
                        out.cell(i, j) = cofactor(i, j);
                    }
                }
                return out;
            } end function cofactor_matrix

            function adjugate() const -> DynMatrix {
                return cofactor_matrix().transpose();
            } end function adjugate

            operator(+) function(const DynMatrix&: o) const -> DynMatrix {
                require_same(o, "'+'");
                DynMatrix: out = *this;
                for (long int: i = 0; i < cells.size(); i++) {
                    out.cells[i] += o.cells[i];
                }
                return out;
            }

            operator(-) function(const DynMatrix&: o) const -> DynMatrix {
                require_same(o, "'-'");
                DynMatrix: out = *this;
                for (long int: i = 0; i < cells.size(); i++) {
                    out.cells[i] -= o.cells[i];
                }
                return out;
            }

            operator(-) function() const -> DynMatrix {
                DynMatrix: out = *this;
                for (long int: i = 0; i < cells.size(); i++) {
                    out.cells[i] = -cells[i];
                }
                return out;
            }

            operator(*) function(const T&: k) const -> DynMatrix {
                DynMatrix: out = *this;
                for (long int: i = 0; i < cells.size(); i++) {
                    out.cells[i] *= k;
                }
                return out;
            }

            operator(/) function(const T&: k) const -> DynMatrix {
                DynMatrix: out = *this;
                for (long int: i = 0; i < cells.size(); i++) {
                    out.cells[i] /= k;
                }
                return out;
            }

            operator(*) function(const DynMatrix&: o) const -> DynMatrix {
                if (col_count != o.row_count) then {
                    detail::fail(static_cast<string>(`can't multiply a ${row_count}x${col_count} matrix by a ${o.row_count}x${o.col_count} one`));
                }
                DynMatrix: out(row_count, o.col_count);
                for (long int: i = 0; i < row_count; i++) {
                    for (long int: k = 0; k < col_count; k++) {
                        const T: a = cell(i, k);
                        if (a == T(0)) then {
                            continue;
                        }
                        for (long int: j = 0; j < o.col_count; j++) {
                            out.cell(i, j) += a * o.cell(k, j);
                        }
                    }
                }
                return out;
            }

            operator(*) function(const DynVector<T>&: v) const -> DynVector<T> {
                if (col_count != v.size()) then {
                    detail::fail(static_cast<string>(`can't multiply a ${row_count}x${col_count} matrix by a vector of size ${v.size()}`));
                }
                DynVector<T>: out(row_count);
                for (long int: i = 0; i < row_count; i++) {
                    T: s = T(0);
                    for (long int: j = 0; j < col_count; j++) {
                        s += cell(i, j) * v[j];
                    }
                    out[i] = s;
                }
                return out;
            }

            operator(+=) function(const DynMatrix&: o) -> DynMatrix& {
                *this = *this + o;
                return *this;
            }

            operator(-=) function(const DynMatrix&: o) -> DynMatrix& {
                *this = *this - o;
                return *this;
            }

            operator(*=) function(const DynMatrix&: o) -> DynMatrix& {
                *this = *this * o;
                return *this;
            }

            operator(*=) function(const T&: k) -> DynMatrix& {
                *this = *this * k;
                return *this;
            }

            operator(/=) function(const T&: k) -> DynMatrix& {
                *this = *this / k;
                return *this;
            }

            operator(==) function(const DynMatrix&: o) const -> bool {
                if (o.row_count != row_count || o.col_count != col_count) then {
                    return false;
                }
                for (long int: i = 0; i < cells.size(); i++) {
                    if (cells[i] != o.cells[i]) then {
                        return false;
                    }
                }
                return true;
            }

            operator(!=) function(const DynMatrix&: o) const -> bool {
                return !(*this == o);
            }

            function hadamard(const DynMatrix&: o) const -> DynMatrix {
                require_same(o, "hadamard()");
                DynMatrix: out = *this;
                for (long int: i = 0; i < cells.size(); i++) {
                    out.cells[i] *= o.cells[i];
                }
                return out;
            } end function hadamard

            function kronecker(const DynMatrix&: o) const -> DynMatrix {
                DynMatrix: out(row_count * o.row_count, col_count * o.col_count);
                for (long int: i = 0; i < row_count; i++) {
                    for (long int: j = 0; j < col_count; j++) {
                        for (long int: k = 0; k < o.row_count; k++) {
                            for (long int: l = 0; l < o.col_count; l++) {
                                out.cell(i * o.row_count + k, j * o.col_count + l) = cell(i, j) * o.cell(k, l);
                            }
                        }
                    }
                }
                return out;
            } end function kronecker

            function transpose() const -> DynMatrix {
                DynMatrix: out(col_count, row_count);
                for (long int: i = 0; i < row_count; i++) {
                    for (long int: j = 0; j < col_count; j++) {
                        out.cell(j, i) = cell(i, j);
                    }
                }
                return out;
            } end function transpose

            function trace() const -> T {
                require_square("trace()");
                T: total = T(0);
                for (long int: i = 0; i < row_count; i++) {
                    total += cell(i, i);
                }
                return total;
            } end function trace

            function max_abs() const -> T {
                T: best = T(0);
                for (long int: i = 0; i < cells.size(); i++) {
                    if (std::math::abs(cells[i]) > best) then {
                        best = std::math::abs(cells[i]);
                    }
                }
                return best;
            } end function max_abs

            function frobenius_norm() const -> T {
                T: total = T(0);
                for (long int: i = 0; i < cells.size(); i++) {
                    total += cells[i] * cells[i];
                }
                return std::math::sqrt(total);
            } end function frobenius_norm

            function norm() const -> T {
                return frobenius_norm();
            } end function norm

            function norm_1() const -> T {
                T: best = T(0);
                for (long int: j = 0; j < col_count; j++) {
                    T: s = T(0);
                    for (long int: i = 0; i < row_count; i++) {
                        s += std::math::abs(cell(i, j));
                    }
                    if (s > best) then {
                        best = s;
                    }
                }
                return best;
            } end function norm_1

            function norm_inf() const -> T {
                T: best = T(0);
                for (long int: i = 0; i < row_count; i++) {
                    T: s = T(0);
                    for (long int: j = 0; j < col_count; j++) {
                        s += std::math::abs(cell(i, j));
                    }
                    if (s > best) then {
                        best = s;
                    }
                }
                return best;
            } end function norm_inf

            function norm_2() const -> T {
                const DynVector<T>: s = singular_values();
                return s.empty() ? T(0) : s[0];
            } end function norm_2

            function approx_equal(const DynMatrix&: o, const T&: tolerance) const -> bool {
                if (o.row_count != row_count || o.col_count != col_count) then {
                    return false;
                }
                for (long int: i = 0; i < cells.size(); i++) {
                    if (std::math::abs(cells[i] - o.cells[i]) > tolerance) then {
                        return false;
                    }
                }
                return true;
            } end function approx_equal

            function approx_equal(const DynMatrix&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(1024) * scale());
            } end function approx_equal

            function is_symmetric(const T&: tolerance) const -> bool {
                if (!is_square()) then {
                    return false;
                }
                for (long int: i = 0; i < row_count; i++) {
                    for (long int: j = i + 1; j < col_count; j++) {
                        if (std::math::abs(cell(i, j) - cell(j, i)) > tolerance) then {
                            return false;
                        }
                    }
                }
                return true;
            } end function is_symmetric

            function is_symmetric() const -> bool {
                return is_symmetric(detail::tolerance<T>() * T(64) * scale());
            } end function is_symmetric

            function is_diagonal() const -> bool {
                for (long int: i = 0; i < row_count; i++) {
                    for (long int: j = 0; j < col_count; j++) {
                        if (i != j && cell(i, j) != T(0)) then {
                            return false;
                        }
                    }
                }
                return true;
            } end function is_diagonal

            function is_identity() const -> bool {
                if (!is_square()) then {
                    return false;
                }
                return approx_equal(identity(row_count), detail::tolerance<T>() * T(64));
            } end function is_identity

            function is_upper_triangular() const -> bool {
                for (long int: i = 1; i < row_count; i++) {
                    for (long int: j = 0; j < i && j < col_count; j++) {
                        if (cell(i, j) != T(0)) then {
                            return false;
                        }
                    }
                }
                return true;
            } end function is_upper_triangular

            function is_lower_triangular() const -> bool {
                for (long int: i = 0; i < row_count; i++) {
                    for (long int: j = i + 1; j < col_count; j++) {
                        if (cell(i, j) != T(0)) then {
                            return false;
                        }
                    }
                }
                return true;
            } end function is_lower_triangular

            function is_orthogonal() const -> bool {
                if (!is_square()) then {
                    return false;
                }
                return (transpose() * *this).approx_equal(identity(row_count), detail::tolerance<T>() * T(1024));
            } end function is_orthogonal

            function lu() const -> LUDecomposition<T> {
                require_square("lu()");
                const long int: n = row_count;
                DynMatrix: a = *this;
                LUDecomposition<T>: out;
                for (long int: i = 0; i < n; i++) {
                    out.permutation.push_back(i);
                }
                const T: limit = detail::tolerance<T>() * scale() * T(n > 0 ? n : 1);
                for (long int: k = 0; k < n; k++) {
                    long int: p = k;
                    T: best = std::math::abs(a.cell(k, k));
                    for (long int: i = k + 1; i < n; i++) {
                        if (std::math::abs(a.cell(i, k)) > best) then {
                            best = std::math::abs(a.cell(i, k));
                            p = i;
                        }
                    }
                    if (best <= limit) then {
                        out.singular = true;
                        a.cell(k, k) = T(0);
                        continue;
                    }
                    if (p != k) then {
                        a.swap_rows(p, k);
                        const long int: held = out.permutation[p];
                        out.permutation[p] = out.permutation[k];
                        out.permutation[k] = held;
                        out.sign = -out.sign;
                    }
                    for (long int: i = k + 1; i < n; i++) {
                        a.cell(i, k) /= a.cell(k, k);
                        const T: f = a.cell(i, k);
                        for (long int: j = k + 1; j < n; j++) {
                            a.cell(i, j) -= f * a.cell(k, j);
                        }
                    }
                }
                out.lower = DynMatrix::identity(n);
                out.upper = DynMatrix(n, n);
                for (long int: i = 0; i < n; i++) {
                    for (long int: j = 0; j < n; j++) {
                        if (j < i) then {
                            out.lower.cell(i, j) = a.cell(i, j);
                        } else then {
                            out.upper.cell(i, j) = a.cell(i, j);
                        }
                    }
                }
                return out;
            } end function lu

            function determinant() const -> T {
                require_square("determinant()");
                const long int: n = row_count;
                if (n == 0) then {
                    return T(1);
                }
                if (n == 1) then {
                    return cell(0, 0);
                }
                if (n == 2) then {
                    return cell(0, 0) * cell(1, 1) - cell(0, 1) * cell(1, 0);
                }
                if (n == 3) then {
                    return cell(0, 0) * (cell(1, 1) * cell(2, 2) - cell(1, 2) * cell(2, 1))
                         - cell(0, 1) * (cell(1, 0) * cell(2, 2) - cell(1, 2) * cell(2, 0))
                         + cell(0, 2) * (cell(1, 0) * cell(2, 1) - cell(1, 1) * cell(2, 0));
                }
                return lu().determinant();
            } end function determinant

            function is_invertible() const -> bool {
                return is_square() && !lu().singular;
            } end function is_invertible

            function is_singular() const -> bool {
                return !is_invertible();
            } end function is_singular

            function inverse() const -> DynMatrix {
                require_square("inverse()");
                return lu().inverse();
            } end function inverse

            function solve(const DynVector<T>&: b) const -> DynVector<T> {
                require_square("solve()");
                return lu().solve(b);
            } end function solve

            function solve(const DynMatrix&: b) const -> DynMatrix {
                require_square("solve()");
                return lu().solve(b);
            } end function solve

            function least_squares(const DynVector<T>&: b) const -> DynVector<T> {
                if (b.size() != row_count) then {
                    detail::fail(static_cast<string>(`least_squares() needs a vector of size ${row_count}, not ${b.size()}`));
                }
                const DynMatrix: at = transpose();
                return (at * *this).solve(at * b);
            } end function least_squares

            function rank() const -> long int {
                DynMatrix: a = *this;
                const T: limit = detail::tolerance<T>() * scale() * T((row_count > col_count ? row_count : col_count) + 1) * T(16);
                long int: r = 0;
                for (long int: c = 0; c < col_count && r < row_count; c++) {
                    long int: p = r;
                    for (long int: i = r + 1; i < row_count; i++) {
                        if (std::math::abs(a.cell(i, c)) > std::math::abs(a.cell(p, c))) then {
                            p = i;
                        }
                    }
                    if (std::math::abs(a.cell(p, c)) <= limit) then {
                        continue;
                    }
                    a.swap_rows(p, r);
                    for (long int: i = r + 1; i < row_count; i++) {
                        const T: f = a.cell(i, c) / a.cell(r, c);
                        for (long int: j = c; j < col_count; j++) {
                            a.cell(i, j) -= f * a.cell(r, j);
                        }
                    }
                    r++;
                }
                return r;
            } end function rank

            function row_echelon() const -> DynMatrix {
                DynMatrix: a = *this;
                const T: limit = detail::tolerance<T>() * scale() * T(16);
                long int: r = 0;
                for (long int: c = 0; c < col_count && r < row_count; c++) {
                    long int: p = r;
                    for (long int: i = r + 1; i < row_count; i++) {
                        if (std::math::abs(a.cell(i, c)) > std::math::abs(a.cell(p, c))) then {
                            p = i;
                        }
                    }
                    if (std::math::abs(a.cell(p, c)) <= limit) then {
                        for (long int: i = r; i < row_count; i++) {
                            a.cell(i, c) = T(0);
                        }
                        continue;
                    }
                    a.swap_rows(p, r);
                    const T: pivot = a.cell(r, c);
                    for (long int: j = c; j < col_count; j++) {
                        a.cell(r, j) /= pivot;
                    }
                    for (long int: i = 0; i < row_count; i++) {
                        if (i == r) then {
                            continue;
                        }
                        const T: f = a.cell(i, c);
                        for (long int: j = c; j < col_count; j++) {
                            a.cell(i, j) -= f * a.cell(r, j);
                        }
                    }
                    r++;
                }
                return a;
            } end function row_echelon

            function power(long int: n) const -> DynMatrix {
                require_square("power()");
                if (n < 0) then {
                    return inverse().power(-n);
                }
                DynMatrix: result = identity(row_count);
                DynMatrix: base = *this;
                long int: e = n;
                while (e > 0) {
                    if (e % 2 == 1) then {
                        result = result * base;
                    }
                    base = base * base;
                    e /= 2;
                }
                return result;
            } end function power

            function qr() const -> QRDecomposition<T> {
                const long int: m = row_count;
                const long int: n = col_count;
                QRDecomposition<T>: out;
                out.r = *this;
                out.q = identity(m);
                const long int: steps = m - 1 < n ? m - 1 : n;
                for (long int: k = 0; k < steps; k++) {
                    T: norm_sq = T(0);
                    for (long int: i = k; i < m; i++) {
                        norm_sq += out.r.cell(i, k) * out.r.cell(i, k);
                    }
                    if (norm_sq == T(0)) then {
                        continue;
                    }
                    const T: alpha = -detail::sign_of(out.r.cell(k, k)) * std::math::sqrt(norm_sq);
                    DynVector<T>: v(m - k);
                    v[0] = out.r.cell(k, k) - alpha;
                    for (long int: i = 1; i < m - k; i++) {
                        v[i] = out.r.cell(k + i, k);
                    }
                    const T: vv = v.dot(v);
                    if (vv == T(0)) then {
                        continue;
                    }
                    for (long int: j = 0; j < n; j++) {
                        T: s = T(0);
                        for (long int: i = 0; i < m - k; i++) {
                            s += v[i] * out.r.cell(k + i, j);
                        }
                        const T: f = T(2) * s / vv;
                        for (long int: i = 0; i < m - k; i++) {
                            out.r.cell(k + i, j) -= f * v[i];
                        }
                    }
                    for (long int: i = 0; i < m; i++) {
                        T: s = T(0);
                        for (long int: l = 0; l < m - k; l++) {
                            s += out.q.cell(i, k + l) * v[l];
                        }
                        const T: f = T(2) * s / vv;
                        for (long int: l = 0; l < m - k; l++) {
                            out.q.cell(i, k + l) -= f * v[l];
                        }
                    }
                    for (long int: i = k + 1; i < m; i++) {
                        out.r.cell(i, k) = T(0);
                    }
                }
                return out;
            } end function qr

            function cholesky() const -> DynMatrix {
                require_square("cholesky()");
                if (!is_symmetric()) then {
                    detail::fail("cholesky() needs a symmetric matrix");
                }
                const long int: n = row_count;
                DynMatrix: l(n, n);
                for (long int: j = 0; j < n; j++) {
                    T: d = cell(j, j);
                    for (long int: k = 0; k < j; k++) {
                        d -= l.cell(j, k) * l.cell(j, k);
                    }
                    if (d <= T(0)) then {
                        detail::fail("cholesky() needs a positive-definite matrix");
                    }
                    l.cell(j, j) = std::math::sqrt(d);
                    for (long int: i = j + 1; i < n; i++) {
                        T: s = cell(i, j);
                        for (long int: k = 0; k < j; k++) {
                            s -= l.cell(i, k) * l.cell(j, k);
                        }
                        l.cell(i, j) = s / l.cell(j, j);
                    }
                }
                return l;
            } end function cholesky

            function is_positive_definite() const -> bool {
                if (!is_square() || !is_symmetric()) then {
                    return false;
                }
                const SymmetricEigen<T>: e = symmetric_eigen();
                for (long int: i = 0; i < e.values.size(); i++) {
                    if (e.values[i] <= T(0)) then {
                        return false;
                    }
                }
                return true;
            } end function is_positive_definite

            function symmetric_eigen() const -> SymmetricEigen<T> {
                require_square("symmetric_eigen()");
                if (!is_symmetric(detail::tolerance<T>() * T(1024) * scale())) then {
                    detail::fail("symmetric_eigen() needs a symmetric matrix; use eigenvalues() for any square matrix");
                }
                const long int: n = row_count;
                DynMatrix: a = *this;
                DynMatrix: v = identity(n);
                const T: limit = detail::tolerance<T>() * detail::tolerance<T>() * scale() * scale();
                for (int: sweep = 0; sweep < 100; sweep++) {
                    T: off = T(0);
                    for (long int: p = 0; p < n; p++) {
                        for (long int: q = p + 1; q < n; q++) {
                            off += a.cell(p, q) * a.cell(p, q);
                        }
                    }
                    if (off <= limit) then {
                        break;
                    }
                    for (long int: p = 0; p < n; p++) {
                        for (long int: q = p + 1; q < n; q++) {
                            const T: apq = a.cell(p, q);
                            if (apq == T(0)) then {
                                continue;
                            }
                            const T: theta = (a.cell(q, q) - a.cell(p, p)) / (T(2) * apq);
                            const T: t = detail::sign_of(theta) / (std::math::abs(theta) + std::math::sqrt(theta * theta + T(1)));
                            const T: c = T(1) / std::math::sqrt(t * t + T(1));
                            const T: s = t * c;
                            for (long int: k = 0; k < n; k++) {
                                const T: akp = a.cell(k, p);
                                const T: akq = a.cell(k, q);
                                a.cell(k, p) = c * akp - s * akq;
                                a.cell(k, q) = s * akp + c * akq;
                            }
                            for (long int: k = 0; k < n; k++) {
                                const T: apk = a.cell(p, k);
                                const T: aqk = a.cell(q, k);
                                a.cell(p, k) = c * apk - s * aqk;
                                a.cell(q, k) = s * apk + c * aqk;
                            }
                            for (long int: k = 0; k < n; k++) {
                                const T: vkp = v.cell(k, p);
                                const T: vkq = v.cell(k, q);
                                v.cell(k, p) = c * vkp - s * vkq;
                                v.cell(k, q) = s * vkp + c * vkq;
                            }
                        }
                    }
                }
                SymmetricEigen<T>: out;
                out.values = DynVector<T>(n);
                out.vectors = DynMatrix(n, n);
                std::collections::Vector<long int>: order;
                for (long int: i = 0; i < n; i++) {
                    order.push_back(i);
                }
                for (long int: i = 1; i < n; i++) {
                    long int: j = i;
                    while (j > 0 && a.cell(order[j], order[j]) < a.cell(order[j - 1], order[j - 1])) {
                        const long int: held = order[j];
                        order[j] = order[j - 1];
                        order[j - 1] = held;
                        j--;
                    }
                }
                for (long int: i = 0; i < n; i++) {
                    out.values[i] = a.cell(order[i], order[i]);
                    DynVector<T>: col = v.column(order[i]);
                    long int: big = col.abs().argmax();
                    if (col[big] < T(0)) then {
                        col = -col;
                    }
                    out.vectors.set_column(i, col);
                }
                return out;
            } end function symmetric_eigen

            function eigenvalues() const -> std::collections::Vector<std::math::Complex<T>> {
                require_square("eigenvalues()");
                if (row_count == 0) then {
                    return std::collections::Vector<std::math::Complex<T>>();
                }
                if (is_symmetric()) then {
                    const SymmetricEigen<T>: e = symmetric_eigen();
                    std::collections::Vector<std::math::Complex<T>>: out;
                    for (long int: i = 0; i < e.values.size(); i++) {
                        out.push_back(std::math::Complex<T>(e.values[i], T(0)));
                    }
                    return out;
                }
                return hessenberg_eigenvalues();
            } end function eigenvalues

            function real_eigenvalues() const -> DynVector<T> {
                const std::collections::Vector<std::math::Complex<T>>: all = eigenvalues();
                DynVector<T>: out;
                const T: limit = detail::tolerance<T>() * T(1024) * scale();
                for (long int: i = 0; i < all.size(); i++) {
                    if (std::math::abs(all[i].imaginary()) <= limit) then {
                        out.push_back(all[i].real());
                    }
                }
                return out;
            } end function real_eigenvalues

            function eigenvector(const T&: value) const -> DynVector<T> {
                require_square("eigenvector()");
                const long int: n = row_count;
                const T: sc = scale();
                T: shift = value + detail::tolerance<T>() * T(1024) * sc;
                DynVector<T>: x(n, T(1));
                for (long int: i = 0; i < n; i++) {
                    x[i] = T(1) + T(i) / T(n + 1);
                }
                x.normalize();
                for (int: attempt = 0; attempt < 8; attempt++) {
                    DynMatrix: shifted = *this;
                    for (long int: i = 0; i < n; i++) {
                        shifted.cell(i, i) -= shift;
                    }
                    const LUDecomposition<T>: f = shifted.lu();
                    if (f.singular) then {
                        shift += detail::tolerance<T>() * T(65536) * sc;
                        continue;
                    }
                    for (int: step = 0; step < 32; step++) {
                        DynVector<T>: next = f.solve(x);
                        const T: len = next.length();
                        if (len == T(0)) then {
                            break;
                        }
                        next /= len;
                        const T: change = (next - x).norm_inf() < (next + x).norm_inf() ? (next - x).norm_inf() : (next + x).norm_inf();
                        x = next;
                        if (change <= detail::tolerance<T>() * T(64)) then {
                            break;
                        }
                    }
                    break;
                }
                const long int: big = x.abs().argmax();
                if (x[big] < T(0)) then {
                    x = -x;
                }
                return x;
            } end function eigenvector

            function eigenvectors() const -> DynMatrix {
                require_square("eigenvectors()");
                if (is_symmetric()) then {
                    return symmetric_eigen().vectors;
                }
                const DynVector<T>: values = real_eigenvalues();
                DynMatrix: out(row_count, values.size());
                for (long int: i = 0; i < values.size(); i++) {
                    out.set_column(i, eigenvector(values[i]));
                }
                return out;
            } end function eigenvectors

            function svd() const -> SingularValueDecomposition<T> {
                const long int: k = row_count < col_count ? row_count : col_count;
                const SymmetricEigen<T>: e = (transpose() * *this).symmetric_eigen();
                SingularValueDecomposition<T>: out;
                out.singular_values = DynVector<T>(k);
                out.u = DynMatrix(row_count, k);
                out.v = DynMatrix(col_count, k);
                const T: limit = detail::tolerance<T>() * T(1024) * scale();
                for (long int: i = 0; i < k; i++) {
                    const long int: source = col_count - 1 - i;
                    T: ev = e.values[source];
                    if (ev < T(0)) then {
                        ev = T(0);
                    }
                    const T: sigma = std::math::sqrt(ev);
                    out.singular_values[i] = sigma;
                    const DynVector<T>: vi = e.vectors.column(source);
                    out.v.set_column(i, vi);
                    if (sigma > limit) then {
                        out.u.set_column(i, (*this * vi) / sigma);
                    }
                }
                return out;
            } end function svd

            function singular_values() const -> DynVector<T> {
                return svd().singular_values;
            } end function singular_values

            function condition_number() const -> T {
                const DynVector<T>: s = singular_values();
                if (s.empty() || s[s.size() - 1] == T(0)) then {
                    if constexpr (std::traits::is_builtin_float<T>) then {
                        return std::traits::float_traits<T>::infinity();
                    } else then {
                        detail::fail("condition_number() of a singular matrix is infinite");
                    }
                }
                return s[0] / s[s.size() - 1];
            } end function condition_number

            function pseudo_inverse() const -> DynMatrix {
                const SingularValueDecomposition<T>: d = svd();
                const T: limit = detail::tolerance<T>() * T(1024) * scale() * T(row_count > col_count ? row_count : col_count);
                DynMatrix: out(col_count, row_count);
                for (long int: i = 0; i < d.singular_values.size(); i++) {
                    if (d.singular_values[i] <= limit) then {
                        continue;
                    }
                    const DynVector<T>: vi = d.v.column(i);
                    const DynVector<T>: ui = d.u.column(i);
                    out += vi.outer(ui) / d.singular_values[i];
                }
                return out;
            } end function pseudo_inverse

            function null_space() const -> DynMatrix {
                const SymmetricEigen<T>: e = (transpose() * *this).symmetric_eigen();
                const T: limit = detail::tolerance<T>() * T(4096) * scale() * scale();
                std::collections::Vector<DynVector<T>>: basis;
                for (long int: i = 0; i < e.values.size(); i++) {
                    if (std::math::abs(e.values[i]) <= limit) then {
                        basis.push_back(e.vectors.column(i));
                    }
                }
                if (basis.empty()) then {
                    return DynMatrix(col_count, 0);
                }
                return from_columns(basis);
            } end function null_space

            function to_string() const -> string {
                string: out = "[";
                for (long int: i = 0; i < row_count; i++) {
                    if (i > 0) then {
                        out += ", ";
                    }
                    out += "[";
                    for (long int: j = 0; j < col_count; j++) {
                        if (j > 0) then {
                            out += ", ";
                        }
                        out += std::core::to_string(cell(i, j));
                    }
                    out += "]";
                }
                out += "]";
                return out;
            } end function to_string
        } end class DynMatrix

        template <typename T>
        operator(*) function(const T&: k, const DynMatrix<T>&: m) -> DynMatrix<T> {
            return m * k;
        }

        template <typename T, int R, int C>
        struct Matrix {
            static_assert(std::traits::is_float<T>, "linalg matrices need a real float type, such as float or double, not an integer or other type");
            static_assert(R > 0 && C > 0, "a Matrix needs at least one row and one column");
            array[R * C] T: cells;

            constructor() {
                for (long int: i = 0; i < R * C; i++) {
                    cells[i] = T(0);
                }
            }

            constructor(const array[R * C] T&: values) : cells = values { }

            template <typename... Ts>
            constructor(Ts...: values) {
                static_assert(countof(values) == R * C, "a Matrix<T, R, C> is made from exactly R * C values, row by row");
                array[R * C] T: given = {T(values)...};
                cells = given;
            }

            static function zero() -> Matrix {
                return Matrix();
            } end function zero

            static function filled(const T&: value) -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R * C; i++) {
                    out.cells[i] = value;
                }
                return out;
            } end function filled

            static function identity() -> Matrix {
                static_assert(R == C, "identity() needs a square matrix");
                Matrix: out;
                for (long int: i = 0; i < R; i++) {
                    out.cells[i * C + i] = T(1);
                }
                return out;
            } end function identity

            static function diagonal(const VectorN<T, R>&: values) -> Matrix {
                static_assert(R == C, "diagonal() needs a square matrix");
                Matrix: out;
                for (long int: i = 0; i < R; i++) {
                    out.cells[i * C + i] = values[i];
                }
                return out;
            } end function diagonal

            static function from_rows(const array[R] VectorN<T, C>&: rows) -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R; i++) {
                    out.set_row(i, rows[i]);
                }
                return out;
            } end function from_rows

            static function from_columns(const array[C] VectorN<T, R>&: columns) -> Matrix {
                Matrix: out;
                for (long int: j = 0; j < C; j++) {
                    out.set_column(j, columns[j]);
                }
                return out;
            } end function from_columns

            static function from_dyn(const DynMatrix<T>&: m) -> Matrix {
                if (m.rows() != R || m.cols() != C) then {
                    detail::fail(static_cast<string>(`can't make a ${R}x${C} Matrix from a ${m.rows()}x${m.cols()} DynMatrix`));
                }
                Matrix: out;
                for (long int: i = 0; i < R; i++) {
                    for (long int: j = 0; j < C; j++) {
                        out.cells[i * C + j] = m(i, j);
                    }
                }
                return out;
            } end function from_dyn

            static function rows() -> long int {
                return R;
            } end function rows

            static function cols() -> long int {
                return C;
            } end function cols

            static function size() -> long int {
                return R * C;
            } end function size

            static function is_square() -> bool {
                return R == C;
            } end function is_square

            operator(()) function(long int: r, long int: c) -> T& {
                if (r < 0 || r >= R || c < 0 || c >= C) then {
                    detail::fail(static_cast<string>(`element (${r}, ${c}) is out of range for a ${R}x${C} matrix`));
                }
                return cells[r * C + c];
            }

            operator(()) function(long int: r, long int: c) const -> const T& {
                if (r < 0 || r >= R || c < 0 || c >= C) then {
                    detail::fail(static_cast<string>(`element (${r}, ${c}) is out of range for a ${R}x${C} matrix`));
                }
                return cells[r * C + c];
            }

            function at(long int: r, long int: c) -> T& {
                return (*this)(r, c);
            } end function at

            function at(long int: r, long int: c) const -> const T& {
                return (*this)(r, c);
            } end function at

            function row(long int: r) const -> VectorN<T, C> {
                VectorN<T, C>: out;
                for (long int: j = 0; j < C; j++) {
                    out[j] = (*this)(r, j);
                }
                return out;
            } end function row

            function column(long int: c) const -> VectorN<T, R> {
                VectorN<T, R>: out;
                for (long int: i = 0; i < R; i++) {
                    out[i] = (*this)(i, c);
                }
                return out;
            } end function column

            function set_row(long int: r, const VectorN<T, C>&: values) -> void {
                for (long int: j = 0; j < C; j++) {
                    (*this)(r, j) = values[j];
                }
            } end function set_row

            function set_column(long int: c, const VectorN<T, R>&: values) -> void {
                for (long int: i = 0; i < R; i++) {
                    (*this)(i, c) = values[i];
                }
            } end function set_column

            function swap_rows(long int: a, long int: b) -> void {
                const VectorN<T, C>: held = row(a);
                set_row(a, row(b));
                set_row(b, held);
            } end function swap_rows

            function swap_columns(long int: a, long int: b) -> void {
                const VectorN<T, R>: held = column(a);
                set_column(a, column(b));
                set_column(b, held);
            } end function swap_columns

            operator(+) function(const Matrix&: o) const -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R * C; i++) {
                    out.cells[i] = cells[i] + o.cells[i];
                }
                return out;
            }

            operator(-) function(const Matrix&: o) const -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R * C; i++) {
                    out.cells[i] = cells[i] - o.cells[i];
                }
                return out;
            }

            operator(-) function() const -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R * C; i++) {
                    out.cells[i] = -cells[i];
                }
                return out;
            }

            operator(*) function(const T&: k) const -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R * C; i++) {
                    out.cells[i] = cells[i] * k;
                }
                return out;
            }

            operator(/) function(const T&: k) const -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R * C; i++) {
                    out.cells[i] = cells[i] / k;
                }
                return out;
            }

            template <int K>
            operator(*) function(const Matrix<T, C, K>&: o) const -> Matrix<T, R, K> {
                Matrix<T, R, K>: out;
                for (long int: i = 0; i < R; i++) {
                    for (long int: j = 0; j < K; j++) {
                        T: s = T(0);
                        for (long int: k = 0; k < C; k++) {
                            s += cells[i * C + k] * o.cells[k * K + j];
                        }
                        out.cells[i * K + j] = s;
                    }
                }
                return out;
            }

            operator(*) function(const VectorN<T, C>&: v) const -> VectorN<T, R> {
                VectorN<T, R>: out;
                for (long int: i = 0; i < R; i++) {
                    T: s = T(0);
                    for (long int: j = 0; j < C; j++) {
                        s += cells[i * C + j] * v.data[j];
                    }
                    out.data[i] = s;
                }
                return out;
            }

            operator(+=) function(const Matrix&: o) -> Matrix& {
                for (long int: i = 0; i < R * C; i++) {
                    cells[i] += o.cells[i];
                }
                return *this;
            }

            operator(-=) function(const Matrix&: o) -> Matrix& {
                for (long int: i = 0; i < R * C; i++) {
                    cells[i] -= o.cells[i];
                }
                return *this;
            }

            operator(*=) function(const T&: k) -> Matrix& {
                for (long int: i = 0; i < R * C; i++) {
                    cells[i] *= k;
                }
                return *this;
            }

            operator(/=) function(const T&: k) -> Matrix& {
                for (long int: i = 0; i < R * C; i++) {
                    cells[i] /= k;
                }
                return *this;
            }

            operator(*=) function(const Matrix&: o) -> Matrix& {
                static_assert(R == C, "'*=' with a matrix needs a square matrix");
                *this = *this * o;
                return *this;
            }

            operator(==) function(const Matrix&: o) const -> bool {
                for (long int: i = 0; i < R * C; i++) {
                    if (cells[i] != o.cells[i]) then {
                        return false;
                    }
                }
                return true;
            }

            operator(!=) function(const Matrix&: o) const -> bool {
                return !(*this == o);
            }

            function hadamard(const Matrix&: o) const -> Matrix {
                Matrix: out;
                for (long int: i = 0; i < R * C; i++) {
                    out.cells[i] = cells[i] * o.cells[i];
                }
                return out;
            } end function hadamard

            function transpose() const -> Matrix<T, C, R> {
                Matrix<T, C, R>: out;
                for (long int: i = 0; i < R; i++) {
                    for (long int: j = 0; j < C; j++) {
                        out.cells[j * R + i] = cells[i * C + j];
                    }
                }
                return out;
            } end function transpose

            function trace() const -> T {
                static_assert(R == C, "trace() needs a square matrix");
                T: total = T(0);
                for (long int: i = 0; i < R; i++) {
                    total += cells[i * C + i];
                }
                return total;
            } end function trace

            function to_dyn() const -> DynMatrix<T> {
                DynMatrix<T>: out(R, C);
                for (long int: i = 0; i < R; i++) {
                    for (long int: j = 0; j < C; j++) {
                        out(i, j) = cells[i * C + j];
                    }
                }
                return out;
            } end function to_dyn

            function determinant() const -> T {
                static_assert(R == C, "determinant() needs a square matrix");
                return to_dyn().determinant();
            } end function determinant

            function inverse() const -> Matrix {
                static_assert(R == C, "inverse() needs a square matrix");
                if constexpr (R == 2) then {
                    const T: det = determinant();
                    if (det == T(0)) then {
                        detail::fail("inverse() of a singular matrix: its determinant is 0");
                    }
                    return Matrix(cells[3] / det, -cells[1] / det, -cells[2] / det, cells[0] / det);
                } else then {
                    return from_dyn(to_dyn().inverse());
                }
            } end function inverse

            function is_invertible() const -> bool {
                return R == C && to_dyn().is_invertible();
            } end function is_invertible

            function is_singular() const -> bool {
                return !is_invertible();
            } end function is_singular

            function rank() const -> long int {
                return to_dyn().rank();
            } end function rank

            function solve(const VectorN<T, R>&: b) const -> VectorN<T, C> {
                static_assert(R == C, "solve() needs a square matrix; use least_squares() otherwise");
                return VectorN<T, C>::from_dyn(to_dyn().solve(b.to_dyn()));
            } end function solve

            function least_squares(const VectorN<T, R>&: b) const -> VectorN<T, C> {
                return VectorN<T, C>::from_dyn(to_dyn().least_squares(b.to_dyn()));
            } end function least_squares

            function power(long int: n) const -> Matrix {
                static_assert(R == C, "power() needs a square matrix");
                return from_dyn(to_dyn().power(n));
            } end function power

            function minor(long int: r, long int: c) const -> T {
                static_assert(R == C, "minor() needs a square matrix");
                return to_dyn().minor(r, c);
            } end function minor

            function cofactor(long int: r, long int: c) const -> T {
                static_assert(R == C, "cofactor() needs a square matrix");
                return to_dyn().cofactor(r, c);
            } end function cofactor

            function adjugate() const -> Matrix {
                static_assert(R == C, "adjugate() needs a square matrix");
                return from_dyn(to_dyn().adjugate());
            } end function adjugate

            function lu() const -> LUDecomposition<T> {
                static_assert(R == C, "lu() needs a square matrix");
                return to_dyn().lu();
            } end function lu

            function qr() const -> QRDecomposition<T> {
                return to_dyn().qr();
            } end function qr

            function cholesky() const -> Matrix {
                static_assert(R == C, "cholesky() needs a square matrix");
                return from_dyn(to_dyn().cholesky());
            } end function cholesky

            function svd() const -> SingularValueDecomposition<T> {
                return to_dyn().svd();
            } end function svd

            function singular_values() const -> DynVector<T> {
                return to_dyn().singular_values();
            } end function singular_values

            function condition_number() const -> T {
                return to_dyn().condition_number();
            } end function condition_number

            function pseudo_inverse() const -> Matrix<T, C, R> {
                return Matrix<T, C, R>::from_dyn(to_dyn().pseudo_inverse());
            } end function pseudo_inverse

            function symmetric_eigen() const -> SymmetricEigen<T> {
                static_assert(R == C, "symmetric_eigen() needs a square matrix");
                return to_dyn().symmetric_eigen();
            } end function symmetric_eigen

            function eigenvalues() const -> std::collections::Vector<std::math::Complex<T>> {
                static_assert(R == C, "eigenvalues() needs a square matrix");
                return to_dyn().eigenvalues();
            } end function eigenvalues

            function real_eigenvalues() const -> DynVector<T> {
                static_assert(R == C, "real_eigenvalues() needs a square matrix");
                return to_dyn().real_eigenvalues();
            } end function real_eigenvalues

            function eigenvector(const T&: value) const -> VectorN<T, R> {
                static_assert(R == C, "eigenvector() needs a square matrix");
                return VectorN<T, R>::from_dyn(to_dyn().eigenvector(value));
            } end function eigenvector

            function eigenvectors() const -> DynMatrix<T> {
                static_assert(R == C, "eigenvectors() needs a square matrix");
                return to_dyn().eigenvectors();
            } end function eigenvectors

            function max_abs() const -> T {
                T: best = T(0);
                for (long int: i = 0; i < R * C; i++) {
                    if (std::math::abs(cells[i]) > best) then {
                        best = std::math::abs(cells[i]);
                    }
                }
                return best;
            } end function max_abs

            function frobenius_norm() const -> T {
                T: total = T(0);
                for (long int: i = 0; i < R * C; i++) {
                    total += cells[i] * cells[i];
                }
                return std::math::sqrt(total);
            } end function frobenius_norm

            function norm() const -> T {
                return frobenius_norm();
            } end function norm

            function norm_1() const -> T {
                return to_dyn().norm_1();
            } end function norm_1

            function norm_inf() const -> T {
                return to_dyn().norm_inf();
            } end function norm_inf

            function norm_2() const -> T {
                return to_dyn().norm_2();
            } end function norm_2

            function approx_equal(const Matrix&: o, const T&: tolerance) const -> bool {
                for (long int: i = 0; i < R * C; i++) {
                    if (std::math::abs(cells[i] - o.cells[i]) > tolerance) then {
                        return false;
                    }
                }
                return true;
            } end function approx_equal

            function approx_equal(const Matrix&: o) const -> bool {
                return to_dyn().approx_equal(o.to_dyn());
            } end function approx_equal

            function is_symmetric() const -> bool {
                return to_dyn().is_symmetric();
            } end function is_symmetric

            function is_diagonal() const -> bool {
                return to_dyn().is_diagonal();
            } end function is_diagonal

            function is_identity() const -> bool {
                return to_dyn().is_identity();
            } end function is_identity

            function is_upper_triangular() const -> bool {
                return to_dyn().is_upper_triangular();
            } end function is_upper_triangular

            function is_lower_triangular() const -> bool {
                return to_dyn().is_lower_triangular();
            } end function is_lower_triangular

            function is_orthogonal() const -> bool {
                return to_dyn().is_orthogonal();
            } end function is_orthogonal

            function is_positive_definite() const -> bool {
                return to_dyn().is_positive_definite();
            } end function is_positive_definite

            function to_string() const -> string {
                return to_dyn().to_string();
            } end function to_string
        } end struct Matrix

        template <typename T, int R, int C>
        operator(*) function(const T&: k, const Matrix<T, R, C>&: m) -> Matrix<T, R, C> {
            return m * k;
        }

        template <typename T, int N>
        using SquareMatrix = Matrix<T, N, N>;

        template <typename T>
        using Matrix2 = Matrix<T, 2, 2>;

        template <typename T>
        using Matrix3 = Matrix<T, 3, 3>;

        template <typename T>
        using Matrix4 = Matrix<T, 4, 4>;

        template <typename T>
        using Matrix2x3 = Matrix<T, 2, 3>;

        template <typename T>
        using Matrix3x2 = Matrix<T, 3, 2>;

        template <typename T>
        using Matrix3x4 = Matrix<T, 3, 4>;

        template <typename T>
        using Matrix4x3 = Matrix<T, 4, 3>;

        template <typename T>
        operator(*) function(const Matrix<T, 2, 2>&: m, const Vector2<T>&: v) -> Vector2<T> {
            return Vector2<T>(m.cells[0] * v.x + m.cells[1] * v.y, m.cells[2] * v.x + m.cells[3] * v.y);
        }

        template <typename T>
        operator(*) function(const Matrix<T, 3, 3>&: m, const Vector3<T>&: v) -> Vector3<T> {
            return Vector3<T>(m.cells[0] * v.x + m.cells[1] * v.y + m.cells[2] * v.z,
                              m.cells[3] * v.x + m.cells[4] * v.y + m.cells[5] * v.z,
                              m.cells[6] * v.x + m.cells[7] * v.y + m.cells[8] * v.z);
        }

        template <typename T>
        operator(*) function(const Matrix<T, 4, 4>&: m, const Vector4<T>&: v) -> Vector4<T> {
            return Vector4<T>(m.cells[0] * v.x + m.cells[1] * v.y + m.cells[2] * v.z + m.cells[3] * v.w,
                              m.cells[4] * v.x + m.cells[5] * v.y + m.cells[6] * v.z + m.cells[7] * v.w,
                              m.cells[8] * v.x + m.cells[9] * v.y + m.cells[10] * v.z + m.cells[11] * v.w,
                              m.cells[12] * v.x + m.cells[13] * v.y + m.cells[14] * v.z + m.cells[15] * v.w);
        }

        template <typename T>
        function transform_point(const Matrix<T, 4, 4>&: m, const Vector3<T>&: p) -> Vector3<T> {
            return (m * Vector4<T>(p.x, p.y, p.z, T(1))).project();
        } end function transform_point

        template <typename T>
        function transform_direction(const Matrix<T, 4, 4>&: m, const Vector3<T>&: d) -> Vector3<T> {
            return (m * Vector4<T>(d.x, d.y, d.z, T(0))).xyz();
        } end function transform_direction

        template <typename T>
        function rotation2(const T&: radians) -> Matrix<T, 2, 2> {
            const T: c = std::math::cos(radians);
            const T: s = std::math::sin(radians);
            return Matrix<T, 2, 2>(c, -s, s, c);
        } end function rotation2

        template <typename T>
        function rotation3(const Vector3<T>&: axis, const T&: radians) -> Matrix<T, 3, 3> {
            const Vector3<T>: k = axis.normalized();
            const T: c = std::math::cos(radians);
            const T: s = std::math::sin(radians);
            const T: t = T(1) - c;
            return Matrix<T, 3, 3>(t * k.x * k.x + c, t * k.x * k.y - s * k.z, t * k.x * k.z + s * k.y,
                                   t * k.x * k.y + s * k.z, t * k.y * k.y + c, t * k.y * k.z - s * k.x,
                                   t * k.x * k.z - s * k.y, t * k.y * k.z + s * k.x, t * k.z * k.z + c);
        } end function rotation3

        template <typename T>
        function translation(const Vector3<T>&: offset) -> Matrix<T, 4, 4> {
            Matrix<T, 4, 4>: out = Matrix<T, 4, 4>::identity();
            out(0, 3) = offset.x;
            out(1, 3) = offset.y;
            out(2, 3) = offset.z;
            return out;
        } end function translation

        template <typename T>
        function scaling(const Vector3<T>&: factors) -> Matrix<T, 4, 4> {
            Matrix<T, 4, 4>: out;
            out(0, 0) = factors.x;
            out(1, 1) = factors.y;
            out(2, 2) = factors.z;
            out(3, 3) = T(1);
            return out;
        } end function scaling

        template <typename T>
        function scaling(const T&: factor) -> Matrix<T, 4, 4> {
            return scaling(Vector3<T>(factor, factor, factor));
        } end function scaling

        template <typename T>
        function rotation(const Vector3<T>&: axis, const T&: radians) -> Matrix<T, 4, 4> {
            const Matrix<T, 3, 3>: r = rotation3(axis, radians);
            Matrix<T, 4, 4>: out = Matrix<T, 4, 4>::identity();
            for (long int: i = 0; i < 3; i++) {
                for (long int: j = 0; j < 3; j++) {
                    out(i, j) = r(i, j);
                }
            }
            return out;
        } end function rotation

        template <typename T>
        function rotation_x(const T&: radians) -> Matrix<T, 4, 4> {
            return rotation(Vector3<T>::unit_x(), radians);
        } end function rotation_x

        template <typename T>
        function rotation_y(const T&: radians) -> Matrix<T, 4, 4> {
            return rotation(Vector3<T>::unit_y(), radians);
        } end function rotation_y

        template <typename T>
        function rotation_z(const T&: radians) -> Matrix<T, 4, 4> {
            return rotation(Vector3<T>::unit_z(), radians);
        } end function rotation_z

        template <typename T>
        function look_at(const Vector3<T>&: eye, const Vector3<T>&: target, const Vector3<T>&: up) -> Matrix<T, 4, 4> {
            const Vector3<T>: f = (target - eye).normalized();
            const Vector3<T>: s = f.cross(up).normalized();
            const Vector3<T>: u = s.cross(f);
            Matrix<T, 4, 4>: out = Matrix<T, 4, 4>::identity();
            out(0, 0) = s.x;
            out(0, 1) = s.y;
            out(0, 2) = s.z;
            out(1, 0) = u.x;
            out(1, 1) = u.y;
            out(1, 2) = u.z;
            out(2, 0) = -f.x;
            out(2, 1) = -f.y;
            out(2, 2) = -f.z;
            out(0, 3) = -s.dot(eye);
            out(1, 3) = -u.dot(eye);
            out(2, 3) = f.dot(eye);
            return out;
        } end function look_at

        template <typename T>
        function perspective(const T&: fov_y, const T&: aspect, const T&: near_plane, const T&: far_plane) -> Matrix<T, 4, 4> {
            const T: f = T(1) / std::math::tan(fov_y / T(2));
            Matrix<T, 4, 4>: out;
            out(0, 0) = f / aspect;
            out(1, 1) = f;
            out(2, 2) = (far_plane + near_plane) / (near_plane - far_plane);
            out(2, 3) = T(2) * far_plane * near_plane / (near_plane - far_plane);
            out(3, 2) = T(-1);
            return out;
        } end function perspective

        template <typename T>
        function orthographic(const T&: left, const T&: right, const T&: bottom, const T&: top, const T&: near_plane, const T&: far_plane) -> Matrix<T, 4, 4> {
            Matrix<T, 4, 4>: out = Matrix<T, 4, 4>::identity();
            out(0, 0) = T(2) / (right - left);
            out(1, 1) = T(2) / (top - bottom);
            out(2, 2) = T(-2) / (far_plane - near_plane);
            out(0, 3) = -(right + left) / (right - left);
            out(1, 3) = -(top + bottom) / (top - bottom);
            out(2, 3) = -(far_plane + near_plane) / (far_plane - near_plane);
            return out;
        } end function orthographic

        template <typename T>
        struct AxisAngle {
            Vector3<T>: axis;
            T: angle = T(0);
        } end struct AxisAngle

        template <typename T>
        struct Quaternion {
            static_assert(std::traits::is_float<T>, "quaternions need a real float type, such as float or double, not an integer or other type");
            T: w = T(1);
            T: x = T(0);
            T: y = T(0);
            T: z = T(0);

            constructor() { }

            constructor(const T&: w_value, const T&: x_value, const T&: y_value, const T&: z_value) : w = w_value, x = x_value, y = y_value, z = z_value { }

            constructor(const T&: scalar, const Vector3<T>&: vector) : w = scalar, x = vector.x, y = vector.y, z = vector.z { }

            static function identity() -> Quaternion {
                return Quaternion();
            } end function identity

            static function zero() -> Quaternion {
                return Quaternion(T(0), T(0), T(0), T(0));
            } end function zero

            static function from_axis_angle(const Vector3<T>&: axis, const T&: radians) -> Quaternion {
                const Vector3<T>: k = axis.normalized();
                const T: half = radians / T(2);
                const T: s = std::math::sin(half);
                return Quaternion(std::math::cos(half), k.x * s, k.y * s, k.z * s);
            } end function from_axis_angle

            static function from_euler(const T&: roll, const T&: pitch, const T&: yaw) -> Quaternion {
                const T: cr = std::math::cos(roll / T(2));
                const T: sr = std::math::sin(roll / T(2));
                const T: cp = std::math::cos(pitch / T(2));
                const T: sp = std::math::sin(pitch / T(2));
                const T: cy = std::math::cos(yaw / T(2));
                const T: sy = std::math::sin(yaw / T(2));
                return Quaternion(cr * cp * cy + sr * sp * sy,
                                  sr * cp * cy - cr * sp * sy,
                                  cr * sp * cy + sr * cp * sy,
                                  cr * cp * sy - sr * sp * cy);
            } end function from_euler

            static function from_euler(const Vector3<T>&: angles) -> Quaternion {
                return from_euler(angles.x, angles.y, angles.z);
            } end function from_euler

            static function from_matrix(const Matrix<T, 3, 3>&: m) -> Quaternion {
                const T: tr = m(0, 0) + m(1, 1) + m(2, 2);
                const T: one = T(1);
                const T: two = T(2);
                if (tr > T(0)) then {
                    const T: s = std::math::sqrt(tr + one) * two;
                    return Quaternion(s / T(4), (m(2, 1) - m(1, 2)) / s, (m(0, 2) - m(2, 0)) / s, (m(1, 0) - m(0, 1)) / s).normalized();
                } else if (m(0, 0) > m(1, 1) && m(0, 0) > m(2, 2)) then {
                    const T: s = std::math::sqrt(one + m(0, 0) - m(1, 1) - m(2, 2)) * two;
                    return Quaternion((m(2, 1) - m(1, 2)) / s, s / T(4), (m(0, 1) + m(1, 0)) / s, (m(0, 2) + m(2, 0)) / s).normalized();
                } else if (m(1, 1) > m(2, 2)) then {
                    const T: s = std::math::sqrt(one + m(1, 1) - m(0, 0) - m(2, 2)) * two;
                    return Quaternion((m(0, 2) - m(2, 0)) / s, (m(0, 1) + m(1, 0)) / s, s / T(4), (m(1, 2) + m(2, 1)) / s).normalized();
                }
                const T: s = std::math::sqrt(one + m(2, 2) - m(0, 0) - m(1, 1)) * two;
                return Quaternion((m(1, 0) - m(0, 1)) / s, (m(0, 2) + m(2, 0)) / s, (m(1, 2) + m(2, 1)) / s, s / T(4)).normalized();
            } end function from_matrix

            static function from_to(const Vector3<T>&: start, const Vector3<T>&: finish) -> Quaternion {
                const Vector3<T>: a = start.normalized();
                const Vector3<T>: b = finish.normalized();
                const T: d = a.dot(b);
                if (d >= T(1) - detail::tolerance<T>() * T(16)) then {
                    return Quaternion();
                }
                if (d <= T(-1) + detail::tolerance<T>() * T(16)) then {
                    return from_axis_angle(a.any_perpendicular(), detail::pi<T>());
                }
                const Vector3<T>: c = a.cross(b);
                return Quaternion(T(1) + d, c.x, c.y, c.z).normalized();
            } end function from_to

            static function look_rotation(const Vector3<T>&: forward, const Vector3<T>&: up) -> Quaternion {
                const Vector3<T>: f = forward.normalized();
                const Vector3<T>: r = up.cross(f).normalized();
                const Vector3<T>: u = f.cross(r);
                return from_matrix(Matrix<T, 3, 3>(r.x, u.x, f.x, r.y, u.y, f.y, r.z, u.z, f.z));
            } end function look_rotation

            operator(+) function(const Quaternion&: o) const -> Quaternion {
                return Quaternion(w + o.w, x + o.x, y + o.y, z + o.z);
            }

            operator(-) function(const Quaternion&: o) const -> Quaternion {
                return Quaternion(w - o.w, x - o.x, y - o.y, z - o.z);
            }

            operator(-) function() const -> Quaternion {
                return Quaternion(-w, -x, -y, -z);
            }

            operator(*) function(const Quaternion&: o) const -> Quaternion {
                return Quaternion(w * o.w - x * o.x - y * o.y - z * o.z,
                                  w * o.x + x * o.w + y * o.z - z * o.y,
                                  w * o.y - x * o.z + y * o.w + z * o.x,
                                  w * o.z + x * o.y - y * o.x + z * o.w);
            }

            operator(*) function(const T&: k) const -> Quaternion {
                return Quaternion(w * k, x * k, y * k, z * k);
            }

            operator(/) function(const T&: k) const -> Quaternion {
                return Quaternion(w / k, x / k, y / k, z / k);
            }

            operator(/) function(const Quaternion&: o) const -> Quaternion {
                return *this * o.inverse();
            }

            operator(*) function(const Vector3<T>&: v) const -> Vector3<T> {
                return rotate(v);
            }

            operator(+=) function(const Quaternion&: o) -> Quaternion& {
                *this = *this + o;
                return *this;
            }

            operator(-=) function(const Quaternion&: o) -> Quaternion& {
                *this = *this - o;
                return *this;
            }

            operator(*=) function(const Quaternion&: o) -> Quaternion& {
                *this = *this * o;
                return *this;
            }

            operator(*=) function(const T&: k) -> Quaternion& {
                *this = *this * k;
                return *this;
            }

            operator(/=) function(const T&: k) -> Quaternion& {
                *this = *this / k;
                return *this;
            }

            operator(==) function(const Quaternion&: o) const -> bool {
                return w == o.w && x == o.x && y == o.y && z == o.z;
            }

            operator(!=) function(const Quaternion&: o) const -> bool {
                return !(*this == o);
            }

            function scalar_part() const -> T {
                return w;
            } end function scalar_part

            function vector_part() const -> Vector3<T> {
                return Vector3<T>(x, y, z);
            } end function vector_part

            function dot(const Quaternion&: o) const -> T {
                return w * o.w + x * o.x + y * o.y + z * o.z;
            } end function dot

            function norm_squared() const -> T {
                return dot(*this);
            } end function norm_squared

            function norm() const -> T {
                return std::math::sqrt(norm_squared());
            } end function norm

            function length() const -> T {
                return norm();
            } end function length

            function normalized() const -> Quaternion {
                const T: n = norm();
                if (n == T(0)) then {
                    return Quaternion();
                }
                return *this / n;
            } end function normalized

            function normalize() -> Quaternion& {
                *this = normalized();
                return *this;
            } end function normalize

            function is_normalized() const -> bool {
                return std::math::abs(norm_squared() - T(1)) <= detail::tolerance<T>() * T(16);
            } end function is_normalized

            function conjugate() const -> Quaternion {
                return Quaternion(w, -x, -y, -z);
            } end function conjugate

            function inverse() const -> Quaternion {
                const T: n = norm_squared();
                if (n == T(0)) then {
                    detail::fail("inverse() of a zero quaternion");
                }
                return conjugate() / n;
            } end function inverse

            function rotate(const Vector3<T>&: v) const -> Vector3<T> {
                const Vector3<T>: u(x, y, z);
                const Vector3<T>: t = u.cross(v) * T(2);
                return v + t * w + u.cross(t);
            } end function rotate

            function angle() const -> T {
                return T(2) * std::math::acos(detail::clamp_unit(normalized().w));
            } end function angle

            function axis() const -> Vector3<T> {
                const Quaternion: q = normalized();
                const T: s = std::math::sqrt(T(1) - q.w * q.w);
                if (s <= detail::tolerance<T>() * T(16)) then {
                    return Vector3<T>::unit_x();
                }
                return Vector3<T>(q.x / s, q.y / s, q.z / s);
            } end function axis

            function to_axis_angle() const -> AxisAngle<T> {
                AxisAngle<T>: out;
                out.axis = axis();
                out.angle = angle();
                return out;
            } end function to_axis_angle

            function to_euler() const -> Vector3<T> {
                const Quaternion: q = normalized();
                const T: one = T(1);
                const T: two = T(2);
                const T: roll = std::math::atan2(two * (q.w * q.x + q.y * q.z), one - two * (q.x * q.x + q.y * q.y));
                const T: sp = two * (q.w * q.y - q.z * q.x);
                T: pitch = T(0);
                if (std::math::abs(sp) >= one) then {
                    pitch = detail::copy_sign(detail::pi<T>() / two, sp);
                } else then {
                    pitch = std::math::asin(sp);
                }
                const T: yaw = std::math::atan2(two * (q.w * q.z + q.x * q.y), one - two * (q.y * q.y + q.z * q.z));
                return Vector3<T>(roll, pitch, yaw);
            } end function to_euler

            function to_matrix3() const -> Matrix<T, 3, 3> {
                const Quaternion: q = normalized();
                const T: one = T(1);
                const T: two = T(2);
                return Matrix<T, 3, 3>(one - two * (q.y * q.y + q.z * q.z), two * (q.x * q.y - q.z * q.w), two * (q.x * q.z + q.y * q.w),
                                       two * (q.x * q.y + q.z * q.w), one - two * (q.x * q.x + q.z * q.z), two * (q.y * q.z - q.x * q.w),
                                       two * (q.x * q.z - q.y * q.w), two * (q.y * q.z + q.x * q.w), one - two * (q.x * q.x + q.y * q.y));
            } end function to_matrix3

            function to_matrix4() const -> Matrix<T, 4, 4> {
                const Matrix<T, 3, 3>: r = to_matrix3();
                Matrix<T, 4, 4>: out = Matrix<T, 4, 4>::identity();
                for (long int: i = 0; i < 3; i++) {
                    for (long int: j = 0; j < 3; j++) {
                        out(i, j) = r(i, j);
                    }
                }
                return out;
            } end function to_matrix4

            function exp() const -> Quaternion {
                const Vector3<T>: v = vector_part();
                const T: theta = v.length();
                const T: ew = std::math::exp(w);
                if (theta == T(0)) then {
                    return Quaternion(ew, T(0), T(0), T(0));
                }
                const T: s = ew * std::math::sin(theta) / theta;
                return Quaternion(ew * std::math::cos(theta), v.x * s, v.y * s, v.z * s);
            } end function exp

            function log() const -> Quaternion {
                const T: n = norm();
                if (n == T(0)) then {
                    detail::fail("log() of a zero quaternion");
                }
                const Vector3<T>: v = vector_part();
                const T: vl = v.length();
                if (vl == T(0)) then {
                    return Quaternion(std::math::ln(n), T(0), T(0), T(0));
                }
                const T: s = std::math::acos(detail::clamp_unit(w / n)) / vl;
                return Quaternion(std::math::ln(n), v.x * s, v.y * s, v.z * s);
            } end function log

            function pow(const T&: power) const -> Quaternion {
                return (log() * power).exp();
            } end function pow

            function slerp(const Quaternion&: o, const T&: t) const -> Quaternion {
                Quaternion: target = o;
                T: d = dot(o);
                if (d < T(0)) then {
                    target = -o;
                    d = -d;
                }
                if (d > T(1) - detail::tolerance<T>() * T(1024)) then {
                    return nlerp(target, t);
                }
                const T: theta = std::math::acos(detail::clamp_unit(d));
                const T: s = std::math::sin(theta);
                const T: a = std::math::sin((T(1) - t) * theta) / s;
                const T: b = std::math::sin(t * theta) / s;
                return (*this * a + target * b).normalized();
            } end function slerp

            function nlerp(const Quaternion&: o, const T&: t) const -> Quaternion {
                const Quaternion: target = dot(o) < T(0) ? -o : o;
                return (*this * (T(1) - t) + target * t).normalized();
            } end function nlerp

            function angle_to(const Quaternion&: o) const -> T {
                const T: d = std::math::abs(normalized().dot(o.normalized()));
                return T(2) * std::math::acos(detail::clamp_unit(d));
            } end function angle_to

            function approx_equal(const Quaternion&: o, const T&: tolerance) const -> bool {
                return std::math::abs(w - o.w) <= tolerance && std::math::abs(x - o.x) <= tolerance && std::math::abs(y - o.y) <= tolerance && std::math::abs(z - o.z) <= tolerance;
            } end function approx_equal

            function approx_equal(const Quaternion&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            function same_rotation(const Quaternion&: o) const -> bool {
                return approx_equal(o) || approx_equal(-o);
            } end function same_rotation

            function to_vector() const -> Vector4<T> {
                return Vector4<T>(x, y, z, w);
            } end function to_vector

            function to_string() const -> string {
                return static_cast<string>(`(${std::core::to_string(w)} + ${std::core::to_string(x)}i + ${std::core::to_string(y)}j + ${std::core::to_string(z)}k)`);
            } end function to_string
        } end struct Quaternion

        template <typename T>
        operator(*) function(const T&: k, const Quaternion<T>&: q) -> Quaternion<T> {
            return q * k;
        }

        template <typename T>
        struct Octonion {
            static_assert(std::traits::is_float<T>, "octonions need a real float type, such as float or double, not an integer or other type");
            array[8] T: e;

            constructor() {
                for (long int: i = 0; i < 8; i++) {
                    e[i] = T(0);
                }
            }

            constructor(const array[8] T&: values) : e = values { }

            constructor(const T&: e0, const T&: e1, const T&: e2, const T&: e3, const T&: e4, const T&: e5, const T&: e6, const T&: e7) {
                e[0] = e0;
                e[1] = e1;
                e[2] = e2;
                e[3] = e3;
                e[4] = e4;
                e[5] = e5;
                e[6] = e6;
                e[7] = e7;
            }

            constructor(const Quaternion<T>&: a, const Quaternion<T>&: b) {
                e[0] = a.w;
                e[1] = a.x;
                e[2] = a.y;
                e[3] = a.z;
                e[4] = b.w;
                e[5] = b.x;
                e[6] = b.y;
                e[7] = b.z;
            }

            static function zero() -> Octonion {
                return Octonion();
            } end function zero

            static function one() -> Octonion {
                return unit(0);
            } end function one

            static function unit(long int: index) -> Octonion {
                Octonion: out;
                out[index] = T(1);
                return out;
            } end function unit

            static function real_value(const T&: value) -> Octonion {
                Octonion: out;
                out.e[0] = value;
                return out;
            } end function real_value

            operator([]) function(long int: index) -> T& {
                if (index < 0 || index >= 8) then {
                    detail::fail(static_cast<string>(`index ${index} is out of range for an Octonion`));
                }
                return e[index];
            }

            operator([]) function(long int: index) const -> const T& {
                if (index < 0 || index >= 8) then {
                    detail::fail(static_cast<string>(`index ${index} is out of range for an Octonion`));
                }
                return e[index];
            }

            function real() const -> T {
                return e[0];
            } end function real

            function imaginary() const -> VectorN<T, 7> {
                VectorN<T, 7>: out;
                for (long int: i = 0; i < 7; i++) {
                    out[i] = e[i + 1];
                }
                return out;
            } end function imaginary

            function first_half() const -> Quaternion<T> {
                return Quaternion<T>(e[0], e[1], e[2], e[3]);
            } end function first_half

            function second_half() const -> Quaternion<T> {
                return Quaternion<T>(e[4], e[5], e[6], e[7]);
            } end function second_half

            operator(+) function(const Octonion&: o) const -> Octonion {
                Octonion: out;
                for (long int: i = 0; i < 8; i++) {
                    out.e[i] = e[i] + o.e[i];
                }
                return out;
            }

            operator(-) function(const Octonion&: o) const -> Octonion {
                Octonion: out;
                for (long int: i = 0; i < 8; i++) {
                    out.e[i] = e[i] - o.e[i];
                }
                return out;
            }

            operator(-) function() const -> Octonion {
                Octonion: out;
                for (long int: i = 0; i < 8; i++) {
                    out.e[i] = -e[i];
                }
                return out;
            }

            operator(*) function(const T&: k) const -> Octonion {
                Octonion: out;
                for (long int: i = 0; i < 8; i++) {
                    out.e[i] = e[i] * k;
                }
                return out;
            }

            operator(/) function(const T&: k) const -> Octonion {
                Octonion: out;
                for (long int: i = 0; i < 8; i++) {
                    out.e[i] = e[i] / k;
                }
                return out;
            }

            operator(*) function(const Octonion&: o) const -> Octonion {
                const Quaternion<T>: a = first_half();
                const Quaternion<T>: b = second_half();
                const Quaternion<T>: c = o.first_half();
                const Quaternion<T>: d = o.second_half();
                return Octonion(a * c - d.conjugate() * b, d * a + b * c.conjugate());
            }

            operator(/) function(const Octonion&: o) const -> Octonion {
                return *this * o.inverse();
            }

            operator(+=) function(const Octonion&: o) -> Octonion& {
                *this = *this + o;
                return *this;
            }

            operator(-=) function(const Octonion&: o) -> Octonion& {
                *this = *this - o;
                return *this;
            }

            operator(*=) function(const Octonion&: o) -> Octonion& {
                *this = *this * o;
                return *this;
            }

            operator(*=) function(const T&: k) -> Octonion& {
                *this = *this * k;
                return *this;
            }

            operator(/=) function(const T&: k) -> Octonion& {
                *this = *this / k;
                return *this;
            }

            operator(==) function(const Octonion&: o) const -> bool {
                for (long int: i = 0; i < 8; i++) {
                    if (e[i] != o.e[i]) then {
                        return false;
                    }
                }
                return true;
            }

            operator(!=) function(const Octonion&: o) const -> bool {
                return !(*this == o);
            }

            function conjugate() const -> Octonion {
                Octonion: out = -*this;
                out.e[0] = e[0];
                return out;
            } end function conjugate

            function dot(const Octonion&: o) const -> T {
                T: total = T(0);
                for (long int: i = 0; i < 8; i++) {
                    total += e[i] * o.e[i];
                }
                return total;
            } end function dot

            function norm_squared() const -> T {
                return dot(*this);
            } end function norm_squared

            function norm() const -> T {
                return std::math::sqrt(norm_squared());
            } end function norm

            function normalized() const -> Octonion {
                const T: n = norm();
                if (n == T(0)) then {
                    return *this;
                }
                return *this / n;
            } end function normalized

            function inverse() const -> Octonion {
                const T: n = norm_squared();
                if (n == T(0)) then {
                    detail::fail("inverse() of a zero octonion");
                }
                return conjugate() / n;
            } end function inverse

            function approx_equal(const Octonion&: o, const T&: tolerance) const -> bool {
                for (long int: i = 0; i < 8; i++) {
                    if (std::math::abs(e[i] - o.e[i]) > tolerance) then {
                        return false;
                    }
                }
                return true;
            } end function approx_equal

            function approx_equal(const Octonion&: o) const -> bool {
                return approx_equal(o, detail::tolerance<T>() * T(64));
            } end function approx_equal

            function to_string() const -> string {
                string: out = "(";
                for (long int: i = 0; i < 8; i++) {
                    if (i > 0) then {
                        out += ", ";
                    }
                    out += std::core::to_string(e[i]);
                }
                out += ")";
                return out;
            } end function to_string
        } end struct Octonion

        template <typename T>
        operator(*) function(const T&: k, const Octonion<T>&: o) -> Octonion<T> {
            return o * k;
        }

