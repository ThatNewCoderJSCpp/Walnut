import module.math

namespace std {
    namespace units {
        template <int L, int M, int T, int I, int K, int N, int J, int A>
        struct Dims {
        } end struct Dims

        namespace kind {
            struct generic {
                static constexpr bool: is_generic = true;
                static constexpr bool: is_affine = false;
                using dims = Dims<0, 0, 0, 0, 0, 0, 0, 0>;
                using parent = generic;
                using interval = generic;
            } end struct generic

            struct none {
                static constexpr bool: is_generic = false;
                static constexpr bool: is_affine = false;
                using dims = Dims<0, 0, 0, 0, 0, 0, 0, 0>;
                using parent = none;
                using interval = none;
            } end struct none
        } end namespace kind

        namespace detail {
            template <typename Q, int L, int M, int T, int I, int K, int N, int J, int A>
            constexpr bool: kind_matches = Q::is_generic || std::traits::is_same<Q::dims, Dims<L, M, T, I, K, N, J, A>>;

            template <typename X, typename Y>
            constexpr bool: kinds_compatible = std::traits::is_same<X, Y> || X::is_generic || Y::is_generic || std::traits::is_same<X::parent, Y> || std::traits::is_same<X, Y::parent>;

            template <typename From, typename To>
            constexpr bool: implicit_kind = std::traits::is_same<From, To> || From::is_generic || (To::is_generic && !From::is_affine) || (std::traits::is_same<To, From::parent> && !From::is_affine);

            template <typename X, typename Y>
            using common_kind = std::traits::conditional<std::traits::is_same<X, Y>, X,
                                std::traits::conditional<X::is_generic, Y,
                                std::traits::conditional<Y::is_generic, X,
                                std::traits::conditional<std::traits::is_same<X::parent, Y>, Y,
                                std::traits::conditional<std::traits::is_same<X, Y::parent>, X, kind::none>>>>>;

            template <typename P, typename Q>
            constexpr bool: offsets_point = Q::is_generic || std::traits::is_same<Q, P::interval> || std::traits::is_same<Q, P::parent>;

            template <typename X, typename Y>
            using add_kind = std::traits::conditional<X::is_affine && Y::is_affine, kind::none,
                             std::traits::conditional<X::is_affine, std::traits::conditional<offsets_point<X, Y>, X, kind::none>,
                             std::traits::conditional<Y::is_affine, std::traits::conditional<offsets_point<Y, X>, Y, kind::none>,
                             common_kind<X, Y>>>>;

            template <typename X, typename Y>
            using sub_kind = std::traits::conditional<X::is_affine && Y::is_affine, std::traits::conditional<std::traits::is_same<X, Y>, X::interval, kind::none>,
                             std::traits::conditional<X::is_affine, std::traits::conditional<offsets_point<X, Y>, X, kind::none>,
                             std::traits::conditional<Y::is_affine, kind::none,
                             common_kind<X, Y>>>>;

            template <typename R>
            using or_generic = std::traits::conditional<std::traits::is_same<R, kind::none>, kind::generic, R>;

            template <typename Q, int P>
            struct pow_kind_of {
                using type = std::traits::conditional<P == 1, Q, kind::generic>;
            } end struct pow_kind_of

            template <typename Q, int P>
            using pow_kind = pow_kind_of<Q, P>::type;

            function tidy(float: x) -> float {
                if (x == 0.0 || x != x) then {
                    return x;
                }
                const float: m = std::math::abs(x);
                if (m > 1.0e4000 || m < 1.0e-4000) then {
                    return x;
                }
                const long int: k = 32 - static_cast<long int>(std::math::floor(std::math::log10(m)));
                if (k >= 0) then {
                    const float: p = std::math::pow(10.0, k);
                    return std::math::round(x * p) / p;
                }
                const float: p = std::math::pow(10.0, -k);
                return std::math::round(x / p) * p;
            } end function tidy

            function power_text(const string&: symbol, int: p) -> string {
                if (p == 1) then {
                    return symbol;
                }
                return static_cast<string>(`${symbol}^${p}`);
            } end function power_text

            function dimension_text(int: ll, int: mm, int: tt, int: ii, int: kk, int: nn, int: jj, int: aa) -> string {
                string: out = "";
                if (ll != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("m", ll);
                }
                if (mm != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("kg", mm);
                }
                if (tt != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("s", tt);
                }
                if (ii != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("A", ii);
                }
                if (kk != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("K", kk);
                }
                if (nn != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("mol", nn);
                }
                if (jj != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("cd", jj);
                }
                if (aa != 0) then {
                    if (out.length() > 0) then {
                        out = out + "·";
                    }
                    out = out + power_text("rad", aa);
                }
                return out;
            } end function dimension_text
        } end namespace detail

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q = kind::generic>
        struct Unit {
            static_assert(detail::kind_matches<Q, L, M, T, I, K, N, J, A>, "std::units::Unit: the kind's dimension doesn't match the unit's dimension");

            using kind_type = Q;
            using dims = Dims<L, M, T, I, K, N, J, A>;
            float: scale = 1.0;
            float: offset = 0.0;

            function to_base(float: x) const -> float {
                return x * scale + offset;
            } end function to_base

            function from_base(float: b) const -> float {
                return (b - offset) / scale;
            } end function from_base

            function has_offset() const -> bool {
                return offset != 0.0;
            } end function has_offset

            function as_generic() const -> Unit<L, M, T, I, K, N, J, A> {
                return Unit<L, M, T, I, K, N, J, A>{scale, offset};
            } end function as_generic

            template <int P>
            function pow() const -> Unit<L * P, M * P, T * P, I * P, K * P, N * P, J * P, A * P, detail::pow_kind<Q, P>> {
                static_assert(!Q::is_affine || P == 1, "std::units: a temperature point (celsius, fahrenheit...) can't be raised to a power; use a temperature interval unit or kelvin");
                float: s = 1.0;
                if (P >= 0) then {
                    for (int: i = 0; i < P; i++) {
                        s = s * scale;
                    }
                } else then {
                    for (int: i = 0; i < -P; i++) {
                        s = s / scale;
                    }
                }
                return Unit<L * P, M * P, T * P, I * P, K * P, N * P, J * P, A * P, detail::pow_kind<Q, P>>{s, 0.0};
            } end function pow

            static function dimension_text() -> string {
                return detail::dimension_text(L, M, T, I, K, N, J, A);
            } end function dimension_text

            template <typename Q2>
            requires (!std::traits::is_same<Q, Q2> && detail::implicit_kind<Q, Q2>)
            operator(Unit<L, M, T, I, K, N, J, A, Q2>) function() const {
                return Unit<L, M, T, I, K, N, J, A, Q2>{scale, offset};
            }
        } end struct Unit

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q = kind::generic>
        struct ReciprocalUnit {
            static_assert(detail::kind_matches<Q, L, M, T, I, K, N, J, A>, "std::units::ReciprocalUnit: the kind's dimension doesn't match the unit's dimension");

            using kind_type = Q;
            using dims = Dims<L, M, T, I, K, N, J, A>;
            float: scale = 1.0;

            function to_base(float: x) const -> float {
                return 1.0 / (x * scale);
            } end function to_base

            function from_base(float: b) const -> float {
                return 1.0 / (b * scale);
            } end function from_base

            function has_offset() const -> bool {
                return false;
            } end function has_offset

            static function dimension_text() -> string {
                return detail::dimension_text(L, M, T, I, K, N, J, A);
            } end function dimension_text

            template <typename Q2>
            requires (!std::traits::is_same<Q, Q2> && detail::implicit_kind<Q, Q2>)
            operator(ReciprocalUnit<L, M, T, I, K, N, J, A, Q2>) function() const {
                return ReciprocalUnit<L, M, T, I, K, N, J, A, Q2>{scale};
            }
        } end struct ReciprocalUnit

        template <int L1, int M1, int T1, int I1, int K1, int N1, int J1, int A1, typename Q1, int L2, int M2, int T2, int I2, int K2, int N2, int J2, int A2, typename Q2>
        operator(*) function(const Unit<L1, M1, T1, I1, K1, N1, J1, A1, Q1>&: a, const Unit<L2, M2, T2, I2, K2, N2, J2, A2, Q2>&: b) -> Unit<L1 + L2, M1 + M2, T1 + T2, I1 + I2, K1 + K2, N1 + N2, J1 + J2, A1 + A2> {
            static_assert(!Q1::is_affine && !Q2::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be multiplied; use a temperature interval unit or kelvin");
            return Unit<L1 + L2, M1 + M2, T1 + T2, I1 + I2, K1 + K2, N1 + N2, J1 + J2, A1 + A2>{a.scale * b.scale, 0.0};
        }

        template <int L1, int M1, int T1, int I1, int K1, int N1, int J1, int A1, typename Q1, int L2, int M2, int T2, int I2, int K2, int N2, int J2, int A2, typename Q2>
        operator(/) function(const Unit<L1, M1, T1, I1, K1, N1, J1, A1, Q1>&: a, const Unit<L2, M2, T2, I2, K2, N2, J2, A2, Q2>&: b) -> Unit<L1 - L2, M1 - M2, T1 - T2, I1 - I2, K1 - K2, N1 - N2, J1 - J2, A1 - A2> {
            static_assert(!Q1::is_affine && !Q2::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be divided; use a temperature interval unit or kelvin");
            return Unit<L1 - L2, M1 - M2, T1 - T2, I1 - I2, K1 - K2, N1 - N2, J1 - J2, A1 - A2>{a.scale / b.scale, 0.0};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(*) function(float: k, const Unit<L, M, T, I, K, N, J, A, Q>&: u) -> Unit<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be scaled; use a temperature interval unit or kelvin");
            return Unit<L, M, T, I, K, N, J, A, Q>{u.scale * k, 0.0};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(*) function(const Unit<L, M, T, I, K, N, J, A, Q>&: u, float: k) -> Unit<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be scaled; use a temperature interval unit or kelvin");
            return Unit<L, M, T, I, K, N, J, A, Q>{u.scale * k, 0.0};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(/) function(const Unit<L, M, T, I, K, N, J, A, Q>&: u, float: k) -> Unit<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be scaled; use a temperature interval unit or kelvin");
            return Unit<L, M, T, I, K, N, J, A, Q>{u.scale / k, 0.0};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(/) function(float: k, const Unit<L, M, T, I, K, N, J, A, Q>&: u) -> Unit<0 - L, 0 - M, 0 - T, 0 - I, 0 - K, 0 - N, 0 - J, 0 - A> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be divided; use a temperature interval unit or kelvin");
            return Unit<0 - L, 0 - M, 0 - T, 0 - I, 0 - K, 0 - N, 0 - J, 0 - A>{k / u.scale, 0.0};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        function prefixed(float: factor, const Unit<L, M, T, I, K, N, J, A, Q>&: base) -> Unit<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be given a prefix; use a temperature interval unit or kelvin");
            return Unit<L, M, T, I, K, N, J, A, Q>{base.scale * factor, 0.0};
        } end function prefixed

        template <typename Q2, int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        function kind_cast(const Unit<L, M, T, I, K, N, J, A, Q>&: u) -> Unit<L, M, T, I, K, N, J, A, Q2> {
            return Unit<L, M, T, I, K, N, J, A, Q2>{u.scale, u.offset};
        } end function kind_cast

        template <typename Q2, int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        function kind_cast(const ReciprocalUnit<L, M, T, I, K, N, J, A, Q>&: u) -> ReciprocalUnit<L, M, T, I, K, N, J, A, Q2> {
            return ReciprocalUnit<L, M, T, I, K, N, J, A, Q2>{u.scale};
        } end function kind_cast

        template <typename A, typename B>
        function same_dimension(const A&: a, const B&: b) -> bool {
            return std::traits::is_same<A::dims, B::dims>;
        } end function same_dimension

        template <typename A, typename B>
        function same_kind(const A&: a, const B&: b) -> bool {
            return same_dimension(a, b) && detail::kinds_compatible<A::kind_type, B::kind_type>;
        } end function same_kind

        template <typename A, typename B>
        function convert(float: value, const A&: source, const B&: target) -> float {
            static_assert(std::traits::is_same<A::dims, B::dims>, "std::units::convert: the units have different dimensions");
            static_assert(detail::kinds_compatible<A::kind_type, B::kind_type>, "std::units::convert: the units are different kinds of quantity (energy and torque, say); use kind_cast if this is intended");
            return detail::tidy(target.from_base(source.to_base(value)));
        } end function convert

        template <typename U>
        function to_base(float: value, const U&: source) -> float {
            return source.to_base(value);
        } end function to_base

        template <typename U>
        function from_base(float: base, const U&: target) -> float {
            return target.from_base(base);
        } end function from_base

        template <typename A, typename B>
        function scale_ratio(const A&: source, const B&: target) -> float {
            static_assert(std::traits::is_same<A::dims, B::dims>, "std::units::scale_ratio: the units have different dimensions");
            static_assert(detail::kinds_compatible<A::kind_type, B::kind_type>, "std::units::scale_ratio: the units are different kinds of quantity (energy and torque, say); use kind_cast if this is intended");
            return detail::tidy(source.scale / target.scale);
        } end function scale_ratio

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q = kind::generic>
        struct Quantity {
            static_assert(detail::kind_matches<Q, L, M, T, I, K, N, J, A>, "std::units::Quantity: the kind's dimension doesn't match the quantity's dimension");

            using kind_type = Q;
            using dims = Dims<L, M, T, I, K, N, J, A>;

            float: base = 0.0;

            template <typename U>
            function value_in(const U&: u) const -> float {
                static_assert(std::traits::is_same<U::dims, Dims<L, M, T, I, K, N, J, A>>, "std::units::Quantity::value_in: the unit has a different dimension");
                static_assert(detail::kinds_compatible<Q, U::kind_type>, "std::units::Quantity::value_in: the quantity and the unit are different kinds (energy and torque, say); use kind_cast if this is intended");
                return detail::tidy(u.from_base(base));
            } end function value_in

            function as_generic() const -> Quantity<L, M, T, I, K, N, J, A> {
                return Quantity<L, M, T, I, K, N, J, A>{base};
            } end function as_generic

            static function dimension_text() -> string {
                return detail::dimension_text(L, M, T, I, K, N, J, A);
            } end function dimension_text

            function to_string() const -> string {
                const string: dims = detail::dimension_text(L, M, T, I, K, N, J, A);
                if (dims.length() == 0) then {
                    return static_cast<string>(`${base}`);
                }
                return static_cast<string>(`${base} ${dims}`);
            } end function to_string

            template <typename Q2>
            requires (!std::traits::is_same<Q, Q2> && detail::implicit_kind<Q, Q2>)
            operator(Quantity<L, M, T, I, K, N, J, A, Q2>) function() const {
                return Quantity<L, M, T, I, K, N, J, A, Q2>{base};
            }
        } end struct Quantity

        namespace detail {
            template <typename D, typename Q>
            struct unit_from {
            } end struct unit_from

            template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
            struct unit_from<Dims<L, M, T, I, K, N, J, A>, Q> {
                using type = Unit<L, M, T, I, K, N, J, A, Q>;
            } end struct unit_from

            template <typename D, typename Q>
            struct reciprocal_from {
            } end struct reciprocal_from

            template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
            struct reciprocal_from<Dims<L, M, T, I, K, N, J, A>, Q> {
                using type = ReciprocalUnit<L, M, T, I, K, N, J, A, Q>;
            } end struct reciprocal_from

            template <typename D, typename Q>
            struct quantity_from {
            } end struct quantity_from

            template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
            struct quantity_from<Dims<L, M, T, I, K, N, J, A>, Q> {
                using type = Quantity<L, M, T, I, K, N, J, A, Q>;
            } end struct quantity_from
        } end namespace detail

        template <typename U>
        function quantity(float: value, const U&: u) -> detail::quantity_from<U::dims, U::kind_type>::type {
            return detail::quantity_from<U::dims, U::kind_type>::type{u.to_base(value)};
        } end function quantity

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q, typename U>
        function value_in(const Quantity<L, M, T, I, K, N, J, A, Q>&: q, const U&: u) -> float {
            return q.value_in(u);
        } end function value_in

        template <typename Q2, int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        function kind_cast(const Quantity<L, M, T, I, K, N, J, A, Q>&: q) -> Quantity<L, M, T, I, K, N, J, A, Q2> {
            return Quantity<L, M, T, I, K, N, J, A, Q2>{q.base};
        } end function kind_cast

        template <int L1, int M1, int T1, int I1, int K1, int N1, int J1, int A1, typename Q1, int L2, int M2, int T2, int I2, int K2, int N2, int J2, int A2, typename Q2>
        operator(*) function(const Quantity<L1, M1, T1, I1, K1, N1, J1, A1, Q1>&: a, const Quantity<L2, M2, T2, I2, K2, N2, J2, A2, Q2>&: b) -> Quantity<L1 + L2, M1 + M2, T1 + T2, I1 + I2, K1 + K2, N1 + N2, J1 + J2, A1 + A2> {
            static_assert(!Q1::is_affine && !Q2::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be multiplied; use a temperature interval unit or kelvin");
            return Quantity<L1 + L2, M1 + M2, T1 + T2, I1 + I2, K1 + K2, N1 + N2, J1 + J2, A1 + A2>{a.base * b.base};
        }

        template <int L1, int M1, int T1, int I1, int K1, int N1, int J1, int A1, typename Q1, int L2, int M2, int T2, int I2, int K2, int N2, int J2, int A2, typename Q2>
        operator(/) function(const Quantity<L1, M1, T1, I1, K1, N1, J1, A1, Q1>&: a, const Quantity<L2, M2, T2, I2, K2, N2, J2, A2, Q2>&: b) -> Quantity<L1 - L2, M1 - M2, T1 - T2, I1 - I2, K1 - K2, N1 - N2, J1 - J2, A1 - A2> {
            static_assert(!Q1::is_affine && !Q2::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be divided; use a temperature interval unit or kelvin");
            return Quantity<L1 - L2, M1 - M2, T1 - T2, I1 - I2, K1 - K2, N1 - N2, J1 - J2, A1 - A2>{a.base / b.base};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q1, typename Q2>
        operator(+) function(const Quantity<L, M, T, I, K, N, J, A, Q1>&: a, const Quantity<L, M, T, I, K, N, J, A, Q2>&: b) -> Quantity<L, M, T, I, K, N, J, A, detail::or_generic<detail::add_kind<Q1, Q2>>> {
            static_assert(!std::traits::is_same<detail::add_kind<Q1, Q2>, kind::none>, "std::units: these quantities can't be added (different kinds such as energy and torque, or two temperature points)");
            return Quantity<L, M, T, I, K, N, J, A, detail::or_generic<detail::add_kind<Q1, Q2>>>{a.base + b.base};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q1, typename Q2>
        operator(-) function(const Quantity<L, M, T, I, K, N, J, A, Q1>&: a, const Quantity<L, M, T, I, K, N, J, A, Q2>&: b) -> Quantity<L, M, T, I, K, N, J, A, detail::or_generic<detail::sub_kind<Q1, Q2>>> {
            static_assert(!std::traits::is_same<detail::sub_kind<Q1, Q2>, kind::none>, "std::units: these quantities can't be subtracted (different kinds such as energy and torque, or an interval minus a temperature point)");
            return Quantity<L, M, T, I, K, N, J, A, detail::or_generic<detail::sub_kind<Q1, Q2>>>{a.base - b.base};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(-) function(const Quantity<L, M, T, I, K, N, J, A, Q>&: a) -> Quantity<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be negated; use a temperature interval unit or kelvin");
            return Quantity<L, M, T, I, K, N, J, A, Q>{-a.base};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(*) function(const Quantity<L, M, T, I, K, N, J, A, Q>&: a, float: k) -> Quantity<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be scaled; use a temperature interval unit or kelvin");
            return Quantity<L, M, T, I, K, N, J, A, Q>{a.base * k};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(*) function(float: k, const Quantity<L, M, T, I, K, N, J, A, Q>&: a) -> Quantity<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be scaled; use a temperature interval unit or kelvin");
            return Quantity<L, M, T, I, K, N, J, A, Q>{a.base * k};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(/) function(const Quantity<L, M, T, I, K, N, J, A, Q>&: a, float: k) -> Quantity<L, M, T, I, K, N, J, A, Q> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be scaled; use a temperature interval unit or kelvin");
            return Quantity<L, M, T, I, K, N, J, A, Q>{a.base / k};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        operator(/) function(float: k, const Quantity<L, M, T, I, K, N, J, A, Q>&: a) -> Quantity<0 - L, 0 - M, 0 - T, 0 - I, 0 - K, 0 - N, 0 - J, 0 - A> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be inverted; use a temperature interval unit or kelvin");
            return Quantity<0 - L, 0 - M, 0 - T, 0 - I, 0 - K, 0 - N, 0 - J, 0 - A>{k / a.base};
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q>
        function reciprocal(const Quantity<L, M, T, I, K, N, J, A, Q>&: a) -> Quantity<0 - L, 0 - M, 0 - T, 0 - I, 0 - K, 0 - N, 0 - J, 0 - A> {
            static_assert(!Q::is_affine, "std::units: a temperature point (celsius, fahrenheit...) can't be inverted; use a temperature interval unit or kelvin");
            return Quantity<0 - L, 0 - M, 0 - T, 0 - I, 0 - K, 0 - N, 0 - J, 0 - A>{1.0 / a.base};
        } end function reciprocal

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q1, typename Q2>
        operator(==) function(const Quantity<L, M, T, I, K, N, J, A, Q1>&: a, const Quantity<L, M, T, I, K, N, J, A, Q2>&: b) -> bool {
            static_assert(detail::kinds_compatible<Q1, Q2>, "std::units: these quantities are different kinds (energy and torque, say) and can't be compared");
            return a.base == b.base;
        }

        template <int L, int M, int T, int I, int K, int N, int J, int A, typename Q1, typename Q2>
        operator(<) function(const Quantity<L, M, T, I, K, N, J, A, Q1>&: a, const Quantity<L, M, T, I, K, N, J, A, Q2>&: b) -> bool {
            static_assert(detail::kinds_compatible<Q1, Q2>, "std::units: these quantities are different kinds (energy and torque, say) and can't be compared");
            return a.base < b.base;
        }

        template <typename Q>
        using KindUnit = detail::unit_from<Q::dims, Q>::type;

        template <typename Q>
        using KindReciprocalUnit = detail::reciprocal_from<Q::dims, Q>::type;

        template <typename Q>
        using KindQuantity = detail::quantity_from<Q::dims, Q>::type;

        template <typename U>
        using QuantityOf = detail::quantity_from<U::dims, U::kind_type>::type;

        template <typename Self, int L_, int M_, int T_, int I_, int K_, int N_, int J_, int A_>
        struct kind_of {
            static constexpr bool: is_generic = false;
            static constexpr bool: is_affine = false;
            using dims = Dims<L_, M_, T_, I_, K_, N_, J_, A_>;
            using parent = Self;
            using interval = Self;
        } end struct kind_of

        template <typename Self, typename Like>
        struct kind_like {
            static constexpr bool: is_generic = false;
            static constexpr bool: is_affine = false;
            using dims = Like::dims;
            using parent = Self;
            using interval = Self;
        } end struct kind_like

        template <typename Self, typename Parent>
        struct subkind_of {
            static constexpr bool: is_generic = false;
            static constexpr bool: is_affine = false;
            using dims = Parent::dims;
            using parent = Parent;
            using interval = Self;
        } end struct subkind_of

