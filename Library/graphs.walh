import module.collections
import module.threading

safe(compile) {
    namespace std {
        namespace errors {
            class graph_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class graph_error
        } end namespace errors

        namespace graphs {
            enum Direction { undirected, directed }

            template <typename W>
            concept Weight = std::traits::is_number<std::traits::discard_cv<W>>

            template <typename W = float>
            requires Weight<W>
            struct Edge {
                unsigned long int: source = std::npos;
                unsigned long int: target = std::npos;
                W: weight = static_cast<W>(1);

                constructor() { }

                constructor(unsigned long int: source_node, unsigned long int: target_node, const W&: edge_weight) : source = source_node, target = target_node, weight = edge_weight { }

                operator(==) function(const self&, const Edge&: o) -> bool {
                    return self.source == o.source && self.target == o.target && self.weight == o.weight;
                }

                operator(!=) function(const self&, const Edge&: o) -> bool {
                    return !(*this == o);
                }

                function reversed(const self&) -> Edge {
                    return Edge(self.target, self.source, self.weight);
                } end function reversed

                function to_string(const self&) -> string {
                    return static_cast<string>(`${self.source} -> ${self.target} (${std::core::to_string(self.weight)})`);
                } end function to_string
            } end struct Edge

            template <typename W = float>
            requires Weight<W>
            class Path {
                std::collections::Vector<unsigned long int>: steps;
                W: total = static_cast<W>(0);

            public:
                constructor() { }

                constructor(unsigned long int: start) {
                    self.steps.push_back(start);
                }

                constructor(const std::collections::Vector<unsigned long int>&: nodes, const W&: cost) : steps = nodes, total = cost { }

                function found(const self&) -> bool {
                    return !self.steps.empty();
                } end function found

                operator(bool) function(const self&) explicit {
                    return self.found();
                }

                function empty(const self&) -> bool {
                    return self.steps.empty();
                } end function empty

                function nodes(const self&) -> const std::collections::Vector<unsigned long int>& {
                    return self.steps;
                } end function nodes

                function cost(const self&) -> W {
                    return self.total;
                } end function cost

                function node_count(const self&) -> unsigned long int {
                    return self.steps.size();
                } end function node_count

                function edge_count(const self&) -> unsigned long int {
                    return self.steps.empty() ? 0 : self.steps.size() - 1;
                } end function edge_count

                function size(const self&) -> unsigned long int {
                    return self.steps.size();
                } end function size

                function front(const self&) -> unsigned long int {
                    if (self.steps.empty()) then {
                        throw std::errors::graph_error("front() of an empty path");
                    }
                    return self.steps[0];
                } end function front

                function back(const self&) -> unsigned long int {
                    if (self.steps.empty()) then {
                        throw std::errors::graph_error("back() of an empty path");
                    }
                    return self.steps[static_cast<unsigned long int>(self.steps.size() - 1)];
                } end function back

                function start(const self&) -> unsigned long int {
                    return self.front();
                } end function start

                function goal(const self&) -> unsigned long int {
                    return self.back();
                } end function goal

                operator([]) function(const self&, unsigned long int: index) -> unsigned long int {
                    if (index >= self.steps.size()) then {
                        throw std::errors::graph_error(static_cast<string>(`index ${index} is out of range for a path of ${self.steps.size()} nodes`));
                    }
                    return self.steps[index];
                }

                function contains(const self&, unsigned long int: node) -> bool {
                    for (unsigned long int: n in self.steps) {
                        if (n == node) then {
                            return true;
                        }
                    }
                    return false;
                } end function contains

                function is_simple(const self&) -> bool {
                    for (unsigned long int: i = 0; i < self.steps.size(); i++) {
                        for (unsigned long int: j = i + 1; j < self.steps.size(); j++) {
                            if (self.steps[i] == self.steps[j]) then {
                                return false;
                            }
                        }
                    }
                    return true;
                } end function is_simple

                function is_cycle(const self&) -> bool {
                    return self.steps.size() > 1 && self.steps[0] == self.steps[static_cast<unsigned long int>(self.steps.size() - 1)];
                } end function is_cycle

                function extend(self&, unsigned long int: next, const W&: step_cost = static_cast<W>(1)) -> Path& {
                    if (!self.steps.empty()) then {
                        self.total += step_cost;
                    }
                    self.steps.push_back(next);
                    return *this;
                } end function extend

                function reversed(const self&) -> Path {
                    std::collections::Vector<unsigned long int>: out;
                    for (unsigned long int: i = self.steps.size(); i > 0;) {
                        i--;
                        out.push_back(self.steps[i]);
                    }
                    return Path(out, self.total);
                } end function reversed

                function begin(const self&) -> const unsigned long int* {
                    return self.steps.begin();
                } end function begin

                function end(const self&) -> const unsigned long int* {
                    return self.steps.end();
                } end function end

                operator(==) function(const self&, const Path&: o) -> bool {
                    return self.steps == o.steps;
                }

                operator(!=) function(const self&, const Path&: o) -> bool {
                    return !(*this == o);
                }

                function to_string(const self&) -> string {
                    if (self.steps.empty()) then {
                        return "(no path)";
                    }
                    string: out;
                    for (unsigned long int: i = 0; i < self.steps.size(); i++) {
                        if (i > 0) then {
                            out += " -> ";
                        }
                        out += std::core::to_string(self.steps[i]);
                    }
                    return out;
                } end function to_string
            } end class Path

            struct Traversal {
                std::collections::Vector<unsigned long int>: order;
                std::collections::Vector<unsigned long int>: depth;
                std::collections::Vector<unsigned long int>: parent;
                bool: has_cycle = false;
                std::collections::Vector<unsigned long int>: cycle;
                std::collections::Vector<unsigned long int>: loop_from;
                std::collections::Vector<unsigned long int>: loop_to;

                function loop_count(const self&) -> unsigned long int {
                    return self.loop_from.size();
                } end function loop_count

                function loop(const self&, unsigned long int: index) -> std::collections::Vector<unsigned long int> {
                    std::collections::Vector<unsigned long int>: back;
                    if (index >= self.loop_from.size()) then {
                        return back;
                    }
                    unsigned long int: walk = self.loop_from[index];
                    while (walk != std::npos) {
                        back.push_back(walk);
                        if (walk == self.loop_to[index]) then {
                            break;
                        }
                        walk = self.parent[walk];
                    }
                    std::collections::Vector<unsigned long int>: out;
                    for (unsigned long int: i = back.size(); i > 0;) {
                        i--;
                        out.push_back(back[i]);
                    }
                    out.push_back(self.loop_to[index]);
                    return out;
                } end function loop

                function loops(const self&) -> std::collections::Vector<std::collections::Vector<unsigned long int>> {
                    std::collections::Vector<std::collections::Vector<unsigned long int>>: out;
                    for (unsigned long int: i = 0; i < self.loop_from.size(); i++) {
                        out.push_back(self.loop(i));
                    }
                    return out;
                } end function loops

                function reached(const self&, unsigned long int: node) -> bool {
                    return node < self.depth.size() && self.depth[node] != std::npos;
                } end function reached

                function depth_of(const self&, unsigned long int: node) -> unsigned long int {
                    return self.reached(node) ? self.depth[node] : std::npos;
                } end function depth_of

                function parent_of(const self&, unsigned long int: node) -> unsigned long int {
                    return self.reached(node) ? self.parent[node] : std::npos;
                } end function parent_of

                function path_to(const self&, unsigned long int: node) -> std::collections::Vector<unsigned long int> {
                    std::collections::Vector<unsigned long int>: out;
                    if (!self.reached(node)) then {
                        return out;
                    }
                    unsigned long int: at = node;
                    while (at != std::npos) {
                        out.push_back(at);
                        at = self.parent[at];
                    }
                    std::collections::Vector<unsigned long int>: forward;
                    for (unsigned long int: i = out.size(); i > 0;) {
                        i--;
                        forward.push_back(out[i]);
                    }
                    return forward;
                } end function path_to

                function count(const self&) -> unsigned long int {
                    return self.order.size();
                } end function count
            } end struct Traversal

            template <typename W = float>
            requires Weight<W>
            struct Distances {
                std::collections::Vector<W>: distance;
                std::collections::Vector<bool>: reached;
                std::collections::Vector<unsigned long int>: parent;
                bool: has_negative_cycle = false;

                function reachable(const self&, unsigned long int: node) -> bool {
                    return node < self.reached.size() && self.reached[node];
                } end function reachable

                function distance_to(const self&, unsigned long int: node) -> W {
                    if (!self.reachable(node)) then {
                        throw std::errors::graph_error(static_cast<string>(`node ${node} can't be reached`));
                    }
                    return self.distance[node];
                } end function distance_to

                function path_to(const self&, unsigned long int: node) -> Path<W> {
                    if (!self.reachable(node)) then {
                        return Path<W>();
                    }
                    std::collections::Vector<unsigned long int>: back;
                    unsigned long int: at = node;
                    unsigned long int: guard = 0;
                    while (at != std::npos && guard <= self.parent.size()) {
                        back.push_back(at);
                        at = self.parent[at];
                        guard++;
                    }
                    std::collections::Vector<unsigned long int>: forward;
                    for (unsigned long int: i = back.size(); i > 0;) {
                        i--;
                        forward.push_back(back[i]);
                    }
                    return Path<W>(forward, self.distance[node]);
                } end function path_to
            } end struct Distances

            hidden namespace detail {
                extern "C++" from "<walnut_threading.hpp>" {
                    class ClaimTable as "walnut_rt::threading::claim_table" {
                    public:
                        constructor(unsigned long int: count) explicit;
                        constructor(const ClaimTable&: other) = delete;
                        function mark(self&, unsigned long int: node) noexcept -> void;
                        function take_first(self&, unsigned long int: node) noexcept -> bool;
                    } end class ClaimTable
                } end extern

                constexpr unsigned long int: parallel_grain = 512;

                template <typename G>
                function run_parts(unsigned long int: parts, G&: work) -> void {
                    if (parts <= 1) then {
                        work(0);
                        return;
                    }
                    std::collections::Vector<std::threading::Thread>: helpers;
                    for (unsigned long int: p = 1; p < parts; p++) {
                        helpers.push_back(std::threading::Thread([&work, p]() -> void {
                            work(p);
                        }));
                    }
                    work(0);
                    for (std::threading::Thread&: t in helpers) {
                        t.join();
                    }
                } end function run_parts
            } end namespace detail

            hidden namespace detail {
                template <typename W>
                struct HeapItem {
                    W: cost;
                    unsigned long int: node = 0;
                } end struct HeapItem

                template <typename W>
                class MinHeap {
                    std::collections::Vector<HeapItem<W>>: items;

                public:
                    function empty(const self&) -> bool {
                        return self.items.empty();
                    } end function empty

                    function push(self&, const W&: cost, unsigned long int: node) -> void {
                        HeapItem<W>: item;
                        item.cost = cost;
                        item.node = node;
                        self.items.push_back(item);
                        unsigned long int: i = self.items.size() - 1;
                        while (i > 0) {
                            const unsigned long int: up = (i - 1) / 2;
                            if (!(self.items[i].cost < self.items[up].cost)) then {
                                break;
                            }
                            const HeapItem<W>: held = self.items[i];
                            self.items[i] = self.items[up];
                            self.items[up] = held;
                            i = up;
                        }
                    } end function push

                    function pop(self&) -> HeapItem<W> {
                        const HeapItem<W>: top = self.items[0];
                        self.items[0] = self.items[static_cast<unsigned long int>(self.items.size() - 1)];
                        self.items.pop_back();
                        unsigned long int: i = 0;
                        while (true) {
                            const unsigned long int: l = i * 2 + 1;
                            const unsigned long int: r = l + 1;
                            unsigned long int: best = i;
                            if (l < self.items.size() && self.items[l].cost < self.items[best].cost) then {
                                best = l;
                            }
                            if (r < self.items.size() && self.items[r].cost < self.items[best].cost) then {
                                best = r;
                            }
                            if (best == i) then {
                                break;
                            }
                            const HeapItem<W>: held = self.items[i];
                            self.items[i] = self.items[best];
                            self.items[best] = held;
                            i = best;
                        }
                        return top;
                    } end function pop
                } end class MinHeap

                function reverse_ids(const std::collections::Vector<unsigned long int>&: ids) -> std::collections::Vector<unsigned long int> {
                    std::collections::Vector<unsigned long int>: out;
                    for (unsigned long int: i = ids.size(); i > 0;) {
                        i--;
                        out.push_back(ids[i]);
                    }
                    return out;
                } end function reverse_ids
            } end namespace detail

            template <typename T, typename W = float>
            requires Weight<W>
            class Graph {
                bool: is_directed_graph = false;
                std::collections::Vector<T>: node_values;
                std::collections::Vector<std::collections::Vector<Edge<W>>>: adjacency;

                function check(const self&, unsigned long int: node) -> void {
                    if (node >= self.node_values.size()) then {
                        throw std::errors::graph_error(static_cast<string>(`node ${node} isn't in this graph, which has ${self.node_values.size()} nodes`));
                    }
                } end function check

                function link(self&, unsigned long int: source, unsigned long int: target, const W&: weight) -> void {
                    self.adjacency[source].push_back(Edge<W>(source, target, weight));
                } end function link

                function unlink(self&, unsigned long int: source, unsigned long int: target) -> bool {
                    std::collections::Vector<Edge<W>>: kept;
                    bool: removed = false;
                    for (const Edge<W>&: e in self.adjacency[source]) {
                        if (e.target == target) then {
                            removed = true;
                        } else then {
                            kept.push_back(e);
                        }
                    }
                    self.adjacency[source] = kept;
                    return removed;
                } end function unlink

                function edge_cost(const self&, unsigned long int: source, unsigned long int: target) -> W {
                    bool: seen = false;
                    W: best = static_cast<W>(0);
                    for (const Edge<W>&: e in self.adjacency[source]) {
                        if (e.target == target && (!seen || e.weight < best)) then {
                            best = e.weight;
                            seen = true;
                        }
                    }
                    return best;
                } end function edge_cost

                function rebuild(const self&, const std::collections::Vector<unsigned long int>&: parent, unsigned long int: start, unsigned long int: goal) -> Path<W> {
                    std::collections::Vector<unsigned long int>: back;
                    unsigned long int: at = goal;
                    while (at != std::npos) {
                        back.push_back(at);
                        if (at == start) then {
                            break;
                        }
                        at = parent[at];
                    }
                    if (back.empty() || back[static_cast<unsigned long int>(back.size() - 1)] != start) then {
                        return Path<W>();
                    }
                    const std::collections::Vector<unsigned long int>: forward = detail::reverse_ids(back);
                    Path<W>: out(start);
                    for (unsigned long int: i = 1; i < forward.size(); i++) {
                        out.extend(forward[i], self.edge_cost(forward[static_cast<unsigned long int>(i - 1)], forward[i]));
                    }
                    return out;
                } end function rebuild

                function has_negative_weight(const self&) -> bool {
                    for (const std::collections::Vector<Edge<W>>&: list in self.adjacency) {
                        for (const Edge<W>&: e in list) {
                            if (e.weight < static_cast<W>(0)) then {
                                return true;
                            }
                        }
                    }
                    return false;
                } end function has_negative_weight

            public:
                constructor() { }

                constructor(Direction: direction) : is_directed_graph = direction == Direction::directed { }

                static function undirected() -> Graph {
                    return Graph(Direction::undirected);
                } end function undirected

                static function directed() -> Graph {
                    return Graph(Direction::directed);
                } end function directed

                function is_directed(const self&) -> bool {
                    return self.is_directed_graph;
                } end function is_directed

                function add_node(self&, const T&: value) -> unsigned long int {
                    self.node_values.push_back(value);
                    self.adjacency.push_back(std::collections::Vector<Edge<W>>());
                    return self.node_values.size() - 1;
                } end function add_node

                function add_nodes(self&, const std::collections::Vector<T>&: values) -> std::collections::Vector<unsigned long int> {
                    std::collections::Vector<unsigned long int>: ids;
                    for (const T&: v in values) {
                        ids.push_back(self.add_node(v));
                    }
                    return ids;
                } end function add_nodes

                function add_edge(self&, unsigned long int: source, unsigned long int: target, const W&: weight = static_cast<W>(1)) -> void {
                    self.check(source);
                    self.check(target);
                    self.link(source, target, weight);
                    if (!self.is_directed_graph && source != target) then {
                        self.link(target, source, weight);
                    }
                } end function add_edge

                function connect(self&, unsigned long int: source, unsigned long int: target, const W&: weight = static_cast<W>(1)) -> void {
                    self.add_edge(source, target, weight);
                } end function connect

                function remove_edge(self&, unsigned long int: source, unsigned long int: target) -> bool {
                    self.check(source);
                    self.check(target);
                    const bool: removed = self.unlink(source, target);
                    if (!self.is_directed_graph && source != target) then {
                        self.unlink(target, source);
                    }
                    return removed;
                } end function remove_edge

                function set_weight(self&, unsigned long int: source, unsigned long int: target, const W&: weight) -> void {
                    self.check(source);
                    self.check(target);
                    if (!self.has_edge(source, target)) then {
                        self.add_edge(source, target, weight);
                        return;
                    }
                    for (Edge<W>&: e in self.adjacency[source]) {
                        if (e.target == target) then {
                            e.weight = weight;
                        }
                    }
                    if (!self.is_directed_graph && source != target) then {
                        for (Edge<W>&: e in self.adjacency[target]) {
                            if (e.target == source) then {
                                e.weight = weight;
                            }
                        }
                    }
                } end function set_weight

                function has_edge(const self&, unsigned long int: source, unsigned long int: target) -> bool {
                    if (!self.contains(source) || !self.contains(target)) then {
                        return false;
                    }
                    for (const Edge<W>&: e in self.adjacency[source]) {
                        if (e.target == target) then {
                            return true;
                        }
                    }
                    return false;
                } end function has_edge

                function weight(const self&, unsigned long int: source, unsigned long int: target) -> W {
                    if (!self.has_edge(source, target)) then {
                        throw std::errors::graph_error(static_cast<string>(`there's no edge from ${source} to ${target}`));
                    }
                    return self.edge_cost(source, target);
                } end function weight

                function contains(const self&, unsigned long int: node) -> bool {
                    return node < self.node_values.size();
                } end function contains

                function node_count(const self&) -> unsigned long int {
                    return self.node_values.size();
                } end function node_count

                function size(const self&) -> unsigned long int {
                    return self.node_values.size();
                } end function size

                function empty(const self&) -> bool {
                    return self.node_values.empty();
                } end function empty

                function edge_count(const self&) -> unsigned long int {
                    unsigned long int: total = 0;
                    unsigned long int: loops = 0;
                    for (unsigned long int: i = 0; i < self.adjacency.size(); i++) {
                        for (const Edge<W>&: e in self.adjacency[i]) {
                            total++;
                            if (e.target == i) then {
                                loops++;
                            }
                        }
                    }
                    return self.is_directed_graph ? total : (total - loops) / 2 + loops;
                } end function edge_count

                function value(self&, unsigned long int: node) -> T& {
                    self.check(node);
                    return self.node_values[node];
                } end function value

                function value(const self&, unsigned long int: node) -> const T& {
                    self.check(node);
                    return self.node_values[node];
                } end function value

                operator([]) function(self&, unsigned long int: node) -> T& {
                    return self.value(node);
                }

                operator([]) function(const self&, unsigned long int: node) -> const T& {
                    return self.value(node);
                }

                function values(const self&) -> const std::collections::Vector<T>& {
                    return self.node_values;
                } end function values

                function nodes(const self&) -> std::collections::Vector<unsigned long int> {
                    std::collections::Vector<unsigned long int>: out;
                    for (unsigned long int: i = 0; i < self.node_values.size(); i++) {
                        out.push_back(i);
                    }
                    return out;
                } end function nodes

                function find(const self&, const T&: value) -> std::collections::Vector<unsigned long int> {
                    std::collections::Vector<unsigned long int>: out;
                    for (unsigned long int: i = 0; i < self.node_values.size(); i++) {
                        if (self.node_values[i] == value) then {
                            out.push_back(i);
                        }
                    }
                    return out;
                } end function find

                function find_first(const self&, const T&: value) -> unsigned long int {
                    for (unsigned long int: i = 0; i < self.node_values.size(); i++) {
                        if (self.node_values[i] == value) then {
                            return i;
                        }
                    }
                    return std::npos;
                } end function find_first

                function edges_from(const self&, unsigned long int: node) -> std::collections::Vector<Edge<W>> {
                    self.check(node);
                    return self.adjacency[node];
                } end function edges_from

                function edges_to(const self&, unsigned long int: node) -> std::collections::Vector<Edge<W>> {
                    self.check(node);
                    std::collections::Vector<Edge<W>>: out;
                    for (unsigned long int: i = 0; i < self.adjacency.size(); i++) {
                        for (const Edge<W>&: e in self.adjacency[i]) {
                            if (e.target == node) then {
                                out.push_back(e);
                            }
                        }
                    }
                    return out;
                } end function edges_to

                function edges(const self&) -> std::collections::Vector<Edge<W>> {
                    std::collections::Vector<Edge<W>>: out;
                    for (unsigned long int: i = 0; i < self.adjacency.size(); i++) {
                        for (const Edge<W>&: e in self.adjacency[i]) {
                            if (self.is_directed_graph || e.source <= e.target) then {
                                out.push_back(e);
                            }
                        }
                    }
                    return out;
                } end function edges

                function neighbors(const self&, unsigned long int: node) -> std::collections::Vector<unsigned long int> {
                    self.check(node);
                    std::collections::Vector<unsigned long int>: out;
                    for (const Edge<W>&: e in self.adjacency[node]) {
                        out.push_back(e.target);
                    }
                    return out;
                } end function neighbors

                function predecessors(const self&, unsigned long int: node) -> std::collections::Vector<unsigned long int> {
                    self.check(node);
                    std::collections::Vector<unsigned long int>: out;
                    for (unsigned long int: i = 0; i < self.adjacency.size(); i++) {
                        for (const Edge<W>&: e in self.adjacency[i]) {
                            if (e.target == node) then {
                                out.push_back(i);
                                break;
                            }
                        }
                    }
                    return out;
                } end function predecessors

                function out_degree(const self&, unsigned long int: node) -> unsigned long int {
                    self.check(node);
                    return self.adjacency[node].size();
                } end function out_degree

                function in_degree(const self&, unsigned long int: node) -> unsigned long int {
                    return self.edges_to(node).size();
                } end function in_degree

                function degree(const self&, unsigned long int: node) -> unsigned long int {
                    return self.is_directed_graph ? self.in_degree(node) + self.out_degree(node) : self.out_degree(node);
                } end function degree

                function clear(self&) -> void {
                    self.node_values.clear();
                    self.adjacency.clear();
                } end function clear

                function reversed(const self&) -> Graph {
                    Graph: out(self.is_directed_graph ? Direction::directed : Direction::undirected);
                    for (const T&: v in self.node_values) {
                        out.add_node(v);
                    }
                    for (unsigned long int: i = 0; i < self.adjacency.size(); i++) {
                        for (const Edge<W>&: e in self.adjacency[i]) {
                            if (self.is_directed_graph) then {
                                out.link(e.target, e.source, e.weight);
                            } else then {
                                out.link(e.source, e.target, e.weight);
                            }
                        }
                    }
                    return out;
                } end function reversed

                function breadth_first_search(const self&, unsigned long int: start) -> Traversal {
                    self.check(start);
                    const unsigned long int: n = self.node_values.size();
                    Traversal: out;
                    out.depth = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    out.parent = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    std::collections::Vector<unsigned long int>: queue;
                    unsigned long int: head = 0;
                    out.depth[start] = 0;
                    queue.push_back(start);
                    while (head < queue.size()) {
                        const unsigned long int: at = queue[head];
                        head++;
                        out.order.push_back(at);
                        for (const Edge<W>&: e in self.adjacency[at]) {
                            if (out.depth[static_cast<unsigned long int>(e.target)] == std::npos) then {
                                out.depth[static_cast<unsigned long int>(e.target)] = out.depth[at] + 1;
                                out.parent[static_cast<unsigned long int>(e.target)] = at;
                                queue.push_back(e.target);
                            }
                        }
                    }
                    return out;
                } end function breadth_first_search

                function breadth_first_search(const self&, unsigned long int: start, function(unsigned long int, unsigned long int) -> bool: visit) -> Traversal {
                    self.check(start);
                    const unsigned long int: n = self.node_values.size();
                    Traversal: out;
                    out.depth = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    out.parent = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    std::collections::Vector<unsigned long int>: queue;
                    unsigned long int: head = 0;
                    out.depth[start] = 0;
                    queue.push_back(start);
                    while (head < queue.size()) {
                        const unsigned long int: at = queue[head];
                        head++;
                        out.order.push_back(at);
                        if (!visit(at, out.depth[at])) then {
                            break;
                        }
                        for (const Edge<W>&: e in self.adjacency[at]) {
                            if (out.depth[static_cast<unsigned long int>(e.target)] == std::npos) then {
                                out.depth[static_cast<unsigned long int>(e.target)] = out.depth[at] + 1;
                                out.parent[static_cast<unsigned long int>(e.target)] = at;
                                queue.push_back(e.target);
                            }
                        }
                    }
                    return out;
                } end function breadth_first_search

                function parallel_breadth_first_search(const self&, unsigned long int: start, unsigned long int: threads = 0) -> Traversal {
                    return self.parallel_breadth_first_search(start, [](unsigned long int: node, unsigned long int: depth) -> bool { return true; }, threads);
                } end function parallel_breadth_first_search

                function parallel_breadth_first_search(const self&, unsigned long int: start, function(unsigned long int, unsigned long int) -> bool: visit, unsigned long int: threads = 0) -> Traversal {
                    self.check(start);
                    const unsigned long int: n = self.node_values.size();
                    const unsigned long int: workers = static_cast<unsigned long int>(threads > 0 ? threads : std::threading::hardware_threads());
                    Traversal: out;
                    out.depth = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    out.parent = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    detail::ClaimTable: claims(n);
                    claims.mark(start);
                    out.depth[start] = 0;
                    std::collections::Vector<unsigned long int>: frontier;
                    frontier.push_back(start);
                    unsigned long int: level = 0;

                    while (!frontier.empty()) {
                        for (unsigned long int: node in frontier) {
                            out.order.push_back(node);
                        }
                        const unsigned long int: count = frontier.size();
                        unsigned long int: parts = count / detail::parallel_grain;
                        if (parts > workers) then {
                            parts = workers;
                        }
                        if (parts < 1) then {
                            parts = 1;
                        }
                        std::collections::Vector<std::collections::Vector<unsigned long int>>: found = std::collections::Vector<std::collections::Vector<unsigned long int>>::filled(parts, std::collections::Vector<unsigned long int>());

                        bool: stopped = false;
                        for (unsigned long int: node in frontier) {
                            if (!visit(node, level)) then {
                                stopped = true;
                            }
                        }
                        if (stopped) then {
                            break;
                        }

                        auto: expanding = [&](unsigned long int: part) -> void {
                            const unsigned long int: lo = count * part / parts;
                            const unsigned long int: hi = count * (part + 1) / parts;
                            std::collections::Vector<unsigned long int>&: mine = found[part];
                            for (unsigned long int: i = lo; i < hi; i++) {
                                const unsigned long int: at = frontier[i];
                                for (const Edge<W>&: e in self.adjacency[at]) {
                                    if (claims.take_first(e.target)) then {
                                        mine.push_back(e.target);
                                        out.depth[static_cast<unsigned long int>(e.target)] = level + 1;
                                        out.parent[static_cast<unsigned long int>(e.target)] = at;
                                    }
                                }
                            }
                        };
                        detail::run_parts(parts, expanding);

                        level++;
                        frontier.clear();
                        for (const std::collections::Vector<unsigned long int>&: piece in found) {
                            for (unsigned long int: node in piece) {
                                frontier.push_back(node);
                            }
                        }
                    }
                    return out;
                } end function parallel_breadth_first_search

                function depth_first_search(const self&, unsigned long int: start) -> Traversal {
                    return self.depth_first_search(start, [](unsigned long int: node, unsigned long int: depth) -> bool { return true; });
                } end function depth_first_search

                function depth_first_search(const self&, unsigned long int: start, function(unsigned long int, unsigned long int) -> bool: visit) -> Traversal {
                    self.check(start);
                    const unsigned long int: n = self.node_values.size();
                    Traversal: out;
                    out.depth = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    out.parent = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    std::collections::Vector<unsigned int>: state = std::collections::Vector<unsigned int>::filled(n, 0);
                    std::collections::Vector<unsigned long int>: stack;
                    std::collections::Vector<unsigned long int>: cursor;
                    std::collections::Vector<bool>: skipped_parent;
                    out.depth[start] = 0;
                    state[start] = 1;
                    out.order.push_back(start);
                    if (!visit(start, 0)) then {
                        return out;
                    }
                    stack.push_back(start);
                    cursor.push_back(0);
                    skipped_parent.push_back(false);
                    while (!stack.empty()) {
                        const unsigned long int: top = stack.size() - 1;
                        const unsigned long int: at = stack[top];
                        if (cursor[top] < self.adjacency[at].size()) then {
                            const Edge<W>: e = self.adjacency[at][static_cast<unsigned long int>(cursor[static_cast<unsigned long int>(top)])];
                            cursor[top] = cursor[top] + 1;
                            if (!self.is_directed_graph && e.target == out.parent[at] && !skipped_parent[top]) then {
                                skipped_parent[top] = true;
                                continue;
                            }
                            if (state[static_cast<unsigned long int>(e.target)] == 0) then {
                                state[static_cast<unsigned long int>(e.target)] = 1;
                                out.depth[static_cast<unsigned long int>(e.target)] = out.depth[at] + 1;
                                out.parent[static_cast<unsigned long int>(e.target)] = at;
                                out.order.push_back(e.target);
                                if (!visit(e.target, out.depth[static_cast<unsigned long int>(e.target)])) then {
                                    return out;
                                }
                                stack.push_back(e.target);
                                cursor.push_back(0);
                                skipped_parent.push_back(false);
                            } else if (state[static_cast<unsigned long int>(e.target)] == 1) then {
                                out.loop_from.push_back(at);
                                out.loop_to.push_back(e.target);
                                if (out.has_cycle) then {
                                    continue;
                                }
                                out.has_cycle = true;
                                std::collections::Vector<unsigned long int>: back;
                                unsigned long int: walk = at;
                                while (walk != std::npos) {
                                    back.push_back(walk);
                                    if (walk == e.target) then {
                                        break;
                                    }
                                    walk = out.parent[walk];
                                }
                                out.cycle = detail::reverse_ids(back);
                                out.cycle.push_back(e.target);
                            }
                        } else then {
                            state[at] = 2;
                            stack.pop_back();
                            cursor.pop_back();
                            skipped_parent.pop_back();
                        }
                    }
                    return out;
                } end function depth_first_search

                function depth_first_postorder(const self&, unsigned long int: start) -> std::collections::Vector<unsigned long int> {
                    self.check(start);
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<bool>: seen = std::collections::Vector<bool>::filled(n, false);
                    std::collections::Vector<unsigned long int>: order;
                    std::collections::Vector<unsigned long int>: stack;
                    std::collections::Vector<unsigned long int>: cursor;
                    seen[start] = true;
                    stack.push_back(start);
                    cursor.push_back(0);
                    while (!stack.empty()) {
                        const unsigned long int: top = stack.size() - 1;
                        const unsigned long int: at = stack[top];
                        if (cursor[top] < self.adjacency[at].size()) then {
                            const unsigned long int: next = self.adjacency[at][cursor[top]].target;
                            cursor[top] = cursor[top] + 1;
                            if (!seen[next]) then {
                                seen[next] = true;
                                stack.push_back(next);
                                cursor.push_back(0);
                            }
                        } else then {
                            order.push_back(at);
                            stack.pop_back();
                            cursor.pop_back();
                        }
                    }
                    return order;
                } end function depth_first_postorder

                function reachable(const self&, unsigned long int: source, unsigned long int: target) -> bool {
                    self.check(target);
                    return self.breadth_first_search(source).reached(target);
                } end function reachable

                function hop_distances(const self&, unsigned long int: start) -> std::collections::Vector<unsigned long int> {
                    return self.breadth_first_search(start).depth;
                } end function hop_distances

                function breadth_first_path(const self&, unsigned long int: start, unsigned long int: goal) -> Path<W> {
                    self.check(goal);
                    const Traversal: t = self.breadth_first_search(start);
                    if (!t.reached(goal)) then {
                        return Path<W>();
                    }
                    return self.rebuild(t.parent, start, goal);
                } end function breadth_first_path

                function depth_first_path(const self&, unsigned long int: start, unsigned long int: goal) -> Path<W> {
                    self.check(goal);
                    const Traversal: t = self.depth_first_search(start, [goal](unsigned long int: node, unsigned long int: depth) -> bool { return node != goal; });
                    if (!t.reached(goal)) then {
                        return Path<W>();
                    }
                    return self.rebuild(t.parent, start, goal);
                } end function depth_first_path

                function shortest_distances(const self&, unsigned long int: start) -> Distances<W> {
                    self.check(start);
                    if (self.has_negative_weight()) then {
                        return self.bellman_ford(start);
                    }
                    const unsigned long int: n = self.node_values.size();
                    Distances<W>: out;
                    out.distance = std::collections::Vector<W>::filled(n, static_cast<W>(0));
                    out.reached = std::collections::Vector<bool>::filled(n, false);
                    out.parent = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    std::collections::Vector<bool>: done = std::collections::Vector<bool>::filled(n, false);
                    detail::MinHeap<W>: open;
                    out.reached[start] = true;
                    open.push(static_cast<W>(0), start);
                    while (!open.empty()) {
                        const detail::HeapItem<W>: item = open.pop();
                        const unsigned long int: at = item.node;
                        if (done[at]) then {
                            continue;
                        }
                        done[at] = true;
                        for (const Edge<W>&: e in self.adjacency[at]) {
                            if (done[static_cast<unsigned long int>(e.target)]) then {
                                continue;
                            }
                            const W: candidate = out.distance[at] + e.weight;
                            if (!out.reached[static_cast<unsigned long int>(e.target)] || candidate < out.distance[static_cast<unsigned long int>(e.target)]) then {
                                out.reached[static_cast<unsigned long int>(e.target)] = true;
                                out.distance[static_cast<unsigned long int>(e.target)] = candidate;
                                out.parent[static_cast<unsigned long int>(e.target)] = at;
                                open.push(candidate, e.target);
                            }
                        }
                    }
                    return out;
                } end function shortest_distances

                function bellman_ford(const self&, unsigned long int: start) -> Distances<W> {
                    self.check(start);
                    const unsigned long int: n = self.node_values.size();
                    Distances<W>: out;
                    out.distance = std::collections::Vector<W>::filled(n, static_cast<W>(0));
                    out.reached = std::collections::Vector<bool>::filled(n, false);
                    out.parent = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    out.reached[start] = true;
                    for (unsigned long int: round = 0; round < n; round++) {
                        bool: changed = false;
                        for (unsigned long int: at = 0; at < n; at++) {
                            if (!out.reached[at]) then {
                                continue;
                            }
                            for (const Edge<W>&: e in self.adjacency[at]) {
                                const W: candidate = out.distance[at] + e.weight;
                                if (!out.reached[static_cast<unsigned long int>(e.target)] || candidate < out.distance[static_cast<unsigned long int>(e.target)]) then {
                                    if (round == n - 1) then {
                                        out.has_negative_cycle = true;
                                    }
                                    out.reached[static_cast<unsigned long int>(e.target)] = true;
                                    out.distance[static_cast<unsigned long int>(e.target)] = candidate;
                                    out.parent[static_cast<unsigned long int>(e.target)] = at;
                                    changed = true;
                                }
                            }
                        }
                        if (!changed) then {
                            break;
                        }
                    }
                    return out;
                } end function bellman_ford

                function shortest_path(const self&, unsigned long int: start, unsigned long int: goal) -> Path<W> {
                    self.check(goal);
                    const Distances<W>: d = self.shortest_distances(start);
                    if (d.has_negative_cycle) then {
                        throw std::errors::graph_error("shortest_path(): the graph has a negative cycle, so there's no shortest path");
                    }
                    return d.path_to(goal);
                } end function shortest_path

                template <typename H>
                function a_star(const self&, unsigned long int: start, unsigned long int: goal, H: heuristic) -> Path<W> {
                    self.check(start);
                    self.check(goal);
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<W>: best = std::collections::Vector<W>::filled(n, static_cast<W>(0));
                    std::collections::Vector<bool>: known = std::collections::Vector<bool>::filled(n, false);
                    std::collections::Vector<bool>: done = std::collections::Vector<bool>::filled(n, false);
                    std::collections::Vector<unsigned long int>: parent = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    detail::MinHeap<W>: open;
                    known[start] = true;
                    open.push(static_cast<W>(heuristic(start)), start);
                    while (!open.empty()) {
                        const unsigned long int: at = open.pop().node;
                        if (done[at]) then {
                            continue;
                        }
                        done[at] = true;
                        if (at == goal) then {
                            return self.rebuild(parent, start, goal);
                        }
                        for (const Edge<W>&: e in self.adjacency[at]) {
                            if (done[static_cast<unsigned long int>(e.target)]) then {
                                continue;
                            }
                            const W: candidate = best[at] + e.weight;
                            if (!known[static_cast<unsigned long int>(e.target)] || candidate < best[static_cast<unsigned long int>(e.target)]) then {
                                known[static_cast<unsigned long int>(e.target)] = true;
                                best[static_cast<unsigned long int>(e.target)] = candidate;
                                parent[static_cast<unsigned long int>(e.target)] = at;
                                open.push(candidate + static_cast<W>(heuristic(e.target)), e.target);
                            }
                        }
                    }
                    return Path<W>();
                } end function a_star

                function all_simple_paths(const self&, unsigned long int: start, unsigned long int: goal, unsigned long int: max_edges = 9223372036854775807) -> std::collections::Vector<Path<W>> {
                    self.check(start);
                    self.check(goal);
                    std::collections::Vector<Path<W>>: out;
                    if (start == goal) then {
                        out.push_back(Path<W>(start));
                        return out;
                    }
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<bool>: on_path = std::collections::Vector<bool>::filled(n, false);
                    std::collections::Vector<unsigned long int>: stack;
                    std::collections::Vector<unsigned long int>: cursor;
                    std::collections::Vector<W>: costs;
                    stack.push_back(start);
                    cursor.push_back(0);
                    costs.push_back(static_cast<W>(0));
                    on_path[start] = true;
                    while (!stack.empty()) {
                        const unsigned long int: top = stack.size() - 1;
                        const unsigned long int: at = stack[top];
                        if (cursor[top] < self.adjacency[at].size() && (top < max_edges)) then {
                            const Edge<W>: e = self.adjacency[at][cursor[top]];
                            cursor[top] = cursor[top] + 1;
                            if (on_path[static_cast<unsigned long int>(e.target)]) then {
                                continue;
                            }
                            if (e.target == goal) then {
                                std::collections::Vector<unsigned long int>: nodes = stack;
                                nodes.push_back(goal);
                                out.push_back(Path<W>(nodes, costs[top] + e.weight));
                                continue;
                            }
                            on_path[static_cast<unsigned long int>(e.target)] = true;
                            stack.push_back(e.target);
                            cursor.push_back(0);
                            costs.push_back(costs[top] + e.weight);
                        } else then {
                            on_path[at] = false;
                            stack.pop_back();
                            cursor.pop_back();
                            costs.pop_back();
                        }
                    }
                    return out;
                } end function all_simple_paths

                function connected_components(const self&) -> std::collections::Vector<std::collections::Vector<unsigned long int>> {
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<std::collections::Vector<unsigned long int>>: out;
                    std::collections::Vector<bool>: seen = std::collections::Vector<bool>::filled(n, false);
                    const Graph: both = self.is_directed_graph ? self.undirected_copy() : *this;
                    for (unsigned long int: s = 0; s < n; s++) {
                        if (seen[s]) then {
                            continue;
                        }
                        const Traversal: t = both.breadth_first_search(s);
                        for (unsigned long int: id in t.order) {
                            seen[id] = true;
                        }
                        out.push_back(t.order);
                    }
                    return out;
                } end function connected_components

                function undirected_copy(const self&) -> Graph {
                    Graph: out(Direction::undirected);
                    for (const T&: v in self.node_values) {
                        out.add_node(v);
                    }
                    for (unsigned long int: i = 0; i < self.adjacency.size(); i++) {
                        for (const Edge<W>&: e in self.adjacency[i]) {
                            if (!self.is_directed_graph && e.target < e.source) then {
                                continue;
                            }
                            out.add_edge(e.source, e.target, e.weight);
                        }
                    }
                    return out;
                } end function undirected_copy

                function is_connected(const self&) -> bool {
                    return self.connected_components().size() <= 1;
                } end function is_connected

                function strongly_connected_components(const self&) -> std::collections::Vector<std::collections::Vector<unsigned long int>> {
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<bool>: seen = std::collections::Vector<bool>::filled(n, false);
                    std::collections::Vector<unsigned long int>: finish;
                    for (unsigned long int: s = 0; s < n; s++) {
                        if (seen[s]) then {
                            continue;
                        }
                        std::collections::Vector<unsigned long int>: stack;
                        std::collections::Vector<unsigned long int>: cursor;
                        seen[s] = true;
                        stack.push_back(s);
                        cursor.push_back(0);
                        while (!stack.empty()) {
                            const unsigned long int: top = stack.size() - 1;
                            const unsigned long int: at = stack[top];
                            if (cursor[top] < self.adjacency[at].size()) then {
                                const unsigned long int: next = self.adjacency[at][cursor[top]].target;
                                cursor[top] = cursor[top] + 1;
                                if (!seen[next]) then {
                                    seen[next] = true;
                                    stack.push_back(next);
                                    cursor.push_back(0);
                                }
                            } else then {
                                finish.push_back(at);
                                stack.pop_back();
                                cursor.pop_back();
                            }
                        }
                    }
                    const Graph: back = self.reversed();
                    std::collections::Vector<bool>: assigned = std::collections::Vector<bool>::filled(n, false);
                    std::collections::Vector<std::collections::Vector<unsigned long int>>: out;
                    for (unsigned long int: i = finish.size(); i > 0;) {
                        i--;
                        const unsigned long int: s = finish[i];
                        if (assigned[s]) then {
                            continue;
                        }
                        std::collections::Vector<unsigned long int>: component;
                        std::collections::Vector<unsigned long int>: todo;
                        todo.push_back(s);
                        assigned[s] = true;
                        while (!todo.empty()) {
                            const unsigned long int: at = todo[static_cast<unsigned long int>(todo.size() - 1)];
                            todo.pop_back();
                            component.push_back(at);
                            for (const Edge<W>&: e in back.adjacency[at]) {
                                if (!assigned[static_cast<unsigned long int>(e.target)]) then {
                                    assigned[static_cast<unsigned long int>(e.target)] = true;
                                    todo.push_back(e.target);
                                }
                            }
                        }
                        out.push_back(component);
                    }
                    return out;
                } end function strongly_connected_components

                function topological_sort(const self&) -> std::collections::Vector<unsigned long int> {
                    if (!self.is_directed_graph) then {
                        throw std::errors::graph_error("topological_sort() needs a directed graph");
                    }
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<unsigned long int>: incoming = std::collections::Vector<unsigned long int>::filled(n, 0);
                    for (unsigned long int: i = 0; i < n; i++) {
                        for (const Edge<W>&: e in self.adjacency[i]) {
                            incoming[static_cast<unsigned long int>(e.target)] = incoming[static_cast<unsigned long int>(e.target)] + 1;
                        }
                    }
                    std::collections::Vector<unsigned long int>: ready;
                    for (unsigned long int: i = 0; i < n; i++) {
                        if (incoming[i] == 0) then {
                            ready.push_back(i);
                        }
                    }
                    std::collections::Vector<unsigned long int>: order;
                    unsigned long int: head = 0;
                    while (head < ready.size()) {
                        const unsigned long int: at = ready[head];
                        head++;
                        order.push_back(at);
                        for (const Edge<W>&: e in self.adjacency[at]) {
                            incoming[static_cast<unsigned long int>(e.target)] = incoming[static_cast<unsigned long int>(e.target)] - 1;
                            if (incoming[static_cast<unsigned long int>(e.target)] == 0) then {
                                ready.push_back(e.target);
                            }
                        }
                    }
                    if (order.size() != n) then {
                        throw std::errors::graph_error("topological_sort(): the graph has a cycle, so it has no topological order");
                    }
                    return order;
                } end function topological_sort

                function find_cycle(const self&) -> Path<W> {
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<bool>: covered = std::collections::Vector<bool>::filled(n, false);
                    for (unsigned long int: s = 0; s < n; s++) {
                        if (covered[s]) then {
                            continue;
                        }
                        const Traversal: t = self.depth_first_search(s);
                        if (t.has_cycle) then {
                            Path<W>: out(t.cycle[0]);
                            for (unsigned long int: i = 1; i < t.cycle.size(); i++) {
                                out.extend(t.cycle[i], self.edge_cost(t.cycle[static_cast<unsigned long int>(i - 1)], t.cycle[i]));
                            }
                            return out;
                        }
                        for (unsigned long int: id in t.order) {
                            covered[id] = true;
                        }
                    }
                    return Path<W>();
                } end function find_cycle

                function has_cycle(const self&) -> bool {
                    return self.find_cycle().found();
                } end function has_cycle

                function is_acyclic(const self&) -> bool {
                    return !self.has_cycle();
                } end function is_acyclic

                function is_tree(const self&) -> bool {
                    if (self.is_directed_graph) then {
                        return self.undirected_copy().is_tree();
                    }
                    return !self.empty() && self.is_connected() && !self.has_cycle();
                } end function is_tree

                function is_bipartite(const self&) -> bool {
                    const unsigned long int: n = self.node_values.size();
                    const Graph: both = self.is_directed_graph ? self.undirected_copy() : *this;
                    std::collections::Vector<unsigned long int>: side = std::collections::Vector<unsigned long int>::filled(n, std::npos);
                    for (unsigned long int: s = 0; s < n; s++) {
                        if (side[s] != std::npos) then {
                            continue;
                        }
                        side[s] = 0;
                        std::collections::Vector<unsigned long int>: queue;
                        unsigned long int: head = 0;
                        queue.push_back(s);
                        while (head < queue.size()) {
                            const unsigned long int: at = queue[head];
                            head++;
                            for (const Edge<W>&: e in both.adjacency[at]) {
                                if (side[static_cast<unsigned long int>(e.target)] == std::npos) then {
                                    side[static_cast<unsigned long int>(e.target)] = 1 - side[at];
                                    queue.push_back(e.target);
                                } else if (side[static_cast<unsigned long int>(e.target)] == side[at]) then {
                                    return false;
                                }
                            }
                        }
                    }
                    return true;
                } end function is_bipartite

                function minimum_spanning_tree(const self&) -> std::collections::Vector<Edge<W>> {
                    const unsigned long int: n = self.node_values.size();
                    std::collections::Vector<Edge<W>>: all = self.undirected_copy().edges();
                    for (unsigned long int: i = 1; i < all.size(); i++) {
                        unsigned long int: j = i;
                        while (j > 0 && all[j].weight < all[static_cast<unsigned long int>(j - 1)].weight) {
                            const Edge<W>: held = all[j];
                            all[j] = all[static_cast<unsigned long int>(j - 1)];
                            all[static_cast<unsigned long int>(j - 1)] = held;
                            j--;
                        }
                    }
                    std::collections::Vector<unsigned long int>: root;
                    for (unsigned long int: i = 0; i < n; i++) {
                        root.push_back(i);
                    }
                    std::collections::Vector<Edge<W>>: out;
                    for (const Edge<W>&: e in all) {
                        unsigned long int: a = e.source;
                        while (root[a] != a) {
                            root[a] = root[root[a]];
                            a = root[a];
                        }
                        unsigned long int: b = e.target;
                        while (root[b] != b) {
                            root[b] = root[root[b]];
                            b = root[b];
                        }
                        if (a != b) then {
                            root[a] = b;
                            out.push_back(e);
                        }
                    }
                    return out;
                } end function minimum_spanning_tree

                function path_values(const self&, const Path<W>&: path) -> std::collections::Vector<T> {
                    std::collections::Vector<T>: out;
                    for (unsigned long int: id in path.nodes()) {
                        out.push_back(self.value(id));
                    }
                    return out;
                } end function path_values

                function path_is_valid(const self&, const Path<W>&: path) -> bool {
                    for (unsigned long int: i = 1; i < path.node_count(); i++) {
                        if (!self.has_edge(path[static_cast<unsigned long int>(i - 1)], path[i])) then {
                            return false;
                        }
                    }
                    return true;
                } end function path_is_valid

                function to_string(const self&) -> string {
                    string: out = self.is_directed_graph ? "directed graph" : "graph";
                    out += static_cast<string>(` with ${self.node_count()} nodes and ${self.edge_count()} edges`);
                    for (const Edge<W>&: e in self.edges()) {
                        out += static_cast<string>(`\n  ${e.source} ${self.is_directed_graph ? "->" : "--"} ${e.target} (${std::core::to_string(e.weight)})`);
                    }
                    return out;
                } end function to_string
            } end class Graph

            template <typename T, typename W = float>
            requires Weight<W>
            function directed_graph() -> Graph<T, W> {
                return Graph<T, W>(Direction::directed);
            } end function directed_graph

            template <typename T, typename W = float>
            requires Weight<W>
            function undirected_graph() -> Graph<T, W> {
                return Graph<T, W>(Direction::undirected);
            } end function undirected_graph
        } end namespace graphs
    } end namespace std
} end safe
