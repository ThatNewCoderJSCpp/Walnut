            template <typename T>
            requires Real<T>
            class Gamma as "walnut_rt::stats::Gamma" {
            public:
                constructor(const T&: shape, const T&: scale) as "walnut_rt::stats::make_gamma<T>";
                function mean() const -> T as "walnut_rt::stats::dist_mean";
                function variance() const -> T as "walnut_rt::stats::dist_variance";
                function standard_deviation() const -> T as "walnut_rt::stats::dist_sd";
                function median() const -> T as "walnut_rt::stats::dist_median";
                function quantile(const T&: p) const -> T as "walnut_rt::stats::dist_quantile";
                function upper_quantile(const T&: p) const -> T as "walnut_rt::stats::dist_upper_quantile";
