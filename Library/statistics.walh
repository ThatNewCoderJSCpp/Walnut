        struct Condition {
            string: name;
            bool: met = true;
            string: detail;
        } end struct Condition

        template <typename T>
        struct Quartiles {
            T: q1;
            T: median;
            T: q3;

            function interquartile_range() const -> T {
                return q3 - q1;
            } end function interquartile_range
        } end struct Quartiles

        template <typename T>
        struct FiveNumberSummary {
            T: minimum;
            T: q1;
            T: median;
            T: q3;
            T: maximum;

            function range() const -> T {
                return maximum - minimum;
            } end function range

            function interquartile_range() const -> T {
                return q3 - q1;
            } end function interquartile_range
        } end struct FiveNumberSummary

        template <typename T>
        struct LinearRegression {
            T: slope;
            T: intercept;
            T: r;
            T: r_squared;
            T: residual_standard_error;
            T: slope_standard_error;
            T: intercept_standard_error;
            long int: size = 0;

            function predict(const T&: x) const -> T {
                return intercept + slope * x;
            } end function predict

            function residual(const T&: x, const T&: y) const -> T {
                return y - predict(x);
            } end function residual
        } end struct LinearRegression

        template <typename T>
        struct TestResult {
            string: name;
            T: statistic;
            T: p_value;
            T: degrees_of_freedom;
            T: estimate;
            T: null_value;
            T: standard_error;
            Tail: tail = Tail::two;
            std::collections::Vector<Condition>: conditions;

            function reject(const T&: alpha) const -> bool {
                return p_value < alpha;
            } end function reject

            function fail_to_reject(const T&: alpha) const -> bool {
                return !reject(alpha);
            } end function fail_to_reject

            function conditions_met() const -> bool {
                for (const Condition&: c in conditions) {
                    if (!c.met) then {
                        return false;
                    }
                }
                return true;
            } end function conditions_met

            function to_string() const -> string {
                return static_cast<string>(`${name}: statistic ${std::core::to_string(statistic)}, p-value ${std::core::to_string(p_value)}`);
            } end function to_string
        } end struct TestResult

        template <typename T>
        struct ConfidenceInterval {
            string: name;
            T: estimate;
            T: critical_value;
            T: standard_error;
            T: margin_of_error;
            T: lower;
            T: upper;
            T: confidence;
            T: degrees_of_freedom;
            std::collections::Vector<Condition>: conditions;

            function contains(const T&: value) const -> bool {
                return value >= lower && value <= upper;
            } end function contains

            function width() const -> T {
                return upper - lower;
            } end function width

            function conditions_met() const -> bool {
                for (const Condition&: c in conditions) {
                    if (!c.met) then {
                        return false;
                    }
                }
                return true;
            } end function conditions_met

            function to_string() const -> string {
                return static_cast<string>(`${name}: (${std::core::to_string(lower)}, ${std::core::to_string(upper)})`);
            } end function to_string
        } end struct ConfidenceInterval

        struct Proportion {
            long int: successes = 0;
            long int: size = 0;
            long int: population = 0;

            constructor() { }

            constructor(long int: success_count, long int: sample_size) : successes = success_count, size = sample_size { }

            constructor(long int: success_count, long int: sample_size, long int: population_size) : successes = success_count, size = sample_size, population = population_size { }

            function with_population(long int: population_size) const -> Proportion {
                return Proportion(successes, size, population_size);
            } end function with_population

            function failures() const -> long int {
                return size - successes;
            } end function failures

            template <typename T = float>
            function value() const -> T {
                return static_cast<T>(successes) / static_cast<T>(size);
            } end function value
        } end struct Proportion

        namespace detail {
            template <typename T>
            function conditions_of(const RawTest<T>&: raw) -> std::collections::Vector<Condition> {
                std::collections::Vector<Condition>: out;
                for (long int: i = 0; i < raw.condition_count(); i++) {
                    Condition: c;
                    c.name = raw.condition_name(i);
                    c.met = raw.condition_met(i);
                    c.detail = raw.condition_detail(i);
                    out.push_back(c);
                }
                return out;
            } end function conditions_of

            template <typename T>
            function conditions_of(const RawInterval<T>&: raw) -> std::collections::Vector<Condition> {
                std::collections::Vector<Condition>: out;
                for (long int: i = 0; i < raw.condition_count(); i++) {
                    Condition: c;
                    c.name = raw.condition_name(i);
                    c.met = raw.condition_met(i);
                    c.detail = raw.condition_detail(i);
                    out.push_back(c);
                }
                return out;
            } end function conditions_of

            template <typename T>
            function test(const RawTest<T>&: raw) -> TestResult<T> {
                TestResult<T>: out;
                out.name = raw.name();
                out.statistic = raw.number(0);
                out.p_value = raw.number(1);
                out.degrees_of_freedom = raw.number(2);
                out.estimate = raw.number(3);
                out.null_value = raw.number(4);
                out.standard_error = raw.number(5);
                const int: code = raw.tail_code();
                out.tail = code == 0 ? Tail::lower : (code == 1 ? Tail::upper : Tail::two);
                out.conditions = conditions_of(raw);
                return out;
            } end function test

            template <typename T>
            function interval(const RawInterval<T>&: raw) -> ConfidenceInterval<T> {
                ConfidenceInterval<T>: out;
                out.name = raw.name();
                out.estimate = raw.number(0);
                out.critical_value = raw.number(1);
                out.standard_error = raw.number(2);
                out.margin_of_error = raw.number(3);
                out.lower = raw.number(4);
                out.upper = raw.number(5);
                out.confidence = raw.number(6);
                out.degrees_of_freedom = raw.number(7);
                out.conditions = conditions_of(raw);
                return out;
            } end function interval

            template <typename T>
            function require_data(const std::collections::Vector<T>&: data, long int: at_least, const string&: what) -> void {
                if (data.size() < at_least) then {
                    throw std::errors::statistics_error(static_cast<string>(`${what} needs at least ${at_least} values, not ${data.size()}`));
                }
            } end function require_data

            template <typename T>
            function require_same_size(const std::collections::Vector<T>&: x, const std::collections::Vector<T>&: y, const string&: what) -> void {
                if (x.size() != y.size()) then {
                    throw std::errors::statistics_error(static_cast<string>(`${what} needs two lists of the same size, not ${x.size()} and ${y.size()}`));
                }
            } end function require_same_size
        } end namespace detail

        template <typename T>
        requires Real<T>
        function sum(const std::collections::Vector<T>&: data) -> T {
            return Native<T>::sum(data);
        } end function sum

        template <typename T>
        requires Real<T>
        function mean(const std::collections::Vector<T>&: data) -> T {
            detail::require_data(data, 1, "mean()");
            return Native<T>::mean(data);
        } end function mean

