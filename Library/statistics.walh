        requires Real<T>
        function modes(const std::collections::Vector<T>&: data) -> std::collections::Vector<T> {
            return Native<T>::modes(data);
        } end function modes

        template <typename T>
        requires Real<T>
        function quantile(const std::collections::Vector<T>&: data, const T&: p) -> T {
            detail::require_data(data, 1, "quantile()");
            if (p < static_cast<T>(0) || p > static_cast<T>(1)) then {
                throw std::errors::statistics_error("quantile() needs p between 0 and 1");
            }
            return Native<T>::quantile(data, p);
        } end function quantile

        template <typename T>
        requires Real<T>
        function percentile(const std::collections::Vector<T>&: data, const T&: percent) -> T {
            detail::require_data(data, 1, "percentile()");
            if (percent < static_cast<T>(0) || percent > static_cast<T>(100)) then {
                throw std::errors::statistics_error("percentile() needs a percent between 0 and 100");
            }
            return Native<T>::percentile(data, percent);
        } end function percentile

        template <typename T>
        requires Real<T>
        function quartiles(const std::collections::Vector<T>&: data) -> Quartiles<T> {
            detail::require_data(data, 1, "quartiles()");
            const std::collections::Vector<T>: q = Native<T>::quartiles(data);
            Quartiles<T>: out;
            out.q1 = q[0];
            out.median = q[1];
            out.q3 = q[2];
            return out;
        } end function quartiles

        template <typename T>
        requires Real<T>
        function five_number_summary(const std::collections::Vector<T>&: data) -> FiveNumberSummary<T> {
            detail::require_data(data, 1, "five_number_summary()");
            const std::collections::Vector<T>: q = Native<T>::five_numbers(data);
            FiveNumberSummary<T>: out;
            out.minimum = q[0];
            out.q1 = q[1];
            out.median = q[2];
            out.q3 = q[3];
            out.maximum = q[4];
            return out;
        } end function five_number_summary

