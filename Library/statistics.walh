import module.collections

namespace std {
    namespace errors {
        class statistics_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what() const -> string {
                return message;
            } end function what
        } end class statistics_error
    } end namespace errors

    namespace statistics {
        enum Tail { lower, upper, two }

        enum Variances { unequal, equal }

        enum Expected { infer, counts, proportions }

        template <typename T>
        concept Real = std::traits::is_builtin_float<T>

        extern "C++" from "<walnut_statistics.hpp>" {
            template <typename T>
            class Sample as "walnut_rt::stats::Sample" {
            public:
                static function of(const std::collections::Vector<T>&: data) -> Sample as "walnut_rt::stats::sample_from_data";
                static function from_summary(const T&: mean, const T&: standard_deviation, long int: size) -> Sample as "walnut_rt::stats::sample_from_summary";
                static function differences(const std::collections::Vector<T>&: before, const std::collections::Vector<T>&: after) -> Sample as "walnut_rt::stats::sample_from_differences";
                function with_population(long int: population) const -> Sample as "walnut_rt::stats::sample_with_population";
                function size() const -> long int as "walnut_rt::stats::sample_size";
                function population() const -> long int as "walnut_rt::stats::sample_population";
                function degrees_of_freedom() const -> long int as "walnut_rt::stats::sample_df";
                function has_population() const -> bool;
                function mean() const -> T;
                function standard_deviation() const -> T;
                function standard_error() const -> T;
            } end class Sample

            template <typename T>
            class RawTest as "walnut_rt::stats::TestResult" {
            public:
                function name() const -> string as "walnut_rt::stats::test_name";
                function number(int: which) const -> T as "walnut_rt::stats::test_number";
                function tail_code() const -> int as "walnut_rt::stats::test_tail";
                function condition_count() const -> long int as "walnut_rt::stats::test_condition_count";
                function condition_name(long int: i) const -> string as "walnut_rt::stats::test_condition_name";
                function condition_met(long int: i) const -> bool as "walnut_rt::stats::test_condition_met";
                function condition_detail(long int: i) const -> string as "walnut_rt::stats::test_condition_detail";
            } end class RawTest

            template <typename T>
            class RawInterval as "walnut_rt::stats::ConfidenceInterval" {
            public:
                function name() const -> string as "walnut_rt::stats::interval_name";
                function number(int: which) const -> T as "walnut_rt::stats::interval_number";
                function condition_count() const -> long int as "walnut_rt::stats::interval_condition_count";
                function condition_name(long int: i) const -> string as "walnut_rt::stats::interval_condition_name";
                function condition_met(long int: i) const -> bool as "walnut_rt::stats::interval_condition_met";
                function condition_detail(long int: i) const -> string as "walnut_rt::stats::interval_condition_detail";
            } end class RawInterval

            template <typename T>
            class Native as "walnut_rt::stats::tag" {
            public:
                static function sum(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::sum";
                static function mean(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::mean";
                static function median(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::median";
                static function mode(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::mode";
                static function minimum(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::minimum";
                static function maximum(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::maximum";
                static function range(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::range";
                static function variance(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::variance";
                static function population_variance(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::population_variance";
                static function standard_deviation(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::standard_deviation";
                static function population_standard_deviation(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::population_standard_deviation";
                static function standard_error(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::standard_error";
                static function interquartile_range(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::interquartile_range";
                static function geometric_mean(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::geometric_mean";
                static function harmonic_mean(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::harmonic_mean";
                static function mean_absolute_deviation(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::mean_absolute_deviation";
                static function median_absolute_deviation(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::median_absolute_deviation";
                static function coefficient_of_variation(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::coefficient_of_variation";
                static function sum_of_squares(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::sum_of_squares";
                static function root_mean_square(const std::collections::Vector<T>&: data) -> T as "walnut_rt::stats::root_mean_square";
                static function modes(const std::collections::Vector<T>&: data) -> std::collections::Vector<T> as "walnut_rt::stats::modes";
                static function quantile(const std::collections::Vector<T>&: data, const T&: p) -> T as "walnut_rt::stats::quantile";
                static function percentile(const std::collections::Vector<T>&: data, const T&: p) -> T as "walnut_rt::stats::percentile";
                static function outliers(const std::collections::Vector<T>&: data, const T&: fence) -> std::collections::Vector<T> as "walnut_rt::stats::outliers";
                static function skewness(const std::collections::Vector<T>&: data, bool: sample) -> T as "walnut_rt::stats::skewness";
                static function kurtosis(const std::collections::Vector<T>&: data, bool: sample) -> T as "walnut_rt::stats::kurtosis";
                static function excess_kurtosis(const std::collections::Vector<T>&: data, bool: sample) -> T as "walnut_rt::stats::excess_kurtosis";
                static function pearson_kurtosis(const std::collections::Vector<T>&: data, bool: sample) -> T as "walnut_rt::stats::pearson_kurtosis";
                static function covariance(const std::collections::Vector<T>&: x, const std::collections::Vector<T>&: y, bool: sample) -> T as "walnut_rt::stats::covariance";
                static function correlation(const std::collections::Vector<T>&: x, const std::collections::Vector<T>&: y) -> T as "walnut_rt::stats::correlation";
                static function z_score(const T&: x, const T&: m, const T&: sd) -> T as "walnut_rt::stats::z_score";
                static function z_scores(const std::collections::Vector<T>&: data, bool: sample) -> std::collections::Vector<T> as "walnut_rt::stats::z_scores";
                static function weighted_mean(const std::collections::Vector<T>&: data, const std::collections::Vector<T>&: weights) -> T as "walnut_rt::stats::weighted_mean";
                static function quartiles(const std::collections::Vector<T>&: data) -> std::collections::Vector<T> as "walnut_rt::stats::quartiles";
                static function five_numbers(const std::collections::Vector<T>&: data) -> std::collections::Vector<T> as "walnut_rt::stats::five_numbers";
                static function regression(const std::collections::Vector<T>&: x, const std::collections::Vector<T>&: y) -> std::collections::Vector<T> as "walnut_rt::stats::regression";
                static function one_mean_t_test(const Sample<T>&: s, const T&: mu0, int: tail) -> RawTest<T> as "walnut_rt::stats::one_mean_t_test";
                static function one_mean_z_test(const Sample<T>&: s, const T&: sigma, const T&: mu0, int: tail) -> RawTest<T> as "walnut_rt::stats::one_mean_z_test";
                static function two_mean_t_test(const Sample<T>&: a, const Sample<T>&: b, const T&: d0, int: tail, int: v) -> RawTest<T> as "walnut_rt::stats::two_mean_t_test";
                static function two_mean_z_test(const Sample<T>&: a, const T&: s1, const Sample<T>&: b, const T&: s2, const T&: d0, int: tail) -> RawTest<T> as "walnut_rt::stats::two_mean_z_test";
                static function paired_t_test(const Sample<T>&: d, const T&: d0, int: tail) -> RawTest<T> as "walnut_rt::stats::paired_t_test";
                static function one_proportion_z_test(long int: s, long int: n, long int: pop, const T&: p0, int: tail) -> RawTest<T> as "walnut_rt::stats::one_proportion_z_test<T>";
                static function two_proportion_z_test(long int: s1, long int: n1, long int: pop1, long int: s2, long int: n2, long int: pop2, int: tail) -> RawTest<T> as "walnut_rt::stats::two_proportion_z_test<T>";
                static function goodness_of_fit(const std::collections::Vector<T>&: observed, const std::collections::Vector<T>&: expected, int: kind) -> RawTest<T> as "walnut_rt::stats::goodness_of_fit";
                static function independence(const std::collections::Vector<std::collections::Vector<T>>&: table) -> RawTest<T> as "walnut_rt::stats::independence";
                static function homogeneity(const std::collections::Vector<std::collections::Vector<T>>&: table) -> RawTest<T> as "walnut_rt::stats::homogeneity";
                static function slope_t_test(const std::collections::Vector<T>&: x, const std::collections::Vector<T>&: y, const T&: b0, int: tail) -> RawTest<T> as "walnut_rt::stats::slope_t_test";
                static function one_mean_t_interval(const Sample<T>&: s, const T&: c) -> RawInterval<T> as "walnut_rt::stats::one_mean_t_interval";
                static function one_mean_z_interval(const Sample<T>&: s, const T&: sigma, const T&: c) -> RawInterval<T> as "walnut_rt::stats::one_mean_z_interval";
                static function two_mean_t_interval(const Sample<T>&: a, const Sample<T>&: b, const T&: c, int: v) -> RawInterval<T> as "walnut_rt::stats::two_mean_t_interval";
                static function two_mean_z_interval(const Sample<T>&: a, const T&: s1, const Sample<T>&: b, const T&: s2, const T&: c) -> RawInterval<T> as "walnut_rt::stats::two_mean_z_interval";
                static function paired_t_interval(const Sample<T>&: d, const T&: c) -> RawInterval<T> as "walnut_rt::stats::paired_t_interval";
                static function variance_interval(const Sample<T>&: s, const T&: c) -> RawInterval<T> as "walnut_rt::stats::variance_interval";
                static function slope_t_interval(const std::collections::Vector<T>&: x, const std::collections::Vector<T>&: y, const T&: c) -> RawInterval<T> as "walnut_rt::stats::slope_t_interval";
                static function one_proportion_z_interval(long int: s, long int: n, long int: pop, const T&: c) -> RawInterval<T> as "walnut_rt::stats::one_proportion_z_interval<T>";
                static function two_proportion_z_interval(long int: s1, long int: n1, long int: pop1, long int: s2, long int: n2, long int: pop2, const T&: c) -> RawInterval<T> as "walnut_rt::stats::two_proportion_z_interval<T>";
                static function critical_z(const T&: alpha, int: tail) -> T as "walnut_rt::stats::critical_z";
                static function critical_t(const T&: alpha, const T&: df, int: tail) -> T as "walnut_rt::stats::critical_t";
                static function critical_chi_squared(const T&: alpha, const T&: df) -> T as "walnut_rt::stats::critical_chi_squared";
                static function critical_f(const T&: alpha, const T&: d1, const T&: d2) -> T as "walnut_rt::stats::critical_f";
                static function z_star(const T&: c) -> T as "walnut_rt::stats::z_star";
                static function t_star(const T&: c, const T&: df) -> T as "walnut_rt::stats::t_star";
                static function z_statistic(const T&: e, const T&: n, const T&: se) -> T as "walnut_rt::stats::z_statistic";
                static function t_statistic(const Sample<T>&: s, const T&: mu0) -> T as "walnut_rt::stats::t_statistic";
                static function welch_df(const Sample<T>&: a, const Sample<T>&: b) -> T as "walnut_rt::stats::welch_df";
                static function one_mean_z_power(const T&: m0, const T&: ma, const T&: sigma, long int: n, const T&: alpha, int: tail) -> T as "walnut_rt::stats::one_mean_z_power";
                static function one_mean_t_power(const T&: m0, const T&: ma, const T&: sd, long int: n, const T&: alpha, int: tail) -> T as "walnut_rt::stats::one_mean_t_power";
                static function two_mean_z_power(const T&: d0, const T&: da, const T&: s1, long int: n1, const T&: s2, long int: n2, const T&: alpha, int: tail) -> T as "walnut_rt::stats::two_mean_z_power";
                static function two_mean_t_power(const T&: d0, const T&: da, const T&: s1, long int: n1, const T&: s2, long int: n2, const T&: alpha, int: tail, int: v) -> T as "walnut_rt::stats::two_mean_t_power";
                static function one_proportion_z_power(const T&: p0, const T&: pa, long int: n, const T&: alpha, int: tail) -> T as "walnut_rt::stats::one_proportion_z_power";
                static function two_proportion_z_power(const T&: p1, const T&: p2, long int: n1, long int: n2, const T&: alpha, int: tail) -> T as "walnut_rt::stats::two_proportion_z_power";
                static function size_for_mean(const T&: margin, const T&: sigma, const T&: c) -> long int as "walnut_rt::stats::size_for_mean";
                static function size_for_proportion(const T&: margin, const T&: c, const T&: guess) -> long int as "walnut_rt::stats::size_for_proportion";
            } end class Native

            template <typename T>
            requires Real<T>
            class Normal as "walnut_rt::stats::Normal" {
            public:
                constructor() as "walnut_rt::stats::make_normal_standard<T>";
                constructor(const T&: mean, const T&: standard_deviation) as "walnut_rt::stats::make_normal<T>";
                function mean() const -> T as "walnut_rt::stats::dist_mean";
                function variance() const -> T as "walnut_rt::stats::dist_variance";
                function standard_deviation() const -> T as "walnut_rt::stats::dist_sd";
                function median() const -> T as "walnut_rt::stats::dist_median";
                function quantile(const T&: p) const -> T as "walnut_rt::stats::dist_quantile";
                function upper_quantile(const T&: p) const -> T as "walnut_rt::stats::dist_upper_quantile";
                function is_valid() const -> bool as "walnut_rt::stats::dist_valid";
                function pdf(const T&: x) const -> T as "walnut_rt::stats::dist_pdf";
                function log_pdf(const T&: x) const -> T as "walnut_rt::stats::dist_log_pdf";
                function cdf(const T&: x) const -> T as "walnut_rt::stats::dist_cdf";
                function survival(const T&: x) const -> T as "walnut_rt::stats::dist_survival";
                function between(const T&: low, const T&: high) const -> T as "walnut_rt::stats::dist_between";
                function outside(const T&: low, const T&: high) const -> T as "walnut_rt::stats::dist_outside";

                function below(const T&: x) const -> T {
                    return cdf(x);
                } end function below

                function above(const T&: x) const -> T {
                    return survival(x);
                } end function above

                function inverse_cdf(const T&: p) const -> T {
                    return quantile(p);
                } end function inverse_cdf

                function z_score(const T&: x) const -> T {
                    return (x - mean()) / standard_deviation();
                } end function z_score

                function value_at(const T&: z) const -> T {
                    return mean() + z * standard_deviation();
                } end function value_at
            } end class Normal

            template <typename T>
            requires Real<T>
            class StudentT as "walnut_rt::stats::StudentT" {
            public:
                constructor(const T&: degrees_of_freedom) as "walnut_rt::stats::make_student_t<T>";
                function mean() const -> T as "walnut_rt::stats::dist_mean";
                function variance() const -> T as "walnut_rt::stats::dist_variance";
                function standard_deviation() const -> T as "walnut_rt::stats::dist_sd";
                function median() const -> T as "walnut_rt::stats::dist_median";
                function quantile(const T&: p) const -> T as "walnut_rt::stats::dist_quantile";
                function upper_quantile(const T&: p) const -> T as "walnut_rt::stats::dist_upper_quantile";
                function is_valid() const -> bool as "walnut_rt::stats::dist_valid";
                function pdf(const T&: x) const -> T as "walnut_rt::stats::dist_pdf";
                function log_pdf(const T&: x) const -> T as "walnut_rt::stats::dist_log_pdf";
                function cdf(const T&: x) const -> T as "walnut_rt::stats::dist_cdf";
                function survival(const T&: x) const -> T as "walnut_rt::stats::dist_survival";
                function between(const T&: low, const T&: high) const -> T as "walnut_rt::stats::dist_between";
                function outside(const T&: low, const T&: high) const -> T as "walnut_rt::stats::dist_outside";

                function below(const T&: x) const -> T {
                    return cdf(x);
                } end function below

                function above(const T&: x) const -> T {
                    return survival(x);
                } end function above

                function inverse_cdf(const T&: p) const -> T {
                    return quantile(p);
                } end function inverse_cdf
            } end class StudentT

