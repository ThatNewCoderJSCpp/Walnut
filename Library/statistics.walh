        function differences_of(const std::collections::Vector<T>&: before, const std::collections::Vector<T>&: after) -> Sample<T> {
            detail::require_same_size(before, after, "differences_of()");
            return Sample<T>::differences(before, after);
        } end function differences_of

        template <typename T>
        requires Real<T>
        function one_mean_t_test(const Sample<T>&: sample, const T&: null_mean, Tail: tail = Tail::two) -> TestResult<T> {
            return detail::test(Native<T>::one_mean_t_test(sample, null_mean, static_cast<int>(tail)));
        } end function one_mean_t_test

        template <typename T>
        requires Real<T>
        function one_mean_t_test(const std::collections::Vector<T>&: data, const T&: null_mean, Tail: tail = Tail::two) -> TestResult<T> {
            return one_mean_t_test(sample_of(data), null_mean, tail);
        } end function one_mean_t_test

        template <typename T>
        requires Real<T>
        function one_mean_z_test(const Sample<T>&: sample, const T&: sigma, const T&: null_mean, Tail: tail = Tail::two) -> TestResult<T> {
            return detail::test(Native<T>::one_mean_z_test(sample, sigma, null_mean, static_cast<int>(tail)));
        } end function one_mean_z_test

        template <typename T>
        requires Real<T>
        function one_mean_z_test(const std::collections::Vector<T>&: data, const T&: sigma, const T&: null_mean, Tail: tail = Tail::two) -> TestResult<T> {
            return one_mean_z_test(sample_of(data), sigma, null_mean, tail);
        } end function one_mean_z_test

        template <typename T>
        requires Real<T>
        function two_mean_t_test(const Sample<T>&: a, const Sample<T>&: b, const T&: null_difference = static_cast<T>(0), Tail: tail = Tail::two, Variances: variances = Variances::unequal) -> TestResult<T> {
            return detail::test(Native<T>::two_mean_t_test(a, b, null_difference, static_cast<int>(tail), static_cast<int>(variances)));
        } end function two_mean_t_test

        template <typename T>
        requires Real<T>
        function two_mean_t_test(const std::collections::Vector<T>&: a, const std::collections::Vector<T>&: b, const T&: null_difference = static_cast<T>(0), Tail: tail = Tail::two, Variances: variances = Variances::unequal) -> TestResult<T> {
            return two_mean_t_test(sample_of(a), sample_of(b), null_difference, tail, variances);
        } end function two_mean_t_test

        template <typename T>
        requires Real<T>
        function two_mean_z_test(const Sample<T>&: a, const T&: sigma_a, const Sample<T>&: b, const T&: sigma_b, const T&: null_difference = static_cast<T>(0), Tail: tail = Tail::two) -> TestResult<T> {
            return detail::test(Native<T>::two_mean_z_test(a, sigma_a, b, sigma_b, null_difference, static_cast<int>(tail)));
        } end function two_mean_z_test

