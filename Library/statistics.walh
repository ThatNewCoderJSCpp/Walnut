        requires Real<T>
        function z_scores(const std::collections::Vector<T>&: data, bool: sample = true) -> std::collections::Vector<T> {
            detail::require_data(data, 2, "z_scores()");
            return Native<T>::z_scores(data, sample);
        } end function z_scores

        template <typename T>
        requires Real<T>
        function weighted_mean(const std::collections::Vector<T>&: data, const std::collections::Vector<T>&: weights) -> T {
            detail::require_same_size(data, weights, "weighted_mean()");
            detail::require_data(data, 1, "weighted_mean()");
            return Native<T>::weighted_mean(data, weights);
        } end function weighted_mean

        template <typename T>
        requires Real<T>
        function linear_regression(const std::collections::Vector<T>&: x, const std::collections::Vector<T>&: y) -> LinearRegression<T> {
            detail::require_same_size(x, y, "linear_regression()");
            detail::require_data(x, 2, "linear_regression()");
            const std::collections::Vector<T>: v = Native<T>::regression(x, y);
            LinearRegression<T>: out;
            out.slope = v[0];
            out.intercept = v[1];
            out.r = v[2];
            out.r_squared = v[3];
            out.residual_standard_error = v[4];
            out.slope_standard_error = v[5];
            out.intercept_standard_error = v[6];
            out.size = x.size();
            return out;
        } end function linear_regression

