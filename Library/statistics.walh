        template <typename T>
        requires Real<T>
        function sample_size_for_mean(const T&: margin, const T&: sigma, const T&: confidence) -> long int {
            return Native<T>::size_for_mean(margin, sigma, confidence);
        } end function sample_size_for_mean

        template <typename T>
        requires Real<T>
        function sample_size_for_proportion(const T&: margin, const T&: confidence, const T&: p_guess = static_cast<T>(0.5)) -> long int {
            return Native<T>::size_for_proportion(margin, confidence, p_guess);
        } end function sample_size_for_proportion

        template <typename T>
        requires Real<T>
        function probability_of_all(const std::collections::Vector<T>&: probabilities) -> T {
            T: total = static_cast<T>(1);
            for (const T&: p in probabilities) {
                total *= p;
            }
            return total;
        } end function probability_of_all

        template <typename T>
        requires Real<T>
        function probability_of_any(const std::collections::Vector<T>&: probabilities) -> T {
            T: none = static_cast<T>(1);
            for (const T&: p in probabilities) {
                none *= static_cast<T>(1) - p;
            }
            return static_cast<T>(1) - none;
        } end function probability_of_any

        template <typename T>
        requires Real<T>
        function probability_of_union(const T&: a, const T&: b, const T&: both) -> T {
            return a + b - both;
        } end function probability_of_union

        template <typename T>
        requires Real<T>
        function conditional_probability(const T&: both, const T&: given) -> T {
            return both / given;
        } end function conditional_probability

        template <typename T>
        requires Real<T>
        function bayes(const T&: likelihood, const T&: prior, const T&: evidence) -> T {
            return likelihood * prior / evidence;
        } end function bayes

        template <typename T>
        requires Real<T>
        function complement(const T&: p) -> T {
            return static_cast<T>(1) - p;
        } end function complement
    } end namespace statistics
} end namespace std
