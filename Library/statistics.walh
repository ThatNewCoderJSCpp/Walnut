        requires Real<T>
        function two_mean_z_test(const std::collections::Vector<T>&: a, const T&: sigma_a, const std::collections::Vector<T>&: b, const T&: sigma_b, const T&: null_difference = static_cast<T>(0), Tail: tail = Tail::two) -> TestResult<T> {
