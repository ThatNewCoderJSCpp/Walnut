        function variance(const std::collections::Vector<T>&: data) -> T {
            detail::require_data(data, 2, "variance()");
            return Native<T>::variance(data);
        } end function variance

        template <typename T>
        requires Real<T>
        function sample_variance(const std::collections::Vector<T>&: data) -> T {
            detail::require_data(data, 2, "sample_variance()");
            return Native<T>::variance(data);
        } end function sample_variance

        template <typename T>
        requires Real<T>
        function population_variance(const std::collections::Vector<T>&: data) -> T {
            detail::require_data(data, 1, "population_variance()");
            return Native<T>::population_variance(data);
        } end function population_variance

        template <typename T>
        requires Real<T>
        function standard_deviation(const std::collections::Vector<T>&: data) -> T {
            detail::require_data(data, 2, "standard_deviation()");
