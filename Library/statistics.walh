            class Binomial as "walnut_rt::stats::Binomial" {
            public:
                constructor(long int: trials, const T&: probability) as "walnut_rt::stats::make_binomial<T>";
                function mean() const -> T as "walnut_rt::stats::dist_mean";
                function variance() const -> T as "walnut_rt::stats::dist_variance";
                function standard_deviation() const -> T as "walnut_rt::stats::dist_sd";
                function median() const -> T as "walnut_rt::stats::dist_median";
                function quantile(const T&: p) const -> T as "walnut_rt::stats::dist_quantile";
                function upper_quantile(const T&: p) const -> T as "walnut_rt::stats::dist_upper_quantile";
                function is_valid() const -> bool as "walnut_rt::stats::dist_valid";
                function pmf(long int: k) const -> T as "walnut_rt::stats::dist_pmf";
                function log_pmf(long int: k) const -> T as "walnut_rt::stats::dist_log_pmf";
                function cdf(long int: k) const -> T as "walnut_rt::stats::dist_cdf_k";
                function survival(long int: k) const -> T as "walnut_rt::stats::dist_survival_k";
                function between(long int: low, long int: high) const -> T as "walnut_rt::stats::dist_between_k";
                function outside(long int: low, long int: high) const -> T as "walnut_rt::stats::dist_outside_k";

                function exactly(long int: k) const -> T {
                    return pmf(k);
                } end function exactly

                function at_most(long int: k) const -> T {
                    return cdf(k);
                } end function at_most

                function less_than(long int: k) const -> T {
                    return cdf(k - 1);
                } end function less_than

                function at_least(long int: k) const -> T {
                    return survival(k - 1);
                } end function at_least

                function greater_than(long int: k) const -> T {
                    return survival(k);
                } end function greater_than
            } end class Binomial

