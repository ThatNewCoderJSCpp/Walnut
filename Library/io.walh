            function open(const string&: path, int: mode = 4) -> void {
                if (m_fb.open(path, mode | ios_base::input) == nullptr) then {
                    setstate(ios_base::failbit);
                } else then {
                    clear();
                }
            } end function open

            function is_open() const -> bool {
                return m_fb.is_open();
            } end function is_open

            function close() -> void {
                if (m_fb.close() == nullptr) then {
                    setstate(ios_base::failbit);
                }
            } end function close
        } end class ifstream

