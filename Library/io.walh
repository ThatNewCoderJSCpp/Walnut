        class ospanstream inherits ostream {
            spanbuf: m_sb;

        public:
            constructor(char*: data, long int: size) : ostream(nullptr), m_sb(data, size, ios_base::output) {
                rdbuf(&m_sb);
            }

            function span_data() const -> char* {
                return m_sb.span_data();
            } end function span_data

            function span_size() const -> long int {
                return m_sb.span_size();
            } end function span_size
        } end class ospanstream

        class ispanstream inherits istream {
            spanbuf: m_sb;

        public:
            constructor(char*: data, long int: size) : istream(nullptr), m_sb(data, size, ios_base::input) {
                rdbuf(&m_sb);
            }

            function span_data() const -> char* {
                return m_sb.span_data();
            } end function span_data

            function span_size() const -> long int {
                return m_sb.span_size();
            } end function span_size
        } end class ispanstream

        class spanstream inherits iostream {
            spanbuf: m_sb;

        public:
            constructor(char*: data, long int: size) : iostream(nullptr), m_sb(data, size, 12) {
                rdbuf(&m_sb);
            }

            function span_data() const -> char* {
                return m_sb.span_data();
            } end function span_data

            function span_size() const -> long int {
                return m_sb.span_size();
            } end function span_size
        } end class spanstream

        class osyncstream inherits ostream {
            syncbuf: m_sb;

        public:
            constructor(ostream&: target) : ostream(nullptr), m_sb(target.rdbuf()) {
                rdbuf(&m_sb);
            }

            constructor(streambuf*: target) : ostream(nullptr), m_sb(target) {
                rdbuf(&m_sb);
            }

            function emit() -> void {
                if (!m_sb.emit()) then {
                    setstate(ios_base::badbit);
                }
            } end function emit

            function get_wrapped() const -> streambuf* {
                return m_sb.get_wrapped();
            } end function get_wrapped
        } end class osyncstream

        function getline(istream&: input, string&: s, char: delim = '\n') -> istream& {
            return input.getline(s, delim);
        } end function getline

        function getline(istream&: input, text&: t, char: delim = '\n') -> istream& {
            return input.getline(t, delim);
        } end function getline

        filebuf: stdin_buf = filebuf(0);
        filebuf: stdout_buf = filebuf(1);
        filebuf: stderr_buf = filebuf(2);

        ostream: cout = ostream(&stdout_buf, nullptr, walnut_rt::io_native::start_unbuffered() ? ios_base::unitbuf : 0);
        istream: cin = istream(&stdin_buf, &cout);
        ostream: cerr = ostream(&stderr_buf, &cout, ios_base::unitbuf);
        ostream: clog = ostream(&stderr_buf, &cout, walnut_rt::io_native::start_unbuffered() ? ios_base::unitbuf : 0);

        namespace detail {
            struct format_spec {
                bool: left = false;
                bool: plus = false;
                bool: space = false;
                bool: alt = false;
                bool: zero = false;
                long int: width = -1;
                long int: precision = -1;
                char: conv = 's';
            } end struct format_spec

            function digit_of(char: c) -> long int {
                return static_cast<long int>(c) - static_cast<long int>('0');
            } end function digit_of

            function is_digit(char: c) -> bool {
                return c >= '0' && c <= '9';
            } end function is_digit

            function next_spec(string&: out, string&: rest, format_spec&: sp) -> bool {
                sp = format_spec{};
                long int: used = 0;
                int: state = 0;
                bool: found = false;

                for (char: c in rest) {
                    used += 1;

                    if (state == 0) then {
                        if (c == '%') then {
                            state = 1;
                        } else then {
                            out += c;
                        }
                        continue;
                    }

                    if (state == 1) then {
                        if (c == '%') then {
                            out += '%';
                            state = 0;
                            continue;
                        }
                        state = 2;
                    }

                    if (state == 2) then {
                        if (c == '-') then {
                            sp.left = true;
                            continue;
                        }
                        if (c == '+') then {
                            sp.plus = true;
                            continue;
                        }
                        if (c == ' ') then {
                            sp.space = true;
                            continue;
                        }
                        if (c == '#') then {
                            sp.alt = true;
                            continue;
                        }
                        if (c == '0') then {
                            sp.zero = true;
                            continue;
                        }
                        state = 3;
                    }

                    if (state == 3) then {
                        if (is_digit(c)) then {
                            sp.width = (sp.width < 0 ? 0 : sp.width) * 10 + digit_of(c);
                            continue;
                        }
                        if (c == '.') then {
                            sp.precision = 0;
                            state = 4;
                            continue;
                        }
                        state = 5;
                    }

                    if (state == 4) then {
                        if (is_digit(c)) then {
                            sp.precision = sp.precision * 10 + digit_of(c);
                            continue;
                        }
                        state = 5;
                    }

                    if (c == 'h' || c == 'l' || c == 'L' || c == 'z' || c == 'j' || c == 't' || c == 'q') then {
                        continue;
                    }

                    sp.conv = c;
                    found = true;
                    break;
                }

                if (state != 0 && !found) then {
                    throw std::errors::format_error("the format ends in the middle of a '%' placeholder");
                }

                rest = found ? rest.substr(used) : "";
                return found;
            } end function next_spec

            function spaces(long int: n, char: c) -> string {
                string: s = "";
                for (long int: i = 0; i < n; i++) {
                    s += c;
                }
                return s;
            } end function spaces

            function mismatch(const format_spec&: sp, long int: index, const string&: wanted, const string&: given) -> std::errors::format_error {
                return std::errors::format_error(static_cast<string>(`argument ${index} is ${given}, but %${sp.conv} needs ${wanted}`));
            } end function mismatch

            function pad(string&: body, const format_spec&: sp, bool: numeric) -> void {
                if (numeric && sp.space && !body.starts_with('-') && !body.starts_with('+')) then {
                    body = " " + body;
                }

                const long int: len = body.length();
                if (sp.width <= len) then {
                    return;
                }

                const long int: gap = sp.width - len;
                if (sp.left) then {
                    body = body + spaces(gap, ' ');
                    return;
                }

                const bool: special_word = body.contains("inf") || body.contains("nan") || body.contains("undefined") || body.contains("indeterminate");
                if (numeric && sp.zero && !special_word) then {
                    long int: prefix = 0;
                    if (body.starts_with('-') || body.starts_with('+') || body.starts_with(' ')) then {
                        prefix = 1;
                    }
                    const string: after = body.substr(prefix);
                    if (after.starts_with("0x") || after.starts_with("0X") || after.starts_with("0b") || after.starts_with("0B")) then {
                        prefix += 2;
                    }
                    body = body.substr(0, prefix) + spaces(gap, '0') + body.substr(prefix);
                    return;
                }

                body = spaces(gap, ' ') + body;
            } end function pad

            template <typename T>
            function put_one(string&: out, const format_spec&: sp, long int: index, const T&: v) -> void {
                ostringstream: s;
                bool: numeric = true;
                const char: conv = sp.conv;
                if (sp.plus) then {
                    s.setf(ios_base::showpos);
                }

                if (conv == 'd' || conv == 'i' || conv == 'u') then {
                    if constexpr (std::traits::is_char<T>) then {
                        s << static_cast<long int>(v);
                    } else if constexpr (std::traits::is_builtin_integer<T>) then {
                        s << v;
                    } else then {
                        throw mismatch(sp, index, "an integer", typeid(T));
                    }
                } else if (conv == 'x' || conv == 'X' || conv == 'o' || conv == 'b' || conv == 'B') then {
                    if constexpr (std::traits::is_builtin_integer<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>) then {
                        if (conv == 'o') then {
                            s.setf(ios_base::oct, ios_base::basefield);
                        } else if (conv == 'b' || conv == 'B') then {
                            s.setf(ios_base::bin, ios_base::basefield);
                        } else then {
                            s.setf(ios_base::hex, ios_base::basefield);
                        }
                        if (sp.alt) then {
                            s.setf(ios_base::showbase);
                        }
                        if (conv == 'X' || conv == 'B') then {
                            s.setf(ios_base::uppercase);
                        }
                        s << v;
                    } else then {
                        throw mismatch(sp, index, "an integer", typeid(T));
                    }
                } else if (conv == 'f' || conv == 'F' || conv == 'e' || conv == 'E' || conv == 'g' || conv == 'G') then {
                    if constexpr (std::traits::is_builtin_float<T>) then {
                        s.precision(sp.precision < 0 ? 6 : sp.precision);
                        if (conv == 'f' || conv == 'F') then {
                            s.setf(ios_base::fixed, ios_base::floatfield);
                        } else if (conv == 'e' || conv == 'E') then {
                            s.setf(ios_base::scientific, ios_base::floatfield);
                        }
                        if (sp.alt) then {
                            s.setf(ios_base::showpoint);
                        }
                        if (conv == 'F' || conv == 'E' || conv == 'G') then {
                            s.setf(ios_base::uppercase);
                        }
                        s << v;
                    } else then {
                        throw mismatch(sp, index, "a float", typeid(T));
                    }
                } else if (conv == 'c') then {
                    numeric = false;
                    if constexpr (std::traits::is_char<T>) then {
                        s << v;
                    } else then {
                        throw mismatch(sp, index, "a char", typeid(T));
                    }
                } else if (conv == 's' || conv == 'v') then {
                    numeric = false;
                    if constexpr (std::traits::is_bool<T>) then {
                        s.setf(ios_base::boolalpha);
                    }
                    s << v;
                } else then {
                    throw std::errors::format_error(static_cast<string>(`%${conv} isn't a placeholder; use %d, %i, %u, %x, %X, %o, %b, %f, %e, %g, %c, %s or %%`));
                }

                string: body = s.contents();
                if (!numeric && sp.precision >= 0 && body.length() > sp.precision) then {
                    body = body.substr(0, sp.precision);
                }
                pad(body, sp, numeric);
                out += body;
            } end function put_one

            template <typename T, typename... Ts>
            function format_into(string&: out, string&: rest, long int: index, const T&: first, const Ts&...: others) -> void {
                format_spec: sp;
                if (!next_spec(out, rest, sp)) then {
                    throw std::errors::format_error(static_cast<string>(`there are more arguments than placeholders; the format has ${index - 1}`));
                }
                put_one(out, sp, index, first);
                if constexpr (countof(others) > 0) then {
                    format_into(out, rest, index + 1, others...);
                }
            } end function format_into

            function format_finish(string&: out, string&: rest, long int: given) -> void {
                format_spec: sp;
                if (next_spec(out, rest, sp)) then {
                    throw std::errors::format_error(static_cast<string>(`the format has more placeholders than arguments; ${given} given`));
                }
            } end function format_finish

            function lowered(const string&: s) -> string {
                return s.to_lower();
            } end function lowered
        } end namespace detail

        template <typename... Ts>
        function sprintf(const string&: fmt, const Ts&...: args) -> string {
            string: out = "";
            string: rest = fmt;
            if constexpr (countof(args) > 0) then {
                detail::format_into(out, rest, 1, args...);
            }
            detail::format_finish(out, rest, countof(args));
            return out;
        } end function sprintf

        template <typename... Ts>
        function sprintf(const text&: fmt, const Ts&...: args) -> text {
            return static_cast<text>(sprintf(static_cast<string>(fmt), args...));
        } end function sprintf

        template <typename... Ts>
        function printf(const string&: fmt, const Ts&...: args) -> void {
            cout.write(sprintf(fmt, args...));
        } end function printf

        template <typename... Ts>
        function printf(const text&: fmt, const Ts&...: args) -> void {
            cout.write(sprintf(static_cast<string>(fmt), args...));
        } end function printf

        template <typename... Ts>
        function printf(ostream&: out, const string&: fmt, const Ts&...: args) -> void {
            out.write(sprintf(fmt, args...));
        } end function printf

        template <typename... Ts>
        function printf(ostream&: out, const text&: fmt, const Ts&...: args) -> void {
            out.write(sprintf(static_cast<string>(fmt), args...));
        } end function printf

        namespace detail {
            template <typename T>
            function wants_flush(const T&: value) -> bool {
                return false;
            } end function wants_flush

            function wants_flush(const manipulator&: m) -> bool {
                return m.kind == 3;
            } end function wants_flush

            template <typename... Ts>
            function any_flush(const Ts&...: values) -> bool {
                if constexpr (countof(values) > 0) then {
                    return (wants_flush(values) || ...);
                } else then {
                    return false;
                }
            } end function any_flush
        } end namespace detail

        function print() -> void {
            return;
        } end function print

        template <typename T, typename... Ts>
        function print(const T&: first, const Ts&...: rest) -> void {
            if constexpr (std::traits::is_same<T, ostream> || std::traits::is_base_of<ostream, T>) then {
                ostream&: out = const_cast<T&>(first);
                if constexpr (countof(rest) > 0) then {
                    (out << ... << rest);
                }
            } else then {
                cout << first;
                if constexpr (countof(rest) > 0) then {
                    (cout << ... << rest);
                }
            }
        } end function print

        function println() -> void {
            cout << '\n';
        } end function println

        template <typename T, typename... Ts>
        function println(const T&: first, const Ts&...: rest) -> void {
            if constexpr (std::traits::is_same<T, ostream> || std::traits::is_base_of<ostream, T>) then {
                ostream&: out = const_cast<T&>(first);
                if constexpr (countof(rest) > 0) then {
                    (out << ... << rest);
                }
                out << '\n';
                if (detail::any_flush(rest...)) then {
                    out.flush();
                }
            } else then {
                cout << first;
                if constexpr (countof(rest) > 0) then {
                    (cout << ... << rest);
                }
                cout << '\n';
                if (detail::wants_flush(first) || detail::any_flush(rest...)) then {
                    cout.flush();
                }
            }
        } end function println

        function set_unbuffered(bool: on = true) -> void {
            if (on) then {
                cout.setf(ios_base::unitbuf);
                clog.setf(ios_base::unitbuf);
                cout.flush();
                clog.flush();
            } else then {
                cout.unsetf(ios_base::unitbuf);
                clog.unsetf(ios_base::unitbuf);
            }
        } end function set_unbuffered

        function is_unbuffered() -> bool {
            return (cout.flags() & ios_base::unitbuf) != 0;
        } end function is_unbuffered

        template <typename T = int>
        requires std::traits::is_builtin_integer<T> && std::traits::is_signed<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>
        function parse_int(const string&: s, int: base = 10) -> T {
            const string: token = walnut_rt::io_native::trim_spaces(s);
            if (!walnut_rt::io_native::parse_int_ok(token, base)) then {
                return undefined;
            }
            const long long integer: wide = walnut_rt::io_native::parse_int(token, base);
            if (wide is inf || wide is nan || wide is undefined || wide is indeterminate) then {
                return static_cast<T>(wide);
            }
            const T: narrow = static_cast<T>(wide);
            const long long integer: back = narrow;
            if (back != wide) then {
                if (wide > 0) then {
                    return inf;
                }
                return -inf;
            }
            return narrow;
        } end function parse_int

        template <typename T = int>
        requires std::traits::is_builtin_integer<T> && std::traits::is_signed<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>
        function parse_int(const text&: s, int: base = 10) -> T {
            return parse_int<T>(static_cast<string>(s), base);
        } end function parse_int

        template <typename T = unsigned int>
        requires std::traits::is_builtin_integer<T> && std::traits::is_unsigned<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>
        function parse_uint(const string&: s, int: base = 10) -> T {
            const string: token = walnut_rt::io_native::trim_spaces(s);
            if (!walnut_rt::io_native::parse_uint_ok(token, base)) then {
                return undefined;
            }
            const unsigned long long integer: wide = walnut_rt::io_native::parse_uint(token, base);
            if (wide is inf || wide is nan || wide is undefined || wide is indeterminate) then {
                return static_cast<T>(wide);
            }
            const T: narrow = static_cast<T>(wide);
            const unsigned long long integer: back = narrow;
            if (back != wide) then {
                return inf;
            }
            return narrow;
        } end function parse_uint

        template <typename T = unsigned int>
        requires std::traits::is_builtin_integer<T> && std::traits::is_unsigned<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>
        function parse_uint(const text&: s, int: base = 10) -> T {
            return parse_uint<T>(static_cast<string>(s), base);
        } end function parse_uint

        template <typename T = float>
        requires std::traits::is_builtin_float<T>
        function parse_float(const string&: s) -> T {
            const string: token = walnut_rt::io_native::trim_spaces(s);
            if (!walnut_rt::io_native::parse_float_ok(token)) then {
                return undefined;
            }
            return static_cast<T>(walnut_rt::io_native::parse_float(token));
        } end function parse_float

        template <typename T = float>
        requires std::traits::is_builtin_float<T>
        function parse_float(const text&: s) -> T {
            return parse_float<T>(static_cast<string>(s));
        } end function parse_float

        function parse_bool(const string&: s) -> special(bool) {
            const string: token = detail::lowered(walnut_rt::io_native::trim_spaces(s));
            if (token == "true" || token == "1") then {
                return true;
            }
            if (token == "false" || token == "0") then {
                return false;
            }
            return undefined;
        } end function parse_bool

        function parse_bool(const text&: s) -> special(bool) {
            return parse_bool(static_cast<string>(s));
        } end function parse_bool

        function parse_char(const string&: s) -> special(char) {
            string: body = s;
            if (s.length() >= 3 && s.starts_with('\'') && s.ends_with('\'')) then {
                if (!walnut_rt::io_native::unescape_ok(s)) then {
                    return undefined;
                }
                body = walnut_rt::io_native::unescape(s);
            }
            if (body.length() != 1) then {
                return undefined;
            }
            return body[0];
        } end function parse_char

        function parse_char(const text&: s) -> special(char) {
            return parse_char(static_cast<string>(s));
        } end function parse_char

        function parse_string(const string&: s) -> special(string) {
            const string: token = walnut_rt::io_native::trim_spaces(s);
            const bool: quoted = token.length() >= 2 && (token.starts_with('"') || token.starts_with('`') || token.starts_with('\'')) && token.ends_with(token[0]);
            if (!quoted) then {
                return s;
            }
            if (!walnut_rt::io_native::unescape_ok(token)) then {
                return undefined;
            }
            return walnut_rt::io_native::unescape(token);
        } end function parse_string

        function parse_string(const text&: s) -> special(string) {
            return parse_string(static_cast<string>(s));
        } end function parse_string

        namespace detail {
            function input_line(istream&: input, const string&: prompt, const string&: what) -> string {
                if (!prompt.empty()) then {
                    cout << prompt;
                    cout.flush();
                }
                string: line;
                if (!getline(input, line)) then {
                    throw std::errors::input_error(what + ": the input ended before a value was entered");
                }
                if (line.ends_with('\r')) then {
                    line = line.substr(0, line.length() - 1);
                }
                return line;
            } end function input_line

            function input_retry(const string&: message) -> void {
                cout << message << '\n';
            } end function input_retry

            function blank(const string&: line) -> bool {
                return walnut_rt::io_native::trim_spaces(line).empty();
            } end function blank
        } end namespace detail

        template <typename T = int>
        requires std::traits::is_builtin_integer<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>
        function input_integer(istream&: input, const string&: prompt = "") -> T {
            while (true) {
                const string: line = detail::input_line(input, prompt, "input_integer");
                if (detail::blank(line)) then {
                    continue;
                }
                T: value = 0;
                if constexpr (std::traits::is_signed<T>) then {
                    value = parse_int<T>(line);
                } else then {
                    value = parse_uint<T>(line);
                }
                if (value is undefined && !std::traits::is_signed<T> && parse_int<long long integer>(line) < 0) then {
                    detail::input_retry("That number can't be negative. Please try again.");
                } else if (value is undefined) then {
                    detail::input_retry("That isn't a whole number. Please try again.");
                } else if (value is inf || value is nan || value is indeterminate) then {
                    detail::input_retry("That number is too large or too small. Please try again.");
                } else then {
                    return value;
                }
            }
        } end function input_integer

        template <typename T = int>
        requires std::traits::is_builtin_integer<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>
        function input_integer(const string&: prompt = "") -> T {
            return input_integer<T>(cin, prompt);
        } end function input_integer

        template <typename T = float>
        requires std::traits::is_builtin_float<T>
        function input_float(istream&: input, const string&: prompt = "") -> T {
            while (true) {
                const string: line = detail::input_line(input, prompt, "input_float");
                if (detail::blank(line)) then {
                    continue;
                }
                const T: value = parse_float<T>(line);
                if (value is undefined) then {
                    detail::input_retry("That isn't a number. Please try again.");
                } else if (value is inf || value is nan || value is indeterminate) then {
                    detail::input_retry("Please enter a finite number.");
                } else then {
                    return value;
                }
            }
        } end function input_float

        template <typename T = float>
        requires std::traits::is_builtin_float<T>
        function input_float(const string&: prompt = "") -> T {
            return input_float<T>(cin, prompt);
        } end function input_float

        function input_string(istream&: input, const string&: prompt = "") -> string {
            return detail::input_line(input, prompt, "input_string");
        } end function input_string

        function input_string(const string&: prompt = "") -> string {
            return input_string(cin, prompt);
        } end function input_string

        function input_text(istream&: input, const string&: prompt = "") -> text {
            return static_cast<text>(detail::input_line(input, prompt, "input_text"));
        } end function input_text

        function input_text(const string&: prompt = "") -> text {
            return input_text(cin, prompt);
        } end function input_text

        function input_bool(istream&: input, const string&: prompt = "") -> bool {
            while (true) {
                const string: line = detail::input_line(input, prompt, "input_bool");
                if (detail::blank(line)) then {
                    continue;
                }
                const string: word = detail::lowered(walnut_rt::io_native::trim_spaces(line));
                if (word == "true" || word == "1" || word == "yes" || word == "y") then {
                    return true;
                }
                if (word == "false" || word == "0" || word == "no" || word == "n") then {
                    return false;
                }
                detail::input_retry("Please answer yes or no.");
            }
        } end function input_bool

        function input_bool(const string&: prompt = "") -> bool {
            return input_bool(cin, prompt);
        } end function input_bool

        function input_char(istream&: input, const string&: prompt = "") -> char {
            while (true) {
                const string: line = detail::input_line(input, prompt, "input_char");
                const string: token = walnut_rt::io_native::trim_spaces(line);
                if (token.empty()) then {
                    continue;
                }
                if (token.length() == 1) then {
                    return token[0];
                }
                detail::input_retry("Please enter a single character.");
            }
        } end function input_char

        function input_char(const string&: prompt = "") -> char {
            return input_char(cin, prompt);
        } end function input_char

        function parse_text(const string&: s) -> special(text) {
            special(string): r = parse_string(s);
            if (r is undefined) then {
                return undefined;
            }
            return static_cast<text>(r as string);
        } end function parse_text

        function parse_text(const text&: s) -> special(text) {
            return parse_text(static_cast<string>(s));
        } end function parse_text
    } end namespace io
} end namespace std
