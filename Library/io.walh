hidden namespace walnut_rt {
    namespace io_native {
        extern "C++" {
            function file_open(const string&: path, long int: mode) noexcept -> long int;
            function string_open(const string&: initial, long int: mode) noexcept -> long int;
            function string_get(long int: id) noexcept -> string;
            function string_set(long int: id, const string&: value, long int: mode) noexcept -> void;
            function device_close(long int: id) noexcept -> bool;
            function device_write(long int: id, const string&: bytes) noexcept -> bool;
            function device_flush(long int: id) noexcept -> bool;
            function device_peek_ok(long int: id) noexcept -> bool;
            function device_peek(long int: id) noexcept -> char;
            function device_bump(long int: id) noexcept -> void;
            function device_unget(long int: id) noexcept -> bool;
            function device_seek(long int: id, long int: offset, long int: dir, long int: which) noexcept -> long int;
            function device_available(long int: id) noexcept -> long int;
            function sync_acquire() noexcept -> void;
            function sync_release() noexcept -> void;
            function format_int(long long integer: value, long int: base, bool: upper, bool: showbase, bool: showpos) noexcept -> string;
            function format_uint(unsigned long long integer: value, long int: base, bool: upper, bool: showbase, bool: showpos) noexcept -> string;
            function format_float(long long double: value, long int: bits, long int: precision, long int: style, bool: upper, bool: showpos, bool: showpoint) noexcept -> string;
            function parse_int_ok(const string&: token, long int: base) noexcept -> bool;
            function parse_int(const string&: token, long int: base) noexcept -> long long integer;
            function parse_uint_ok(const string&: token, long int: base) noexcept -> bool;
            function parse_uint(const string&: token, long int: base) noexcept -> unsigned long long integer;
            function parse_float_ok(const string&: token) noexcept -> bool;
            function parse_float(const string&: token) noexcept -> long long double;
            function unescape_ok(const string&: s) noexcept -> bool;
            function unescape(const string&: s) noexcept -> string;
            function trim_spaces(const string&: s) noexcept -> string;
            function start_unbuffered() noexcept -> bool;
        } end extern
    } end namespace io_native
} end namespace walnut_rt

namespace std {
    namespace errors {
        class format_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what() const -> string {
                return message;
            } end function what
        } end class format_error

        class input_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what() const -> string {
                return message;
            } end function what
        } end class input_error
    } end namespace errors

    namespace io {
        class streambuf;
        class ostream;

        struct ios_state {
            int: flags = 4098;
            int: state = 0;
            long int: width = 0;
            long int: precision = 6;
            bool: precision_set = false;
            char: fill = ' ';
            streambuf*: buf = nullptr;
            ostream*: tied = nullptr;
        } end struct ios_state

        class ios_base {
        protected:
            ios_state: m_own;
            ios_state*: m_s;

        public:
            static constexpr int: boolalpha  = 1;
            static constexpr int: base10     = 2;
            static constexpr int: fixed      = 4;
            static constexpr int: hex        = 8;
            static constexpr int: internal   = 16;
            static constexpr int: left       = 32;
            static constexpr int: oct        = 64;
            static constexpr int: right      = 128;
            static constexpr int: scientific = 256;
            static constexpr int: showbase   = 512;
            static constexpr int: showpoint  = 1024;
            static constexpr int: showpos    = 2048;
            static constexpr int: skipws     = 4096;
            static constexpr int: unitbuf    = 8192;
            static constexpr int: uppercase  = 16384;
            static constexpr int: bin        = 32768;
            static constexpr int: basefield   = 32842;
            static constexpr int: adjustfield = 176;
            static constexpr int: floatfield  = 260;

            static constexpr int: goodbit = 0;
            static constexpr int: badbit  = 1;
            static constexpr int: eofbit  = 2;
            static constexpr int: failbit = 4;

            static constexpr int: app       = 1;
            static constexpr int: binary    = 2;
            static constexpr int: input     = 4;
            static constexpr int: output    = 8;
            static constexpr int: trunc     = 16;
            static constexpr int: ate       = 32;
            static constexpr int: noreplace = 64;

            static constexpr int: seek_beg = 0;
            static constexpr int: seek_cur = 1;
            static constexpr int: seek_end = 2;

            constructor() : m_s = nullptr {
                m_s = &m_own;
            }

            constructor(const ios_base&: other) = delete;

            function flags() const -> int {
                return m_s->flags;
            } end function flags

            function flags(int: f) -> int {
                int: old = m_s->flags;
                m_s->flags = f;
                return old;
            } end function flags

            function setf(int: f) -> int {
                int: old = m_s->flags;
                m_s->flags = old | f;
                return old;
            } end function setf

            function setf(int: f, int: mask) -> int {
                int: old = m_s->flags;
                m_s->flags = (old & ~mask) | (f & mask);
                return old;
            } end function setf

            function unsetf(int: mask) -> void {
                m_s->flags = m_s->flags & ~mask;
            } end function unsetf

            function width() const -> long int {
                return m_s->width;
            } end function width

            function width(long int: w) -> long int {
                long int: old = m_s->width;
                m_s->width = w;
                return old;
            } end function width

            function precision() const -> long int {
                return m_s->precision;
            } end function precision

            function precision(long int: p) -> long int {
                long int: old = m_s->precision;
                m_s->precision = p;
                m_s->precision_set = true;
                return old;
            } end function precision

            function fill() const -> char {
                return m_s->fill;
            } end function fill

            function fill(char: c) -> char {
                char: old = m_s->fill;
                m_s->fill = c;
                return old;
            } end function fill

            function rdstate() const -> int {
                return m_s->state;
            } end function rdstate

            function good() const -> bool {
                return m_s->state == 0;
            } end function good

            function eof() const -> bool {
                return (m_s->state & eofbit) != 0;
            } end function eof

            function fail() const -> bool {
                return (m_s->state & (failbit | badbit)) != 0;
            } end function fail

            function bad() const -> bool {
                return (m_s->state & badbit) != 0;
            } end function bad

            function clear(int: s = 0) -> void {
                m_s->state = s;
            } end function clear

            function setstate(int: s) -> void {
                m_s->state = m_s->state | s;
            } end function setstate

            function share_state_with(ios_base&: other) -> void {
                m_s = other.m_s;
            } end function share_state_with

            operator(bool) function() const {
                return (m_s->state & (failbit | badbit)) == 0;
            }

            operator(!) function() const -> bool {
                return (m_s->state & (failbit | badbit)) != 0;
            }
        } end class ios_base

        class ios inherits ios_base {
        public:
            constructor() { }

            function rdbuf() const -> streambuf* {
                return m_s->buf;
            } end function rdbuf

            function rdbuf(streambuf*: b) -> streambuf* {
                streambuf*: old = m_s->buf;
                m_s->buf = b;
                m_s->state = 0;
                return old;
            } end function rdbuf

            function tie() const -> ostream* {
                return m_s->tied;
            } end function tie

            function tie(ostream*: t) -> ostream* {
                ostream*: old = m_s->tied;
                m_s->tied = t;
                return old;
            } end function tie

            function copyfmt(const ios&: other) -> ios& {
                m_s->flags = other.flags();
                m_s->width = other.width();
                m_s->precision = other.precision();
                m_s->precision_set = other.m_s->precision_set;
                m_s->fill = other.fill();
                return *this;
            } end function copyfmt
        } end class ios

        class streambuf {
        public:
            constructor() { }

            constructor(const streambuf&: other) = delete;

            function sputn(const string&: s) virtual -> long int {
                return 0;
            } end function sputn

            function sputc(char: c) -> bool {
                string: s = "";
                s += c;
                return sputn(s) > 0;
            } end function sputc

            function sgetc(char&: out) virtual -> bool {
                return false;
            } end function sgetc

            function sbumpc(char&: out) virtual -> bool {
                return false;
            } end function sbumpc

            function snextc(char&: out) -> bool {
                char: skipped = ' ';
                if (!sbumpc(skipped)) then {
                    return false;
                }
                return sgetc(out);
            } end function snextc

            function sungetc() virtual -> bool {
                return false;
            } end function sungetc

            function sgetn(long int: count) -> string {
                string: got = "";
                char: c = ' ';
                long int: n = 0;
                while (n < count && sbumpc(c)) {
                    got += c;
                    n++;
                }
                return got;
            } end function sgetn

            function in_avail() virtual -> long int {
                return 0;
            } end function in_avail

            function pubsync() virtual -> int {
                return 0;
            } end function pubsync

            function pubseekoff(long int: offset, int: dir, int: which = 12) virtual -> long int {
                return -1;
            } end function pubseekoff

            function pubseekpos(long int: pos, int: which = 12) -> long int {
                return pubseekoff(pos, 0, which);
            } end function pubseekpos
        } end class streambuf

        class nativebuf inherits streambuf {
        protected:
            long int: m_id = -1;

        public:
            constructor() { }

            function native_handle() const -> long int {
                return m_id;
            } end function native_handle

            function sputn(const string&: s) override -> long int {
                if (m_id < 0 || !walnut_rt::io_native::device_write(m_id, s)) then {
                    return 0;
                }
                return countof(s);
            } end function sputn

            function sgetc(char&: out) override -> bool {
                if (m_id < 0 || !walnut_rt::io_native::device_peek_ok(m_id)) then {
                    return false;
                }
                out = walnut_rt::io_native::device_peek(m_id);
                return true;
            } end function sgetc

            function sbumpc(char&: out) override -> bool {
                if (!sgetc(out)) then {
                    return false;
                }
                walnut_rt::io_native::device_bump(m_id);
                return true;
            } end function sbumpc

            function sungetc() override -> bool {
                return m_id >= 0 && walnut_rt::io_native::device_unget(m_id);
            } end function sungetc

            function in_avail() override -> long int {
                if (m_id < 0) then {
                    return 0;
                }
                return walnut_rt::io_native::device_available(m_id);
            } end function in_avail

            function pubsync() override -> int {
                if (m_id < 0 || !walnut_rt::io_native::device_flush(m_id)) then {
                    return -1;
                }
                return 0;
            } end function pubsync

            function pubseekoff(long int: offset, int: dir, int: which = 12) override -> long int {
                if (m_id < 0) then {
                    return -1;
                }
                return walnut_rt::io_native::device_seek(m_id, offset, dir, which);
            } end function pubseekoff
        } end class nativebuf

        class filebuf inherits nativebuf {
        public:
            constructor() { }

            constructor(long int: standard_handle) explicit {
                if (standard_handle >= 0 && standard_handle <= 2) then {
                    m_id = standard_handle;
                }
            }

            destructor() {
                close();
            }

            function open(const string&: path, int: mode) -> filebuf* {
                if (m_id >= 0) then {
                    return nullptr;
                }
                m_id = walnut_rt::io_native::file_open(path, mode);
                if (m_id < 0) then {
                    return nullptr;
                }
                return this;
            } end function open

            function is_open() const -> bool {
                return m_id >= 0;
            } end function is_open

            function close() -> filebuf* {
                if (m_id < 0) then {
                    return nullptr;
                }
                walnut_rt::io_native::device_close(m_id);
                m_id = -1;
                return this;
            } end function close
        } end class filebuf

        class stringbuf inherits nativebuf {
            int: m_mode;

        public:
            constructor(int: mode = 12) : m_mode = mode {
                m_id = walnut_rt::io_native::string_open("", mode);
            }

            constructor(const string&: s, int: mode = 12) : m_mode = mode {
                m_id = walnut_rt::io_native::string_open(s, mode);
            }

            destructor() {
                walnut_rt::io_native::device_close(m_id);
            }

            function contents() const -> string {
                return walnut_rt::io_native::string_get(m_id);
            } end function contents

            function contents(const string&: s) -> void {
                walnut_rt::io_native::string_set(m_id, s, m_mode);
            } end function contents
        } end class stringbuf

        class textbuf inherits nativebuf {
            int: m_mode;

        public:
            constructor(int: mode = 12) : m_mode = mode {
                m_id = walnut_rt::io_native::string_open("", mode);
            }

            constructor(const text&: s, int: mode = 12) : m_mode = mode {
                m_id = walnut_rt::io_native::string_open(static_cast<string>(s), mode);
            }

            destructor() {
                walnut_rt::io_native::device_close(m_id);
            }

            function contents() const -> text {
                return static_cast<text>(walnut_rt::io_native::string_get(m_id));
            } end function contents

            function contents(const text&: s) -> void {
                walnut_rt::io_native::string_set(m_id, static_cast<string>(s), m_mode);
            } end function contents
        } end class textbuf

        class spanbuf inherits streambuf {
            char*: m_data;
            long int: m_size;
            long int: m_put = 0;
            long int: m_get = 0;
            int: m_mode;

            function readable() const -> long int {
                if ((m_mode & 8) != 0) then {
                    return m_put;
                }
                return m_size;
            } end function readable

        public:
            constructor(char*: data, long int: size, int: mode = 12) : m_data = data, m_size = size, m_mode = mode { }

            function span_data() const -> char* {
                return m_data;
            } end function span_data

            function span_size() const -> long int {
                return readable();
            } end function span_size

            function span(char*: data, long int: size) -> void {
                m_data = data;
                m_size = size;
                m_put = 0;
                m_get = 0;
            } end function span

            function sputn(const string&: s) override -> long int {
                long int: written = 0;
                for (char: c in s) {
                    if (m_put >= m_size) then {
                        return written;
                    }
                    m_data[m_put] = c;
                    m_put++;
                    written++;
                }
                return written;
            } end function sputn

            function sgetc(char&: out) override -> bool {
                if (m_get >= readable()) then {
                    return false;
                }
                out = m_data[m_get];
                return true;
            } end function sgetc

            function sbumpc(char&: out) override -> bool {
                if (!sgetc(out)) then {
                    return false;
                }
                m_get++;
                return true;
            } end function sbumpc

            function sungetc() override -> bool {
                if (m_get <= 0) then {
                    return false;
                }
                m_get--;
                return true;
            } end function sungetc

            function in_avail() override -> long int {
                return readable() - m_get;
            } end function in_avail

            function pubseekoff(long int: offset, int: dir, int: which = 12) override -> long int {
                long int: result = -1;
                if ((which & 4) != 0) then {
                    long int: base = 0;
                    if (dir == 1) then { base = m_get; } else if (dir == 2) then { base = readable(); }
                    long int: target = base + offset;
                    if (target < 0 || target > readable()) then {
                        return -1;
                    }
                    m_get = target;
                    result = target;
                }
                if ((which & 8) != 0) then {
                    long int: base = 0;
                    if (dir == 1) then { base = m_put; } else if (dir == 2) then { base = m_size; }
                    long int: target = base + offset;
                    if (target < 0 || target > m_size) then {
                        return -1;
                    }
                    m_put = target;
                    result = target;
                }
                return result;
            } end function pubseekoff
        } end class spanbuf

        class syncbuf inherits streambuf {
            streambuf*: m_wrapped;
            string: m_pending = "";
            bool: m_emit_on_sync = false;

        public:
            constructor(streambuf*: wrapped = nullptr) : m_wrapped = wrapped { }

            destructor() {
                emit();
            }

            function emit() -> bool {
                if (m_wrapped == nullptr) then {
                    return false;
                }
                if (m_pending == "") then {
                    return true;
                }
                walnut_rt::io_native::sync_acquire();
                const long int: wanted = countof(m_pending);
                const long int: written = m_wrapped->sputn(m_pending);
                m_wrapped->pubsync();
                walnut_rt::io_native::sync_release();
                m_pending = "";
                return written == wanted;
            } end function emit

            function get_wrapped() const -> streambuf* {
                return m_wrapped;
            } end function get_wrapped

            function set_emit_on_sync(bool: on) -> void {
                m_emit_on_sync = on;
            } end function set_emit_on_sync

            function sputn(const string&: s) override -> long int {
                m_pending += s;
                return countof(s);
            } end function sputn

            function pubsync() override -> int {
                if (m_emit_on_sync && !emit()) then {
                    return -1;
                }
                return 0;
            } end function pubsync
        } end class syncbuf

        struct manipulator {
            int: kind = 0;
            int: set = 0;
            int: mask = 0;
            long int: number = 0;
            char: fill_char = ' ';
        } end struct manipulator

        const manipulator: endl         = manipulator{1, 0, 0, 0, ' '};
        const manipulator: ends         = manipulator{2, 0, 0, 0, ' '};
        const manipulator: flush        = manipulator{3, 0, 0, 0, ' '};
        const manipulator: ws           = manipulator{4, 0, 0, 0, ' '};
        const manipulator: emit_on_flush   = manipulator{8, 0, 0, 1, ' '};
        const manipulator: noemit_on_flush = manipulator{8, 0, 0, 0, ' '};
        const manipulator: flush_emit   = manipulator{9, 0, 0, 0, ' '};
        const manipulator: boolalpha    = manipulator{0, 1, 1, 0, ' '};
        const manipulator: noboolalpha  = manipulator{0, 0, 1, 0, ' '};
        const manipulator: base10       = manipulator{0, 2, 32842, 0, ' '};
        const manipulator: hex          = manipulator{0, 8, 32842, 0, ' '};
        const manipulator: oct          = manipulator{0, 64, 32842, 0, ' '};
        const manipulator: bin          = manipulator{0, 32768, 32842, 0, ' '};
        const manipulator: fixed        = manipulator{0, 4, 260, 0, ' '};
        const manipulator: scientific   = manipulator{0, 256, 260, 0, ' '};
        const manipulator: defaultfloat = manipulator{0, 0, 260, 0, ' '};
        const manipulator: left         = manipulator{0, 32, 176, 0, ' '};
        const manipulator: right        = manipulator{0, 128, 176, 0, ' '};
        const manipulator: internal     = manipulator{0, 16, 176, 0, ' '};
        const manipulator: showbase     = manipulator{0, 512, 512, 0, ' '};
        const manipulator: noshowbase   = manipulator{0, 0, 512, 0, ' '};
        const manipulator: showpoint    = manipulator{0, 1024, 1024, 0, ' '};
        const manipulator: noshowpoint  = manipulator{0, 0, 1024, 0, ' '};
        const manipulator: showpos      = manipulator{0, 2048, 2048, 0, ' '};
        const manipulator: noshowpos    = manipulator{0, 0, 2048, 0, ' '};
        const manipulator: skipws       = manipulator{0, 4096, 4096, 0, ' '};
        const manipulator: noskipws     = manipulator{0, 0, 4096, 0, ' '};
        const manipulator: unitbuf      = manipulator{0, 8192, 8192, 0, ' '};
        const manipulator: nounitbuf    = manipulator{0, 0, 8192, 0, ' '};
        const manipulator: uppercase    = manipulator{0, 16384, 16384, 0, ' '};
        const manipulator: nouppercase  = manipulator{0, 0, 16384, 0, ' '};

        function setw(long int: n) -> manipulator {
            return manipulator{5, 0, 0, n, ' '};
        } end function setw

        function setprecision(long int: n) -> manipulator {
            return manipulator{6, 0, 0, n, ' '};
        } end function setprecision

        function setfill(char: c) -> manipulator {
            return manipulator{7, 0, 0, 0, c};
        } end function setfill

        function setbase(int: base) -> manipulator {
            if (base == 16) then {
                return hex;
            } else if (base == 8) then {
                return oct;
            } else if (base == 2) then {
                return bin;
            }
            return base10;
        } end function setbase

        function setiosflags(int: f) -> manipulator {
            return manipulator{0, f, f, 0, ' '};
        } end function setiosflags

        function resetiosflags(int: f) -> manipulator {
            return manipulator{0, 0, f, 0, ' '};
        } end function resetiosflags

        class ostream inherits ios {
        protected:
            function emit_raw(const string&: s) -> void {
                streambuf*: b = m_s->buf;
                if (b == nullptr) then {
                    setstate(ios_base::badbit);
                    return;
                }
                if (b->sputn(s) < countof(s)) then {
                    setstate(ios_base::badbit);
                }
            } end function emit_raw

            function after_output() -> void {
                if ((m_s->flags & ios_base::unitbuf) != 0) then {
                    flush();
                }
            } end function after_output

            function emit_field(const string&: body) -> void {
                const long int: want = m_s->width;
                m_s->width = 0;
                const long int: have = countof(body);
                if (want <= have) then {
                    emit_raw(body);
                    after_output();
                    return;
                }
                string: pad = "";
                for (long int: i = 0; i < want - have; i++) {
                    pad += m_s->fill;
                }
                const int: adjust = m_s->flags & ios_base::adjustfield;
                if (adjust == ios_base::left) then {
                    emit_raw(body + pad);
                } else if (adjust == ios_base::internal) then {
                    long int: split = 0;
                    if (have > 0 && (body[0] == '-' || body[0] == '+')) then {
                        split = 1;
                    }
                    if (have > split + 1 && body[split] == '0' && (body[split + 1] == 'x' || body[split + 1] == 'X' || body[split + 1] == 'b' || body[split + 1] == 'B')) then {
                        split += 2;
                    }
                    string: head = "";
                    string: tail = "";
                    long int: at = 0;
                    for (char: c in body) {
                        if (at < split) then {
                            head += c;
                        } else then {
                            tail += c;
                        }
                        at++;
                    }
                    emit_raw(head + pad + tail);
                } else then {
                    emit_raw(pad + body);
                }
                after_output();
            } end function emit_field

            function number_base() const -> long int {
                const int: base = m_s->flags & ios_base::basefield;
                if (base == ios_base::hex) then {
                    return 16;
                } else if (base == ios_base::oct) then {
                    return 8;
                } else if (base == ios_base::bin) then {
                    return 2;
                }
                return 10;
            } end function number_base

        public:
            constructor(streambuf*: b, ostream*: tied = nullptr, int: extra_flags = 0) {
                m_s->buf = b;
                m_s->tied = tied;
                m_s->flags = m_s->flags | extra_flags;
            }

            function write(const string&: s) -> ostream& {
                emit_raw(s);
                after_output();
                return *this;
            } end function write

            function put(char: c) -> ostream& {
                string: s = "";
                s += c;
                emit_raw(s);
                after_output();
                return *this;
            } end function put

            function flush() -> ostream& {
                streambuf*: b = m_s->buf;
                if (b != nullptr && b->pubsync() != 0) then {
                    setstate(ios_base::badbit);
                }
                return *this;
            } end function flush

            function tellp() -> long int {
                streambuf*: b = m_s->buf;
                if (b == nullptr || fail()) then {
                    return -1;
                }
                return b->pubseekoff(0, ios_base::seek_cur, ios_base::output);
            } end function tellp

            function seekp(long int: pos) -> ostream& {
                return seekp(pos, ios_base::seek_beg);
            } end function seekp

            function seekp(long int: offset, int: dir) -> ostream& {
                streambuf*: b = m_s->buf;
                if (b == nullptr || fail() || b->pubseekoff(offset, dir, ios_base::output) < 0) then {
                    setstate(ios_base::failbit);
                }
                return *this;
            } end function seekp

            operator(<<) function(const string&: s) -> ostream& {
                emit_field(s);
                return *this;
            }

            operator(<<) function(const text&: t) -> ostream& {
                emit_field(static_cast<string>(t));
                return *this;
            }

            operator(<<) function(const var&: v) -> ostream& {
                emit_field(static_cast<string>(`${v}`));
                return *this;
            }

            operator(<<) function(char: c) -> ostream& {
                string: s = "";
                s += c;
                emit_field(s);
                return *this;
            }

            operator(<<) function(bool: b) -> ostream& {
                if ((m_s->flags & ios_base::boolalpha) != 0) then {
                    if (b) then { emit_field("true"); } else then { emit_field("false"); }
                } else then {
                    if (b) then { emit_field("1"); } else then { emit_field("0"); }
                }
                return *this;
            }

            template <typename T>
            requires std::traits::is_builtin_integer<T> && std::traits::is_signed<T>
            operator(<<) function(T: v) -> ostream& {
                const long long integer: wide = v;
                const int: f = m_s->flags;
                emit_field(walnut_rt::io_native::format_int(wide, number_base(), (f & ios_base::uppercase) != 0, (f & ios_base::showbase) != 0, (f & ios_base::showpos) != 0));
                return *this;
            }

            template <typename T>
            requires std::traits::is_builtin_integer<T> && std::traits::is_unsigned<T>
            operator(<<) function(T: v) -> ostream& {
                const unsigned long long integer: wide = v;
                const int: f = m_s->flags;
                emit_field(walnut_rt::io_native::format_uint(wide, number_base(), (f & ios_base::uppercase) != 0, (f & ios_base::showbase) != 0, (f & ios_base::showpos) != 0));
                return *this;
            }

            template <typename T>
            requires std::traits::is_builtin_float<T>
            operator(<<) function(T: v) -> ostream& {
                const long long double: wide = v;
                const int: f = m_s->flags;
                const int: style = f & ios_base::floatfield;
                long int: mode = 0;
                if (style == ios_base::fixed) then {
                    mode = 1;
                } else if (style == ios_base::scientific) then {
                    mode = 2;
                }
                long int: digits = m_s->precision;
                if (mode == 0 && !m_s->precision_set) then {
                    digits = 0;
                } else if (mode == 0 && digits <= 0) then {
                    digits = 1;
                } else if (digits < 0) then {
                    digits = 6;
                }
                emit_field(walnut_rt::io_native::format_float(wide, sizeof(T) * 8, digits, mode, (f & ios_base::uppercase) != 0, (f & ios_base::showpos) != 0, (f & ios_base::showpoint) != 0));
                return *this;
            }

            operator(<<) function(streambuf*: source) -> ostream& {
                if (source == nullptr) then {
                    setstate(ios_base::badbit);
                    return *this;
                }
                char: c = ' ';
                string: all = "";
                while (source->sbumpc(c)) {
                    all += c;
                }
                emit_raw(all);
                after_output();
                return *this;
            }

            operator(<<) function(const manipulator&: m) -> ostream& {
                if (m.kind == 0) then {
                    setf(m.set, m.mask);
                } else if (m.kind == 1) then {
                    emit_raw("\n");
                    flush();
                } else if (m.kind == 2) then {
                    emit_raw("\0");
                } else if (m.kind == 3) then {
                    flush();
                } else if (m.kind == 5) then {
                    width(m.number);
                } else if (m.kind == 6) then {
                    precision(m.number);
                } else if (m.kind == 7) then {
                    fill(m.fill_char);
                } else if (m.kind == 8) then {
                    syncbuf*: s = dynamic_cast<syncbuf*>(m_s->buf);
                    if (s != nullptr) then {
                        s->set_emit_on_sync(m.number != 0);
                    }
                } else if (m.kind == 9) then {
                    syncbuf*: s = dynamic_cast<syncbuf*>(m_s->buf);
                    flush();
                    if (s != nullptr && !s->emit()) then {
                        setstate(ios_base::badbit);
                    }
                }
                return *this;
            }

            template <typename T>
            requires std::traits::is_class<T> && std::concepts::has_to_string<T>
            operator(<<) function(const T&: value) -> ostream& {
                emit_field(std::core::to_string(value));
                return *this;
            }
        } end class ostream

        class istream inherits ios {
        protected:
            long int: m_gcount = 0;

            static function is_space(char: c) -> bool {
                return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f';
            } end function is_space

            function prepare(bool: skip) -> bool {
                m_gcount = 0;
                if (!good()) then {
                    setstate(ios_base::failbit);
                    return false;
                }
                if (m_s->buf == nullptr) then {
                    setstate(ios_base::badbit);
                    return false;
                }
                if (m_s->tied != nullptr) then {
                    m_s->tied->flush();
                }
                if (skip && (m_s->flags & ios_base::skipws) != 0) then {
                    skip_space();
                    if (eof()) then {
                        setstate(ios_base::failbit);
                        return false;
                    }
                }
                return true;
            } end function prepare

            function skip_space() -> void {
                char: c = ' ';
                while (true) {
                    if (!m_s->buf->sgetc(c)) then {
                        setstate(ios_base::eofbit);
                        return;
                    }
                    if (!is_space(c)) then {
                        return;
                    }
                    m_s->buf->sbumpc(c);
                }
            } end function skip_space

            function read_token() -> string {
                string: token = "";
                char: c = ' ';
                long int: limit = m_s->width;
                m_s->width = 0;
                while (true) {
                    if (limit > 0 && countof(token) >= limit) then {
                        break;
                    }
                    if (!m_s->buf->sgetc(c)) then {
                        setstate(ios_base::eofbit);
                        break;
                    }
                    if (is_space(c)) then {
                        break;
                    }
                    token += c;
                    m_s->buf->sbumpc(c);
                    m_gcount++;
                }
                if (token == "") then {
                    setstate(ios_base::failbit);
                }
                return token;
            } end function read_token

            function number_base() const -> long int {
                const int: base = m_s->flags & ios_base::basefield;
                if (base == ios_base::hex) then {
                    return 16;
                } else if (base == ios_base::oct) then {
                    return 8;
                } else if (base == ios_base::bin) then {
                    return 2;
                }
                return 10;
            } end function number_base

        public:
            constructor(streambuf*: b, ostream*: tied = nullptr) {
                m_s->buf = b;
                m_s->tied = tied;
            }

            function gcount() const -> long int {
                return m_gcount;
            } end function gcount

            function get(char&: c) -> istream& {
                if (!prepare(false)) then {
                    return *this;
                }
                if (m_s->buf->sbumpc(c)) then {
                    m_gcount = 1;
                } else then {
                    setstate(ios_base::eofbit | ios_base::failbit);
                }
                return *this;
            } end function get

            function peek(char&: c) -> bool {
                if (!prepare(false)) then {
                    return false;
                }
                if (!m_s->buf->sgetc(c)) then {
                    setstate(ios_base::eofbit);
                    return false;
                }
                return true;
            } end function peek

            function unget() -> istream& {
                clear(rdstate() & ~ios_base::eofbit);
                if (!prepare(false)) then {
                    return *this;
                }
                if (!m_s->buf->sungetc()) then {
                    setstate(ios_base::badbit);
                }
                return *this;
            } end function unget

            function putback(char: c) -> istream& {
                return unget();
            } end function putback

            function ignore(long int: n = 1) -> istream& {
                if (!prepare(false)) then {
                    return *this;
                }
                char: c = ' ';
                while (m_gcount < n) {
                    if (!m_s->buf->sbumpc(c)) then {
                        setstate(ios_base::eofbit);
                        break;
                    }
                    m_gcount++;
                }
                return *this;
            } end function ignore

            function ignore(long int: n, char: delim) -> istream& {
                if (!prepare(false)) then {
                    return *this;
                }
                char: c = ' ';
                while (m_gcount < n) {
                    if (!m_s->buf->sbumpc(c)) then {
                        setstate(ios_base::eofbit);
                        break;
                    }
                    m_gcount++;
                    if (c == delim) then {
                        break;
                    }
                }
                return *this;
            } end function ignore

            function getline(string&: s, char: delim = '\n') -> istream& {
                s = "";
                if (!prepare(false)) then {
                    return *this;
                }
                char: c = ' ';
                bool: got_any = false;
                while (true) {
                    if (!m_s->buf->sbumpc(c)) then {
                        setstate(ios_base::eofbit);
                        break;
                    }
                    got_any = true;
                    m_gcount++;
                    if (c == delim) then {
                        break;
                    }
                    s += c;
                }
                if (!got_any) then {
                    setstate(ios_base::failbit);
                }
                return *this;
            } end function getline

            function getline(text&: t, char: delim = '\n') -> istream& {
                string: s = "";
                getline(s, delim);
                t = static_cast<text>(s);
                return *this;
            } end function getline

            function read(string&: s, long int: n) -> istream& {
                s = "";
                if (!prepare(false)) then {
                    return *this;
                }
                char: c = ' ';
                while (m_gcount < n) {
                    if (!m_s->buf->sbumpc(c)) then {
                        setstate(ios_base::eofbit | ios_base::failbit);
                        break;
                    }
                    s += c;
                    m_gcount++;
                }
                return *this;
            } end function read

            function sync() -> int {
                if (m_s->buf == nullptr) then {
                    return -1;
                }
                return m_s->buf->pubsync();
            } end function sync

            function tellg() -> long int {
                if (m_s->buf == nullptr || fail()) then {
                    return -1;
                }
                return m_s->buf->pubseekoff(0, ios_base::seek_cur, ios_base::input);
            } end function tellg

            function seekg(long int: pos) -> istream& {
                return seekg(pos, ios_base::seek_beg);
            } end function seekg

            function seekg(long int: offset, int: dir) -> istream& {
                clear(rdstate() & ~ios_base::eofbit);
                if (m_s->buf == nullptr || fail() || m_s->buf->pubseekoff(offset, dir, ios_base::input) < 0) then {
                    setstate(ios_base::failbit);
                }
                return *this;
            } end function seekg

            operator(>>) function(string&: s) -> istream& {
                if (prepare(true)) then {
                    s = read_token();
                }
                return *this;
            }

            operator(>>) function(text&: t) -> istream& {
                if (prepare(true)) then {
                    t = static_cast<text>(read_token());
                }
                return *this;
            }

            operator(>>) function(char&: c) -> istream& {
                if (!prepare(true)) then {
                    return *this;
                }
                if (m_s->buf->sbumpc(c)) then {
                    m_gcount = 1;
                } else then {
                    setstate(ios_base::eofbit | ios_base::failbit);
                }
                return *this;
            }

            operator(>>) function(bool&: b) -> istream& {
                if (!prepare(true)) then {
                    return *this;
                }
                const string: token = read_token();
                if (token == "1" || ((m_s->flags & ios_base::boolalpha) != 0 && token == "true")) then {
                    b = true;
                } else if (token == "0" || ((m_s->flags & ios_base::boolalpha) != 0 && token == "false")) then {
                    b = false;
                } else then {
                    b = false;
                    setstate(ios_base::failbit);
                }
                return *this;
            }

            template <typename T>
            requires std::traits::is_builtin_integer<T> && std::traits::is_signed<T>
            operator(>>) function(T&: v) -> istream& {
                if (!prepare(true)) then {
                    return *this;
                }
                const string: token = read_token();
                if (fail()) then {
                    return *this;
                }
                if (!walnut_rt::io_native::parse_int_ok(token, number_base())) then {
                    v = 0;
                    setstate(ios_base::failbit);
                    return *this;
                }
                const long long integer: wide = walnut_rt::io_native::parse_int(token, number_base());
                if (wide is inf || wide is nan || wide is undefined || wide is indeterminate) then {
                    v = static_cast<T>(wide);
                    return *this;
                }
                const T: narrow = static_cast<T>(wide);
                const long long integer: back = narrow;
                if (back != wide) then {
                    setstate(ios_base::failbit);
                }
                v = narrow;
                return *this;
            }

            template <typename T>
            requires std::traits::is_builtin_integer<T> && std::traits::is_unsigned<T>
            operator(>>) function(T&: v) -> istream& {
                if (!prepare(true)) then {
                    return *this;
                }
                const string: token = read_token();
                if (fail()) then {
                    return *this;
                }
                if (!walnut_rt::io_native::parse_uint_ok(token, number_base())) then {
                    v = 0;
                    setstate(ios_base::failbit);
                    return *this;
                }
                const unsigned long long integer: wide = walnut_rt::io_native::parse_uint(token, number_base());
                if (wide is inf || wide is nan || wide is undefined || wide is indeterminate) then {
                    v = static_cast<T>(wide);
                    return *this;
                }
                const T: narrow = static_cast<T>(wide);
                const unsigned long long integer: back = narrow;
                if (back != wide) then {
                    setstate(ios_base::failbit);
                }
                v = narrow;
                return *this;
            }

            template <typename T>
            requires std::traits::is_builtin_float<T>
            operator(>>) function(T&: v) -> istream& {
                if (!prepare(true)) then {
                    return *this;
                }
                const string: token = read_token();
                if (fail()) then {
                    return *this;
                }
                if (!walnut_rt::io_native::parse_float_ok(token)) then {
                    v = 0;
                    setstate(ios_base::failbit);
                    return *this;
                }
                v = static_cast<T>(walnut_rt::io_native::parse_float(token));
                return *this;
            }

            operator(>>) function(const manipulator&: m) -> istream& {
                if (m.kind == 0) then {
                    setf(m.set, m.mask);
                } else if (m.kind == 4) then {
                    if (m_s->buf != nullptr) then {
                        skip_space();
                    }
                } else if (m.kind == 5) then {
                    width(m.number);
                }
                return *this;
            }
        } end class istream

        class iostream inherits istream, ostream {
        public:
            constructor(streambuf*: b) : istream(b), ostream(b) {
                istream*: as_in = this;
                ostream*: as_out = this;
                ios_base*: in_base = as_in;
                ios_base*: out_base = as_out;
                out_base->share_state_with(*in_base);
            }

            function flags() const -> int { return istream::flags(); } end function flags
            function flags(int: f) -> int { return istream::flags(f); } end function flags
            function setf(int: f) -> int { return istream::setf(f); } end function setf
            function setf(int: f, int: mask) -> int { return istream::setf(f, mask); } end function setf
            function unsetf(int: mask) -> void { istream::unsetf(mask); } end function unsetf
            function width() const -> long int { return istream::width(); } end function width
            function width(long int: w) -> long int { return istream::width(w); } end function width
            function precision() const -> long int { return istream::precision(); } end function precision
            function precision(long int: p) -> long int { return istream::precision(p); } end function precision
            function fill() const -> char { return istream::fill(); } end function fill
            function fill(char: c) -> char { return istream::fill(c); } end function fill
            function rdstate() const -> int { return istream::rdstate(); } end function rdstate
            function good() const -> bool { return istream::good(); } end function good
            function eof() const -> bool { return istream::eof(); } end function eof
            function fail() const -> bool { return istream::fail(); } end function fail
            function bad() const -> bool { return istream::bad(); } end function bad
            function clear(int: s = 0) -> void { istream::clear(s); } end function clear
            function setstate(int: s) -> void { istream::setstate(s); } end function setstate
            function rdbuf() const -> streambuf* { return istream::rdbuf(); } end function rdbuf
            function rdbuf(streambuf*: b) -> streambuf* { return istream::rdbuf(b); } end function rdbuf
            function tie() const -> ostream* { return istream::tie(); } end function tie
            function tie(ostream*: t) -> ostream* { return istream::tie(t); } end function tie
            function copyfmt(const ios&: other) -> ios& { return istream::copyfmt(other); } end function copyfmt
            function share_state_with(ios_base&: other) -> void { istream::share_state_with(other); } end function share_state_with

            operator(bool) function() const {
                return !istream::fail();
            }

            operator(!) function() const -> bool {
                return istream::fail();
            }
        } end class iostream

        class ofstream inherits ostream {
            filebuf: m_fb;

        public:
            constructor() : ostream(nullptr) {
                rdbuf(&m_fb);
            }

            constructor(const string&: path, int: mode = 8) : ostream(nullptr) {
                rdbuf(&m_fb);
                open(path, mode);
            }

            function open(const string&: path, int: mode = 8) -> void {
                if (m_fb.open(path, mode | ios_base::output) == nullptr) then {
                    setstate(ios_base::failbit);
                } else then {
                    clear();
                }
            } end function open

            function is_open() const -> bool {
                return m_fb.is_open();
            } end function is_open

            function close() -> void {
                flush();
                if (m_fb.close() == nullptr) then {
                    setstate(ios_base::failbit);
                }
            } end function close
        } end class ofstream

        class ifstream inherits istream {
            filebuf: m_fb;

        public:
            constructor() : istream(nullptr) {
