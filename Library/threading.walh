namespace std {
    namespace threading {
        safe(compile) {
            hidden namespace detail {
                extern "C++" from "<walnut_threading.hpp>" {
                    class Api as "walnut_rt::threading::api" {
                    public:
                        static function sleep_for(unsigned long int: milliseconds) -> void as "walnut_rt::threading::sleep_for";
                        static function sleep_for_micros(unsigned long int: microseconds) -> void as "walnut_rt::threading::sleep_for_micros";
                        static function yield_now() -> void as "walnut_rt::threading::yield";
                        static function current_id() -> unsigned long int as "walnut_rt::threading::current_id";
                        static function hardware_threads() -> unsigned long int as "walnut_rt::threading::hardware_threads";
                    } end class Api
                } end extern
            } end namespace detail

            namespace this_thread {
                function sleep_for(unsigned long int: milliseconds) -> void {
                    detail::Api::sleep_for(milliseconds);
                } end function sleep_for

                function sleep_for_micros(unsigned long int: microseconds) -> void {
                    detail::Api::sleep_for_micros(microseconds);
                } end function sleep_for_micros

                function yield() -> void {
                    detail::Api::yield_now();
                } end function yield

                function id() -> unsigned long int {
                    return detail::Api::current_id();
                } end function id
            } end namespace this_thread

            function hardware_threads() -> unsigned long int {
                return detail::Api::hardware_threads();
            } end function hardware_threads

            extern "C++" from "<walnut_threading.hpp>" {
                class Thread as "walnut_rt::threading::thread" {
                public:
                    constructor();
                    constructor(function() -> void: body);
                    constructor(const Thread&: other) = delete;
                    constructor(Thread&&: other) noexcept;
                    operator(=) function(self&, Thread&&: other) noexcept -> Thread&;
                    function join(self&) -> void;
                    function detach(self&) -> void;
                    function joinable(const self&) -> bool;
                    function id(const self&) -> unsigned long int;
                } end class Thread

                class Mutex as "std::mutex" {
                public:
                    constructor();
                    constructor(const Mutex&: other) = delete;
                    function lock(self&) -> void;
                    function unlock(self&) -> void;
                    function try_lock(self&) -> bool;
                } end class Mutex

                class RecursiveMutex as "std::recursive_mutex" {
                public:
                    constructor();
                    constructor(const RecursiveMutex&: other) = delete;
                    function lock(self&) -> void;
                    function unlock(self&) -> void;
                    function try_lock(self&) -> bool;
                } end class RecursiveMutex

                class TimedMutex as "std::timed_mutex" {
                public:
                    constructor();
                    constructor(const TimedMutex&: other) = delete;
                    function lock(self&) -> void;
                    function unlock(self&) -> void;
                    function try_lock(self&) -> bool;
                    function try_lock_for(self&, unsigned long int: milliseconds) -> bool as "walnut_rt::threading::try_lock_for";
                } end class TimedMutex

                class RecursiveTimedMutex as "std::recursive_timed_mutex" {
                public:
                    constructor();
                    constructor(const RecursiveTimedMutex&: other) = delete;
                    function lock(self&) -> void;
                    function unlock(self&) -> void;
                    function try_lock(self&) -> bool;
                    function try_lock_for(self&, unsigned long int: milliseconds) -> bool as "walnut_rt::threading::try_lock_for";
                } end class RecursiveTimedMutex

                class SharedMutex as "std::shared_mutex" {
                public:
                    constructor();
                    constructor(const SharedMutex&: other) = delete;
                    function lock(self&) -> void;
                    function unlock(self&) -> void;
                    function try_lock(self&) -> bool;
                    function lock_shared(self&) -> void;
                    function unlock_shared(self&) -> void;
                    function try_lock_shared(self&) -> bool;
                } end class SharedMutex
            } end extern

            template <typename M>
            concept Lockable = std::traits::is_same<M, Mutex> || std::traits::is_same<M, RecursiveMutex> || std::traits::is_same<M, TimedMutex> || std::traits::is_same<M, RecursiveTimedMutex> || std::traits::is_same<M, SharedMutex>

            template <typename M>
            concept SharedLockable = std::traits::is_same<M, SharedMutex>

            extern "C++" from "<walnut_threading.hpp>" {

                template <typename M>
                requires Lockable<M>
                class LockGuard as "walnut_rt::threading::lock_guard" {
                public:
                    constructor(const LockGuard&: other) = delete;
                    constructor(M&: mutex);
                } end class LockGuard

                template <typename M>
                requires Lockable<M>
                class UniqueLock as "walnut_rt::threading::unique_lock" {
                public:
                    constructor();
                    constructor(const UniqueLock&: other) = delete;
                    constructor(M&: mutex);
                    constructor(M&: mutex, bool: lock_now);
                    function lock() -> void;
                    function unlock() -> void;
                    function try_lock() -> bool;
                    function owns_lock() const -> bool;
                } end class UniqueLock

                template <typename M>
                requires SharedLockable<M>
                class SharedLock as "walnut_rt::threading::shared_lock" {
                public:
                    constructor();
                    constructor(const SharedLock&: other) = delete;
                    constructor(M&: mutex);
                    constructor(M&: mutex, bool: lock_now);
                    function lock() -> void;
                    function unlock() -> void;
                    function try_lock() -> bool;
                    function owns_lock() const -> bool;
                } end class SharedLock

                class ConditionVariable as "walnut_rt::threading::condition_variable" {
                public:
                    constructor();
                    constructor(const ConditionVariable&: other) = delete;
                    function wait(self&, UniqueLock<Mutex>&: lock) -> void;
                    function wait(self&, UniqueLock<Mutex>&: lock, function() -> bool: ready) -> void;
                    function wait_for(self&, UniqueLock<Mutex>&: lock, unsigned long int: milliseconds) -> bool;
                    function wait_for(self&, UniqueLock<Mutex>&: lock, unsigned long int: milliseconds, function() -> bool: ready) -> bool;
                    function wait(self&, UniqueLock<TimedMutex>&: lock) -> void;
                    function wait(self&, UniqueLock<TimedMutex>&: lock, function() -> bool: ready) -> void;
                    function wait_for(self&, UniqueLock<TimedMutex>&: lock, unsigned long int: milliseconds) -> bool;
                    function wait_for(self&, UniqueLock<TimedMutex>&: lock, unsigned long int: milliseconds, function() -> bool: ready) -> bool;
                    function wait(self&, UniqueLock<SharedMutex>&: lock) -> void;
                    function wait(self&, UniqueLock<SharedMutex>&: lock, function() -> bool: ready) -> void;
                    function wait_for(self&, UniqueLock<SharedMutex>&: lock, unsigned long int: milliseconds) -> bool;
                    function wait_for(self&, UniqueLock<SharedMutex>&: lock, unsigned long int: milliseconds, function() -> bool: ready) -> bool;
                    function wait(self&, SharedLock<SharedMutex>&: lock) -> void;
                    function wait(self&, SharedLock<SharedMutex>&: lock, function() -> bool: ready) -> void;
                    function wait_for(self&, SharedLock<SharedMutex>&: lock, unsigned long int: milliseconds) -> bool;
                    function wait_for(self&, SharedLock<SharedMutex>&: lock, unsigned long int: milliseconds, function() -> bool: ready) -> bool;
                    function notify_one(self&) -> void;
                    function notify_all(self&) -> void;
                } end class ConditionVariable

            } end extern

            enum MemoryOrder { relaxed, acquire, release, acq_rel, seq_cst }
        } end safe

        hidden namespace detail {
            safe(compile) {
                template <typename T, bool Integer>
                struct SmallInteger {
                    static constexpr bool: value = false;
                } end struct SmallInteger

                template <typename T>
                struct SmallInteger<T, true> {
                    static constexpr bool: value = std::traits::is_hardware<T> ? sizeof(T) <= 8 : std::traits::integer_bits<T> <= 32;
                } end struct SmallInteger

                template <typename T, bool IsEnum>
                struct SmallEnum {
                    static constexpr bool: value = false;
                } end struct SmallEnum

                template <typename T>
                struct SmallEnum<T, true> {
                    static constexpr bool: value = std::traits::integer_bits<std::traits::underlying_type<T>> <= 64;
                } end struct SmallEnum

                template <typename T>
                constexpr bool: native_atomic = SmallInteger<T, (std::traits::is_builtin_integer<T>)>::value || std::traits::is_bool<T> || std::traits::is_char<T> || std::traits::is_pointer<T> || SmallEnum<T, (std::traits::is_enum<T>)>::value;

                template <typename T>
                constexpr bool: atomic_number = (std::traits::is_builtin_integer<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>) || std::traits::is_builtin_float<T>;

                template <typename T>
                constexpr bool: atomic_bits = std::traits::is_builtin_integer<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>;

                template <typename T>
                using atomic_delta = std::traits::conditional<std::traits::is_pointer<T>, unsigned long int, T>;

                extern "C++" from "<walnut_threading.hpp>" {
                    template <typename T>
                    class NativeAtomic as "walnut_rt::threading::atomic" {
                    public:
                        constructor();
                        constructor(const T&: value);
                        constructor(const NativeAtomic&: other) = delete;
                        function load_with(const self&, unsigned long int: order) -> T;
                        function store_with(self&, const T&: value, unsigned long int: order) -> void;
                        function exchange_with(self&, const T&: value, unsigned long int: order) -> T;
                        function compare_exchange_with(self&, T&: expected, const T&: desired, bool: weak, unsigned long int: order) -> bool;
                        function fetch_add_with(self&, const atomic_delta<T>&: value, unsigned long int: order) -> T;
                        function fetch_sub_with(self&, const atomic_delta<T>&: value, unsigned long int: order) -> T;
                        function add_with(self&, const atomic_delta<T>&: value, unsigned long int: order) -> T;
                        function sub_with(self&, const atomic_delta<T>&: value, unsigned long int: order) -> T;
                        function fetch_and_with(self&, const T&: value, unsigned long int: order) -> T;
                        function fetch_or_with(self&, const T&: value, unsigned long int: order) -> T;
                        function fetch_xor_with(self&, const T&: value, unsigned long int: order) -> T;
                        function and_with(self&, const T&: value, unsigned long int: order) -> T;
                        function or_with(self&, const T&: value, unsigned long int: order) -> T;
                        function xor_with(self&, const T&: value, unsigned long int: order) -> T;
                        function fetch_min_with(self&, const T&: value, unsigned long int: order) -> T;
                        function fetch_max_with(self&, const T&: value, unsigned long int: order) -> T;
                        function wait_with(const self&, const T&: old, unsigned long int: order) -> void;
                        function notify(const self&) -> void;
                        function lock_free(const self&) -> bool;
                    } end class NativeAtomic

                    class Parker as "walnut_rt::threading::parker" {
                    public:
                        static function park_while(const void*: address, function() -> bool: unchanged) -> void;
                        static function unpark(const void*: address) -> void;
                    } end class Parker

                    class SpinLock as "walnut_rt::threading::spin_lock" {
                    public:
                        constructor();
                        constructor(const SpinLock&: other) = delete;
                        function lock(self&) noexcept -> void;
                        function try_lock(self&) noexcept -> bool;
                        function unlock(self&) noexcept -> void;
                    } end class SpinLock

                } end extern
            } end safe

            class SpinGuard {
                SpinLock*: held;
            public:
                constructor(SpinLock&: l) noexcept : held = &l {
                    self.held->lock();
                }
                constructor(const SpinGuard&: other) = delete;
                destructor() noexcept {
                    held->unlock();
                }
            } end class SpinGuard

            safe(compile) {
                template <typename T>
                class LockedAtomic {
                    T: value;
                    mutable SpinLock: guard;

                public:
                    constructor() { }
                    constructor(const T&: v) : value = v { }
                    constructor(const LockedAtomic&: other) = delete;

                    function load_with(const self&, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        return self.value;
                    } end function load_with

                    function store_with(self&, const T&: v, unsigned long int: order) -> void {
                        SpinGuard: g(self.guard);
                        self.value = v;
                    } end function store_with

                    function exchange_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        self.value = v;
                        return old;
                    } end function exchange_with

                    function compare_exchange_with(self&, T&: expected, const T&: desired, bool: weak, unsigned long int: order) -> bool {
                        SpinGuard: g(self.guard);
                        if (self.value == expected) then {
                            self.value = desired;
                            return true;
                        }
                        expected = self.value;
                        return false;
                    } end function compare_exchange_with

                    function fetch_add_with(self&, const atomic_delta<T>&: d, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        self.value = self.value + d;
                        return old;
                    } end function fetch_add_with

                    function fetch_sub_with(self&, const atomic_delta<T>&: d, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        self.value = self.value - d;
                        return old;
                    } end function fetch_sub_with

                    function add_with(self&, const atomic_delta<T>&: d, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        self.value = self.value + d;
                        return self.value;
                    } end function add_with

                    function sub_with(self&, const atomic_delta<T>&: d, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        self.value = self.value - d;
                        return self.value;
                    } end function sub_with

                    function fetch_and_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        self.value = self.value & v;
                        return old;
                    } end function fetch_and_with

                    function fetch_or_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        self.value = self.value | v;
                        return old;
                    } end function fetch_or_with

                    function fetch_xor_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        self.value = self.value ^ v;
                        return old;
                    } end function fetch_xor_with

                    function and_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        self.value = self.value & v;
                        return self.value;
                    } end function and_with

                    function or_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        self.value = self.value | v;
                        return self.value;
                    } end function or_with

                    function xor_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        self.value = self.value ^ v;
                        return self.value;
                    } end function xor_with

                    function fetch_min_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        if (v < self.value) then {
                            self.value = v;
                        }
                        return old;
                    } end function fetch_min_with

                    function fetch_max_with(self&, const T&: v, unsigned long int: order) -> T {
                        SpinGuard: g(self.guard);
                        T: old = self.value;
                        if (self.value < v) then {
                            self.value = v;
                        }
                        return old;
                    } end function fetch_max_with

                    function wait_with(const self&, const T&: old, unsigned long int: order) -> void {
                        Parker::park_while(static_cast<const void*>(this), [&]() -> bool {
                            return self.load_with(order) == old;
                        });
                    } end function wait_with

                    function notify(const self&) -> void {
                        Parker::unpark(static_cast<const void*>(this));
                    } end function notify

                    function lock_free(const self&) -> bool {
                        return false;
                    } end function lock_free
                } end class LockedAtomic
            } end safe
        } end namespace detail

        safe(compile) {
            template <typename T>
            class Atomic {
                std::traits::conditional<detail::native_atomic<T>, detail::NativeAtomic<T>, detail::LockedAtomic<T>>: cell;

            public:
                constructor() noexcept { }

                constructor(const T&: value) : cell(value) { }

                constructor(const Atomic&: other) = delete;

                function load(const self&, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    return self.cell.load_with(static_cast<unsigned long int>(order));
                } end function load

                function store(self&, const T&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> void {
                    self.cell.store_with(value, static_cast<unsigned long int>(order));
                } end function store

                function exchange(self&, const T&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    return self.cell.exchange_with(value, static_cast<unsigned long int>(order));
                } end function exchange

                function compare_exchange(self&, T&: expected, const T&: desired, MemoryOrder: order = MemoryOrder::seq_cst) -> bool {
                    static_assert(std::concepts::equality_comparable<T>, "Atomic::compare_exchange needs a type that can be compared with ==");
                    return self.cell.compare_exchange_with(expected, desired, false, static_cast<unsigned long int>(order));
                } end function compare_exchange

                function compare_exchange_weak(self&, T&: expected, const T&: desired, MemoryOrder: order = MemoryOrder::seq_cst) -> bool {
                    static_assert(std::concepts::equality_comparable<T>, "Atomic::compare_exchange_weak needs a type that can be compared with ==");
                    return self.cell.compare_exchange_with(expected, desired, true, static_cast<unsigned long int>(order));
                } end function compare_exchange_weak

                function fetch_add(self&, const detail::atomic_delta<T>&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic::fetch_add needs a number or a pointer");
                    return self.cell.fetch_add_with(value, static_cast<unsigned long int>(order));
                } end function fetch_add

                function fetch_sub(self&, const detail::atomic_delta<T>&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic::fetch_sub needs a number or a pointer");
                    return self.cell.fetch_sub_with(value, static_cast<unsigned long int>(order));
                } end function fetch_sub

                function fetch_and(self&, const T&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    static_assert(detail::atomic_bits<T>, "Atomic::fetch_and needs an integer");
                    return self.cell.fetch_and_with(value, static_cast<unsigned long int>(order));
                } end function fetch_and

                function fetch_or(self&, const T&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    static_assert(detail::atomic_bits<T>, "Atomic::fetch_or needs an integer");
                    return self.cell.fetch_or_with(value, static_cast<unsigned long int>(order));
                } end function fetch_or

                function fetch_xor(self&, const T&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    static_assert(detail::atomic_bits<T>, "Atomic::fetch_xor needs an integer");
                    return self.cell.fetch_xor_with(value, static_cast<unsigned long int>(order));
                } end function fetch_xor

                function fetch_min(self&, const T&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic::fetch_min needs a number or a pointer");
                    return self.cell.fetch_min_with(value, static_cast<unsigned long int>(order));
                } end function fetch_min

                function fetch_max(self&, const T&: value, MemoryOrder: order = MemoryOrder::seq_cst) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic::fetch_max needs a number or a pointer");
                    return self.cell.fetch_max_with(value, static_cast<unsigned long int>(order));
                } end function fetch_max

                function wait(const self&, const T&: old, MemoryOrder: order = MemoryOrder::seq_cst) -> void {
                    static_assert(std::concepts::equality_comparable<T>, "Atomic::wait needs a type that can be compared with ==");
                    self.cell.wait_with(old, static_cast<unsigned long int>(order));
                } end function wait

                function notify_one(const self&) -> void {
                    self.cell.notify();
                } end function notify_one

                function notify_all(const self&) -> void {
                    self.cell.notify();
                } end function notify_all

                function is_lock_free(const self&) -> bool {
                    return self.cell.lock_free();
                } end function is_lock_free

                operator(T) function(const self&) {
                    return self.load();
                }

                operator(=) function(self&, const T&: value) -> T {
                    self.store(value);
                    return value;
                }

                operator(++) function(self&) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic '++' needs a number or a pointer");
                    return self.cell.add_with(static_cast<detail::atomic_delta<T>>(1), 4);
                }

                operator(++) function(self&, unsigned int: unused) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic '++' needs a number or a pointer");
                    return self.cell.fetch_add_with(static_cast<detail::atomic_delta<T>>(1), 4);
                }

                operator(--) function(self&) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic '--' needs a number or a pointer");
                    return self.cell.sub_with(static_cast<detail::atomic_delta<T>>(1), 4);
                }

                operator(--) function(self&, unsigned int: unused) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic '--' needs a number or a pointer");
                    return self.cell.fetch_sub_with(static_cast<detail::atomic_delta<T>>(1), 4);
                }

                operator(+=) function(self&, const detail::atomic_delta<T>&: value) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic '+=' needs a number or a pointer");
                    return self.cell.add_with(value, 4);
                }

                operator(-=) function(self&, const detail::atomic_delta<T>&: value) -> T {
                    static_assert(detail::atomic_number<T> || std::traits::is_pointer<T>, "Atomic '-=' needs a number or a pointer");
                    return self.cell.sub_with(value, 4);
                }

                operator(&=) function(self&, const T&: value) -> T {
                    static_assert(detail::atomic_bits<T>, "Atomic '&=' needs an integer");
                    return self.cell.and_with(value, 4);
                }

                operator(|=) function(self&, const T&: value) -> T {
                    static_assert(detail::atomic_bits<T>, "Atomic '|=' needs an integer");
                    return self.cell.or_with(value, 4);
                }

                operator(^=) function(self&, const T&: value) -> T {
                    static_assert(detail::atomic_bits<T>, "Atomic '^=' needs an integer");
                    return self.cell.xor_with(value, 4);
                }
            } end class Atomic

            class AtomicFlag {
                Atomic<bool>: flag;

            public:
                constructor() : flag(false) { }

                constructor(const AtomicFlag&: other) = delete;

                function test_and_set(self&, MemoryOrder: order = MemoryOrder::seq_cst) -> bool {
                    return self.flag.exchange(true, order);
                } end function test_and_set

                function clear(self&, MemoryOrder: order = MemoryOrder::seq_cst) -> void {
                    self.flag.store(false, order);
                } end function clear

                function test(const self&, MemoryOrder: order = MemoryOrder::seq_cst) -> bool {
                    return self.flag.load(order);
                } end function test

                function wait(const self&, bool: old, MemoryOrder: order = MemoryOrder::seq_cst) -> void {
                    self.flag.wait(old, order);
                } end function wait

                function notify_one(const self&) -> void {
                    self.flag.notify_one();
                } end function notify_one

                function notify_all(const self&) -> void {
                    self.flag.notify_all();
                } end function notify_all
            } end class AtomicFlag
        } end safe
    } end namespace threading
} end namespace std
