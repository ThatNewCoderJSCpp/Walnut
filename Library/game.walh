import module.colors
import module.windows
import module.graphics
import module.input
import module.time

safe(compile) {
    namespace std {
        namespace errors {
            class game_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class game_error
        } end namespace errors

        namespace game {
            using std::colors::Color;
            using std::windows::Window;
            using std::windows::WindowEvent;
            using std::graphics::Renderer;
            using std::graphics::Backend;
            using std::graphics::Texture;
            using std::graphics::Sprite;
            using std::graphics::Paint;
            using std::graphics::Path;
            using std::graphics::Camera;
            using std::graphics::Filter;
            using std::graphics::Wrap;
            using std::images::Image;
            using std::typography::TextStyle;

            extern "C++" from "<walnut_game.hpp>" {
                class Assets as "walnut_rt::gfx::assets" {
                    function native_load_image(self&, const string&: name) -> Image as "load_image";
                    function native_load_texture(self&, const string&: name, long int: filter, long int: wrap) -> Texture as "load_texture";
                    function native_text_ok(self&, const string&: name) -> bool as "text_ok";
                    function native_text(self&, const string&: name) -> string as "text";
                    function native_add_root(self&, const string&: folder, bool: first) -> void as "add_root";
                    function native_stat(const self&, long int: which) -> long int as "stat";

                public:
                    constructor();

                    function add_folder(self&, const string&: folder, bool: search_first = false) -> void {
                        self.native_add_root(folder, search_first);
                    } end function add_folder

                    function clear_folders(self&) -> void as "clear_roots";

                    function image(self&, const string&: name) -> Image {
                        Image: img = self.native_load_image(name);
                        if (img.is_empty()) then {
                            throw std::errors::image_error(static_cast<string>(`can't load the image '${name}': ${self.last_error()}`));
                        }
                        return img;
                    } end function image

                    function texture(self&, const string&: name, Filter: filter = Filter::nearest, Wrap: wrap = Wrap::clamp) -> Texture {
                        Texture: t = self.native_load_texture(name, static_cast<long int>(filter), static_cast<long int>(wrap));
                        if (!t.valid()) then {
                            throw std::errors::image_error(static_cast<string>(`can't load the texture '${name}': ${self.last_error()}`));
                        }
                        return t;
                    } end function texture

                    function read_text(self&, const string&: name) -> string {
                        if (!self.native_text_ok(name)) then {
                            throw std::errors::game_error(static_cast<string>(`can't read the text file '${name}': ${self.last_error()}`));
                        }
                        return self.native_text(name);
                    } end function read_text

                    function loaded(const self&, const string&: name) -> bool;
                    function unload(self&, const string&: name) -> bool;
                    function collect(self&) -> long int;
                    function clear(self&) -> void;
                    function last_error(const self&) -> string;
                    function enable_hot_reload(self&) -> void;
                    function disable_hot_reload(self&) -> void;
                    function check_reloads(self&) -> long int;

                    function image_count(const self&) -> long int {
                        return self.native_stat(0);
                    } end function image_count

                    function text_count(const self&) -> long int {
                        return self.native_stat(1);
                    } end function text_count

                    function image_bytes(const self&) -> long int {
                        return self.native_stat(2);
                    } end function image_bytes

                    function reload_count(const self&) -> long int {
                        return self.native_stat(3);
                    } end function reload_count
                } end class Assets

                class Node as "walnut_rt::gfx::scene_node" {
                    function native_add_shape(self&, long int: kind, float: w, float: h, float: r, const Paint&: p, const string&: name) -> Node as "add_shape";
                    function native_add_group(self&, const string&: name) -> Node as "add_group";
                    function native_add_sprite(self&, const Texture&: t, const string&: name) -> Node as "add_sprite";
                    function native_add_path(self&, const Path&: p, const Paint&: paint, const string&: name) -> Node as "add_path";
                    function native_add_text(self&, const string&: s, const TextStyle&: style, const string&: name) -> Node as "add_text";
                    function native_get_text(const self&) -> string as "get_text";

                    function checked(const self&) -> void {
                        if (!self.valid()) then {
                            throw std::errors::game_error("this scene node was removed");
                        }
                    } end function checked

                public:
                    constructor();

                    function valid(const self&) -> bool;

                    function add_group(self&, const string&: name = "") -> Node {
                        self.checked();
                        return self.native_add_group(name);
                    } end function add_group

                    function add_sprite(self&, const Texture&: texture, const string&: name = "") -> Node {
                        self.checked();
                        return self.native_add_sprite(texture, name);
                    } end function add_sprite

                    function add_rect(self&, float: w, float: h, const Paint&: paint, const string&: name = "") -> Node {
                        self.checked();
                        return self.native_add_shape(0, w, h, 0.0, paint, name);
                    } end function add_rect

                    function add_rounded_rect(self&, float: w, float: h, float: radius, const Paint&: paint, const string&: name = "") -> Node {
                        self.checked();
                        return self.native_add_shape(1, w, h, radius, paint, name);
                    } end function add_rounded_rect

                    function add_ellipse(self&, float: w, float: h, const Paint&: paint, const string&: name = "") -> Node {
                        self.checked();
                        return self.native_add_shape(2, w, h, 0.0, paint, name);
                    } end function add_ellipse

                    function add_path(self&, const Path&: path, const Paint&: paint, const string&: name = "") -> Node {
                        self.checked();
                        return self.native_add_path(path, paint, name);
                    } end function add_path

                    function add_text(self&, const string&: s, const TextStyle&: style, const string&: name = "") -> Node {
                        self.checked();
                        return self.native_add_text(s, style, name);
                    } end function add_text

                    function name(const self&) -> string;
                    function set_name(self&, const string&: n) -> void;
                    function x(const self&) -> float;
                    function y(const self&) -> float;
                    function set_position(self&, float: x, float: y) -> void;
                    function move(self&, float: dx, float: dy) -> void;
                    function rotation(const self&) -> float;
                    function set_rotation(self&, float: degrees) -> void;
                    function rotate(self&, float: degrees) -> void;
                    function scale_x(const self&) -> float;
                    function scale_y(const self&) -> float;
                    function set_scale(self&, float: sx, float: sy) -> void;
                    function set_origin(self&, float: ox, float: oy) -> void;
                    function z_order(const self&) -> long int;
                    function set_z_order(self&, long int: z) -> void;
                    function visible(const self&) -> bool;
                    function set_visible(self&, bool: on) -> void;
                    function active(const self&) -> bool;
                    function set_active(self&, bool: on) -> void;
                    function opacity(const self&) -> float;
                    function set_opacity(self&, float: opacity) -> void;
                    function world_x(const self&) -> float;
                    function world_y(const self&) -> float;
                    function world_rotation(const self&) -> float;
                    function hit(const self&, float: wx, float: wy) -> bool;
                    function child_count(const self&) -> long int;
                    function child(const self&, long int: index) -> Node;
                    function parent(const self&) -> Node;
                    function find(const self&, const string&: name) -> Node;
                    function reparent(self&, const Node&: new_parent) -> bool;
                    function remove(self&) -> void;
                    function sprite(const self&) -> Sprite as "get_sprite";
                    function set_sprite(self&, const Sprite&: s) -> void;
                    function set_paint(self&, const Paint&: p) -> void;
                    function set_size(self&, float: w, float: h) -> void;
                    function set_text(self&, const string&: s) -> void;
                    function set_style(self&, const TextStyle&: style) -> void;

                    function set_scale(self&, float: s) -> void {
                        self.set_scale(s, s);
                    } end function set_scale

                    function text_value(const self&) -> string {
                        return self.native_get_text();
                    } end function text_value
                } end class Node

                class Scene as "walnut_rt::gfx::scene" {
                    function native_draw_camera(self&, Renderer&: r, float: x, float: y, float: zoom, float: rotation) -> void as "draw_camera";

                public:
                    constructor();

                    function root(const self&) -> Node;
                    function update(self&, float: dt) -> void;
                    function draw(self&, Renderer&: renderer) -> void;
                    function pick(self&, float: x, float: y) -> Node;

                    function draw(self&, Renderer&: renderer, const Camera&: camera) -> void {
                        self.native_draw_camera(renderer, camera.x, camera.y, camera.zoom, camera.rotation);
                    } end function draw
                } end class Scene
            } end extern

            class Game {
            public:
                Window: window;
                Renderer: renderer;
                Color: clear_color = Color(0, 0, 0);
                bool: auto_clear = true;
                float: max_fps = 0.0;

            private:
                bool: running = false;
                float: delta = 0.0;
                float: current_fps = 0.0;
                float: average_fps = 0.0;
                float: total_seconds = 0.0;
                long int: frames = 0;

                function start_frame(self&, std::time::Instant&: last) -> void {
                    const std::time::Instant: now = std::time::Instant::now();
                    self.delta = (now - last).as_seconds();
                    last = now;
                    if (self.delta > 0.25) then {
                        self.delta = 0.25;
                    }
                    self.total_seconds = self.total_seconds + self.delta;
                    if (self.delta > 0.0) then {
                        self.current_fps = 1.0 / self.delta;
                        self.average_fps = self.average_fps == 0.0 ? self.current_fps : self.average_fps * 0.95 + self.current_fps * 0.05;
                    }
                } end function start_frame

                function finish_frame(self&, const std::time::Instant&: frame_start) -> void {
                    self.frames = self.frames + 1;
                    if (self.max_fps > 0.0) then {
                        const float: budget = 1.0 / self.max_fps;
                        const float: used = frame_start.elapsed().as_seconds();
                        if (used < budget) then {
                            std::time::sleep(std::time::Duration(static_cast<long int>((budget - used) * 1000000000.0)));
                        }
                    }
                } end function finish_frame

            public:
                constructor(const string&: title, long int: width, long int: height, Backend: backend = Backend::best, bool: vsync = false) : window = Window::open(title, width, height), renderer = Renderer::make(self.window, backend, vsync) { }

                function quit(self&) -> void {
                    self.running = false;
                } end function quit

                function is_running(const self&) -> bool {
                    return self.running && self.window.is_open();
                } end function is_running

                function delta_seconds(const self&) -> float {
                    return self.delta;
                } end function delta_seconds

                function fps(const self&) -> float {
                    return self.current_fps;
                } end function fps

                function fps_average(const self&) -> float {
                    return self.average_fps;
                } end function fps_average

                function elapsed_seconds(const self&) -> float {
                    return self.total_seconds;
                } end function elapsed_seconds

                function frame_count(const self&) -> long int {
                    return self.frames;
                } end function frame_count

                function width(const self&) -> long int {
                    return self.window.width();
                } end function width

                function height(const self&) -> long int {
                    return self.window.height();
                } end function height

                template <typename Update, typename Draw, typename OnEvent>
                function run(self&, Update: update, Draw: draw, OnEvent: on_event) -> void {
                    self.running = true;
                    std::time::Instant: last = std::time::Instant::now();
                    while (self.running && self.window.poll()) {
                        const std::time::Instant: frame_start = std::time::Instant::now();
                        WindowEvent: e;
                        while (self.window.next_event(e)) {
                            on_event(e);
                        }
                        if (!self.running || !self.window.is_open()) then {
                            break;
                        }
                        self.start_frame(last);
                        update(self.delta);
                        if (!self.running) then {
                            break;
                        }
                        self.renderer.begin_frame();
                        if (self.auto_clear) then {
                            self.renderer.clear(self.clear_color);
                        }
                        draw(self.renderer);
                        self.renderer.present();
                        self.finish_frame(frame_start);
                    }
                    self.running = false;
                } end function run

                template <typename Update, typename Draw>
                function run(self&, Update: update, Draw: draw) -> void {
                    self.run(update, draw, [](const WindowEvent&: e) -> void { });
                } end function run
            } end class Game
        } end namespace game
    } end namespace std
} end safe
