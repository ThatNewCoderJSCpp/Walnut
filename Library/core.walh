namespace std {
    template <typename T, T V>
    struct value_constant {
        static constexpr T: value = V;
        using value_type = T;

        constexpr operator(T) function() const {
            return V;
        }

        constexpr operator(()) function() const -> T {
            return V;
        }
    } end struct value_constant

    template <bool V>
    struct bool_constant {
        static constexpr bool: value = V;
        using value_type = bool;

        constexpr operator(bool) function() const {
            return V;
        }

        constexpr operator(()) function() const -> bool {
            return V;
        }
    } end struct bool_constant

    template <typename T, T V>
        requires std::traits::is_integer<T>
    struct integer_constant {
        static constexpr T: value = V;
        using value_type = T;

        constexpr operator(T) function() const {
            return V;
        }

        constexpr operator(()) function() const -> T {
            return V;
        }
    } end struct integer_constant

    template <typename T, T V>
        requires std::traits::is_floating<T>
    struct float_constant {
        static constexpr T: value = V;
        using value_type = T;

        constexpr operator(T) function() const {
            return V;
        }

        constexpr operator(()) function() const -> T {
            return V;
        }
    } end struct float_constant

    template <char V>
    struct char_constant {
        static constexpr char: value = V;
        using value_type = char;

        constexpr operator(char) function() const {
            return V;
        }

        constexpr operator(()) function() const -> char {
            return V;
        }
    } end struct char_constant

    template <string V>
    struct string_constant {
        static constexpr string: value = V;
        using value_type = string;

        constexpr operator(string) function() const {
            return V;
        }

        constexpr operator(()) function() const -> string {
            return V;
        }
    } end struct string_constant

    template <text V>
    struct text_constant {
        static constexpr text: value = V;
        using value_type = text;

        constexpr operator(text) function() const {
            return V;
        }

        constexpr operator(()) function() const -> text {
            return V;
        }
    } end struct text_constant

    using true_type = bool_constant<true>;
    using false_type = bool_constant<false>;

    template <bool Condition, typename T = void>
    struct enable_if {
    } end struct enable_if

    template <typename T>
    struct enable_if<true, T> {
        using type = T;
    } end struct enable_if

    template <bool Condition, typename T = void>
    using enable_if_t = enable_if<Condition, T>::type;

    template <typename T>
    using Predicate = function(const T&) -> bool;

    template <typename T>
    using Compare = function(const T&, const T&) -> bool;

    template <typename T>
    using Action = function(T&) -> void;

    template <typename T, typename U>
    using Transform = function(const T&) -> U;

    template <typename U, typename T>
    using Combine = function(const U&, const T&) -> U;

    template <typename T>
    using Supplier = function() -> T;

    template <typename T>
    function less_than(const T&: a, const T&: b) -> bool {
        return a < b;
    } end function less_than

    template <typename T>
    function leq(const T&: a, const T&: b) -> bool {
        return !(b < a);
    } end function leq

    template <typename T>
    function greater_than(const T&: a, const T&: b) -> bool {
        return b < a;
    } end function greater_than

    template <typename T>
    function geq(const T&: a, const T&: b) -> bool {
        return !(a < b);
    } end function geq

    template <typename T>
    function equal(const T&: a, const T&: b) -> bool {
        return a == b;
    } end function equal

    template <typename T>
    function not_equal(const T&: a, const T&: b) -> bool {
        return !(a == b);
    } end function not_equal

    template <typename T, typename K>
    function by(std::Transform<T, K>: key) -> std::Compare<T> {
        return [key](const T&: a, const T&: b) -> bool { return key(a) < key(b); };
    } end function by

    template <typename T>
    function reverse_order(std::Compare<T>: less) -> std::Compare<T> {
        return [less](const T&: a, const T&: b) -> bool { return less(b, a); };
    } end function reverse_order

    template <typename T>
    function negate(std::Predicate<T>: test) -> std::Predicate<T> {
        return [test](const T&: value) -> bool { return !test(value); };
    } end function negate

