        namespace detail {
            extern "C++" from "<walnut_limits.hpp>" {
                template <typename T>
                class FloatLimits as "walnut_rt::num::tag" {
                public:
                    static function epsilon() -> T as "walnut_rt::num::epsilon<T>";
                    static function smallest() -> T as "walnut_rt::num::smallest<T>";
                    static function largest() -> T as "walnut_rt::num::largest<T>";
                    static function lowest() -> T as "walnut_rt::num::lowest<T>";
                    static function subnormal_min() -> T as "walnut_rt::num::subnormal_min<T>";
                    static function infinity() -> T as "walnut_rt::num::infinity_of<T>";
                    static function nan() -> T as "walnut_rt::num::nan_of<T>";
                } end class FloatLimits
            } end extern
        } end namespace detail

        template <typename T>
        struct integer_traits {
            static_assert(__is_integer(T), "integer_traits is only for the built-in integer types; use float_traits for float types");
            using type = T;
            using unsigned_type = std::traits::make_unsigned<T>;
            using signed_type = std::traits::make_signed<T>;
            static constexpr int: bits = __integer_bits(T);
            static constexpr int: bytes = (__integer_bits(T) + 7) / 8;
            static constexpr int: rank = __integer_rank(T);
            static constexpr bool: is_signed = __is_signed(T);
            static constexpr int: digits = __is_signed(T) ? __integer_bits(T) - 1 : __integer_bits(T);
            static constexpr int: digits10 = digits * 30103 / 100000;
            static constexpr int: radix = 2;
            static constexpr bool: has_special_values = true;
            static constexpr T: max = __is_signed(T) ? static_cast<T>(~static_cast<std::traits::make_unsigned<T>>(0) >> 1) : static_cast<T>(~static_cast<std::traits::make_unsigned<T>>(0));
            static constexpr T: min = __is_signed(T) ? -max - 1 : static_cast<T>(0);
            static constexpr T: lowest = min;
            static constexpr T: zero = static_cast<T>(0);
            static constexpr T: one = static_cast<T>(1);
            static constexpr bool: is_integer = true;
            static constexpr bool: is_exact = true;
            static constexpr bool: is_bounded = true;
        } end struct integer_traits

        template <typename T>
        struct float_traits {
            static_assert(__is_float(T), "float_traits is only for the built-in float types; use integer_traits for integer types");
            using type = T;
            static constexpr int: bits = __float_bits(T);
            static constexpr int: bytes = __float_bits(T) / 8;
            static constexpr int: rank = __float_rank(T);
            static constexpr bool: is_signed = __is_signed(T);
            static constexpr int: mantissa_bits = __float_mantissa_bits(T);
            static constexpr int: exponent_bits = __float_exponent_bits(T);
            static constexpr int: digits = __float_mantissa_bits(T) + 1;
            static constexpr int: digits10 = (__float_mantissa_bits(T)) * 30103 / 100000;
            static constexpr int: max_digits10 = 2 + (__float_mantissa_bits(T) + 1) * 30103 / 100000;
            static constexpr int: radix = 2;
            static constexpr int: exponent_bias = (1 << (__float_exponent_bits(T) - 1)) - 1;
            static constexpr int: max_exponent = exponent_bias;
            static constexpr int: min_exponent = 1 - exponent_bias;
            static constexpr int: max_exponent10 = static_cast<int>(static_cast<long int>(max_exponent) * 30103 / 100000);
            static constexpr int: min_exponent10 = static_cast<int>(static_cast<long int>(min_exponent) * 30103 / 100000);
            static constexpr bool: has_infinity = true;
            static constexpr bool: has_nan = true;
            static constexpr bool: has_subnormals = true;
            static constexpr bool: has_special_values = true;
            static constexpr bool: is_integer = false;
            static constexpr bool: is_exact = false;
            static constexpr bool: is_bounded = true;

            static function epsilon() -> T {
                return detail::FloatLimits<T>::epsilon();
            } end function epsilon

            static function min() -> T {
                return detail::FloatLimits<T>::smallest();
            } end function min

            static function max() -> T {
                return detail::FloatLimits<T>::largest();
            } end function max

            static function lowest() -> T {
                return detail::FloatLimits<T>::lowest();
            } end function lowest

            static function subnormal_min() -> T {
                return detail::FloatLimits<T>::subnormal_min();
            } end function subnormal_min

            static function infinity() -> T {
                return detail::FloatLimits<T>::infinity();
            } end function infinity

            static function nan() -> T {
                return detail::FloatLimits<T>::nan();
            } end function nan

            static function round_error() -> T {
                return static_cast<T>(0.5);
            } end function round_error
        } end struct float_traits

        template <typename T, bool IsFloat = std::traits::is_float<T>>
        struct numeric_traits {
            static_assert(__is_integer(T), "numeric_traits is only for the built-in integer and float types");
            using type = T;
            static constexpr int: bits = integer_traits<T>::bits;
            static constexpr int: bytes = integer_traits<T>::bytes;
            static constexpr bool: is_signed = integer_traits<T>::is_signed;
            static constexpr bool: is_integer = true;
            static constexpr bool: is_exact = true;
            static constexpr bool: is_bounded = true;
            static constexpr int: radix = 2;
            static constexpr int: digits = integer_traits<T>::digits;
            static constexpr int: digits10 = integer_traits<T>::digits10;
            static constexpr int: max_digits10 = 0;
            static constexpr int: min_exponent = 0;
            static constexpr int: max_exponent = 0;
            static constexpr int: min_exponent10 = 0;
            static constexpr int: max_exponent10 = 0;
            static constexpr bool: has_infinity = true;
            static constexpr bool: has_nan = true;
            static constexpr bool: has_subnormals = false;
            static constexpr bool: has_special_values = true;

            static constexpr function max() -> T {
                return integer_traits<T>::max;
            } end function max

            static constexpr function min() -> T {
                return integer_traits<T>::min;
            } end function min

            static constexpr function lowest() -> T {
                return integer_traits<T>::lowest;
            } end function lowest

            static constexpr function epsilon() -> T {
                return static_cast<T>(0);
            } end function epsilon

            static constexpr function round_error() -> T {
                return static_cast<T>(0);
            } end function round_error

            static constexpr function subnormal_min() -> T {
                return static_cast<T>(0);
            } end function subnormal_min

            static constexpr function infinity() -> T {
                return inf;
            } end function infinity

            static constexpr function nan() -> T {
                return nan;
            } end function nan
        } end struct numeric_traits

        template <typename T>
        struct numeric_traits<T, true> {
            using type = T;
            static constexpr int: bits = float_traits<T>::bits;
            static constexpr int: bytes = float_traits<T>::bytes;
            static constexpr bool: is_signed = float_traits<T>::is_signed;
            static constexpr bool: is_integer = false;
            static constexpr bool: is_exact = false;
            static constexpr bool: is_bounded = true;
            static constexpr int: radix = 2;
            static constexpr int: digits = float_traits<T>::digits;
            static constexpr int: digits10 = float_traits<T>::digits10;
            static constexpr int: max_digits10 = float_traits<T>::max_digits10;
            static constexpr int: min_exponent = float_traits<T>::min_exponent;
            static constexpr int: max_exponent = float_traits<T>::max_exponent;
            static constexpr int: min_exponent10 = float_traits<T>::min_exponent10;
            static constexpr int: max_exponent10 = float_traits<T>::max_exponent10;
            static constexpr bool: has_infinity = true;
            static constexpr bool: has_nan = true;
            static constexpr bool: has_subnormals = true;
            static constexpr bool: has_special_values = true;

            static function max() -> T {
                return float_traits<T>::max();
            } end function max

            static function min() -> T {
                return float_traits<T>::min();
            } end function min

            static function lowest() -> T {
                return float_traits<T>::lowest();
            } end function lowest

            static function epsilon() -> T {
                return float_traits<T>::epsilon();
            } end function epsilon

            static function round_error() -> T {
                return float_traits<T>::round_error();
            } end function round_error

            static function subnormal_min() -> T {
                return float_traits<T>::subnormal_min();
            } end function subnormal_min

            static function infinity() -> T {
                return float_traits<T>::infinity();
            } end function infinity

            static function nan() -> T {
                return float_traits<T>::nan();
            } end function nan
        } end struct numeric_traits
    } end namespace traits

    namespace concepts {
        template <typename T, typename U>
        concept same_as = std::traits::is_same<T, U>

        template <typename From, typename To>
        concept convertible_to = std::traits::is_convertible<From, To>

        template <typename Derived, typename Base>
        concept derived_from = std::traits::is_base_of<Base, Derived>

        template <typename T>
        concept integer_type = std::traits::is_integer<T>

        template <typename T>
        concept signed_integer = std::traits::is_integer<T> && std::traits::is_signed<T>

        template <typename T>
        concept unsigned_integer = std::traits::is_integer<T> && std::traits::is_unsigned<T>

        template <typename T>
        concept floating_point = std::traits::is_floating<T>

        template <typename T>
        concept real_float = std::traits::is_float<T>

        template <typename T>
        concept number = std::traits::is_number<T>

        template <typename T>
        concept arithmetic = std::traits::is_arithmetic<T>

        template <typename T>
        concept bool_type = std::traits::is_bool<T>

        template <typename T>
        concept char_type = std::traits::is_char<T>

        template <typename T>
        concept string_like = std::traits::is_string<T>

        template <typename T>
        concept enumeration = std::traits::is_enum<T>

        template <typename T>
        concept class_type = std::traits::is_class<T>

        template <typename T>
        concept scalar = std::traits::is_scalar<T>

        template <typename T>
        concept pointer = std::traits::is_pointer<T>

        template <typename T>
        concept default_constructible = requires () { T(); }

        template <typename T>
        concept copy_constructible = requires (const T&: value) { T(value); }

        template <typename T>
        concept move_constructible = requires (T&&: value) { T(std::core::move(value)); }

        template <typename T>
        concept copy_assignable = requires (T&: target, const T&: value) { target = value; }

        template <typename T>
        concept move_assignable = requires (T&: target, T&&: value) { target = std::core::move(value); }

        template <typename T>
        concept copyable = copy_constructible<T> && copy_assignable<T>

        template <typename T>
        concept movable = move_constructible<T> && move_assignable<T>

        template <typename T>
        concept hashable = requires (const T&: value) { value.hash(); }

        template <typename T>
        concept equality_comparable = requires (T: a, T: b) { a == b; a != b; }

        template <typename T>
        concept totally_ordered = equality_comparable<T> && requires (T: a, T: b) { a < b; a > b; a <= b; a >= b; }

        template <typename T>
        concept has_to_string = requires (T: value) { value.to_string(); }

        template <typename C>
        concept iterable = requires (C: items) { items.begin(); items.end(); }

        template <typename I>
        concept iterator = requires (I: it, I: other) { *it; ++it; it != other; }

        template <typename I>
        concept random_access_iterator = iterator<I> && requires (I: it, I: other) { it + 1; it - 1; it - other; it[0]; }
    } end namespace concepts


    extern "C++" {
        template <typename T>
        class initializer_list as "walnut_rt::init_list" {
        public:
            constructor();
            constructor(T...: items);
            function size() const -> long int;
            function begin() const -> const T*;
            function end() const -> const T*;
            function at(long int: index) const -> const T&;

            function empty() const -> bool {
                return size() == 0;
            } end function empty

            function data() const -> const T* {
                return begin();
            } end function data

            operator([]) function(long int: index) const -> const T& {
                return at(index);
            }
        } end class initializer_list
    } end extern

    namespace core {
        template <typename T>
        constexpr function move(T&: value) noexcept -> T&& {
            return static_cast<T&&>(value);
        } end function move

        template <typename T>
        constexpr function move(T&&: value) noexcept -> T&& {
            return static_cast<T&&>(value);
        } end function move

        template <typename T>
        constexpr function forward(std::traits::discard_ref<T>&: value) noexcept -> T&& {
            return static_cast<T&&>(value);
        } end function forward

        template <typename T>
        constexpr function forward(std::traits::discard_ref<T>&&: value) noexcept -> T&& {
            return static_cast<T&&>(value);
        } end function forward

        template <typename T>
        requires std::traits::is_class<T> && std::concepts::has_to_string<T>
        function to_string(const T&: value) -> string {
            return static_cast<string>(value.to_string());
        } end function to_string

        template <typename T>
        requires !std::traits::is_class<T>
        function to_string(const T&: value) -> string {
            return static_cast<string>(`${value}`);
        } end function to_string

        namespace detail {
            template <typename T>
            constexpr bool: checkable_number = (std::traits::is_builtin_integer<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>) || std::traits::is_builtin_float<T>;

            template <typename T>
            constexpr bool: plain_integer = std::traits::is_builtin_integer<T> && !std::traits::is_bool<T> && !std::traits::is_char<T>;

            template <typename T>
            constexpr function special_value(T: x) -> bool {
                return x is inf || x is nan || x is undefined || x is indeterminate;
            } end function special_value

            template <typename T>
            constexpr function magnitude(T: x) -> T {
                if (x < static_cast<T>(0)) then {
                    return -x;
                }
                return x;
            } end function magnitude

            template <typename T, typename I>
            constexpr function float_whole_parity(T: x, bool: want_parity) -> int {
                const T: a = magnitude(x);
                if (a >= static_cast<T>(std::traits::integer_traits<I>::max)) then {
                    return want_parity ? 0 : 1;
                }
                const I: whole = static_cast<I>(a);
                if (static_cast<T>(whole) != a) then {
                    return -1;
                }
                if (!want_parity) then {
                    return 1;
                }
                return whole % static_cast<I>(2) == static_cast<I>(0) ? 0 : 1;
            } end function float_whole_parity

            template <typename T>
            constexpr function float_whole(T: x, bool: want_parity) -> int {
                if (special_value(x)) then {
                    return -1;
                }
                constexpr int: m = std::traits::float_traits<T>::mantissa_bits;
                if constexpr (m < 61) then {
                    return float_whole_parity<T, long int>(x, want_parity);
                } else if constexpr (m < 125) then {
                    return float_whole_parity<T, long long int>(x, want_parity);
                } else if constexpr (m < 253) then {
                    return float_whole_parity<T, short integer>(x, want_parity);
                } else if constexpr (m < 509) then {
                    return float_whole_parity<T, integer>(x, want_parity);
                } else if constexpr (m < 1021) then {
                    return float_whole_parity<T, long integer>(x, want_parity);
                } else then {
                    return float_whole_parity<T, long long integer>(x, want_parity);
                }
            } end function float_whole
        } end namespace detail

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_integer(T: x) -> bool {
            if constexpr (detail::plain_integer<T>) then {
                return !detail::special_value(x);
            } else then {
                return detail::float_whole(x, false) == 1;
            }
        } end function is_integer

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_even(T: x) -> bool {
            if constexpr (detail::plain_integer<T>) then {
                if (detail::special_value(x)) then {
                    return false;
                }
                return x % static_cast<T>(2) == static_cast<T>(0);
            } else then {
                return detail::float_whole(x, true) == 0;
            }
        } end function is_even

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_odd(T: x) -> bool {
            if constexpr (detail::plain_integer<T>) then {
                if (detail::special_value(x)) then {
                    return false;
                }
                return x % static_cast<T>(2) != static_cast<T>(0);
            } else then {
                return detail::float_whole(x, true) == 1;
            }
        } end function is_odd

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_zero(T: x) -> bool {
            return !detail::special_value(x) && x == static_cast<T>(0);
        } end function is_zero

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_nonzero(T: x) -> bool {
            return !detail::special_value(x) && x != static_cast<T>(0);
        } end function is_nonzero

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_positive(T: x) -> bool {
            if (x is nan || x is undefined || x is indeterminate) then {
                return false;
            }
            return x > static_cast<T>(0);
        } end function is_positive

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_negative(T: x) -> bool {
            if (x is nan || x is undefined || x is indeterminate) then {
                return false;
            }
            return x < static_cast<T>(0);
        } end function is_negative

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_nonnegative(T: x) -> bool {
            if (x is nan || x is undefined || x is indeterminate) then {
                return false;
            }
            return x >= static_cast<T>(0);
        } end function is_nonnegative

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_nonpositive(T: x) -> bool {
            if (x is nan || x is undefined || x is indeterminate) then {
                return false;
            }
            return x <= static_cast<T>(0);
        } end function is_nonpositive

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_finite(T: x) -> bool {
            return !detail::special_value(x);
        } end function is_finite

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_infinite(T: x) -> bool {
            return x is inf;
        } end function is_infinite

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_nan(T: x) -> bool {
            return x is nan;
        } end function is_nan

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_undefined(T: x) -> bool {
            return x is undefined;
        } end function is_undefined

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_indeterminate(T: x) -> bool {
            return x is indeterminate;
        } end function is_indeterminate

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_special(T: x) -> bool {
            return detail::special_value(x);
        } end function is_special

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_power_of_two(T: x) -> bool {
            if (detail::special_value(x) || !(x > static_cast<T>(0))) then {
                return false;
            }
            if constexpr (detail::plain_integer<T>) then {
                return (x & (x - static_cast<T>(1))) == static_cast<T>(0);
            } else then {
                T: v = x;
                while (v >= static_cast<T>(2)) {
                    v = v / static_cast<T>(2);
                }
                while (v < static_cast<T>(1)) {
                    v = v * static_cast<T>(2);
                }
                return v == static_cast<T>(1);
            }
        } end function is_power_of_two

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_multiple_of(T: x, T: n) -> bool {
            if (detail::special_value(x) || detail::special_value(n) || n == static_cast<T>(0)) then {
                return false;
            }
            if constexpr (detail::plain_integer<T>) then {
                return x % n == static_cast<T>(0);
            } else then {
                return detail::float_whole(x / n, false) == 1;
            }
        } end function is_multiple_of

        template <typename T>
        requires detail::checkable_number<T>
        constexpr function is_between(T: x, T: low, T: high) -> bool {
            if (x is nan || x is undefined || x is indeterminate) then {
                return false;
            }
            return low <= x && x <= high;
        } end function is_between

        template <typename T>
        requires std::traits::is_builtin_float<T>
        function is_normal(T: x) -> bool {
            if (detail::special_value(x) || x == static_cast<T>(0)) then {
                return false;
            }
            return detail::magnitude(x) >= std::traits::float_traits<T>::min();
        } end function is_normal

        template <typename T>
        requires std::traits::is_builtin_float<T>
        function is_subnormal(T: x) -> bool {
            if (detail::special_value(x) || x == static_cast<T>(0)) then {
                return false;
            }
            return detail::magnitude(x) < std::traits::float_traits<T>::min();
        } end function is_subnormal
    } end namespace core
} end namespace std
