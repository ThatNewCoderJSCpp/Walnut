                function send_all(self&, const string&: data) -> bool;
                function receive(self&, long int: max_bytes = 16384) -> string;
                function receive_all(self&) -> string;
                function close(self&) -> void;
            } end class TlsStream

            class Url as "walnut_rt::net::url" {
            public:
                constructor();
                static function parse(const string&: input) -> Url as "walnut_rt::net::url::parse";
                static function parse_relative(const string&: input, const string&: base) -> Url as "walnut_rt::net::url::parse_relative";
                static function can_parse(const string&: input) -> bool as "walnut_rt::net::url::can_parse";
                static function default_port(const string&: scheme) -> long int as "walnut_rt::net::url::default_port";
                function href(const self&) -> string;
                function origin(const self&) -> string;
                function scheme(const self&) -> string;
                function username(const self&) -> string;
                function password(const self&) -> string;
                function host(const self&) -> string;
                function hostname(const self&) -> string;
                function port(const self&) -> long int;
                function path(const self&) -> string;
                function query(const self&) -> string;
                function fragment(const self&) -> string;
                function path_and_query(const self&) -> string;
                function secure(const self&) -> bool;
                function param(const self&, const string&: name) -> string;
                function has_param(const self&, const string&: name) -> bool;
                function params(const self&, const string&: name) -> std::collections::Vector<string>;
                function param_names(const self&) -> std::collections::Vector<string>;
                function with_scheme(const self&, const string&: value) -> Url;
                function with_host(const self&, const string&: value) -> Url;
                function with_port(const self&, long int: value) -> Url;
                function with_path(const self&, const string&: value) -> Url;
                function with_query(const self&, const string&: value) -> Url;
                function with_fragment(const self&, const string&: value) -> Url;
                function with_param(const self&, const string&: name, const string&: value) -> Url;
                function without_param(const self&, const string&: name) -> Url;

                function to_string(const self&) -> string {
                    return self.href();
                } end function to_string
            } end class Url

            class Headers as "walnut_rt::net::headers" {
            public:
                constructor();
                function set(self&, const string&: name, const string&: value) -> void;
                function add(self&, const string&: name, const string&: value) -> void;
                function get(const self&, const string&: name) -> string;
                function has(const self&, const string&: name) -> bool;
                function remove(self&, const string&: name) -> bool;
