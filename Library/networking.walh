                function listen(const string&: host, long int: port) -> void;
                function broadcast(const string&: input) -> long int;
                function client_count() const -> long int;
                function port() const -> long int;
                function serve() -> void;
                function serve_for(long int: milliseconds) -> void;
                function close() -> void;
            } end class WebSocketServer

            class Timer as "walnut_rt::net::timer" {
            public:
                constructor();
                function cancel() -> void;
                function active() const -> bool;
            } end class Timer

            class Native as "walnut_rt::net::api" {
            public:
                static function resolve(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve";
                static function resolve4(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve4";
                static function resolve6(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve6";
                static function reverse_lookup(const string&: ip) -> std::collections::Vector<string> as "walnut_rt::net::reverse_lookup";
                static function is_ipv4(const string&: input) -> bool as "walnut_rt::net::is_ipv4";
                static function is_ipv6(const string&: input) -> bool as "walnut_rt::net::is_ipv6";
                static function fetch(const string&: method, const string&: url, const string&: body, const Headers&: headers, long int: timeout_ms, bool: follow, bool: verify) -> Response as "walnut_rt::net::fetch";
                static function fetch_async(const string&: method, const string&: url, const string&: body, const Headers&: headers, long int: timeout_ms, bool: follow, bool: verify, function(Response) -> void: callback) -> void as "walnut_rt::net::fetch_async";
                static function set_timeout(long int: ms, function() -> void: callback) -> Timer as "walnut_rt::net::set_timeout";
                static function set_interval(long int: ms, function() -> void: callback) -> Timer as "walnut_rt::net::set_interval";
                static function next_tick(function() -> void: callback) -> void as "walnut_rt::net::next_tick";
                static function run() -> long int as "walnut_rt::net::run";
                static function run_once() -> long int as "walnut_rt::net::run_once";
                static function poll() -> long int as "walnut_rt::net::poll";
                static function run_for(long int: ms) -> long int as "walnut_rt::net::run_for";
                static function stop() -> void as "walnut_rt::net::stop";
                static function status_text(long int: code) -> string as "walnut_rt::net::status_text";
                static function url_encode(const string&: input) -> string as "walnut_rt::net::url_encode";
                static function url_decode(const string&: input) -> string as "walnut_rt::net::url_decode";
            } end class Native
        } end extern

        namespace guard {
            extern "C++" from "<walnut_net.hpp>" {
                class LoginCheck as "walnut_rt::net::login_check" {
                public:
                    constructor();
                    function allowed() const -> bool;
                    function status() const -> long int;
                    function retry_after_ms() const -> long int;
                    function delay_ms() const -> long int;
                    function reason() const -> string;
                } end class LoginCheck

                class LogFields as "walnut_rt::guard::log_fields" {
                public:
                    constructor();
                    function add(const string&: key, const string&: value) -> LogFields&;
                    function add_int(const string&: key, long int: value) -> LogFields&;
                    function add_float(const string&: key, short float: value) -> LogFields&;
                    function add_bool(const string&: key, bool: value) -> LogFields&;
                    function size() const -> long int;
                } end class LogFields

                class Logger as "walnut_rt::guard::logger" {
                public:
                    constructor();
                    constructor(const string&: level);
                    function to_stderr() -> void;
                    function to_stdout() -> void;
                    function to_file(const string&: path, long int: max_bytes = 10485760, long int: files = 5) -> void;
                    function as_text(bool: enabled = true) -> void;
                    function set_level(const string&: level) -> void;
                    function redact(const string&: key) -> void;
                    function trace(const string&: message) -> void;
                    function debug(const string&: message) -> void;
                    function info(const string&: message) -> void;
                    function warn(const string&: message) -> void;
                    function error(const string&: message) -> void;
                    function info_with(const string&: message, const LogFields&: fields) -> void;
                    function warn_with(const string&: message, const LogFields&: fields) -> void;
                    function error_with(const string&: message, const LogFields&: fields) -> void;
                    function flush() -> void;
                    static function new_request_id() -> string as "walnut_rt::guard::logger::new_request_id";
                } end class Logger


                class Guard as "walnut_rt::net::guard" {
                public:
                    constructor();
                    function rate_limit(short float: per_second, short float: burst) -> void;
                    function no_rate_limit() -> void;
                    function route_limit(const string&: method, const string&: path_prefix, short float: per_minute, short float: burst) -> void;
                    function trust_proxy(bool: on) -> void;
                    function trusted_proxy(const string&: ip) -> void;
                    function block_bots(bool: on) -> void;
                    function track_failures(bool: on) -> void;
                    function access_log(bool: on) -> void;
                    function security_headers(bool: on) -> void;
                    function content_security_policy(const string&: policy) -> void;
                    function hsts(const string&: value) -> void;
                    function no_store(bool: on) -> void;
                    function allowed_origin(const string&: origin) -> void;
                    function max_body(long int: bytes) -> void;
                    function session_timeouts(long int: idle_minutes, long int: absolute_hours) -> void;
                    function cookie_same_site(const string&: mode) -> void;
                    function secure_cookies(bool: on) -> void;
                    function use_logger(const Logger&: log) -> void;
                    function block_fingerprint(const string&: ja4, const string&: label = "") -> void;
                    function trust_fingerprint(const string&: ja4, const string&: label = "") -> void;

                    function authenticated(const Request&: req) const -> bool;
                    function user(const Request&: req) const -> string;
                    function has_role(const Request&: req, const string&: role) const -> bool;
                    function session_id(const Request&: req) const -> string;
                    function csrf_token(const Request&: req) const -> string;
                    function csrf_ok(const Request&: req) const -> bool;
                    function same_origin(const Request&: req) const -> bool;
                    function check_login(const Request&: req, const string&: account) const -> LoginCheck;
                    function login_failed(const Request&: req, const string&: account) const -> void;
                    function login(const Request&: req, const string&: user_id, const std::collections::Vector<string>&: roles) const -> string;
                    function login_user(const Request&: req, const string&: user_id) const -> string;
                    function new_device(const Request&: req) const -> bool;
                    function trust_device(const Request&: req, const string&: label = "") const -> bool;
                    function logout(const Request&: req, bool: everywhere = false, bool: keep_device = false) const -> void;
                    function revoke_sessions(const string&: user_id) const -> long int;
                    function session_count(const string&: user_id) const -> long int;
                    function register_owner(const string&: type, function(string) -> string: lookup) -> void;
                    function admin_role(const string&: role) -> void;
                    function can(const Request&: req, const string&: type, const string&: id, const string&: action = "read") const -> bool;
                    function idempotent(const Request&: req, function() -> Response: body) const -> Response;
                    function set_budget(const string&: metric, short float: limit, long int: period_seconds = 86400, short float: warn_ratio = 0.8, bool: hard_stop = false) -> void;
                    function budget_level(const string&: metric) const -> string;
                    function on_budget_alert(function(string, string, short float, short float) -> void: callback) -> void;
                    function on_new_error(function(string, string, string, long int) -> void: callback) -> void;
                    function error_groups() const -> long int;
                    function errors_json() const -> string;
                    function start_maintenance() -> void;
                    function stop_maintenance() -> void;
                    function sweep() -> void;
                } end class Guard

                class RateDecision as "walnut_rt::guard::rate_decision" {
                public:
                    constructor();
                    function allowed() const -> bool;
                    function remaining() const -> short float;
                    function limit() const -> short float;
                    function retry_after_ms() const -> long int;
                    function reset_after_ms() const -> long int;
                } end class RateDecision

                class RateLimiter as "walnut_rt::guard::rate_limiter" {
                public:
                    constructor();
                    constructor(short float: per_second, short float: burst, short float: start_tokens = -1.0);
                    constructor(float: per_second, float: burst) as "walnut_rt::guard::rate_limiter::from_wide";
                    constructor(float: per_second, float: burst, float: start_tokens) as "walnut_rt::guard::rate_limiter::from_wide_start";
                    static function per_minute(short float: per_minute, short float: burst) -> RateLimiter as "walnut_rt::guard::rate_limiter::per_minute";
                    static function per_hour(short float: per_hour, short float: burst) -> RateLimiter as "walnut_rt::guard::rate_limiter::per_hour";
                    function consume(const string&: key, short float: cost = 1.0) -> RateDecision;
                    function peek(const string&: key, short float: cost = 1.0) const -> RateDecision;
                    function allow(const string&: key) -> bool;
                    function refund(const string&: key, short float: amount = 1.0) -> void;
                    function reset(const string&: key) -> void;
                    function size() const -> long int;
                    function sweep() -> long int;
                } end class RateLimiter

