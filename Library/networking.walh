import module.collections

safe(compile) {
namespace std {
    namespace errors {
        class network_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what(const self&) -> string {
                return self.message;
            } end function what
        } end class network_error
    } end namespace errors

    namespace networking {
        extern "C++" from "<walnut_net.hpp>" {
            class TcpStream as "walnut_rt::net::tcp_stream" {
            public:
                constructor();
                static function connect(const string&: host, long int: port, long int: timeout_ms = 10000) -> TcpStream as "walnut_rt::net::tcp_stream::connect";
                function is_open(const self&) -> bool;
                function send(self&, const string&: data) -> long int;
                function send_all(self&, const string&: data) -> bool;
                function receive(self&, long int: max_bytes = 65536) -> string;
                function receive_exact(self&, long int: count) -> string;
                function read_line(self&) -> string;
                function receive_all(self&) -> string;
                function set_timeout(self&, long int: milliseconds) -> void;
                function close(self&) -> void;
                function local_address(const self&) -> string;
                function remote_address(const self&) -> string;
                function last_error(const self&) -> string;

                function write_line(self&, const string&: line) -> bool {
                    return self.send_all(line + "\n");
                } end function write_line
            } end class TcpStream

            class TcpListener as "walnut_rt::net::tcp_listener" {
            public:
                constructor();
                static function bind(const string&: host, long int: port, long int: backlog = 16) -> TcpListener as "walnut_rt::net::tcp_listener::bind";
                function accept(self&) -> TcpStream;
                function port(const self&) -> long int;
                function local_address(const self&) -> string;
                function is_open(const self&) -> bool;
                function close(self&) -> void;
            } end class TcpListener

