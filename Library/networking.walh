import module.collections

namespace std {
    namespace errors {
        class network_error {
        public:
            string: message;

            constructor(const string&: m) : message = m { }

            function what() const -> string {
                return message;
            } end function what
        } end class network_error
    } end namespace errors

    namespace networking {
        extern "C++" from "<walnut_net.hpp>" {
            class TcpStream as "walnut_rt::net::tcp_stream" {
            public:
                constructor();
                static function connect(const string&: host, long int: port, long int: timeout_ms = 10000) -> TcpStream as "walnut_rt::net::tcp_stream::connect";
                function is_open() const -> bool;
                function send(const string&: data) -> long int;
                function send_all(const string&: data) -> bool;
                function receive(long int: max_bytes = 65536) -> string;
                function receive_exact(long int: count) -> string;
                function read_line() -> string;
                function receive_all() -> string;
                function set_timeout(long int: milliseconds) -> void;
                function close() -> void;
                function local_address() const -> string;
                function remote_address() const -> string;
                function last_error() const -> string;

                function write_line(const string&: line) -> bool {
                    return send_all(line + "\n");
                } end function write_line
            } end class TcpStream

            class TcpListener as "walnut_rt::net::tcp_listener" {
            public:
                constructor();
                static function bind(const string&: host, long int: port, long int: backlog = 16) -> TcpListener as "walnut_rt::net::tcp_listener::bind";
                function accept() -> TcpStream;
                function port() const -> long int;
                function local_address() const -> string;
                function is_open() const -> bool;
                function close() -> void;
            } end class TcpListener

            class Datagram as "walnut_rt::net::datagram" {
            public:
                constructor();
                function data() const -> string;
                function host() const -> string;
                function port() const -> long int;
                function empty() const -> bool;
            } end class Datagram

            class UdpSocket as "walnut_rt::net::udp_socket" {
            public:
                constructor();
                static function bind(const string&: host, long int: port) -> UdpSocket as "walnut_rt::net::udp_socket::bind";
                function send_to(const string&: host, long int: port, const string&: data) -> long int;
                function receive_from(long int: max_bytes = 65507) -> Datagram;
                function broadcast(long int: port, const string&: data) -> long int;
                function set_timeout(long int: milliseconds) -> void;
                function port() const -> long int;
                function local_address() const -> string;
                function close() -> void;
            } end class UdpSocket

            class TlsStream as "walnut_rt::net::tls_stream" {
            public:
                constructor();
                static function connect(const string&: host, long int: port, bool: verify = true, long int: timeout_ms = 10000) -> TlsStream as "walnut_rt::net::tls_stream::connect";
                function is_open() const -> bool;
                function send_all(const string&: data) -> bool;
                function receive(long int: max_bytes = 16384) -> string;
                function receive_all() -> string;
                function close() -> void;
            } end class TlsStream

            class Url as "walnut_rt::net::url" {
            public:
                constructor();
                static function parse(const string&: input) -> Url as "walnut_rt::net::url::parse";
                static function parse_relative(const string&: input, const string&: base) -> Url as "walnut_rt::net::url::parse_relative";
                static function can_parse(const string&: input) -> bool as "walnut_rt::net::url::can_parse";
                static function default_port(const string&: scheme) -> long int as "walnut_rt::net::url::default_port";
                function href() const -> string;
                function origin() const -> string;
                function scheme() const -> string;
                function username() const -> string;
                function password() const -> string;
                function host() const -> string;
                function hostname() const -> string;
                function port() const -> long int;
                function path() const -> string;
                function query() const -> string;
                function fragment() const -> string;
                function path_and_query() const -> string;
                function secure() const -> bool;
                function param(const string&: name) const -> string;
                function has_param(const string&: name) const -> bool;
                function params(const string&: name) const -> std::collections::Vector<string>;
                function param_names() const -> std::collections::Vector<string>;
                function with_scheme(const string&: value) const -> Url;
                function with_host(const string&: value) const -> Url;
                function with_port(long int: value) const -> Url;
                function with_path(const string&: value) const -> Url;
                function with_query(const string&: value) const -> Url;
                function with_fragment(const string&: value) const -> Url;
                function with_param(const string&: name, const string&: value) const -> Url;
                function without_param(const string&: name) const -> Url;

                function to_string() const -> string {
                    return href();
                } end function to_string
            } end class Url

            class Headers as "walnut_rt::net::headers" {
            public:
                constructor();
                function set(const string&: name, const string&: value) -> void;
                function add(const string&: name, const string&: value) -> void;
                function get(const string&: name) const -> string;
                function has(const string&: name) const -> bool;
                function remove(const string&: name) -> bool;
                function size() const -> long int;
                function names() const -> std::collections::Vector<string>;
            } end class Headers

            class Request as "walnut_rt::net::request" {
            public:
                constructor();
                function method() const -> string;
                function target() const -> string;
                function path() const -> string;
                function query() const -> string;
                function param(const string&: name) const -> string;
                function body() const -> string;
                function version() const -> string;
                function header(const string&: name) const -> string;
                function has_header(const string&: name) const -> bool;
                function header_names() const -> std::collections::Vector<string>;
                function request_id() const -> string;
                function client_ip() const -> string;
                function tls_fingerprint() const -> string;
                function risk() const -> string;
                function risk_score() const -> long int;
                function encrypted() const -> bool;
                function user() const -> string;
                function guarded() const -> bool;
            } end class Request

            class Response as "walnut_rt::net::response" {
            public:
                constructor();
                static function make(long int: status, const string&: body, const string&: content_type = "text/plain; charset=utf-8") -> Response as "walnut_rt::net::response::make";
                function status() const -> long int;
                function status_text() const -> string;
                function body() const -> string;
                function url() const -> string;
                function ok() const -> bool;
                function header(const string&: name) const -> string;
                function has_header(const string&: name) const -> bool;
                function header_names() const -> std::collections::Vector<string>;
                function error() const -> string;
                function failed() const -> bool;
                function set_status(long int: code) -> void;
                function set_body(const string&: input) -> void;
                function set_header(const string&: name, const string&: value) -> void;
                function add_header(const string&: name, const string&: value) -> void;

                static function plain(const string&: body, long int: status = 200) -> Response {
                    return Response::make(status, body, "text/plain; charset=utf-8");
                } end function plain

                static function html(const string&: body, long int: status = 200) -> Response {
                    return Response::make(status, body, "text/html; charset=utf-8");
                } end function html

                static function json(const string&: body, long int: status = 200) -> Response {
                    return Response::make(status, body, "application/json");
                } end function json

                static function not_found() -> Response {
                    return Response::make(404, "not found");
                } end function not_found

                static function redirect(const string&: location, long int: status = 302) -> Response {
                    Response: r = Response::make(status, "");
                    r.set_header("Location", location);
                    return r;
                } end function redirect
            } end class Response

            class Message as "walnut_rt::net::message" {
            public:
                constructor();
                function data() const -> string;
                function is_binary() const -> bool;
                function is_text() const -> bool;
                function ok() const -> bool;
            } end class Message

            class WebSocket as "walnut_rt::net::websocket" {
            public:
                constructor();
