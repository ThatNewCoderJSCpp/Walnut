                class JobQueue as "walnut_rt::guard::job_queue" {
                public:
                    constructor();
                    constructor(long int: workers);
                    function on(self&, const string&: name, function(Job) -> bool: handler) -> void;
                    function on_checked(self&, const string&: name, const JobSchema&: schema, function(Job) -> bool: handler) -> void;
                    function enqueue(self&, const string&: name, const string&: payload = "", long int: max_attempts = 5, long int: delay_ms = 0, const string&: unique_key = "") -> string;
                    function try_enqueue(self&, const string&: name, const string&: payload = "", long int: max_attempts = 5, long int: delay_ms = 0, const string&: unique_key = "") -> EnqueueResult;
                    function check(const self&, const string&: name, const string&: payload = "", long int: max_attempts = 5, long int: delay_ms = 0, const string&: unique_key = "") -> std::collections::Vector<string>;
                    function set_schema(self&, const string&: name, const JobSchema&: schema) -> void;
                    function remove_schema(self&, const string&: name) -> bool;
                    function has_schema(const self&, const string&: name) -> bool;
                    function limit_attempts(self&, long int: n) -> void;
                    function limit_queue(self&, long int: n) -> void;
                    function limit_dead_letters(self&, long int: n) -> void;
                    function limit_payload(self&, long int: bytes) -> void;
                    function limit_delay(self&, long int: ms) -> void;
                    function require_handlers(self&, bool: on) -> void;
                    function require_schemas(self&, bool: on) -> void;
                    function attempt_limit(const self&) -> long int;
                    function set_retry_delay(self&, long int: initial_ms, long int: max_ms) -> void;
                    function start(self&) -> void;
                    function stop(self&, bool: drain = false) -> void;
                    function running(const self&) -> bool;
                    function wait_idle(self&, long int: timeout_ms) -> bool;
                    function cancel(self&, const string&: id) -> bool;
                    function retry_dead(self&, const string&: id) -> bool;
                    function retry_all_dead(self&) -> long int;
                    function discard_dead(self&, const string&: id) -> bool;
                    function clear_dead(self&) -> long int;
                    function queued(const self&) -> long int;
                    function dead(const self&) -> long int;
                    function succeeded(const self&) -> long int;
                    function rejected(const self&) -> long int;
                    function dead_dropped(const self&) -> long int;
                    function errors_of(const self&, const string&: id) -> std::collections::Vector<string>;
                    function attempts_of(const self&, const string&: id) -> long int;
                    function dead_ids(const self&) -> std::collections::Vector<string>;
                    function state_of(const self&, const string&: id) -> string;
                } end class JobQueue

                class BudgetMonitor as "walnut_rt::guard::budget_monitor" {
                public:
                    constructor();
                    function set_budget(self&, const string&: metric, short float: limit, long int: period_seconds = 86400, short float: warn_ratio = 0.8, bool: hard_stop = false, const string&: unit = "") -> void;
                    function add(self&, const string&: metric, short float: amount = 1.0) -> string;
                    function allows(const self&, const string&: metric, short float: amount = 1.0) -> bool;
                    function consume(self&, const string&: metric, short float: amount = 1.0) -> bool;
                    function used(const self&, const string&: metric) -> short float;
                    function level(const self&, const string&: metric) -> string;
                    function reset(self&, const string&: metric) -> void;
                    function set_gauge_threshold(self&, const string&: metric, short float: warn, short float: critical) -> void;
                    function set_gauge(self&, const string&: metric, short float: value) -> string;
                    function on_alert(self&, function(string, string, short float, short float) -> void: callback) -> void;
                } end class BudgetMonitor

                class Debouncer as "walnut_rt::guard::debouncer" {
                public:
                    constructor();
                    constructor(function() -> void: callback, long int: wait_ms, bool: leading = false, bool: trailing = true, long int: max_wait_ms = 0);
                    function call(self&) -> void;
                    function cancel(self&) -> void;
                    function flush(self&) -> void;
                    function pending(const self&) -> bool;
                } end class Debouncer

                class Throttler as "walnut_rt::guard::throttler" {
                public:
                    constructor();
                    constructor(function() -> void: callback, long int: interval_ms, bool: trailing = true);
                    function call(self&) -> void;
                    function cancel(self&) -> void;
                    function pending(const self&) -> bool;
                } end class Throttler

                class KeyedLock as "walnut_rt::guard::keyed_lock" {
                public:
                    constructor();
                    function with(self&, const string&: key, function() -> void: body) -> void;
                    function locked(const self&, const string&: key) -> bool;
                } end class KeyedLock

                class SqlStatement as "walnut_rt::guard::sql_statement" {
                public:
                    constructor();
                    constructor(const string&: sql);
                    function bind_int(self&, long int: value) -> SqlStatement&;
                    function bind_float(self&, short float: value) -> SqlStatement&;
                    function bind_text(self&, const string&: value) -> SqlStatement&;
                    function bind_bool(self&, bool: value) -> SqlStatement&;
                    function bind_null(self&) -> SqlStatement&;
                    function append(self&, const string&: fragment) -> SqlStatement&;
                    function sql(const self&) -> string;
                    function placeholders(const self&) -> long int;
                    function bound(const self&) -> long int;
                    function complete(const self&) -> bool;
                    function shape(const self&) -> string;
                    function debug_string(const self&) -> string;
                    static function identifier(const string&: name) -> string as "walnut_rt::guard::sql_statement::identifier";
                    static function placeholders_for(long int: count) -> string as "walnut_rt::guard::sql_statement::placeholders_for";
                } end class SqlStatement

                class Native as "walnut_rt::guard::api" {
                public:
                    static function hash_secret(const string&: secret) -> string as "walnut_rt::guard::hash_secret";
                } end class Native
            } end extern

            function object_of(const JobSchema&: fields) -> FieldRule {
                return fields.as_field();
            } end function object_of

            function hash_secret(const string&: secret) -> string {
                return Native::hash_secret(secret);
            } end function hash_secret
        } end namespace guard

        extern "C++" from "<walnut_net.hpp>" {
            class HttpServer as "walnut_rt::net::http_server" {
            public:
                constructor();
                function handle(self&, function(Request) -> Response: handler) -> void;
                function listen(self&, const string&: host, long int: port) -> void;
                function serve(self&) -> void;
                function serve_for(self&, long int: milliseconds) -> void;
                function close(self&) -> void;
                function is_listening(const self&) -> bool;
                function use_guard(self&, const guard::Guard&: shield) -> void;
            } end class HttpServer
        } end extern

        function resolve(const string&: host) -> std::collections::Vector<string> {
            return Native::resolve(host);
        } end function resolve

        function resolve4(const string&: host) -> std::collections::Vector<string> {
            return Native::resolve4(host);
        } end function resolve4

        function resolve6(const string&: host) -> std::collections::Vector<string> {
            return Native::resolve6(host);
        } end function resolve6

        function reverse_lookup(const string&: ip) -> std::collections::Vector<string> {
            return Native::reverse_lookup(ip);
        } end function reverse_lookup

        function is_ipv4(const string&: input) -> bool {
            return Native::is_ipv4(input);
        } end function is_ipv4

        function is_ipv6(const string&: input) -> bool {
            return Native::is_ipv6(input);
        } end function is_ipv6

        function url_encode(const string&: input) -> string {
            return Native::url_encode(input);
        } end function url_encode

        function url_decode(const string&: input) -> string {
            return Native::url_decode(input);
        } end function url_decode

        function status_text(long int: code) -> string {
            return Native::status_text(code);
        } end function status_text

        struct RequestOptions {
            string: method = "GET";
            string: body;
            Headers: headers;
            long int: timeout_ms = 30000;
            bool: follow_redirects = true;
            bool: verify_certificates = true;

            function header(self&, const string&: name, const string&: value) -> RequestOptions& {
                self.headers.set(name, value);
                return *this;
            } end function header
        } end struct RequestOptions

        function request(const string&: url, const RequestOptions&: options) -> Response {
            return Native::fetch(options.method, url, options.body, options.headers, options.timeout_ms, options.follow_redirects, options.verify_certificates);
        } end function request

        function request(const string&: method, const string&: url, const string&: body = "", long int: timeout_ms = 30000) -> Response {
            RequestOptions: o;
            o.method = method;
            o.body = body;
            o.timeout_ms = timeout_ms;
            return request(url, o);
        } end function request

        function get(const string&: url, long int: timeout_ms = 30000) -> Response {
            return request("GET", url, "", timeout_ms);
        } end function get

        function head(const string&: url, long int: timeout_ms = 30000) -> Response {
            return request("HEAD", url, "", timeout_ms);
        } end function head

        function post(const string&: url, const string&: body, const string&: content_type = "application/x-www-form-urlencoded", long int: timeout_ms = 30000) -> Response {
            RequestOptions: o;
            o.method = "POST";
            o.body = body;
            o.timeout_ms = timeout_ms;
            o.headers.set("Content-Type", content_type);
            return request(url, o);
        } end function post

        function post_json(const string&: url, const string&: json, long int: timeout_ms = 30000) -> Response {
            return post(url, json, "application/json", timeout_ms);
        } end function post_json

        function put(const string&: url, const string&: body, const string&: content_type = "application/octet-stream", long int: timeout_ms = 30000) -> Response {
            RequestOptions: o;
            o.method = "PUT";
            o.body = body;
            o.timeout_ms = timeout_ms;
            o.headers.set("Content-Type", content_type);
            return request(url, o);
        } end function put

        function patch(const string&: url, const string&: body, const string&: content_type = "application/json", long int: timeout_ms = 30000) -> Response {
            RequestOptions: o;
            o.method = "PATCH";
            o.body = body;
            o.timeout_ms = timeout_ms;
            o.headers.set("Content-Type", content_type);
            return request(url, o);
        } end function patch

        function remove(const string&: url, long int: timeout_ms = 30000) -> Response {
            return request("DELETE", url, "", timeout_ms);
        } end function remove

        function download(const string&: url) -> string {
            const Response: r = get(url);
            if (r.failed()) then {
                throw std::errors::network_error(static_cast<string>(`download of ${url} failed: ${r.error()}`));
            }
            if (!r.ok()) then {
                throw std::errors::network_error(static_cast<string>(`download of ${url} failed: ${r.status()} ${r.status_text()}`));
            }
            return r.body();
        } end function download

        function request_async(const string&: url, const RequestOptions&: options, function(Response) -> void: callback) -> void {
            Native::fetch_async(options.method, url, options.body, options.headers, options.timeout_ms, options.follow_redirects, options.verify_certificates, callback);
        } end function request_async

        function get_async(const string&: url, function(Response) -> void: callback) -> void {
            RequestOptions: o;
            request_async(url, o, callback);
        } end function get_async

        function post_async(const string&: url, const string&: body, const string&: content_type, function(Response) -> void: callback) -> void {
            RequestOptions: o;
            o.method = "POST";
            o.body = body;
            o.headers.set("Content-Type", content_type);
            request_async(url, o, callback);
        } end function post_async

        function serve(const string&: host, long int: port, function(Request) -> Response: handler) -> void {
            HttpServer: server;
            server.handle(handler);
            server.listen(host, port);
            server.serve();
        } end function serve

        function set_timeout(long int: milliseconds, function() -> void: callback) -> Timer {
            return Native::set_timeout(milliseconds, callback);
        } end function set_timeout

        function set_interval(long int: milliseconds, function() -> void: callback) -> Timer {
            return Native::set_interval(milliseconds, callback);
        } end function set_interval

        function next_tick(function() -> void: callback) -> void {
            Native::next_tick(callback);
        } end function next_tick

        function run() -> long int {
            return Native::run();
        } end function run

        function run_once() -> long int {
            return Native::run_once();
        } end function run_once

        function poll() -> long int {
            return Native::poll();
        } end function poll

        function run_for(long int: milliseconds) -> long int {
            return Native::run_for(milliseconds);
        } end function run_for

        function stop() -> void {
            Native::stop();
        } end function stop
    } end namespace networking
} end namespace std
} end safe
