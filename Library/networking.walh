                function receive_from(self&, long int: max_bytes = 65507) -> Datagram;
                function broadcast(self&, long int: port, const string&: data) -> long int;
                function set_timeout(self&, long int: milliseconds) -> void;
                function port(const self&) -> long int;
                function local_address(const self&) -> string;
