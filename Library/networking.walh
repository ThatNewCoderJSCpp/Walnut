                    function non_empty(self&) -> FieldRule&;
                    function min_items(self&, long int: n) -> FieldRule&;
                    function max_items(self&, long int: n) -> FieldRule&;
                    function unique_items(self&) -> FieldRule&;
                    function allow_control_chars(self&) -> FieldRule&;
                    function format(self&, const string&: name) -> FieldRule&;
                    function one_of(self&, const std::collections::Vector<string>&: values) -> FieldRule&;
