            class Native as "walnut_rt::net::api" {
            public:
                static function resolve(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve";
                static function resolve4(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve4";
                static function resolve6(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve6";
                static function reverse_lookup(const string&: ip) -> std::collections::Vector<string> as "walnut_rt::net::reverse_lookup";
                static function is_ipv4(const string&: input) -> bool as "walnut_rt::net::is_ipv4";
                static function is_ipv6(const string&: input) -> bool as "walnut_rt::net::is_ipv6";
                static function fetch(const string&: method, const string&: url, const string&: body, const Headers&: headers, long int: timeout_ms, bool: follow, bool: verify) -> Response as "walnut_rt::net::fetch";
                static function fetch_async(const string&: method, const string&: url, const string&: body, const Headers&: headers, long int: timeout_ms, bool: follow, bool: verify, function(Response) -> void: callback) -> void as "walnut_rt::net::fetch_async";
                static function set_timeout(long int: ms, function() -> void: callback) -> Timer as "walnut_rt::net::set_timeout";
                static function set_interval(long int: ms, function() -> void: callback) -> Timer as "walnut_rt::net::set_interval";
                static function next_tick(function() -> void: callback) -> void as "walnut_rt::net::next_tick";
                static function run() -> long int as "walnut_rt::net::run";
                static function run_once() -> long int as "walnut_rt::net::run_once";
                static function poll() -> long int as "walnut_rt::net::poll";
                static function run_for(long int: ms) -> long int as "walnut_rt::net::run_for";
                static function stop() -> void as "walnut_rt::net::stop";
                static function status_text(long int: code) -> string as "walnut_rt::net::status_text";
                static function url_encode(const string&: input) -> string as "walnut_rt::net::url_encode";
                static function url_decode(const string&: input) -> string as "walnut_rt::net::url_decode";
            } end class Native
        } end extern

        namespace guard {
            extern "C++" from "<walnut_net.hpp>" {
                class LoginCheck as "walnut_rt::net::login_check" {
                public:
                    constructor();
                    function allowed(const self&) -> bool;
                    function status(const self&) -> long int;
                    function retry_after_ms(const self&) -> long int;
                    function delay_ms(const self&) -> long int;
                    function reason(const self&) -> string;
                } end class LoginCheck

                class LogFields as "walnut_rt::guard::log_fields" {
                public:
                    constructor();
                    function add(self&, const string&: key, const string&: value) -> LogFields&;
                    function add_int(self&, const string&: key, long int: value) -> LogFields&;
                    function add_float(self&, const string&: key, short float: value) -> LogFields&;
                    function add_bool(self&, const string&: key, bool: value) -> LogFields&;
                    function size(const self&) -> long int;
                } end class LogFields

                class Logger as "walnut_rt::guard::logger" {
                public:
                    constructor();
                    constructor(const string&: level);
                    function to_stderr(self&) -> void;
                    function to_stdout(self&) -> void;
                    function to_file(self&, const string&: path, long int: max_bytes = 10485760, long int: files = 5) -> void;
                    function as_text(self&, bool: enabled = true) -> void;
                    function set_level(self&, const string&: level) -> void;
                    function redact(self&, const string&: key) -> void;
                    function trace(self&, const string&: message) -> void;
                    function debug(self&, const string&: message) -> void;
                    function info(self&, const string&: message) -> void;
                    function warn(self&, const string&: message) -> void;
                    function error(self&, const string&: message) -> void;
                    function info_with(self&, const string&: message, const LogFields&: fields) -> void;
                    function warn_with(self&, const string&: message, const LogFields&: fields) -> void;
                    function error_with(self&, const string&: message, const LogFields&: fields) -> void;
                    function flush(self&) -> void;
                    static function new_request_id() -> string as "walnut_rt::guard::logger::new_request_id";
                } end class Logger


                class Guard as "walnut_rt::net::guard" {
                public:
                    constructor();
                    function rate_limit(self&, short float: per_second, short float: burst) -> void;
                    function no_rate_limit(self&) -> void;
                    function route_limit(self&, const string&: method, const string&: path_prefix, short float: per_minute, short float: burst) -> void;
                    function trust_proxy(self&, bool: on) -> void;
                    function trusted_proxy(self&, const string&: ip) -> void;
                    function block_bots(self&, bool: on) -> void;
                    function track_failures(self&, bool: on) -> void;
                    function access_log(self&, bool: on) -> void;
                    function security_headers(self&, bool: on) -> void;
                    function content_security_policy(self&, const string&: policy) -> void;
                    function hsts(self&, const string&: value) -> void;
                    function no_store(self&, bool: on) -> void;
                    function allowed_origin(self&, const string&: origin) -> void;
                    function max_body(self&, long int: bytes) -> void;
                    function session_timeouts(self&, long int: idle_minutes, long int: absolute_hours) -> void;
                    function cookie_same_site(self&, const string&: mode) -> void;
                    function secure_cookies(self&, bool: on) -> void;
                    function use_logger(self&, const Logger&: log) -> void;
                    function block_fingerprint(self&, const string&: ja4, const string&: label = "") -> void;
                    function trust_fingerprint(self&, const string&: ja4, const string&: label = "") -> void;

                    function authenticated(const self&, const Request&: req) -> bool;
                    function user(const self&, const Request&: req) -> string;
                    function has_role(const self&, const Request&: req, const string&: role) -> bool;
                    function session_id(const self&, const Request&: req) -> string;
                    function csrf_token(const self&, const Request&: req) -> string;
                    function csrf_ok(const self&, const Request&: req) -> bool;
                    function same_origin(const self&, const Request&: req) -> bool;
                    function check_login(const self&, const Request&: req, const string&: account) -> LoginCheck;
                    function login_failed(const self&, const Request&: req, const string&: account) -> void;
                    function login(const self&, const Request&: req, const string&: user_id, const std::collections::Vector<string>&: roles) -> string;
                    function login_user(const self&, const Request&: req, const string&: user_id) -> string;
                    function new_device(const self&, const Request&: req) -> bool;
                    function trust_device(const self&, const Request&: req, const string&: label = "") -> bool;
                    function logout(const self&, const Request&: req, bool: everywhere = false, bool: keep_device = false) -> void;
                    function revoke_sessions(const self&, const string&: user_id) -> long int;
                    function session_count(const self&, const string&: user_id) -> long int;
                    function register_owner(self&, const string&: type, function(string) -> string: lookup) -> void;
                    function admin_role(self&, const string&: role) -> void;
                    function can(const self&, const Request&: req, const string&: type, const string&: id, const string&: action = "read") -> bool;
                    function idempotent(const self&, const Request&: req, function() -> Response: body) -> Response;
                    function set_budget(self&, const string&: metric, short float: limit, long int: period_seconds = 86400, short float: warn_ratio = 0.8, bool: hard_stop = false) -> void;
                    function budget_level(const self&, const string&: metric) -> string;
                    function on_budget_alert(self&, function(string, string, short float, short float) -> void: callback) -> void;
                    function on_new_error(self&, function(string, string, string, long int) -> void: callback) -> void;
                    function error_groups(const self&) -> long int;
                    function errors_json(const self&) -> string;
                    function start_maintenance(self&) -> void;
                    function stop_maintenance(self&) -> void;
                    function sweep(self&) -> void;
                } end class Guard

