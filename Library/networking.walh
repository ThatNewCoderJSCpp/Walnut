import module.collections

safe(compile) {
    namespace std {
        namespace errors {
            class network_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class network_error
        } end namespace errors

        namespace networking {
            extern "C++" from "<walnut_net.hpp>" {
                class TcpStream as "walnut_rt::net::tcp_stream" {
                public:
                    constructor();
                    static function connect(const string&: host, unsigned long int: port, unsigned long int: timeout_ms = 10000) -> TcpStream as "walnut_rt::net::tcp_stream::connect";
                    function is_open(const self&) -> bool;
                    function send(self&, const string&: data) -> unsigned long int;
                    function send_all(self&, const string&: data) -> bool;
                    function receive(self&, unsigned long int: max_bytes = 65536) -> string;
                    function receive_exact(self&, unsigned long int: count) -> string;
                    function read_line(self&) -> string;
                    function receive_all(self&) -> string;
                    function set_timeout(self&, unsigned long int: milliseconds) -> void;
                    function close(self&) -> void;
                    function local_address(const self&) -> string;
                    function remote_address(const self&) -> string;
                    function last_error(const self&) -> string;

                    function write_line(self&, const string&: line) -> bool {
                        return self.send_all(line + "\n");
                    } end function write_line
                } end class TcpStream

                class TcpListener as "walnut_rt::net::tcp_listener" {
                public:
                    constructor();
                    static function bind(const string&: host, unsigned long int: port, unsigned long int: backlog = 16) -> TcpListener as "walnut_rt::net::tcp_listener::bind";
                    function accept(self&) -> TcpStream;
                    function port(const self&) -> unsigned long int;
                    function local_address(const self&) -> string;
                    function is_open(const self&) -> bool;
                    function close(self&) -> void;
                } end class TcpListener

                class Datagram as "walnut_rt::net::datagram" {
                public:
                    constructor();
                    function data(const self&) -> string;
                    function host(const self&) -> string;
                    function port(const self&) noexcept -> unsigned long int;
                    function empty(const self&) noexcept -> bool;
                } end class Datagram

                class UdpSocket as "walnut_rt::net::udp_socket" {
                public:
                    constructor();
                    static function bind(const string&: host, unsigned long int: port) -> UdpSocket as "walnut_rt::net::udp_socket::bind";
                    function send_to(self&, const string&: host, unsigned long int: port, const string&: data) -> unsigned long int;
                    function receive_from(self&, unsigned long int: max_bytes = 65507) -> Datagram;
                    function broadcast(self&, unsigned long int: port, const string&: data) -> unsigned long int;
                    function set_timeout(self&, unsigned long int: milliseconds) -> void;
                    function port(const self&) -> unsigned long int;
                    function local_address(const self&) -> string;
                    function close(self&) -> void;
                } end class UdpSocket

                class TlsStream as "walnut_rt::net::tls_stream" {
                public:
                    constructor();
                    static function connect(const string&: host, unsigned long int: port, bool: verify = true, unsigned long int: timeout_ms = 10000) -> TlsStream as "walnut_rt::net::tls_stream::connect";
                    function is_open(const self&) -> bool;
                    function send_all(self&, const string&: data) -> bool;
                    function receive(self&, unsigned long int: max_bytes = 16384) -> string;
                    function receive_all(self&) -> string;
                    function close(self&) -> void;
                } end class TlsStream

                class Url as "walnut_rt::net::url" {
                public:
                    constructor();
                    static function parse(const string&: input) -> Url as "walnut_rt::net::url::parse";
                    static function parse_relative(const string&: input, const string&: base) -> Url as "walnut_rt::net::url::parse_relative";
                    static function can_parse(const string&: input) -> bool as "walnut_rt::net::url::can_parse";
                    static function default_port(const string&: scheme) -> unsigned long int as "walnut_rt::net::url::default_port";
                    function href(const self&) -> string;
                    function origin(const self&) -> string;
                    function scheme(const self&) -> string;
                    function username(const self&) -> string;
                    function password(const self&) -> string;
                    function host(const self&) -> string;
                    function hostname(const self&) -> string;
                    function port(const self&) -> unsigned long int;
                    function path(const self&) -> string;
                    function query(const self&) -> string;
                    function fragment(const self&) -> string;
                    function path_and_query(const self&) -> string;
                    function secure(const self&) -> bool;
                    function param(const self&, const string&: name) -> string;
                    function has_param(const self&, const string&: name) -> bool;
                    function params(const self&, const string&: name) -> std::collections::Vector<string>;
                    function param_names(const self&) -> std::collections::Vector<string>;
                    function with_scheme(const self&, const string&: value) -> Url;
                    function with_host(const self&, const string&: value) -> Url;
                    function with_port(const self&, unsigned long int: value) -> Url;
                    function with_path(const self&, const string&: value) -> Url;
                    function with_query(const self&, const string&: value) -> Url;
                    function with_fragment(const self&, const string&: value) -> Url;
                    function with_param(const self&, const string&: name, const string&: value) -> Url;
                    function without_param(const self&, const string&: name) -> Url;

                    function to_string(const self&) -> string {
                        return self.href();
                    } end function to_string
                } end class Url

                class Headers as "walnut_rt::net::headers" {
                public:
                    constructor();
                    function set(self&, const string&: name, const string&: value) -> void;
                    function add(self&, const string&: name, const string&: value) -> void;
                    function get(const self&, const string&: name) -> string;
                    function has(const self&, const string&: name) -> bool;
                    function remove(self&, const string&: name) -> bool;
                    function size(const self&) -> unsigned long int;
                    function names(const self&) -> std::collections::Vector<string>;
                } end class Headers

                class Request as "walnut_rt::net::request" {
                public:
                    constructor();
                    function method(const self&) -> string;
                    function target(const self&) -> string;
                    function path(const self&) -> string;
                    function query(const self&) -> string;
                    function param(const self&, const string&: name) -> string;
                    function body(const self&) -> string;
                    function version(const self&) -> string;
                    function header(const self&, const string&: name) -> string;
                    function has_header(const self&, const string&: name) -> bool;
                    function header_names(const self&) -> std::collections::Vector<string>;
                    function request_id(const self&) -> string;
                    function client_ip(const self&) -> string;
                    function tls_fingerprint(const self&) -> string;
                    function risk(const self&) -> string;
                    function risk_score(const self&) -> unsigned long int;
                    function encrypted(const self&) -> bool;
                    function user(const self&) -> string;
                    function guarded(const self&) -> bool;
                } end class Request

                class Response as "walnut_rt::net::response" {
                public:
                    constructor();
                    static function make(unsigned long int: status, const string&: body, const string&: content_type = "text/plain; charset=utf-8") -> Response as "walnut_rt::net::response::make";
                    function status(const self&) noexcept -> unsigned long int;
                    function status_text(const self&) -> string;
                    function body(const self&) -> string;
                    function url(const self&) -> string;
                    function ok(const self&) -> bool;
                    function header(const self&, const string&: name) -> string;
                    function has_header(const self&, const string&: name) -> bool;
                    function header_names(const self&) -> std::collections::Vector<string>;
                    function error(const self&) -> string;
                    function failed(const self&) -> bool;
                    function set_status(self&, unsigned long int: code) -> void;
                    function set_body(self&, const string&: input) -> void;
                    function set_header(self&, const string&: name, const string&: value) -> void;
                    function add_header(self&, const string&: name, const string&: value) -> void;

                    static function plain(const string&: body, unsigned long int: status = 200) -> Response {
                        return Response::make(status, body, "text/plain; charset=utf-8");
                    } end function plain

                    static function html(const string&: body, unsigned long int: status = 200) -> Response {
                        return Response::make(status, body, "text/html; charset=utf-8");
                    } end function html

                    static function json(const string&: body, unsigned long int: status = 200) -> Response {
                        return Response::make(status, body, "application/json");
                    } end function json

                    static function not_found() -> Response {
                        return Response::make(404, "not found");
                    } end function not_found

                    static function redirect(const string&: location, unsigned long int: status = 302) -> Response {
                        Response: r = Response::make(status, "");
                        r.set_header("Location", location);
                        return r;
                    } end function redirect
                } end class Response

                class Message as "walnut_rt::net::message" {
                public:
                    constructor();
                    function data(const self&) -> string;
                    function is_binary(const self&) noexcept -> bool;
                    function is_text(const self&) -> bool;
                    function ok(const self&) noexcept -> bool;
                } end class Message

                class WebSocket as "walnut_rt::net::websocket" {
                public:
                    constructor();
                    static function connect(const string&: url, unsigned long int: timeout_ms = 30000) -> WebSocket as "walnut_rt::net::websocket::connect";
                    function send_text(self&, const string&: input) -> bool;
                    function send_binary(self&, const string&: data) -> bool;
                    function receive(self&, unsigned long int: timeout_ms = std::npos) -> Message;
                    function on_message(self&, function(Message) -> void: callback) -> void;
                    function close(self&, unsigned long int: code = 1000, const string&: reason = "") -> void;
                    function is_open(const self&) -> bool;
                    function close_code(const self&) noexcept -> unsigned long int;
                    function close_reason(const self&) -> string;
                    function error(const self&) -> string;
                    function remote_address(const self&) -> string;
                } end class WebSocket

                class WebSocketServer as "walnut_rt::net::websocket_server" {
                public:
                    constructor();
                    function handle(self&, function(WebSocket) -> void: on_connect) -> void;
                    function listen(self&, const string&: host, unsigned long int: port) -> void;
                    function broadcast(self&, const string&: input) -> unsigned long int;
                    function client_count(const self&) -> unsigned long int;
                    function port(const self&) -> unsigned long int;
                    function serve(self&) -> void;
                    function serve_for(self&, unsigned long int: milliseconds) -> void;
                    function close(self&) -> void;
                } end class WebSocketServer

                class Timer as "walnut_rt::net::timer" {
                public:
                    constructor();
                    function cancel(self&) -> void;
                    function active(const self&) -> bool;
                } end class Timer

                hidden class Native as "walnut_rt::net::api" {
                public:
                    static function resolve(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve";
                    static function resolve4(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve4";
                    static function resolve6(const string&: host) -> std::collections::Vector<string> as "walnut_rt::net::resolve6";
                    static function reverse_lookup(const string&: ip) -> std::collections::Vector<string> as "walnut_rt::net::reverse_lookup";
                    static function is_ipv4(const string&: input) -> bool as "walnut_rt::net::is_ipv4";
                    static function is_ipv6(const string&: input) -> bool as "walnut_rt::net::is_ipv6";
                    static function fetch(const string&: method, const string&: url, const string&: body, const Headers&: headers, unsigned long int: timeout_ms, bool: follow, bool: verify) -> Response as "walnut_rt::net::fetch";
                    static function fetch_async(const string&: method, const string&: url, const string&: body, const Headers&: headers, unsigned long int: timeout_ms, bool: follow, bool: verify, function(Response) -> void: callback) -> void as "walnut_rt::net::fetch_async";
                    static function set_timeout(unsigned long int: ms, function() -> void: callback) -> Timer as "walnut_rt::net::set_timeout";
                    static function set_interval(unsigned long int: ms, function() -> void: callback) -> Timer as "walnut_rt::net::set_interval";
                    static function next_tick(function() -> void: callback) -> void as "walnut_rt::net::next_tick";
                    static function run() -> unsigned long int as "walnut_rt::net::run";
                    static function run_once() -> unsigned long int as "walnut_rt::net::run_once";
                    static function poll() -> unsigned long int as "walnut_rt::net::poll";
                    static function run_for(unsigned long int: ms) -> unsigned long int as "walnut_rt::net::run_for";
                    static function stop() -> void as "walnut_rt::net::stop";
                    static function status_text(unsigned long int: code) -> string as "walnut_rt::net::status_text";
                    static function url_encode(const string&: input) -> string as "walnut_rt::net::url_encode";
                    static function url_decode(const string&: input) -> string as "walnut_rt::net::url_decode";
                } end class Native
            } end extern

            namespace guard {
                extern "C++" from "<walnut_net.hpp>" {
                    class LoginCheck as "walnut_rt::net::login_check" {
                    public:
                        constructor();
                        function allowed(const self&) noexcept -> bool;
                        function status(const self&) noexcept -> unsigned long int;
                        function retry_after_ms(const self&) -> unsigned long int;
                        function delay_ms(const self&) -> unsigned long int;
                        function reason(const self&) -> string;
                    } end class LoginCheck

                    class LogFields as "walnut_rt::guard::log_fields" {
                    public:
                        constructor();
                        function add(self&, const string&: key, const string&: value) -> LogFields&;
                        function add_int(self&, const string&: key, unsigned long int: value) -> LogFields&;
                        function add_float(self&, const string&: key, short float: value) -> LogFields&;
                        function add_bool(self&, const string&: key, bool: value) -> LogFields&;
                        function size(const self&) -> unsigned long int;
                    } end class LogFields

                    class Logger as "walnut_rt::guard::logger" {
                    public:
                        constructor();
                        constructor(const string&: level);
                        function to_stderr(self&) -> void;
                        function to_stdout(self&) -> void;
                        function to_file(self&, const string&: path, unsigned long int: max_bytes = 10485760, unsigned long int: files = 5) -> void;
                        function as_text(self&, bool: enabled = true) -> void;
                        function set_level(self&, const string&: level) -> void;
                        function redact(self&, const string&: key) -> void;
                        function trace(self&, const string&: message) -> void;
                        function debug(self&, const string&: message) -> void;
                        function info(self&, const string&: message) -> void;
                        function warn(self&, const string&: message) -> void;
                        function error(self&, const string&: message) -> void;
                        function info_with(self&, const string&: message, const LogFields&: fields) -> void;
                        function warn_with(self&, const string&: message, const LogFields&: fields) -> void;
                        function error_with(self&, const string&: message, const LogFields&: fields) -> void;
                        function flush(self&) -> void;
                        static function new_request_id() -> string as "walnut_rt::guard::logger::new_request_id";
                    } end class Logger


                    class Guard as "walnut_rt::net::guard" {
                    public:
                        constructor();
                        function rate_limit(self&, short float: per_second, short float: burst) -> void;
                        function no_rate_limit(self&) -> void;
                        function route_limit(self&, const string&: method, const string&: path_prefix, short float: per_minute, short float: burst) -> void;
                        function trust_proxy(self&, bool: on) -> void;
                        function trusted_proxy(self&, const string&: ip) -> void;
                        function block_bots(self&, bool: on) -> void;
                        function track_failures(self&, bool: on) -> void;
                        function access_log(self&, bool: on) -> void;
                        function security_headers(self&, bool: on) -> void;
                        function content_security_policy(self&, const string&: policy) -> void;
                        function hsts(self&, const string&: value) -> void;
                        function no_store(self&, bool: on) -> void;
                        function allowed_origin(self&, const string&: origin) -> void;
                        function max_body(self&, unsigned long int: bytes) -> void;
                        function session_timeouts(self&, unsigned long int: idle_minutes, unsigned long int: absolute_hours) -> void;
                        function cookie_same_site(self&, const string&: mode) -> void;
                        function secure_cookies(self&, bool: on) -> void;
                        function use_logger(self&, const Logger&: log) -> void;
                        function block_fingerprint(self&, const string&: ja4, const string&: label = "") -> void;
                        function trust_fingerprint(self&, const string&: ja4, const string&: label = "") -> void;

                        function authenticated(const self&, const Request&: req) -> bool;
                        function user(const self&, const Request&: req) -> string;
                        function has_role(const self&, const Request&: req, const string&: role) -> bool;
                        function session_id(const self&, const Request&: req) -> string;
                        function csrf_token(const self&, const Request&: req) -> string;
                        function csrf_ok(const self&, const Request&: req) -> bool;
                        function same_origin(const self&, const Request&: req) -> bool;
                        function check_login(const self&, const Request&: req, const string&: account) -> LoginCheck;
                        function login_failed(const self&, const Request&: req, const string&: account) -> void;
                        function login(const self&, const Request&: req, const string&: user_id, const std::collections::Vector<string>&: roles) -> string;
                        function login_user(const self&, const Request&: req, const string&: user_id) -> string;
                        function new_device(const self&, const Request&: req) -> bool;
                        function trust_device(const self&, const Request&: req, const string&: label = "") -> bool;
                        function logout(const self&, const Request&: req, bool: everywhere = false, bool: keep_device = false) -> void;
                        function revoke_sessions(const self&, const string&: user_id) -> unsigned long int;
                        function session_count(const self&, const string&: user_id) -> unsigned long int;
                        function register_owner(self&, const string&: type, function(string) -> string: lookup) -> void;
                        function admin_role(self&, const string&: role) -> void;
                        function can(const self&, const Request&: req, const string&: type, const string&: id, const string&: action = "read") -> bool;
                        function idempotent(const self&, const Request&: req, function() -> Response: body) -> Response;
                        function set_budget(self&, const string&: metric, short float: limit, unsigned long int: period_seconds = 86400, short float: warn_ratio = 0.8, bool: hard_stop = false) -> void;
                        function budget_level(const self&, const string&: metric) -> string;
                        function on_budget_alert(self&, function(string, string, short float, short float) -> void: callback) -> void;
                        function on_new_error(self&, function(string, string, string, unsigned long int) -> void: callback) -> void;
                        function error_groups(const self&) -> unsigned long int;
                        function errors_json(const self&) -> string;
                        function start_maintenance(self&) -> void;
                        function stop_maintenance(self&) -> void;
                        function sweep(self&) -> void;
                    } end class Guard

                    class RateDecision as "walnut_rt::guard::rate_decision" {
                    public:
                        constructor();
                        function allowed(const self&) noexcept -> bool;
                        function remaining(const self&) noexcept -> short float;
                        function limit(const self&) noexcept -> short float;
                        function retry_after_ms(const self&) -> unsigned long int;
                        function reset_after_ms(const self&) -> unsigned long int;
                    } end class RateDecision

                    class RateLimiter as "walnut_rt::guard::rate_limiter" {
                    public:
                        constructor();
                        constructor(short float: per_second, short float: burst, short float: start_tokens = -1.0);
                        constructor(float: per_second, float: burst) as "walnut_rt::guard::rate_limiter::from_wide";
                        constructor(float: per_second, float: burst, float: start_tokens) as "walnut_rt::guard::rate_limiter::from_wide_start";
                        static function per_minute(short float: per_minute, short float: burst) -> RateLimiter as "walnut_rt::guard::rate_limiter::per_minute";
                        static function per_hour(short float: per_hour, short float: burst) -> RateLimiter as "walnut_rt::guard::rate_limiter::per_hour";
                        function consume(self&, const string&: key, short float: cost = 1.0) -> RateDecision;
                        function peek(const self&, const string&: key, short float: cost = 1.0) -> RateDecision;
                        function allow(self&, const string&: key) -> bool;
                        function refund(self&, const string&: key, short float: amount = 1.0) -> void;
                        function reset(self&, const string&: key) -> void;
                        function size(const self&) -> unsigned long int;
                        function sweep(self&) -> unsigned long int;
                    } end class RateLimiter

                    class WindowLimiter as "walnut_rt::guard::window_limiter" {
                    public:
                        constructor();
                        constructor(unsigned long int: limit, unsigned long int: window_seconds);
                        function hit(self&, const string&: key) -> RateDecision;
                        function peek(const self&, const string&: key) -> RateDecision;
                        function count(const self&, const string&: key) -> unsigned long int;
                        function reset(self&, const string&: key) -> void;
                    } end class WindowLimiter

                    class FailureStatus as "walnut_rt::guard::failure_status" {
                    public:
                        constructor();
                        function failures(const self&) noexcept -> unsigned long int;
                        function successes(const self&) noexcept -> unsigned long int;
                        function failure_ratio(const self&) noexcept -> short float;
                        function locked(const self&) noexcept -> bool;
                        function strikes(const self&) noexcept -> unsigned long int;
                        function lock_remaining_ms(const self&) -> unsigned long int;
                        function delay_ms(const self&) -> unsigned long int;
                    } end class FailureStatus

                    class FailureTracker as "walnut_rt::guard::failure_tracker" {
                    public:
                        constructor();
                        constructor(unsigned long int: max_failures, unsigned long int: window_seconds, unsigned long int: lockout_seconds);
                        function record_failure(self&, const string&: key) -> FailureStatus;
                        function record_success(self&, const string&: key, bool: forgive = false) -> FailureStatus;
                        function status(const self&, const string&: key) -> FailureStatus;
                        function is_locked(const self&, const string&: key) -> bool;
                        function unlock(self&, const string&: key) -> void;
                        function reset(self&, const string&: key) -> void;
                    } end class FailureTracker

                    class Job as "walnut_rt::guard::job" {
                    public:
                        constructor();
                        function id(const self&) -> string;
                        function name(const self&) -> string;
                        function payload(const self&) -> string;
                        function attempt(const self&) noexcept -> unsigned long int;
                        function max_attempts(const self&) noexcept -> unsigned long int;
                        function last_attempt(const self&) -> bool;
                        function last_error(const self&) -> string;
                        function should_stop(const self&) -> bool;
                    } end class Job

                    class FieldRule as "walnut_rt::guard::field_rule" {
                    public:
                        constructor();
                        static function text_field() -> FieldRule as "walnut_rt::guard::field_rule::text_field";
                        static function int_field() -> FieldRule as "walnut_rt::guard::field_rule::int_field";
                        static function float_field() -> FieldRule as "walnut_rt::guard::field_rule::float_field";
                        static function bool_field() -> FieldRule as "walnut_rt::guard::field_rule::bool_field";
                        static function any_field() -> FieldRule as "walnut_rt::guard::field_rule::any_field";
                        static function list_of(const FieldRule&: items) -> FieldRule as "walnut_rt::guard::field_rule::list_of";
                        function optional(self&) -> FieldRule&;
                        function required(self&) -> FieldRule&;
                        function nullable(self&) -> FieldRule&;
                        function min(self&, short float: value) -> FieldRule&;
                        function max(self&, short float: value) -> FieldRule&;
                        function between(self&, short float: low, short float: high) -> FieldRule&;
                        function positive(self&) -> FieldRule&;
                        function min_length(self&, unsigned long int: n) -> FieldRule&;
                        function max_length(self&, unsigned long int: n) -> FieldRule&;
                        function length(self&, unsigned long int: low, unsigned long int: high) -> FieldRule&;
                        function non_empty(self&) -> FieldRule&;
                        function min_items(self&, unsigned long int: n) -> FieldRule&;
                        function max_items(self&, unsigned long int: n) -> FieldRule&;
                        function unique_items(self&) -> FieldRule&;
                        function allow_control_chars(self&) -> FieldRule&;
                        function format(self&, const string&: name) -> FieldRule&;
                        function one_of(self&, const std::collections::Vector<string>&: values) -> FieldRule&;
                    } end class FieldRule

                    class JobSchema as "walnut_rt::guard::job_schema" {
                    public:
                        constructor();
                        static function text_payload(unsigned long int: max_bytes = 65536) -> JobSchema as "walnut_rt::guard::job_schema::text_payload";
                        static function no_payload() -> JobSchema as "walnut_rt::guard::job_schema::no_payload";
                        function add(self&, const string&: name, const FieldRule&: rule) -> JobSchema&;
                        function allow_extra_fields(self&) -> JobSchema&;
                        function max_bytes(self&, unsigned long int: n) -> JobSchema&;
                        function max_depth(self&, unsigned long int: n) -> JobSchema&;
                        function max_string_length(self&, unsigned long int: n) -> JobSchema&;
                        function max_array_items(self&, unsigned long int: n) -> JobSchema&;
                        function at_least_one_of(self&, const std::collections::Vector<string>&: names) -> JobSchema&;
                        function only_one_of(self&, const std::collections::Vector<string>&: names) -> JobSchema&;
                        function all_or_none_of(self&, const std::collections::Vector<string>&: names) -> JobSchema&;
                        function validate(const self&, const string&: payload) -> std::collections::Vector<string>;
                        function accepts(const self&, const string&: payload) -> bool;
                        function as_field(const self&) -> FieldRule;
                    } end class JobSchema

                    class EnqueueResult as "walnut_rt::guard::enqueue_result" {
                    public:
                        constructor();
                        function ok(const self&) noexcept -> bool;
                        function duplicate(const self&) noexcept -> bool;
                        function id(const self&) -> string;
                        function problems(const self&) -> std::collections::Vector<string>;
                        function message(const self&) -> string;
                    } end class EnqueueResult

                    class JobQueue as "walnut_rt::guard::job_queue" {
                    public:
                        constructor();
                        constructor(unsigned long int: workers);
                        function on(self&, const string&: name, function(Job) -> bool: handler) -> void;
                        function on_checked(self&, const string&: name, const JobSchema&: schema, function(Job) -> bool: handler) -> void;
                        function enqueue(self&, const string&: name, const string&: payload = "", unsigned long int: max_attempts = 5, unsigned long int: delay_ms = 0, const string&: unique_key = "") -> string;
                        function try_enqueue(self&, const string&: name, const string&: payload = "", unsigned long int: max_attempts = 5, unsigned long int: delay_ms = 0, const string&: unique_key = "") -> EnqueueResult;
                        function check(const self&, const string&: name, const string&: payload = "", unsigned long int: max_attempts = 5, unsigned long int: delay_ms = 0, const string&: unique_key = "") -> std::collections::Vector<string>;
                        function set_schema(self&, const string&: name, const JobSchema&: schema) -> void;
                        function remove_schema(self&, const string&: name) -> bool;
                        function has_schema(const self&, const string&: name) -> bool;
                        function limit_attempts(self&, unsigned long int: n) -> void;
                        function limit_queue(self&, unsigned long int: n) -> void;
                        function limit_dead_letters(self&, unsigned long int: n) -> void;
                        function limit_payload(self&, unsigned long int: bytes) -> void;
                        function limit_delay(self&, unsigned long int: ms) -> void;
                        function require_handlers(self&, bool: on) -> void;
                        function require_schemas(self&, bool: on) -> void;
                        function attempt_limit(const self&) -> unsigned long int;
                        function set_retry_delay(self&, unsigned long int: initial_ms, unsigned long int: max_ms) -> void;
                        function start(self&) -> void;
                        function stop(self&, bool: drain = false) -> void;
                        function running(const self&) -> bool;
                        function wait_idle(self&, unsigned long int: timeout_ms) -> bool;
                        function cancel(self&, const string&: id) -> bool;
                        function retry_dead(self&, const string&: id) -> bool;
                        function retry_all_dead(self&) -> unsigned long int;
                        function discard_dead(self&, const string&: id) -> bool;
                        function clear_dead(self&) -> unsigned long int;
                        function queued(const self&) -> unsigned long int;
                        function dead(const self&) -> unsigned long int;
                        function succeeded(const self&) -> unsigned long int;
                        function rejected(const self&) -> unsigned long int;
                        function dead_dropped(const self&) -> unsigned long int;
                        function errors_of(const self&, const string&: id) -> std::collections::Vector<string>;
                        function attempts_of(const self&, const string&: id) -> unsigned long int;
                        function dead_ids(const self&) -> std::collections::Vector<string>;
                        function state_of(const self&, const string&: id) -> string;
                    } end class JobQueue

                    class BudgetMonitor as "walnut_rt::guard::budget_monitor" {
                    public:
                        constructor();
                        function set_budget(self&, const string&: metric, short float: limit, unsigned long int: period_seconds = 86400, short float: warn_ratio = 0.8, bool: hard_stop = false, const string&: unit = "") -> void;
                        function add(self&, const string&: metric, short float: amount = 1.0) -> string;
                        function allows(const self&, const string&: metric, short float: amount = 1.0) -> bool;
                        function consume(self&, const string&: metric, short float: amount = 1.0) -> bool;
                        function used(const self&, const string&: metric) -> short float;
                        function level(const self&, const string&: metric) -> string;
                        function reset(self&, const string&: metric) -> void;
                        function set_gauge_threshold(self&, const string&: metric, short float: warn, short float: critical) -> void;
                        function set_gauge(self&, const string&: metric, short float: value) -> string;
                        function on_alert(self&, function(string, string, short float, short float) -> void: callback) -> void;
                    } end class BudgetMonitor

                    class Debouncer as "walnut_rt::guard::debouncer" {
                    public:
                        constructor();
