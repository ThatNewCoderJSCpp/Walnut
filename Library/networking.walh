                class JobQueue as "walnut_rt::guard::job_queue" {
                public:
                    constructor();
                    constructor(long int: workers);
                    function on(const string&: name, function(Job) -> bool: handler) -> void;
                    function on_checked(const string&: name, const JobSchema&: schema, function(Job) -> bool: handler) -> void;
                    function enqueue(const string&: name, const string&: payload = "", long int: max_attempts = 5, long int: delay_ms = 0, const string&: unique_key = "") -> string;
                    function try_enqueue(const string&: name, const string&: payload = "", long int: max_attempts = 5, long int: delay_ms = 0, const string&: unique_key = "") -> EnqueueResult;
                    function check(const string&: name, const string&: payload = "", long int: max_attempts = 5, long int: delay_ms = 0, const string&: unique_key = "") const -> std::collections::Vector<string>;
                    function set_schema(const string&: name, const JobSchema&: schema) -> void;
                    function remove_schema(const string&: name) -> bool;
                    function has_schema(const string&: name) const -> bool;
                    function limit_attempts(long int: n) -> void;
                    function limit_queue(long int: n) -> void;
                    function limit_dead_letters(long int: n) -> void;
                    function limit_payload(long int: bytes) -> void;
                    function limit_delay(long int: ms) -> void;
                    function require_handlers(bool: on) -> void;
                    function require_schemas(bool: on) -> void;
                    function attempt_limit() const -> long int;
                    function set_retry_delay(long int: initial_ms, long int: max_ms) -> void;
                    function start() -> void;
                    function stop(bool: drain = false) -> void;
                    function running() const -> bool;
                    function wait_idle(long int: timeout_ms) -> bool;
                    function cancel(const string&: id) -> bool;
                    function retry_dead(const string&: id) -> bool;
                    function retry_all_dead() -> long int;
                    function discard_dead(const string&: id) -> bool;
                    function clear_dead() -> long int;
