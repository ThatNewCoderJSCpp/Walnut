                    static function is_letter(char: c) -> bool as "walnut_rt::str::is_letter";
                    static function is_hex_digit(char: c) -> bool as "walnut_rt::str::is_hex_digit";
                    static function is_ascii(char: c) -> bool as "walnut_rt::str::is_ascii_char";
