        requires std::traits::is_string<S>
        function ends_with_ignore_case(const S&: a, const S&: b) -> bool {
            return detail::Native<S>::ends_with_ignore_case(a, b);
        } end function ends_with_ignore_case

        template <typename S>
        requires std::traits::is_string<S>
        function contains_ignore_case(const S&: a, const S&: b) -> bool {
            return detail::Native<S>::contains_ignore_case(a, b);
        } end function contains_ignore_case

        template <typename S>
        requires std::traits::is_string<S>
        function compare_ignore_case(const S&: a, const S&: b) -> long int {
            return detail::Native<S>::compare_ignore_case(a, b);
        } end function compare_ignore_case

        template <typename S, typename Pred>
        requires std::traits::is_string<S>
        function count_if(const S&: s, Pred: pred) -> long int {
            long int: n = 0;
            for (char: c in s) {
                if (pred(c)) then {
                    n += 1;
                }
            }
            return n;
        } end function count_if

        template <typename S, typename Pred>
        requires std::traits::is_string<S>
        function all_of(const S&: s, Pred: pred) -> bool {
            for (char: c in s) {
                if (!pred(c)) then {
                    return false;
                }
            }
            return true;
        } end function all_of

        template <typename S, typename Pred>
        requires std::traits::is_string<S>
        function any_of(const S&: s, Pred: pred) -> bool {
            for (char: c in s) {
                if (pred(c)) then {
                    return true;
                }
            }
            return false;
        } end function any_of

        template <typename S, typename Pred>
        requires std::traits::is_string<S>
        function none_of(const S&: s, Pred: pred) -> bool {
            return !any_of(s, pred);
        } end function none_of

        template <typename S, typename Pred>
        requires std::traits::is_string<S>
        function find_if(const S&: s, Pred: pred) -> long int {
            long int: i = 0;
            for (char: c in s) {
                if (pred(c)) then {
                    return i;
                }
                i += 1;
            }
            return -1;
        } end function find_if

        template <typename S, typename Pred>
        requires std::traits::is_string<S>
        function filter(const S&: s, Pred: pred) -> S {
            S: out;
            for (char: c in s) {
                if (pred(c)) then {
                    out += c;
                }
            }
            return out;
        } end function filter

        template <typename S, typename Pred>
        requires std::traits::is_string<S>
        function remove_if(const S&: s, Pred: pred) -> S {
            S: out;
            for (char: c in s) {
                if (!pred(c)) then {
                    out += c;
                }
            }
            return out;
        } end function remove_if

        template <typename S, typename Func>
        requires std::traits::is_string<S>
        function map_chars(const S&: s, Func: func) -> S {
            S: out;
            for (char: c in s) {
                out += func(c);
            }
            return out;
        } end function map_chars

        template <typename S, typename Func>
        requires std::traits::is_string<S>
        function for_each(const S&: s, Func: func) -> void {
            for (char: c in s) {
                func(c);
            }
        } end function for_each

        template <typename S, typename Pred>
        requires std::traits::is_string<S> && !std::traits::is_char<Pred>
        function where(S&: s, Pred: pred) -> std::collections::WhereQuery<S, char> {
            return std::collections::WhereQuery<S, char>::matching(s, pred);
        } end function where

        template <typename S>
        requires std::traits::is_string<S>
        function where(S&: s, char: c) -> std::collections::WhereQuery<S, char> {
            return std::collections::WhereQuery<S, char>::equal_to(s, c);
        } end function where

        template <typename S>
        requires std::traits::is_string<S>
        function char_at(const S&: s, long int: index) -> char {
            return s[index];
        } end function char_at

        template <typename S>
        requires std::traits::is_string<S>
        function sorted(const S&: s) -> S {
            S: out = s;
            std::collections::Vector<char>: cs = chars(s);
            std::algorithms::sort(cs.data(), cs.data() + cs.size());
            out = static_cast<S>("");
            for (char: c in cs) {
                out += c;
            }
            return out;
        } end function sorted

        function is_digit(char: c) -> bool {
            return detail::Chars::is_digit(c);
        } end function is_digit

