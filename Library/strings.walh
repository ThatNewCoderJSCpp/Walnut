                    static function words(const S&: s, std::collections::Vector<S>&: out) -> void as "walnut_rt::str::words";
                    static function chunks(const S&: s, long int: size, std::collections::Vector<S>&: out) -> void as "walnut_rt::str::chunks";
                    static function chars(const S&: s, std::collections::Vector<char>&: out) -> void as "walnut_rt::str::chars";
