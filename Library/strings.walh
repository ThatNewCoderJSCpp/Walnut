        function right(const S&: s, long int: count) -> S {
            return detail::Native<S>::right(s, count);
        } end function right

        template <typename S>
        requires std::traits::is_string<S>
        function truncate(const S&: s, long int: width) -> S {
            return detail::Native<S>::truncate(s, width, static_cast<S>("..."));
        } end function truncate

        template <typename S>
        requires std::traits::is_string<S>
        function truncate(const S&: s, long int: width, const S&: ellipsis) -> S {
