        requires std::traits::is_string<S>
        function equals_ignore_case(const S&: a, const S&: b) -> bool {
            return detail::Native<S>::equals_ignore_case(a, b);
        } end function equals_ignore_case

        template <typename S>
        requires std::traits::is_string<S>
        function starts_with_ignore_case(const S&: a, const S&: b) -> bool {
            return detail::Native<S>::starts_with_ignore_case(a, b);
        } end function starts_with_ignore_case

