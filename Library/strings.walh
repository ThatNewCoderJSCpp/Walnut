                    static function trim_left(const S&: s) -> S as "walnut_rt::str::trim_left";
                    static function trim_right(const S&: s) -> S as "walnut_rt::str::trim_right";
                    static function trim_all(const S&: s) -> S as "walnut_rt::str::trim_all";
                    static function trim_chars(const S&: s, const S&: chars) -> S as "walnut_rt::str::trim_chars";
                    static function upper(const S&: s) -> S as "walnut_rt::str::upper";
                    static function lower(const S&: s) -> S as "walnut_rt::str::lower";
                    static function capitalize(const S&: s) -> S as "walnut_rt::str::capitalize";
                    static function title_case(const S&: s) -> S as "walnut_rt::str::title_case";
                    static function swap_case(const S&: s) -> S as "walnut_rt::str::swap_case";
                    static function reverse(const S&: s) -> S as "walnut_rt::str::reverse";
                    static function repeated(const S&: s, long int: times) -> S as "walnut_rt::str::repeated";
