        template <typename S, typename N>
        requires std::traits::is_string<S> && (std::traits::is_string<N> || std::traits::is_char<N>)
        function find(const S&: s, const N&: needle) -> long int {
            return detail::Native<S, N>::find_from(s, needle, 0);
        } end function find

