        } end function insert

        template <typename S>
        requires std::traits::is_string<S>
        function erase(const S&: s, long int: index, long int: count = 1) -> S {
            return detail::Native<S>::erase(s, index, count);
        } end function erase

        template <typename S>
        requires std::traits::is_string<S>
        function slice(const S&: s, long int: start, long int: stop) -> S {
            return detail::Native<S>::slice(s, start, stop);
        } end function slice

        template <typename S>
        requires std::traits::is_string<S>
        function substring(const S&: s, long int: start, long int: stop) -> S {
            return detail::Native<S>::slice(s, start, stop);
        } end function substring

        template <typename S>
        requires std::traits::is_string<S>
        function left(const S&: s, long int: count) -> S {
            return detail::Native<S>::left(s, count);
        } end function left

