import module.collections
import module.colors

safe(compile) {
    namespace std {
        namespace errors {
            class typography_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class typography_error
        } end namespace errors

        namespace typography {
            using std::colors::Color;

            enum FontWeight { thin, extra_light, light, normal, medium, semi_bold, bold, extra_bold, black }

            enum TextAlign { left, center, right, justify }

            enum TextOverflow { visible, clip, ellipsis, word_wrap }

            enum TextTransform { none, uppercase, lowercase, capitalize }

            struct TextMetrics {
                long int: width = 0;
                long int: height = 0;
                long int: ascent = 0;
                long int: descent = 0;

                constructor() { }

                constructor(long int: w, long int: h, long int: a, long int: d) : width = w, height = h, ascent = a, descent = d { }

                function is_empty(const self&) -> bool {
                    return self.width == 0 && self.height == 0;
                } end function is_empty

                function to_string(const self&) -> string {
                    return static_cast<string>(`${self.width} by ${self.height} (ascent ${self.ascent}, descent ${self.descent})`);
                } end function to_string
            } end struct TextMetrics

            hidden namespace detail {
                extern "C++" from "<walnut_graphics.hpp>" {
                    class Native as "walnut_rt::gfx::typography_api" {
                    public:
                        static function font_names() -> std::collections::Vector<string> as "walnut_rt::gfx::font_names";
                    } end class Native
                } end extern
            } end namespace detail

            function font_names() -> std::collections::Vector<string> {
                return detail::Native::font_names();
            } end function font_names

            extern "C++" from "<walnut_graphics.hpp>" {
                class TextStyle as "walnut_rt::gfx::text_style" {
                    function native_set_font(self&, const string&: name) -> bool as "set_font";
                    function native_set_color(self&, long int: rgba) -> void as "set_color";
                    function native_color(const self&) -> long int as "color_value";
                    function native_set_background(self&, long int: rgba) -> void as "set_background";
                    function native_set_weight(self&, long int: weight) -> void as "set_weight";
                    function native_weight(const self&) -> long int as "weight";
                    function native_set_align(self&, long int: a) -> void as "set_align";
                    function native_align(const self&) -> long int as "align";
                    function native_set_overflow(self&, long int: o) -> void as "set_overflow";
                    function native_set_transform(self&, long int: t) -> void as "set_transform";
                    function native_set_outline(self&, long int: rgba, float: width) -> void as "set_outline";
                    function native_set_shadow(self&, float: dx, float: dy, float: blur, long int: rgba) -> void as "set_shadow";

                public:
                    constructor();
                    constructor(float: size, long int: rgba);

                    static function make(float: size, const Color&: color = Color(0, 0, 0)) -> TextStyle {
                        return TextStyle(size, color.packed());
                    } end function make

                    static function is_font(const string&: name) -> bool {
                        TextStyle: probe;
                        return probe.native_set_font(name);
                    } end function is_font

                    function set_font(self&, const string&: name) -> void {
                        if (!self.native_set_font(name)) then {
                            throw std::errors::typography_error(static_cast<string>(`'${name}' is not a font Fizmo knows; std::typography::font_names() lists them`));
                        }
                    } end function set_font

                    function font(const self&) -> string;
                    function clear_font(self&) -> void;
                    function set_size(self&, float: px) -> void;
                    function size(const self&) -> float;
                    function set_bold(self&, bool: on = true) -> void;
                    function bold(const self&) -> bool;
                    function set_italic(self&, bool: on = true) -> void;
                    function italic(const self&) -> bool;
                    function set_underline(self&, bool: on = true) -> void;
                    function underline(const self&) -> bool;
                    function set_strikethrough(self&, bool: on = true) -> void;
                    function strikethrough(const self&) -> bool;
                    function set_overline(self&, bool: on = true) -> void;
                    function overline(const self&) -> bool;
                    function set_letter_spacing(self&, float: px) -> void;
                    function letter_spacing(const self&) -> float;
                    function set_word_spacing(self&, float: px) -> void;
                    function set_line_height(self&, float: multiple) -> void;
                    function line_height(const self&) -> float;
                    function set_opacity(self&, float: opacity) -> void;
                    function clear_background(self&) -> void;
                    function clear_outline(self&) -> void;
                    function clear_shadow(self&) -> void;
                    function set_max_lines(self&, long int: count) -> void;
                    function set_indent(self&, float: px) -> void;

                    function set_color(self&, const Color&: c) -> void {
                        self.native_set_color(c.packed());
                    } end function set_color

                    function color(const self&) -> Color {
                        return Color::from_packed(self.native_color());
                    } end function color

                    function set_background(self&, const Color&: c) -> void {
                        self.native_set_background(c.packed());
                    } end function set_background

                    function set_weight(self&, FontWeight: weight) -> void {
                        self.native_set_weight((static_cast<long int>(weight) + 1) * 100);
                    } end function set_weight

                    function weight(const self&) -> FontWeight {
                        long int: index = self.native_weight() / 100 - 1;
                        if (index < 0) then {
                            index = 0;
                        }
                        if (index > 8) then {
                            index = 8;
                        }
                        return static_cast<FontWeight>(index);
                    } end function weight

                    function set_align(self&, TextAlign: a) -> void {
                        self.native_set_align(static_cast<long int>(a));
                    } end function set_align

                    function align(const self&) -> TextAlign {
                        return static_cast<TextAlign>(self.native_align());
                    } end function align

                    function set_overflow(self&, TextOverflow: o) -> void {
                        self.native_set_overflow(static_cast<long int>(o));
                    } end function set_overflow

                    function set_transform(self&, TextTransform: t) -> void {
                        self.native_set_transform(static_cast<long int>(t));
                    } end function set_transform

                    function set_outline(self&, const Color&: c, float: width = 1.0) -> void {
                        self.native_set_outline(c.packed(), width);
                    } end function set_outline

                    function set_shadow(self&, float: dx, float: dy, float: blur = 0.0, const Color&: c = Color(0, 0, 0, 128)) -> void {
                        self.native_set_shadow(dx, dy, blur, c.packed());
                    } end function set_shadow
                } end class TextStyle
            } end extern
        } end namespace typography
    } end namespace std
} end safe
