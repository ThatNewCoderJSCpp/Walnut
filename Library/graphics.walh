                    } end function play

                    function play(self&, const string&: name, bool: loop, float: fade_seconds, float: speed) -> bool {
                        return self.native_play(name, loop, fade_seconds, speed);
                    } end function play

                    function play(self&, long int: index, bool: loop = true, float: fade_seconds = 0.0) -> bool {
                        return self.native_play_index(index, loop, fade_seconds, 1.0);
                    } end function play

                    function play(self&, long int: index, bool: loop, float: fade_seconds, float: speed) -> bool {
                        return self.native_play_index(index, loop, fade_seconds, speed);
                    } end function play

                    function valid(const self&) -> bool;
                    function stop(self&) -> void;
                    function set_speed(self&, float: speed) -> void;
                    function set_time(self&, float: seconds) -> void;
                    function time(const self&) -> float;
                    function duration(const self&) -> float;
                    function finished(const self&) -> bool;
                    function current(const self&) -> long int;
