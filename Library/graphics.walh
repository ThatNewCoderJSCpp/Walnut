                class TileMap as "walnut_rt::gfx::tilemap" {
                    static function native_load(const string&: path) -> TileMap as "walnut_rt::gfx::tilemap::load_tiled";
                    static function native_load_error() -> string as "walnut_rt::gfx::tilemap::load_error";
                    function native_add_tileset(self&, const Texture&: t, long int: tw, long int: th, long int: margin, long int: spacing, long int: columns) -> long int as "add_tileset";
                    function native_add_layer_csv(self&, const string&: name, const string&: csv, long int: offset) -> long int as "add_layer_csv";
                    function native_set_layer_tint(self&, long int: layer, long int: rgba) -> void as "set_layer_tint";
                    function native_move(self&, float: x, float: y, float: w, float: h, float: dx, float: dy) -> void as "move";
                    function native_move_x(const self&) -> float as "move_x";
                    function native_move_y(const self&) -> float as "move_y";
                    function native_move_flags(const self&) -> long int as "move_flags";
                    function native_raycast(self&, float: ox, float: oy, float: dx, float: dy, float: max_distance) -> void as "raycast";
                    function native_hit(const self&) -> bool as "hit";
                    function native_hit_tile_x(const self&) -> long int as "hit_tile_x";
                    function native_hit_tile_y(const self&) -> long int as "hit_tile_y";
                    function native_hit_gid(const self&) -> long int as "hit_gid";
                    function native_hit_value(const self&, long int: which) -> float as "hit_value";
                    function native_set_animation(self&, long int: gid, const std::collections::Vector<long int>&: frames, const std::collections::Vector<float>&: seconds) -> void as "set_animation";

                    function check_layer(const self&, long int: layer, const string&: what) -> void {
                        if (layer < 0 || layer >= self.layer_count()) then {
                            throw std::errors::graphics_error(static_cast<string>(`${what}: there is no layer ${layer} (the map has ${self.layer_count()})`));
                        }
                    } end function check_layer

                public:
                    constructor();
                    constructor(long int: tile_width, long int: tile_height);

                    static function load_tiled(const string&: path) -> TileMap {
                        TileMap: m = native_load(path);
                        const string: problem = native_load_error();
                        if (problem.size() > 0) then {
                            throw std::errors::graphics_error(static_cast<string>(`can't load the map '${path}': ${problem}`));
                        }
                        return m;
                    } end function load_tiled

                    function tile_width(const self&) -> long int;
                    function tile_height(const self&) -> long int;
                    function tileset_count(const self&) -> long int;
                    function layer_count(const self&) -> long int;
                    function layer_index(const self&, const string&: name) -> long int;
                    function layer_name(const self&, long int: layer) -> string;
                    function layer_width(const self&, long int: layer) -> long int;
                    function layer_height(const self&, long int: layer) -> long int;
                    function add_layer(self&, const string&: name, long int: width, long int: height) -> long int;
                    function set_layer_visible(self&, long int: layer, bool: visible) -> void;
                    function set_layer_collides(self&, long int: layer, bool: collides) -> void;
                    function set_layer_opacity(self&, long int: layer, float: opacity) -> void;
                    function set_layer_offset(self&, long int: layer, float: x, float: y) -> void;
                    function set_layer_parallax(self&, long int: layer, float: x, float: y) -> void;
                    function set_solid(self&, long int: gid, bool: solid) -> void;
                    function solid(const self&, long int: gid) -> bool;
                    function update(self&, float: dt) -> void;
                    function world_to_tile_x(const self&, float: x) -> long int;
                    function world_to_tile_y(const self&, float: y) -> long int;
                    function tile_to_world_x(const self&, long int: x) -> float;
                    function tile_to_world_y(const self&, long int: y) -> float;
                    function solid_at_tile(const self&, long int: x, long int: y) -> bool;
                    function solid_at(const self&, float: x, float: y) -> bool;
                    function overlaps_solid(const self&, float: x, float: y, float: w, float: h) -> bool;
                    function pixel_width(const self&) -> float;
                    function pixel_height(const self&) -> float;
                    function get(const self&, long int: layer, long int: x, long int: y) -> long int;
                    function set(self&, long int: layer, long int: x, long int: y, long int: gid) -> void;
                    function fill(self&, long int: layer, long int: gid) -> void;
                    function fill_rect(self&, long int: layer, long int: x, long int: y, long int: w, long int: h, long int: gid) -> void;

                    function add_tileset(self&, const Texture&: texture, long int: tile_width, long int: tile_height) -> long int {
                        return self.native_add_tileset(texture, tile_width, tile_height, 0, 0, 0);
                    } end function add_tileset

                    function add_tileset(self&, const Texture&: texture, long int: tile_width, long int: tile_height, long int: margin, long int: spacing) -> long int {
                        return self.native_add_tileset(texture, tile_width, tile_height, margin, spacing, 0);
                    } end function add_tileset

                    function add_layer_csv(self&, const string&: name, const string&: csv, long int: id_offset = 0) -> long int {
                        const long int: index = self.native_add_layer_csv(name, csv, id_offset);
                        if (index < 0) then {
                            throw std::errors::graphics_error(static_cast<string>(`add_layer_csv: the CSV for '${name}' isn't a grid of tile numbers`));
                        }
                        return index;
                    } end function add_layer_csv

                    function tile(const self&, long int: layer, long int: x, long int: y) -> long int {
                        self.check_layer(layer, "tile()");
                        return self.get(layer, x, y);
                    } end function tile

                    function set_tile(self&, long int: layer, long int: x, long int: y, long int: gid) -> void {
                        self.check_layer(layer, "set_tile()");
                        self.set(layer, x, y, gid);
                    } end function set_tile

                    function fill_layer(self&, long int: layer, long int: gid) -> void {
                        self.check_layer(layer, "fill_layer()");
                        self.fill(layer, gid);
                    } end function fill_layer

                    function set_layer_tint(self&, long int: layer, const Color&: c) -> void {
                        self.native_set_layer_tint(layer, c.packed());
                    } end function set_layer_tint

                    function set_animation(self&, long int: gid, const std::collections::Vector<long int>&: frames, const std::collections::Vector<float>&: seconds) -> void {
                        self.native_set_animation(gid, frames, seconds);
                    } end function set_animation

                    function move(self&, float: x, float: y, float: w, float: h, float: dx, float: dy) -> TileMove {
                        self.native_move(x, y, w, h, dx, dy);
                        TileMove: out;
                        out.x = self.native_move_x();
                        out.y = self.native_move_y();
                        const long int: f = self.native_move_flags();
                        out.hit_x = f % 2 == 1;
                        out.hit_y = (f / 2) % 2 == 1;
                        out.on_ground = (f / 4) % 2 == 1;
                        out.on_ceiling = (f / 8) % 2 == 1;
                        out.on_left = (f / 16) % 2 == 1;
                        out.on_right = (f / 32) % 2 == 1;
                        return out;
                    } end function move

                    function raycast(self&, float: ox, float: oy, float: dx, float: dy, float: max_distance) -> TileHit {
                        self.native_raycast(ox, oy, dx, dy, max_distance);
                        TileHit: out;
                        out.hit = self.native_hit();
                        out.tile_x = self.native_hit_tile_x();
                        out.tile_y = self.native_hit_tile_y();
                        out.gid = self.native_hit_gid();
                        out.distance = self.native_hit_value(0);
                        out.x = self.native_hit_value(1);
                        out.y = self.native_hit_value(2);
                        out.normal_x = self.native_hit_value(3);
                        out.normal_y = self.native_hit_value(4);
                        return out;
                    } end function raycast
                } end class TileMap

                class Renderer as "walnut_rt::gfx::renderer" {
                    function native_clear(self&, long int: rgba) -> void as "clear";
                    function native_set_blend_mode(self&, long int: m) -> void as "set_blend_mode";
                    function native_blend_mode(const self&) -> long int as "blend_mode";
                    function native_pixel(self&, float: x, float: y, long int: rgba) -> void as "pixel";
                    function native_line(self&, float: x1, float: y1, float: x2, float: y2, const Paint&: p) -> void as "line";
                    function native_rect(self&, float: x, float: y, float: w, float: h, const Paint&: p) -> void as "rect";
                    function native_rounded_rect(self&, float: x, float: y, float: w, float: h, float: r, const Paint&: p) -> void as "rounded_rect";
                    function native_circle(self&, float: cx, float: cy, float: r, const Paint&: p) -> void as "circle";
                    function native_ellipse(self&, float: cx, float: cy, float: rx, float: ry, const Paint&: p) -> void as "ellipse";
                    function native_arc(self&, float: cx, float: cy, float: rx, float: ry, const Paint&: p) -> void as "arc";
                    function native_triangle(self&, float: x1, float: y1, float: x2, float: y2, float: x3, float: y3, const Paint&: p) -> void as "triangle";
                    function native_polygon(self&, const std::collections::Vector<float>&: xs, const std::collections::Vector<float>&: ys, const Paint&: p) -> void as "polygon";
                    function native_polyline(self&, const std::collections::Vector<float>&: xs, const std::collections::Vector<float>&: ys, const Paint&: p, bool: closed) -> void as "polyline";
                    function native_path(self&, const Path&: path, const Paint&: p) -> void as "draw_path";
                    function native_image(self&, const Image&: img, float: x, float: y) -> void as "draw_image";
                    function native_image_sized(self&, const Image&: img, float: x, float: y, float: w, float: h) -> void as "draw_image_sized";
                    function native_texture(self&, const Texture&: t, float: x, float: y, float: opacity) -> void as "draw_texture";
                    function native_texture_sized(self&, const Texture&: t, float: x, float: y, float: w, float: h, float: opacity) -> void as "draw_texture_sized";
                    function native_texture_part(self&, const Texture&: t, float: x, float: y, float: w, float: h, long int: sx, long int: sy, long int: sw, long int: sh, long int: tint, float: opacity) -> void as "draw_texture_part";
                    function native_sprite(self&, const Sprite&: s) -> void as "draw_sprite";
                    function native_text(self&, float: x, float: y, const string&: s, const TextStyle&: style) -> void as "text";
                    function native_text_box(self&, float: x, float: y, float: w, float: h, const string&: s, const TextStyle&: style) -> void as "text_box";
                    function native_measure(self&, const string&: s, const TextStyle&: style, long int: max_width, long int: which) -> long int as "measure";
                    function native_begin_camera(self&, float: x, float: y, float: zoom, float: rotation) -> void as "begin_camera";
                    function native_begin_target(self&, const RenderTarget&: t, long int: rgba, bool: clear) -> bool as "begin_target";
                    function native_draw_target(self&, const RenderTarget&: t, float: x, float: y, float: w, float: h, float: opacity) -> void as "draw_target";
                    function native_load_font(self&, const string&: file) -> bool as "load_font_file";
                    function valid(const self&) -> bool;

                public:
                    constructor();
                    constructor(const Window&: window, long int: backend, bool: vsync);

                    static function make(const Window&: window, Backend: backend = Backend::best, bool: vsync = false) -> Renderer {
                        Renderer: r = Renderer(window, static_cast<long int>(backend), vsync);
                        if (!r.valid()) then {
                            throw std::errors::graphics_error("can't start a renderer for this window; is it open?");
                        }
                        return r;
                    } end function make

                    function is_ready(const self&) -> bool {
                        return self.valid();
                    } end function is_ready

                    function backend_name(const self&) -> string;
                    function is_gpu(const self&) -> bool;
                    function set_vsync(self&, bool: on) -> void;
                    function vsync(const self&) -> bool;
                    function width(const self&) -> long int;
                    function height(const self&) -> long int;
                    function frame_ms(const self&) -> float;
                    function begin_frame(self&) -> void;
                    function present(self&) -> void;
                    function capture(self&) -> Image;
                    function push(self&) -> void;
                    function pop(self&) -> void;
                    function reset_transform(self&) -> void;
                    function translate(self&, float: dx, float: dy) -> void;
                    function rotate(self&, float: degrees) -> void;
                    function scale(self&, float: sx, float: sy) -> void;
                    function set_clip(self&, float: x, float: y, float: w, float: h) -> void;
                    function reset_clip(self&) -> void;
                    function end_camera(self&) -> void;
                    function end_target(self&) -> void;
                    function read_target(self&, const RenderTarget&: target) -> Image;

                    function scale(self&, float: s) -> void {
                        self.scale(s, s);
                    } end function scale

                    function clear(self&, const Color&: c = Color(0, 0, 0)) -> void {
                        self.native_clear(c.packed());
                    } end function clear

                    function set_blend_mode(self&, BlendMode: m) -> void {
                        self.native_set_blend_mode(static_cast<long int>(m));
                    } end function set_blend_mode

                    function blend_mode(const self&) -> BlendMode {
                        return static_cast<BlendMode>(self.native_blend_mode());
                    } end function blend_mode

                    function begin_camera(self&, const Camera&: camera) -> void {
                        self.native_begin_camera(camera.x, camera.y, camera.zoom, camera.rotation);
                    } end function begin_camera

                    function draw_pixel(self&, float: x, float: y, const Color&: c) -> void {
                        self.native_pixel(x, y, c.packed());
                    } end function draw_pixel

                    function draw_line(self&, float: x1, float: y1, float: x2, float: y2, const Paint&: p) -> void {
                        self.native_line(x1, y1, x2, y2, p);
                    } end function draw_line

                    function draw_line(self&, float: x1, float: y1, float: x2, float: y2, const Color&: c, float: width = 1.0) -> void {
                        self.native_line(x1, y1, x2, y2, Paint::stroke(c, width));
                    } end function draw_line

                    function draw_rect(self&, float: x, float: y, float: w, float: h, const Paint&: p) -> void {
                        self.native_rect(x, y, w, h, p);
                    } end function draw_rect

                    function fill_rect(self&, float: x, float: y, float: w, float: h, const Color&: c) -> void {
                        self.native_rect(x, y, w, h, Paint::fill(c));
                    } end function fill_rect

                    function stroke_rect(self&, float: x, float: y, float: w, float: h, const Color&: c, float: width = 1.0) -> void {
                        self.native_rect(x, y, w, h, Paint::stroke(c, width));
                    } end function stroke_rect

                    function draw_rounded_rect(self&, float: x, float: y, float: w, float: h, float: radius, const Paint&: p) -> void {
                        self.native_rounded_rect(x, y, w, h, radius, p);
                    } end function draw_rounded_rect

                    function draw_circle(self&, float: cx, float: cy, float: radius, const Paint&: p) -> void {
                        self.native_circle(cx, cy, radius, p);
                    } end function draw_circle

                    function fill_circle(self&, float: cx, float: cy, float: radius, const Color&: c) -> void {
                        self.native_circle(cx, cy, radius, Paint::fill(c));
                    } end function fill_circle

                    function stroke_circle(self&, float: cx, float: cy, float: radius, const Color&: c, float: width = 1.0) -> void {
                        self.native_circle(cx, cy, radius, Paint::stroke(c, width));
                    } end function stroke_circle

                    function draw_ellipse(self&, float: cx, float: cy, float: rx, float: ry, const Paint&: p) -> void {
                        self.native_ellipse(cx, cy, rx, ry, p);
                    } end function draw_ellipse

                    function draw_arc(self&, float: cx, float: cy, float: rx, float: ry, const Paint&: p) -> void {
                        self.native_arc(cx, cy, rx, ry, p);
                    } end function draw_arc

                    function draw_triangle(self&, float: x1, float: y1, float: x2, float: y2, float: x3, float: y3, const Paint&: p) -> void {
                        self.native_triangle(x1, y1, x2, y2, x3, y3, p);
                    } end function draw_triangle

                    function draw_polygon(self&, const std::collections::Vector<Point>&: points, const Paint&: p) -> void {
                        self.native_polygon(detail::xs_of(points), detail::ys_of(points), p);
                    } end function draw_polygon

                    function draw_polyline(self&, const std::collections::Vector<Point>&: points, const Paint&: p, bool: closed = false) -> void {
                        self.native_polyline(detail::xs_of(points), detail::ys_of(points), p, closed);
                    } end function draw_polyline

                    function draw_path(self&, const Path&: path, const Paint&: p) -> void {
                        self.native_path(path, p);
                    } end function draw_path

                    function draw_image(self&, const Image&: img, float: x, float: y) -> void {
                        self.native_image(img, x, y);
                    } end function draw_image

                    function draw_image(self&, const Image&: img, float: x, float: y, float: w, float: h) -> void {
                        self.native_image_sized(img, x, y, w, h);
                    } end function draw_image

                    function draw_texture(self&, const Texture&: t, float: x, float: y, float: opacity = 1.0) -> void {
                        self.native_texture(t, x, y, opacity);
                    } end function draw_texture

                    function draw_texture(self&, const Texture&: t, float: x, float: y, float: w, float: h, float: opacity = 1.0) -> void {
                        self.native_texture_sized(t, x, y, w, h, opacity);
                    } end function draw_texture

                    function draw_texture_part(self&, const Texture&: t, float: x, float: y, float: w, float: h, long int: sx, long int: sy, long int: sw, long int: sh, const Color&: tint = Color(255, 255, 255), float: opacity = 1.0) -> void {
                        self.native_texture_part(t, x, y, w, h, sx, sy, sw, sh, tint.packed(), opacity);
                    } end function draw_texture_part

                    function draw_sprite(self&, const Sprite&: s) -> void {
                        self.native_sprite(s);
                    } end function draw_sprite

                    function draw_text(self&, float: x, float: y, const string&: s, const TextStyle&: style) -> void {
                        self.native_text(x, y, s, style);
                    } end function draw_text

                    function draw_text(self&, float: x, float: y, float: w, float: h, const string&: s, const TextStyle&: style) -> void {
                        self.native_text_box(x, y, w, h, s, style);
                    } end function draw_text

                    function measure_text(self&, const string&: s, const TextStyle&: style, long int: max_width = 0) -> TextMetrics {
                        return TextMetrics(self.native_measure(s, style, max_width, 0), self.native_measure(s, style, max_width, 1), self.native_measure(s, style, max_width, 2), self.native_measure(s, style, max_width, 3));
                    } end function measure_text

                    function load_font(self&, const string&: file) -> void {
                        if (!self.native_load_font(file)) then {
                            throw std::errors::graphics_error(static_cast<string>(`can't load the font file '${file}'`));
                        }
                    } end function load_font

                    function begin_target(self&, const RenderTarget&: target) -> void {
                        if (!self.native_begin_target(target, 0, false)) then {
                            throw std::errors::graphics_error("can't draw into this render target");
                        }
                    } end function begin_target

                    function begin_target(self&, const RenderTarget&: target, const Color&: clear_color) -> void {
                        if (!self.native_begin_target(target, clear_color.packed(), true)) then {
                            throw std::errors::graphics_error("can't draw into this render target");
                        }
                    } end function begin_target

                    function draw_target(self&, const RenderTarget&: target, float: x, float: y, float: opacity = 1.0) -> void {
                        self.native_draw_target(target, x, y, static_cast<float>(target.width()), static_cast<float>(target.height()), opacity);
                    } end function draw_target

                    function draw_target(self&, const RenderTarget&: target, float: x, float: y, float: w, float: h, float: opacity = 1.0) -> void {
                        self.native_draw_target(target, x, y, w, h, opacity);
                    } end function draw_target

                private:
                    function native_begin_3d(self&, Camera3D&: camera) -> bool as "walnut_rt::gfx::begin_3d";
                    function native_end_3d(self&) -> void as "walnut_rt::gfx::end_3d";
                    function native_set_light(self&, float: dx, float: dy, float: dz, float: ambient, float: diffuse) -> void as "walnut_rt::gfx::set_light";
                    function native_set_lighting(self&, const Lighting&: l) -> void as "walnut_rt::gfx::set_lighting";
                    function native_draw_mesh(self&, const Mesh&: m, const Material&: mat) -> void as "walnut_rt::gfx::draw_mesh";
                    function native_draw_mesh_at(self&, const Mesh&: m, float: px, float: py, float: pz, float: rx, float: ry, float: rz, float: sx, float: sy, float: sz, const Material&: mat) -> void as "walnut_rt::gfx::draw_mesh_at";
                    function native_draw_model(self&, const Model&: m, float: px, float: py, float: pz, float: rx, float: ry, float: rz, float: sx, float: sy, float: sz) -> void as "walnut_rt::gfx::draw_model";
                    function native_draw_animated(self&, const Animator&: a, float: px, float: py, float: pz, float: rx, float: ry, float: rz, float: sx, float: sy, float: sz) -> void as "walnut_rt::gfx::draw_animated";
                    function native_line_3d(self&, float: ax, float: ay, float: az, float: bx, float: by, float: bz, long int: rgba, float: width, bool: depth_test) -> void as "walnut_rt::gfx::draw_line_3d";
                    function native_box_3d(self&, float: ax, float: ay, float: az, float: bx, float: by, float: bz, long int: rgba, float: width, bool: depth_test) -> void as "walnut_rt::gfx::draw_box_3d";
                    function native_draw_tilemap(self&, const TileMap&: map, float: x, float: y) -> long int as "walnut_rt::gfx::draw_tilemap";

                public:
                    function begin_3d(self&, Camera3D&: camera) -> void {
                        if (!self.native_begin_3d(camera)) then {
                            throw std::errors::graphics_error("can't start 3D drawing; call begin_3d between begin_frame and present");
                        }
                    } end function begin_3d

                    function end_3d(self&) -> void {
                        self.native_end_3d();
                    } end function end_3d

                    function set_light(self&, const Vec3&: direction) -> void {
                        self.native_set_light(direction.x, direction.y, direction.z, 0.45, 0.55);
                    } end function set_light

                    function set_light(self&, const Vec3&: direction, float: ambient, float: diffuse) -> void {
                        self.native_set_light(direction.x, direction.y, direction.z, ambient, diffuse);
                    } end function set_light

                    function set_lighting(self&, const Lighting&: lighting) -> void {
                        self.native_set_lighting(lighting);
                    } end function set_lighting

                    function draw_mesh(self&, const Mesh&: mesh) -> void {
                        self.native_draw_mesh(mesh, Material());
                    } end function draw_mesh

                    function draw_mesh(self&, const Mesh&: mesh, const Material&: material) -> void {
                        self.native_draw_mesh(mesh, material);
                    } end function draw_mesh

                    function draw_mesh(self&, const Mesh&: mesh, const Transform3D&: t, const Material&: material = Material()) -> void {
                        self.native_draw_mesh_at(mesh, t.position.x, t.position.y, t.position.z, t.rotation.x, t.rotation.y, t.rotation.z, t.scale.x, t.scale.y, t.scale.z, material);
                    } end function draw_mesh

                    function draw_model(self&, const Model&: model, const Transform3D&: t = Transform3D()) -> void {
                        self.native_draw_model(model, t.position.x, t.position.y, t.position.z, t.rotation.x, t.rotation.y, t.rotation.z, t.scale.x, t.scale.y, t.scale.z);
                    } end function draw_model

                    function draw_model(self&, const Animator&: animator, const Transform3D&: t = Transform3D()) -> void {
                        self.native_draw_animated(animator, t.position.x, t.position.y, t.position.z, t.rotation.x, t.rotation.y, t.rotation.z, t.scale.x, t.scale.y, t.scale.z);
                    } end function draw_model

                    function draw_line_3d(self&, const Vec3&: a, const Vec3&: b, const Color&: c, float: width = 1.0, bool: depth_test = true) -> void {
                        self.native_line_3d(a.x, a.y, a.z, b.x, b.y, b.z, c.packed(), width, depth_test);
                    } end function draw_line_3d

                    function draw_box_3d(self&, const Vec3&: low, const Vec3&: high, const Color&: c, float: width = 1.0, bool: depth_test = true) -> void {
                        self.native_box_3d(low.x, low.y, low.z, high.x, high.y, high.z, c.packed(), width, depth_test);
                    } end function draw_box_3d

                    function draw_tilemap(self&, const TileMap&: map) -> long int {
                        return self.native_draw_tilemap(map, 0.0, 0.0);
                    } end function draw_tilemap

                    function draw_tilemap(self&, const TileMap&: map, float: x, float: y) -> long int {
                        return self.native_draw_tilemap(map, x, y);
                    } end function draw_tilemap
                } end class Renderer

                class Particles as "walnut_rt::gfx::particles" {
                    function native_add_emitter(self&, const string&: preset, const string&: dimension, float: pixels_per_unit) -> long int as "add_emitter";
                    function native_add_effect(self&, const string&: preset, const string&: dimension, float: pixels_per_unit) -> long int as "add_effect";
                    function native_step_camera(self&, float: seconds, const Camera3D&: camera) -> void as "step_camera";
                    function native_draw_camera(self&, Renderer&: renderer, const Camera3D&: camera) -> long int as "draw_camera";
                    function native_count_of(const self&, long int: emitter) -> long int as "count_of";
                    function native_clear_emitter(self&, long int: emitter) -> void as "clear_emitter";

                public:
                    constructor();
                    constructor(long int: budget);

                    function add_emitter(self&, const string&: preset) -> long int {
                        return self.native_add_emitter(preset, "3d", 50.0);
                    } end function add_emitter

                    function add_emitter(self&, const string&: preset, const string&: dimension) -> long int {
                        return self.native_add_emitter(preset, dimension, 50.0);
                    } end function add_emitter

                    function add_emitter(self&, const string&: preset, const string&: dimension, float: pixels_per_unit) -> long int {
                        return self.native_add_emitter(preset, dimension, pixels_per_unit);
                    } end function add_emitter

                    function add_emitter_text(self&, const string&: settings) -> long int;
                    function settings_text(const self&, long int: emitter) -> string;
                    function set_setting(self&, long int: emitter, const string&: key, const string&: value) -> void;
                    function setting(const self&, long int: emitter, const string&: key) -> string;

                    function set_position(self&, long int: emitter, float: x, float: y, float: z) -> void;
                    function teleport(self&, long int: emitter, float: x, float: y, float: z) -> void;
                    function set_direction(self&, long int: emitter, float: x, float: y, float: z) -> void;
                    function set_orientation(self&, long int: emitter, float: fx, float: fy, float: fz, float: ux, float: uy, float: uz) -> void;
                    function set_angle(self&, long int: emitter, float: degrees) -> void;
                    function set_velocity(self&, long int: emitter, float: x, float: y, float: z) -> void;
                    function clear_velocity(self&, long int: emitter) -> void;
                    function set_texture(self&, long int: emitter, const Texture&: t) -> void;

                    function set_position(self&, long int: emitter, float: x, float: y) -> void {
                        self.set_position(emitter, x, y, 0.0);
                    } end function set_position

                    function set_position(self&, long int: emitter, const Vec3&: p) -> void {
                        self.set_position(emitter, p.x, p.y, p.z);
                    } end function set_position

                    function set_direction(self&, long int: emitter, const Vec3&: d) -> void {
                        self.set_direction(emitter, d.x, d.y, d.z);
                    } end function set_direction

                    function play(self&, long int: emitter) -> void;
                    function stop(self&, long int: emitter) -> void;
                    function pause(self&, long int: emitter, bool: paused) -> void;
                    function restart(self&, long int: emitter) -> void;
                    function burst(self&, long int: emitter, long int: count) -> long int;
                    function remove(self&, long int: emitter) -> void;
                    function exists(const self&, long int: emitter) -> bool;
                    function playing(const self&, long int: emitter) -> bool;
                    function finished(const self&, long int: emitter) -> bool;
                    function count(const self&) -> long int;
                    function emitter_count(const self&) -> long int;
                    function clear(self&) -> void;

                    function count(const self&, long int: emitter) -> long int {
                        return self.native_count_of(emitter);
                    } end function count

                    function clear(self&, long int: emitter) -> void {
                        self.native_clear_emitter(emitter);
                    } end function clear

                    function add_effect(self&, const string&: preset) -> long int {
                        return self.native_add_effect(preset, "3d", 50.0);
                    } end function add_effect

                    function add_effect(self&, const string&: preset, const string&: dimension) -> long int {
                        return self.native_add_effect(preset, dimension, 50.0);
                    } end function add_effect

                    function add_effect(self&, const string&: preset, const string&: dimension, float: pixels_per_unit) -> long int {
                        return self.native_add_effect(preset, dimension, pixels_per_unit);
                    } end function add_effect

                    function add_effect_text(self&, const string&: settings) -> long int;
                    function spawn(self&, long int: effect, float: x, float: y, float: z) -> bool;
                    function spawn_2d(self&, long int: effect, float: x, float: y, float: angle) -> bool;

                    function spawn_2d(self&, long int: effect, float: x, float: y) -> bool {
                        return self.spawn_2d(effect, x, y, 0.0);
                    } end function spawn_2d

                    function set_budget(self&, long int: budget) -> void;
                    function set_threads(self&, long int: count) -> void;
                    function set_origin(self&, float: x, float: y, float: z) -> void;
                    function add_ground(self&, float: height) -> void;
                    function add_plane(self&, float: nx, float: ny, float: nz, float: px, float: py, float: pz) -> void;
                    function add_box(self&, float: x0, float: y0, float: z0, float: x1, float: y1, float: z1) -> void;
                    function add_sphere(self&, float: x, float: y, float: z, float: radius) -> void;
                    function clear_colliders(self&) -> void;

                    function step(self&, float: seconds) -> void;
                    function step_2d(self&, float: seconds, float: x0, float: y0, float: x1, float: y1) -> void;
                    function draw(self&, Renderer&: renderer) -> long int;
                    function draw_2d(self&, Renderer&: renderer) -> long int;

                    function step(self&, float: seconds, const Camera3D&: camera) -> void {
                        self.native_step_camera(seconds, camera);
                    } end function step

                    function draw(self&, Renderer&: renderer, const Camera3D&: camera) -> long int {
                        return self.native_draw_camera(renderer, camera);
                    } end function draw

                    function spawned(const self&) -> long int;
                    function limited(const self&) -> long int;
                    function step_ms(const self&) -> float;
                } end class Particles
            } end extern
        } end namespace graphics
    } end namespace std
} end safe
