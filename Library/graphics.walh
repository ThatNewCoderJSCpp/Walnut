                class Model as "walnut_rt::gfx::model" {
                    static function native_load(const string&: path, float: scale, bool: z_up) -> Model as "walnut_rt::gfx::model::load";
                    static function native_load_error() -> string as "walnut_rt::gfx::model::load_error";
                    function native_bound(const self&, long int: which) -> float as "bound";

                public:
                    constructor();

                    static function load(const string&: path, float: scale = 1.0, bool: z_up = true) -> Model {
                        Model: m = native_load(path, scale, z_up);
                        if (!m.valid()) then {
                            throw std::errors::graphics_error(static_cast<string>(`can't load the model '${path}': ${native_load_error()}`));
                        }
                        return m;
                    } end function load

                    function valid(const self&) -> bool;
                    function vertex_count(const self&) -> long int;
                    function find_animation(const self&, const string&: name) -> long int;

                    function bounds_min(const self&) -> Vec3 {
                        return Vec3(self.native_bound(0), self.native_bound(1), self.native_bound(2));
                    } end function bounds_min

                    function bounds_max(const self&) -> Vec3 {
                        return Vec3(self.native_bound(3), self.native_bound(4), self.native_bound(5));
                    } end function bounds_max
                } end class Model

