import module.random

namespace std {
    namespace algorithms {
        template <typename It>
        struct Range {
            It: first;
            It: last;

            constructor() { }

            constructor(It: a, It: b) : first = a, last = b { }

            function begin() const -> It {
                return first;
            } end function begin

            function end() const -> It {
                return last;
            } end function end

            function empty() const -> bool {
                return !(first != last);
            } end function empty
        } end struct Range

        namespace detail {
            template <typename T>
            function swap_values(T&: a, T&: b) -> void {
                auto: held = std::core::move(a);
                a = std::core::move(b);
                b = std::core::move(held);
            } end function swap_values

            function depth_limit(long int: n) -> int {
                int: depth = 0;
                for (long int: k = n; k > 1; k /= 2) {
                    depth += 2;
                }
                return depth + 4;
            } end function depth_limit

            template <typename It, typename Compare>
            function sift_down(It: first, long int: root, long int: count, Compare&: comp) -> void {
                long int: parent = root;
                while (parent * 2 + 1 < count) {
                    long int: child = parent * 2 + 1;
                    if (child + 1 < count && comp(first[child], first[child + 1])) then {
                        child += 1;
                    }
                    if (!comp(first[parent], first[child])) then {
                        return;
                    }
                    swap_values(first[parent], first[child]);
                    parent = child;
                }
            } end function sift_down

            template <typename It, typename Compare>
            function sift_up(It: first, long int: index, Compare&: comp) -> void {
                long int: child = index;
                while (child > 0) {
                    const long int: parent = (child - 1) / 2;
                    if (!comp(first[parent], first[child])) then {
                        return;
                    }
                    swap_values(first[parent], first[child]);
                    child = parent;
                }
            } end function sift_up

            template <typename It, typename Compare>
            function insertion(It: first, long int: lo, long int: hi, Compare&: comp) -> void {
                for (long int: i = lo + 1; i < hi; i++) {
                    if (comp(first[i], first[i - 1])) then {
                        auto: held = std::core::move(first[i]);
                        long int: j = i;
                        while (j > lo && comp(held, first[j - 1])) {
                            first[j] = std::core::move(first[j - 1]);
                            j -= 1;
                        }
                        first[j] = std::core::move(held);
                    }
                }
            } end function insertion

            template <typename It, typename Compare>
            function heapify(It: first, long int: count, Compare&: comp) -> void {
                for (long int: start = count / 2 - 1; start >= 0; start--) {
                    sift_down(first, start, count, comp);
                }
            } end function heapify

            template <typename It, typename Compare>
            function heap(It: first, long int: count, Compare&: comp) -> void {
                if (count < 2) then {
                    return;
                }
                heapify(first, count, comp);
                for (long int: last = count - 1; last > 0; last--) {
                    swap_values(first[0], first[last]);
                    sift_down(first, 0, last, comp);
                }
            } end function heap

            template <typename It, typename Compare>
            function median_to_front(It: first, long int: a, long int: b, long int: c, Compare&: comp) -> void {
                if (comp(first[b], first[a])) then {
                    swap_values(first[a], first[b]);
                }
                if (comp(first[c], first[b])) then {
                    swap_values(first[b], first[c]);
                }
                if (comp(first[b], first[a])) then {
                    swap_values(first[a], first[b]);
                }
                swap_values(first[a], first[b]);
            } end function median_to_front

            template <typename It, typename Compare>
            function partition_around_first(It: first, long int: lo, long int: hi, Compare&: comp) -> long int {
                long int: i = lo + 1;
                long int: j = hi - 1;
                while (true) {
                    while (i <= j && comp(first[i], first[lo])) {
                        i += 1;
                    }
                    while (i <= j && comp(first[lo], first[j])) {
                        j -= 1;
                    }
                    if (i >= j) then {
                        break;
                    }
                    swap_values(first[i], first[j]);
                    i += 1;
                    j -= 1;
                }
                swap_values(first[lo], first[j]);
                return j;
            } end function partition_around_first

            template <typename It, typename Compare>
            function intro(It: first, long int: lo, long int: hi, int: depth, Compare&: comp) -> void {
                long int: a = lo;
                long int: b = hi;
                int: budget = depth;
                while (b - a > 16) {
                    if (budget == 0) then {
                        heap(first + a, b - a, comp);
                        return;
                    }
                    budget -= 1;
                    median_to_front(first, a, a + (b - a) / 2, b - 1, comp);
                    const long int: p = partition_around_first(first, a, b, comp);
                    if (p - a < b - p - 1) then {
                        intro(first, a, p, budget, comp);
                        a = p + 1;
                    } else then {
                        intro(first, p + 1, b, budget, comp);
                        b = p;
                    }
                }
                insertion(first, a, b, comp);
            } end function intro

            template <typename It, typename V, typename Compare>
            function merge_pass(It: first, long int: lo, long int: mid, long int: hi, V*: buffer, Compare&: comp) -> void {
                long int: n = 0;
                for (long int: k = lo; k < mid; k++) {
                    buffer[n] = std::core::move(first[k]);
                    n += 1;
                }
                long int: i = 0;
                long int: j = mid;
                long int: out = lo;
                while (i < n && j < hi) {
                    if (comp(first[j], buffer[i])) then {
                        first[out] = std::core::move(first[j]);
                        j += 1;
                    } else then {
                        first[out] = std::core::move(buffer[i]);
                        i += 1;
                    }
                    out += 1;
                }
                while (i < n) {
                    first[out] = std::core::move(buffer[i]);
                    i += 1;
                    out += 1;
                }
            } end function merge_pass

            template <typename It, typename V, typename Compare>
            function merge_rec(It: first, long int: lo, long int: hi, V*: buffer, Compare&: comp) -> void {
                if (hi - lo <= 16) then {
                    insertion(first, lo, hi, comp);
                    return;
                }
                const long int: mid = lo + (hi - lo) / 2;
                merge_rec(first, lo, mid, buffer, comp);
                merge_rec(first, mid, hi, buffer, comp);
                if (comp(first[mid], first[mid - 1])) then {
                    merge_pass(first, lo, mid, hi, buffer, comp);
                }
            } end function merge_rec

            template <typename It, typename Compare>
            function select(It: first, long int: lo, long int: hi, long int: k, Compare&: comp) -> void {
                long int: a = lo;
                long int: b = hi;
                while (b - a > 16) {
                    median_to_front(first, a, a + (b - a) / 2, b - 1, comp);
                    const long int: p = partition_around_first(first, a, b, comp);
                    if (p == k) then {
                        return;
                    }
                    if (k < p) then {
                        b = p;
                    } else then {
                        a = p + 1;
                    }
                }
                insertion(first, a, b, comp);
            } end function select

            template <typename It, typename Compare>
            function quick(It: first, long int: lo, long int: hi, Compare&: comp) -> void {
                long int: a = lo;
                long int: b = hi;
                while (b - a > 16) {
                    median_to_front(first, a, a + (b - a) / 2, b - 1, comp);
                    auto: pivot = first[a];
                    long int: lt = a;
                    long int: i = a + 1;
                    long int: gt = b;
                    while (i < gt) {
                        if (comp(first[i], pivot)) then {
                            swap_values(first[lt], first[i]);
                            lt += 1;
                            i += 1;
                        } else if (comp(pivot, first[i])) then {
                            gt -= 1;
                            swap_values(first[i], first[gt]);
                        } else then {
                            i += 1;
                        }
                    }
                    if (lt - a < b - gt) then {
                        quick(first, a, lt, comp);
                        a = gt;
                    } else then {
                        quick(first, gt, b, comp);
                        b = lt;
                    }
                }
                insertion(first, a, b, comp);
            } end function quick
        } end namespace detail

        template <typename It>
        function distance(It: first, It: last) -> long int {
            if constexpr (std::concepts::random_access_iterator<It>) then {
                return static_cast<long int>(last - first);
            } else then {
                long int: n = 0;
                for (It: it = first; it != last; ++it) {
                    n += 1;
                }
                return n;
            }
        } end function distance

        template <typename It>
        function next(It: it, long int: n = 1) -> It {
            if constexpr (std::concepts::random_access_iterator<It>) then {
                return it + n;
            } else then {
                It: out = it;
                for (long int: k = 0; k < n; k++) {
                    ++out;
                }
                return out;
            }
        } end function next

        template <typename It>
        function prev(It: it, long int: n = 1) -> It {
            return it - n;
        } end function prev

        template <typename It>
        function iter_swap(It: a, It: b) -> void {
            detail::swap_values(*a, *b);
        } end function iter_swap

        template <typename It, typename Func>
        function for_each(It: first, It: last, Func: func) -> Func {
            for (It: it = first; it != last; ++it) {
                func(*it);
            }
            return func;
        } end function for_each

        template <typename It, typename Func>
        function for_each_indexed(It: first, It: last, Func: func) -> Func {
            long int: i = 0;
            for (It: it = first; it != last; ++it) {
                func(i, *it);
                i += 1;
            }
            return func;
        } end function for_each_indexed

        template <typename It, typename T>
        function count(It: first, It: last, const T&: value) -> long int {
            long int: n = 0;
            for (It: it = first; it != last; ++it) {
                if (*it == value) then {
                    n += 1;
                }
            }
            return n;
        } end function count

        template <typename It, typename Pred>
        function count_if(It: first, It: last, Pred: pred) -> long int {
            long int: n = 0;
            for (It: it = first; it != last; ++it) {
                if (pred(*it)) then {
                    n += 1;
                }
            }
            return n;
        } end function count_if

        template <typename It, typename T>
        function find(It: first, It: last, const T&: value) -> It {
            for (It: it = first; it != last; ++it) {
                if (*it == value) then {
                    return it;
                }
            }
            return last;
        } end function find

        template <typename It, typename Pred>
        function find_if(It: first, It: last, Pred: pred) -> It {
            for (It: it = first; it != last; ++it) {
                if (pred(*it)) then {
                    return it;
                }
            }
            return last;
        } end function find_if

        template <typename It, typename Pred>
        function find_if_not(It: first, It: last, Pred: pred) -> It {
            for (It: it = first; it != last; ++it) {
                if (!pred(*it)) then {
                    return it;
                }
            }
            return last;
        } end function find_if_not

        template <typename It, typename T>
        function find_last(It: first, It: last, const T&: value) -> It {
            It: found = last;
            for (It: it = first; it != last; ++it) {
                if (*it == value) then {
                    found = it;
                }
            }
            return found;
        } end function find_last

        template <typename It, typename Pred>
        function find_last_if(It: first, It: last, Pred: pred) -> It {
            It: found = last;
            for (It: it = first; it != last; ++it) {
                if (pred(*it)) then {
                    found = it;
                }
            }
            return found;
        } end function find_last_if

        template <typename It, typename T>
        function index_of(It: first, It: last, const T&: value) -> long int {
            long int: i = 0;
            for (It: it = first; it != last; ++it) {
                if (*it == value) then {
                    return i;
                }
                i += 1;
            }
            return -1;
        } end function index_of

        template <typename It, typename Pred>
        function index_if(It: first, It: last, Pred: pred) -> long int {
            long int: i = 0;
            for (It: it = first; it != last; ++it) {
                if (pred(*it)) then {
                    return i;
                }
                i += 1;
            }
            return -1;
        } end function index_if

        template <typename It, typename T>
        function contains(It: first, It: last, const T&: value) -> bool {
            return find(first, last, value) != last;
        } end function contains

        template <typename It, typename Pred>
        function contains_if(It: first, It: last, Pred: pred) -> bool {
            return find_if(first, last, pred) != last;
        } end function contains_if

        template <typename It, typename Pred>
        function all_of(It: first, It: last, Pred: pred) -> bool {
            for (It: it = first; it != last; ++it) {
                if (!pred(*it)) then {
                    return false;
                }
            }
            return true;
        } end function all_of

        template <typename It, typename Pred>
        function any_of(It: first, It: last, Pred: pred) -> bool {
            return find_if(first, last, pred) != last;
        } end function any_of

        template <typename It, typename Pred>
        function none_of(It: first, It: last, Pred: pred) -> bool {
            return find_if(first, last, pred) == last;
        } end function none_of

        template <typename It>
        function adjacent_find(It: first, It: last) -> It {
            if (first == last) then {
                return last;
            }
            It: before = first;
            It: it = first;
            ++it;
            while (it != last) {
                if (*before == *it) then {
                    return before;
                }
                before = it;
                ++it;
            }
            return last;
        } end function adjacent_find

        template <typename It, typename Pred>
        function adjacent_find(It: first, It: last, Pred: pred) -> It {
            if (first == last) then {
                return last;
            }
            It: before = first;
            It: it = first;
            ++it;
            while (it != last) {
                if (pred(*before, *it)) then {
                    return before;
                }
                before = it;
                ++it;
            }
            return last;
        } end function adjacent_find

        template <typename It, typename Other>
        function find_first_of(It: first, It: last, Other: s_first, Other: s_last) -> It {
            for (It: it = first; it != last; ++it) {
                for (Other: s = s_first; s != s_last; ++s) {
                    if (*it == *s) then {
                        return it;
                    }
                }
            }
            return last;
        } end function find_first_of

        template <typename It, typename Other>
        function search(It: first, It: last, Other: s_first, Other: s_last) -> It {
            if (s_first == s_last) then {
                return first;
            }
            for (It: start = first; start != last; ++start) {
                It: a = start;
                Other: b = s_first;
                while (a != last && b != s_last && *a == *b) {
                    ++a;
                    ++b;
                }
                if (b == s_last) then {
                    return start;
                }
                if (a == last) then {
                    return last;
                }
            }
            return last;
        } end function search

        template <typename It, typename T>
        function search_n(It: first, It: last, long int: n, const T&: value) -> It {
            if (n <= 0) then {
                return first;
            }
            long int: run = 0;
            It: start = first;
            for (It: it = first; it != last; ++it) {
                if (*it == value) then {
                    if (run == 0) then {
                        start = it;
                    }
                    run += 1;
                    if (run == n) then {
                        return start;
                    }
                } else then {
                    run = 0;
                }
            }
            return last;
        } end function search_n

        template <typename A, typename B>
        function equal(A: first, A: last, B: other) -> bool {
            B: b = other;
            for (A: a = first; a != last; ++a) {
                if (!(*a == *b)) then {
                    return false;
                }
                ++b;
            }
            return true;
        } end function equal

        template <typename A, typename B>
        function equal(A: first, A: last, B: o_first, B: o_last) -> bool {
            A: a = first;
            B: b = o_first;
            while (a != last && b != o_last) {
                if (!(*a == *b)) then {
                    return false;
                }
                ++a;
                ++b;
            }
            return a == last && b == o_last;
        } end function equal

        template <typename A, typename B>
        function mismatch(A: first, A: last, B: o_first, B: o_last) -> long int {
            A: a = first;
            B: b = o_first;
            long int: i = 0;
            while (a != last && b != o_last) {
                if (!(*a == *b)) then {
                    return i;
                }
                ++a;
                ++b;
                i += 1;
            }
            if (a == last && b == o_last) then {
                return -1;
            }
            return i;
        } end function mismatch

        template <typename A, typename B>
        function starts_with(A: first, A: last, B: p_first, B: p_last) -> bool {
            A: a = first;
            for (B: b = p_first; b != p_last; ++b) {
                if (a == last || !(*a == *b)) then {
                    return false;
                }
                ++a;
            }
            return true;
        } end function starts_with

        template <typename A, typename B>
        function ends_with(A: first, A: last, B: s_first, B: s_last) -> bool {
            const long int: n = distance(first, last);
            const long int: m = distance(s_first, s_last);
            if (m > n) then {
                return false;
            }
            return equal(next(first, n - m), last, s_first, s_last);
        } end function ends_with

        template <typename A, typename B>
        function lexicographical_compare(A: first, A: last, B: o_first, B: o_last) -> bool {
            A: a = first;
            B: b = o_first;
            while (a != last && b != o_last) {
                if (*a < *b) then {
                    return true;
                }
                if (*b < *a) then {
                    return false;
                }
                ++a;
                ++b;
            }
            return a == last && b != o_last;
        } end function lexicographical_compare

        template <typename It, typename Compare>
        function min_element(It: first, It: last, Compare: comp) -> It {
            if (first == last) then {
                return last;
            }
            It: best = first;
            It: it = first;
            ++it;
            while (it != last) {
                if (comp(*it, *best)) then {
                    best = it;
                }
                ++it;
            }
            return best;
        } end function min_element

        template <typename It>
        function min_element(It: first, It: last) -> It {
            return min_element(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function min_element

        template <typename It, typename Compare>
        function max_element(It: first, It: last, Compare: comp) -> It {
            if (first == last) then {
                return last;
            }
            It: best = first;
            It: it = first;
            ++it;
            while (it != last) {
                if (comp(*best, *it)) then {
                    best = it;
                }
                ++it;
            }
            return best;
        } end function max_element

        template <typename It>
        function max_element(It: first, It: last) -> It {
            return max_element(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function max_element

        template <typename It, typename Compare>
        function minmax_element(It: first, It: last, Compare: comp) -> Range<It> {
            return Range<It>(min_element(first, last, comp), max_element(first, last, comp));
        } end function minmax_element

        template <typename It>
        function minmax_element(It: first, It: last) -> Range<It> {
            return Range<It>(min_element(first, last), max_element(first, last));
        } end function minmax_element

        template <typename It, typename T>
        function accumulate(It: first, It: last, T: init) -> T {
            T: total = std::core::move(init);
            for (It: it = first; it != last; ++it) {
                total = total + *it;
            }
            return total;
        } end function accumulate

        template <typename It, typename T, typename Op>
        function accumulate(It: first, It: last, T: init, Op: op) -> T {
            T: total = std::core::move(init);
            for (It: it = first; it != last; ++it) {
                total = op(total, *it);
            }
            return total;
        } end function accumulate

        template <typename It, typename T>
        function reduce(It: first, It: last, T: init) -> T {
            return accumulate(first, last, init);
        } end function reduce

        template <typename It, typename T, typename Op>
        function reduce(It: first, It: last, T: init, Op: op) -> T {
            return accumulate(first, last, init, op);
        } end function reduce

        template <typename It, typename Out>
        function prefix_sum(It: first, It: last, Out: out) -> Out {
            if (first == last) then {
                return out;
            }
            auto: total = *first;
            Out: o = out;
            *o = total;
            ++o;
            It: it = first;
            ++it;
            while (it != last) {
                total = total + *it;
                *o = total;
                ++o;
                ++it;
            }
            return o;
        } end function prefix_sum

        template <typename It, typename T>
        function fill(It: first, It: last, const T&: value) -> void {
            for (It: it = first; it != last; ++it) {
                *it = value;
            }
        } end function fill

        template <typename It, typename T>
        function iota(It: first, It: last, T: start) -> void {
            T: value = start;
            for (It: it = first; it != last; ++it) {
                *it = value;
                ++value;
            }
        } end function iota

        template <typename It, typename Gen>
        function generate(It: first, It: last, Gen: gen) -> void {
            for (It: it = first; it != last; ++it) {
                *it = gen();
            }
        } end function generate

        template <typename It, typename Out>
        function copy(It: first, It: last, Out: out) -> Out {
            Out: o = out;
            for (It: it = first; it != last; ++it) {
                *o = *it;
                ++o;
            }
            return o;
        } end function copy

        template <typename It, typename Out>
        function copy_n(It: first, long int: n, Out: out) -> Out {
            It: it = first;
            Out: o = out;
            for (long int: k = 0; k < n; k++) {
                *o = *it;
                ++o;
                ++it;
            }
            return o;
        } end function copy_n

        template <typename It, typename Out, typename Pred>
        function copy_if(It: first, It: last, Out: out, Pred: pred) -> Out {
            Out: o = out;
            for (It: it = first; it != last; ++it) {
                if (pred(*it)) then {
                    *o = *it;
                    ++o;
                }
            }
            return o;
        } end function copy_if

        template <typename It, typename Out>
        function move_to(It: first, It: last, Out: out) -> Out {
            Out: o = out;
            for (It: it = first; it != last; ++it) {
                *o = std::core::move(*it);
                ++o;
            }
            return o;
        } end function move_to

        template <typename It, typename Out, typename Op>
        function transform(It: first, It: last, Out: out, Op: op) -> Out {
            Out: o = out;
            for (It: it = first; it != last; ++it) {
                *o = op(*it);
                ++o;
            }
            return o;
        } end function transform

        template <typename It, typename Op>
        function transform_in_place(It: first, It: last, Op: op) -> void {
            for (It: it = first; it != last; ++it) {
                *it = op(*it);
            }
        } end function transform_in_place

        template <typename It, typename T>
        function replace(It: first, It: last, const T&: old_value, const T&: new_value) -> long int {
            long int: n = 0;
            for (It: it = first; it != last; ++it) {
                if (*it == old_value) then {
                    *it = new_value;
                    n += 1;
                }
            }
            return n;
        } end function replace

        template <typename It, typename Pred, typename T>
        function replace_if(It: first, It: last, Pred: pred, const T&: new_value) -> long int {
            long int: n = 0;
            for (It: it = first; it != last; ++it) {
                if (pred(*it)) then {
                    *it = new_value;
                    n += 1;
                }
            }
            return n;
        } end function replace_if

        template <typename It, typename Pred>
        function remove_if(It: first, It: last, Pred: pred) -> It {
            It: out = find_if(first, last, pred);
            if (out == last) then {
                return last;
            }
            It: it = out;
            ++it;
            while (it != last) {
                if (!pred(*it)) then {
                    *out = std::core::move(*it);
                    ++out;
                }
                ++it;
            }
            return out;
        } end function remove_if

        template <typename It, typename T>
        function remove(It: first, It: last, const T&: value) -> It {
            return remove_if(first, last, [&value](const auto&: x) -> bool { return x == value; });
        } end function remove

        template <typename It, typename Pred>
        function unique(It: first, It: last, Pred: same) -> It {
            if (first == last) then {
                return last;
            }
            It: out = first;
            It: it = first;
            ++it;
            while (it != last) {
                if (!same(*out, *it)) then {
                    ++out;
                    if (out != it) then {
                        *out = std::core::move(*it);
                    }
                }
                ++it;
            }
            ++out;
            return out;
        } end function unique

        template <typename It>
        function unique(It: first, It: last) -> It {
            return unique(first, last, [](const auto&: a, const auto&: b) -> bool { return a == b; });
        } end function unique

        template <typename It>
        function reverse(It: first, It: last) -> void {
            long int: n = distance(first, last);
            if (n < 2) then {
                return;
            }
            It: a = first;
            It: b = prev(last);
            while (n > 1) {
                iter_swap(a, b);
                ++a;
                --b;
                n -= 2;
            }
        } end function reverse

        template <typename It>
        function rotate(It: first, It: middle, It: last) -> It {
            if (first == middle) then {
                return last;
            }
            if (middle == last) then {
                return first;
            }
            const long int: moved = distance(middle, last);
            reverse(first, middle);
            reverse(middle, last);
            reverse(first, last);
            return next(first, moved);
        } end function rotate

        template <typename It>
        function rotate_left(It: first, It: last, long int: n = 1) -> void {
            const long int: size = distance(first, last);
            if (size < 2) then {
                return;
            }
            const long int: k = ((n % size) + size) % size;
            if (k != 0) then {
                rotate(first, next(first, k), last);
            }
        } end function rotate_left

        template <typename It>
        function rotate_right(It: first, It: last, long int: n = 1) -> void {
            const long int: size = distance(first, last);
            if (size < 2) then {
                return;
            }
            rotate_left(first, last, size - ((n % size) + size) % size);
        } end function rotate_right

        template <typename A, typename B>
        function swap_ranges(A: first, A: last, B: other) -> B {
            B: b = other;
            for (A: a = first; a != last; ++a) {
                detail::swap_values(*a, *b);
                ++b;
            }
            return b;
        } end function swap_ranges

        template <typename It>
        function shuffle(It: first, It: last) -> void {
            const long int: n = distance(first, last);
            for (long int: i = n - 1; i > 0; i--) {
                const long int: j = std::random::random_int<long int>(0, i);
                detail::swap_values(first[i], first[j]);
            }
        } end function shuffle

        template <typename It, typename Pred>
        function partition(It: first, It: last, Pred: pred) -> It {
            It: out = find_if_not(first, last, pred);
            if (out == last) then {
                return last;
            }
            It: it = out;
            ++it;
            while (it != last) {
                if (pred(*it)) then {
                    iter_swap(it, out);
                    ++out;
                }
                ++it;
            }
            return out;
        } end function partition

        template <typename It, typename Pred>
        function stable_partition(It: first, It: last, Pred: pred) -> It {
            using V = std::traits::decay<typeof(*first)>;
            const long int: n = distance(first, last);
            if (n == 0) then {
                return first;
            }
            V*: rejected = new V[n];
            long int: kept = 0;
            long int: dropped = 0;
            It: out = first;
            for (It: it = first; it != last; ++it) {
                if (pred(*it)) then {
                    if (out != it) then {
                        *out = std::core::move(*it);
                    }
                    ++out;
                    kept += 1;
                } else then {
                    rejected[dropped] = std::core::move(*it);
                    dropped += 1;
                }
            }
            It: o = out;
            for (long int: k = 0; k < dropped; k++) {
                *o = std::core::move(rejected[k]);
                ++o;
            }
            delete[] rejected;
            return out;
        } end function stable_partition

        template <typename It, typename Pred>
        function is_partitioned(It: first, It: last, Pred: pred) -> bool {
            It: it = find_if_not(first, last, pred);
            while (it != last) {
                if (pred(*it)) then {
                    return false;
                }
                ++it;
            }
            return true;
        } end function is_partitioned

        template <typename It, typename Compare>
        function is_sorted_until(It: first, It: last, Compare: comp) -> It {
            if (first == last) then {
                return last;
            }
            It: before = first;
            It: it = first;
            ++it;
            while (it != last) {
                if (comp(*it, *before)) then {
                    return it;
                }
                before = it;
                ++it;
            }
            return last;
        } end function is_sorted_until

        template <typename It>
        function is_sorted_until(It: first, It: last) -> It {
            return is_sorted_until(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function is_sorted_until

        template <typename It, typename Compare>
        function is_sorted(It: first, It: last, Compare: comp) -> bool {
            return is_sorted_until(first, last, comp) == last;
        } end function is_sorted

        template <typename It>
        function is_sorted(It: first, It: last) -> bool {
            return is_sorted_until(first, last) == last;
        } end function is_sorted

        template <typename It, typename Compare>
        function sort(It: first, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            if (n < 2) then {
                return;
            }
            detail::intro(first, 0, n, detail::depth_limit(n), comp);
        } end function sort

        template <typename It>
        function sort(It: first, It: last) -> void {
            sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function sort

        template <typename It>
        function sort_descending(It: first, It: last) -> void {
            sort(first, last, [](const auto&: a, const auto&: b) -> bool { return b < a; });
        } end function sort_descending

        template <typename It, typename Key>
        function sort_by(It: first, It: last, Key: key) -> void {
            sort(first, last, [&key](const auto&: a, const auto&: b) -> bool { return key(a) < key(b); });
        } end function sort_by

        template <typename It, typename Compare>
        function stable_sort(It: first, It: last, Compare: comp) -> void {
            using V = std::traits::decay<typeof(*first)>;
            const long int: n = static_cast<long int>(last - first);
            if (n < 2) then {
                return;
            }
            V*: buffer = new V[n / 2 + 1];
            detail::merge_rec(first, 0, n, buffer, comp);
            delete[] buffer;
        } end function stable_sort

        template <typename It>
        function stable_sort(It: first, It: last) -> void {
            stable_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function stable_sort

        template <typename It, typename Key>
        function stable_sort_by(It: first, It: last, Key: key) -> void {
            stable_sort(first, last, [&key](const auto&: a, const auto&: b) -> bool { return key(a) < key(b); });
        } end function stable_sort_by

        template <typename It, typename Compare>
        function merge_sort(It: first, It: last, Compare: comp) -> void {
            stable_sort(first, last, comp);
        } end function merge_sort

        template <typename It>
        function merge_sort(It: first, It: last) -> void {
            stable_sort(first, last);
        } end function merge_sort

        template <typename It, typename Compare>
        function quick_sort(It: first, It: last, Compare: comp) -> void {
            detail::quick(first, 0, static_cast<long int>(last - first), comp);
        } end function quick_sort

        template <typename It>
        function quick_sort(It: first, It: last) -> void {
            quick_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function quick_sort

        template <typename It, typename Compare>
        function heap_sort(It: first, It: last, Compare: comp) -> void {
            detail::heap(first, static_cast<long int>(last - first), comp);
        } end function heap_sort

        template <typename It>
        function heap_sort(It: first, It: last) -> void {
            heap_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function heap_sort

        template <typename It, typename Compare>
        function insertion_sort(It: first, It: last, Compare: comp) -> void {
            detail::insertion(first, 0, static_cast<long int>(last - first), comp);
        } end function insertion_sort

        template <typename It>
        function insertion_sort(It: first, It: last) -> void {
            insertion_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function insertion_sort

        template <typename It, typename Compare>
        function selection_sort(It: first, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            for (long int: i = 0; i + 1 < n; i++) {
                long int: best = i;
                for (long int: j = i + 1; j < n; j++) {
                    if (comp(first[j], first[best])) then {
                        best = j;
                    }
                }
                if (best != i) then {
                    detail::swap_values(first[i], first[best]);
                }
            }
        } end function selection_sort

        template <typename It>
        function selection_sort(It: first, It: last) -> void {
            selection_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function selection_sort

        template <typename It, typename Compare>
        function bubble_sort(It: first, It: last, Compare: comp) -> void {
            long int: stop = static_cast<long int>(last - first);
            while (stop > 1) {
                long int: last_swap = 0;
                for (long int: i = 1; i < stop; i++) {
                    if (comp(first[i], first[i - 1])) then {
                        detail::swap_values(first[i], first[i - 1]);
                        last_swap = i;
                    }
                }
                stop = last_swap;
            }
        } end function bubble_sort

        template <typename It>
        function bubble_sort(It: first, It: last) -> void {
            bubble_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function bubble_sort

        template <typename It, typename Compare>
        function cocktail_sort(It: first, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            if (n < 2) then {
                return;
            }
            long int: lo = 0;
            long int: hi = n - 1;
            while (lo < hi) {
                long int: moved = lo;
                for (long int: i = lo; i < hi; i++) {
                    if (comp(first[i + 1], first[i])) then {
                        detail::swap_values(first[i], first[i + 1]);
                        moved = i;
                    }
                }
                hi = moved;
                if (lo >= hi) then {
                    break;
                }
                moved = hi;
                for (long int: i = hi; i > lo; i--) {
                    if (comp(first[i], first[i - 1])) then {
                        detail::swap_values(first[i], first[i - 1]);
                        moved = i;
                    }
                }
                lo = moved;
            }
        } end function cocktail_sort

        template <typename It>
        function cocktail_sort(It: first, It: last) -> void {
            cocktail_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function cocktail_sort

        template <typename It, typename Compare>
        function gnome_sort(It: first, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            long int: i = 1;
            while (i < n) {
                if (i == 0 || !comp(first[i], first[i - 1])) then {
                    i += 1;
                } else then {
                    detail::swap_values(first[i], first[i - 1]);
                    i -= 1;
                }
            }
        } end function gnome_sort

        template <typename It>
        function gnome_sort(It: first, It: last) -> void {
            gnome_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function gnome_sort

        template <typename It, typename Compare>
        function shell_sort(It: first, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            long int: gap = 1;
            while (gap < n / 3) {
                gap = gap * 3 + 1;
            }
            while (gap >= 1) {
                for (long int: i = gap; i < n; i++) {
                    auto: held = std::core::move(first[i]);
                    long int: j = i;
                    while (j >= gap && comp(held, first[j - gap])) {
                        first[j] = std::core::move(first[j - gap]);
                        j -= gap;
                    }
                    first[j] = std::core::move(held);
                }
                gap /= 3;
            }
        } end function shell_sort

        template <typename It>
        function shell_sort(It: first, It: last) -> void {
            shell_sort(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function shell_sort

        template <typename It>
        function counting_sort(It: first, It: last, bool: descending = false) -> void {
            static_assert(std::traits::is_builtin_integer<std::traits::decay<typeof(*first)>>, "counting_sort needs a range of integers or chars");
            const long int: n = static_cast<long int>(last - first);
            if (n < 2) then {
                return;
            }
            long long int: lo = static_cast<long long int>(first[0]);
            long long int: hi = lo;
            for (long int: i = 1; i < n; i++) {
                const long long int: v = static_cast<long long int>(first[i]);
                if (v < lo) then {
                    lo = v;
                }
                if (v > hi) then {
                    hi = v;
                }
            }
            const long long int: span = hi - lo + 1;
            if (span > 4 * n + 1024) then {
                sort(first, last);
                if (descending) then {
                    reverse(first, last);
                }
                return;
            }
            long int*: counts = new long int[span];
            for (long long int: k = 0; k < span; k++) {
                counts[k] = 0;
            }
            for (long int: i = 0; i < n; i++) {
                counts[static_cast<long long int>(first[i]) - lo] += 1;
            }
            using V = std::traits::decay<typeof(*first)>;
            long int: out = 0;
            for (long long int: k = 0; k < span; k++) {
                const long long int: slot = descending ? span - 1 - k : k;
                for (long int: m = counts[slot]; m > 0; m--) {
                    if constexpr (std::traits::is_char<V>) then {
                        first[out] = '\0' + static_cast<long int>(slot + lo);
                    } else then {
                        first[out] = static_cast<V>(slot + lo);
                    }
                    out += 1;
                }
            }
            delete[] counts;
        } end function counting_sort

        template <typename It>
        function radix_sort(It: first, It: last) -> void {
            using V = std::traits::decay<typeof(*first)>;
            static_assert(std::traits::is_builtin_integer<V>, "radix_sort needs a range of integers or chars");
            const long int: n = static_cast<long int>(last - first);
            if (n < 2) then {
                return;
            }
            long long int: lo = static_cast<long long int>(first[0]);
            for (long int: i = 1; i < n; i++) {
                if (static_cast<long long int>(first[i]) < lo) then {
                    lo = static_cast<long long int>(first[i]);
                }
            }
            unsigned long long int*: keys = new unsigned long long int[n];
            unsigned long long int*: scratch = new unsigned long long int[n];
            unsigned long long int: top = 0;
            for (long int: i = 0; i < n; i++) {
                keys[i] = static_cast<unsigned long long int>(static_cast<long long int>(first[i]) - lo);
                if (keys[i] > top) then {
                    top = keys[i];
                }
            }
            long int*: counts = new long int[256];
            for (int: shift = 0; shift < 64 && (top >> shift) > 0; shift += 8) {
                for (int: b = 0; b < 256; b++) {
                    counts[b] = 0;
                }
                for (long int: i = 0; i < n; i++) {
                    counts[static_cast<long int>((keys[i] >> shift) & 255)] += 1;
                }
                long int: total = 0;
                for (int: b = 0; b < 256; b++) {
                    const long int: c = counts[b];
                    counts[b] = total;
                    total += c;
                }
                for (long int: i = 0; i < n; i++) {
                    const long int: b = static_cast<long int>((keys[i] >> shift) & 255);
                    scratch[counts[b]] = keys[i];
                    counts[b] += 1;
                }
                for (long int: i = 0; i < n; i++) {
                    keys[i] = scratch[i];
                }
            }
            for (long int: i = 0; i < n; i++) {
                if constexpr (std::traits::is_char<V>) then {
                    first[i] = '\0' + static_cast<long int>(static_cast<long long int>(keys[i]) + lo);
                } else then {
                    first[i] = static_cast<V>(static_cast<long long int>(keys[i]) + lo);
                }
            }
            delete[] counts;
            delete[] scratch;
            delete[] keys;
        } end function radix_sort

        template <typename It, typename Compare>
        function partial_sort(It: first, It: middle, It: last, Compare: comp) -> void {
            const long int: k = static_cast<long int>(middle - first);
            const long int: n = static_cast<long int>(last - first);
            if (k <= 0) then {
                return;
            }
            detail::heapify(first, k, comp);
            for (long int: i = k; i < n; i++) {
                if (comp(first[i], first[0])) then {
                    detail::swap_values(first[i], first[0]);
                    detail::sift_down(first, 0, k, comp);
                }
            }
            for (long int: end_index = k - 1; end_index > 0; end_index--) {
                detail::swap_values(first[0], first[end_index]);
                detail::sift_down(first, 0, end_index, comp);
            }
        } end function partial_sort

        template <typename It>
        function partial_sort(It: first, It: middle, It: last) -> void {
            partial_sort(first, middle, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function partial_sort

        template <typename It, typename Compare>
        function nth_element(It: first, It: nth, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            const long int: k = static_cast<long int>(nth - first);
            if (k < 0 || k >= n) then {
                return;
            }
            detail::select(first, 0, n, k, comp);
        } end function nth_element

        template <typename It>
        function nth_element(It: first, It: nth, It: last) -> void {
            nth_element(first, nth, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function nth_element

        template <typename It, typename Compare>
        function make_heap(It: first, It: last, Compare: comp) -> void {
            detail::heapify(first, static_cast<long int>(last - first), comp);
        } end function make_heap

        template <typename It>
        function make_heap(It: first, It: last) -> void {
            make_heap(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function make_heap

        template <typename It, typename Compare>
        function push_heap(It: first, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            if (n > 1) then {
                detail::sift_up(first, n - 1, comp);
            }
        } end function push_heap

        template <typename It>
        function push_heap(It: first, It: last) -> void {
            push_heap(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function push_heap

        template <typename It, typename Compare>
        function pop_heap(It: first, It: last, Compare: comp) -> void {
            const long int: n = static_cast<long int>(last - first);
            if (n > 1) then {
                detail::swap_values(first[0], first[n - 1]);
                detail::sift_down(first, 0, n - 1, comp);
            }
        } end function pop_heap

        template <typename It>
        function pop_heap(It: first, It: last) -> void {
            pop_heap(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function pop_heap

        template <typename It, typename Compare>
        function sort_heap(It: first, It: last, Compare: comp) -> void {
            for (long int: n = static_cast<long int>(last - first); n > 1; n--) {
                detail::swap_values(first[0], first[n - 1]);
                detail::sift_down(first, 0, n - 1, comp);
            }
        } end function sort_heap

        template <typename It>
        function sort_heap(It: first, It: last) -> void {
            sort_heap(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function sort_heap

        template <typename It, typename Compare>
        function is_heap(It: first, It: last, Compare: comp) -> bool {
            const long int: n = static_cast<long int>(last - first);
            for (long int: i = 1; i < n; i++) {
                if (comp(first[(i - 1) / 2], first[i])) then {
                    return false;
                }
            }
            return true;
        } end function is_heap

        template <typename It>
        function is_heap(It: first, It: last) -> bool {
            return is_heap(first, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function is_heap

        template <typename It, typename T, typename Compare>
        function lower_bound(It: first, It: last, const T&: value, Compare: comp) -> It {
            long int: lo = 0;
            long int: hi = static_cast<long int>(last - first);
            while (lo < hi) {
                const long int: mid = lo + (hi - lo) / 2;
                if (comp(first[mid], value)) then {
                    lo = mid + 1;
                } else then {
                    hi = mid;
                }
            }
            return first + lo;
        } end function lower_bound

        template <typename It, typename T>
        function lower_bound(It: first, It: last, const T&: value) -> It {
            return lower_bound(first, last, value, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function lower_bound

        template <typename It, typename T, typename Compare>
        function upper_bound(It: first, It: last, const T&: value, Compare: comp) -> It {
            long int: lo = 0;
            long int: hi = static_cast<long int>(last - first);
            while (lo < hi) {
                const long int: mid = lo + (hi - lo) / 2;
                if (comp(value, first[mid])) then {
                    hi = mid;
                } else then {
                    lo = mid + 1;
                }
            }
            return first + lo;
        } end function upper_bound

        template <typename It, typename T>
        function upper_bound(It: first, It: last, const T&: value) -> It {
            return upper_bound(first, last, value, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function upper_bound

        template <typename It, typename T, typename Compare>
        function equal_range(It: first, It: last, const T&: value, Compare: comp) -> Range<It> {
            return Range<It>(lower_bound(first, last, value, comp), upper_bound(first, last, value, comp));
        } end function equal_range

        template <typename It, typename T>
        function equal_range(It: first, It: last, const T&: value) -> Range<It> {
            return Range<It>(lower_bound(first, last, value), upper_bound(first, last, value));
        } end function equal_range

        template <typename It, typename T, typename Compare>
        function binary_search(It: first, It: last, const T&: value, Compare: comp) -> bool {
            It: it = lower_bound(first, last, value, comp);
            return it != last && !comp(value, *it);
        } end function binary_search

        template <typename It, typename T>
        function binary_search(It: first, It: last, const T&: value) -> bool {
            It: it = lower_bound(first, last, value);
            return it != last && !(value < *it);
        } end function binary_search

        template <typename It, typename T, typename Compare>
        function binary_find(It: first, It: last, const T&: value, Compare: comp) -> It {
            It: it = lower_bound(first, last, value, comp);
            if (it != last && !comp(value, *it)) then {
                return it;
            }
            return last;
        } end function binary_find

        template <typename It, typename T>
        function binary_find(It: first, It: last, const T&: value) -> It {
            return binary_find(first, last, value, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function binary_find

        template <typename It, typename T, typename Compare>
        function exponential_search(It: first, It: last, const T&: value, Compare: comp) -> It {
            const long int: n = static_cast<long int>(last - first);
            if (n == 0) then {
                return last;
            }
            long int: bound = 1;
            while (bound < n && comp(first[bound], value)) {
                bound *= 2;
            }
            const long int: lo = bound / 2;
            const long int: hi = bound + 1 < n ? bound + 1 : n;
            It: it = lower_bound(first + lo, first + hi, value, comp);
            if (it != first + hi && !comp(value, *it)) then {
                return it;
            }
            return last;
        } end function exponential_search

        template <typename It, typename T>
        function exponential_search(It: first, It: last, const T&: value) -> It {
            return exponential_search(first, last, value, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function exponential_search

        template <typename It, typename T>
        requires std::traits::is_arithmetic<T>
        function interpolation_search(It: first, It: last, const T&: value) -> It {
            long int: lo = 0;
            long int: hi = static_cast<long int>(last - first) - 1;
            while (lo <= hi && !(value < first[lo]) && !(first[hi] < value)) {
                if (first[hi] == first[lo]) then {
                    if (first[lo] == value) then {
                        return first + lo;
                    }
                    return last;
                }
                const float: span = static_cast<float>(first[hi]) - static_cast<float>(first[lo]);
                const float: offset = (static_cast<float>(value) - static_cast<float>(first[lo])) / span;
                long int: pos = lo + static_cast<long int>(offset * static_cast<float>(hi - lo));
                if (pos < lo) then {
                    pos = lo;
                }
                if (pos > hi) then {
                    pos = hi;
                }
                if (first[pos] == value) then {
                    return first + pos;
                }
                if (first[pos] < value) then {
                    lo = pos + 1;
                } else then {
                    hi = pos - 1;
                }
            }
            return last;
        } end function interpolation_search

        template <typename It, typename T, typename Compare>
        function fibonacci_search(It: first, It: last, const T&: value, Compare: comp) -> It {
            const long int: n = static_cast<long int>(last - first);
            long int: fib2 = 0;
            long int: fib1 = 1;
            long int: fib = 1;
            while (fib < n) {
                fib2 = fib1;
                fib1 = fib;
                fib = fib1 + fib2;
            }
            long int: offset = -1;
            while (fib > 1) {
                long int: i = offset + fib2;
                if (i > n - 1) then {
                    i = n - 1;
                }
                if (comp(first[i], value)) then {
                    fib = fib1;
                    fib1 = fib2;
                    fib2 = fib - fib1;
                    offset = i;
                } else if (comp(value, first[i])) then {
                    fib = fib2;
                    fib1 = fib1 - fib2;
                    fib2 = fib - fib1;
                } else then {
                    return first + i;
                }
            }
            if (fib1 == 1 && offset + 1 < n && !comp(first[offset + 1], value) && !comp(value, first[offset + 1])) then {
                return first + (offset + 1);
            }
            return last;
        } end function fibonacci_search

        template <typename It, typename T>
        function fibonacci_search(It: first, It: last, const T&: value) -> It {
            return fibonacci_search(first, last, value, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function fibonacci_search

        template <typename A, typename B, typename Out, typename Compare>
        function merge(A: first, A: last, B: o_first, B: o_last, Out: out, Compare: comp) -> Out {
            A: a = first;
            B: b = o_first;
            Out: o = out;
            while (a != last && b != o_last) {
                if (comp(*b, *a)) then {
                    *o = *b;
                    ++b;
                } else then {
                    *o = *a;
                    ++a;
                }
                ++o;
            }
            while (a != last) {
                *o = *a;
                ++a;
                ++o;
            }
            while (b != o_last) {
                *o = *b;
                ++b;
                ++o;
            }
            return o;
        } end function merge

        template <typename A, typename B, typename Out>
        function merge(A: first, A: last, B: o_first, B: o_last, Out: out) -> Out {
            return merge(first, last, o_first, o_last, out, [](const auto&: x, const auto&: y) -> bool { return x < y; });
        } end function merge

        template <typename It, typename Compare>
        function inplace_merge(It: first, It: middle, It: last, Compare: comp) -> void {
            using V = std::traits::decay<typeof(*first)>;
            const long int: mid = static_cast<long int>(middle - first);
            const long int: n = static_cast<long int>(last - first);
            if (mid <= 0 || mid >= n) then {
                return;
            }
            V*: buffer = new V[mid];
            detail::merge_pass(first, 0, mid, n, buffer, comp);
            delete[] buffer;
        } end function inplace_merge

        template <typename It>
        function inplace_merge(It: first, It: middle, It: last) -> void {
            inplace_merge(first, middle, last, [](const auto&: a, const auto&: b) -> bool { return a < b; });
        } end function inplace_merge

        template <typename A, typename B, typename Out>
        function set_union(A: first, A: last, B: o_first, B: o_last, Out: out) -> Out {
            A: a = first;
            B: b = o_first;
            Out: o = out;
            while (a != last && b != o_last) {
                if (*a < *b) then {
                    *o = *a;
                    ++a;
                } else if (*b < *a) then {
                    *o = *b;
                    ++b;
                } else then {
                    *o = *a;
                    ++a;
                    ++b;
                }
                ++o;
            }
            o = copy(a, last, o);
            return copy(b, o_last, o);
        } end function set_union

        template <typename A, typename B, typename Out>
        function set_intersection(A: first, A: last, B: o_first, B: o_last, Out: out) -> Out {
            A: a = first;
            B: b = o_first;
            Out: o = out;
            while (a != last && b != o_last) {
                if (*a < *b) then {
                    ++a;
                } else if (*b < *a) then {
                    ++b;
                } else then {
                    *o = *a;
                    ++o;
                    ++a;
                    ++b;
                }
            }
            return o;
        } end function set_intersection

        template <typename A, typename B, typename Out>
        function set_difference(A: first, A: last, B: o_first, B: o_last, Out: out) -> Out {
            A: a = first;
            B: b = o_first;
            Out: o = out;
            while (a != last) {
                if (b == o_last) then {
                    return copy(a, last, o);
                }
                if (*a < *b) then {
                    *o = *a;
                    ++o;
                    ++a;
                } else if (*b < *a) then {
                    ++b;
                } else then {
                    ++a;
                    ++b;
                }
            }
            return o;
        } end function set_difference

        template <typename A, typename B>
        function includes(A: first, A: last, B: o_first, B: o_last) -> bool {
            A: a = first;
            for (B: b = o_first; b != o_last; ++b) {
                while (a != last && *a < *b) {
                    ++a;
                }
                if (a == last || *b < *a) then {
                    return false;
                }
                ++a;
            }
            return true;
        } end function includes

        template <typename C>
        requires std::concepts::iterable<C>
        function sort(C&&: items) -> void {
            sort(items.begin(), items.end());
        } end function sort

        template <typename C, typename Compare>
        requires std::concepts::iterable<C>
        function sort(C&&: items, Compare: comp) -> void {
            sort(items.begin(), items.end(), comp);
        } end function sort

        template <typename C>
        requires std::concepts::iterable<C>
        function stable_sort(C&&: items) -> void {
            stable_sort(items.begin(), items.end());
        } end function stable_sort

        template <typename C, typename Compare>
        requires std::concepts::iterable<C>
        function stable_sort(C&&: items, Compare: comp) -> void {
            stable_sort(items.begin(), items.end(), comp);
        } end function stable_sort

        template <typename C>
        requires std::concepts::iterable<C>
        function reverse(C&&: items) -> void {
            reverse(items.begin(), items.end());
        } end function reverse

        template <typename C, typename T>
        requires std::concepts::iterable<C>
        function count(C&&: items, const T&: value) -> long int {
            return count(items.begin(), items.end(), value);
        } end function count

        template <typename C, typename Pred>
        requires std::concepts::iterable<C>
        function count_if(C&&: items, Pred: pred) -> long int {
            return count_if(items.begin(), items.end(), pred);
        } end function count_if

        template <typename C, typename T>
        requires std::concepts::iterable<C>
        function contains(C&&: items, const T&: value) -> bool {
            return contains(items.begin(), items.end(), value);
        } end function contains

        template <typename C, typename Pred>
        requires std::concepts::iterable<C>
        function all_of(C&&: items, Pred: pred) -> bool {
            return all_of(items.begin(), items.end(), pred);
        } end function all_of

        template <typename C, typename Pred>
        requires std::concepts::iterable<C>
        function any_of(C&&: items, Pred: pred) -> bool {
            return any_of(items.begin(), items.end(), pred);
        } end function any_of

        template <typename C, typename Pred>
        requires std::concepts::iterable<C>
        function none_of(C&&: items, Pred: pred) -> bool {
            return none_of(items.begin(), items.end(), pred);
        } end function none_of

        template <typename C, typename T>
        requires std::concepts::iterable<C>
        function accumulate(C&&: items, T: init) -> T {
            return accumulate(items.begin(), items.end(), init);
        } end function accumulate

        template <typename C, typename T>
        requires std::concepts::iterable<C>
        function binary_search(C&&: items, const T&: value) -> bool {
            return binary_search(items.begin(), items.end(), value);
        } end function binary_search

        template <typename C>
        requires std::concepts::iterable<C>
        function is_sorted(C&&: items) -> bool {
            return is_sorted(items.begin(), items.end());
        } end function is_sorted

        template <typename C, typename Func>
        requires std::concepts::iterable<C>
        function for_each(C&&: items, Func: func) -> Func {
            return for_each(items.begin(), items.end(), func);
        } end function for_each
    } end namespace algorithms
} end namespace std
