import module.collections

safe(compile) {
    namespace std {
        namespace errors {
            class time_error {
            public:
                string: message;

                constructor(string: m) : message = m { }

                function what(const self&) -> string {
                    return self.message;
                } end function what
            } end class time_error
        } end namespace errors

        namespace time {
            enum Month { january, february, march, april, may, june, july, august, september, october, november, december }

            enum Weekday { monday, tuesday, wednesday, thursday, friday, saturday, sunday }

            namespace detail {
                extern "C++" from "<walnut_time.hpp>" {
                    class Parsed as "walnut_rt::clock::Parsed" {
                    public:
                        function ok(const self&) -> bool as "walnut_rt::clock::parsed_ok";
                        function error(const self&) -> string as "walnut_rt::clock::parsed_error";
                        function has_offset(const self&) -> bool as "walnut_rt::clock::parsed_has_offset";
                        function field(const self&, long int: which) -> long int as "walnut_rt::clock::parsed_field";
                    } end class Parsed

                    class Native as "walnut_rt::clock::api" {
                    public:
                        static function now_unix_nanos() -> long int as "walnut_rt::clock::now_unix_nanos";
                        static function steady_nanos() -> long int as "walnut_rt::clock::steady_nanos";
                        static function local_offset(long int: unix_seconds) -> long int as "walnut_rt::clock::local_offset";
                        static function zone_name(long int: unix_seconds) -> string as "walnut_rt::clock::zone_name";
                        static function sleep_nanos(long int: ns) -> bool as "walnut_rt::clock::sleep_nanos";
                        static function wait_nanos(long int: ns) -> bool as "walnut_rt::clock::wait_nanos";
                        static function precise_wait_nanos(long int: ns) -> bool as "walnut_rt::clock::precise_wait_nanos";
                        static function yield_now() -> void as "walnut_rt::clock::yield_now";
                        static function tai_minus_utc(long int: unix_seconds) -> long int as "walnut_rt::clock::tai_minus_utc";
                        static function gps_minus_utc(long int: unix_seconds) -> long int as "walnut_rt::clock::gps_minus_utc";
                        static function leap_second_day(long int: unix_seconds) -> bool as "walnut_rt::clock::leap_second_day";
                        static function format(const string&: pattern, long int: y, long int: m, long int: d, long int: h, long int: mi, long int: s, long int: ns, long int: offset, const string&: zone) -> string as "walnut_rt::clock::format";
                        static function parse(const string&: input, const string&: pattern) -> Parsed as "walnut_rt::clock::parse";
                    } end class Native
                } end extern

                constexpr long int: ns_per_us = 1000;
                constexpr long int: ns_per_ms = 1000000;
                constexpr long int: ns_per_second = 1000000000;
                constexpr long int: ns_per_minute = 60000000000;
                constexpr long int: ns_per_hour = 3600000000000;
                constexpr long int: ns_per_day = 86400000000000;

                function floor_div(long int: a, long int: b) -> long int {
                    const long int: q = a / b;
                    if (a % b != 0 && ((a < 0) != (b < 0))) then {
                        return q - 1;
                    }
                    return q;
                } end function floor_div

                function floor_mod(long int: a, long int: b) -> long int {
                    return a - floor_div(a, b) * b;
                } end function floor_mod

                function pad(long int: value, long int: width) -> string {
                    const bool: negative = value < 0;
                    string: digits = std::core::to_string(negative ? -value : value);
                    while (digits.size() < width) {
                        digits = "0" + digits;
                    }
                    return negative ? "-" + digits : digits;
                } end function pad

                function days_from_civil(long int: year, long int: month, long int: day) -> long int {
                    const long int: y = month <= 2 ? year - 1 : year;
                    const long int: era = floor_div(y, 400);
                    const long int: yoe = y - era * 400;
                    const long int: mp = (month + 9) % 12;
                    const long int: doy = (153 * mp + 2) / 5 + day - 1;
                    const long int: doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
                    return era * 146097 + doe - 719468;
                } end function days_from_civil

                function year_from_days(long int: days) -> long int {
                    const long int: z = days + 719468;
                    const long int: era = floor_div(z, 146097);
                    const long int: doe = z - era * 146097;
                    const long int: yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
                    const long int: doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
                    const long int: mp = (5 * doy + 2) / 153;
                    const long int: m = mp < 10 ? mp + 3 : mp - 9;
                    return yoe + era * 400 + (m <= 2 ? 1 : 0);
                } end function year_from_days

                function month_from_days(long int: days) -> long int {
                    const long int: z = days + 719468;
                    const long int: era = floor_div(z, 146097);
                    const long int: doe = z - era * 146097;
                    const long int: yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
                    const long int: doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
                    const long int: mp = (5 * doy + 2) / 153;
                    return mp < 10 ? mp + 3 : mp - 9;
                } end function month_from_days

                function day_from_days(long int: days) -> long int {
                    const long int: z = days + 719468;
                    const long int: era = floor_div(z, 146097);
                    const long int: doe = z - era * 146097;
                    const long int: yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
                    const long int: doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
                    const long int: mp = (5 * doy + 2) / 153;
                    return doy - (153 * mp + 2) / 5 + 1;
                } end function day_from_days

                function time_nanos(long int: hour, long int: minute, long int: second, long int: nanosecond) -> long int {
                    if (hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59 || nanosecond < 0 || nanosecond >= ns_per_second) then {
                        throw std::errors::time_error(static_cast<string>(`${hour}:${minute}:${second} isn't a time of day`));
                    }
                    return hour * ns_per_hour + minute * ns_per_minute + second * ns_per_second + nanosecond;
                } end function time_nanos

                function weekday_from_days(long int: days) -> Weekday {
                    return static_cast<Weekday>(static_cast<int>(floor_mod(days + 3, 7)));
                } end function weekday_from_days
            } end namespace detail

            function is_leap_year(long int: year) -> bool {
                return (year % 4 == 0) && ((year % 100 != 0) || (year % 400 == 0));
            } end function is_leap_year

            function days_in_year(long int: year) -> long int {
                return is_leap_year(year) ? 366 : 365;
            } end function days_in_year

            function days_in_month(long int: year, long int: month) -> long int {
                if (month < 1 || month > 12) then {
                    throw std::errors::time_error(static_cast<string>(`month ${month} isn't between 1 and 12`));
                }
                if (month == 2) then {
                    return is_leap_year(year) ? 29 : 28;
                }
                if (month == 4 || month == 6 || month == 9 || month == 11) then {
                    return 30;
                }
                return 31;
            } end function days_in_month

            function is_valid_date(long int: year, long int: month, long int: day) -> bool {
                return month >= 1 && month <= 12 && day >= 1 && day <= days_in_month(year, month);
            } end function is_valid_date

            function month_number(Month: m) -> long int {
                return static_cast<long int>(m) + 1;
            } end function month_number

            function month_of(long int: number) -> Month {
                if (number < 1 || number > 12) then {
                    throw std::errors::time_error(static_cast<string>(`month ${number} isn't between 1 and 12`));
                }
                return static_cast<Month>(static_cast<int>(number - 1));
            } end function month_of

            function month_name(Month: m) -> string {
                array[12] string: names = {"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"};
                return names[static_cast<long int>(m)];
            } end function month_name

            function month_short_name(Month: m) -> string {
                return month_name(m).substr(0, 3);
            } end function month_short_name

            function weekday_number(Weekday: w) -> long int {
                return static_cast<long int>(w) + 1;
            } end function weekday_number

            function weekday_of(long int: iso_number) -> Weekday {
                if (iso_number < 1 || iso_number > 7) then {
                    throw std::errors::time_error(static_cast<string>(`weekday ${iso_number} isn't between 1 (Monday) and 7 (Sunday)`));
                }
                return static_cast<Weekday>(static_cast<int>(iso_number - 1));
            } end function weekday_of

            function weekday_name(Weekday: w) -> string {
                array[7] string: names = {"Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"};
                return names[static_cast<long int>(w)];
            } end function weekday_name

            function weekday_short_name(Weekday: w) -> string {
                return weekday_name(w).substr(0, 3);
            } end function weekday_short_name

            function is_weekend(Weekday: w) -> bool {
                return w == Weekday::saturday || w == Weekday::sunday;
            } end function is_weekend

            function next_weekday(Weekday: w) -> Weekday {
                return static_cast<Weekday>((static_cast<int>(w) + 1) % 7);
            } end function next_weekday

            function previous_weekday(Weekday: w) -> Weekday {
                return static_cast<Weekday>((static_cast<int>(w) + 6) % 7);
            } end function previous_weekday

            function is_am(long int: hour) -> bool {
                return hour >= 0 && hour < 12;
            } end function is_am

            function is_pm(long int: hour) -> bool {
                return hour >= 12 && hour < 24;
            } end function is_pm

            function make12(long int: hour) -> long int {
                return hour % 12 == 0 ? 12 : hour % 12;
            } end function make12

            function make24(long int: hour12, bool: pm) -> long int {
                return hour12 % 12 + (pm ? 12 : 0);
            } end function make24

            struct HoursMinutesSeconds {
                bool: negative = false;
                long int: hours = 0;
                long int: minutes = 0;
                long int: seconds = 0;
                long int: nanoseconds = 0;

                function to_string(const self&) -> string {
                    string: out = self.negative ? "-" : "";
                    out += detail::pad(self.hours, 2) + ":" + detail::pad(self.minutes, 2) + ":" + detail::pad(self.seconds, 2);
                    if (self.nanoseconds != 0) then {
                        string: frac = detail::pad(self.nanoseconds, 9);
                        while (frac.size() > 0 && frac.substr(frac.size() - 1, 1) == "0") {
                            frac = frac.substr(0, frac.size() - 1);
                        }
                        out += "." + frac;
                    }
                    return out;
                } end function to_string
            } end struct HoursMinutesSeconds

            struct Duration {
                long int: nanos = 0;

                constructor() { }

                constructor(long int: total_nanoseconds) : nanos = total_nanoseconds { }

                static function zero() -> Duration {
                    return Duration(0);
                } end function zero

                static function max() -> Duration {
                    return Duration(9223372036854775807);
                } end function max

                static function min() -> Duration {
                    return Duration(-9223372036854775807 - 1);
                } end function min

                function total_nanoseconds(const self&) -> long int {
                    return self.nanos;
                } end function total_nanoseconds

                function total_microseconds(const self&) -> long int {
                    return self.nanos / detail::ns_per_us;
                } end function total_microseconds

                function total_milliseconds(const self&) -> long int {
                    return self.nanos / detail::ns_per_ms;
                } end function total_milliseconds

                function total_seconds(const self&) -> long int {
                    return self.nanos / detail::ns_per_second;
                } end function total_seconds

                function total_minutes(const self&) -> long int {
                    return self.nanos / detail::ns_per_minute;
                } end function total_minutes

                function total_hours(const self&) -> long int {
                    return self.nanos / detail::ns_per_hour;
                } end function total_hours

                function total_days(const self&) -> long int {
                    return self.nanos / detail::ns_per_day;
                } end function total_days

                function total_weeks(const self&) -> long int {
                    return self.nanos / (7 * detail::ns_per_day);
                } end function total_weeks

                function as_seconds(const self&) -> float {
                    return static_cast<float>(self.nanos) / static_cast<float>(detail::ns_per_second);
                } end function as_seconds

                function as_milliseconds(const self&) -> float {
                    return static_cast<float>(self.nanos) / static_cast<float>(detail::ns_per_ms);
                } end function as_milliseconds

                function as_microseconds(const self&) -> float {
                    return static_cast<float>(self.nanos) / static_cast<float>(detail::ns_per_us);
                } end function as_microseconds

                function as_minutes(const self&) -> float {
                    return static_cast<float>(self.nanos) / static_cast<float>(detail::ns_per_minute);
                } end function as_minutes

                function as_hours(const self&) -> float {
                    return static_cast<float>(self.nanos) / static_cast<float>(detail::ns_per_hour);
                } end function as_hours

                function as_days(const self&) -> float {
                    return static_cast<float>(self.nanos) / static_cast<float>(detail::ns_per_day);
                } end function as_days

                function is_zero(const self&) -> bool {
                    return self.nanos == 0;
                } end function is_zero

                function is_negative(const self&) -> bool {
                    return self.nanos < 0;
                } end function is_negative

                function is_positive(const self&) -> bool {
                    return self.nanos > 0;
                } end function is_positive

                function abs(const self&) -> Duration {
                    return Duration(self.nanos < 0 ? -self.nanos : self.nanos);
                } end function abs

                function floor_to(const self&, const Duration&: unit) -> Duration {
                    if (unit.nanos <= 0) then {
                        throw std::errors::time_error("floor_to() needs a positive unit");
                    }
                    return Duration(detail::floor_div(self.nanos, unit.nanos) * unit.nanos);
                } end function floor_to

                function ceil_to(const self&, const Duration&: unit) -> Duration {
                    const Duration: floored = self.floor_to(unit);
                    return floored.nanos == self.nanos ? floored : Duration(floored.nanos + unit.nanos);
                } end function ceil_to

                function round_to(const self&, const Duration&: unit) -> Duration {
                    const Duration: floored = self.floor_to(unit);
                    const long int: below = self.nanos - floored.nanos;
                    const long int: above = unit.nanos - below;
                    if (below < above) then {
                        return floored;
                    }
                    if (above < below) then {
                        return Duration(floored.nanos + unit.nanos);
                    }
                    return detail::floor_mod(detail::floor_div(self.nanos, unit.nanos), 2) == 0 ? floored : Duration(floored.nanos + unit.nanos);
                } end function round_to

                function split(const self&) -> HoursMinutesSeconds {
                    HoursMinutesSeconds: out;
                    out.negative = self.nanos < 0;
                    const long int: mag = self.nanos < 0 ? -self.nanos : self.nanos;
                    out.hours = mag / detail::ns_per_hour;
                    out.minutes = (mag / detail::ns_per_minute) % 60;
                    out.seconds = (mag / detail::ns_per_second) % 60;
                    out.nanoseconds = mag % detail::ns_per_second;
                    return out;
                } end function split

                operator(+) function(const self&, const Duration&: o) -> Duration {
                    return Duration(self.nanos + o.nanos);
                }

                operator(-) function(const self&, const Duration&: o) -> Duration {
                    return Duration(self.nanos - o.nanos);
                }

                operator(-) function(const self&) -> Duration {
                    return Duration(-self.nanos);
                }

                operator(*) function(const self&, long int: k) -> Duration {
                    return Duration(self.nanos * k);
                }

                operator(*) function(const self&, float: k) -> Duration {
                    return Duration(static_cast<long int>(static_cast<float>(self.nanos) * k));
                }

                operator(/) function(const self&, long int: k) -> Duration {
                    if (k == 0) then {
                        throw std::errors::time_error("a Duration divided by 0");
                    }
                    return Duration(self.nanos / k);
                }

                operator(/) function(const self&, const Duration&: o) -> long int {
                    if (o.nanos == 0) then {
                        throw std::errors::time_error("a Duration divided by a zero Duration");
                    }
                    return self.nanos / o.nanos;
                }

                operator(%) function(const self&, const Duration&: o) -> Duration {
                    if (o.nanos == 0) then {
                        throw std::errors::time_error("a Duration modulo a zero Duration");
                    }
                    return Duration(self.nanos % o.nanos);
                }

                function ratio(const self&, const Duration&: o) -> float {
                    return static_cast<float>(self.nanos) / static_cast<float>(o.nanos);
                } end function ratio

                operator(+=) function(self&, const Duration&: o) -> Duration& {
                    self.nanos += o.nanos;
                    return *this;
                }

                operator(-=) function(self&, const Duration&: o) -> Duration& {
                    self.nanos -= o.nanos;
                    return *this;
                }

                operator(*=) function(self&, long int: k) -> Duration& {
                    self.nanos *= k;
                    return *this;
                }

                operator(/=) function(self&, long int: k) -> Duration& {
                    self.nanos /= k;
                    return *this;
                }

                operator(==) function(const self&, const Duration&: o) -> bool {
                    return self.nanos == o.nanos;
                }

                operator(!=) function(const self&, const Duration&: o) -> bool {
                    return self.nanos != o.nanos;
                }

                operator(<) function(const self&, const Duration&: o) -> bool {
                    return self.nanos < o.nanos;
                }

                operator(<=) function(const self&, const Duration&: o) -> bool {
                    return self.nanos <= o.nanos;
                }

                operator(>) function(const self&, const Duration&: o) -> bool {
                    return self.nanos > o.nanos;
                }

                operator(>=) function(const self&, const Duration&: o) -> bool {
                    return self.nanos >= o.nanos;
                }

                function to_string(const self&) -> string {
                    if (self.nanos == 0) then {
                        return "0s";
                    }
                    const HoursMinutesSeconds: s = self.split();
                    string: out = s.negative ? "-" : "";
                    const long int: days = s.hours / 24;
                    const long int: hours = s.hours % 24;
                    if (days > 0) then {
                        out += std::core::to_string(days) + "d ";
                    }
                    if (hours > 0) then {
                        out += std::core::to_string(hours) + "h ";
                    }
                    if (s.minutes > 0) then {
                        out += std::core::to_string(s.minutes) + "m ";
                    }
                    if (s.seconds > 0 || s.nanoseconds > 0) then {
                        out += std::core::to_string(s.seconds);
                        if (s.nanoseconds > 0) then {
                            string: frac = detail::pad(s.nanoseconds, 9);
                            while (frac.substr(frac.size() - 1, 1) == "0") {
                                frac = frac.substr(0, frac.size() - 1);
                            }
                            out += "." + frac;
                        }
                        out += "s ";
                    }
                    return out.substr(0, out.size() - 1);
                } end function to_string

                function to_iso_string(const self&) -> string {
                    const HoursMinutesSeconds: s = self.split();
                    string: out = s.negative ? "-P" : "P";
                    const long int: days = s.hours / 24;
                    const long int: hours = s.hours % 24;
                    if (days > 0) then {
                        out += std::core::to_string(days) + "D";
                    }
                    out += "T";
                    if (hours > 0) then {
                        out += std::core::to_string(hours) + "H";
                    }
                    if (s.minutes > 0) then {
                        out += std::core::to_string(s.minutes) + "M";
                    }
                    if (s.seconds > 0 || s.nanoseconds > 0 || (hours == 0 && s.minutes == 0)) then {
                        out += std::core::to_string(s.seconds);
                        if (s.nanoseconds > 0) then {
                            string: frac = detail::pad(s.nanoseconds, 9);
                            while (frac.substr(frac.size() - 1, 1) == "0") {
                                frac = frac.substr(0, frac.size() - 1);
                            }
                            out += "." + frac;
                        }
                        out += "S";
                    }
                    if (out.substr(out.size() - 1, 1) == "T") then {
                        out = out.substr(0, out.size() - 1);
                    }
                    return out;
                } end function to_iso_string
            } end struct Duration

            operator(*) function(long int: k, const Duration&: d) -> Duration {
                return d * k;
            }

            function nanoseconds(long int: count) -> Duration {
                return Duration(count);
            } end function nanoseconds

            function microseconds(long int: count) -> Duration {
                return Duration(count * detail::ns_per_us);
            } end function microseconds

            function milliseconds(long int: count) -> Duration {
                return Duration(count * detail::ns_per_ms);
            } end function milliseconds

            function seconds(long int: count) -> Duration {
                return Duration(count * detail::ns_per_second);
            } end function seconds

            function minutes(long int: count) -> Duration {
                return Duration(count * detail::ns_per_minute);
            } end function minutes

            function hours(long int: count) -> Duration {
                return Duration(count * detail::ns_per_hour);
            } end function hours

            function days(long int: count) -> Duration {
                return Duration(count * detail::ns_per_day);
            } end function days

            function weeks(long int: count) -> Duration {
                return Duration(count * 7 * detail::ns_per_day);
            } end function weeks

            function from_seconds(float: count) -> Duration {
                return Duration(static_cast<long int>(count * 1000000000.0));
            } end function from_seconds

            function from_milliseconds(float: count) -> Duration {
                return Duration(static_cast<long int>(count * 1000000.0));
            } end function from_milliseconds

            function from_parts(long int: h, long int: m, long int: s, long int: ns = 0) -> Duration {
                return Duration(h * detail::ns_per_hour + m * detail::ns_per_minute + s * detail::ns_per_second + ns);
            } end function from_parts

            struct IsoWeek {
                long int: year = 1970;
                long int: week = 1;
                Weekday: weekday = Weekday::monday;

                function to_string(const self&) -> string {
                    return std::core::to_string(self.year) + "-W" + detail::pad(self.week, 2) + "-" + std::core::to_string(weekday_number(self.weekday));
                } end function to_string
            } end struct IsoWeek

            struct Date {
                long int: days_since_epoch = 0;

                constructor() { }

                constructor(long int: year, long int: month, long int: day) {
                    if (!is_valid_date(year, month, day)) then {
                        throw std::errors::time_error(static_cast<string>(`${year}-${month}-${day} isn't a real calendar date`));
                    }
                    self.days_since_epoch = detail::days_from_civil(year, month, day);
                }

                constructor(long int: year, Month: month, long int: day) {
                    const long int: m = month_number(month);
                    if (!is_valid_date(year, m, day)) then {
                        throw std::errors::time_error(static_cast<string>(`${year}-${m}-${day} isn't a real calendar date`));
                    }
                    self.days_since_epoch = detail::days_from_civil(year, m, day);
                }

                static function from_days(long int: days) -> Date {
                    Date: out;
                    out.days_since_epoch = days;
                    return out;
                } end function from_days

                static function epoch() -> Date {
                    return Date();
                } end function epoch

                static function today() -> Date {
                    return from_days(detail::floor_div(detail::Native::now_unix_nanos(), detail::ns_per_day));
                } end function today

                static function today_local() -> Date {
                    const long int: now = detail::Native::now_unix_nanos();
                    const long int: offset = detail::Native::local_offset(detail::floor_div(now, detail::ns_per_second));
                    return from_days(detail::floor_div(now + offset * detail::ns_per_second, detail::ns_per_day));
                } end function today_local

                static function nth_weekday(long int: year, long int: month, Weekday: weekday, long int: n) -> Date {
                    if (n < 1 || n > 5) then {
                        throw std::errors::time_error(static_cast<string>(`nth_weekday() needs n between 1 and 5, not ${n}`));
                    }
                    const Date: first = Date(year, month, 1);
                    const long int: offset = detail::floor_mod(static_cast<long int>(weekday) - static_cast<long int>(first.weekday()), 7);
                    const long int: day = 1 + offset + (n - 1) * 7;
                    if (day > std::time::days_in_month(year, month)) then {
                        throw std::errors::time_error(static_cast<string>(`${year}-${month} has no weekday number ${n} of that kind`));
                    }
                    return Date(year, month, day);
                } end function nth_weekday

                static function last_weekday(long int: year, long int: month, Weekday: weekday) -> Date {
                    const Date: last = Date(year, month, std::time::days_in_month(year, month));
                    const long int: back = detail::floor_mod(static_cast<long int>(last.weekday()) - static_cast<long int>(weekday), 7);
                    return from_days(last.days_since_epoch - back);
                } end function last_weekday

                static function from_ordinal(long int: year, long int: day_of_year) -> Date {
                    if (day_of_year < 1 || day_of_year > std::time::days_in_year(year)) then {
                        throw std::errors::time_error(static_cast<string>(`day ${day_of_year} isn't in year ${year}`));
                    }
                    return from_days(detail::days_from_civil(year, 1, 1) + day_of_year - 1);
                } end function from_ordinal

                static function from_iso_week(long int: year, long int: week, Weekday: weekday) -> Date {
                    const Date: jan4 = Date(year, 1, 4);
                    const long int: monday = jan4.days_since_epoch - static_cast<long int>(jan4.weekday());
                    return from_days(monday + (week - 1) * 7 + static_cast<long int>(weekday));
                } end function from_iso_week

                static function parse(const string&: input, const string&: pattern = "%Y-%m-%d") -> Date {
                    const detail::Parsed: p = detail::Native::parse(input, pattern);
                    if (!p.ok()) then {
                        throw std::errors::time_error(static_cast<string>(`can't read '${input}' as a date: ${p.error()}`));
                    }
                    return Date(p.field(0), p.field(1), p.field(2));
                } end function parse

                function days(const self&) -> long int {
                    return self.days_since_epoch;
                } end function days

                function year(const self&) -> long int {
                    return detail::year_from_days(self.days_since_epoch);
                } end function year

                function month(const self&) -> long int {
                    return detail::month_from_days(self.days_since_epoch);
                } end function month

                function month_enum(const self&) -> Month {
                    return month_of(self.month());
                } end function month_enum

                function day(const self&) -> long int {
                    return detail::day_from_days(self.days_since_epoch);
                } end function day

                function weekday(const self&) -> Weekday {
                    return detail::weekday_from_days(self.days_since_epoch);
                } end function weekday

                function day_of_year(const self&) -> long int {
                    return self.days_since_epoch - detail::days_from_civil(self.year(), 1, 1) + 1;
                } end function day_of_year

                function quarter(const self&) -> long int {
                    return (self.month() - 1) / 3 + 1;
                } end function quarter

                function iso_week(const self&) -> IsoWeek {
                    const long int: thursday = self.days_since_epoch + 3 - static_cast<long int>(self.weekday());
                    const long int: y = detail::year_from_days(thursday);
                    IsoWeek: out;
                    out.year = y;
                    out.week = (thursday - detail::days_from_civil(y, 1, 1)) / 7 + 1;
                    out.weekday = self.weekday();
                    return out;
                } end function iso_week

                function is_leap_year(const self&) -> bool {
                    return std::time::is_leap_year(self.year());
                } end function is_leap_year

                function days_in_month(const self&) -> long int {
                    return std::time::days_in_month(self.year(), self.month());
                } end function days_in_month

                function days_in_year(const self&) -> long int {
                    return std::time::days_in_year(self.year());
                } end function days_in_year

                function is_weekend(const self&) -> bool {
                    return std::time::is_weekend(self.weekday());
                } end function is_weekend

                function first_of_month(const self&) -> Date {
                    return Date(self.year(), self.month(), 1);
                } end function first_of_month

                function last_of_month(const self&) -> Date {
                    return Date(self.year(), self.month(), self.days_in_month());
                } end function last_of_month

                function first_of_year(const self&) -> Date {
                    return Date(self.year(), 1, 1);
                } end function first_of_year

                function last_of_year(const self&) -> Date {
                    return Date(self.year(), 12, 31);
                } end function last_of_year

                function add_days(const self&, long int: count) -> Date {
                    return from_days(self.days_since_epoch + count);
                } end function add_days

                function add_weeks(const self&, long int: count) -> Date {
                    return from_days(self.days_since_epoch + count * 7);
                } end function add_weeks

                function add_months(const self&, long int: count) -> Date {
                    const long int: total = self.year() * 12 + (self.month() - 1) + count;
                    const long int: y = detail::floor_div(total, 12);
                    const long int: m = detail::floor_mod(total, 12) + 1;
                    const long int: last = std::time::days_in_month(y, m);
                    return Date(y, m, self.day() < last ? self.day() : last);
                } end function add_months

                function add_years(const self&, long int: count) -> Date {
                    return self.add_months(count * 12);
                } end function add_years

                function next(const self&, Weekday: target) -> Date {
                    const long int: ahead = detail::floor_mod(static_cast<long int>(target) - static_cast<long int>(self.weekday()), 7);
                    return self.add_days(ahead == 0 ? 7 : ahead);
                } end function next

                function previous(const self&, Weekday: target) -> Date {
                    const long int: back = detail::floor_mod(static_cast<long int>(self.weekday()) - static_cast<long int>(target), 7);
                    return self.add_days(back == 0 ? -7 : -back);
                } end function previous

                function days_until(const self&, const Date&: other) -> long int {
                    return other.days_since_epoch - self.days_since_epoch;
                } end function days_until

                function years_until(const self&, const Date&: other) -> long int {
                    long int: years = other.year() - self.year();
                    if (years > 0 && (other.month() < self.month() || (other.month() == self.month() && other.day() < self.day()))) then {
                        years--;
                    } else if (years < 0 && (other.month() > self.month() || (other.month() == self.month() && other.day() > self.day()))) then {
                        years++;
                    }
                    return years;
                } end function years_until

                operator(+) function(const self&, const Duration&: d) -> Date {
                    return self.add_days(d.total_days());
                }

                operator(-) function(const self&, const Duration&: d) -> Date {
                    return self.add_days(-d.total_days());
                }

                operator(-) function(const self&, const Date&: o) -> Duration {
                    return std::time::days(self.days_since_epoch - o.days_since_epoch);
                }

                operator(++) function(self&) -> Date& {
                    self.days_since_epoch++;
                    return *this;
                }

                operator(--) function(self&) -> Date& {
                    self.days_since_epoch--;
                    return *this;
                }

                operator(==) function(const self&, const Date&: o) -> bool {
                    return self.days_since_epoch == o.days_since_epoch;
                }

                operator(!=) function(const self&, const Date&: o) -> bool {
                    return self.days_since_epoch != o.days_since_epoch;
                }

                operator(<) function(const self&, const Date&: o) -> bool {
                    return self.days_since_epoch < o.days_since_epoch;
                }

                operator(<=) function(const self&, const Date&: o) -> bool {
                    return self.days_since_epoch <= o.days_since_epoch;
                }

                operator(>) function(const self&, const Date&: o) -> bool {
                    return self.days_since_epoch > o.days_since_epoch;
                }

                operator(>=) function(const self&, const Date&: o) -> bool {
                    return self.days_since_epoch >= o.days_since_epoch;
                }

                function format(const self&, const string&: pattern) -> string {
                    return detail::Native::format(pattern, self.year(), self.month(), self.day(), 0, 0, 0, 0, 0, "UTC");
                } end function format

                function to_string(const self&) -> string {
                    const long int: y = self.year();
                    const string: ys = (y >= 0 && y <= 9999) ? detail::pad(y, 4) : std::core::to_string(y);
                    return ys + "-" + detail::pad(self.month(), 2) + "-" + detail::pad(self.day(), 2);
                } end function to_string
            } end struct Date

            struct TimeOfDay {
                long int: nanos_since_midnight = 0;

                constructor() { }

                constructor(long int: hour, long int: minute) {
                    self.nanos_since_midnight = detail::time_nanos(hour, minute, 0, 0);
                }

                constructor(long int: hour, long int: minute, long int: second) {
                    self.nanos_since_midnight = detail::time_nanos(hour, minute, second, 0);
                }

                constructor(long int: hour, long int: minute, long int: second, long int: nanosecond) {
                    self.nanos_since_midnight = detail::time_nanos(hour, minute, second, nanosecond);
                }

                static function from_nanoseconds(long int: nanos) -> TimeOfDay {
                    TimeOfDay: out;
                    out.nanos_since_midnight = detail::floor_mod(nanos, detail::ns_per_day);
                    return out;
                } end function from_nanoseconds

                static function midnight() -> TimeOfDay {
                    return TimeOfDay();
                } end function midnight

                static function noon() -> TimeOfDay {
                    return TimeOfDay(12, 0);
                } end function noon

                static function parse(const string&: input, const string&: pattern = "%H:%M:%S") -> TimeOfDay {
                    const detail::Parsed: p = detail::Native::parse("1970-01-01 " + input, "%Y-%m-%d " + pattern);
                    if (!p.ok()) then {
                        throw std::errors::time_error(static_cast<string>(`can't read '${input}' as a time: ${p.error()}`));
                    }
                    return TimeOfDay(p.field(3), p.field(4), p.field(5), p.field(6));
                } end function parse

                function hour(const self&) -> long int {
                    return self.nanos_since_midnight / detail::ns_per_hour;
                } end function hour

                function minute(const self&) -> long int {
                    return (self.nanos_since_midnight / detail::ns_per_minute) % 60;
                } end function minute

                function second(const self&) -> long int {
                    return (self.nanos_since_midnight / detail::ns_per_second) % 60;
                } end function second

                function millisecond(const self&) -> long int {
                    return (self.nanos_since_midnight / detail::ns_per_ms) % 1000;
                } end function millisecond

                function microsecond(const self&) -> long int {
                    return (self.nanos_since_midnight / detail::ns_per_us) % 1000000;
                } end function microsecond

                function nanosecond(const self&) -> long int {
                    return self.nanos_since_midnight % detail::ns_per_second;
                } end function nanosecond

                function hour12(const self&) -> long int {
                    return make12(self.hour());
                } end function hour12

                function is_am(const self&) -> bool {
                    return std::time::is_am(self.hour());
                } end function is_am

                function is_pm(const self&) -> bool {
                    return std::time::is_pm(self.hour());
                } end function is_pm

                function since_midnight(const self&) -> Duration {
                    return Duration(self.nanos_since_midnight);
                } end function since_midnight

                function until_midnight(const self&) -> Duration {
                    return Duration(detail::ns_per_day - self.nanos_since_midnight);
                } end function until_midnight

                operator(+) function(const self&, const Duration&: d) -> TimeOfDay {
                    return from_nanoseconds(self.nanos_since_midnight + d.nanos);
                }

                operator(-) function(const self&, const Duration&: d) -> TimeOfDay {
                    return from_nanoseconds(self.nanos_since_midnight - d.nanos);
                }

                operator(-) function(const self&, const TimeOfDay&: o) -> Duration {
                    return Duration(self.nanos_since_midnight - o.nanos_since_midnight);
                }

                operator(==) function(const self&, const TimeOfDay&: o) -> bool {
                    return self.nanos_since_midnight == o.nanos_since_midnight;
                }

                operator(!=) function(const self&, const TimeOfDay&: o) -> bool {
                    return self.nanos_since_midnight != o.nanos_since_midnight;
                }

                operator(<) function(const self&, const TimeOfDay&: o) -> bool {
                    return self.nanos_since_midnight < o.nanos_since_midnight;
                }

                operator(<=) function(const self&, const TimeOfDay&: o) -> bool {
                    return self.nanos_since_midnight <= o.nanos_since_midnight;
                }

                operator(>) function(const self&, const TimeOfDay&: o) -> bool {
                    return self.nanos_since_midnight > o.nanos_since_midnight;
                }

                operator(>=) function(const self&, const TimeOfDay&: o) -> bool {
                    return self.nanos_since_midnight >= o.nanos_since_midnight;
                }

                function format(const self&, const string&: pattern) -> string {
                    return detail::Native::format(pattern, 1970, 1, 1, self.hour(), self.minute(), self.second(), self.nanosecond(), 0, "UTC");
                } end function format

                function to_string(const self&) -> string {
                    string: out = detail::pad(self.hour(), 2) + ":" + detail::pad(self.minute(), 2) + ":" + detail::pad(self.second(), 2);
                    const long int: ns = self.nanosecond();
                    if (ns != 0) then {
                        string: frac = detail::pad(ns, 9);
                        while (frac.substr(frac.size() - 1, 1) == "0") {
                            frac = frac.substr(0, frac.size() - 1);
                        }
                        out += "." + frac;
                    }
                    return out;
                } end function to_string
            } end struct TimeOfDay

            struct DateTime {
                long int: day_count = 0;
                long int: nanos_of_day = 0;

                constructor() { }

                constructor(const Date&: date, const TimeOfDay&: time = TimeOfDay()) : day_count = date.days_since_epoch, nanos_of_day = time.nanos_since_midnight { }

                constructor(long int: year, long int: month, long int: day) {
                    self.day_count = Date(year, month, day).days_since_epoch;
                }

                constructor(long int: year, long int: month, long int: day, long int: hour, long int: minute) {
                    self.day_count = Date(year, month, day).days_since_epoch;
                    self.nanos_of_day = detail::time_nanos(hour, minute, 0, 0);
                }

                constructor(long int: year, long int: month, long int: day, long int: hour, long int: minute, long int: second) {
                    self.day_count = Date(year, month, day).days_since_epoch;
                    self.nanos_of_day = detail::time_nanos(hour, minute, second, 0);
                }

                constructor(long int: year, long int: month, long int: day, long int: hour, long int: minute, long int: second, long int: nanosecond) {
                    self.day_count = Date(year, month, day).days_since_epoch;
                    self.nanos_of_day = detail::time_nanos(hour, minute, second, nanosecond);
                }

                static function from_unix_nanoseconds(long int: nanos) -> DateTime {
                    DateTime: out;
                    out.day_count = detail::floor_div(nanos, detail::ns_per_day);
                    out.nanos_of_day = detail::floor_mod(nanos, detail::ns_per_day);
                    return out;
                } end function from_unix_nanoseconds

                static function from_unix_seconds(long int: seconds) -> DateTime {
                    DateTime: out;
                    out.day_count = detail::floor_div(seconds, 86400);
                    out.nanos_of_day = detail::floor_mod(seconds, 86400) * detail::ns_per_second;
                    return out;
                } end function from_unix_seconds

                static function from_unix_milliseconds(long int: millis) -> DateTime {
                    DateTime: out;
                    out.day_count = detail::floor_div(millis, 86400000);
                    out.nanos_of_day = detail::floor_mod(millis, 86400000) * detail::ns_per_ms;
                    return out;
                } end function from_unix_milliseconds

                static function now() -> DateTime {
                    return from_unix_nanoseconds(detail::Native::now_unix_nanos());
                } end function now

                static function now_local() -> DateTime {
                    const long int: now = detail::Native::now_unix_nanos();
                    const long int: offset = detail::Native::local_offset(detail::floor_div(now, detail::ns_per_second));
                    return from_unix_nanoseconds(now + offset * detail::ns_per_second);
                } end function now_local

                static function epoch() -> DateTime {
                    return DateTime();
                } end function epoch

                static function parse(const string&: input, const string&: pattern = "%Y-%m-%dT%H:%M:%S") -> DateTime {
                    const detail::Parsed: p = detail::Native::parse(input, pattern);
                    if (!p.ok()) then {
                        throw std::errors::time_error(static_cast<string>(`can't read '${input}' as a date and time: ${p.error()}`));
                    }
                    DateTime: out = DateTime(p.field(0), p.field(1), p.field(2), p.field(3), p.field(4), p.field(5), p.field(6));
                    if (p.has_offset()) then {
                        out = out - seconds(p.field(7));
                    }
                    return out;
                } end function parse

                static function from_iso_string(const string&: input) -> DateTime {
                    array[6] string: patterns = {"%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M", "%Y-%m-%d"};
                    for (const string&: p in patterns) {
                        const detail::Parsed: r = detail::Native::parse(input, p);
                        if (r.ok()) then {
                            return parse(input, p);
                        }
                    }
                    throw std::errors::time_error(static_cast<string>(`can't read '${input}' as an ISO 8601 date and time`));
                } end function from_iso_string

                function date(const self&) -> Date {
                    return Date::from_days(self.day_count);
                } end function date

                function time(const self&) -> TimeOfDay {
                    return TimeOfDay::from_nanoseconds(self.nanos_of_day);
                } end function time

                function year(const self&) -> long int {
                    return self.date().year();
                } end function year

                function month(const self&) -> long int {
                    return self.date().month();
                } end function month

                function day(const self&) -> long int {
                    return self.date().day();
                } end function day

                function weekday(const self&) -> Weekday {
                    return self.date().weekday();
                } end function weekday

                function hour(const self&) -> long int {
                    return self.time().hour();
                } end function hour

                function minute(const self&) -> long int {
                    return self.time().minute();
                } end function minute

                function second(const self&) -> long int {
                    return self.time().second();
                } end function second

                function millisecond(const self&) -> long int {
                    return self.time().millisecond();
                } end function millisecond

                function nanosecond(const self&) -> long int {
                    return self.time().nanosecond();
                } end function nanosecond

                function day_of_year(const self&) -> long int {
                    return self.date().day_of_year();
                } end function day_of_year

                function unix_seconds(const self&) -> long int {
                    return self.day_count * 86400 + detail::floor_div(self.nanos_of_day, detail::ns_per_second);
                } end function unix_seconds

                function unix_milliseconds(const self&) -> long int {
                    return self.day_count * 86400000 + detail::floor_div(self.nanos_of_day, detail::ns_per_ms);
                } end function unix_milliseconds

                function unix_nanoseconds(const self&) -> long int {
                    return self.day_count * detail::ns_per_day + self.nanos_of_day;
                } end function unix_nanoseconds

                function since_epoch(const self&) -> Duration {
                    return Duration(self.unix_nanoseconds());
                } end function since_epoch

                function add_months(const self&, long int: count) -> DateTime {
                    return DateTime(self.date().add_months(count), self.time());
                } end function add_months

                function add_years(const self&, long int: count) -> DateTime {
                    return DateTime(self.date().add_years(count), self.time());
                } end function add_years

                function start_of_day(const self&) -> DateTime {
                    return DateTime(self.date());
                } end function start_of_day

                function to_local(const self&) -> DateTime {
                    return *this + seconds(detail::Native::local_offset(self.unix_seconds()));
                } end function to_local

                function to_utc_from_local(const self&) -> DateTime {
                    return *this - seconds(detail::Native::local_offset(self.unix_seconds()));
                } end function to_utc_from_local

                function tai_offset(const self&) -> Duration {
                    return seconds(detail::Native::tai_minus_utc(self.unix_seconds()));
                } end function tai_offset

                function gps_offset(const self&) -> Duration {
                    return seconds(detail::Native::gps_minus_utc(self.unix_seconds()));
                } end function gps_offset

                function to_tai(const self&) -> DateTime {
                    return *this + self.tai_offset();
                } end function to_tai

                function to_gps(const self&) -> DateTime {
                    return *this + self.gps_offset();
                } end function to_gps

                function has_leap_second(const self&) -> bool {
                    return detail::Native::leap_second_day(self.unix_seconds());
                } end function has_leap_second

                operator(+) function(const self&, const Duration&: d) -> DateTime {
                    return from_unix_nanoseconds(self.unix_nanoseconds() + d.nanos);
                }

                operator(-) function(const self&, const Duration&: d) -> DateTime {
                    return from_unix_nanoseconds(self.unix_nanoseconds() - d.nanos);
                }

                operator(-) function(const self&, const DateTime&: o) -> Duration {
                    return Duration((self.day_count - o.day_count) * detail::ns_per_day + (self.nanos_of_day - o.nanos_of_day));
                }

                operator(+=) function(self&, const Duration&: d) -> DateTime& {
                    *this = *this + d;
                    return *this;
                }

                operator(-=) function(self&, const Duration&: d) -> DateTime& {
                    *this = *this - d;
                    return *this;
                }

                operator(==) function(const self&, const DateTime&: o) -> bool {
                    return self.day_count == o.day_count && self.nanos_of_day == o.nanos_of_day;
                }

                operator(!=) function(const self&, const DateTime&: o) -> bool {
                    return !(*this == o);
                }

                operator(<) function(const self&, const DateTime&: o) -> bool {
                    return self.day_count < o.day_count || (self.day_count == o.day_count && self.nanos_of_day < o.nanos_of_day);
                }

                operator(<=) function(const self&, const DateTime&: o) -> bool {
                    return !(o < *this);
                }

                operator(>) function(const self&, const DateTime&: o) -> bool {
                    return o < *this;
                }

                operator(>=) function(const self&, const DateTime&: o) -> bool {
                    return !(*this < o);
                }

                function format(const self&, const string&: pattern, long int: offset_seconds = 0, const string&: zone = "UTC") -> string {
                    const Date: d = self.date();
                    const TimeOfDay: t = self.time();
                    return detail::Native::format(pattern, d.year(), d.month(), d.day(), t.hour(), t.minute(), t.second(), t.nanosecond(), offset_seconds, zone);
                } end function format

                function to_iso_string(const self&) -> string {
                    const long int: ms = self.time().millisecond();
                    if (self.time().nanosecond() == 0) then {
                        return self.format("%Y-%m-%dT%H:%M:%SZ");
                    }
                    if (self.time().nanosecond() == ms * detail::ns_per_ms) then {
                        return self.format("%Y-%m-%dT%H:%M:%S.%LZ");
                    }
                    return self.format("%Y-%m-%dT%H:%M:%S.%NZ");
                } end function to_iso_string

                function to_string(const self&) -> string {
                    return self.date().to_string() + " " + self.time().to_string();
                } end function to_string
            } end struct DateTime

            struct ZonedDateTime {
                DateTime: utc;
                long int: offset_seconds = 0;
                string: zone = "UTC";

                constructor() { }

                constructor(const DateTime&: utc_time, long int: offset, const string&: zone_name = "") : utc = utc_time, offset_seconds = offset, zone = zone_name { }

                static function now_local() -> ZonedDateTime {
                    const DateTime: now = DateTime::now();
                    const long int: offset = detail::Native::local_offset(now.unix_seconds());
                    return ZonedDateTime(now, offset, detail::Native::zone_name(now.unix_seconds()));
                } end function now_local

                static function from_local(const DateTime&: local_time, long int: offset, const string&: zone_name = "") -> ZonedDateTime {
                    return ZonedDateTime(local_time - seconds(offset), offset, zone_name);
                } end function from_local

                function local(const self&) -> DateTime {
                    return self.utc + seconds(self.offset_seconds);
                } end function local

                function offset(const self&) -> Duration {
                    return seconds(self.offset_seconds);
                } end function offset

                function with_offset(const self&, long int: offset, const string&: zone_name = "") -> ZonedDateTime {
                    return ZonedDateTime(self.utc, offset, zone_name);
                } end function with_offset

                function offset_string(const self&) -> string {
                    const long int: mag = self.offset_seconds < 0 ? -self.offset_seconds : self.offset_seconds;
                    return (self.offset_seconds < 0 ? "-" : "+") + detail::pad(mag / 3600, 2) + ":" + detail::pad((mag / 60) % 60, 2);
                } end function offset_string

                function format(const self&, const string&: pattern) -> string {
                    return self.local().format(pattern, self.offset_seconds, self.zone);
                } end function format

                function to_iso_string(const self&) -> string {
                    return self.local().format("%Y-%m-%dT%H:%M:%S") + self.offset_string();
                } end function to_iso_string

                function to_string(const self&) -> string {
                    return self.local().to_string() + " " + self.offset_string() + (self.zone == "" ? "" : " " + self.zone);
                } end function to_string

                operator(==) function(const self&, const ZonedDateTime&: o) -> bool {
                    return self.utc == o.utc;
                }

                operator(<) function(const self&, const ZonedDateTime&: o) -> bool {
                    return self.utc < o.utc;
                }
            } end struct ZonedDateTime

            function local_utc_offset() -> Duration {
                return seconds(detail::Native::local_offset(DateTime::now().unix_seconds()));
            } end function local_utc_offset

            function local_zone_name() -> string {
                return detail::Native::zone_name(DateTime::now().unix_seconds());
            } end function local_zone_name

            struct Instant {
                long int: ticks = 0;

                static function now() -> Instant {
                    Instant: out;
                    out.ticks = detail::Native::steady_nanos();
                    return out;
                } end function now

                function elapsed(const self&) -> Duration {
                    return Duration(detail::Native::steady_nanos() - self.ticks);
                } end function elapsed

                function since(const self&, const Instant&: earlier) -> Duration {
                    return Duration(self.ticks - earlier.ticks);
                } end function since

                operator(+) function(const self&, const Duration&: d) -> Instant {
                    Instant: out;
                    out.ticks = self.ticks + d.nanos;
                    return out;
                }

                operator(-) function(const self&, const Duration&: d) -> Instant {
                    Instant: out;
                    out.ticks = self.ticks - d.nanos;
                    return out;
                }

                operator(-) function(const self&, const Instant&: o) -> Duration {
                    return Duration(self.ticks - o.ticks);
                }

                operator(==) function(const self&, const Instant&: o) -> bool {
                    return self.ticks == o.ticks;
                }

                operator(<) function(const self&, const Instant&: o) -> bool {
                    return self.ticks < o.ticks;
                }

                operator(<=) function(const self&, const Instant&: o) -> bool {
                    return self.ticks <= o.ticks;
                }

                operator(>) function(const self&, const Instant&: o) -> bool {
                    return self.ticks > o.ticks;
                }

                operator(>=) function(const self&, const Instant&: o) -> bool {
                    return self.ticks >= o.ticks;
                }
            } end struct Instant

            function sleep(const Duration&: d) -> bool {
                return detail::Native::sleep_nanos(d.nanos);
            } end function sleep

            function sleep_until(const Instant&: deadline) -> bool {
                const Duration: left = deadline - Instant::now();
                return left.is_positive() ? detail::Native::sleep_nanos(left.nanos) : true;
            } end function sleep_until

            function wait(const Duration&: d) -> bool {
                return detail::Native::wait_nanos(d.nanos);
            } end function wait

            function precise_wait(const Duration&: d) -> bool {
                return detail::Native::precise_wait_nanos(d.nanos);
            } end function precise_wait

            function yield_now() -> void {
                detail::Native::yield_now();
            } end function yield_now

            function measure(function() -> void: work) -> Duration {
                const Instant: start = Instant::now();
                work();
                return start.elapsed();
            } end function measure

            class Stopwatch {
                long int: started_at = 0;
                long int: banked = 0;
                bool: running = false;
                std::collections::Vector<Duration>: lap_times;
                long int: last_lap = 0;

            public:
                constructor() { }

                static function started() -> Stopwatch {
                    Stopwatch: out;
                    out.start();
                    return out;
                } end function started

                function start(self&) -> void {
                    if (!self.running) then {
                        self.started_at = detail::Native::steady_nanos();
                        self.running = true;
                    }
                } end function start

                function stop(self&) -> Duration {
                    if (self.running) then {
                        self.banked += detail::Native::steady_nanos() - self.started_at;
                        self.running = false;
                    }
                    return self.elapsed();
                } end function stop

                function reset(self&) -> void {
                    self.banked = 0;
                    self.running = false;
                    self.lap_times.clear();
                    self.last_lap = 0;
                } end function reset

                function restart(self&) -> Duration {
                    const Duration: total = self.elapsed();
                    self.reset();
                    self.start();
                    return total;
                } end function restart

                function is_running(const self&) -> bool {
                    return self.running;
                } end function is_running

                function elapsed(const self&) -> Duration {
                    return Duration(self.banked + (self.running ? detail::Native::steady_nanos() - self.started_at : 0));
                } end function elapsed

                function lap(self&) -> Duration {
                    const long int: now = self.elapsed().nanos;
                    const Duration: piece = Duration(now - self.last_lap);
                    self.last_lap = now;
                    self.lap_times.push_back(piece);
                    return piece;
                } end function lap

                function laps(const self&) -> const std::collections::Vector<Duration>& {
                    return self.lap_times;
                } end function laps

                function to_string(const self&) -> string {
                    return self.elapsed().to_string();
                } end function to_string
            } end class Stopwatch

            class CountdownTimer {
                Duration: length;
                long int: started_at = 0;
                long int: banked = 0;
                bool: running = false;

            public:
                constructor() { }

                constructor(const Duration&: total) : length = total { }

                function start(self&) -> void {
                    if (!self.running) then {
                        self.started_at = detail::Native::steady_nanos();
                        self.running = true;
                    }
                } end function start

                function pause(self&) -> void {
                    if (self.running) then {
                        self.banked += detail::Native::steady_nanos() - self.started_at;
                        self.running = false;
                    }
                } end function pause

                function reset(self&) -> void {
                    self.banked = 0;
                    self.running = false;
                } end function reset

                function reset(self&, const Duration&: total) -> void {
                    self.length = total;
                    self.reset();
                } end function reset

                function is_running(const self&) -> bool {
                    return self.running;
                } end function is_running

                function elapsed(const self&) -> Duration {
                    return Duration(self.banked + (self.running ? detail::Native::steady_nanos() - self.started_at : 0));
                } end function elapsed

                function remaining(const self&) -> Duration {
                    const Duration: left = self.length - self.elapsed();
                    return left.is_negative() ? Duration::zero() : left;
                } end function remaining

                function expired(const self&) -> bool {
                    return self.remaining().is_zero();
                } end function expired

                function progress(const self&) -> float {
                    if (self.length.nanos <= 0) then {
                        return 1.0;
                    }
                    const float: p = self.elapsed().ratio(self.length);
                    return p > 1.0 ? 1.0 : p;
                } end function progress

                function duration(const self&) -> Duration {
                    return self.length;
                } end function duration

                function wait_until_done(self&) -> void {
                    self.start();
                    const Duration: left = self.remaining();
                    if (left.is_positive()) then {
                        sleep(left);
                    }
                } end function wait_until_done
            } end class CountdownTimer

            class RepeatingTimer {
                Duration: period;
                long int: next_tick = 0;
                long int: count = 0;

            public:
                constructor(const Duration&: every) : period = every {
                    if (every.nanos <= 0) then {
                        throw std::errors::time_error("a RepeatingTimer needs a positive period");
                    }
                    self.next_tick = detail::Native::steady_nanos() + every.nanos;
                }

                function ready(self&) -> bool {
                    const long int: now = detail::Native::steady_nanos();
                    if (now < self.next_tick) then {
                        return false;
                    }
                    self.count++;
                    self.next_tick += self.period.nanos;
                    if (self.next_tick <= now) then {
                        const long int: behind = (now - self.next_tick) / self.period.nanos + 1;
                        self.next_tick += behind * self.period.nanos;
                    }
                    return true;
                } end function ready

                function wait_for_next(self&) -> void {
                    const long int: left = self.next_tick - detail::Native::steady_nanos();
                    if (left > 0) then {
                        detail::Native::sleep_nanos(left);
                    }
                    self.ready();
                } end function wait_for_next

                function ticks(const self&) -> long int {
                    return self.count;
                } end function ticks

                function until_next(const self&) -> Duration {
                    const long int: left = self.next_tick - detail::Native::steady_nanos();
                    return Duration(left > 0 ? left : 0);
                } end function until_next
            } end class RepeatingTimer

            class FrameClock {
                long int: last = 0;
                long int: first = 0;
                long int: frame_count = 0;
                Duration: last_delta;
                float: smoothed = 0.0;

            public:
                constructor() {
                    self.last = detail::Native::steady_nanos();
                    self.first = self.last;
                }

                function tick(self&) -> Duration {
                    const long int: now = detail::Native::steady_nanos();
                    self.last_delta = Duration(now - self.last);
                    self.last = now;
                    self.frame_count++;
                    const float: dt = self.last_delta.as_seconds();
                    self.smoothed = self.frame_count == 1 ? dt : self.smoothed * 0.9 + dt * 0.1;
                    return self.last_delta;
                } end function tick

                function delta(const self&) -> Duration {
                    return self.last_delta;
                } end function delta

                function delta_seconds(const self&) -> float {
                    return self.last_delta.as_seconds();
                } end function delta_seconds

                function frames(const self&) -> long int {
                    return self.frame_count;
                } end function frames

                function fps(const self&) -> float {
                    return self.smoothed > 0.0 ? 1.0 / self.smoothed : 0.0;
                } end function fps

                function total(const self&) -> Duration {
                    return Duration(self.last - self.first);
                } end function total

                function limit(self&, float: target_fps) -> void {
                    if (target_fps <= 0.0) then {
                        return;
                    }
                    const long int: frame = static_cast<long int>(1000000000.0 / target_fps);
                    const long int: spent = detail::Native::steady_nanos() - self.last;
                    if (spent < frame) then {
                        detail::Native::precise_wait_nanos(frame - spent);
                    }
                } end function limit
            } end class FrameClock
        } end namespace time
    } end namespace std
} end safe
