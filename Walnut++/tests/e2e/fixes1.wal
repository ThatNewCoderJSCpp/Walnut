class A { public: function f() const virtual -> int { return 1; } end function f } end class A
class B extends A { public: function f() const override -> int { return A::f() + 1; } end function f } end class B
class T {
 public:
    constructor() { println("ctor"); }
    destructor() { println("dtor"); }
} end class T
int: x = 1;
int&: r = x;
T: g = T();
function forward_decl_user() -> bool;
function is_odd(int: n) -> bool;
function is_even(int: n) -> bool { if (n == 0) then { return true; } return is_odd(n - 1); } end function is_even
function is_odd(int: n) -> bool { if (n == 0) then { return false; } return is_even(n - 1); } end function is_odd
function main() -> int {
    B: b;
    println(b.f());
    r = 5;
    println(x);
    auto&: rx = x;
    rx = 7;
    println(x);
    try { try { throw 1; } catch (int: e) { e += 100; throw; } } catch (int: o) { println(o); }
    string: s = "日本語";
    int: n = 0;
    for (char: c in s) { n += 1; print(c); }
    println("", n);
    s[0] = 'X';
    println(s);
    int: big = 1000000000;
    long int: lng = 3000000000 - 1;
    auto: m = 3000000000;
    println(big, lng, m);
    array int: d[4] = { 1, 2, 3, 4 };
    int*: p0 = &d[0];
    int*: p3 = &d[3];
    long int: dist = p3 - p0;
    println(dist, is_even(10), is_odd(7));
    switch (n) {
        case 3: println("three"); fallthrough;
        case 4: println("four"); break;
        default: println("other");
    }
    return 0;
}
end function main
