struct Point {
    int: x;
    int: y;
    constructor(int: a, int: b) : x(a), y(b) { }
    function sum() const -> int { return x + y; } end function sum
    function scale(int: k) -> void { x = x * k; y = y * k; } end function scale
} end struct Point
class Counter {
 private:
    int: n;
 public:
    constructor() : n(0) { println("ctor"); }
    destructor() { println("dtor", n); }
    function inc() -> void { n += 1; } end function inc
    function get() const -> int { return n; } end function get
} end class Counter
function main() -> int {
    Point: p = Point(2, 3);
    p.scale(10);
    println(p.x, p.y, p.sum());
    {
        Counter: c;
        c.inc();
        c.inc();
        println("count", c.get());
    }
    println("after");
    return 0;
}
end function main
