template <typename T>
struct Box {
    using Elem = T;
    T: v;
} end struct Box
struct P { short short int: a; long int: b; bool: c; } end struct P
class Poly { public: int: x; destructor() virtual = default; } end class Poly
class Q extends Poly { public: short short int: y; } end class Q
struct Arr { array[3] short int: xs; char: c; } end struct Arr
template <typename T>
function sz() -> int { return sizeof(Box<T>::Elem) + sizeof(Box<T>); } end function sz
function main() -> int {
    println(sizeof(P), alignof(P), sizeof(Poly), sizeof(Q), sizeof(Arr), alignof(Arr));
    println(sz<short int>(), sz<P>(), sizeof(Box<P>));
    return 0;
}
end function main
