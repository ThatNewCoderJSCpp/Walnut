template <typename T>
function biggest(T: a, T: b) -> T { if (a > b) then { return a; } return b; } end function biggest
template <typename T>
struct Box {
    T: v;
    constructor(T: a) : v(a) { int: z = 0; }
    function get() const -> T { return v; } end function get
} end struct Box
template <int N>
function power_of_two() -> int {
    if constexpr (N == 0) then { return 1; } else then { return 2 * power_of_two<N - 1>(); }
} end function power_of_two
template <typename T, int N>
struct Arr { function size() const -> int { return N; } end function size } end struct Arr
function main() -> int {
    println(biggest(3, 9), biggest(2.5, 1.5));
    Box<int>: b = Box<int>(41);
    Box<string>: s = Box<string>("boxed");
    println(b.get() + 1, s.get());
    println(power_of_two<10>());
    Arr<float, 7>: a;
    println(a.size());
    return 0;
}
end function main
