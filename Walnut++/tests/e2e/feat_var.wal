function sum(int...: xs) -> int {
    int: s = 0;
    for (int: x in xs) { s += x; }
    return s;
}
end function sum
function label(string: name, int...[3]: xs) -> string {
    return name + ":" + to_string(countof(xs));
}
end function label
function folds(int...: xs) -> int {
    return (xs + ...);
}
end function folds
function all_pos(int...: xs) -> bool {
    return ((xs > 0) && ...);
}
end function all_pos
function sub_right(int...: xs) -> int { return (xs - ...); } end function sub_right
function sub_left(int...: xs) -> int { return (... - xs); } end function sub_left
function with_init(int...: xs) -> int { return (100 - ... - xs); } end function with_init
template <typename... Args>
function count(const Args...: args) -> int { return countof(args); } end function count
template <typename... Args>
function total(const Args...: args) -> double { return (0.0 + ... + args); } end function total
template <typename... Args>
function show(const Args...: args) -> void { (print(args), ...); println(); } end function show
template <typename... Args>
function concat(const Args...: args) -> string { return ("" + ... + to_string(args)); } end function concat
template <typename... Args>
function forward(const Args...: args) -> string { return concat(args..., "!"); } end function forward
template <typename T, typename... Rest>
function first_of(const T: head, const Rest...: rest) -> T { return head; } end function first_of
template <typename... Args>
function second(const Args...: args) -> int { return first_of(args...) + countof(args); } end function second
function main() -> int {
    println(forward(1, 2), forward(), second(7, 8, 9));
    println(sum(), sum(1), sum(1, 2, 3, 4));
    println(label("a"), label("b", 1, 2), label("c", 1, 2, 3));
    println(folds(1, 2, 3), all_pos(1, 2, 3), all_pos(1, -2), all_pos());
    println(sub_right(10, 4, 3), sub_left(10, 4, 3), with_init(1, 2, 3));
    println(count(), count(1, "x", 2.5), total(1, 2.5, 3));
    show(1, "two", 3.5, 'c', true);
    println(concat(1, 2.5, "x"));
    try { println(folds()); } catch (...) { println("empty fold"); }
    return 0;
}
end function main
