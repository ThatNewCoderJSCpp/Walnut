namespace mathlib {
    function gcd(int: a, int: b) -> int {
        while (b != 0) {
            int: t = a % b;
            a = b;
            b = t;
        }
        return a;
    } end function gcd

    struct Frac {
        int: n;
        int: d;
        constructor(int: a, int: b) : n(a), d(b) { int: z = 0; }
        function reduced() const -> Frac {
            int: g = gcd(n, d);
            return Frac(n / g, d / g);
        } end function reduced
    } end struct Frac
}
end namespace mathlib

export {
    mathlib::gcd
    mathlib::Frac
}
