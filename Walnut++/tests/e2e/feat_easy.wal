class Shape {
 public:
    destructor() virtual = default;
    function name() const virtual -> string { return "shape"; } end function name
} end class Shape
class Circle extends Shape {
 public:
    int: r = 2;
    function name() const override -> string { return "circle"; } end function name
} end class Circle
class Square extends Shape {
 public:
    function name() const override -> string { return "square"; } end function name
} end class Square
struct V {
    int: x;
    operator(==) function (const V&: o) const -> bool { return x == o.x; }
} end struct V
function main() -> int {
    Circle: c;
    Square: s;
    Shape*: p = &c;
    Circle*: pc = dynamic_cast<Circle*>(p);
    if (pc != nullptr) then { println("is circle", pc->r); }
    p = &s;
    pc = dynamic_cast<Circle*>(p);
    println(pc == nullptr);
    Shape&: rs = s;
    try { Circle&: rc = dynamic_cast<Circle&>(rs); println(rc.r); } catch (...) { println("bad cast"); }
    int: tries = 0;
    for (int: i = 0; i < 3; i++) {
        tries++;
        if (tries == 2) then { repeat; }
        println("i", i, "tries", tries);
    }
    int: n = 0;
    auto: counter = [n]() mutable -> int { n++; return n; };
    println(counter(), counter(), n);
    V: a = V{1};
    V: b = V{2};
    println(a == b, a != b);
    string: t = 'x' + "yz";
    println(t, "ab" + 'c');
    return 0;
}
end function main
