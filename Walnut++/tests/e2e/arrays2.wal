function total(array int: xs) -> int {
    int: s = 0;
    for (int: x in xs) { s += x; }
    return s;
} end function total
function bump_all(array int&: xs) -> void {
    for (int: i = 0; i < 3; i++) { xs[i] += 10; }
} end function bump_all
function first(array[3] string: xs) -> string { return xs[0]; } end function first
function main() -> int {
    array int: d[3] = { 1, 2, 3 };
    println(total(d));
    bump_all(d);
    println(d[0], d[1], d[2], total(d));
    int: n = 4;
    array int: dyn[n];
    dyn[3] = 9;
    println(total(dyn));
    array string: names[3] = { "x", "y", "z" };
    println(first(names));
    return 0;
}
end function main
