enum Color { Red, Green, Blue = 10 }
function name(Color: c) -> string {
    switch (c) {
        case Color::Red: return "red";
        case Color::Green: return "green";
        default: return "other";
    }
} end function name
function main() -> int {
    Color: c = Color::Green;
    println(name(c), name(Color::Blue), name(Color::Red));
    int: v = 2;
    switch (v) {
        case 1: println("one");
        case 2: println("two"); fallthrough;
        case 3: println("three");
        default: println("dflt");
    }
    return 0;
}
end function main
