struct Point { int: x; int: y; } end struct Point
struct Named { string: name; double: score; } end struct Named
function make() -> Point { return Point{3, 4}; } end function make
auto: [gx, gy] = make();
function main() -> int {
    auto: [a, b] = make();
    println(a, b);
    Point: p = Point{1, 2};
    auto&: [rx, ry] = p;
    rx = 10;
    println(p.x, ry);
    const auto: [cx, cy] = p;
    println(cx + cy);
    array[3] int: nums = {7, 8, 9};
    auto: [f, s, t] = nums;
    println(f, s, t);
    array Named: people[] = {Named{"ann", 1.5}, Named{"bob", 2.5}};
    for (auto: [n, sc] in people) { println(n, sc); }
    for (auto&: [n, sc] in people) { sc = sc * 2.0; }
    println(people[1].score, gx, gy);
    return 0;
}
end function main
