struct Oops { int: code; } end struct Oops
function risky(int: n) -> int {
    if (n > 2) then { throw Oops{ n }; }
    return n;
} end function risky
function main() -> int {
    try {
        println(risky(1));
        println(risky(5));
        println("unreached");
    } catch (Oops: o) {
        println("caught", o.code);
    }
    return 3;
}
end function main
