function main() -> int {
    string: s = "abc";
    s += "def";
    s = s + 'g';
    println(s, s == "abcdefg", s != "x", s < "b");
    char: c = 'z';
    println(c, c == 'z', c > 'a');
    int: code = static_cast<int>(c);
    println(code);
    println(1.0 / 4.0, 2.5 * 2.0);
    println(3 > 2 ? "yes" : "no");
    string: empty;
    println("[" + empty + "]");
    return 0;
}
end function main
