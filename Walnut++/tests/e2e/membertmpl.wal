struct Printer {
    string: prefix;
    constructor(string: p) : prefix(p) { int: z = 0; }
    template <typename T>
    function show(T: v) const -> string { return prefix; } end function show
    template <typename T>
    function twice(T: v) const -> T { return v + v; } end function twice
} end struct Printer
namespace util {
    template <typename T>
    function maxof(T: a, T: b, T: c) -> T {
        T: m = a;
        if (b > m) then { m = b; }
        if (c > m) then { m = c; }
        return m;
    } end function maxof
}
end namespace util
function main() -> int {
    Printer: p = Printer(">");
    println(p.show(1), p.show("x"), p.twice(21), p.twice(1.5), p.twice("ab"));
    println(util::maxof(3, 9, 4), util::maxof("pear", "apple", "zoo"));
    return 0;
}
end function main
