auto: square = [](auto: v) -> auto { return v * v; };
function apply(function(int) -> int: f, int: v) -> int { return f(v); } end function apply
function apply_s(function(string) -> string: f) -> string { return f("w"); } end function apply_s
function main() -> int {
    int: offset = 100;
    auto: shift = [&](auto: v) -> auto { return v + offset; };
    println(square(4), square(1.5), shift(1), shift(0.5));
    offset = 1;
    println(shift(1));
    println(apply(square, 7), apply(shift, 2));
    auto: wrap = [](const auto&: s) { return "<" + to_string(s) + ">"; };
    println(wrap(5), wrap("x"), apply_s(wrap));
    function(int) -> int: f = square;
    println(f(9));
    return 0;
}
end function main
