class Shape {
 public:
    function area() const virtual -> int { return 0; } end function area
    function describe() const -> string { return "shape"; } end function describe
} end class Shape
class Square extends Shape {
 public:
    int: side;
    constructor(int: s) : side(s) { int: z = 0; }
    function area() const override -> int { return side * side; } end function area
} end class Square
function report(const Shape&: s) -> int { return s.area(); } end function report
function main() -> int {
    Square: q = Square(4);
    println(report(q), q.describe());
    Shape*: p = new Square(3);
    println(p->area());
    delete p;
    return 0;
}
end function main
