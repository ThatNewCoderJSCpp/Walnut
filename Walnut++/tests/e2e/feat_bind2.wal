template <typename T>
struct Pair { T: first; T: second; } end struct Pair
struct Base { int: a; } end struct Base
struct Derived extends Base { int: b; } end struct Derived
const auto: [ca, cb] = Pair<int>{5, 6};
function split(array[] int: xs) -> int {
    auto: [p, q] = xs;
    return p * 10 + q;
}
end function split
function main() -> int {
    auto: [l, r] = Pair<string>{"left", "right"};
    println(l, r, ca + cb);
    Derived: d;
    d.a = 1; d.b = 2;
    auto: [x, y] = d;
    println(x, y);
    array[] int: two = {4, 2};
    println(split(two));
    array[] int: three = {1, 2, 3};
    try { println(split(three)); } catch (...) { println("count mismatch"); }
    return 0;
}
end function main
