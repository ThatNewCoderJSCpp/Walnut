function main() -> int {
    array int: grid[3] = { 3, 1, 2 };
    for (int: i = 0; i < 3; i++) {
        for (int: j = 0; j < 2 - i; j++) {
            if (grid[j] > grid[j + 1]) then {
                int: t = grid[j];
                grid[j] = grid[j + 1];
                grid[j + 1] = t;
            }
        }
    }
    for (int: v in grid) { print(v, ""); }
    println();
    array string: names[] = { "a", "b" };
    for (auto: n in names) { println(n); }
    return 0;
}
end function main
