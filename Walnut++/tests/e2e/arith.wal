int: g = 7;
constexpr int: k = 3 ** 4;
function sq(int: x) -> int { return x * x; } end function sq
function main() -> int {
    int: a = 10;
    int: b = 3;
    println(a + b, a - b, a * b, a / b, a % b, a ** b);
    println(-7 / 2, -7 % 2, k, sq(g));
    short short int: s = 127;
    s += 1;
    println(s);
    long long int: big = 170141183460469231731687303715884105727;
    println(big);
    float: f = 1.5;
    float: h = f * 2.0 + 0.25;
    println(h);
    unsigned int: u = 5;
    println(u << 3, u >> 1, u & 4, u | 2, u ^ 1);
    bool: t = a > b && b != 0;
    println(t, !t);
    int: i = 0;
    i++;
    ++i;
    i -= 5;
    println(i);
    return 0;
}
end function main
