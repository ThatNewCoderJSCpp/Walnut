struct M { int: c; } end struct M
struct T {
    int: v;
    constructor(int: x) : v(x) { int: z = 0; }
} end struct T
struct H {
    T: a;
    M: m;
    T: b;
    constructor(T: x) : a(x), m(M{ 9 }), b(4) { int: z = 0; }
} end struct H
class A {
 public:
    int: id;
    constructor() : id(7) { int: z = 0; }
    function base() const -> int { return 5; } end function base
} end class A
class B extends A {
 public:
    function get() const -> int { return id + base(); } end function get
} end class B
template <typename T>
class Base {
 public:
    T: value;
    function twice() const -> T { return value + value; } end function twice
} end class Base
class D extends Base<int> {
 public:
    int: extra;
    function sum() const -> int { return value + extra; } end function sum
} end class D
template <typename T>
struct Box {
    T: v;
    constructor(T: x) : v(x) { int: z = 0; }
    function copy() const -> Box { return Box(v); } end function copy
    function plus(const Box<T>&: o) const -> Box<T> { return Box<T>(v + o.v); } end function plus
} end struct Box
template <typename T>
function depth(T: b, int: n) -> int { if (n == 0) then { return 0; } return 1 + depth(b, n - 1); } end function depth
function main() -> int {
    M: a = M{ 1 };
    M: b = M{ 2 };
    a = b;
    println(a.c);
    T: t = T(3);
    T: u = T(t);
    H: h = H(u);
    println(h.a.v, h.m.c, h.b.v);
    B: bb;
    println(bb.get());
    D: d;
    d.value = 4;
    d.extra = 1;
    Base<int>&: r = d;
    println(d.value, d.sum(), r.twice());
    Box<int>: x = Box<int>(20);
    Box<int>: y = x.copy();
    println(y.plus(x).v);
    println(depth(5, 3), depth("s", 2));
    return 0;
}
end function main
