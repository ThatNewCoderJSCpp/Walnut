struct Inner { int: a; int: b; } end struct Inner
struct Outer {
    Inner: inner;
    array int: hist[3];
    string: label = "outer";
    function total() const -> int { return inner.a + inner.b + hist[0] + hist[2]; } end function total
} end struct Outer
struct Celsius {
    float: deg;
    constructor(float: d) : deg(d) { int: z = 0; }
    operator(float) function () const { return deg * 1.8 + 32.0; }
} end struct Celsius
function main() -> int {
    Outer: o;
    o.inner.a = 2;
    o.inner.b = 3;
    o.hist[0] = 10;
    o.hist[2] = 100;
    Outer: copy = o;
    copy.inner.a = 1000;
    println(o.total(), copy.total(), o.label);
    Celsius: c = Celsius(100.0);
    float: f = static_cast<float>(c);
    println(f);
    if (1 + 1 == 3) then { println("dead"); } else then { println("live"); }
    return 0;
}
end function main
