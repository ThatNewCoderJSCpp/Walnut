struct Adder {
    int: k;
    operator(()) function (int: x) const -> int { return x + k; }
} end struct Adder
function apply(function(int) -> int: f, int: v) -> int { return f(v); } end function apply
function main() -> int {
    function(int) -> int: fib = [&fib](int: n) -> int { if (n < 2) then { return n; } return fib(n - 1) + fib(n - 2); };
    println(fib(10));
    Adder: a = Adder{5};
    function(int) -> int: g = a;
    println(g(1), apply(a, 2), apply(Adder{7}, 1));
    return 0;
}
end function main
