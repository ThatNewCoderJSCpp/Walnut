function main() -> int {
    int: base = 10;
    function add(int: x) -> int { return x + base; } end function add
    function fact(int: n) -> int { if (n <= 1) then { return 1; } return n * fact(n - 1); } end function fact
    println(add(5), fact(5));
    base = 20;
    println(add(5));
    println(early(2));
    hoisted function early(int: k) -> int { return k * 3; } end function early
    return 0;
}
end function main
