struct Node {
    int: value;
    Node*: next;
    constructor(int: v) : value(v), next(nullptr) { int: z = 0; }
} end struct Node
class List {
 private:
    Node*: head;
    int: count;
 public:
    constructor() : head(nullptr), count(0) { int: z = 0; }
    destructor() {
        Node*: cur = head;
        while (cur != nullptr) {
            Node*: nxt = cur->next;
            delete cur;
            cur = nxt;
        }
        println("freed", count);
    }
    function push(int: v) -> void {
        Node*: n = new Node(v);
        n->next = head;
        head = n;
        count += 1;
    } end function push
    function sum() const -> int {
        int: s = 0;
        Node*: cur = head;
        while (cur != nullptr) { s += cur->value; cur = cur->next; }
        return s;
    } end function sum
    function size() const -> int { return count; } end function size
} end class List
template <typename T>
class Stack {
 private:
    array T: items[16];
    int: top;
 public:
    constructor() : top(0) { int: z = 0; }
    function push(T: v) -> void {
        if (top >= 16) then { throw "stack overflow"; }
        items[top] = v;
        top += 1;
    } end function push
    function pop() -> T {
        if (top == 0) then { throw "stack underflow"; }
        top -= 1;
        return items[top];
    } end function pop
    function empty() const -> bool { return top == 0; } end function empty
} end class Stack
function main() -> int {
    {
        List: l;
        for (int: i = 1; i <= 10; i++) { l.push(i * i); }
        println(l.size(), l.sum());
    }
    Stack<string>: s;
    s.push("a");
    s.push("b");
    s.push("c");
    string: out = "";
    while (!s.empty()) { out += s.pop(); }
    println(out);
    try {
        s.pop();
    } catch (string: e) {
        println("caught", e);
    }
    return 0;
}
end function main
