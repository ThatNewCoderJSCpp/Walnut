template <typename T>
class Box {
public:
    constructor() = default;

    constructor(const T: v) : m_value(v) {
        continue;
    }

    function get() const -> T {
        return m_value;
    } end function get

    function set(const T: v) {
        m_value = v;
    } end function set

private:
    T: m_value;
} end class Box

