struct Vec2 {
    float: dx;
    float: dy;

    constructor() = default;

    constructor(float: a, float: b) : dx(a), dy(b) {
        continue;
    }

    function length_squared() const -> float {
        return dx ** 2 + dy ** 2;
    } end function length_squared
} end struct Vec2

class Rectangle {
public:
    constructor() = default;

    constructor(float: w, float: h) : m_width(w), m_height(h) {
        continue;
    }

    constructor(const Rectangle&: other) = delete;

    destructor() = default;

    function area() const -> float {
        return m_width * m_height;
    } end function area

    function scale(float: factor) {
        m_width = m_width * factor;
        m_height = m_height * factor;
    } end function scale

protected:
    function invariant() const -> bool {
        return m_width >= 0.0 && m_height >= 0.0;
    } end function invariant

private:
    float: m_width = 0.0;
    float: m_height = 0.0;
} end class Rectangle

class Shape {
public:
    constructor() = default;

    destructor() virtual = default;

    function area() virtual -> float {
        return 0.0;
    } end function area

    function name() const -> string {
        return "shape";
    } end function name
} end class Shape

class Circle inherits Shape {
public:
    constructor(float: r) : m_radius(r) {
        continue;
    }

    function area() override -> float {
        return 3.14159 * m_radius ** 2;
    } end function area

private:
    float: m_radius = 0.0;
} end class Circle

