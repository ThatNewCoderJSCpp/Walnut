template <typename T>
class List {
public:
    struct Node {
        T: value;
        Node*: next = nullptr;
    } end struct Node

    constructor() = default;
    constructor(const List<T>&: other) = delete;
    destructor() virtual = default;

    function push(const T: v) -> int {
        return m_size;
    } end function push

    function head_value() const -> T {
        return m_head.value;
    } end function head_value

protected:
    function invariant() const -> bool {
        return m_size >= 0;
    } end function invariant

private:
    Node*: m_head = nullptr;
    int: m_size = 0;
} end class List

