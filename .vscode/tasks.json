{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build (g++ Debug)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-g",
                "-I", "${env:FIZMO_INCLUDES}",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lgdi32", "-luser32", "-lz", "-ljpeg",
                "-lole32", "-loleaut32", "-luuid", "-lcomdlg32",
                "-lshell32", "-lkernel32", "-lwinmm", "-lwsock32",
                "-lws2_32", "-lbcrypt", "-lsecur32", "-lcrypt32"
            ],
            "options": {
                "cw`d": "${fileDirname}",
                "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Debug build with g++ (-g)"
        },
        {
            "type": "cppbuild",
            "label": "Build (g++ Release)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-O3", "-DNDEBUG",
                "-I", "${env:FIZMO_INCLUDES}",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lgdi32", "-luser32", "-lz", "-ljpeg",
                "-lole32", "-loleaut32", "-luuid", "-lcomdlg32",
                "-lshell32", "-lkernel32", "-lwinmm", "-lwsock32",
                "-lws2_32", "-lbcrypt", "-lsecur32", "-lcrypt32"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
            },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Optimized release build with g++ (default)"
        },
        {
            "type": "cppbuild",
            "label": "Build (clang++ Debug)",
            "command": "C:\\msys64\\ucrt64\\bin\\clang++.exe",
            "args": [
                "-g",
                "-I", "${env:FIZMO_INCLUDES}",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lgdi32", "-luser32", "-lz", "-ljpeg",
                "-lole32", "-loleaut32", "-luuid", "-lcomdlg32",
                "-lshell32", "-lkernel32", "-lwinmm", "-lwsock32",
                "-lws2_32", "-lbcrypt", "-lsecur32", "-lcrypt32"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Debug build with clang++ (-g)"
        },
        {
            "type": "cppbuild",
            "label": "Build (clang++ Release)",
            "command": "C:\\msys64\\ucrt64\\bin\\clang++.exe",
            "args": [
                "-O3", "-DNDEBUG",
                "-I", "${env:FIZMO_INCLUDES}",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lgdi32", "-luser32", "-lz", "-ljpeg",
                "-lole32", "-loleaut32", "-luuid", "-lcomdlg32",
                "-lshell32", "-lkernel32", "-lwinmm", "-lwsock32",
                "-lws2_32", "-lbcrypt", "-lsecur32", "-lcrypt32"
            ],
            "options": { "cwd": "${fileDirname}" },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Optimized release build with clang++"
        }
    ]
}