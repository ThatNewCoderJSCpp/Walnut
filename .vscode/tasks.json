{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build (g++ Debug)",
            "command": "/usr/bin/g++",
            "args": [
                "-g", "-std=c++17",
                "-I", "${env:FIZMO_INCLUDES}",
                "-I", "/usr/include/pango-1.0",
                "-I", "/usr/include/glib-2.0",
                "-I", "/usr/lib64/glib-2.0/include",
                "-I", "/usr/include/harfbuzz",
                "-I", "/usr/include/cairo",
                "-I", "/usr/include/freetype2",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}",
                "-lX11", "-lXft", "-lXrender", "-lfontconfig", "-lfreetype",
                "-lz", "-ljpeg", "-lm", "-lssl", "-lcrypto", "-lpthread",
                "-lpangocairo-1.0",
                "-lpango-1.0",
                "-lgobject-2.0",
                "-lglib-2.0",
                "-lcairo"
            ],
            "options": { "cwd": "${fileDirname}" },
            "windows": {
                "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
                "args": [
                    "-g", "-std=c++17",
                    "-I", "${env:FIZMO_INCLUDES}",
                    "${file}",
                    "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe",
                    "-lgdi32", "-luser32", "-lz", "-ljpeg",
                    "-lole32", "-loleaut32", "-luuid", "-lcomdlg32",
                    "-lshell32", "-lkernel32", "-lwinmm", "-lwsock32",
                    "-lws2_32", "-lbcrypt", "-lsecur32", "-lcrypt32", "-ldwrite", "-lmsimg32"
                ],
                "options": {
                    "cwd": "${fileDirname}",
                    "env": { "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}" }
                }
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Debug build with g++ (-g)"
